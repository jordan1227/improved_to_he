# GitHub Linguist classification for game sources.
*.script linguist-language=Lua
*.ltx linguist-language=INI
*.xml linguist-language=XML
*.cpp linguist-language=C++

# Game assets are binary data, not source languages.
*.anm -text linguist-vendored
*.dds -text linguist-vendored
*.dll -text linguist-vendored
*.ogf -text linguist-vendored
*.ogm -text linguist-vendored
*.omf -text linguist-vendored
*.ogg -text linguist-vendored
all.spawn -text linguist-vendored
