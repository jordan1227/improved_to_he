+#include "common.h"
+#include "he_watch_common.h"
+#include "sload.h"
+#include "electronics_problems.h"
+
+// uniform float4 shader_param_6;
+
+float4 main( p_flat I ) : SV_Target
+{
+  //f_deffer	O;
+
+  // diffuse
+  float3 D	= tbase		(I.tcdh);	// IN:  rgb.a
+  D	= SRGBToLinear(D);
+
+	float brightness = 100.f;
+	brightness *= calc_glitch_brightness(brightness);
+	float4 color = float4(D.rgb,1);
+	//color *= float4(brightness,brightness,brightness,brightness);
+	color *= min(brightness, 100.f) / 100.f;
+  return float4(he_watch_apply_signal(color.rgb, I.tcdh.xy), color.a);
+}
