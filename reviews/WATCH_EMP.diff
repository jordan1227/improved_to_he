+-- No stored-state writes here: safe during load/stop before a new save is bound.
+function uber_watch:stop_alarm_output()
+  wake_generation = wake_generation + 1
+  -- Undo only time scaling still owned by this alarm, never another sleep event.
+  if self.alarm_sleep_factor and sleep_manager.is_sleep_active()
+      and level.get_time_factor() == self.alarm_applied_factor then
+    level.set_time_factor(self.alarm_sleep_factor)
+  end
+  self.alarm_sleep_factor, self.alarm_applied_factor = nil, nil
+  if self.alarm_sound then
+    self.alarm_sound:stop()
+    self.alarm_sound = nil
+  end
+end
+
+-- Advance ONLY an occurrence already missed. Retain enabled flag and saved time.
+function uber_watch:skip_unavailable_alarm()
+  local cfg = self:alarm_config()
+  local days, minutes = math.floor(time_days()), time_minutes()
+  local alarm = cfg.h * 60 + cfg.m
+  if cfg.f and (cfg.d * 1440 + alarm <= days * 1440 + minutes) then
+    cfg.d = days + (alarm <= minutes and 1 or 0)
+    set_value("alarm_time", cfg)
+  end
+  self.prev_days, self.prev_update = days, minutes
+end
+
+function uber_watch:on_watch_state_changed(available)
+  self:shut_up()
+  self:skip_unavailable_alarm() -- also runs on recovery before normal update
+end
