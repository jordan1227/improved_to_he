-- [HE-PORT] adapter starogo kotovod/ui_arc_container_menu.script (NLC HE).
-- put_out_art udalyaet art iz kontejnera cherez OGSR arts/arc_containers.art_container
-- (take_art sam delaet update+save netpaketa).

function put_out_art( id, slot, art_section, condition )
  local box = level.object_by_id( id )
  if not box then return false end
  local cont = arc_containers.art_container( id )
  if not cont then return false end
  local slots = cont.config and cont.config.slots or 8

  if slot then
    if slot < 1 or slot > slots then return false end
    local rec = cont.arts[ slot ]
    if not rec or rec.count == 0 then return false end
    cont:take_art( slot )
    return true
  end

  for i = 1, slots do
    local rec = cont.arts[ i ]
    if rec and rec.count > 0 and rec.section == art_section then
      if not condition or ( rec.condition and rec.condition >= condition ) then
        cont:take_art( i )
        return true
      end
    end
  end
  return false
end
