-----------------------------------------------------------------------------------
-- Monster binding
-----------------------------------------------------------------------------------

local particles       = {}
local timer           = 0
dog_shield            = 1
count_spawns          = 0

local num
local DogNum, BurerNum
local DogTimer, BurerTimer = 0, 0
local mask_k          = 1
local game_difficulty = tonumber( level.get_game_difficulty() )
-- Global cache for psy mask multiplier to prevent calling heavy functions every frame per mutant
local cached_mask_k = 1.0
local mask_k_timer = 0

local function get_cached_mask_k()
    if time_global() > mask_k_timer then
        cached_mask_k = (sivol and sivol.get_mask_psy_k) and sivol.get_mask_psy_k() or 1.0
        mask_k_timer = time_global() + 500 -- Update every 0.5 seconds
    end
    return cached_mask_k
end
----------------------------------------------------------------------------------

class "generic_object_binder"( object_binder )

function generic_object_binder:__init( obj ) super( obj )
	self.loaded      = false
	self.chtime      = 0
	self.last_update = 0
	self.upd_count   = 0
	self.particles   = {}
	self.last_pos    = vector()
	self.move_events = 0
	--------- added by DSH for  OGSE Signal Manager -----
	self.am = ogse_signals.get_mgr()
	self.am:call( "on_monster_init", obj, self )
	-------------------------------------------------	
end 

function bind( obj )
	local new_binder = generic_object_binder( obj )
	obj:bind_object( new_binder )
end

function generic_object_binder:reload( section )
	object_binder.reload( self, section )
end

function generic_object_binder:reinit()
	object_binder.reinit( self )
	if self.object:clsid() ~= CLID_TRADER then
		self.object:set_patrol_extrapolate_callback( generic_object_binder.extrapolate_callback, self )
	end
	db.storage[ self.object:id() ] = {}
	self.st = db.storage[self.object:id()]
	self.object:set_callback( callback.patrol_path_in_point, self.waypoint_callback, self)
	self.object:set_callback( callback.hit,          		 self.hit_callback,      self)
	self.object:set_callback( callback.death,        		 self.death_callback,    self)
	self.object:set_callback( callback.use_object,      	 self.use_callback,  	 self)
end

prevent_gulag_registration_for_id = 0
local step = 1

function generic_object_binder:on_move( dist )
	self.move_events = self.move_events + 1
	if ( dist > 0.1 ) and ( self.object:alive() ) then -- обработка перемещения живых мобов
		-- self:anomaly_evade()
		local obj = engine_object( self.object:id() )
		if obj then
			obj:set_schedule( 50, 200 ) -- чтобы почаще обновлялся
		end
	end
end

function generic_object_binder:update( delta )
	object_binder.update( self, delta )
	local classid = self.object:clsid()
	local sfobj   = self.object
	local sfpos   = sfobj:position()
	local actor   = db.actor
	if nil == actor then
		abort ( "db.actor == nil" )
	end   
	-- added for OGES Anomaly Evader --------------
	self.am:call( "on_monster_update", self.object, delta )
	self.am:call(
    "on_monster_update." .. self.object:id(), self.object, delta
	)
	-----------------------------------------------	
    local dist_to_actor = actor:position():distance_to( sfpos )
    local dist = sfpos:distance_to( self.last_pos )
    local mask_k = get_cached_mask_k()

	if math.abs( dist ) > 0.05 then  -- оптимизация обработки перемещений
		self:on_move( dist )
		self.last_pos:set( sfpos )
	end

	if 
		dist_to_actor < 10 
		and bind_stalker.binder_loops < 100 
		and not sfobj:is_stalker() 
		and sfobj:section() ~= "m_trader" 
	then
		wprintf("[~T].~C0C #WARN:~C07 на переходе застрял монстр ~C0A %s~C07 - отправляется в оффлайн", sfobj:name())
		misc.force_offline( sfobj:id() )
	end

	if
		particles[ sfobj:id() ] 
		and table.getn( particles[ sfobj:id() ] ) > 0 
	then
		for kk, vv in pairs( particles[ sfobj:id() ] ) do
			table.insert( self.particles, amk_particle.amk_particle( vv ) )
			--table.remove( particles[ sfobj:id() ], kk )
			particles[ sfobj:id() ][ kk ] = nil
		end
	end
	
	if table.getn( self.particles ) > 0 then
		for kk, vv in pairs( self.particles ) do
			if vv:is_finished() then
				self.particles[ kk ] = nil
			else
				vv:update( delta )
				if vv.give_dmg and vv.target then
					if vv:get_pos():distance_to( vv.target:bone_position( "bip01_spine" ) ) < 1 then
						local h = hit()
						h.impulse = 0
						h.draftsman = vv.target
						h.direction = vv.dir
						h:bone( "bip01_spine" )
						h.power = lua_random( 10, 50 ) / 100
						h.type = hit.strike
						vv.target:hit( h )
						h.power = lua_random( 10, 50 ) / 100
						h.type = hit.chemical_burn
						vv.target:hit( h )
						vv:stop()
					end
				end
			end
		end
	end
  
	if classid == CLID_TRADER then trade_manager.update( sfobj ) end

	local act_scheme = db.storage[ sfobj:id() ].active_section or ""
	local is_fake    = string.find( act_scheme, "mob_fake_death", 1, true ) or false 
	if balance.monsters == nil then
		balance.load_config()
	end
	local bconf = balance.monsters -- table balance configuration
	if bconf == nil then return end

	------------------------- Тушкан --------------------------

	if classid == CLID_TUSHKANO and sfobj:alive() then
		local posit = sfobj:position()
		local enemy = sfobj:best_enemy()
		if not enemy then return end
		local posit = posit:distance_to( enemy:position() )
		if posit < bconf.tushkano_dist_attack and sfobj:see( enemy ) then
			if 
				lua_random() < 0.25 
				and not string.find( sfobj:section(), "rat_",     1, true ) 
				and not string.find( sfobj:section(), "electro_", 1, true ) 
			then
				local h = hit()
				h.type = hit.chemical_burn
				h.direction = vector():set( 0, 0, 0 )
				h.power = 0.01 + ( 0.008 * game_difficulty )
				h.impulse = 0
				h.draftsman = enemy
				enemy:hit( h )
			end
		end
    end	
	----------------------- Полтергейст ------------------------	
    if classid == CLID_POLTERGEIST and sfobj:alive() then
        local posit   = sfobj:position()
        local enemy   = sfobj:best_enemy()
        local epDist  = enemy and posit:distance_to( enemy:position() ) or 999
        local sec     = sfobj:section()
        local is_flame = string.find( sec, "flame", 1, true )
        local aura_dist = is_flame 
            and bconf.poltergeist_dist_attack * 1.4
            or  bconf.poltergeist_dist_attack

        if enemy and enemy:id() == actor:id() and epDist < aura_dist and sfobj:see( enemy ) then
            -- Distance factor: 1.0 at point-blank, ~0.5 at aura edge
            local dist_factor = 1.0 - ( epDist / aura_dist )
            dist_factor = math.max( 0.5, dist_factor )  -- floor at 50%
            
            if is_flame then
                self.polter_zap_timer = self.polter_zap_timer or 0
                if dist_to_actor < aura_dist and time_global() > self.polter_zap_timer then
                    local flame_snds = {
                        "monsters\\poltergeist\\polter_flame1",
                        "monsters\\poltergeist\\polter_flame2",
                        "monsters\\poltergeist\\polter_flame3",
                    }
                    local snd_obj = xr_sound.get_safe_sound_object( flame_snds[ lua_random( 3 ) ] )
                    snd_obj:play_no_feedback( sfobj, sound_object.s2d, 0, vector(), 5.0 )
                    local zh     = hit()
                    zh.draftsman = sfobj
                    zh.type      = hit.burn
                    zh.direction = sfobj:position():sub( enemy:position() )
                    zh:bone( "bip01_spine" )
                    zh.power     = ( 0.125 + ( 0.025 * game_difficulty ) ) * dist_factor
                    zh.impulse   = 0.0
                    actor:hit( zh )
                    self.polter_zap_timer = time_global() + 1850
                end
            else
                self.polter_zap_timer = self.polter_zap_timer or 0
                if time_global() > self.polter_zap_timer then
                 local snd_obj = xr_sound.get_safe_sound_object( "monsters\\tushkano\\tushkano_spark" )
				 snd_obj:play_no_feedback( sfobj, sound_object.s2d, 0, vector(), 5.0 )
                    local zh     = hit()
                    zh.draftsman = sfobj
                    zh.type      = hit.shock
                    zh.direction = sfobj:position():sub( enemy:position() )
                    zh:bone( "bip01_spine" )
                    zh.power     = ( 0.2 + ( 0.025 * game_difficulty ) ) * dist_factor
                    zh.impulse   = 0.05
                    actor:hit( zh )
                    self.polter_zap_timer = time_global() + 3500
                end
            end

            -- Battery drain: tele variants only
            if not is_flame then
                self.polter_batt_timer = self.polter_batt_timer or 0
                if dist_to_actor < bconf.poltergeist_batt_dist
                and time_global() > self.polter_batt_timer then
                    kotovod.fuckup_batteries()
                    self.polter_batt_timer = time_global() + 10000
                end
            end
        end  
    end  
	------------------------- Собака ---------------------------	
	
	if classid == CLID_DOG and sfobj:alive() and sfobj.health > 0.05 then
		local npc = sfobj:get_enemy()
		if npc and npc:id() == actor:id() then
			if sfobj:see( npc ) then
				if 
					sak.arts_operate == true 
					and sak_inventory.belt_items[ "af_dummy_fire" ]
					and dist_to_actor < bconf.dog_dist_panic 
				then
					sfobj:set_custom_panic_threshold( 1 )
				else
					sfobj:set_custom_panic_threshold( 0.1 )
				end
			end
		end
	end
	------------------------- Кровосос --------------------------	

	if classid == CLID_BLOODSUCKER and sfobj:alive() and sfobj.health > 0.05 then
		local npc = sfobj:get_enemy()
		if npc and npc:id() == actor:id() then
			if sfobj:see( npc ) then 
				if 
					sak.arts_operate == true 
					and sak_inventory.belt_items[ "af_baloon" ]
					and npc:see( sfobj )
					and dist_to_actor < 8 
				then
					sfobj:set_custom_panic_threshold( 1 )
					arc_arts.discharge_art_on_belt( "af_baloon", 0.001 )
				else
					sfobj:set_custom_panic_threshold( 0 )
				end
			end
		end
	end
	--------------------------- Псевда ----------------------------
	
	if classid == CLID_PSEUDODOG and sfobj:alive() and sfobj.health > 0.05 then
        local npc = sfobj:get_enemy()
        if npc and npc:id() == actor:id() then
            if sfobj:see( npc ) and lua_random() < bconf.psevdodog_divert_prob and wpn_params.get_zie_obj() and db.actor:see( sfobj ) then
                level.add_pp_effector( "zevok.ppe", 2021, false )
                local dh = ( 0.5 - lua_random() ) * 0.225 * mask_k  
                local dp = ( 0.5 - lua_random() ) * 0.175  * mask_k 
                if sivol_weapon and sivol_weapon.start_psy_divert then
                    sivol_weapon.start_psy_divert( dh, dp, 80 ) 
                elseif coord_params and coord_params.camera_angles then
                    local h, p = coord_params.camera_angles()
                    coord_params.camera_angles( h + dh, p + dp ) 
                end
                return
            end
            if game_options.BalanceValue == true then return end
            
            if DogTimer < time_global() then 	
                local v1, v2 = sfobj:direction(), actor:direction()
                if ( v1.x * v2.x ) + ( v1.z * v2.z ) < -0.6 and sfobj:see( actor ) and dist_to_actor < 20 and lua_random() < 0.5 then
                    DogNum = 1
                    for _, n in ipairs({ 1, 2 }) do
                        level.add_cam_effector( "build_1935_pseudodog_effect_" .. n .. ".anm", 990 + n, false, "" )
                    end				
                    level.add_pp_effector( "psy_antenna.ppe", 395, false )
                    if sivol_weapon and sivol_weapon.start_psy_divert then
                        local huge_dh = ( 0.5 - lua_random() ) * 0.8 * mask_k
                        local huge_dp = ( 0.5 - lua_random() ) * 0.4 * mask_k
                        sivol_weapon.start_psy_divert( huge_dh, huge_dp, 250 )
                    end 
                    local h = hit()
                    h.draftsman = self.object 
                    h.type = hit.telepatic 
                    h:bone( "bip01_spine" )				
                    h.direction = vector():set( 0, 0, 0 )				
                    h.power = ( bconf.psevdodog_hit_power + 0.03 * sak.dog_psy ) * mask_k
                    h.impulse = 0.0 
                    actor:hit( h )
                    xr_sound.get_safe_sound_object( "monsters\\pseudodog\\psy_affect_0", sound_object.s2d ):play_at_pos( actor, actor:position() )
                    if not string.find( sfobj:section(), "_weak", 1, true ) then
                        panic_item_drop( 0.2 )
                    end
                    DogTimer = time_global() + bconf.psevdodog_eff_timer * ( 1 + math.random( -0.2, 0.2 ) ) + 700
                end
            elseif DogNum and DogTimer < time_global() + bconf.psevdodog_eff_timer then 
                level.remove_pp_effector( 2003 ) 
                DogNum = nil 
            end
        end
	end	
	--------------------------- Бюрер ----------------------------
	
        -- Атака бюрера из Зова Припяти (Авторы: Shadows and Charsi)
    if classid == CLID_BURER and BurerTimer < time_global() then
		local actor = db.actor
		local oTarget = self.object:get_enemy()
        local v1, v2 = sfobj:direction(), actor:direction()
		if 
			( v1.x * v2.x ) + ( v1.z * v2.z ) < -0.6 
            and sfobj:see( actor )
            and sfobj:position():distance_to( actor:position() ) < 25
		then		
			BurerNum = 1 
			actor.power = -1.0
			burer_mask_item_drop()			
	        BurerTimer = time_global() + bconf.burer_hit_timer * ( 1 + math.random( -0.2, 0.2 ) )
        end
    elseif BurerNum and BurerTimer < time_global() + bconf.burer_hit_timer then 
		BurerNum = nil 
	end
	--------------------------- Кабан ----------------------------		
		
    if classid == CLID_BOAR then
        if step == 1 then
            if actor and dist_to_actor < bconf.boar_radiation_dist then
                local h     = hit()
                h.type      = hit.radiation
                h.power     = 0.0005 + ( 0.0002 * game_difficulty ) + 0.008 * ( sak.dog_psy )
                h.impulse   = 0.0
                h:bone( "bip_none" )	-- Чтобы не тормозили радейкой?
                h.draftsman = sfobj
                h.direction = sfobj:direction()
                actor:hit(h)
				sak.snd_rand_geiger()				
            end
            step = 2
        else
            step = 1
        end
        return
    end
	
	local blowout = amk_vars.blowout or 0
	if blowout == 3 and ( not self.control_override ) then
		if not sfobj:action() then
			xr_logic.mob_capture( sfobj, true )
			self.control_override = true
		end
	elseif self.control_override and blowout == 3 then
		if not sfobj:action() then
			local snds = { sound.take_damage, sound.panic, sound.idle }
			local snd = snds[ lua_random( 1, table.getn( snds ) ) ]
			action( sfobj, anim( anim.lie_idle, 0 ), sound( snd ), cond( cond.sound_end ) )
		end
	elseif self.control_override and blowout ~= 3 then
		self.control_override = nil
		xr_logic.mob_release( sfobj )
	elseif self.st.active_section ~= nil then
		xr_logic.issue_event( sfobj, self.st[ self.st.active_scheme ], "update", delta )
	end
	
	if self.chtime < time_global() then
		self.chtime = time_global() + 1513

    --------------------------- Псевдогигант ----------------------------	
    
    if classid == CLID_GIGANT then 
        -- Throttle the radiation application to roughly every 500ms
        -- This mimics the Boar's 'step' logic but is safely localized to this specific giant
        if not self.giant_rad_timer or time_global() > self.giant_rad_timer then
            local rad_dist = 5.0 -- You can change this to bconf.giant_radiation_dist if you add it to your config
            
            if actor and dist_to_actor < rad_dist then
                local h     = hit()
                h.type      = hit.radiation
                -- Slightly stronger than the boar, scales with difficulty
                h.power     = 0.005 + ( 0.0005 * game_difficulty ) 
                h.impulse   = 0.0
                h:bone( "bip_none" )	
                h.draftsman = sfobj
                h.direction = sfobj:direction()
                actor:hit( h )
                
                -- Play geiger sound
                sak.snd_rand_geiger()				
            end
            
            -- Set the next timer tick (500ms from now)
            self.giant_rad_timer = time_global() + 500
        end
    end
	--------------------------- Собака ----------------------------

	if classid == CLID_DOG and sfobj:alive() and sfobj.health > 0.05 then
		local npc = sfobj:get_enemy()
		if npc and npc:id() == actor:id() then
			if sfobj:see( npc ) then
				if lua_random() < sak.dog_psy and dist_to_actor < bconf.dog_dist_attack then
					level.add_pp_effector( "radiation.ppe", 2012, false )
					local h = hit()
					h.type      = hit.telepatic
					h.power     = ( 0.02 + 0.014 * sak.dog_psy ) * mask_k
					h.impulse   = 0.0
					h:bone( "bip01_spine" )
					h.draftsman = sfobj
					h.direction = sfobj:direction()
					npc:hit( h )

					-- subtle jitter, every successful psy hit
					local dh = ( 0.5 - lua_random() ) * 0.12 * mask_k
					local dp = ( 0.5 - lua_random() ) * 0.09 * mask_k
					if sivol_weapon and sivol_weapon.start_psy_divert then
						sivol_weapon.start_psy_divert( dh, dp, 120 )
					elseif coord_params and coord_params.camera_angles then
						local cam_h, cam_p = coord_params.camera_angles()
						coord_params.camera_angles( cam_h + dh, cam_p + dp )
					end

					if panic_item_drop( 0.05 ) then
						-- distinct two-pulse seizure, confirmed weapon drop only
						local dh1 = ( 0.5 - lua_random() ) * 0.35 * mask_k
						local dp1 = ( 0.5 - lua_random() ) * 0.35* mask_k
						if sivol_weapon and sivol_weapon.start_psy_divert then
							sivol_weapon.start_psy_divert( dh1, dp1, 170 )
							schedule.add(
								"dog_seizure_pulse2_" .. sfobj:id(),
								function() sivol_weapon.start_psy_divert( -dh1 * 0.6, -dp1 * 0.6, 120 ) end,
								80
							)
						elseif coord_params and coord_params.camera_angles then
							local cam_h, cam_p = coord_params.camera_angles()
							coord_params.camera_angles( cam_h + dh1, cam_p + dp1 )
						end
					end
				end
				return
			end
		end
	end
	--------------------------- Тушкан ----------------------------		
	
    if classid == CLID_TUSHKANO and sfobj:alive() then
		local posit = sfobj:position()
		local enemy = sfobj:best_enemy()
		if not enemy then return end
		local posit = posit:distance_to(enemy:position())
		if posit < 2 and sfobj:see( enemy ) then
			if sfobj:section() == "electro_tushkano_normal" then
				charge_tushkano( sfobj )
			end
			return
		end
    end
    --------------------------- Контрик ----------------------------
    
    if classid == CLID_CONTROLLER and sfobj:alive() then
        local k = mask_k 
        
        local dist_mod = 0
        if math.fmod( sfobj:id(), 3 ) == 0 then dist_mod = 20 end
        
        -- Distance Intensity: Scales STRENGTH and DURATION, NOT frequency.
        -- 1.5x intensity at 10m, 1.0x at 50m+
        local dist_intensity = 1.0
        local dur_dist_factor = 0.75 -- default for 50m+
        if dist_to_actor <= 10 then
            dist_intensity = 1.5
            dur_dist_factor = 1.25
        elseif dist_to_actor < 50 then
            local t = ( 50 - dist_to_actor ) / 40
            dist_intensity = 1.0 + ( t * 0.5 )
            dur_dist_factor = 0.75 + ( t * 0.5 )
        end
        
        -- Yank strength: 1.35x base when maskless, scales down with mask, scales up close
        local yank_str = 1.35 * k * dist_intensity
        
        -- Precision Divert (ADS only): Capped at 80%
        local divert_chance = math.min( ( bconf.controller_chance or 0 ) * 1.2 * k * dist_intensity, 0.80 )
        if wpn_params.get_zie_obj() and actor:see( sfobj ) and lua_random() < divert_chance then
            local dh = ( 0.5 - lua_random() ) * 0.3 * yank_str
            local dp = ( 0.5 - lua_random() ) * 0.2 * yank_str
            if sivol_weapon and sivol_weapon.start_psy_divert then
                sivol_weapon.start_psy_divert( dh, dp, 120 )
            elseif coord_params and coord_params.camera_angles then
                local h, p = coord_params.camera_angles()
                coord_params.camera_angles( h + dh, p + dp )
            end
            return
        end 		
        
		if dist_to_actor < ( bconf.controller_dist + dist_mod ) then

			-- Frequency scaling: 95% proc chance at 0m, tapering linearly to 70% at 20m+.
			-- Mirrors the poltergeist aura's dist_factor pattern.
			local near_proc  = 0.95
			local base_proc  = 0.70
			local proc_chance
			if dist_to_actor <= 0 then
				proc_chance = near_proc
			elseif dist_to_actor >= 20 then
				proc_chance = base_proc
			else
				local t = dist_to_actor / 25  -- 0 at 0m, 1 at 25m
				proc_chance = near_proc - t * ( near_proc - base_proc )
			end

			if lua_random() < proc_chance then
				-- Ability selection: same relative proportions as before, renormalized
				-- so the roll always lands inside a band (no more "nothing" gap here —
				-- that's already been decided by proc_chance above).
				local top_bound = math.min( 0.3 + 0.25 * k, 0.80 ) + 0.10
				local byaka = lua_random() * top_bound

				if byaka < 0.1 then
					sak.rebind_movement()
					schedule.add( "resore_movement", "sak.restore_movement()", math.floor( 4500 * dur_dist_factor ) )

				elseif byaka < 0.25 then
					sak.rebind_fire()

				elseif byaka < 0.3 then 
					if dist_to_actor < 35 then 
						local diff = sak.level_difficulty[ level.name() ]
						if diff and diff >= 1.4 then 
							vergas_masks.on_off_mask() 
						end
					end
					return

				elseif byaka < math.min( 0.3 + 0.25 * k, 0.80 ) then 
					local dh = ( 0.5 - lua_random() ) * 2.4 * yank_str
					local dp = 0
					if sivol_weapon and sivol_weapon.start_psy_divert then
						sivol_weapon.start_psy_divert( dh, dp, 400 )
					elseif coord_params and coord_params.camera_angles then
						local h, p = coord_params.camera_angles()
						coord_params.camera_angles( h + dh, p + dp )
					end
					return

				elseif byaka <= top_bound then  
					local slots = { 1, 2, 4 }
					local slot = slots[ lua_random( #slots ) ]
					actor:activate_slot( slot )			
					sak.start_fire()
					return
				end
			end
		end
	end
	---------------------------- Кошка ------------------------------	
    
    if classid == CLID_CAT and sfobj:alive() and sfobj.health > 0.05 then
		local npc = sfobj:get_enemy()
		if npc and npc:id() == actor:id() then
			if sfobj:see( npc ) and sfobj:position():distance_to( actor:position() ) < 20 then 
				if lua_random() < bconf.cat_attack_prob + ( 0.02 * game_difficulty ) then
					level.add_pp_effector( "black_cats.ppe", 2015, false )
					sleep_manager.zevota()
					if sak.arts_operate == true and sak_inventory.belt_items[ "af_medus_new" ] then
						sleep_manager.add_sleepiness( 3 )
						arc_arts.discharge_art_on_belt( "af_medus_new", 0.004 )
					else
						sleep_manager.add_sleepiness( 17 )
					end
					return
				end
			end
		end
    end
	---------------------------- Зомби -------------------------------
	
    if classid == CLID_ZOMBIE and sfobj:alive() and sfobj.health > 0.05 then
		local npc = sfobj:get_enemy()
		if npc and npc:id() == actor:id() then
			if 
				sfobj:see( npc ) 
				and dist_to_actor < bconf.starv_dist_attack 
				and lua_random() < 0.2 + ( 0.1 * game_difficulty ) 
			then
				if lua_random() < 0.4 then 
					local snd_obj
					local sound = "monsters\\zombie\\zombi_attack2"
					snd_obj = xr_sound.get_safe_sound_object( sound )
					snd_obj:play_no_feedback( npc, sound_object.s2d, 0, vector(), 5.0 )
					local level_vol = 0.1
					level.set_snd_volume( level_vol )
				end
				if sak.arts_operate == true and sak_inventory.belt_items[ "af_flower_new" ] then
					arc_arts.discharge_art_on_belt( "af_flower_new", 0.001 )
					return
				end
				params.satiety_add( -0.05 )
				return
			end
		end
    end
	---------------------------- Кровосос -------------------------------
	
    if classid == CLID_BLOODSUCKER and sfobj:alive() and sfobj.health > 0.05 then
		local npc = sfobj:get_enemy()
		if npc and npc:id() == actor:id() then
			if 
				sfobj:see( npc ) 
				and dist_to_actor < 15 
				and lua_random() < 0.5 
			then
				local snd_obj
				local sound = "monsters\\bloodsucker\\bloodsucker_attack"
				snd_obj = xr_sound.get_safe_sound_object( sound )
				snd_obj:play_no_feedback( npc, sound_object.s2d, 0, vector(), 5.0 )
				local h = hit()
				h.type = 7
				h.direction = vector():set( 0, 0, 0 )
				h.power = 0.05 + ( 0.02 * game_difficulty )
				h.impulse = 0
				h.draftsman = npc
				npc:hit( h )
				h.type = 3
				npc:hit( h )
				return
			end
		end
    end
	----------------------------- Химера --------------------------------
	
    if classid == CLID_CHIMERA and sfobj:alive() and sfobj.health > 0.5 then
		local npc = sfobj:get_enemy()
		if npc and npc:id() == actor:id() then
			if sfobj:see( npc ) and dist_to_actor < 15 and lua_random() < 0.5 then
				local snd_obj
				local sound = "monsters\\chimera\\attack_2"
					if 
						sak.arts_operate == true 
						and sak_inventory.belt_items[ "af_star_new" ] 
						and lua_random() < 0.66 
					then
						arc_arts.discharge_art_on_belt( "af_star_new", 0.005 )
					else
						snd_obj = xr_sound.get_safe_sound_object( sound )
						snd_obj:play_no_feedback( npc, sound_object.s2d, 0, vector(), 5.0 )
						params.power_health_add( 0.05 )
					end
					return
				end
			end
		end
	end
end

function generic_object_binder:anomaly_evade()
    local npc = self.object
    local sid = npc:story_id()
    if sid == 29 or sid == 3 or sid == 9530 then return end
    if not self.prev_pos then
        self.prev_pos  = vector():set(0, 5000, 0)
        self.prev_dist = 0
    end
    local pos  = npc:position()
    local dist = self.prev_pos:distance_to( pos ) 
    if dist > 15 then -- объект перешел в новую область, надо обновить ему аномальные рестрикторы
        self.prev_pos:set( pos )
        local list  = amk_anoms.get_anomaly_list( npc, 40 )
        local count = 0
        local dump  = " "
        for i, o in ipairs( list ) do
            amk_anoms.add_restriction( npc ,o.id, o.name )
            dump = dump .. DumpVar( o.name ) .. " "
            count = count + 1
        end
    elseif dist ~= self.prv_dist and dist < 20 then
        self.prv_dist = dist
        -- wprintf(" ~C0A %-35s~C07 dist to previuos position = ~C0D %.3f ~C07", npc:name(), dist)
    end
    if amk_anoms.have_pending_sync( npc ) then
        amk_anoms.synchronize( npc )
    end
end

function generic_object_binder:extrapolate_callback()
    if self.object == nil then return false end
    local cur_pt = self.object:get_current_point_index()
    if self.object:get_script() == false then return false end    
    if patrol( self.object:patrol() ):flags( cur_pt ):get() == 0 then return true end
    return false
end

function generic_object_binder:waypoint_callback( obj, action_type, index )
    if self.st.active_section ~= nil then
        xr_logic.issue_event(
            self.object, self.st[ self.st.active_scheme ],
            "waypoint_callback", obj, action_type, index
        )
    end
end

function generic_object_binder:death_callback( victim, who )
	--------------добавлено для изменения работы  xr_combat_ignore.script-----------
	self:clear_callbacks()
	--------------------------------------------------------------------------------	
	if ( self.object == nil ) then return end
	if who:id() == db.actor:id() then
		xr_statistic.addKillCount( self.object )
	end
	if self.st.mob_death then
		xr_logic.issue_event( self.object, self.st.mob_death, "death_callback", victim, who )
	end
	if self.st.active_section then
		xr_logic.issue_event( self.object, self.st[ self.st.active_scheme ], "death_callback", victim, who )
	end
	smart_terrain.on_death(self.object:id())
	local h = hit()
	h.draftsman = self.object
	h.type = hit.fire_wound
	h.direction = db.actor:position():sub(self.object:position())
	h:bone( "pelvis" )
	h.power = 1
	h.impulse = 10
	self.object:hit( h )
  
	if table.getn( self.particles ) > 0 then
		for kk, vv in pairs( self.particles ) do
			vv:on_death()
		end
	end
	amk.on_death(victim, who)
	if rx_ai then rx_ai.monster_death( victim, who ) end
	-- для xr_kamp от ДиШа
    xr_kamp.on_death( victim, who )
	
--	TODO: if IsMonster( victim ) then
--		kotovod.on_monster_kill_check_parts( victim, who )
--	end	
	
	self.am:call( "on_monster_death", victim, who )	
end

function generic_object_binder:hit_callback( obj, amount, local_direction, who, bone_index )
	if amount < 0.015 then return end
	-- amk.on_monster_hit( obj, amount, local_direction, who, bone_index )
	if self.st.active_section then
		xr_logic.issue_event( self.object, self.st[ self.st.active_scheme ], "hit_callback", obj, amount, local_direction, who, bone_index )
	end
	if self.st.hit then
		xr_logic.issue_event( self.object, self.st.hit, "hit_callback", obj, amount, local_direction, who, bone_index )
	end 	

	if bone_index == 14 and string.find( obj:section(), "bloodsucker", 1, true ) then
		local h = hit()
		h.type = hit.fire_wound
		h.power = 100 * local_direction.x * local_direction.x * local_direction.x * local_direction.x
		h.impulse = h.power
		h.draftsman = who
		h.direction = vector():set( 0, -1, 0 )
		obj:hit( h )
	end
	------------------- Партикл у Электро химер -------------------
     
	if obj:section() == "electro_chimera" and time_global() > ( self.charge_time or 0 ) + 3000 then
		amk_particle.amk_particle( { particle = "anomaly2\\electra2_blast", pos = obj:bone_position( "bip01_spine" ), sound = "anomaly\\electra_blast1" } )
		local dist = db.actor:position():distance_to( obj:bone_position( "bip01_spine" ) )
		if dist < 10 then
			if sak.arts_operate == true and sak_inventory.belt_items[ "af_compass" ] then
				arc_arts.discharge_art_on_belt( "af_compass", 0.005 )
				return
			end			
			local h = hit()
			h.impulse = 0
			h.draftsman = db.actor
			h.direction = vector():set(0,0,0)
			h.power = 0.5 / dist
			h.type = hit.strike
			db.actor:hit( h )
			h.power = 2 / dist
			h.type = hit.shock
			db.actor:hit( h )
			sak.special_container_downgrade( 0.3 )
		end
		self.charge_time = time_global()
	end
	----------------- Убийство гиганта в Припяти ------------------	
    if
        string.find( obj:section(), "gigant", 1, true )
        and not strposx( obj:section(), "marsh" )
        and obj:alive()
    then
        if db.actor then
            local active_item = db.actor:active_item()
            if active_item and active_item:section() == "wpn_rpg7" then
				obj:kill( db.actor )
            end
        end
    end		
	
	--------- added for  OGSE Signal Manager - to work monster's script attack ----
	self.am:call( "on_monster_hit", obj, amount, local_direction, who, bone_index)
	-------------------------------------------------------------------------------	
end

