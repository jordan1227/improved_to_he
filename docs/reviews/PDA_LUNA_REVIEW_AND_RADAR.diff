--- before/gamedata/scripts/he_pda_access.script
+++ after/gamedata/scripts/he_pda_access.script
@@ -0,0 +1,472 @@
+-- [HE-PORT] Real-PDA acquisition. Confirmed transactions outlive the dialogue.
+local PDA, DONOR = "device_pda", "device_pda_npc"
+local TX_KEY, UPGRADE_KEY = "he_pda_transaction_v2", "he_pda_upgrade_owned"
+local SIDOR_DISCOUNT_KEY = "he_pda_sidor_discounted"
+local RESULT_KEY, ACQUIRED_KEY = "he_pda_last_transaction_ok", "he_pda_legitimate_acquired"
+local PRICE, SIDOR_DISCOUNT_PRICE = 15000, 10000
+local preview, spawn_wait_started, last_error
+local stepping = false
+
+local function actor_ready() return db and db.actor ~= nil end
+local function saved_true(key) return get_value(key) == true or get_value(key) == 1 end
+function has_notes() return has_upgrade() or saved_true("he_pda_notes_installed") end
+local function pending() return get_value(TX_KEY) end
+function is_busy() return type(pending()) == "table" end
+function has_upgrade() return saved_true(UPGRADE_KEY) end
+local function permanent_blocked()
+    return actor_ready() and (db.actor:has_info("pda_is_broken") or db.actor:has_info("pda_will_be_broken"))
+end
+local function custody() return pda_battery.is_charging() end
+local function has(section) return actor_ready() and db.actor:object(section) ~= nil end
+function can_acquire_base()
+    return actor_ready() and not is_busy() and not saved_true(ACQUIRED_KEY)
+        and not saved_true("he_pda_vergas_reflash_done") and not saved_true("he_pda_petruha_reward_done")
+        and not has_upgrade() and not permanent_blocked() and not custody()
+        and not he_pda_model.get_pda() and not has("device_pda_discharged_gg") and not has("device_pda_npc_gg")
+end
+function radiation_eligible() return has_upgrade() end
+function custom_marker_eligible()
+    local pda = actor_ready() and he_pda_model.get_pda()
+    return pda ~= nil and has_notes() and pda:condition() > 0 and not permanent_blocked() and not custody()
+end
+function sidor_inquiry_available() return can_acquire_base() end
+function base_purchase_available() return can_acquire_base() and db.actor:money() >= PRICE end
+function sidor_discounted() return saved_true(SIDOR_DISCOUNT_KEY) end
+local function sidor_price() return sidor_discounted() and SIDOR_DISCOUNT_PRICE or PRICE end
+function sidor_initial_offer_available() return can_acquire_base() and not sidor_discounted() end
+function sidor_discount_offer_available() return can_acquire_base() and sidor_discounted() end
+function sidor_base_purchase_available() return can_acquire_base() and db.actor:money() >= sidor_price() end
+function mark_sidor_discount() set_value(SIDOR_DISCOUNT_KEY,true) end
+function sidor_intro_available() return can_acquire_base() and not saved_true("he_pda_sidor_intro_seen") end
+function mark_sidor_intro_seen() set_value("he_pda_sidor_intro_seen",true) end
+function vergas_not_met() return actor_ready() and not db.actor:has_info("esc_vergas_new_gg") end
+function barman_purchase_available() return can_acquire_base() and db.actor:money() >= 8000 end
+function upgrade_sold_out()
+    return actor_ready() and db.actor:has_info("bar_darklab_document_done")
+        and db.actor:has_info("bar_deactivate_radar_done") and not has_upgrade()
+end
+function docent_upgrade_dialog_available()
+    return actor_ready() and db.actor:has_info("bar_deactivate_radar_done") and not has_upgrade()
+end
+function upgraded_emp_resistance()
+    return has_upgrade() and he_pda_model.get_pda() and sivol_emp_config.UPGRADED_PDA_EMP_RESISTANCE or 0
+end
+-- Called only when an emission countdown is due, never for forced story damage.
+function emission_burn_due()
+    return not (has_upgrade() and he_pda_model.get_pda())
+        or math.random() >= sivol_emp_config.UPGRADED_PDA_EMISSION_SURVIVAL
+end
+function burn_dialog_available() return actor_ready() and db.actor:has_info("pda_is_broken") end
+function vergas_known()
+    return actor_ready() and db.actor:has_info("esc_vergas_new_gg")
+        and db.actor:has_info("kvest_art_done") and not db.actor:has_info("vergas_umer")
+end
+function vergas_unknown() return not vergas_known() end
+function vergas_reflash_available() return can_acquire_base() and vergas_known() end
+function upgrade_dialog_available()
+    return actor_ready() and not is_busy() and db.actor:has_info("bar_darklab_document_done")
+        and not db.actor:has_info("bar_deactivate_radar_done")
+        and not has_upgrade() and not permanent_blocked() and not custody() and not has("device_pda_npc_gg")
+end
+
+local function owned(id, section)
+    local obj = id and client_obj(id)
+    local parent = obj and obj:parent()
+    if obj and obj:section() == section and parent and parent:id() == db.actor:id() then return obj end
+end
+local function inventory_owned(id, section)
+    local obj = owned(id,section)
+    if obj then return obj end
+    for _, rec in get_shadow_inv():get_content(true):ipairs() do
+        if rec.id == id and rec.sect == section then return rec.obj end
+    end
+end
+local function record(obj, kind)
+    local sobj = alife():object(obj:id())
+    return {id=obj:id(), section=obj:section(), name=sobj and sobj:name(), kind=kind,
+        cdata=kind == "donor" and vergas_pda.get_pda_cdata(obj:id()) or nil}
+end
+local function artifact_minimum() return tonumber(level.get_game_difficulty()) == 0 and 0.01 or 0.5 end
+local function artifact_matches(section, tier)
+    for _, base in ipairs(kotovod.tbl_arts[tier]) do
+        if strpos(section, base, 1, true) then return true end
+    end
+    return false
+end
+local function collect_artifacts(tier, count, minimum)
+    local result, seen = {}, {}
+    -- Match the established non-dyn tier helper, including its difficulty threshold.
+    for _, base in ipairs(kotovod.tbl_arts[tier]) do
+        for section, ids in pairs(sak_inventory.rucksack or {}) do
+            if strpos(section, base, 1, true) then
+                for _, id in ipairs(ids) do
+                    local obj = owned(id, section)
+                    if obj and not seen[id] and obj:condition() >= (minimum or artifact_minimum()) then
+                        seen[id] = true
+                        table.insert(result, record(obj, tier))
+                        if #result == count then return result end
+                    end
+                end
+            end
+        end
+    end
+    return result
+end
+local function donor_valid(id)
+    local obj = inventory_owned(id, DONOR)
+    if not obj then return end
+    local status = vergas_pda.get_pda_status(id)
+    if status == 1 or status == 2 then return obj end
+end
+local function valid(r)
+    local obj = (r.kind == "toz" or r.kind == "donor" or r.kind == "module" or r.kind == "capsule") and inventory_owned(r.id,r.section) or owned(r.id,r.section)
+    local sobj = obj and alife():object(r.id)
+    if not obj or not sobj or sobj:name() ~= r.name then return false end
+    if r.kind == "capsule" then return r.section == "af_capsule" end
+    if r.kind == "module" then return r.section == "pda_chip_rad" end
+    if r.kind == "notes_art" then return artifact_matches(r.section,"lvl1") and obj:condition() >= 0.5 end
+    if r.kind == "donor" then return donor_valid(r.id) ~= nil and vergas_pda.get_pda_cdata(r.id) == r.cdata end
+    if r.kind == "toz" then return obj:condition() >= (tonumber(level.get_game_difficulty()) == 0 and 0.475 or 0.95) end
+    return artifact_matches(r.section, r.kind) and obj:condition() >= artifact_minimum()
+end
+local function all_valid(items)
+    local seen = {}
+    for _, r in ipairs(items) do
+        if seen[r.id] or not valid(r) then return false end
+        seen[r.id] = true
+    end
+    return true
+end
+local function donors()
+    local result = {}
+    -- NPC PDAs are usable items, classified as eatable, not rucksack.
+    -- Read current full inventory rather than either cached category.
+    for _, rec in get_shadow_inv():get_content(true):ipairs() do
+        if rec.sect == DONOR then
+            local obj = donor_valid(rec.id)
+            if obj then table.insert(result, record(obj, "donor")) end
+        end
+    end
+    table.sort(result, function(a,b) return a.id < b.id end)
+    return result
+end
+function can_vergas_one() return vergas_reflash_available() and #donors() >= 1 and #collect_artifacts("lvl1",1) == 1 end
+function can_vergas_five() return vergas_reflash_available() and #donors() >= 5 end
+function vergas_artifact_too_poor()
+    return vergas_reflash_available() and #donors() >= 1
+        and #collect_artifacts("lvl1",1) == 0 and #collect_artifacts("lvl1",1,0) == 1
+end
+function wolf_hint_available() return can_acquire_base() and not saved_true("he_pda_wolf_hint_seen") end
+function wolf_hint_seen() set_value("he_pda_wolf_hint_seen",true) end
+function upgrade_artifacts_have() return upgrade_dialog_available() and #collect_artifacts("lvl2",2) == 2 end
+local function capsule_record()
+    for _, rec in get_shadow_inv():get_content(true):ipairs() do
+        if rec.sect == "af_capsule" then return record(rec.obj,"capsule") end
+    end
+end
+function docent_upgrade_available()
+    return docent_upgrade_dialog_available() and not is_busy() and not custody()
+        and not db.actor:has_info("pda_will_be_broken") and not db.actor:has_info("docent_self_pda_time_start")
+        and capsule_record() ~= nil
+end
+function docent_upgrade_unavailable() return not docent_upgrade_available() end
+local function toz_record()
+    local minimum = tonumber(level.get_game_difficulty()) == 0 and 0.475 or 0.95
+    for _, rec in get_shadow_inv():get_content(true):ipairs() do
+        if sak_inventory.dyn_art_base(rec.sect) == "wpn_bm16_full" and rec.obj:condition() >= minimum then
+            return record(rec.obj,"toz")
+        end
+    end
+end
+function petruha_reward_available() return can_acquire_base() and toz_record() ~= nil end
+
+local function local_notice(key, detail)
+    local text = game.translate_string(key) .. (detail or "")
+    if db.actor:is_talking() then
+        db.actor:give_talk_message(text,"ui\\ui_iconsTotal",Frect():set(0,0,83,47),"iconed_answer_item")
+    else
+        db.actor:give_game_news(text,"ui\\ui_iconsTotal",Frect():set(0,0,83,47),0,7000)
+    end
+end
+function clear_vergas_preview() preview = nil end
+function init_vergas_dialog() clear_vergas_preview() end
+local function show_selection()
+    if not preview then return end
+    local r = preview.candidates[preview.cursor]
+    local info = r and vergas_lib.str_explode("|",r.cdata,true)
+    local serial = info and info[4] or "?"
+    local status = r and vergas_pda.get_pda_status(r.id)
+    local text = "\\n" .. game.translate_string("he_pda_donor_serial") .. " " .. serial
+        .. " - " .. game.translate_string(status == 1 and "he_pda_donor_charged" or "he_pda_donor_empty")
+        .. "\\n" .. game.translate_string("he_pda_donor_selected") .. " " .. #preview.selected .. "/" .. preview.required
+    for _, v in ipairs(preview.selected) do
+        local data = vergas_lib.str_explode("|",v.cdata,true)
+        text = text .. "\\n" .. game.translate_string("he_pda_donor_serial") .. " " .. tostring(data[4])
+    end
+    if preview.artifact then
+        text = text .. "\\n" .. game.translate_string("he_pda_artifact_payment") .. " " .. game.translate_string(get_string(preview.artifact.section,"inv_name",preview.artifact.section))
+    end
+    local_notice("he_pda_selection_card",text)
+end
+local function start_selection(mode)
+    clear_vergas_preview()
+    if not db.actor:is_talking() or not (mode == "one" and can_vergas_one() or mode == "five" and can_vergas_five()) then return false end
+    preview = {mode=mode, candidates=donors(), cursor=1, selected={}, required=mode == "one" and 1 or 5,
+        artifact=mode == "one" and collect_artifacts("lvl1",1)[1] or nil}
+    show_selection()
+    return true
+end
+function preview_vergas_one() return start_selection("one") end
+function preview_vergas_five() return start_selection("five") end
+function next_donor()
+    if not preview then return end
+    preview.cursor = preview.cursor % #preview.candidates + 1
+    show_selection()
+end
+function select_donor()
+    if not preview then return end
+    local r = preview.candidates[preview.cursor]
+    for i,v in ipairs(preview.selected) do
+        if v.id == r.id then table.remove(preview.selected,i); show_selection(); return end
+    end
+    if #preview.selected < preview.required and valid(r) then table.insert(preview.selected,r) end
+    show_selection()
+end
+function has_vergas_preview(mode) return preview ~= nil and preview.mode == mode end
+function selection_ready()
+    return preview ~= nil and #preview.selected == preview.required and all_valid(preview.selected)
+        and (not preview.artifact or valid(preview.artifact))
+end
+
+-- Read-only checkpoints: never call alarm_config(), which initializes missing state.
+function diagnostics(label)
+    if not actor_ready() then return end
+    local function read(fn) local ok,value=pcall(fn); return ok and value or "unavailable" end
+    local total=read(function() return actor_stats.get_points("total") end)
+    local rank=read(function() return db.actor:character_rank() end)
+    local reputation=read(function() return db.actor:character_reputation() end)
+    local alarm=get_value("alarm_time")
+    local pda=he_pda_model.get_pda()
+    log2("[he_pda_access] checkpoint=%s total=%s rank=%s reputation=%s money=%s pda=%s charge=%s upgrade=%s busy=%s alarm=%s/%s/%s/%s/%s",
+        tostring(label),tostring(total),tostring(rank),tostring(reputation),tostring(db.actor:money()),
+        tostring(pda and pda:id()),tostring(pda and pda:condition()),tostring(has_upgrade()),tostring(is_busy()),
+        tostring(alarm and alarm.b),tostring(alarm and alarm.h),tostring(alarm and alarm.m),
+        tostring(alarm and alarm.d),tostring(alarm and alarm.f))
+end
+
+local function module_record()
+    for _, rec in get_shadow_inv():get_content(true):ipairs() do
+        if rec.sect == "pda_chip_rad" then return record(rec.obj,"module") end
+    end
+end
+function module_dialog_available() return actor_ready() and not has_notes() and module_record() ~= nil end
+function module_install_available()
+    local pda=he_pda_model.get_pda()
+    return module_dialog_available() and not is_busy() and not permanent_blocked() and not custody()
+        and pda ~= nil and pda:section() == PDA and pda:condition() > 0
+        and #collect_artifacts("lvl1",1,0.5) == 1
+end
+function module_install_unavailable() return not module_install_available() end
+function module_use_hint()
+    sak.send_tip_local(game.translate_string("he_pda_module_pickup"),game.translate_string("thinking_out_loud"),0,7,"g_g","no","yellow")
+end
+function module_pickup()
+    if saved_true("he_pda_module_seen") then return end
+    set_value("he_pda_module_seen",true)
+    module_use_hint()
+end
+function before_use(item)
+    if item and item:section() == "pda_chip_rad" then
+        item:disable_use()
+        module_use_hint()
+    end
+end
+
+local function save_tx(tx) set_value(TX_KEY,tx) end
+local function fail_unpaid(tx, reason)
+    -- Only our own uncommitted spawn may be removed. Existing PDAs and payment remain intact.
+    if tx.spawn_id then
+        local obj = alife():object(tx.spawn_id)
+        if obj and obj:name() == tx.spawn_name then alife():release(obj,true) end
+    end
+    remove_value(TX_KEY)
+    set_value(RESULT_KEY,false)
+    spawn_wait_started = nil
+    log2("[he_pda_access] failed kind=%s reason=%s payment=untouched",tx.kind,reason)
+    local_notice("he_pda_transaction_failed")
+end
+local function transaction_blocked(kind)
+    if kind == "docent_upgrade" then
+        return db.actor:has_info("pda_will_be_broken") or db.actor:has_info("docent_self_pda_time_start")
+    end
+    return permanent_blocked()
+end
+local function start_transaction(kind, items, cash)
+    if is_busy() or not actor_ready() or transaction_blocked(kind) or custody() then return false end
+    if not all_valid(items) or db.actor:money() < cash then return false end
+    local pda = he_pda_model.get_pda()
+    local tx = {schema=2, kind=kind, items=items, cash=cash, stage="prepare", paid_count=0,
+        existing_id=pda and pda:id() or nil}
+    diagnostics(kind .. "_before")
+    remove_value(RESULT_KEY)
+    save_tx(tx)
+    clear_vergas_preview()
+    spawn_wait_started = time_global()
+    log2("[he_pda_access] confirmed kind=%s items=%d cash=%d",kind,#items,cash)
+    return true
+end
+function install_notes_module()
+    set_value(RESULT_KEY,false)
+    if not module_install_available() then return false end
+    local artifact=collect_artifacts("lvl1",1,0.5)[1]
+    artifact.kind="notes_art"
+    return start_transaction("notes",{module_record(),artifact},0)
+end
+
+function buy_base()
+    set_value(RESULT_KEY,false)
+    return base_purchase_available() and start_transaction("base",{},PRICE)
+end
+function buy_barman_base()
+    set_value(RESULT_KEY,false)
+    return barman_purchase_available() and start_transaction("base",{},8000)
+end
+function buy_docent_upgrade()
+    set_value(RESULT_KEY,false)
+    return docent_upgrade_available() and start_transaction("docent_upgrade",{capsule_record()},0)
+end
+function buy_sidor_base()
+    set_value(RESULT_KEY,false)
+    return sidor_base_purchase_available() and start_transaction("base",{},sidor_price())
+end
+function upgrade_pda()
+    set_value(RESULT_KEY,false)
+    return upgrade_artifacts_have() and start_transaction("upgrade",collect_artifacts("lvl2",2),0)
+end
+function give_petruha_reward()
+    set_value(RESULT_KEY,false)
+    if not petruha_reward_available() then return false end
+    return start_transaction("petruha",{toz_record()},0)
+end
+function reflash(mode)
+    set_value(RESULT_KEY,false)
+    if not can_acquire_base() or not has_vergas_preview(mode) or not selection_ready() then return false end
+    local items = {}
+    for _, r in ipairs(preview.selected) do table.insert(items,r) end
+    if preview.artifact then table.insert(items,preview.artifact) end
+    return start_transaction("reflash",items,0)
+end
+function confirm_reflash()
+    return reflash(preview and preview.mode)
+end
+function last_transaction_success() return get_value(RESULT_KEY) == true and not is_busy() end
+function last_transaction_failed() return get_value(RESULT_KEY) == false and not is_busy() end
+function last_transaction_pending() return is_busy() end
+
+local function step_transaction(tx)
+    if tx.schema ~= 2 then error("unsupported PDA transaction schema") end
+    local pda
+    if tx.stage == "prepare" then
+        if transaction_blocked(tx.kind) or custody() or not all_valid(tx.items) or db.actor:money() < tx.cash then
+            return fail_unpaid(tx,"preflight_changed")
+        end
+        if ui_cheat_pda and ui_cheat_pda.cheat_instance then ui_cheat_pda.cheat_instance:close_for_reflash() end
+        if tx.existing_id then
+            pda = owned(tx.existing_id,PDA)
+            if not pda then return fail_unpaid(tx,"existing_pda_missing") end
+        else
+            if not tx.spawn_id then
+                if has(PDA) then return fail_unpaid(tx,"pda_acquired_elsewhere") end
+                local sobj = misc.spawn_to(PDA,db.actor)
+                if not sobj then return fail_unpaid(tx,"spawn_rejected") end
+                tx.spawn_id, tx.spawn_name = sobj.id, sobj:name()
+                save_tx(tx)
+            end
+            pda = owned(tx.spawn_id,PDA)
+            if not pda then
+                if time_global() - spawn_wait_started > 10000 then fail_unpaid(tx,"spawn_timeout") end
+                return
+            end
+        end
+        if not all_valid(tx.items) or db.actor:money() < tx.cash then return fail_unpaid(tx,"payment_changed") end
+        tx.pda_id, tx.stage = pda:id(), "commit"
+        save_tx(tx)
+    end
+    -- Once consumption starts, retain/retry the transaction on errors; never report a refunded failure.
+    pda = owned(tx.pda_id,PDA)
+    if not pda then error("committing PDA is unavailable; retained transaction") end
+    for i=(tx.paid_count or 0)+1,#tx.items do
+        local r = tx.items[i]
+        local sobj = alife():object(r.id)
+        if sobj then
+            if sobj:name() ~= r.name or not valid(r) then error("payment identity changed during commit") end
+            alife():release(sobj,true)
+        end
+        tx.paid_count = i
+        save_tx(tx)
+    end
+    if not tx.cash_paid then
+        if db.actor:money() < tx.cash then error("cash unavailable during commit") end
+        db.actor:give_money(-tx.cash)
+        tx.cash_paid = true
+        save_tx(tx)
+    end
+    if tx.kind == "petruha" and not tx.bonus_given then
+        sak.create_items("vodka",2)
+        tx.bonus_given = true
+        save_tx(tx)
+    end
+    if tx.kind == "upgrade" or tx.kind == "docent_upgrade" then set_value(UPGRADE_KEY,true); set_value("pda_upgr_rad",true) end
+    if tx.kind == "docent_upgrade" then
+        -- Replacement clears only physical burn state, never quest/statistic history.
+        for _, rec in get_shadow_inv():get_content(true):ipairs() do
+            if rec.sect == "device_pda_npc_gg" then misc.release_obj(rec.obj,true) end
+        end
+        db.actor:disable_info_portion("pda_is_broken")
+    end
+    if tx.kind == "petruha" then
+        set_value("he_pda_petruha_reward_done",true)
+        db.actor:give_info_portion("esc_petruha_toz_done")
+    end
+    if tx.kind == "reflash" then set_value("he_pda_vergas_reflash_done",true) end
+    if tx.kind == "notes" then set_value("he_pda_notes_installed",true) else pda:set_condition(1) end
+    local empty = db.actor:object("device_pda_discharged_gg")
+    if empty then misc.release_obj(empty,true) end
+    if tx.kind ~= "notes" then pda_battery.reset_discharge_clock() end
+    he_pda_market.cancel_startup_removal()
+    bind_pda.enable_pda()
+    vergas_pda.set_tbl_sn_nil()
+    vergas_pda.set_info_pda_nil()
+    sak_inventory.need_update_inventory()
+    remove_value(TX_KEY)
+    set_value(RESULT_KEY,true)
+    spawn_wait_started = nil
+    log2("[he_pda_access] completed kind=%s pda=%s",tx.kind,tostring(pda:id()))
+    diagnostics(tx.kind .. "_after")
+    local_notice(tx.kind == "notes" and "he_pda_module_done" or "he_pda_transaction_done")
+end
+function on_update()
+    ogse_signals.get_mgr():reschedule(200)
+    if not actor_ready() then return end
+    if not db.actor:is_talking() then clear_vergas_preview() end
+    local tx = pending()
+    if type(tx) ~= "table" or stepping then return end
+    spawn_wait_started = spawn_wait_started or time_global()
+    stepping = true
+    local ok, err = pcall(step_transaction,tx)
+    stepping = false
