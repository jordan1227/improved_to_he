--- /dev/null
+++ after/gamedata/scripts/he_local_feedback.script
@@ -0,0 +1,30 @@
+-- Missing quick-use feedback is local, independent of PDA availability.
+local last_used, last_notice = {}, {}
+local function binding(class)
+    if class == clsid.obj_medkit then return key_bindings.kUSE_MEDKIT end
+    if class == clsid.obj_bandage then return key_bindings.kUSE_BANDAGE end
+end
+function before_use(item)
+    local bind = item and binding(item:clsid())
+    if bind then last_used[bind] = time_global() end
+end
+function on_key(key, bind)
+    if bind ~= key_bindings.kUSE_MEDKIT and bind ~= key_bindings.kUSE_BANDAGE then return end
+    if not db.actor or db.actor:is_talking() or level.main_input_receiver() then return end
+    local now = time_global()
+    -- Handles either callback order when the key consumed the last item.
+    if last_used[bind] and now-last_used[bind] < 500 then return end
+    if last_notice[bind] and now-last_notice[bind] < 1500 then return end
+    for _, rec in get_shadow_inv():get_content(false):ipairs() do
+        if binding(rec.obj:clsid()) == bind then return end
+    end
+    last_notice[bind] = now
+    local key = bind == key_bindings.kUSE_MEDKIT and "he_local_no_medkit" or "he_local_no_bandage"
+    sak.send_tip_local(game.translate_string(key),game.translate_string("thinking_out_loud"),0,5,"g_g","no","yellow")
+end
+function on_load() last_used={};last_notice={} end
+function attach(sm)
+    sm:subscribe({signal="on_key",fun=this.on_key})
+    sm:subscribe({signal="on_actor_before_use",fun=this.before_use})
+    sm:subscribe({signal="on_late_init_all",fun=this.on_load})
+end
