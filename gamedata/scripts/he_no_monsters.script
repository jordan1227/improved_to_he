local ZONE = "he_yan_base_no_monsters"
local LEVEL = "l08_yantar"
local BANNED_COMM = { zombied = true }

function attach( sm )
	sm:subscribe( { signal = "on_monster_spawn", fun = this.on_monster_spawn } )
	sm:subscribe( { signal = "on_npc_spawn", fun = this.on_npc_spawn } )
end

local function ban( obj )
	if not obj then return end
	if level.name() ~= LEVEL then return end
	local cur = obj:in_restrictions()
	if cur and string.find( cur, ZONE, 1, true ) then return end
	obj:add_restrictions( "", ZONE )
end

function on_monster_spawn( obj )
	ban( obj )
end

function on_npc_spawn( obj )
	if obj and BANNED_COMM[ obj:character_community() ] then ban( obj ) end
end
