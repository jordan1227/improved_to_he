-- [HE-PORT]
local DONE = "he_mil_freedom_reinforced"
local KEY_SLOTS = "nlc.he_mil_frf_slots"
local KEY_NAMES = "nlc.he_mil_frf_names"
local SMART = "mil_freedom"
local LEVEL = "l07_military"
local GV = 1593
local ACTOR_KEEPOUT = 50

local hq = {
	{ -23.0866012573242, -4.11275291442871, -18.2630882263184, 284075 },
	{ -21.4299545288086, -4.11275196075439, -19.3661041259766, 285451 },
	{ -24.4205341339111, -4.11275243759155, -17.8379135131836, 282669 },
	{ -24.8571243286133, -4.11275243759155, -19.3929405212402, 281960 },
	{ -22.0190143585205, -4.11275196075439, -22.9689960479736, 285441 },
	{ -26.1985130310059, -5.69608497619629, -23.2281837463379, 281278 },
	{ -21.3171691894531, -7.36275196075439, -21.1727600097656, 286169 },
	{ -24.5093784332275, -7.36275196075439, -30.8896160125732, 282652 },
	{ -22.1606445312500, -7.36275243759155, -24.7848987579346, 284737 },
	{ -20.9540309906006, -7.36275196075439, -24.5587444305420, 286159 },
}

local slots = {
	"he_mil_freedom_exo",
	"he_mil_freedom_exo",
	"he_mil_freedom_exo",
	"mil_freedom_respawn_1",
	"mil_freedom_respawn_2",
	"mil_freedom_respawn_3",
	"mil_freedom_respawn_1",
	"mil_freedom_respawn_2",
	"mil_freedom_respawn_3",
	"mil_freedom_respawn_1",
	"mil_freedom_respawn_2",
	"mil_freedom_respawn_3",
	"mil_freedom_respawn_1",
	"mil_freedom_respawn_3",
	"mil_freedom_respawn_1",
	"mil_freedom_respawn_sniper",
	"mil_freedom_respawn_2",
	"mil_freedom_respawn_3",
}

SLOTS = #slots

function slot(se_obj)
	if not se_obj then
		return nil
	end
	local map = get_value(KEY_SLOTS, nil)
	return map and map[tostring(se_obj.id)]
end

function is_protected(name)
	if not name or has_alife_info("mil_dolg_gulag_free") then
		return false
	end
	local map = get_value(KEY_NAMES, nil)
	return map ~= nil and map[name] ~= nil
end

local function ready()
	if has_alife_info(DONE) or not has_alife_info("mil_dolg_skull_talk") then
		return false
	end
	if has_alife_info("mil_lukash_dead") or has_alife_info("mil_dolg_dead") or has_alife_info("mil_dolg_gulag_free") then
		return false
	end
	if level.name() == LEVEL then
		local p = hq[1]
		if db.actor:position():distance_to(vector():set(p[1], p[2], p[3])) < ACTOR_KEEPOUT then
			return false
		end
	end
	return true
end

function update()
	if not ready() then
		return
	end
	local sim = alife()
	if not sim then
		return
	end
	db.actor:give_info_portion(DONE)
	local ids, names = {}, {}
	local created = {}
	for i, section in ipairs(slots) do
		local p = (i <= 3) and hq[i] or hq[4 + (i - 4) % (#hq - 3)]
		local sobj = sim:create(section, vector():set(p[1], p[2], p[3]), p[4], GV)
		if sobj then
			ids[tostring(sobj.id)] = i
			names[sobj:name()] = i
			table.insert(created, sobj)
		end
	end
	set_value(KEY_SLOTS, ids)
	set_value(KEY_NAMES, names)
	for _, sobj in ipairs(created) do
		olr_smart_index.attach_to(sobj, SMART)
	end
end
