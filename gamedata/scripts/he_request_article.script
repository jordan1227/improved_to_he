local function treas()
	return get_value("r_treas_items", 1)
end

local function lvl_art()
	local ind = get_value("r_treas_items", 1) + get_value("r_task_reward", 1) - 1
	if ind > 7 or ind < 1 then ind = 7 end
	return ind
end

local quests = {
	{ start = "bar_dolg_petrenko_electra_flash_start", done = "bar_dolg_petrenko_electra_flash_done", pref = "bar_dolg_petrenko_art_req_", n = 7, idx = lvl_art },
	{ start = "gar_dolg_flesh_eye_start", done = "gar_dolg_flesh_eye_done", pref = "gar_dolg_flesh_eye_req_", n = 3, idx = treas },
	{ start = "gar_dolg_psevdodog_tail_start", done = "gar_dolg_psevdodog_tail_done", pref = "gar_dolg_psevdodog_tail_req_", n = 3, idx = treas },
	{ start = "esc_tolik_five_teil_start", done = "esc_tolik_five_teil_done", pref = "esc_tolik_five_teil_req_", n = 3, idx = treas },
	{ start = "esc_fox_medkit_start", done = "esc_fox_medkit_done", pref = "esc_fox_medkit_req_", n = 3, idx = treas },
	{ start = "esc_shustryi_medusa_start", done = "esc_shustryi_medusa_done", pref = "esc_shustryi_medusa_req_", n = 7, idx = lvl_art },
	{ start = "val_dram_bandit_glavn_yes", done = "val_dram_glavn_spas_done", pref = "val_dram_bandit_glavn_req_", n = 3, idx = treas },
}

local function sync(q)
	local actor = db.actor
	if not actor or not actor:has_info(q.start) or actor:has_info(q.done) then return end
	for i = 1, q.n do
		if actor:has_info(q.pref .. i) then return end
	end
	local i = q.idx()
	if i >= 1 and i <= q.n then
		actor:give_info_portion(q.pref .. i)
	end
end

function on_info(npc, info_id)
	for _, q in ipairs(quests) do
		if info_id == q.start then sync(q) end
	end
end

function on_safe_spawn()
	for _, q in ipairs(quests) do sync(q) end
end

function attach(sm)
	sm:subscribe({ signal = "on_info_2", fun = this.on_info })
	sm:subscribe({ signal = "on_safe_spawn", fun = this.on_safe_spawn })
end
