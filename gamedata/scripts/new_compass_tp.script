end

function create_level_changer( p_dest_lv, p_dest_gv, p_dest_pos )
	local p_story_id = 987986
	local p_position = db.actor:position()
	local p_lvertex_id = db.actor:level_vertex_id()
	local p_gvertex_id = db.actor:game_vertex_id()
	local p_dest_dir = vector():set( 0, 0, 0 )
	local p_dest_level = level.name()
	local p_silent = 1

	local sim = alife()
	local obj = sim:create( "level_changer", p_position, p_lvertex_id, p_gvertex_id )
	set_value( "nlc_vars.compass_lc_id", obj.id )

	local packet = net_packet()
	obj:STATE_Write( packet )

	local game_vertex_id				= packet:r_u16()
	local cse_alife_object__unk1_f32	= packet:r_float()
	local cse_alife_object__unk2_u32	= packet:r_u32()
	local level_vertex_id				= packet:r_u32()
	local object_flags					= packet:r_u32()
	local custom_data					= packet:r_stringZ()
	local story_id						= packet:r_u32()
	local spawn_story_id				= packet:r_u32()

	local shape_count = packet:r_u8()
	for i = 1, shape_count do
		local shape_type = packet:r_u8()
		if shape_type == 0 then
			local center = packet:r_vec3()
			local radius = packet:r_float()
		else
			for j = 1, 12 do local f = packet:r_float() end
		end
	end

	local restrictor_type		= packet:r_u8()

	local dest_game_vertex_id	= packet:r_u16()
	local dest_level_vertex_id	= packet:r_u32()
	local dest_position			= packet:r_vec3()
	local dest_direction		= packet:r_vec3()
	local dest_level_name		= packet:r_stringZ()
	local dest_graph_point		= packet:r_stringZ()
	local silent_mode			= packet:r_u8()

	packet:w_begin( game_vertex_id )
	packet:w_float( cse_alife_object__unk1_f32 )
	packet:w_u32( cse_alife_object__unk2_u32 )
	packet:w_u32( level_vertex_id )
	packet:w_u32( bit_not( 193 ) )
	packet:w_stringZ( custom_data )
	packet:w_u32( p_story_id )
	packet:w_u32( spawn_story_id )

	packet:w_u8( 1 )
	packet:w_u8( 1 )
	packet:w_float( 50 )
	packet:w_float( 0 )
	packet:w_float( 0 )
	packet:w_float( 0 )
	packet:w_float( 50 )
	packet:w_float( 0 )
	packet:w_float( 0 )
	packet:w_float( 0 )
	packet:w_float( 50 )
	packet:w_float( 0 )
	packet:w_float( 0 )
	packet:w_float( 0 )

	packet:w_u8( 3 )

	packet:w_u16( p_dest_gv )
	packet:w_s32( p_dest_lv )
	packet:w_vec3( p_dest_pos )
	packet:w_vec3( p_dest_dir )
	packet:w_stringZ( p_dest_level )
	packet:w_stringZ( "start_actor_02" )
	packet:w_u8( p_silent )

	packet:r_seek( 0 )
	obj:STATE_Read( packet, packet:w_tell() )
	timers.start_timer( "delete_changer", 0, 0, 5, "new_compass_tp.delete_spawned_changer()" )
end

function delete_spawned_changer()
	local id = get_value( "nlc_vars.compass_lc_id" )
	if not id then return end
	local obj = g_sim:object( id )
	if obj then
		misc.release_obj( obj )
	end
	remove_value( "nlc_vars.compass_lc_id" )
end
