-- [HE-PORT]

function attach( sm )
	sm:subscribe({ signal = "on_item_to_belt", fun = this.on_item_to_belt })
end

local function item_cond( obj, default )
	if not obj then return default end
	return obj:condition() or default
end

local function set_item_cond( obj, value )
	if not obj then return end
	if value < 0 then value = 0 end
	if value > 1 then value = 1 end
	obj:set_condition( value )
end

local accum_sections = {
	[ "af_full_akkum" ]     = true,
	[ "af_full_akkum_big" ] = true
}

function get_charged_accum()
	local accum = sak.get_accum()
	if accum and accum_sections[ accum:section() ] and accum:condition() >= 0.75 then
		return accum
	end
	local found
	db.actor:iterate_inventory(
	function( npc, item )
		if not found and accum_sections[ item:section() ] and item:condition() >= 0.75 then
			found = item
		end
	end, db.actor )
	return found
end

function on_item_to_belt( obj, sobj )
	if not obj then return end
	local sect = obj:section()
	if sect ~= "af_red_dummy_compass" then return end

	if get_value( "nlc_vars.compass_tp_id" ) ~= nil then
		sak.send_tip(
			"Компас разряжен. Нужно подождать!",
			"Ёшкин-кот!", 2, 7, "g_g", "sak", "red"
		)
		return
	end

	local accum = get_charged_accum()
	if accum == nil then
		sak.send_tip(
			"Вроде никаких изменений. Может попробовать с заряженным аккумулятором?",
			"Хм...", 2, 7, "g_g", "sak", "yellow"
		)
		return
	end
	set_item_cond( accum, item_cond( accum, 0.99 ) - 0.5 )

	local compass_cond = item_cond( obj, 0.99 )
	if compass_cond > 0.1 then
		set_item_cond( obj, compass_cond - 0.1 )
	else
		misc.release_obj( obj:id() )
	end

	if level.main_input_receiver() then
		schedule.add( "close_window", "sak.close_window()", 100 )
	end
	effectors()
end

function effectors()
	vergas_art.scheme_2()
	db.actor.health = - 0.2
	db.actor.psy_health = - 0.4
	for _, v in pairs({
		"anomaly2\\emi_entrance_big_00",
		"anomaly2\\teleport_out_00",
		"anomaly2\\emi_entrance_big_00"
	}) do
		local particle	= particles_object( v )
		local sound		= sound_object( "anomaly\\teleport_work_2" )
		local actor		= db.actor
		local act_pos	= actor:position()
		local dir		= device().cam_dir
		local a			= vector() a.y = math.atan2( dir.x, dir.z )
		local xdelta	= math.sin( a.y )
		local zdelta	= math.cos( a.y )
		local pos_blast	= sak.v3f( ( act_pos.x + xdelta ), ( act_pos.y + 0.6 ), ( act_pos.z + zdelta ) )
		particle:play_at_pos( pos_blast )
		sound:play_at_pos( actor, pos_blast, 0 )
	end
	schedule.add( "create_compass_tp", "new_compass_tp.create_tp_restrictor()", 600 )
end

function pos_in_front_of_actor()
	local actr   = db.actor
	local dir    = device().cam_dir
	local a      = vector()
	a.y          = math.atan2( dir.x, dir.z )
	local xdelta = math.sin( a.y )
	local pos    = actr:position()
	return sak.v3f( ( pos.x + xdelta ), ( pos.y + 0.3 ), ( pos.z - 7 ) )
end

function create_tp_restrictor()
	local pos   = pos_in_front_of_actor()
	local shape = { shtype = 0, radius = 2.0, center = { 0, 0.5, 0 } }
	local lvid, gvid = db.actor:level_vertex_id(), db.actor:game_vertex_id()

	local obj = amk_anoms.spawn_anomaly( "zone_teleport_4", pos, gvid, lvid, shape, "on" )
	if not obj then return end
	set_value( "nlc_vars.compass_tp_id", obj.id )
	level.map_add_object_spot_ser( obj.id, "alife_presentation_smart_target", "Телепорт" )
	timers.start_timer( "compass_tp_timer", 1, 0, 0, "new_compass_tp.release_compass_tp()" )

	local sr_obj = alife():create( "space_restrictor", vector():set( pos ), lvid, gvid )
	if sr_obj then
		set_value( "nlc_vars.compass_sr_id", sr_obj.id )
		local custom = "[logic]\n"..
		"active = sr_idle\n"..
		"[sr_idle]\n"..
		"on_actor_inside = %=new_compass_tp.move_to()%"
		kotovod_restrictors.rewrite_restrictor( sr_obj, custom, 3.0 )
	end
	info_arts()
end

function release_compass_tp()
	local tp_id  = get_value( "nlc_vars.compass_tp_id" )
	local location
	if tp_id then
		local tp_obj = g_sim:object( tp_id )
		if tp_obj then location = get_lname( tp_obj.m_game_vertex_id ) end
		sak.send_tip(
			"Прекращено действие телепортационной аномалии",
			location, 0, 10, "g_g", "sak", "yellow"
		)
		level.map_remove_object_spot( tp_id, "alife_presentation_smart_target" )
		if tp_obj then misc.release_obj( tp_obj ) end
		remove_value( "nlc_vars.compass_tp_id" )
	end

	local sr_id = get_value( "nlc_vars.compass_sr_id" )
	if sr_id then
		misc.release_obj( sr_id )
		remove_value( "nlc_vars.compass_sr_id" )
	end

	local rest = g_sim:story_object( 987986 )
	if rest then misc.release_obj( rest ) end
end

function get_lname( num )
	local name = "???"
	for k, v in pairs( const.game_vertices ) do
		if num >= v[ 1 ] and num <= v[ 2 ] then
			name = k
			return game.translate_string( name )
		end
	end
	return name
end

function info_arts()
	local tbl = {
		[ "info_compass_tp_escape" 		] = "Кордон - \"Бенгальский огонь\"",
		[ "info_compass_tp_valley"		] = "Тёмная Долина - \"Капля\"",
		[ "info_compass_tp_yantar"		] = "Янтарь - \"Колючка\"",
		[ "info_compass_tp_limansk"		] = "Лиманск - \"Слизь\"",
		[ "info_compass_tp_military"	] = "Арм. Склады - \"Медуза\""
	}
	local text = ""
	for k, v in pairs( tbl ) do
		if has_alife_info( k ) then
			text = text .. v .. "\\n"
		end
	end
	if text == "" then return end
	sak.send_tip( text, "Известные пути для телепортации", 0, 10, "g_g", "sak", "yellow" )
end

