				{ gv =  854, lv = 158415, x =  -12.589, y =  -3.947, z = -261.689 },
				{ gv =  955, lv = 318641, x =  121.242, y =   8.845, z = -262.865 },
				{ gv =  986, lv = 288644, x =   93.461, y =   4.220, z =  -12.916 },
			}
		},

		[ "info_compass_tp_yantar" 		] = {
			artefact = "af_rusty_thorn",
			position = {
				{ gv = 1523, lv = 123270, x =  152.747, y =  12.673, z =   11.723 },
				{ gv = 1487, lv =  16150, x =  -63.649, y =  -4.403, z = -341.022 },
				{ gv = 1438, lv = 132306, x =  169.365, y =   4.278, z = -245.285 },
				{ gv = 1451, lv = 134043, x =  177.652, y =  -7.238, z = -103.651 },
				{ gv = 1469, lv =  48813, x =   17.769, y =  -3.376, z = -200.974 }
			}
		},
		[ "info_compass_tp_limansk"		] = {
			artefact = "af_ameba_slime",
			position = {
				{ gv = 3023, lv =  47129, x =   37.541, y =   6.182, z =  311.764 },
				{ gv = 2995, lv =  20956, x = 	-7.697, y =  -4.976, z = -176.255 },
				{ gv = 2994, lv =   3853, x =  -47.281, y =  -0.960, z = -257.800 },
				{ gv = 3008, lv =  24480, x =   -0.004, y =   4.654, z = -286.390 },
				{ gv = 3015, lv =  45566, x =   35.806, y =   1.045, z =   43.125 }
			}
		},
		[ "info_compass_tp_military" 	] = {
			artefact = "af_medusa",
			position = {
				{ gv = 1795, lv =  29510, x = -316.212, y = -22.447, z = 207.789 },
				{ gv = 1847, lv =   4172, x = -361.645, y = -13.623, z = 387.021 },
				{ gv = 1548, lv = 382792, x =   85.995, y =  -6.544, z = 384.119 },
				{ gv = 1642, lv = 405173, x =  112.633, y = -11.681, z = 164.790 },
				{ gv = 1638, lv = 339325, x =   35.506, y =  -2.193, z =  90.568 }
			}
		}
	}
	local amount = 0
	for k, v in pairs( teleport ) do
		if has_alife_info( k ) then
			for ii, kk in pairs( sak_inventory.belt_items ) do
				if
					strpos( ii, v.artefact, 1, true )
					and not strpos( ii, "_dyn6d", 1, true )
					and ( tonumber( string.sub( ii, -2, -2 ) ) >= 1 )
				then
					if amount == 1 then return end
					local obj = client_obj( kk[ 1 ] )
					misc.release_obj( obj )
					level.add_pp_effector( "teleport.ppe", 2006, false )
					local a = teleport[ k ].position[ lua_random( 1, 5 ) ]
