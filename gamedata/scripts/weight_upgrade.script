-- [HE-PORT]

local UPGRADE_HOURS = 12
local UPGRADE_MAX   = 40
local TICK_MS       = 1000
local KEY           = "nlc_vars.weight_upgrade"

local tf  = system_ini():r_float( "alife", "time_factor" )
local inc = 1 / ( UPGRADE_HOURS * 3600 / tf )

local upgrade     = 0
local upgrade_cur = 0

local function apply()
	local v = math.floor( upgrade )
	if v == upgrade_cur and sak.mass_add == v then return end
	upgrade_cur  = v
	sak.mass_add = v
	if not sleep_manager.sleeping then
		params.max_item_mass_add( 0 )
	end
end

function get_upgrade()
	return upgrade
end

local function moved()
	return get_actor_obj():is_actor_moving()
end

local function overloaded()
	return db.actor:get_inventory_weight() > db.actor:get_max_weight()
end

local function on_update()
	ogse_signals.get_mgr():reschedule( TICK_MS )
	if not db.actor or not db.actor:alive() then return end
	if upgrade < UPGRADE_MAX and not overloaded() and moved() then
		upgrade = upgrade + inc
		if upgrade > UPGRADE_MAX then upgrade = UPGRADE_MAX end
		set_value( KEY, upgrade )
	end
	apply()
end

local function on_first_update()
	upgrade = get_value( KEY, 0 ) or 0
	apply()
	log2( "[weight_upgrade]: %.3f kg (cap %d, %d game hours per kg)",
		upgrade, UPGRADE_MAX, UPGRADE_HOURS )
end

function attach( sm )
	sm:subscribe( { signal = "on_first_update", fun = on_first_update } )
	sm:subscribe( { signal = "on_update",       fun = on_update       } )
end
