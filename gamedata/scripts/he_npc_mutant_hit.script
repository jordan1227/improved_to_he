-- [HE-PORT]
local rank_mul = {
	novice      = 3.5,
	experienced = 3.0,
	veteran     = 2.5,
	master      = 2.0,
}

function attach( sm )
	sm:subscribe({ signal = "on_npc_before_hit", fun = this.on_npc_before_hit })
end

function on_npc_before_hit( npc, hit_data )
	if not ( npc and hit_data ) or hit_data.ignore_hit then return end
	local ht = hit_data.hit_type
	if ht ~= hit.wound and ht ~= hit.strike then return end
	local who = hit_data.who
	if not who and hit_data.who_id then who = level.object_by_id( hit_data.who_id ) end
	if not ( who and who:is_monster() and who:alive() ) then return end
	local rn = xr_motivator.reinforced_npcs
	if rn and ( rn[ npc:name() ] or rn[ npc:profile_name() ] ) then return end
	local mul = rank_mul[ ranks.get_obj_rank_name( npc ) ] or 3.0
	hit_data.power = ( hit_data.power or 0 ) * mul
end
