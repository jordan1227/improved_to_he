-- [HE-PORT]
local pack = {
	"esc_dog_weak",
	"esc_dog_weak_0000",
	"esc_dog_weak_0001",
	"esc_dog_weak_0003",
	"esc_dog_weak_0004",
	"esc_fox_pseudodog_01",
	"esc_fox_pseudodog_02"
}

local wave_key = "he_fox_wave"

function register_wave_monster( id )
	if not id then
		return
	end
	set_value( wave_key, get_value( wave_key, "" ) .. tostring( id ) .. "," )
end

local function pack_alive()
	local sim = alife()
	if not sim then
		return true
	end
	for i = 1, #pack do
		local se = sim:object( pack[ i ] )
		if se and se:alive() then
			return true
		end
	end
	return false
end

local function wave_alive()
	local ids = get_value( wave_key, "" )
	if ids == "" then
		return false
	end
	local sim = alife()
	if not sim then
		return true
	end
	for id in string.gmatch( ids, "(%d+)," ) do
		local se = sim:object( tonumber( id ) )
		if se and se:alive() then
			return true
		end
	end
	return false
end

function attack_over()
	if not has_alife_info( "escape_stalker_done" ) then
		return false
	end
	if timers.check_timer( "t1_lys_monsters" ) or timers.check_timer( "t2_lys_monsters" ) then
		return false
	end
	return not pack_alive() and not wave_alive()
end
