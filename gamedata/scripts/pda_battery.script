-- [HE-PORT]
local FULL_COND = 1.0
local NEED_COND = 0.95
local ART_GROUP = "pda_charge"
local HEARTBEAT_MS = 5000
local LAST_KEY = "he_pda_last_upd"
local NPC_KEY = "he_pda_charge_npc"
local READY_KEY = "he_pda_charge_ready"
local CHARGE_TIME = { vergas = 60, docent = 30, semenov = 15 }

local total_minutes = nil

function attach( sm )
	sm:subscribe( { signal = "on_update", fun = this.on_update } )
end

local function get_total_minutes()
	if not total_minutes then
		total_minutes = get_string( "device_pda", "active_time", -1 ) * 60
	end
	return total_minutes
end

function on_update()
	ogse_signals.get_mgr():reschedule( HEARTBEAT_MS )

	local pda = get_pda()
	if not pda then return end

	local total = get_total_minutes()
	if total <= 0 then return end

	local now = timers.Get_Game_Minutes()
	local last = get_value( LAST_KEY )
	local cond = pda:condition()

	if not last or last > now or cond <= 0 then
		set_value( LAST_KEY, now )
		return
	end

	local delta = now - last
	if delta < 1 then return end
	set_value( LAST_KEY, now )

	local new_cond = cond - delta / total
	if new_cond > 0 then
		pda:set_condition( new_cond )
		return
	end

	sak.send_tip( "0%", game.translate_string( "pda_battery_status_msg" ), 3, 10, "pribor", "pda_news", "red" )
	pda:set_condition( 0 )
	bind_pda.disable_pda()
	if not db.actor:object( "device_pda_discharged_gg" ) then
		misc.spawn_to( "device_pda_discharged_gg", db.actor )
	end
end

function is_charging()
	return get_value( NPC_KEY ) ~= nil
end

function news_blocked()
	if not db.actor then return false end
	if is_charging() then return true end
	local pda = db.actor:object( "device_pda" )
	if not pda then return false end
	return pda:condition() <= 0
end

function get_pda()
	if not db.actor then return nil end
	return db.actor:object( "device_pda" )
end

function get_percent()
	local pda = get_pda()
	if not pda then return nil end
	local cond = pda:condition()
	if cond < 0 then cond = 0 end
	if cond > 1 then cond = 1 end
	return math.floor( cond * 100 + 0.5 )
end

function is_empty()
	local pda = get_pda()
	if not pda then return false end
	return pda:condition() <= 0
end

function need_charge()
	local pda = get_pda()
	if not pda then return false end
	if db.actor:has_info( "pda_is_broken" ) then return false end
	return pda:condition() < NEED_COND
end

function show()
	local pct = get_percent()
	if not pct then return end
	sak.send_tip( pct .. "%", game.translate_string( "pda_battery_status_msg" ), 0, 7, "pribor", "no", "green" )
end

function art_have()
	return kotovod.gg_inventory_artefacts( ART_GROUP, "have", 1 ) == true
end

function can_charge()
	if is_charging() then return false end
	return need_charge()
end

local function taken_by( npc )
	return get_value( NPC_KEY ) == npc
end

function taken_by_vergas()  return taken_by( "vergas" )  end
function taken_by_docent()  return taken_by( "docent" )  end
function taken_by_semenov() return taken_by( "semenov" ) end

local function take( npc )
	if is_charging() then return end
	if not art_have() then return end
	kotovod.gg_inventory_artefacts( ART_GROUP, "give", 1 )
	local pda = get_pda()
	if pda then misc.release_obj( pda ) end
	sak_inventory.release_actor_items( "device_pda_discharged_gg", 1, true )
	set_value( NPC_KEY, npc )
	set_value( READY_KEY, timers.Get_Game_Minutes() + ( CHARGE_TIME[ npc ] or 60 ) )
	level.set_actor_allow_pda( false )
end

function take_vergas()  take( "vergas" )  end
function take_docent()  take( "docent" )  end
function take_semenov() take( "semenov" ) end

function is_ready()
	local ready = get_value( READY_KEY )
	if not ready then return false end
	return timers.Get_Game_Minutes() >= ready
end

function not_ready()
	return is_charging() and not is_ready()
end

function give_back()
	remove_value( NPC_KEY )
	remove_value( READY_KEY )
	set_value( LAST_KEY, timers.Get_Game_Minutes() )
	if not db.actor:object( "device_pda" ) then
		misc.spawn_to( "device_pda", db.actor )
	end
	bind_pda.enable_pda()
	sak.send_tip( "100%", game.translate_string( "pda_battery_status_msg" ), 3, 10, "pribor", "pda_news", "green" )
end

function force_return()
	set_value( READY_KEY, 0 )
	give_back()
end
