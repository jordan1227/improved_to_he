LegsTbl = {}

class "se_legs" (cse_alife_monster_base)

se_legs.LegsTbl = LegsTbl

function se_legs:__init(section)
	super(section)
end

function se_legs:can_switch_offline()
	return false
end

function se_legs:can_switch_online()
	return true
end

local function level_name_for_body(body)
	local sim = alife()
	local graph = game_graph()
	if not sim or not graph then
		return nil
	end

	local vertex = graph:vertex(body.m_game_vertex_id)
	if not vertex then
		return nil
	end

	return sim:level_name(vertex:level_id())
end

function se_legs:on_register()
	cse_alife_monster_base.on_register(self)

	local level_name = level_name_for_body(self)
	if level_name then
		LegsTbl[level_name] = self.id
	end
end

function se_legs:on_unregister()
	local level_name = level_name_for_body(self)
	if level_name and LegsTbl[level_name] == self.id then
		LegsTbl[level_name] = nil
	end

	cse_alife_monster_base.on_unregister(self)
end
