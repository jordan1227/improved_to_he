-- [HE-PORT]

local INI_PATH = "misc\\he_short_story.ltx"
local SECT     = "short_story"
local KEY      = "he_short_story_done"

local DEF = {
	from_level = "warlab",
	gate_info  = "war_zone_sleeps",
	gv         = 2404,
	lv         = 71,
	x          = -29.02,
	y          = 0.21,
	z          = 34.35,
	delay      = 2000,
}

local function ini()
	return dsh.cached_ini_file( INI_PATH )
end

local function r_num( i, key, def )
	if i and i:section_exist( SECT ) and i:line_exist( SECT, key ) then
		return i:r_float( SECT, key )
	end
	return def
end

local function r_int( i, key, def )
	return math.floor( r_num( i, key, def ) )
end

local function r_str( i, key, def )
	if i and i:section_exist( SECT ) and i:line_exist( SECT, key ) then
		return i:r_string( SECT, key )
	end
	return def
end

function enabled()
	return game_options.ShortStory == true
end

function done()
	return get_value( KEY, 0 ) == 1
end

function attach( sm )
	sm:subscribe( { signal = "on_sleep_finished", fun = this.on_sleep_finished } )
end

function on_sleep_finished( hours )
	if not db.actor then return end
	if not enabled() then return end
	if done() then return end

	local i = ini()
	if level.name() ~= r_str( i, "from_level", DEF.from_level ) then return end

	local gate = r_str( i, "gate_info", DEF.gate_info )
	if gate ~= "" and not db.actor:has_info( gate ) then return end

	set_value( KEY, 1 )
	schedule.add( "he_short_story_jump", "he_short_story.jump()", r_int( i, "delay", DEF.delay ) )
end

function jump()
	if not db.actor then return end

	local i = ini()
	local pos = vector():set( r_num( i, "x", DEF.x ), r_num( i, "y", DEF.y ), r_num( i, "z", DEF.z ) )

	level.add_pp_effector( "black_q.ppe", 1236, false )
	spawner.create_level_changers( r_int( i, "lv", DEF.lv ), r_int( i, "gv", DEF.gv ), pos )
end
