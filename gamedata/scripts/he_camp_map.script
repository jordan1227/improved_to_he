-- Camp layer of the upgraded PDA map: campfires and candles the player has been within 5 m of.
-- Discovery runs from ogse_campfire.scan_npc_near_campfires (already once per 1 to 1.5 s over the loaded
-- fires): one squared-distance test per fire, a saved write only for a new one. Spots sit on the existing
-- fire/candle server objects (no user-marker ids are used). A fire that burns now shows the "lit" icon,
-- every other known fire the "known" icon; the layer toggle only hides the spot types
-- (he_pda_layers.apply). docs/PDA_UPGRADE_DESIGN.md section 3.
local KEY = "he_known_fires_v1" -- [light id] = { name, lvl, kind }
local DISCOVER_SQR = 25 -- 5 m
local KNOWN, LIT = "campfire_known", "campfire_lit"

local function data()
	local d = get_value(KEY)
	if type(d) ~= "table" then d = {} end
	return d
end

local function sync_spot(id, want)
	local other = (want == LIT) and KNOWN or LIT
	if level.map_has_object_spot(id, other) ~= 0 then level.map_remove_object_spot(id, other) end
	if level.map_has_object_spot(id, want) ~= 0 then return end
	local sobj = alife():object(id)
	if not sobj then return end
	-- UpdateSpot drops spots of server objects that are not flagged visible for the map
	sobj:visible_for_map(true)
	level.map_add_object_spot_ser(id, want, "")
end

-- Called for every loaded fire in the actor scan; pos and apos are already at hand there.
function check(id, kamp, pos, apos)
	if not kamp.scan_time then return end -- the binder has not classified this light yet
	if pos:distance_to_sqr(apos) >= DISCOVER_SQR then return end
	local d = data()
	if d[id] then return end
	d[id] = { name = kamp.object:name(), lvl = level.name(), kind = kamp.is_candle and "candle" or "fire" }
	set_value(KEY, d)
	sync_spot(id, kamp.can_save and LIT or KNOWN)
	log2("[he_camp_map] discovered %s id=%s level=%s", d[id].name, tostring(id), d[id].lvl)
end

-- Makes every known fire's spot match its state: lit now (loaded and burning) or just known.
-- Also restores spots that went missing. Cheap enough for the map tab; not run per frame.
function refresh()
	if not db.actor then return end
	for id in pairs(data()) do
		local kamp = ogse_campfire.get_light(id)
		sync_spot(id, (kamp and kamp.can_save) and LIT or KNOWN)
	end
end

function on_load() refresh() end

function attach(sm)
	sm:subscribe({ signal = "on_late_init_all", fun = this.on_load })
end
