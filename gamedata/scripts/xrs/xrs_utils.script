-- -*- mode: lua; coding: windows-1251-dos -*-
-- [HE-PORT]

local SMART_SECTION = "smart_terrains"

local read_cd = setmetatable({}, { __mode = "k" })

local function stamp(tbl, cd)
	cd = cd or ""
	tbl.custom_data = cd
	tbl.custom = cd
	read_cd[tbl] = cd
	return tbl
end

local function read_params(sobj)
	if not sobj then return stamp({}, "") end
	local pk = get_netpk(sobj, 1)
	if not pk then return stamp({}, "") end
	local data = pk:get() or {}
	return stamp(data, data.custom_data or data.custom)
end

local function write_params(tbl, sobj)
	if not (tbl and sobj) then return false end
	local pk = get_netpk(sobj, 1)
	if not pk then return false end
	local seen = read_cd[tbl]
	local cd
	if tbl.custom ~= nil and tbl.custom ~= seen then
		cd = tbl.custom
	elseif tbl.custom_data ~= nil then
		cd = tbl.custom_data
	else
		cd = tbl.custom
	end
	cd = cd or ""
	tbl.custom_data = cd
	tbl.custom = nil
	pk:set(tbl)
	stamp(tbl, cd)
	return true
end

local function strip_section(cd, name)
	if not cd or cd == "" then return "" end
	local out = {}
	local skip = false
	for line in string.gmatch(cd .. "\n", "([^\r\n]*)\r?\n") do
		local sect = string.match(line, "^%s*%[%s*([^%]]-)%s*%]")
		if sect then
			skip = (string.lower(sect) == name)
		end
		if not skip then
			table.insert(out, line)
		end
	end
	local res = table.concat(out, "\n")
	res = string.gsub(res, "%s+$", "")
	return res
end

function read_stalker_params(sobj)
	return read_params(sobj)
end

function write_stalker_params(tbl, sobj)
	return write_params(tbl, sobj)
end

function read_monster_params(sobj)
	return read_params(sobj)
end

function write_monster_params(tbl, sobj)
	return write_params(tbl, sobj)
end

function get_custom_data(sobj)
	return read_params(sobj).custom_data
end

function set_custom_data(sobj, str)
	local params = read_params(sobj)
	params.custom_data = str or ""
	params.custom = params.custom_data
	return write_params(params, sobj)
end

function refresh_smart_terrain_conditions(sobj, smart_name)
	if not (sobj and smart_name) then return end
	local conds = {}
	conds[smart_name] = xr_logic.parse_condlist(sobj, SMART_SECTION, smart_name, "true")
	sobj.smart_terrain_conditions = conds
	sobj.has_none_true = (smart_name == "none")
end

function set_smart_terrain(sobj, smart_name)
	if not (sobj and smart_name) then return false end
	local params = read_params(sobj)
	local base = strip_section(params.custom_data, SMART_SECTION)
	local cd = (base ~= "") and (base .. "\n") or ""
	cd = cd .. "\n[" .. SMART_SECTION .. "]\n" .. smart_name .. " = true\n"
	params.custom_data = cd
	params.custom = cd
	if not write_params(params, sobj) then return false end
	refresh_smart_terrain_conditions(sobj, smart_name)
	return true
end

function clear_smart_terrain(sobj)
	if not sobj then return false end
	local params = read_params(sobj)
	local cd = strip_section(params.custom_data, SMART_SECTION)
	if cd ~= "" then cd = cd .. "\n" end
	params.custom_data = cd
	params.custom = cd
	if not write_params(params, sobj) then return false end
	sobj.smart_terrain_conditions = nil
	sobj.has_none_true = false
	return true
end
