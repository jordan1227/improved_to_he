-- [HE-PORT]
local REFRESH_MS = 2000

local names, ids = {}, {}
local stamp = nil

local function add_list( list, sim )
	if type( list ) ~= "table" then return end
	for _, v in pairs( list ) do
		if type( v ) == "table" and v.id and not ( type( v.tips ) == "string" and string.sub( v.tips, 1, 9 ) == "fake_new_" ) then
			local obj = sim:object( v.id )
			if obj then
				ids[ v.id ] = true
				names[ obj:name() ] = true
			end
		end
	end
end

local function refresh()
	local t = time_global()
	if stamp and t >= stamp and t - stamp < REFRESH_MS then return end
	stamp = t
	names, ids = {}, {}
	local sim = alife()
	if not sim then return end
	add_list( get_value( "npc_targets" ), sim )
	add_list( get_value( "kill_targets" ), sim )
end

function is_locked( name )
	if not name then return false end
	if sivol_worldspawns.kishka_is_locked_name( name ) then return true end
	if sivol_worldspawns.convoy_is_locked_name( name ) then return true end
	refresh()
	return names[ name ] == true
end

function is_locked_id( id )
	if not id then return false end
	if sivol_worldspawns.kishka_is_locked_id( id ) then return true end
	if sivol_worldspawns.convoy_is_locked_id( id ) then return true end
	refresh()
	return ids[ id ] == true
end
