local NPC_STORY_ID = 9528
local INFO_AT_CHAIR = "he_kruglov_at_chair"
local SWITCH_MINUTES = 1440
local HEARTBEAT_MS = 5000
local SAFE_DIST = 15
local NEAR_DIST = 6
local LAST_KEY = "he_kruglov_switch"

local STAND = { x = 22.190170, y = -11.534305, z = -267.208649, lv = 49893, gv = 1480 }
local CHAIR = { x = 31.246515, y = -11.718932, z = -264.620575, lv = 54833, gv = 1480 }

function attach( sm )
	sm:subscribe( { signal = "on_update", fun = this.on_update } )
end

local function unseen( sobj )
	local cl = level.object_by_id( sobj.id )
	if not cl then return true end
	local dist = cl:position():distance_to( db.actor:position() )
	if dist >= SAFE_DIST then return true end
	if dist >= NEAR_DIST and not cl:see( db.actor ) then return true end
	return false
end

local function place( sobj, point )
	local pos = vector():set( point.x, point.y, point.z )
	alife():teleport_object( sobj.id, pos, point.lv, point.gv )
	local cl = level.object_by_id( sobj.id )
	if cl and cl.set_npc_position then cl:set_npc_position( pos, true ) end
end

function on_update()
	ogse_signals.get_mgr():reschedule( HEARTBEAT_MS )

	if not db.actor then return end
	local sim = alife()
	if not sim then return end
	local sobj = sim:story_object( NPC_STORY_ID )
	if not sobj then return end

	local now = timers.Get_Game_Minutes()
	local last = get_value( LAST_KEY )
	if not last or last > now then
		set_value( LAST_KEY, now )
		return
	end
	if now - last < SWITCH_MINUTES then return end
	if not unseen( sobj ) then return end

	if has_alife_info( INFO_AT_CHAIR ) then
		place( sobj, STAND )
		db.actor:disable_info_portion( INFO_AT_CHAIR )
	else
		place( sobj, CHAIR )
		db.actor:give_info_portion( INFO_AT_CHAIR )
	end
	set_value( LAST_KEY, now )
end
