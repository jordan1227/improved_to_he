class "PhantomManager"
function PhantomManager:__init()
	self.phantom_count = 0
	self.psy_variants = {}
end
g_PhantomManager = PhantomManager()

function PhantomManager:add_phantom()
	self.phantom_count = self.phantom_count + 1
end
function PhantomManager:remove_phantom()
	self.phantom_count = self.phantom_count - 1
end
function PhantomManager:spawn_phantom(pos)
	level.spawn_phantom(pos)
end

function PhantomManager:prune_psy_variants()
	for id, _ in pairs(self.psy_variants) do
		local obj = alife():object(id)
		local alive = false
		if obj then
			local ok, result = pcall(function() return obj:alive() end)
			alive = ok and result == true
		end
		if not alive then self.psy_variants[id] = nil end
	end
end

-- This helper is intentionally limited to engine-backed phantom sections such
-- as psy_dog_phantom. Arbitrary monster/stalker sections do not automatically
-- inherit one-hit disappearance, loot suppression, or phantom cleanup rules.
function PhantomManager:spawn_psy_variant(section, pos, level_vertex_id, game_vertex_id)
	local obj = alife():create(section, pos, level_vertex_id, game_vertex_id)
	if not obj then return nil end
	self.psy_variants[obj.id] = section
	return obj.id
end

function PhantomManager:psy_variant_count()
	self:prune_psy_variants()
	local count = 0
	for _ in pairs(self.psy_variants) do count = count + 1 end
	return count
end

class "Phantom"		(object_binder)
function Phantom:__init(obj) super(obj)
	g_PhantomManager:add_phantom()
end
function Phantom:net_destroy()
	g_PhantomManager:remove_phantom()
end
function bind(obj)
	obj:bind_object(Phantom(obj))
end

function spawn_phantom(pos)
	g_PhantomManager:spawn_phantom(pos)
end
function phantom_count()
	return g_PhantomManager.phantom_count
end
function spawn_psy_variant(section, pos, level_vertex_id, game_vertex_id)
	return g_PhantomManager:spawn_psy_variant(section, pos, level_vertex_id, game_vertex_id)
end
function psy_variant_count()
	return g_PhantomManager:psy_variant_count()
end
