-- [HE-PORT]
local hos_ladder_drop = {
	hos_stolb = true, hos_bochka_up_hole_2 = true, hos_bochka_up_hole_3 = true,
	hos_box_up_hole_1 = true, hos_box_up_hole_2 = true, hos_box_up_hole_3 = true,
	hos_box_up_hole_4 = true, hos_box_up_hole_5 = true, hos_box_up_hole_6 = true
}

function hos_ladder_old_save()
	if get_value( "hos_ladder_fixed" ) then return end
	local drop, ladder = {}, nil
	for id, o in alife():objects() do
		local n = o:name()
		if hos_ladder_drop[ n ] then
			if o.online then return end
			table.insert( drop, id )
		elseif n == "hos_lestnica" then
			if o.online then return end
			ladder = o
		end
	end
	if ladder then
		local pk = get_netpk( ladder )
		if not pk then return end
		local data = pk:get()
		local shp = data.shapes:get( 1 )
		if not shp then return end
		shp:setBox( vector():set( 0.6, 0, 0 ), vector():set( 0, 3.45, 0 ), vector():set( 0, 0, 0.1 ), vector():set( 0, 0, 0 ) )
		pk:set( data )
		ladder.position = vector():set( -87.234, 28.494, 769.711 )
		ladder.angle = vector():set( 0.482, 1.806, 0 )
	end
	for _, id in ipairs( drop ) do misc.release_obj( id ) end
	set_value( "hos_ladder_fixed", true )
end

