local rostok_fraer_lvid = {
	{ sid = 9515, o = 24285, v = 23851 },
	{ sid = 9516, o = 23942, v = 23241 },
	{ name = "dt_fraer_smart", o = 23942, v = 23448 }
}

function rostok_fraer_vertex_old_save()
	local sim = alife()
	for _, row in ipairs( rostok_fraer_lvid ) do
		local sobj
		if row.sid then
			sobj = sim:story_object( row.sid )
		else
			for _, o in sim:objects() do
				if o:name() == row.name then sobj = o break end
			end
		end
		if sobj and not sobj.online and sobj.m_level_vertex_id == row.o then
			sobj.m_level_vertex_id = row.v
		end
	end
end

-- [HE-PORT]
function marsh_tuzla_outfit_old_save()
	if get_value( "marsh_tuzla_outfit_removed" ) then return end
	set_value( "marsh_tuzla_outfit_removed", true )
	local corpse = alife():story_object( 9494 )
	if not corpse then return end
	local ids = {}
	for id, o in alife():objects() do
		if o.parent_id == corpse.id and o:section_name() == "cs_heavy_outfit" then
			table.insert( ids, id )
		end
	end
	for _, id in ipairs( ids ) do misc.release_obj( id ) end
end

