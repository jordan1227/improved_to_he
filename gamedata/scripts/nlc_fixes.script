-- \\ all spawn - перенести после прохождения \\

function vergas_krujka_old_save(nomer)
	if alife():story_object(9200) then return end
	return vergas_krujka.spawn_krujka(nomer)
end

function agr_mines_old_save()
	doc.off_agr_mines()
end

function val_scaintist_docs_old_save()
	if get_value( "val_scaintist_docs_fixed" ) then return end
	if not has_alife_info( "borov_11_start" ) or has_alife_info( "borov_11_have" ) or has_alife_info( "borov_11_fdone" ) then return end
	local corpse
	for _, o in alife():objects() do
		if o.m_story_id == 9497 then
			corpse = o
		elseif o:section_name() == "scaintist_docs" then
			set_value( "val_scaintist_docs_fixed", true )
			return
		end
	end
	if not corpse then return end
	set_value( "val_scaintist_docs_fixed", true )
	misc.spawn_to( "scaintist_docs", corpse )
end

-- Scripted quest corpses used to lose their items to death_manager.create_release_item.
-- sak.create_corpse now marks bodies death_droped; this restores items on saves made before that.
local quest_corpse_rows = {
	{ sid = 9840, item = "yantar_docs",     done = "info_artmod_dummy_dummy_mosquito_bald" },
	{ sid = 9841, item = "red_forest_docs", done = "info_artmod_dummy_spring_galant" },
	{ sid = 9842, item = "rad_docs",        done = "info_artmod_dummy_pellicle_gravi_zone" }
}
local mil_kurjer_sid = 10121
local mil_kurjer_items = { "mil_kurjer_pda", "belt_2_art", "af_full_akkum", "af_baloon" }
local mil_kurjer_conds = { af_full_akkum = 0.05, af_baloon = 0.80 }
local mil_kurjer_seen = {
	"mil_kurjer_have_docent_info", "mil_kurjer_have_ivancov_info", "mil_kurjer_have_voronin_info",
	"mil_kurjer_have_barman_info", "mil_kurjer_have_skrjaga_info", "mil_kurjer_have_docent_done"
}

local function mil_kurjer_pending()
	if not db.actor or db.actor:object( "mil_kurjer_pda" ) then return false end
	for _, inf in ipairs( mil_kurjer_seen ) do
		if has_alife_info( inf ) then return false end
	end
	return true
end

function quest_corpse_items_old_save()
	local pending = {}
	for _, row in ipairs( quest_corpse_rows ) do
		if not has_alife_info( row.done ) then
			local corpse = alife():story_object( row.sid )
			if corpse then pending[ corpse.id ] = { corpse = corpse, items = { row.item } } end
		end
	end
	local kurjer = alife():story_object( mil_kurjer_sid )
	if kurjer and mil_kurjer_pending() then
		pending[ kurjer.id ] = { corpse = kurjer, items = mil_kurjer_items, all_or_nothing = true }
	end
	if next( pending ) == nil then return end

	local has = {}
	for _, o in alife():objects() do
		local p = o.parent_id
		if p and pending[ p ] then has[ p .. ":" .. o:section_name() ] = true end
	end
	for id, entry in pairs( pending ) do
		local missing = {}
		for _, sect in ipairs( entry.items ) do
			if not has[ id .. ":" .. sect ] then table.insert( missing, sect ) end
		end
		if entry.all_or_nothing and #missing ~= #entry.items then missing = {} end
		if #missing > 0 then
			entry.corpse.death_droped = true
			for _, sect in ipairs( missing ) do
				local sobj = misc.spawn_to( sect, entry.corpse )
				local cond = mil_kurjer_conds[ sect ]
				if sobj and cond and entry.all_or_nothing then
					local pk = get_netpk( sobj )
					local data = pk:get()
					data.condition = cond
					pk:set( data )
				end
			end
		end
	end
end

-- [HE-PORT]
local rostok_fraer_lvid = {
	{ sid = 9515, o = 24285, v = 23851 },
	{ sid = 9516, o = 23942, v = 23241 },
	{ name = "dt_fraer_smart", o = 23942, v = 23448 }
}

function rostok_fraer_vertex_old_save()
	local sim = alife()
	for _, row in ipairs( rostok_fraer_lvid ) do
		local sobj
		if row.sid then
			sobj = sim:story_object( row.sid )
		else
			for _, o in sim:objects() do
				if o:name() == row.name then sobj = o break end
			end
		end
		if sobj and not sobj.online and sobj.m_level_vertex_id == row.o then
			sobj.m_level_vertex_id = row.v
		end
	end
end
