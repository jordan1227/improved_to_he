
-- [HE-PORT] perenos kvestovyh funkcij iz NLC HE (kotovod\nlc_fixes.script)
function create_limansk_corpse()
	sak.create_corpse( "limansk_mielofon_corpse",
        sak.v3f( -50.284, -10.629, -183.869 ), 2993, 2894, 10108
    )
end
function rewrite_val_box_data()
	local box = g_sim:object( "dv_sak_box_ammo" )
	if box then 
		local pk         = get_netpk( box )
		local data       = pk:get()
		data.custom_data = "bes"
		pk:set( data )
	end
end
function create_wpngm()
	local obj = g_sim:create( "wpn_gm94",
		sak.v3f( -50.077, -10.756, -185.717 ),
		3717, 2991
	)
	local pda = g_sim:create( "anomaly_pda",
		sak.v3f( -50.077, -10.756, -185.717 ),
		3717, 2991
	)
	local ruck = amk.spawn_item( "rukzak_inventory_box",
		sak.v3f( -49.433, -10.761, -185.326 ),
		2993, 2894
	)
	misc.process_spawn()
	if ruck then
		local tbl = { "af_dummy_simbion", "af_dummy_buliz", "af_dummy_fire" }
		local art = misc.spawn_to( tbl[ get_value("r_treas_items", 1) ], ruck )
		local akk = misc.spawn_to( "af_full_akkum_big", ruck )
		local rnd = lua_random( 55, 73 ) / 100
		kotovod.update_item_condition( art, rnd )
		kotovod.update_item_condition( akk, rnd )
		kotovod.add_box_protection( ruck:name() )
		sak.off_on( ruck )
	end
end

-- [HE-PORT]
function new_game_init()
	sak_dialog.add_x18_docs()
	sak_dialog.add_docs_X18()
	-- [HE-PORT]
	sak_dialog.fill_agr_u_treasure()
	sak_dialog.fill_hos_treasure()
	x18_botan_book_spawn()
	dsh.get_next_random( "pda_drop_chance", 1, 1000 )
	dsh.get_next_random( "pda_status_rnd", 1, 10 )
	dsh.get_next_random( "pda_treas_rnd", 1, 100 )
	dsh.get_next_random( "sultan_weapon_treasure", 1, 3 )
	dsh.get_next_random( "generate_mutant_table", 1, 3 )
	dsh.get_next_random( "generate_mutant_request", 1, 5 )
	dsh.get_next_random( "generate_mutant_reward", 1, 5 )
	start_randoms()
	doc.add_playboy()
	give_yantar_room_lamp_info()
	spawn_new_mattress()
	spawn_agr_easy_battery()
	spawn_quest_items()
	sivol_worldspawns.new_game_init()
end

-- [HE-PORT]
function spawn_quest_items()
	sak.create_vasiliev_pda()
	sak.add_decoder()
	sak_dialog.dummy_green_art( 3, "spawn", "yan" )
	create_freeman_case()
end

function start_randoms()
	for _, v in ipairs({
		"kotovod.rec_art_info",
		"kotovod.gg_identic_item_have_give",
		"amk_mod.af_start_transform",
		"amk_anoms.randomize_arts",
		"arc_diary.controler_random",
		"kotovod.rnd_item",
		"kotovod.rnd_item_amount",
		"generic_rnd",
		"news_main.do_eternal_stalker",
		"xr_box.ph_item_box"
	}) do
		dsh.get_next_random( v )
	end
	for _, v in ipairs({
		"minigame_bet_rnd"
	}) do
		dsh.get_fixed_random( v, 1 )
	end
end

function x18_botan_book_spawn()
	local t = { "x18_inventory_box", "x18_inventory_box_0002", "x18_inventory_box1" }
	local box = server_obj( t[ get_value( "r_treas_items", 1 ) ] )
	if box then
		misc.spawn_to( "x18_botan_book", box )
	end
end

function give_yantar_room_lamp_info()
	if has_alife_info( "yantar_room_lamp_on" ) then return end
	if has_alife_info( "yantar_room_lamp_off" ) then return end
	db.actor:give_info_portion( "yantar_room_lamp_off" )
end

function save()
	_G.flag_can_save = true
	if _G.flag_can_save then -- [HE-PORT]
		local lname = level.name()
		local where = ( lname == "l01_escape" and "Бункер Сидоровича" ) or "Бункер Сахарова"
		local bl_save = string.format( "День %s %s. %s [%s]", timers.Get_Game_Days(), level.get_time_hours(), level.get_time_minutes(), where )
		cmd("save", dsh.safe_file_name(bl_save))
	end
end

-- [HE-PORT]
function spawn_new_mattress()
	local pos = {
		{ -115.10, -29.96, -387.17,  27, 140556 },
		{ -182.70,   2.38, -284.61, 3367, 50154 }
	}
	for a = 1, #pos do
		local sobj = g_sim:create( "physic_object",
			sak.v3f( pos[ a ][ 1 ], pos[ a ][ 2 ], pos[ a ][ 3 ] ),
			pos[ a ][ 5 ], pos[ a ][ 4 ]
		)
		if sobj then
			local pk         = get_netpk( sobj, 1 )
			local data       = pk:get()
			data.physic_type = 3
			data.mass        = 0
			data.visual_name = "physics\\decor\\bag_01.ogf"
			data.custom_data = "[collide]\n"
				.. "ignore_static\n\n"
				.. "[logic]\n"
				.. "cfg = scripts\\mar\\mar_esc_sleep_matras.ltx\n"
			pk:set( data )
			if a == 1 then sobj.direction = sak.v3f( 0, 1.5708, 0 ) end
		end
	end
end
-- [HE-PORT]
function spawn_agr_easy_battery()
	if level.name() ~= "l03_agroprom" then return end
	if ( get_value( "g_diff" ) or tonumber( level.get_game_difficulty() ) ) ~= 0 then return end
	if get_value( "agr_easy_battery_spawned", false ) then return end
	local obj = amk.spawn_item( "af_dummy_battery", sak.v3f( -199.344116210938, 1.62443733215332, 131.556854248047 ), 416, 425955 )
	if obj then set_value( "agr_easy_battery_spawned", true ) end
end

-- [HE-PORT]
function create_anti_spawn_zones()
	local anti_spawn_restrictors = get_value( "anti_spawn_restrictors", {} )
	local restrictors = {
		{ x = 352.59, y = 20.43, z = -639.40,  lv = 751422,  gv = 3107, dir_x = 0, dir_y = -1.6, dir_z = 0, size_x = 1300, size_y = 60, size_z = 100 },
		{ x = 352.59, y = 20.43, z = -639.40,  lv = 751422,  gv = 3107, dir_x = 0, dir_y = 0,   dir_z = 0, size_x = 1250, size_y = 90, size_z = 100 },
		{ x = -287.32, y = 38.48, z = 1.33,    lv = 914,     gv = 3076, dir_x = 0, dir_y = 1.6,  dir_z = 0, size_x = 1250, size_y = 90, size_z = 100 },
		{ x = -287.32, y = 38.48, z = 1.33,    lv = 914,     gv = 3076, dir_x = 0, dir_y = 0,   dir_z = 0, size_x = 1250, size_y = 30, size_z = 130 },
		{ x = 499.94, y = 12.57, z = -500.02,  lv = 1376325, gv = 2903, dir_x = 0, dir_y = -1.6, dir_z = 0, size_x = 2050, size_y = 80, size_z = 400 },
		{ x = 509.55, y = 12.57, z = -512.42,  lv = 1785989, gv = 2908, dir_x = 0, dir_y = 0,   dir_z = 0, size_x = 2050, size_y = 60, size_z = 400 },
		{ x = -500.08, y = 43.23, z = 500.30,  lv = 2845,    gv = 2887, dir_x = 0, dir_y = 1.6,  dir_z = 0, size_x = 2050, size_y = 33, size_z = 400 },
		{ x = -500.58, y = 43.23, z = 502.30,  lv = 2845,    gv = 2887, dir_x = 0, dir_y = 0,   dir_z = 0, size_x = 2050, size_y = 40, size_z = 400 },
	}
	for a = 1, #restrictors do
		local r = restrictors[ a ]
		local sr_obj = alife():create( "space_restrictor", vector():set( r.x, r.y, r.z ), r.lv, r.gv )
		if sr_obj then
			kotovod_restrictors.rewrite_box_restrictor( sr_obj, "", r.size_x, r.size_y, r.size_z )
			sr_obj.direction = sak.v3f( r.dir_x, r.dir_y, r.dir_z )
			sr_obj:set_name( "anti_spawn_restrictor" .. a )

			local level_key = sr_obj.level_name
			local level_tbl = anti_spawn_restrictors[ level_key ]

			if level_tbl then
				level_tbl[ #level_tbl + 1 ] = sr_obj.id
			else
				anti_spawn_restrictors[ level_key ] = { sr_obj.id }
			end
		end
	end
	set_value( "anti_spawn_restrictors", anti_spawn_restrictors )
end

-- [HE-PORT]
function create_freeman_case()
  if get_value("freeman_case_spawned") then
    local sid = get_value("freeman_case_id")
    if sid and g_sim:object(sid) then return end
  end
  local container = amk.spawn_item("special_art_container", sak.v3f(-238.143, -5.121, 80.622), 1376, 14269)
  if container then
    local container_arts = {
      "af_armor",
      "af_babka",
      "af_cry",
      "af_dik",
      "af_kol",
      "af_pudd",
      "af_spirit"
    }
    local pk = get_netpk(container, 1)
    local data = pk:get()
    local art = container_arts[dsh.get_next_random("special_art", 1, #container_arts)]
    local lvl = dsh.get_next_random("generic_rnd", 1, 100) <= 25 and 3 or 2
    data.custom_data = art .. "_" .. lvl
    pk:set(data)
    set_value("freeman_case_id", container.id)
    set_value("freeman_case_spawned", true)
  end
end

