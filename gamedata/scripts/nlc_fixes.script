local function chaes_spawn_monolith( name, prof, pos, lv, gv, logic )
	local obj = alife():create( "he_chaes_" .. prof, pos, lv, gv )
	if not obj then return end
	local pk = get_netpk( obj )
	local data = pk:get()
	data.custom_data = "[smart_terrains]\nnone = true\n\n" .. logic
	pk:set( data )
	obj:set_name( name )
	obj.ini_initialized = false
	obj.smart_terrain_conditions = { none = xr_logic.parse_condlist( obj, "smart_terrains", "none", "true" ) }
	obj.has_none_true = true
end

function chaes_monolith_old_save()
	if get_value( "chaes_monolith_fixed" ) then return end
	local lname = level.name()
	if lname == "l12_stancia_new" or lname == "l12_stancia_2_new" then return end
	local sim = alife()
	if sim:object( "he_aes_mono_01" ) then
		set_value( "chaes_monolith_fixed", true )
		return
	end
	for n = 1, 54 do
		local k, sid, name, cfg
		if n <= 29 then
			k = n
			sid = 7500 + k
			name = string.format( "aes_spec_monolith_%02d", k )
			cfg = "scripts\\stan1\\" .. name .. ".ltx"
		else
			k = n - 29
			sid = 7530 + k
			name = string.format( "st2_spec_monolith_%02d", k )
			cfg = "scripts\\stan2\\" .. name .. ".ltx"
		end
		local o = sim:story_object( sid )
		if o and o:alive() and not o.online then
			local pos, lv, gv = o.position, o.m_level_vertex_id, o.m_game_vertex_id
			misc.release_obj( o.id )
			chaes_spawn_monolith( name, chaes_old_roles[ ( k - 1 ) % 4 + 1 ], pos, lv, gv, "[logic]\ncfg = " .. cfg )
		end
	end
	for _, r in ipairs( chaes_new_npcs ) do
		chaes_spawn_monolith( r[1], r[2], vector():set( r[3], r[4], r[5] ), r[6], r[7], r[8] )
	end
	set_value( "chaes_monolith_fixed", true )
end
