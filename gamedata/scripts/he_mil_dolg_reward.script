-- [HE-PORT]
local KILLED = "he_mil_freedom_killed"
local CAPTURED = "he_mil_dolg_captured"
local SEIF_PRICE = 10000
local EXO_CAPSULES = 4
local EXO_SECTION = "dolg_black_exoskeleton"

local dolg_military = {
	comm = "dolg",
	sections = {
		"olr_dolg_regular", "olr_dolg_regular",
		"olr_dolg_veteran", "olr_dolg_veteran",
		"olr_dolg_master",
		"olr_dolg_sniper",
	},
	min_size = 3,
	max_size = 6,
	smarts = { "mil_freedom", "mil_fblockpost", "mil_fneutral" },
	no_wander = true,
}

function attach(sm)
	sm:subscribe({ signal = "on_npc_death", fun = this.on_npc_death })
end

function captured()
	return has_alife_info(CAPTURED)
end

function on_npc_death(npc, who)
	if not (db.actor and npc and who) then return end
	if who:id() ~= db.actor:id() then return end
	if not IsStalker(npc) or npc:character_community() ~= "freedom" then return end
	if level.name() ~= "l07_military" then return end
	if not has_alife_info("mil_dolg_skull_talk") or captured() then return end
	db.actor:give_info_portion(KILLED)
end

function on_capture()
	if not (db.actor and has_alife_info(KILLED)) then return end
	relation_registry.set_community_goodwill("freedom", db.actor:id(), -5000)
	if not has_alife_info("bar_voronin_dead") then
		sak.send_tip(game.translate_string("he_mil_voronin_call"), game.translate_string("bar_voronin_name"), 1, 15, "dolg", "sak", "green")
	end
end

function killed() return has_alife_info(KILLED) end
function not_killed() return not has_alife_info(KILLED) end
function skull_alive() return not has_alife_info("mil_scull_dead") end
function skull_dead() return has_alife_info("mil_scull_dead") end
function killed_skull_alive() return killed() and skull_alive() end
function killed_skull_dead() return killed() and skull_dead() end

function give_hyper() kotovod.add_rnd_art_to_actor(9) end
function give_meso() kotovod.add_rnd_art_to_actor(8) end
function give_dummy() kotovod.add_rnd_art_to_actor(4) end

function seif_money_have() return db.actor:money() >= SEIF_PRICE end
function seif_pay() sak_dialog.relocate_money(SEIF_PRICE, "out") end

function caps_have() return nlc_capsules.have_actor(nil, EXO_CAPSULES) end
function caps_not_have() return not nlc_capsules.have_actor(nil, EXO_CAPSULES) end

function exo_trade()
	for i = 1, EXO_CAPSULES do
		nlc_capsules.take_actor(nil)
	end
	sak.create_items(EXO_SECTION, 1)
end

function cut_spawn(respawner, section)
	if not captured() then return false end
	local props = respawner.sectSpawnProps and respawner.sectSpawnProps[section]
	if not props or props.community ~= "freedom" then return false end
	return math.random(1, 3) ~= 1
end

function olr_config(name)
	if name == "dolg_military" then return dolg_military end
	return nil
end

function olr_weights(list)
	if not captured() then return list end
	local out = {}
	for _, fw in ipairs(list) do
		if fw[1] == "freedom" then
			table.insert(out, { fw[1], math.max(1, math.floor(fw[2] / 3)) })
		else
			table.insert(out, fw)
		end
	end
	table.insert(out, { "dolg_military", 12 })
	return out
end

function olr_smart_full(name)
	local pop = olr_smart_index.population(name)
	local cap = olr_smart_index.capacity(name)
	return pop ~= nil and cap ~= nil and pop >= cap
end
