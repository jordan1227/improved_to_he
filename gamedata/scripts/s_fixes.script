function restore_nlc30_static_items()
	if not get_value("nlc30_static_items_spawned", false) then
		amk.spawn_item("amk_zapiska", sak.v3f(-132.93, 11.04, -203.2), 629, 105467)
		amk.spawn_item("rad_document6", sak.v3f(-28.4, -0.26, -173.55), 676, 211656)
		amk.spawn_item("quest_case_02", sak.v3f(-150.2, 12.1, -198.2), 628, 88768)
		set_value("nlc30_static_items_spawned", true)
	end
	if not get_value("nlc30_agro_vss_spawned", false) then
		local obj = g_sim:story_object(story_ids.agr_inventory_box_sak)
		if obj then
			misc.spawn_to("wpn_vintorez_m1", obj)
			sak.obj_off_on(obj)
			set_value("nlc30_agro_vss_spawned", true)
		end
	end
end

function remove_dumenko_content()
	misc.release_by_name("dumenko")
end

function create_underground_safe_zones()
   local lab_safe_zones = get_value( "lab_safe_zones", {} )
   if #lab_safe_zones > 1 then return end
   
   local tbl_levels = {
       "l04u_labx18", 
	   "l08u_brainlab", 
	   "labx8", 
	   "labx10", 
       "warlab", 
	   "l10u_bunker", 
	   "l12u_control_monolith", 
	   "l12u_sarcofag"
   }
   
   for i = 1, MAX_OBJ_ID do
       local obj = g_sim:object( i )
       if obj and str_in_tab( obj.level_name, tbl_levels ) then
           local name = obj:name()
           if ( strpos( name, "_koster_", 1, true ) or strpos( name, "_candle_", 1, true ) ) and not strpos( name, "zone", 1, true ) then
				local radius = strpos( name, "_koster_", 1, true ) and 3.5 or 2.2

				local sr_obj = alife():create( "space_restrictor", obj.position, obj.m_level_vertex_id, obj.m_game_vertex_id )

				if sr_obj then	
					local unique_name = string.format( "safe_zone_%d", sr_obj.id )					
					sr_obj:set_name( unique_name )
					
					local custom = [=[
						[logic]
						active = sr_idle@wait
						[sr_idle@wait]
						on_actor_inside = sr_idle@inside %=undergrounds_hits.enable_sz_protection%
						[sr_idle@inside]
						on_actor_outside = sr_idle@wait %=undergrounds_hits.disable_sz_protection%
					]=]
				   
                   kotovod_restrictors.rewrite_restrictor( sr_obj, custom, radius )
                   
                   if not lab_safe_zones[ obj.level_name ] then
                       lab_safe_zones[ obj.level_name ] = {}
                   end
                   table.insert( lab_safe_zones[ obj.level_name ], sr_obj.id )
               end
           end
       end
   end
   set_value( "lab_safe_zones", lab_safe_zones )
end

function create_x8_safe_zone()
	local lab_safe_zones = get_value( "lab_safe_zones", {} )
	if #lab_safe_zones > 1 then return end	
	local sr_obj = alife():create( "space_restrictor", vector():set( 2.38, 9.26, 23.37 ), 4834, 3210 )		
	if sr_obj then 
		local custom = [=[
			[logic]
			active = sr_idle@wait
			[sr_idle@wait]
			on_actor_inside = sr_idle@inside %=undergrounds_hits.enable_sz_protection%
			[sr_idle@inside]
			on_actor_outside = sr_idle@wait %=undergrounds_hits.disable_sz_protection%
		]=]		
		kotovod_restrictors.rewrite_box_restrictor( sr_obj, custom, 50, 35, 9 )
        sr_obj.direction = sak.v3f( 0, 1.6, 0 )
		sr_obj:set_name( "safe_zone_x8_sleep" )
		table.insert( lab_safe_zones[ sr_obj.level_name ], sr_obj.id )		
	end
	set_value( "lab_safe_zones", lab_safe_zones )
end

function remove_petrenko_items()
	local items = { 22, 56, 57, 62, 63, 66 }
	for _, v in pairs( items ) do 
		local obj = g_sim:object( "bar_petrenko_item_" .. v )
		if obj then 
			misc.release_obj( obj )
		end
	end	
end

function give_yantar_room_lamp_info()
	if has_alife_info( "yantar_room_lamp_on" ) then return end
	if has_alife_info( "yantar_room_lamp_off" ) then return end
	db.actor:give_info_portion( "yantar_room_lamp_off" )
end

function create_esc_notebook()
	local old_note = g_sim:object( "physic_object0025" )
	if old_note then 
		misc.release_obj( old_note )
	end	
	local sobj = alife():create( "physic_object", sak.v3f( -245.128, -23.945, -133.611 ), 12442, 4 )
	if sobj then 
		local pk 		 = get_netpk( sobj, 1 )	
		local data 		 = pk:get()		
		data.physic_type = 3
		data.mass 		 = 10	
		data.visual_name = "equipments\\item_notebook"		
		data.custom_data = 
			"[collide]\n" ..
			"ignore_dynamic\nignore_ragdoll\nignore_static\n\n" .. 
			"[ph_heavy]\n" ..
			"[logic]\n" .. 
			"active = ph_idle@enable\n" ..
			"[ph_idle@enable]\n" ..			
			"tips = ui_mm_save\n" ..
			"on_use = %=s_fixes.save()%"
		pk:set( data )		
		sobj.direction = sak.v3f( 0, 0.871, 0 )
		sobj:set_name( "esc_notebook" )
	end
end

function save()
	_G.flag_can_save = true
	if get_value("blowout", 0) == 0 and _G.flag_can_save then
		local lname = level.name()
		local where = ( lname == "l01_escape" and "Бункер Сидоровича" ) or "Бункер Сахарова" 
		local bl_save = string.format( "День %s %s. %s [%s]", timers.Get_Game_Days(), level.get_time_hours(), level.get_time_minutes(), where )
		cmd("save", dsh.safe_file_name(bl_save))
	end	
end

-- Сюда надо будет добавлять те, которым не нужно показывать окно, например: тп в чащу из агро! 
-- Не забыть добавить все остальные по тп

local skip_lc = {
	[ "argu_teleport_aver" ] = true,
}

function fix_lc()
    for a = 1, MAX_OBJ_ID do
        local sobj = g_sim:object(a)
        if sobj and sobj:clsid() == clsid.level_changer then
            local name = sobj:name()
            if not skip_lc[name] then
                local pk = get_netpk(sobj)
                local data = pk:get()
                data.silent_mode = 0
                pk:set(data)
                -- sak.send_tip(name, "Изменили переход:", 0, 10, "nlc", "pda_news", "gray")
            end
        end
    end
end