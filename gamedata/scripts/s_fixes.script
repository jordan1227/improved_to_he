function bar_tp()
	local res = g_sim:create("space_restrictor",vector():set(62.7021,-0.0013,76.8490),29236,1240)
	local logic = "[logic]\nactive = sr_teleport\n[sr_teleport]\npoint1 = bar_sak_teleport_0001_exit_walk\nlook1 = bar_sak_teleport_0001_exit_look\ntimeout = 5\nbypass = sak.bar_tp_bypass()"
	kotovod_restrictors.rewrite_restrictor(res, logic, 21.0)
	
	res = g_sim:create("space_restrictor",vector():set(83.3692,-0.0014,115.5599),29686,1221)
	kotovod_restrictors.rewrite_restrictor(res, logic, 6.0)
end

function save()
	_G.flag_can_save = true
	if get_value("blowout", 0) == 0 and _G.flag_can_save then
		local lname = level.name()
		local where = ( lname == "l01_escape" and "������ ����������" ) or "������ ��������" 
		local bl_save = string.format( "���� %s %s. %s [%s]", timers.Get_Game_Days(), level.get_time_hours(), level.get_time_minutes(), where )
		cmd("save", dsh.safe_file_name(bl_save))
	end	
end

