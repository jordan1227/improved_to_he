local BY_NAME = {}
for i = 1, #FIX do
	local e = FIX[ i ]
	local t = BY_NAME[ e.n ]
	if not t then t = {}; BY_NAME[ e.n ] = t end
	t[ #t + 1 ] = e
end

local arrived = false
local done    = false

function attach( sm )
	sm:subscribe( { signal = "on_load_before_all", fun = this.on_load_before_all } )
	sm:subscribe( { signal = "on_init_modules",    fun = this.on_init_modules } )
	sm:subscribe( { signal = "on_first_update",    fun = this.on_first_update } )
end

local function patch_alife()
	local sim = alife()
	if not sim then return 0 end
	local n = 0
	for _, sobj in sim:objects() do
		local list = BY_NAME[ sobj:name() ]
		if list then
			local ok, lc = pcall( function() return sobj:get_level_changer() end )
			if ok and lc then
				for i = 1, #list do
					if lc.dest_level_vertex_id == list[ i ].o then
						lc.dest_level_vertex_id = list[ i ].v
						n = n + 1
					end
				end
			end
		end
	end
	return n
end

function on_load_before_all()
	if done then return end
	if not alife() then return end
	done = true
	local n = patch_alife()
	if n > 0 then
		log2( "[he_fix_lc_vertex] patched %s level changers", n )
	end
end

function on_init_modules()
	on_load_before_all()
	local list = get_value( "lc_history", {} )
	arrived = ( #list == 0 ) or ( list[ #list ] ~= level.name() )
end

function on_first_update()
	if not arrived then return end
	arrived = false
	if not db.actor then return end
	local lname = level.name()
	local p = db.actor:position()
	for i = 1, #FIX do
		local e = FIX[ i ]
		if e.l == lname then
			local dx, dz = p.x - e.bx, p.z - e.bz
			if dx * dx + dz * dz < 25 and math.abs( p.y - e.by ) < 8 then
				db.actor:set_actor_position( vector():set( e.gx, e.gy, e.gz ) )
				pcall( function() db.actor:set_actor_direction( e.h ) end )
				log2( "[he_fix_lc_vertex] actor moved to %s exit point", e.n )
				return
			end
		end
	end
end
