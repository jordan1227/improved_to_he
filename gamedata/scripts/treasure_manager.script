local treasure_manager = nil
local n_rank

-- Same tokenization as se_respawn.parse_names, plus "@" so that capsule descriptors
-- ("capsule@af_soul@5") stay in one piece.
local function parse_spawn_names(s)
	local t = {}
	for name in string.gfind(s, "([%w_%-.\\@]+)%p*") do
		table.insert(t, name)
	end
	return t
end

function parse_spawns(line)
	if line==nil then
		return {}
	end
	local t = parse_spawn_names(line)
	local n = table.getn(t)
	local ret_table = {}
	local k = 1
	while k <= n do
		local spawn = {}
		spawn.section = t[k]
		if t[k+1]~=nil then
			local p = tonumber(t[k+1])
			if p then
				spawn.prob = p
				k = k + 2
			else
				spawn.prob = 1
				k = k + 1
			end
		else
			spawn.prob = 1
			k = k + 1
		end
		table.insert(ret_table, spawn)
	end
	return ret_table
end

class "CTreasure"
function CTreasure:__init()
    
	self.ini = ini_file("misc\\treasure_manager.ltx") 
	if not self.ini:section_exist("list") then
		abort("There is no section [list] in treasure_manager.ltx")
	end
	local n = self.ini:line_count("list")
	local id, value = "",""
	local r_trs_item = get_value("r_treas_items", 1)
	self.treasure_info = {}
	for i=0,n-1 do
		result, id, value	= self.ini:r_line("list",i,"","")
		self.treasure_info[id] = {}
		self.treasure_info[id].rnd 			= utils.cfg_get_number(self.ini, id, "random_treasure", nil, false, 1)
		self.treasure_info[id].target		= utils.cfg_get_number(self.ini, id, "target", nil, true)
		self.treasure_info[id].name			= utils.cfg_get_string(self.ini, id, "name", nil, true, "")
		self.treasure_info[id].description	= utils.cfg_get_string(self.ini, id, "description"..r_trs_item, nil, true, "")
		self.treasure_info[id].items		= parse_spawns(utils.cfg_get_string(self.ini, id, "items"..r_trs_item, nil, true, ""))
        self.treasure_info[id].pda         = utils.cfg_get_string(self.ini, id, "pda"..r_trs_item, nil, false, "", "")
        -- сохраняем сырую строку condlist для последующих проверок без повторного чтения ini
        self.treasure_info[id].condlist_raw = utils.cfg_get_string(self.ini, id, "condlist", nil, false, "", "") or ""
        
        if self.treasure_info[id].pda and self.treasure_info[id].pda ~= "" then
            local has_pda = false
            for _, item in pairs( self.treasure_info[id].items ) do
                if item.section == "device_pda_npc" then
                    has_pda = true
                    break
                end
            end
            if not has_pda then
                local pda_count = 0
                for _ in string.gmatch( self.treasure_info[id].pda, "([^|]+)" ) do
                    pda_count = pda_count + 1
                end
                table.insert( self.treasure_info[id].items, { section = "device_pda_npc", prob = pda_count } )
            end
        end		
		
		local community	= parse_names(utils.cfg_get_string(self.ini, id, "community"..r_trs_item, nil, false, "", "stalker"))
		self.treasure_info[id].community = {}
		for k,v in pairs(community) do
			self.treasure_info[id].community[v] = true
		end
		if self.treasure_info[id].items==nil then
			abort("cant find 'items' in %s", id)
		end
		self.treasure_info[id].condlist		= xr_logic.parse_condlist(db.actor, "treasure_manager", "condlist", utils.cfg_get_string(self.ini, id, "condlist", nil, false, "", ""))
		self.treasure_info[id].active = false
		self.treasure_info[id].done = false
        self.treasure_info[id].treasure_given = false		
	end
	self.treasure_by_target = {}
	for k,v in pairs(self.treasure_info) do
		self.treasure_by_target[v.target] = k	
	end
	
    -- восстанавливаем treasure_given
    local given = get_value( "treasure_given_list", {} )
    for k, _ in pairs( given ) do
        if self.treasure_info[ k ] then
            self.treasure_info[ k ].treasure_given = true
        end
    end	
	
	self.ini:release()
	self.ini = nil
end

function CTreasure:offline_give_treasure(npc)
	-- [HE-PORT]
	if not amk_offline_alife.give_treasure then return false end
	local res, boxlist = amk_offline_alife.give_treasure(npc)
	if res then 
		if boxlist and table.getn(boxlist) > 0 then
			for iter, box_story_id in pairs(boxlist) do
				local k = self.treasure_by_target[box_story_id]
				if k~=nil then 
					self.treasure_info[k].active = true
					self.treasure_info[k].done = true
				end
			end
		end
		return true
	end
	return false
end

-- rng: optional sivol_seeded_rng stream (docs/LOOT_RNG_DESIGN.md 6).
function CTreasure:find_similar(k, rng)
    local orig = self.treasure_info[k]
    if not orig then return nil end
    local avail = {}
    local tr_sum = 0
    for id, v in pairs(self.treasure_info) do
        if v.done==false and v.active==false and v.treasure_given==false then
            -- исключаем тайники с sak_no_need — они сюжетные и не должны выдаваться как замена
            if not string.find(v.condlist_raw, "sak_no_need", 1, true) then
                for comm, _ in pairs(orig.community) do
                    if v.community[comm] then
                        table.insert(avail, {k = id, prob = 5})
                        tr_sum = tr_sum + 5
                        break
                    end
                end
            end
        end
    end
    if tr_sum == 0 then return nil end
    table.sort(avail, function(a, b) return a.k < b.k end)
    local tr_w = rng and rng:random(tr_sum) or lua_random(tr_sum)
    for _, v in ipairs(avail) do
        tr_w = tr_w - v.prob
        if tr_w <= 0 then return v.k end
    end
    return nil
end

-- Флаг форс, для передачи прямого тайника
function CTreasure:reserve_treasure(k, force, rng)
    if not self.treasure_info[k] then return nil end
    local target = k
    if self.treasure_info[k].treasure_given then
        -- если тайник указан явно — не ищем замену, просто выдаём повторно
        if force then
           --log2( "reserve_treasure: '%s' already given, forced reuse", k )
        else
            target = self:find_similar(k, rng)
            if not target then
                --log2( "reserve_treasure: '%s' already given, no similar found", k )
                return nil
            end
            --log2( "reserve_treasure: '%s' already given, replaced with '%s'", k, target )
        end
    end
    if not force then
        self.treasure_info[target].treasure_given = true
        self.treasure_info[target].active = true
        local given = get_value( "treasure_given_list", {} )
        if not given[target] then
            given[target] = true
            set_value( "treasure_given_list", given )
            --kotovod.get_nlc( "treasure_given_list" )
        end
    end
    return target
end

-- rng: optional sivol_seeded_rng stream. The caller rolls the stash chance;
-- use() only picks among the available stashes (docs/LOOT_RNG_DESIGN.md 3.2).
-- sivol: PDA stash pick (docs/PDA_FACTION_TEXT_DESIGN.md 7.0, 11.1, 12.2).
-- A condlist with no clause for the evaluated rank now excludes the stash, as in
-- CTreasure:dialog; the old default weight 5 let rookies roll master stashes.
local PDA_TIERS = { "novice", "experienced", "veteran", "master" }
-- debug: [pda_stash] log line on/off, last pick details (sivol_pda_debug)
pda_log = true
pda_last = nil
local PDA_TIER_RANK = { novice = 150, experienced = 450, veteran = 750, master = 1050 }

-- Stand-in for npc_rank: ranks.get_obj_rank_name reads character_rank() and clsid().
local function rank_proxy(rank)
	return {
		character_rank = function() return rank end,
		clsid = function() return CLID_STALKER end,
	}
end

function rank_name(rank)
	return ranks.get_obj_rank_name(rank_proxy(tonumber(rank) or 0))
end

local function rnd_n(rng, n)
	if rng then return rng:random(n) end
	return lua_random(n)
end

-- Target tier from [pda_stash_tier_spread] in vergas_pda.ltx (novice, experienced, veteran, master).
local function roll_tier(owner, rng)
	local ltx = system_ini()
	if not ltx:line_exist("pda_stash_tier_spread", owner) then return owner end
	local w, sum, i = {}, 0, 0
	for s in string.gmatch(ltx:r_string("pda_stash_tier_spread", owner), "[%d%.]+") do
		i = i + 1
		w[i] = tonumber(s) or 0
		sum = sum + w[i]
	end
	if sum <= 0 then return owner end
	local r = rnd_n(rng, 1000) * sum / 1000
	for j = 1, #PDA_TIERS do
		r = r - (w[j] or 0)
		if r <= 0 and (w[j] or 0) > 0 then return PDA_TIERS[j] end
	end
	return owner
end

local monolith_levels = nil
local function get_monolith_levels()
	if monolith_levels == nil then
		monolith_levels = {}
		local ltx = system_ini()
		if ltx:line_exist("pda_monolith_stash_levels", "levels") then
			for s in string.gmatch(ltx:r_string("pda_monolith_stash_levels", "levels"), "[%w]+") do
				monolith_levels[s] = true
			end
		end
	end
	return monolith_levels
end

-- Weighted pick among free stashes of comm, weights read for tier; 0 if none.
function CTreasure:pda_pick(comm, tier, levels, rng)
	local proxy = rank_proxy(PDA_TIER_RANK[tier] or 0)
	local avail, forced = {}, {}
	local tr_sum = 0
	for k,v in pairs(self.treasure_info) do
		if v.done==false and v.active==false and v.treasure_given==false and v.community[comm]==true
			and not string.find(v.condlist_raw, "sak_no_need", 1, true)
			and (levels == nil or levels[string.match(k, "^(%w+)_") or ""]) then
			local prob
			if v.condlist_raw == "" then
				prob = 5
			else
				prob = tonumber(xr_logic.pick_section_from_condlist(db.actor, proxy, v.condlist))
			end
			if prob == 100 then
				table.insert(forced, k)
			elseif prob and prob > 0 then
				table.insert(avail, {k = k, prob = prob})
				tr_sum = tr_sum + prob
			end
		end
	end
	-- a probability-100 stash always wins
	if #forced > 0 then
		table.sort(forced)
		return forced[1]
	end
	if tr_sum == 0 then return 0 end
	table.sort(avail, function(a, b) return a.k < b.k end)
	local tr_w = rnd_n(rng, 1000) * tr_sum / 1000
	for _, v in ipairs(avail) do
		tr_w = tr_w - v.prob
		if tr_w <= 0 then return v.k end
	end
	return avail[#avail].k
end

function CTreasure:use(npc,community,rang_n,rng)
	local comm, rank
	if npc~=nil then
		if self:offline_give_treasure(npc) then
			return 0
		end
		comm = npc:character_community()
		rank = npc:character_rank()
	else
		comm = community
		rank = rang_n or 0
	end
	local owner = rank_name(rank)
	local levels = (comm == "monolith") and get_monolith_levels() or nil
	local tier = roll_tier(owner, rng)
	local shron = self:pda_pick(comm, tier, levels, rng)
	if shron == 0 and tier ~= owner then
		shron = self:pda_pick(comm, owner, levels, rng)
	end
	local fallback = false
	if shron == 0 and comm == "monolith" then
		fallback = true
		-- 11.1: no Monolith stash, take a high-tier stalker one (shown as a note
		-- the brothers took off a stalker's body)
		local t = (tier == "master") and "master" or "veteran"
		shron = self:pda_pick("stalker", t, levels, rng)
		if shron == 0 then
			shron = self:pda_pick("stalker", (t == "master") and "veteran" or "master", levels, rng)
		end
	end
	pda_last = { comm = comm, owner = owner, tier = tier, pick = shron, fallback = fallback }
	if pda_log then
		log2("[pda_stash] comm=%s rank=%s owner=%s tier=%s pick=%s", tostring(comm), tostring(rank), tostring(owner), tostring(tier), tostring(shron))
	end
	return shron
end

function CTreasure:check()
	for k,v in pairs(self.treasure_info) do
		self:give_treasure(k)
	end
end

function CTreasure:give_treasure( k, show, text_only )
    local v = self.treasure_info[ k ]
    local obj = alife():story_object( v.target )
    if obj ~= nil and self.treasure_info[ k ].done ~= true then
    
        kotovod.add_box_protection( obj:name() )

        if not text_only and ( game_options.BalanceValue or show ) then
            sak.send_treasure( v.name )
            local text = "%c[255,238,155,23]" .. game.translate_string( v.name ) .. "\\n" .. "%c[default]" .. game.translate_string( v.description )
            local spot = lua_random(1,4)
            level.map_add_object_spot_ser( obj.id, "crlc_big_treasure" .. spot, text )     
        elseif not text_only then
            if db.actor:object( "klava" ) then      
                local msg_id = "treasure_" .. tostring( vergas_lib.set_pr_from_config( "list_treasure_pda", k ) ) .. "_1"
                local clean_msg = string.gsub( game.translate_string( msg_id ), "^Схрон:%s*", "")
                sak.send_tip( 
                    "%c[ 255, 160, 160, 160 ]" .. clean_msg, 
                    "Получена информация о схроне:", 0, 15, "nlc", "pda_news", "orange" 
                )                   
                vergas_lib.add_record_in_klava( msg_id )
            end
        end

		--[[ формат pda в конфиге тайника:
			items1 = device_pda_npc, 3
			pda1 = 1:ros_secret_0025+enc_artmod_text|2:mar_secret_0059|1

			pda1 соответствует items1, разделитель между пда - |
			каждый пда: статус:тайник+рецепт+рецепт...
				статус 1=рабочий, 2=разряженный, 3=битый
				тайник и рецепты необязательны
				если пда больше чем записей - остальные рандомные
				если pda строка не указана - все рандомные
				
			pda1 = 1:ros_secret_0025+enc_artmod_vyvert_buzz_text|1:mar_secret_0059|1:lvl1u+lvl2u+lvl3u+lvl3u+lvl3u
			Данная запись сделает следующее:
			1. ПДА с тайником на ДТ + фиксированный рецепт выверта
			2. ПДА с тайником на болотах
			3. ПДА С уникальным рандомными рецептами первого, второго и 3 третьего уровня 
			-- Короче, добавляем u к уровню рецепта и получим уникальный, которого нет у игрока! Если же нет, то полностью рандомные
			pda1 = 1:ros_secret_0025+enc_artmod_vyvert_buzz_desc+lvl3u+lvl3u -- Заряженный ПДА, с тайником на ДТ, фиксированный рецом на выверт, если его нет - выдадим и 2 рандомным уникальных 3 уровня
			pda2 = 1:lvl3u+only - онли делает тоже самое, что и в Mike, запись только с рецептами или тайниками, без рандомных сообщений
			pda3 = 1:lvl3u+only|1:lvl2|1:enc_artmod_vyvert_buzz_desc+only - целый пда с уникальным рецептом 3, целый пда с рандомными сообщениями и рандом рецептом, целый пда с фиксированным рецептом выверта
		--]]        
        local pda_list = {}
        if v.pda and v.pda ~= "" then
            for part in string.gmatch( v.pda, "([^|]+)" ) do
                table.insert( pda_list, vergas_lib.trim( part ) )
            end
        end
        local pda_idx = 0

        local b = sak.day_shmoney
        while b > 4 do b = b - 4 end
        for kk, vv in pairs( v.items ) do
            for i = 1, vv.prob do
                if vv.section == "capsule" then vv.section = sak_dialog.treasure_any_capsule() end
                
                if 
                    strpos( vv.section, "art" ) 
                    and not strpos( vv.section, "dart" ) 
                    and not strpos( vv.section, "arc_art_box" )
                    and not strpos( vv.section, "special_art_container" ) 
                then 
                    vv.section = rnd_treasure_art( tonumber( string.sub( vv.section, 4, string.len( vv.section ) ) ) )
                end
            
                if 
                            string.find( vv.section, "^af_" ) 
                    and not string.find( vv.section, "_dummy_", 1, true ) 
                    and not string.find( vv.section, "_1", 1, true ) 
                    and not string.find( vv.section, "_2", 1, true ) 
                    and not string.find( vv.section, "_3", 1, true ) 
                    and not string.find( vv.section, "_4", 1, true ) 
                    and not string.find( vv.section, "_dyn", 1, true ) 
                    and not string.find( vv.section, "_new", 1, true ) 
                    and not string.find( vv.section, "af_baloon", 1, true ) 
                    and not string.find( vv.section, "af_ice", 1, true ) 
                    and not string.find( vv.section, "af_glassbeads", 1, true ) 
                    and not string.find( vv.section, "af_battery", 1, true ) 
                    and not string.find( vv.section, "full_akkum", 1, true ) 
                then
                    vv.section = vv.section .. "_dyn" .. b .. "d"
                    b = b + 1 
                    if b > 4 then b = 1 end
                end

                local payload = nlc_capsules.from_descriptor( vv.section )
                local obj_sp
                if payload then
                    obj_sp = nlc_capsules.spawn( payload, obj.position, obj.m_game_vertex_id, obj.m_level_vertex_id, obj.id )
                else
                    obj_sp = alife():create( vv.section, obj.position, obj.m_level_vertex_id, obj.m_game_vertex_id, obj.id )
                end
                if obj_sp and sivol_unknown_arts
                    and type(sivol_unknown_arts.initialize_new) == "function"
                then
                    sivol_unknown_arts.initialize_new(obj_sp)
                end
                if vv.section == "special_art_container" then
                    local container_arts = { "af_armor", "af_babka", "af_cry", "af_dik", "af_kol", "af_pudd", "af_spirit" }
                    local pk   = get_netpk( obj_sp )
                    local data = pk:get()
                    local art  = container_arts[ dsh.get_next_random( "special_art", 1, #container_arts ) ]
                    -- [HE-PORT]
                    local lvl  = dsh.get_next_random( "generic_rnd", 1, 100 ) <= 25 and 3 or 2
                    data.custom_data = art .. "_" .. lvl
                    pk:set( data )
                end
				
				if vv.section == "device_pda_npc" then
					pda_idx = pda_idx + 1
					local pda_str = pda_list[ pda_idx ] or ""
					local pda_key = "trpda|" .. tostring( k ) .. "|" .. tostring( pda_idx ) -- sivol: reload-stable
					schedule.add("treasure_pda_spawn_" .. obj_sp.id, function()
						local status_pda, messages
						local only = false
						if pda_str ~= "" then
							local parts = vergas_lib.str_explode( ":", pda_str, true )
							status_pda = tonumber( parts[1] )
							if parts[2] then
								local raw = string.gsub( parts[2], "%+", ";" )
								-- проверяем флаг only
								if string.find( raw, ";only$" ) or raw == "only" then
									only = true
									raw = string.gsub( raw, ";?only$", "" )
								end
								messages = vergas_pda.filter_enc_given(
									vergas_pda.process_lvl_messages( raw )
								)
							end
						end
						local trng = sivol_seeded_rng.new( pda_key )
						vergas_pda.set_pda_seed( obj_sp.id, pda_key .. "|content" )
						status_pda = status_pda or vergas_pda.set_status_pda( trng:int( 1, 10 ) )
						vergas_pda.add_tbl_pda( obj.id, obj_sp.id, status_pda, messages, only )
						vergas_pda.set_pda_condition( obj_sp.id, status_pda )
					end, 200)
				end
				
            end
        end  
        self.treasure_info[ k ].active = true
        self.treasure_info[ k ].done = true
        he_pda_stash_log.on_issued( k ) -- NLC: PDA Notes stash log
        xr_statistic.add_pts( "otherstats", game.translate_string( "st_pda_otherstats_treas_found" ), 1, 1 )     
        local sim = alife()
        if obj.online then
            sim:set_switch_online( obj.id, false )
            sim:set_switch_offline( obj.id, true )
            amk.convert_npc[ obj.id ]=1
        end
    else
    end
end

function CTreasure:treasure_empty(box, box_story_id)
	local k = self.treasure_by_target[box_story_id]
	if k==nil or self.treasure_info[k]==nil then 
		return
	end
	self.treasure_info[k].active = false
	if self:named_treasure(self.treasure_info[k])==false then
		self.treasure_info[k].done = false
	end
	for spot=1,4 do
		level.map_remove_object_spot(box:id(), "crlc_big_treasure"..spot)
	end
end

