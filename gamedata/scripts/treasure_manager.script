	"agr_secret_0000_name", 				-- Тайник Серого
	"bar_secret_0011_name", 				-- Тайник Арни
	"esc_secret_0013_name", 				-- Тайник Ворпала
	"gar_secret_0002_name", 				-- Вещи Гризли
	"gar_secret_0011_name", 				-- Склад группы Стрелка
	"gar_secret_0021_name", 				-- Рюкзак Дохляка
	"pri_secret_0003_name", 				-- Хабар Клыка
	"pri_secret_0004_name", 				-- Запасы лидера Свободы
	"rad_secret_0000_name", 				-- Клад Угрюмого
	"rad_secret_0004_name", 				-- Запас группы отчаянных
	"ros_secret_0015_name", 				-- Тайник Счастливчика
	"ros_secret_0018_name", 				-- Ящик с медикаментами
	"val_secret_0028_name", 				-- Тайник Борова
	"x18_secret_0000_name", 				-- Тайник Копченого
	"yan_secret_0011_name", 				-- Тайник учёного
