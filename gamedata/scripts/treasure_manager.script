}

function CTreasure:named_treasure( v )
	if str_in_tab( v.name, named_treasure ) then return true end
	return false
end

function CTreasure:save(p)
	amk_offline_alife.save(p)
	local t, active_cnt, done_cnt = {}, 0, 0
	for k,v in pairs(self.treasure_info) do
		if v.active or v.done then
			table.insert(t, {v.target, v.active, v.done})
			if v.active then active_cnt = active_cnt + 1 end
			if v.done then done_cnt = done_cnt + 1 end
		end
	end
	set_value("treasure_manager.data", t)
	log2("[%s.CTreasure:save]: active|done: %s|%s", script_name(), active_cnt, done_cnt)
end

function CTreasure:load(p)
	amk_offline_alife.load(p)
	local data = get_value("treasure_manager.data")
	if not data then return end
	local active_cnt, done_cnt = 0, 0
	for _, t in ipairs(data) do
		local id, active, done = t[1], t[2], t[3]
		local k = self.treasure_by_target[id]
		local info = k and self.treasure_info[k]
		-- sivol: a save can hold treasures later removed from [list] (dsc_secret_0013, box 2113)
		if info then
			info.active = active
			info.done = done
			if active then active_cnt = active_cnt + 1 end
			if done then done_cnt = done_cnt + 1 end
		end
	end
	log2("[%s.CTreasure:load]: active|done: %s|%s", script_name(), active_cnt, done_cnt)
end

function get_treasure_manager()
	if treasure_manager==nil then
		treasure_manager = CTreasure()
	end
	return treasure_manager
end

function add_rnd_dyn(sec)
	local r = dsh.get_next_random( "rnd_treas_dyn", 1, 4 )
	local res = sec.."_dyn"..tostring(r).."d"
	return res
end

function take_item_from_box(box, box_story_id)
	local story_id = box:story_id()
	if story_id==nil then
		return
	end
	get_treasure_manager():treasure_empty(box, box_story_id)
end

function save(p)
	get_treasure_manager():save(p)
end
function load(p)
	get_treasure_manager():load(p)
end
function clear_treasure_manager()
	treasure_manager = nil
end

function CTreasure:dialog(npc)
	-- sivol: reload-stable pick per NPC (docs/LOOT_RNG_DESIGN.md 6)
	local rng = sivol_seeded_rng.new("trdialog|" .. tostring(npc:id()) .. "|" .. tostring(npc:character_name()))
	local avail = {}
	local tr_sum = 0
	for k,v in pairs(self.treasure_info) do
		if v.done==false and v.active==false and v.community[npc:character_community()]==true then
			local treasure_prob = xr_logic.pick_section_from_condlist(db.actor, npc, v.condlist)
			if treasure_prob=="" or treasure_prob==nil then
				treasure_prob = 0
			end
			if tonumber(treasure_prob) >= 0 and
			v.community[npc:character_community()]==true and
			v.active==false
			then
				if tonumber(treasure_prob)==100 then
					self:give_treasure(k)
				else
					table.insert(avail, {k = k, prob = treasure_prob})
					tr_sum = tr_sum + treasure_prob
				end
			end
		end
	end
	if tr_sum==0 then
		return
	end
	table.sort(avail, function(a, b) return a.k < b.k end)
	local tr_w = rng:random(tr_sum)
	for k,v in ipairs(avail) do
		tr_w = tr_w - v.prob
		if tr_w <= 0 then
			self:give_treasure(v.k)
			local t = get_value("npc_trs", {})
			t[npc:id()] = v.k
			set_value("npc_trs", t)
			break
		end
	end
end

function rnd_treasure_art( lvl )
    local sect = kotovod.rnd_rec_art_info( kotovod.tbl_arts, lvl )
    return sect
end
