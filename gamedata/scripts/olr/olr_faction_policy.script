	bandit = true,
	dolg = true,
	freedom = true,
	ecolog = true,
	killer = true,
	military = true,
	green = true,
	monolith = true,
	zombied = true,
	trader = true,
	stranger = true,
	nebo = true,
}

north_levels = {
	red_forest = true,
	deadcity = true,
	l07_military = true,
	limansk = true,
	l10_radar = true,
	l11_pripyat = true,
}

local cross_sources = {
	dolg     = { "stalker", "ecolog", "military" },
	freedom  = { "stalker", "bandit" },
	ecolog   = { "stalker", "dolg", "military", "freedom" },
	military = { "dolg", "ecolog" },
}

bar_levels = {
	l05_bar = true,
}

local bar_denied = {
	bandit = true,
	killer = true,
	monolith = true,
	zombied = true,
	freedom = true,
	military = true,
}

-- [HE-PORT]
monster_levels = {
