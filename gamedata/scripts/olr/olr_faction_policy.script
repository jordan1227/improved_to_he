	general_lager = true,
	general_lager_prip = true,
}

-- [HE-PORT]
guest_denied = {
	l01_escape = { military = true },
}

-- [HE-PORT]
function is_guest_denied(community, level_name)
	local d = guest_denied[level_name]
	if not d then return false end
	return d[community] == true
end

-- [HE-PORT]
no_wander_levels = {
	l01_escape = true,
}

-- [HE-PORT]
danger_zones = {
	{ level = "l01_escape", pos = { -154.28, -29.45, -384.08 }, radius = 150, safe = { military = true, dolg = true } },
}

-- [HE-PORT]
function no_wander( level_name )
	if not olr_cfg.on( "free_wander" ) then return true end
	return no_wander_levels[ level_name or "" ] == true
end

-- [HE-PORT]
function in_zone( zone, pos )
	local dx = pos.x - zone.pos[ 1 ]
	local dz = pos.z - zone.pos[ 3 ]
	return dx * dx + dz * dz < zone.radius * zone.radius
end

-- [HE-PORT]
function danger_zone( community, level_name, pos )
	if not ( level_name and pos ) then return nil end
	for i = 1, #danger_zones do
		local zone = danger_zones[ i ]
		if zone.level == level_name and not zone.safe[ community ] and in_zone( zone, pos ) then
			return zone
		end
	end
	return nil
end

function expand_comm(community)
	if community == "green" or community == "nebo" then
		return { community, "stalker", "green" }
	end
	if community == "stalker" then
		return { "stalker", "green" }
	end
	-- [HE-PORT]
	if olr_cfg.on("military_guests") then
		if community == "dolg" then
			return { "dolg", "military" }
		end
		if community == "military" then
			return { "military", "dolg" }
		end
	end
	return { community }
end

-- [HE-PORT] authored garrisons stay home; loners and OLR's own people may move
function may_migrate(se, community)
	if olr_trader_runs.on_run(se.id) then return false end
	-- quest-staged people stay put until their quest lets them go (the Garbage hostage scene lost Orekh's two men)
	if olr_cfg.on("quest_bound") and olr_protected.is_quest_bound(se) then return false end
	if not olr_cfg.on("garrisons_stay") then return true end
	if string.sub(se:section_name(), 1, 4) == "olr_" then return true end
	return community == "stalker" or community == "green" or community == "nebo"
end

-- [HE-PORT] the engine cannot walk an online NPC to another level: near the player it only
-- circles. Anyone bound to a smart elsewhere travels offline, and an NPC already online leaves
-- only where the player is not next to him, so nobody vanishes in view.
-- [HE-PORT] the engine's own online radii (alife.ltx switch_distance): an online traveller goes offline where the engine
-- would switch him anyway, an offline one by the player comes online where the engine would bring him in

function in_transit(se)
	if not olr_cfg.on("transit_offline") then return false end
	local sid = se:smart_terrain_id()
	if sid == BAD_OBJ_ID or not se:alive() then return false end
	local smart = alife():object(sid)
	if not smart then return false end
	local here = olr_smart_index.object_level(se)
	if not here or smart.level_name == here then return false end
	-- quest locks stay put; anyone else bound elsewhere is on his way anyway
	local name = se:name()
	if olr_protected.is_always_protected(name) or he_mil_freedom_reinf.is_protected(name) or he_quest_target_lock.is_locked(name) then
		return false
	end
	if se.online then
		local _, outer = olr_cfg.switch_radii()
		return db.actor ~= nil and se.position:distance_to(db.actor:position()) > outer
	end
	-- offline but right by the player on his level (a save was loaded while he walked off): he stays in view and
	-- goes offline again once the player is out of the online radius; this also shows a traveller the player followed
	if db.actor ~= nil and here == level.name() and se.position:distance_to(db.actor:position()) <= ( olr_cfg.switch_radii() ) then
		return false
	end
	return true
end

function is_stalker_comm(c)
	return human_comms[c] == true
end

function level_denied(community, level_name, from_level)
	-- [HE-PORT]
	-- Monolith already holds the north and is not kept out of it; the flag is for the people who must hear first
	if community ~= "zombied" and community ~= "monolith" and human_comms[community] and from_level ~= level_name and olr_cfg.level_closed(level_name) then
		return true
	end
	-- [HE-PORT]
	if monster_levels[level_name] then
		return human_comms[community] == true and from_level ~= level_name
	end
	if not bar_levels[level_name] then return false end
	return bar_denied[community] == true
end

function raw_accepts(smart, community)
	if not smart then return false end
	local acc = he_mil_dolg_base.accepted(smart) -- [HE-PORT]
	if acc then
		return acc[community] == true
	end
	if not is_stalker_comm(community) then
		local fauna = he_random_fauna.accepts(smart, community) -- [HE-PORT]
		if fauna ~= nil then return fauna end
	end
	local gp = smart.gparams
	if not gp or not gp.type then return false end
	local ok, res = pcall(xr_gulag.checkNpc, community, is_stalker_comm(community), gp.type, nil, nil)
	return ok and res == true
end

function is_guest_smart(smart, community)
	if raw_accepts(smart, community) then return false end
	return raw_accepts(smart, "ecolog") or raw_accepts(smart, "dolg")
end

function native_accepts(smart, community)
	if not smart then return false end
	local probes = expand_comm(community)
	local acc = he_mil_dolg_base.accepted(smart) -- [HE-PORT]
	if acc then
		for i = 1, #probes do
			if acc[probes[i]] then
				return true
			end
		end
		return false
	end
	local gp = smart.gparams
	if not gp or not gp.type then
		return false
	end
	for i = 1, #probes do
		local c = probes[i]
		local fauna = nil
		if not is_stalker_comm(c) then
			fauna = he_random_fauna.accepts(smart, c) -- [HE-PORT]
		end
		if fauna == true then
			return true
		end
		if fauna == nil then
			local ok, res = pcall(xr_gulag.checkNpc, c, is_stalker_comm(c), gp.type, nil, nil)
			if ok and res then
				return true
			end
		end
	end
	return false
end

function cross_accepts(smart, community)
	local src = cross_sources[community]
	if not src then return false end
	local gp = smart and smart.gparams
	if not gp or not cross_types[gp.type] then return false end
	local guests = olr_cfg.on("military_guests") -- [HE-PORT]
	if community == "military" and not guests then return false end
	for i = 1, #src do
		if ( guests or src[i] ~= "military" ) and native_accepts(smart, src[i]) then
			return true
		end
	end
	return false
end

function accepts(smart, community, level_name)
	if level_denied(community, level_name) then return false end
	if level_name == "hospital" and nlc_burer_hospital and nlc_burer_hospital.is_closed() then return false end
	if native_accepts(smart, community) then return true end
	-- [HE-PORT]
	if is_guest_denied(community, level_name) then return false end
	return cross_accepts(smart, community)
end

-- [HE-PORT]
bar_preferred = {
	stalker = true,
	dolg    = true,
	ecolog  = true,
	green   = true,
}

local section_comm = {
	stalker  = "stalker",
	bandit   = "bandit",
	dolg     = "dolg",
	svoboda  = "freedom",
	ecolog   = "ecolog",
	killer   = "killer",
	soldier  = "military",
	monolith = "monolith",
	zombie   = "zombied",
}

function is_bar_smart_name(name)
	local n = string.lower(tostring(name or ""))
	return string.sub(n, 1, 4) == "bar_"
end

function is_bar_denied(community)
	return bar_denied[community] == true
end

function is_bar_preferred(community)
	return bar_preferred[community] == true
end

function smart_denied(community, smart_name, level_name)
	if not bar_denied[community] then return false end
	if level_name ~= nil and level_name ~= "?" then
		return bar_levels[level_name] == true
	end
	return is_bar_smart_name(smart_name)
end

function section_community(section)
	local s = string.lower(tostring(section or ""))
	for key, comm in pairs(section_comm) do
		if string.find(s, key, 1, true) then return comm end
	end
	return nil
end

function section_denied(section, level_name)
	local comm = section_community(section)
	if not comm then return false end
	return level_denied(comm, level_name)
end
