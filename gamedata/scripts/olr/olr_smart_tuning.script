-- [HE-PORT]
local tuning = {
	marsh_fish_khutor = { capacity = 8, kamp_jobs = 8 },
}

function capacity( name, default )
	local t = name and tuning[ name ]
	if t and t.capacity then return t.capacity end
	return default
end

function kamp_jobs( name, default )
	local t = name and tuning[ name ]
	if t and t.kamp_jobs then return t.kamp_jobs end
	return default
end
