local walk_on = true
local spots = false

loadedsim = false
tabst = {}
ofl_walkers_cnt = 0

local time_apdeyta = 0
local timerup = 4000

local scan_pos = 1
local scan_batch = 25
local proc_idx = 1
local proc_batch = 3

local montabl = {
	[clsid.zombie_s]       = true,
	[clsid.zombie]         = true,
	[clsid.dog_s]          = true,
	[clsid.dog_red]        = true,
	[clsid.dog_black]      = true,
	[clsid.boar_s]         = true,
	[clsid.boar]           = true,
	[clsid.flesh_s]        = true,
	[clsid.flesh]          = true,
	[clsid.burer_s]        = true,
	[clsid.burer]          = true,
	[clsid.controller_s]   = true,
	[clsid.controller]     = true,
	[clsid.bloodsucker_s]  = true,
	[clsid.bloodsucker]    = true,
	[clsid.pseudodog_s]    = true,
	[clsid.snork_s]        = true,
	[clsid.tushkano_s]     = true,
	[clsid.tushkano]       = true,
	[clsid.gigant_s]       = true,
	[clsid.pseudo_gigant]  = true,
	[clsid.poltergeist_s]  = true,
	[clsid.poltergeist]    = true,
	[clsid.script_stalker] = true
}

function update(delta)
	if not db.actor then return end

	if loadedsim == false and walk_on == true then
		local sim = g_sim
		if not sim then return end
		local scan_end = scan_pos + scan_batch - 1
		if scan_end > MAX_OBJ_ID then scan_end = MAX_OBJ_ID end
		for id = scan_pos, scan_end do
			local kill = sim:object(id)
			if kill then
				if montabl[kill:clsid()] then
					if kill
						and not kill.online
						and kill.m_game_vertex_id
						and game_graph():valid_vertex_id(kill.m_game_vertex_id)
						and kill.health
						and kill:alive()
						and not (kill:clsid() == clsid.script_stalker and olr_protected.is_no_offline_alife_obj(kill:name()))
					then
						local strn_id = kill:smart_terrain_id()
						if strn_id ~= BAD_OBJ_ID then
							local obj_level = sim:level_name(game_graph():vertex(kill.m_game_vertex_id):level_id())
							if obj_level ~= level.name() then
								table.insert(tabst, kill)
							end
						end
					end
				end
			end
		end
		if scan_end >= MAX_OBJ_ID then
			loadedsim = true
			ofl_walkers_cnt = #tabst
			scan_pos = 1
		else
			scan_pos = scan_end + 1
		end
		return
	end

	if loadedsim == true and db.actor then
		if time_global() > time_apdeyta then
			time_apdeyta = time_global() + timerup

			local cnt = #tabst
			if cnt == 0 then return end
			if proc_idx > cnt then proc_idx = 1 end

			local processed = 0
			while processed < proc_batch and processed < cnt do
				local val = tabst[proc_idx]
				if val
					and not val.online
					and val.m_game_vertex_id
					and game_graph():valid_vertex_id(val.m_game_vertex_id)
					and val.health
					and val:alive()
				then
					if val.id and val.level_name == level.name() then
						local strn_id = val:smart_terrain_id()
						if strn_id then
							local smart = g_sim:object(strn_id)
							if smart and val.level_name == "l01_escape" and val.position:distance_to_xz(vector():set(-133, 1, 238)) < 30 then
								g_sim:teleport_object(val.id, smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id)
							end
						end
					else
						pcall(procees, val)
					end
				end

				proc_idx = proc_idx + 1
				if proc_idx > cnt then proc_idx = 1 end
				processed = processed + 1
			end
		end
	end
end

function procees(val)
	if val and val.id then
		if g_sim:object(val.id) then
			if val.brain then
				if val:brain() then
					val:brain():update(true)
				end
			end
		end
	end
end
