local function get_npcs_tasks()
	return get_value("nlc.olr_npcs_tasks") or {}
end

local function save_npcs_tasks(t)
	set_value("nlc.olr_npcs_tasks", t)
end

local function get_npcs_rndway()
	return get_value("nlc.olr_npcs_tasks_rndway") or {}
end

local function save_npcs_rndway(t)
	set_value("nlc.olr_npcs_tasks_rndway", t)
end


function set_maintask_substates(obj, rnd_quest)
	local rndway = get_npcs_rndway()
	local rnd_idx = math.random(#global_task_rnd_way)
	rndway[obj:name()] = global_task_rnd_way[rnd_idx].name
	save_npcs_rndway(rndway)
end


function on_spawn_npc(obj)
	if obj and IsStalker(obj) then
		local comm = obj:community()
		if comm == "monolith" or comm == "military" or comm == "zombied" then
			return
		end
		local tasks = get_npcs_tasks()
		if not tasks[obj:name()] then
			local rndpos = math.random(#global_task)
			local rnd_quest = global_task[rndpos].name
			tasks[obj:name()] = rnd_quest
			save_npcs_tasks(tasks)
			if tasks[obj:name()] then
				set_maintask_substates(obj, rnd_quest)
			end
		end
	end
end


function has_task(obj)
	if obj and IsStalker(obj) then
		local tasks = get_npcs_tasks()
		local rndway = get_npcs_rndway()
		local task_name = tasks[obj:name()]
		if task_name then
			if task_name == "find_monolit" or task_name == "reason_zone" then
				return true
			end
			if rndway[obj:name()] ~= nil then
				return true
			end
		end
	end
	return false
end


function get_task_walk(obj)
	if not (obj and IsStalker(obj)) then return nil end

	local tasks = get_npcs_tasks()
	local rndway = get_npcs_rndway()
	local task_name = tasks[obj:name()]

	if not task_name then return nil end

	if task_name == "find_monolit" then
		return "pri_followers_leader_walk2"
	end

	if task_name == "reason_zone" then
		return "prizrak_radar_walk"
	end

	local way = rndway[obj:name()]
	if way then
		return way
	end

	return nil
end
