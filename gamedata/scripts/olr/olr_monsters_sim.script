-- [HE-PORT]
function pick_travel_target(sim, sec)
	local okc, comm = pcall(function() return sec:community() end)
	if not okc or not comm then return nil end
	local cur
	local sid = sec:smart_terrain_id()
	if sid and sid ~= BAD_OBJ_ID then
		local smart = sim:object(sid)
		cur = smart and smart:name()
	end
	local actor_level = level.name()
	local tname = olr_smart_index.pick_name(comm, cur, actor_level)
	if not tname or olr_smart_index.get_level(tname) == actor_level then return nil end
	return tname
end

function sim_location_traveling()
	if not db.actor then return end
	if #sectionsa == 0 then return end

	local sim = g_sim
	if not sim then return end
	if not olr_smart_index.ensure() then return end -- [HE-PORT]

	for _, val in ipairs(sectionsa) do
		if val then
			local sec = sim:object(val[1])
			if sec and sec:alive() and has_alife_info(val[2]) then
				local gvid = sec.m_game_vertex_id
				if gvid and game_graph():valid_vertex_id(gvid) then
					local sec_level = sim:level_name(game_graph():vertex(gvid):level_id())
					if sec_level ~= level.name() then
						if math.random(1, 200) == 1 then
							-- [HE-PORT]
							local tname = pick_travel_target(sim, sec)
							local target = tname and olr_smart_index.get_obj(tname)
							if target then
								pcall(function()
									sim:teleport_object(sec.id, target.position, target.m_level_vertex_id, target.m_game_vertex_id)
									olr_smart_index.attach_to(sec, tname)
								end)
							end
						end
					end
				end
			end
		end
	end
end
