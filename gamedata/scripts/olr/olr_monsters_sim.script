function sim_kill_stalkers()
	if not olr_timers.has_timer("zombies_task_select_timer") then
		olr_timers.st_timer("zombies_task_select_timer", 65, "olr_offline_task.zombies_task_select()")
	end

	if not olr_timers.has_timer("dogs_task_select_timer") then
		olr_timers.st_timer("dogs_task_select_timer", 270, "olr_offline_task.dogs_task_select()")
	end

	if not olr_timers.has_timer("stalkers_neutral_task_select_timer") then
		olr_timers.st_timer("stalkers_neutral_task_select_timer", 480, "olr_offline_task.stalkers_neutral_task_select()")
	end

	if not olr_timers.has_timer("ecologs_neutral_task_select") then
		olr_timers.st_timer("ecologs_neutral_task_select", 850, "olr_offline_task.ecologs_neutral_task_select()")
	end

	if not olr_timers.has_timer("stalkers_bandits_task_select_timer") then
		olr_timers.st_timer("stalkers_bandits_task_select_timer", 1140, "olr_offline_task.bandits_neutral_task_select()")
	end

	if not olr_timers.has_timer("stalkers_dolg_task_select_timer") then
		olr_timers.st_timer("stalkers_dolg_task_select_timer", 1454, "olr_offline_task.dolgs_task_select()")
	end

	if not olr_timers.has_timer("freedom_task_select_timer") then
		olr_timers.st_timer("freedom_task_select_timer", 960, "olr_offline_task.freedom_task_select()")
	end

	if not olr_timers.has_timer("killers_task_select_timer") then
		olr_timers.st_timer("killers_task_select_timer", 1700, "olr_offline_task.killers_task_select()")
	end

	if not olr_timers.has_timer("military_task_select_timer") then
		olr_timers.st_timer("military_task_select_timer", 1900, "olr_offline_task.military_task_select()")
	end
end

