local smart_cache_sim = {}
local smart_cache_sim_built = false

local function build_smart_cache_sim()
	if smart_cache_sim_built then return end
	local sim = g_sim
	if not sim then return end
	smart_cache_sim = {}
	if db and db.smart_terrain_by_id then
		for id, obj in pairs(db.smart_terrain_by_id) do
			if obj then
				table.insert(smart_cache_sim, obj)
			end
		end
		if #smart_cache_sim > 0 then
			smart_cache_sim_built = true
			return
		end
	end
	-- fallback: slow full scan once
	for id = 1, MAX_OBJ_ID do
		local obj = sim:object(id)
		if obj then
			local cls = obj:clsid()
			if cls == clsid.respawn or cls == clsid.smart_terrain then
				table.insert(smart_cache_sim, obj)
			end
		end
	end
	smart_cache_sim_built = true
end

function sim_location_traveling()
	if not db.actor then return end
	if #sectionsa == 0 then return end

	local sim = g_sim
	if not sim then return end

	build_smart_cache_sim()
	if #smart_cache_sim == 0 then return end

	for _, val in ipairs(sectionsa) do
		if val then
			local sec = sim:object(val[1])
			if sec and sec:alive() and has_alife_info(val[2]) then
				local gvid = sec.m_game_vertex_id
				if gvid and game_graph():valid_vertex_id(gvid) then
					local sec_level = sim:level_name(game_graph():vertex(gvid):level_id())
					if sec_level ~= level.name() then
						if math.random(1, 200) == 1 then
							local target = smart_cache_sim[math.random(#smart_cache_sim)]
							if target then
								pcall(function()
									sim:teleport_object(sec.id, target.position, target.m_level_vertex_id, target.m_game_vertex_id)
									olr_smart_index.attach_to(sec, target:name())
								end)
							end
						end
					end
				end
			end
		end
	end
end
