
local INI_PATH = "misc\\olr_alife.ltx"
local KEY = "nlc.olr_under"
local NEAR_ACTOR = 165
local PER_TICK = 4

local cfg = nil
local passages = nil

local function config()
	if cfg then return cfg end
	cfg = { species = {}, pairs = {}, surface_of = {}, open = {}, indoor = {}, surface = {} }
	local ini = ini_file(INI_PATH)
	for i = 0, ini:line_count("underground") - 1 do
		local _, key, val = ini:r_line("underground", i, "", "")
		cfg[key] = tonumber(val) or val
	end
	for name, chance in string.gmatch(cfg.under_species, "([%w_]+):(%d+)") do cfg.species[name] = tonumber(chance) end
	for name in string.gmatch(cfg.under_surface_levels, "[%w_]+") do cfg.surface[name] = true end
	for i = 0, ini:line_count("underground_pairs") - 1 do
		local _, surface, val = ini:r_line("underground_pairs", i, "", "")
		local under, chapter = string.match(val, "([%w_]+)%s*,%s*(%d+)")
		cfg.pairs[surface] = under
		cfg.surface_of[under] = surface
		cfg.open[under] = tonumber(chapter)
	end
	if ini:section_exist("underground_indoor") then
		for i = 0, ini:line_count("underground_indoor") - 1 do
			local _, lvl, val = ini:r_line("underground_indoor", i, "", "")
			cfg.indoor[lvl] = {}
			for s in string.gmatch(val, "[%w_]+") do table.insert(cfg.indoor[lvl], s) end
		end
	end
	return cfg
end

local function ulog(fmt, ...)
	log2("[olr_under] " .. fmt, ...)
end

local function get_state()
	local st = get_value(KEY) or {}
	st.down = st.down or {}
	st.done = st.done or {}
	st.news = st.news or {}
	return st
end

local function put_state(st)
	set_value(KEY, st)
end

local function level_of_gv(gv)
	return alife():level_name(game_graph():vertex(gv):level_id())
end

local passages_at = 0

local function find_passages(again)
	if passages and not ( again and timers.Get_Game_Seconds() - passages_at >= 3600 ) then return passages end
	passages_at = timers.Get_Game_Seconds()
	passages = {}
	local n = 0
	for _, se in alife():objects() do
		if se:section_name() == "level_changer" then
			local data = kotovod.get_lc_data(se)
			local from = olr_smart_index.object_level(se)
			local to = data and data.dest_game_vertex_id and level_of_gv(data.dest_game_vertex_id)
			if from and to and from ~= to then
				local d = data.dest_position
				passages[to] = passages[to] or {}
				passages[to][from] = { pos = vector():set(d.x, d.y, d.z), lv = data.dest_level_vertex_id, gv = data.dest_game_vertex_id }
				n = n + 1
			end
		end
	end
	ulog("%d level passages found", n)
	return passages
end

local function minute_of_day()
	return level.get_time_hours() * 60 + level.get_time_minutes()
end

local function day_number()
	return math.floor(timers.Get_Game_Seconds() / 86400)
end

local function own_offset(id, salt)
	return ( id * 7919 + day_number() * 104729 + salt ) % config().under_window_min
end

local function in_window(start_h, id, salt)
	local c = config()
	local start = start_h * 60
	local m = minute_of_day()
	if m < start then m = m + 1440 end
	local into = m - start
	return into < c.under_window_min + 60 and into >= own_offset(id, salt)
end

local function species_of(section)
	for name, chance in pairs(config().species) do
		if string.find(section, name, 1, true) then return name, chance end
	end
	return nil
end

local function goes_today(id, chance)
	return ( id * 31 + day_number() * 17 ) % 100 < chance
end

local function under_open(under)
	local gate = config().open[under]
	return gate ~= nil and olr_cfg.chapter() >= gate and not olr_cfg.level_closed(under)
end

local function home_for(lvl)
	local c = config()
	if c.pairs[lvl] and under_open(c.pairs[lvl]) then return c.pairs[lvl] end
	for nb in pairs(olr_smart_index.neighbour_levels(lvl)) do
		local under = c.pairs[nb]
		if under and under_open(under) then return under end
	end
	return nil
end

local function down_count(st, under)
	local n = 0
	for _, rec in pairs(st.down) do
		if rec.to == under then n = n + 1 end
	end
	return n
end

local function free_indoor(lvl)
	local list = config().indoor[lvl]
	if not list then return nil end
	local sim = alife()
	for _, name in ipairs(list) do
		local smart = olr_smart_index.get_obj(name)
		if smart then
			local people = 0
			for _, comm in ipairs({ "stalker", "green", "dolg", "freedom", "ecolog", "military", "killer", "bandit", "monolith" }) do
				for _, id in ipairs(olr_offline_task.cached_stalkers(comm)) do
					local se = sim:object(id)
					if se and IsStalker(se) and se:alive() and olr_smart_index.object_level(se) == lvl and se.position:distance_to(smart.position) <= config().indoor_radius then
						people = people + 1
					end
				end
			end
			if people <= config().indoor_max_people then return smart end
		end
	end
	return nil
end

local function unseen(se, lvl, pos)
	if se.online then return false end
	return lvl ~= level.name() or ( pos or se.position ):distance_to(db.actor:position()) > NEAR_ACTOR
end

local function go_down(st, se, lvl, kind)
	local c = config()
	local here = { x = se.position.x, y = se.position.y, z = se.position.z, lv = se.m_level_vertex_id, gv = se.m_game_vertex_id }
	if kind == "bloodsucker" then
		local spot = free_indoor(lvl)
		if spot then
			alife():teleport_object(se.id, spot.position, spot.m_level_vertex_id, spot.m_game_vertex_id)
			st.down[tostring(se.id)] = { sec = se:section_name(), kind = "indoor", from = lvl, to = lvl, back = here }
			ulog("%s id=%d hides indoors at %s on %s", se:section_name(), se.id, spot:name(), lvl)
			return true
		end
	end
	local under = kind == "burer" and home_for(lvl) or ( c.pairs[lvl] and under_open(c.pairs[lvl]) and c.pairs[lvl] )
	if not under then return false end
	if down_count(st, under) >= c.under_cap then
		ulog("%s id=%d stays on %s: %s is full (%d)", se:section_name(), se.id, lvl, under, c.under_cap)
		return false
	end
	local surface = c.surface_of[under]
	local entry = find_passages()[under] and find_passages()[under][surface]
	if not entry then entry = find_passages(true)[under] and find_passages()[under][surface] end
	if not entry then
		ulog("%s id=%d stays on %s: no passage from %s into %s", se:section_name(), se.id, lvl, surface, under)
		return false
	end
	local name = olr_smart_index.nearest_on_level(under, entry.pos.x, entry.pos.z)
	local smart = name and olr_smart_index.get_obj(name)
	local pos, lv, gv = entry.pos, entry.lv, entry.gv
	if smart then pos, lv, gv = smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id end
	if under == level.name() and pos:distance_to(db.actor:position()) <= NEAR_ACTOR then return false end
	alife():teleport_object(se.id, pos, lv, gv)
	st.down[tostring(se.id)] = { sec = se:section_name(), kind = "under", from = lvl, to = under, back = here }
	ulog("%s id=%d goes down from %s into %s at %s", se:section_name(), se.id, lvl, under, smart and smart:name() or "the passage")
	return true
end

local function say_out(st, surface, pos)
	local c = config()
	local region = olr_smart_index.region_levels()
	if not ( region and region[surface] and he_pda_model.get_pda() ) then return end
	local n = timers.Get_Game_Seconds()
	if n < ( st.news[surface] or 0 ) or math.random(100) > c.under_news_chance then return end
	local sim = alife()
	local who = {}
	for _, comm in ipairs({ "stalker", "dolg", "freedom", "ecolog", "bandit" }) do
		for _, id in ipairs(olr_offline_task.cached_stalkers(comm)) do
			local se = sim:object(id)
			if se and IsStalker(se) and se:alive() and olr_smart_index.object_level(se) == surface and not olr_trader_runs.has_story_name(se) then
				table.insert(who, se)
			end
		end
	end
	if #who == 0 then return end
	local key = olr_trader_runs.pick_line("olr_under_out_")
	if not key then
		ulog("no text for olr_under_out_")
		return
	end
	st.news[surface] = n + c.under_news_cd_h * 3600
	local speaker = who[math.random(#who)]
	local where = news_main.localized_where(surface, pos)
	local text = string.gsub(game.translate_string(key), "%$where", function() return where end)
	sak.send_tip(text, olr_trader_runs.display_name(speaker), 0, 15, "default", "pda_news", "gray")
	ulog("line %s from %s id=%d, %s", key, speaker:name(), speaker.id, where)
end

local function come_up(st, key, rec, se)
	local c = config()
	if rec.kind == "indoor" then
		local pos = vector():set(rec.back.x, rec.back.y, rec.back.z)
		if not unseen(se, rec.from, pos) then return false end
		alife():teleport_object(se.id, pos, rec.back.lv, rec.back.gv)
		ulog("%s id=%s leaves its indoor spot on %s", rec.sec, key, rec.from)
		return true
	end
	if se.online then return false end
	local surface = c.surface_of[rec.to]
	local exit = find_passages()[surface] and find_passages()[surface][rec.to]
	if not exit then exit = find_passages(true)[surface] and find_passages()[surface][rec.to] end
	if not exit then
		ulog("%s id=%s stays down for good: no passage from %s onto %s", rec.sec, key, rec.to, surface)
		st.down[key] = nil
		return false
	end
	if surface == level.name() and exit.pos:distance_to(db.actor:position()) < c.under_min_dist then return false end
	alife():teleport_object(se.id, exit.pos, exit.lv, exit.gv)
	ulog("%s id=%s comes out of %s onto %s", rec.sec, key, rec.to, surface)
	say_out(st, surface, exit.pos)
	return true
end

local function dawn(st, forced)
	local c = config()
	local sim = alife()
	local kept = news_encounters.tracked_ids()
	local moved = 0
	for _, id in ipairs(olr_offline_task.cached_monsters()) do
		if moved >= ( forced and 999 or PER_TICK ) then break end
		local se = sim:object(id)
		if se and IsMonster(se) and se:alive() and not st.down[tostring(id)] and not kept[id] and ( forced or st.done[tostring(id)] ~= day_number() ) then
			local kind, chance = species_of(se:section_name())
			local lvl = kind and olr_smart_index.object_level(se)
			if lvl and c.surface[lvl] and ( forced or in_window(c.under_dawn_h, id, 0) ) and ( kind == "burer" or goes_today(id, chance) )
				and unseen(se, lvl) and not olr_protected.is_protected_monster(se)
			then
				st.done[tostring(id)] = day_number()
				if go_down(st, se, lvl, kind) then moved = moved + 1 end
			end
		end
	end
	return moved
end

local function dusk(st, forced)
	local c = config()
	local sim = alife()
	local moved = 0
	for key, rec in pairs(st.down) do
		if moved >= ( forced and 999 or PER_TICK ) then break end
		local se = sim:object(tonumber(key))
		if not ( se and IsMonster(se) and se:alive() and se:section_name() == rec.sec ) then
			ulog("id=%s %s did not see the dusk", key, rec.sec)
			st.down[key] = nil
		elseif forced or in_window(c.under_dusk_h, tonumber(key), 1) then
			if come_up(st, key, rec, se) then
				st.down[key] = nil
				moved = moved + 1
			end
		end
	end
	return moved
end

local function phase()
	local c = config()
	local m = minute_of_day()
	local function inside(h)
		local start = h * 60
		local into = ( m - start + 1440 ) % 1440
		return into < c.under_window_min + 60
	end
	if inside(c.under_dawn_h) then return "dawn" end
	if inside(c.under_dusk_h) then return "dusk" end
	return nil
end

function update()
	if not ( db.actor and olr_cfg.on("underground") ) then return end
	olr_smart_index.ensure()
	local p = phase()
	if not p then return end
	local st = get_state()
	if p == "dawn" then
		for k, d in pairs(st.done) do
			if d < day_number() then st.done[k] = nil end
		end
		dawn(st, false)
	else
		dusk(st, false)
	end
	put_state(st)
end

function report()
	local st = get_state()
	local n = 0
	for key, rec in pairs(st.down) do
		n = n + 1
		ulog("  %s id=%s %s, from %s to %s", rec.sec, key, rec.kind, rec.from, rec.to)
	end
	ulog("on=%s phase=%s chapter=%d down=%d", tostring(olr_cfg.on("underground")), tostring(phase()), olr_cfg.chapter(), n)
	for under, surface in pairs(config().surface_of) do
		local p = find_passages()
		ulog("  %s <-> %s: open=%s, in %d, passage down=%s up=%s", surface, under, tostring(under_open(under)), down_count(st, under),
			tostring(p[under] ~= nil and p[under][surface] ~= nil), tostring(p[surface] ~= nil and p[surface][under] ~= nil))
	end
end

function force_dawn()
	olr_smart_index.ensure()
	local st = get_state()
	ulog("force_dawn: %d went down", dawn(st, true))
	put_state(st)
end

function force_dusk()
	local st = get_state()
	ulog("force_dusk: %d came out", dusk(st, true))
	put_state(st)
end
