-- [HE-PORT]
local MIN_ACTOR_DIST      = 300
local SAVE_KEY            = "olr_monster_squads.ids"
-- [HE-PORT]
local REGION_SHARE        = 70
local RECYCLE_BATCH       = 6

local time_next_spawn = 0
local spawned_ids = {}
local loaded = false

local monster_comms = {
	"dog", "pseudodog", "boar", "flesh", "snork", "bloodsucker",
	"tushkano", "burer", "controller", "poltergeist", "cat", "chimera", "giant",
}

local squad_types = {
	{ comm = "dog",         tier = "weak",   min = 3, max = 6,
	  sections = { "dog_weak", "dog_weak", "dog_normal" } },
	{ comm = "flesh",       tier = "weak",   min = 2, max = 4,
	  sections = { "flesh_weak", "flesh_normal" } },
	{ comm = "boar",        tier = "weak",   min = 2, max = 4,
	  sections = { "boar_weak", "boar_normal" } },
	{ comm = "tushkano",    tier = "weak",   min = 3, max = 6,
	  sections = { "tushkano_normal" } },
	{ comm = "dog",         tier = "weak",   min = 2, max = 5,
	  sections = { "dog_normal", "dog_weak" } },

	{ comm = "dog",         tier = "medium", min = 3, max = 5,
	  sections = { "dog_normal", "dog_strong" } },
	{ comm = "pseudodog",   tier = "medium", min = 2, max = 4,
	  sections = { "pseudodog_weak", "pseudodog_normal" } },
	{ comm = "snork",       tier = "medium", min = 2, max = 4,
	  sections = { "snork_weak", "snork_normal" } },
	{ comm = "flesh",       tier = "medium", min = 2, max = 4,
	  sections = { "flesh_normal", "flesh_strong" } },
	{ comm = "boar",        tier = "medium", min = 2, max = 3,
	  sections = { "boar_normal", "boar_strong" } },
	{ comm = "cat",         tier = "medium", min = 2, max = 4,
	  sections = { "cat_weak", "cat_normal" } },

	{ comm = "pseudodog",   tier = "strong", min = 2, max = 3,
	  sections = { "pseudodog_normal", "pseudodog_strong" } },
	{ comm = "snork",       tier = "strong", min = 2, max = 3,
	  sections = { "snork_normal", "snork_strong" } },
	{ comm = "cat",         tier = "strong", min = 2, max = 3,
	  sections = { "cat_normal", "cat_strong" } },
	{ comm = "bloodsucker", tier = "strong", min = 1, max = 2,
	  sections = { "bloodsucker_weak", "bloodsucker_normal" } },
	{ comm = "bloodsucker", tier = "strong", min = 1, max = 2,
	  sections = { "bloodsucker_normal", "bloodsucker_strong" } },
	{ comm = "burer",       tier = "strong", min = 1, max = 2,
	  sections = { "burer_weak", "burer_normal" } },
	{ comm = "poltergeist", tier = "strong", min = 1, max = 2,
	  sections = { "m_poltergeist_normal_tele", "m_poltergeist_normal_flame" } },
	{ comm = "controller",  tier = "strong", min = 1, max = 1,
	  sections = { "m_controller_normal" } },
	{ comm = "chimera",     tier = "strong", min = 1, max = 1,
	  sections = { "chimera_weak", "chimera_normal" } },
	{ comm = "giant",       tier = "strong", min = 1, max = 1,
	  sections = { "gigant_normal" } },
}

local by_tier = { weak = {}, medium = {}, strong = {} }
for i = 1, #squad_types do
	local st = squad_types[i]
	table.insert(by_tier[st.tier], st)
end

-- [HE-PORT]
local own_sections = {}
for i = 1, #squad_types do
	local list = squad_types[i].sections
	for j = 1, #list do own_sections[ list[ j ] ] = true end
end

local function tier_weights()
	local h = level.get_time_hours()
	if h >= 22 or h < 5 then
		return 20, 40, 40
	elseif h < 8 or h >= 20 then
		return 35, 40, 25
	elseif h < 10 then
		return 45, 37, 18
	end
	return 55, 33, 12
end

local function pick_tier()
	local w, m, s = tier_weights()
	if not olr_cfg.on("monster_strong_tier") then s = 0 end
	local roll = math.random(1, w + m + s)
	if roll <= w then return "weak" end
	if roll <= w + m then return "medium" end
	return "strong"
end

local function is_night()
	local h = level.get_time_hours()
	return h >= 21 or h < 6
end

local function pick_squad_type()
	local list = by_tier[pick_tier()]
	if not list or #list == 0 then
		list = by_tier.weak
	end
	if not list or #list == 0 then return nil end
	return list[math.random(#list)]
end

local function load_ids()
	if loaded then return end
	loaded = true
	local t = get_value(SAVE_KEY, nil)
	if type(t) == "table" then
		for _, id in ipairs(t) do
			if type(id) == "number" then
				spawned_ids[id] = true
			end
		end
	end
end

local function store_ids()
	local t = {}
	for id, _ in pairs(spawned_ids) do
		table.insert(t, id)
	end
	set_value(SAVE_KEY, t)
end

local function count_alive()
	local sim = g_sim or alife()
	if not sim then return 0 end
	local alive = 0
	local dead = {}
	for id, _ in pairs(spawned_ids) do
		local obj = sim:object(id)
		if obj and IsMonster(obj) and obj:alive() then
			alive = alive + 1
		else
			table.insert(dead, id)
		end
	end
	for i = 1, #dead do
		spawned_ids[dead[i]] = nil
	end
	return alive
end

-- [HE-PORT]
local function count_in_region()
	local region = olr_smart_index.region_levels()
	local sim = g_sim or alife()
	if not ( region and sim ) then return 0 end
	local n = 0
	for id, _ in pairs(spawned_ids) do
		local obj = sim:object(id)
		if obj and IsMonster(obj) and obj:alive() and region[ olr_smart_index.object_level(obj) or "" ] then
			n = n + 1
		end
	end
	return n
end

local counts = {}
local counts_until = 0

function level_counts()
	if time_global() < counts_until then return counts end
	load_ids()
	counts_until = time_global() + 30000
	counts = {}
	local sim = g_sim or alife()
	if not sim then return counts end
	for id, _ in pairs(spawned_ids) do
		local obj = sim:object(id)
		if obj and IsMonster(obj) and obj:alive() then
			local lname = olr_smart_index.object_level(obj) or ""
			counts[lname] = (counts[lname] or 0) + 1
		end
	end
	return counts
end

-- [HE-PORT]
local function recycle_far(limit)
	local region = olr_smart_index.region_levels()
	local sim = g_sim or alife()
	if not ( region and sim ) then return 0 end
	local victims = {}
	for id, _ in pairs(spawned_ids) do
		if #victims >= limit then break end
		local obj = sim:object(id)
		if obj and IsMonster(obj) and obj:alive() and not obj.online
			and own_sections[ obj:section_name() ]
			and not region[ olr_smart_index.object_level(obj) or "" ]
		then
			table.insert(victims, obj)
		end
	end
	for i = 1, #victims do
		spawned_ids[ victims[ i ].id ] = nil
		pcall(function() sim:release(victims[ i ], true) end)
	end
	return #victims
end

local function smart_level(smart_obj)
	local lname = olr_smart_index.get_level(smart_obj:name())
	if lname then return lname end
	local sim = g_sim or alife()
	local gvid = smart_obj.m_game_vertex_id
	if sim and gvid and game_graph():valid_vertex_id(gvid) then
		return sim:level_name(game_graph():vertex(gvid):level_id())
	end
	return nil
end

local function target_allowed(smart_obj)
	local lname = smart_level(smart_obj)
	if not lname then return false end
	if lname ~= level.name() then return true end
	if not olr_cfg.on("spawn_on_player_level") then return false end
	if not db.actor then return false end
	local ok, d = pcall(function()
		return db.actor:position():distance_to(smart_obj.position)
	end)
	if not ok or not d then return false end
	return d > MIN_ACTOR_DIST
end

local function pick_any_monster_name(region)
	local pool = {}
	for i = 1, #monster_comms do
		local list = olr_smart_index.get_names(monster_comms[i])
		for j = 1, #list do
			if not region or region[ olr_smart_index.get_level(list[j]) or "" ] then -- [HE-PORT]
				table.insert(pool, list[j])
			end
		end
	end
	if #pool == 0 then return nil end
	return pool[math.random(#pool)]
end

local function pick_target(comm, region, sections, budget, filter)
	local gates = olr_cfg.on("rank_gates")
	for attempt = 1, 10 do
		local sname
		local only = olr_cfg.intersect_levels(( attempt <= 4 or attempt == 7 or attempt == 8 ) and region or nil, budget) -- [HE-PORT]
		if attempt <= 6 then
			sname = olr_smart_index.pick_name(comm, nil, nil, only)
		elseif olr_cfg.on("monster_any_fallback") then
			sname = pick_any_monster_name(only)
		end
		if sname then
			local sobj = olr_smart_index.get_obj(sname)
			if sobj and target_allowed(sobj)
				and not ( gates and #olr_smart_index.sections_fitting(sname, comm, sections) == 0 )
				and not ( filter and not filter(sname, sobj) )
			then
				return sname, sobj, (attempt <= 6)
			end
		end
	end
	return nil, nil, false
end

local function spawn_squad(in_region, seed_opts)
	local st = pick_squad_type()
	if not st then return 0 end
	if not olr_smart_index.ensure() then return 0 end
	if seed_opts then seed_opts.comm = st.comm end

	local region = in_region and olr_smart_index.region_levels() or nil -- [HE-PORT]
	local budget = seed_opts and seed_opts.only or olr_cfg.budget_open(2, level_counts())
	local smart_name, smart_obj, own_comm = pick_target(st.comm, region, st.sections, budget, seed_opts and seed_opts.filter)
	if not smart_obj then return 0 end
	local pool = st.sections
	if olr_cfg.on("rank_gates") then
		pool = olr_smart_index.sections_fitting(smart_name, st.comm, st.sections)
	end

	local size = math.random(st.min, st.max)
	if is_night() and st.tier ~= "strong" and size < st.max then
		size = size + 1
	end
	if seed_opts then
		size = math.min(size, seed_opts.max_size)
	elseif budget then
		local lname = olr_smart_index.get_level(smart_name)
		local left = olr_cfg.budget_of(2, lname) - ( level_counts()[lname] or 0 )
		size = math.min(size, math.max(2, math.ceil(left)))
	end

	local bind = own_comm and (math.random(1, 100) <= olr_cfg.get("monster_bind_chance"))
	local spawned = 0

	for i = 1, size do
		local section = pool[math.random(#pool)]
		local ok, res = pcall(function()
			local pos = smart_obj.position
			local offset_pos = vector():set(
				pos.x + math.random(-6, 6),
				pos.y,
				pos.z + math.random(-6, 6)
			)
			local obj = alife():create(
				section,
				offset_pos,
				smart_obj.m_level_vertex_id,
				smart_obj.m_game_vertex_id
			)
			if not obj then return false end
			local pk = get_netpk(obj)
			if pk then
				local data = pk:get()
				if data then
					if bind then
						data.custom_data = "[smart_terrains]\n" .. smart_name .. " = true\n"
					else
						data.custom_data = "[smart_terrains]\nnone = true\n"
					end
					pk:set(data)
				end
			end
			spawned_ids[obj.id] = true
			return true
		end)
		if ok and res then
			spawned = spawned + 1
		end
	end

	if spawned > 0 then
		counts_until = 0
		if not seed_opts then olr_population.note_olr(olr_smart_index.get_level(smart_name), false, spawned) end
	end
	return spawned, smart_name
end

function seed_at(sections, spot, home)
	load_ids()
	local sim = alife()
	local n = 0
	for _, section in ipairs(sections) do
		local pos = vector():set(spot.pos.x + math.random(-4, 4), spot.pos.y, spot.pos.z + math.random(-4, 4))
		local obj = sim:create(section, pos, spot.lv, spot.gv)
		if obj then
			local pk = get_netpk(obj)
			local data = pk and pk:get()
			if data then
				data.custom_data = "[smart_terrains]\nnone=true\n[logic]\nactive = mob_home\n[mob_home]\npath_home = " .. home ..
					"\nhome_min_radius = 30\nhome_max_radius = 50\naggressive_home\n"
				pk:set(data)
			end
			obj.smart_terrain_conditions = { none = xr_logic.parse_condlist(obj, "smart_terrains", "none", "true") }
			spawned_ids[obj.id] = true
			n = n + 1
		end
	end
	if n > 0 then
		counts_until = 0
		store_ids()
	end
	return n
end

function seed(lname, filter, max_size)
	if not olr_smart_index.ensure() then return 0 end
	load_ids()
	local opts = { only = { [lname] = true }, filter = filter, max_size = max_size }
	local n, sname = spawn_squad(false, opts)
	if n > 0 then store_ids() end
	return n, sname, opts.comm
end

function update()
	if not db.actor then return end
	if device().precache_frame > 1 then return end
	if olr_cfg.sleep_paused() then return end
	if time_next_spawn == 0 and olr_cfg.on("delay_first_tick") then
		time_next_spawn = time_global() + olr_cfg.get("monster_tick") * 1000
		return
	end
	if time_global() < time_next_spawn then return end

	local sim = g_sim or alife()
	if not sim then return end
	load_ids()

	-- [HE-PORT]
	if olr_cfg.on("budgets") then
		time_next_spawn = time_global() + olr_cfg.get("monster_tick") * 1000
		if olr_smart_index.ensure() then
			spawn_squad(math.random(1, 100) <= REGION_SHARE)
		end
		store_ids()
		return
	end
	local alive = count_alive()
	local max_total = olr_cfg.get("monster_cap")
	if count_in_region() < olr_cfg.get("monster_region_target") then
		time_next_spawn = time_global() + olr_cfg.get("monster_tick_low") * 1000
		if alive >= max_total then
			recycle_far(alive - max_total + RECYCLE_BATCH)
			alive = count_alive()
		end
	else
		time_next_spawn = time_global() + olr_cfg.get("monster_tick") * 1000
	end
	if alive >= max_total then
		store_ids()
		return
	end
	if not olr_smart_index.ensure() then return end

	local waves
	if is_night() then
		waves = math.random(1, 3)
	else
		waves = math.random(1, 2)
	end

	for i = 1, waves do
		if count_alive() >= max_total then break end
		spawn_squad(math.random(1, 100) <= REGION_SHARE) -- [HE-PORT]
	end

	store_ids()
end

function get_status()
	load_ids()
	local w, m, s = tier_weights()
	return count_alive(), w, m, s
end

function is_spawned(id)
	load_ids()
	return spawned_ids[id] ~= nil
end

function known_ids()
	load_ids()
	return spawned_ids
end

function debug_tick()
	time_next_spawn = 1
	update()
end
