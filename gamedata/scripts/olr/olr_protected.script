-- [HE-PORT]
local function all_infos( infos )
	for i = 1, #infos do
		if not has_alife_info( infos[ i ] ) then return false end
	end
	return true
end

local function quests_done( name )
	local infos = release_infos[ name ]
	if not infos then return false end
	if type( infos[ 1 ] ) ~= "table" then return all_infos( infos ) end
	for i = 1, #infos do
		if all_infos( infos[ i ] ) then return true end
	end
	return false
end

function is_released( name )
	return quests_done( name )
end

local protected_monster_sections = {
	["burer_hos"] = true,
}

-- [HE-PORT] a mutant whose part is kept for a quest (Spawn_Inventory_Item_Keep = true in monsters.ltx: Vronsky's
-- hunts and other scene mutants) is the player's to kill and carve: no offline hunt, fight, carrion or move touches it
local keep_part = {}
local function keeps_part(sec)
	local v = keep_part[sec]
	if v == nil then
		local ini = system_ini()
		v = ini:section_exist(sec) and ini:line_exist(sec, "Spawn_Inventory_Item_Keep")
			and string.lower(tostring(ini:r_string(sec, "Spawn_Inventory_Item_Keep"))) == "true" or false
		keep_part[sec] = v
	end
	return v
end

function is_protected_monster(se_obj)
	if se_obj == nil then return false end
	local sec = se_obj:section_name()
	return protected_monster_sections[ sec ] == true or keeps_part(sec)
end

function is_no_offline_alife_obj(name)
	if he_mil_freedom_reinf.is_protected(name) then return true end -- [HE-PORT]
	if he_quest_target_lock.is_locked(name) then return true end -- [HE-PORT]
	if not no_offline_alife_objs[ name ] then return nil end
	-- [HE-PORT]
	if always_protected[ name ] then return true end
	if quests_done( name ) then return nil end
	return true
end

-- [HE-PORT]
-- [HE-PORT]
function is_always_protected(name)
	return always_protected[ name ] == true
end

-- [HE-PORT] quest-bound: an NPC the original mod stages for a quest, which OLR must not move, rebind or drag into
-- offline fights until that quest lets him go. Moving him cannot be undone: xrs_utils.set_smart_terrain rewrites his
-- custom data and drops the authored [smart_terrains] that stage him (gar_dram lost Orekh's men this way).
-- True for: the protected names and quest locks above; a story id whose release (release_infos) is not reached yet;
-- a smart that is a quest scene ([seed_exclude]); a gulag job reserved by object name or by profile; a written character name; own
-- [logic] or a [smart_terrains] line with a condition in his custom data. OLR's and the respawners' own people have
-- no staging, so only the first three apply to them. Cached per id for a minute of game-script time.
local gulag_profiles = {
	bar_dolg_kicenko = true, bar_dolg_petrenko = true, bar_dolg_plichko = true, esc_fanat = true, esc_fox = true,
	esc_petruha = true, esc_provodnik = true, esc_shustryi = true, esc_wolf = true, gar_bandit_dm_3 = true,
	gar_bandit_general = true, gar_bandit_leader = true, gar_bes = true, gar_dolg_prapor = true, gar_kulinar = true,
	gar_seriy = true, gar_yurik = true, green_dan = true, mar_soldier_kalinin = true,
	mil_freedom_blockpost_commander = true, mil_freedom_cook = true, mil_freedom_lukash = true, mil_freedom_max = true,
	mil_freedom_shurup = true, mil_freedom_skryaga = true, mil_freedom_ugrumiy = true, ros_fraer = true,
	ros_kocherga = true, serafim = true, sim_diador = true, val_bandit_borov = true, val_bandit_general = true,
	val_voron = true, vorobey = true,
}

-- [HE-PORT] gulag jobs reserved by object name (obj_info.name == "..." in gulag/*.script, 2026-11-10): scene actors their
-- gulag expects in that exact job; moving one away breaks the scene (the Cordon factory gang ended on Garbage)
local gulag_names = {
	agr_factory_assault_killer1 = true, agr_factory_assault_killer2 = true, agr_factory_assault_killer3 = true,
	agr_factory_assault_killer4 = true, agr_factory_assault_killer5 = true, agr_factory_assault_killer6 = true,
	agr_factory_assault_killer7 = true, agr_factory_assault_killer8 = true, agr_nii_commander = true,
	art_exchanger = true, aver_stalker_monolith_glavn = true, bar_bar_osvedomitel = true, bar_ecolog_professor = true,
	cit_bandit_leader = true, dead_ecolog_03 = true, esc_blokpost_commander = true, esc_bridge_soldier5 = true,
	esc_factory_bandit_glavn = true, esc_factory_bandit_guard = true, esc_fox = true, esc_killer1 = true,
	esc_killer10 = true, esc_killer2 = true, esc_killer3 = true, esc_killer4 = true, esc_killer6 = true,
	esc_killer7 = true, esc_killer8 = true, esc_killer9 = true, esc_novice_attacker1 = true,
	esc_novice_attacker2 = true, esc_soldier_commander_sub = true, esc_vagon_wounded = true, gar_bandit_agr_1 = true,
	gar_bandit_agr_10 = true, gar_bandit_agr_11 = true, gar_bandit_agr_12 = true, gar_bandit_agr_13 = true,
	gar_bandit_agr_2 = true, gar_bandit_agr_3 = true, gar_bandit_agr_4 = true, gar_bandit_agr_5 = true,
	gar_bandit_agr_7 = true, gar_bandit_agr_8 = true, gar_bandit_agr_9 = true, gar_bandit_blokpost01 = true,
	gar_dolg_commander_blokpost = true, gar_seryi_drug3 = true, gar_sniper_bandit = true, gar_wounded_bandit = true,
	lim_bandit_03 = true, mar_military_post_04 = true, marsh_ecolog1 = true, marsh_ecolog2 = true,
	marsh_ecolog_general = true, marsh_oksana2 = true, marsh_provodnik_sev_khutor = true, marsh_stalker_2 = true,
	mil_patrol_glavn = true, rad_killer_unknown = true, real_gluzov = true, real_gluzov_nap = true, stepanych = true,
	stepanych2 = true, td_stalker_fraer = true, val_sos_bs = true, val_vlad = true, yan_dolg_petrenko = true,
}

local bound_cache = {}

local function has_sid(se)
	local sid = se.m_story_id
	return sid ~= nil and sid ~= NONE_SID and sid ~= NONE_CL_SID
end

local function generic(se, name)
	return string.sub(se:section_name(), 1, 4) == "olr_" or string.find(name, "_respawn", 1, true) ~= nil
		or olr_squads.is_spawned(se.id)
end

local function staged(se)
	local ini = se:spawn_ini()
	if not ini then return nil end
	if ini:section_exist("logic") then return "logic" end
	if ini:section_exist("smart_terrains") then
		for i = 0, ini:line_count("smart_terrains") - 1 do
			local _, k, v = ini:r_line("smart_terrains", i, "", "")
			if string.find(( k or "" ) .. ( v or "" ), "{", 1, true) then return "smart_terrains" end
		end
	end
	return nil
end

local function why_bound(se, name)
	if is_no_offline_alife_obj(name) then return "protected" end
	if has_sid(se) and not quests_done(name) then return "story_id" end
	local sid = se:smart_terrain_id()
	local smart = sid and sid ~= BAD_OBJ_ID and alife():object(sid)
	if smart and olr_population.is_scene_smart(smart:name()) then return "scene_smart" end
	if gulag_names[name] then return "gulag_name" end
	if generic(se, name) then return nil end
	if IsStalker(se) then
		if se.profile_name and gulag_profiles[se:profile_name()] then return "gulag_profile" end
		if olr_trader_runs.has_story_name(se) then return "written_name" end
	end
	return staged(se)
end

function quest_bound_reason(se)
	if not ( se and se.id and se.id ~= 0 ) then return nil end
	local name = se:name()
	local c = bound_cache[se.id]
	local now = time_global()
	if c and c.name == name and now < c.till then return c.why end
	local why = why_bound(se, name)
	bound_cache[se.id] = { name = name, why = why, till = now + 60000 }
	return why
end

function is_quest_bound(se)
	return quest_bound_reason(se) ~= nil
end

-- [HE-PORT]
function is_travel_blocked(name)
	if always_protected[ name ] then return true end
	if release_infos[ name ] and not quests_done( name ) then return true end
	return false
end
