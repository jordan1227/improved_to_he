-- [HE-PORT]
local function obj_level_name(obj)
	local sim = g_sim or alife()
	if not sim then return nil end
	local ok, lname = pcall(function()
		return sim:level_name(game_graph():vertex(obj.m_game_vertex_id):level_id())
	end)
	if ok then return lname end
	return nil
end

-- [HE-PORT]
function bar_sweep()
	if not db.actor then return end
	if not olr_smart_index.ensure() then return end
	local sim = g_sim
	if not sim then return end
	rebuild_cache()

	for comm, ids in pairs(stalker_ids_cache) do
		if olr_faction_policy.level_denied(comm, "l05_bar") then
			for _, id in ipairs(ids) do
				local kill = sim:object(id)
				if kill and kill:alive() and not kill.online and has_wander_record(kill:name()) then
					if obj_level_name(kill) == "l05_bar" then
						local target = olr_smart_index.pick_name(comm, nil, "l05_bar")
						local smart = target and olr_smart_index.get_obj(target)
						if smart then
							pcall(function()
								sim:teleport_object(id, smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id)
							end)
						end
					end
				end
			end
		end
	end
end

-- [HE-PORT]
local ROAM_INTERVAL = 5 * 60000
local roam_next = 0
local roam_idx = 0
local roam_plan = {
	"stalker",
	"bandit",
	"dolg",
	"killer",
	"freedom",
	"military",
	"ecolog",
}

-- [HE-PORT]
function roam_update()
	if not db.actor then return end
	if device().precache_frame > 1 then return end
	if sleep_manager and sleep_manager.is_sleep_active and sleep_manager.is_sleep_active() then return end
	if time_global() < roam_next then return end
	roam_next = time_global() + ROAM_INTERVAL
	roam_idx = roam_idx + 1
	if roam_idx > #roam_plan then roam_idx = 1 end
	pcall(faction_migration, roam_plan[roam_idx])
	pcall(bar_sweep)
end

local function monster_migration()
	if not db.actor then return end
	if sleep_manager and sleep_manager.is_sleep_active and sleep_manager.is_sleep_active() then return end
	if not olr_smart_index.ensure() then return end
	rebuild_cache()
	if not monster_ids_cache or #monster_ids_cache == 0 then return end
	local sim = g_sim
	if not sim then return end

	for _, id in ipairs(monster_ids_cache) do
		local kill = sim:object(id)
		if kill and kill:alive() and not kill.online then
			local strn_id = kill:smart_terrain_id()
			if strn_id ~= BAD_OBJ_ID then
				if math.random(1, 3) ~= 1 then
					local cls = kill:clsid()
					local comm = monster_comm_by_clsid[cls]
					if not comm then
						local okc, c = pcall(function() return kill:community() end)
						if okc then comm = c end
					end
					if comm then
						pcall(migrate_monster, kill, comm)
					end
				end
			end
		end
	end
end

function mutants_task_select()
	monster_migration()
end

function dogs_task_select()
	mutants_task_select()
end

function zombies_task_select()
	if not db.actor then return end
	if sleep_manager and sleep_manager.is_sleep_active and sleep_manager.is_sleep_active() then return end
	if not olr_smart_index.ensure() then return end
	rebuild_cache()
	if not zombie_ids_cache or #zombie_ids_cache == 0 then return end
	local sim = g_sim
	if not sim then return end
	for _, id in ipairs(zombie_ids_cache) do
		local kill = sim:object(id)
		if kill and kill:alive() and not kill.online then
			local strn_id = kill:smart_terrain_id()
			if strn_id ~= BAD_OBJ_ID then
				if math.random(1, 3) ~= 1 then
					pcall(migrate_monster, kill, "zombied")
				end
			end
		end
	end
end
