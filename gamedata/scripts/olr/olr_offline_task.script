local zombies_smarts = {
	"esc_zombie_1",
	"esc_zombie_2",
	"yantar_zombies",
	"generators_zombies",
}

local stalker_ids_cache = {}
local monster_ids_cache = {}
local zombie_ids_cache = {}
local cache_time = 0
local CACHE_TTL = 30000

local function rebuild_cache()
	if time_global() - cache_time < CACHE_TTL then return end
	cache_time = time_global()
	stalker_ids_cache = {}
	monster_ids_cache = {}
	zombie_ids_cache = {}
	local sim = g_sim
	if not sim then return end
	for id = 1, MAX_OBJ_ID do
		local obj = sim:object(id)
		if obj and not obj.online and obj.health and obj:alive() then
			local cls = obj:clsid()
			if cls == clsid.script_stalker then
				if not olr_protected.is_no_offline_alife_obj(obj:name()) then
					local comm = obj:community()
					if not stalker_ids_cache[comm] then stalker_ids_cache[comm] = {} end
					table.insert(stalker_ids_cache[comm], id)
				end
			elseif mutant_clsids[cls] then
				table.insert(monster_ids_cache, id)
			elseif cls == clsid.zombie_s or cls == clsid.zombie then
				table.insert(zombie_ids_cache, id)
			end
		end
	end
end

local function migrate_stalker(kill, smarts_table)
	local params = xrs_utils.read_stalker_params(kill)
	params.custom = ""
	xrs_utils.write_stalker_params(params, kill)
	smart_terrain.unregister_npc(kill)
	kill:brain():can_choose_alife_tasks(true)
	kill:brain():update()

	params = xrs_utils.read_stalker_params(kill)
	local rand_smart = smarts_table[math.random(#smarts_table)]
	local b = "\n[smart_terrains]\n" .. rand_smart .. " = true\n"
	params.custom = b
	xrs_utils.write_stalker_params(params, kill)
end

local function migrate_monster(kill, smarts_table)
	smart_terrain.unregister_npc(kill)
	kill:brain():can_choose_alife_tasks(true)

	local params = xrs_utils.read_monster_params(kill)
	local rand_smart = smarts_table[math.random(#smarts_table)]
	local b = "\n[smart_terrains]\n" .. rand_smart .. " = true\n"
	params.custom = b
	xrs_utils.write_monster_params(params, kill)
end

local function faction_migration(community_name, smarts_table, label)
	if not db.actor then return end
	rebuild_cache()
	local id_list = stalker_ids_cache[community_name]
	if not id_list then return end
	local sim = g_sim
	if not sim then return end

	for _, id in ipairs(id_list) do
		local kill = sim:object(id)
		if kill and kill:alive() and not kill.online then
			local strn_id = kill:smart_terrain_id()
			if strn_id ~= BAD_OBJ_ID then
				if math.random(1, 2) == 1 then
					pcall(migrate_stalker, kill, smarts_table)
				end
			end
		end
	end
end

function ecologs_neutral_task_select()
	faction_migration("ecolog", ecologs_smarts, "ECOLOG")
end

function bandits_neutral_task_select()
	faction_migration("bandit", bandits_smarts, "BANDIT")
end

function stalkers_neutral_task_select()
	faction_migration("stalker", neutral_smarts, "STALKER")
end

function dolgs_task_select()
	if sleep_manager and sleep_manager.is_sleep_active and sleep_manager.is_sleep_active() then return end
	faction_migration("dolg", dolgs_smarts, "DOLG")
end

function freedom_task_select()
	if sleep_manager and sleep_manager.is_sleep_active and sleep_manager.is_sleep_active() then return end
	faction_migration("freedom", freedom_smarts, "FREEDOM")
end

function killers_task_select()
	if sleep_manager and sleep_manager.is_sleep_active and sleep_manager.is_sleep_active() then return end
	faction_migration("killer", killers_smarts, "KILLER")
end

function military_task_select()
	if sleep_manager and sleep_manager.is_sleep_active and sleep_manager.is_sleep_active() then return end
	faction_migration("military", military_smarts, "MILITARY")
end

local function monster_migration(label, clsids_table, smarts_table)
	if not db.actor then return end
	if sleep_manager and sleep_manager.is_sleep_active and sleep_manager.is_sleep_active() then return end
	rebuild_cache()

	local id_list
	if clsids_table[clsid.zombie_s] then
		id_list = zombie_ids_cache
	else
		id_list = monster_ids_cache
	end
	if not id_list or #id_list == 0 then return end
	local sim = g_sim
	if not sim then return end

	for _, id in ipairs(id_list) do
		local kill = sim:object(id)
		if kill and kill:alive() and not kill.online then
			local strn_id = kill:smart_terrain_id()
			if strn_id ~= BAD_OBJ_ID then
				if math.random(1, 2) == 1 then
					pcall(migrate_monster, kill, smarts_table)
				end
			end
		end
	end
end

function mutants_task_select()
	monster_migration("MUTANT", mutant_clsids, mutants_smarts)
end

function dogs_task_select()
	mutants_task_select()
end

function zombies_task_select()
	local zombie_clsids = {
		[clsid.zombie_s] = true,
		[clsid.zombie]   = true
	}
	monster_migration("ZOMBIE", zombie_clsids, zombies_smarts)
end
