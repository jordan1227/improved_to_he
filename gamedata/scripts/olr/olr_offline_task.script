-- [HE-PORT] the id caches are up to two minutes old, and AMK pickups recycle ids fast: an id may be an item by now
local function live(o)
	return o ~= nil and ( IsStalker(o) or IsMonster(o) ) and o:alive()
end

-- [HE-PORT]
local mutant_clsids = {
	[clsid.dog_s]          = true,
	[clsid.dog_red]        = true,
	[clsid.dog_black]      = true,
	[clsid.boar_s]         = true,
	[clsid.boar]           = true,
	[clsid.flesh_s]        = true,
	[clsid.flesh]          = true,
	[clsid.pseudodog_s]    = true,
	[clsid.bloodsucker_s]  = true,
	[clsid.bloodsucker]    = true,
	[clsid.snork_s]        = true,
	[clsid.tushkano_s]     = true,
	[clsid.tushkano]       = true,
	[clsid.gigant_s]       = true,
	[clsid.pseudo_gigant]  = true,
	[clsid.burer_s]        = true,
	[clsid.burer]          = true,
	[clsid.controller_s]   = true,
	[clsid.controller]     = true,
	[clsid.poltergeist_s]  = true,
	[clsid.poltergeist]    = true,
}

local monster_comm_by_clsid = {
	[clsid.dog_s] = "dog",
	[clsid.dog_red] = "dog",
	[clsid.dog_black] = "dog",
	[clsid.boar_s] = "boar",
	[clsid.boar] = "boar",
	[clsid.flesh_s] = "flesh",
	[clsid.flesh] = "flesh",
	[clsid.pseudodog_s] = "pseudodog",
	[clsid.bloodsucker_s] = "bloodsucker",
	[clsid.bloodsucker] = "bloodsucker",
	[clsid.snork_s] = "snork",
	[clsid.tushkano_s] = "tushkano",
	[clsid.tushkano] = "tushkano",
	[clsid.gigant_s] = "giant",
	[clsid.pseudo_gigant] = "giant",
	[clsid.burer_s] = "burer",
	[clsid.burer] = "burer",
	[clsid.controller_s] = "controller",
	[clsid.controller] = "controller",
	[clsid.poltergeist_s] = "poltergeist",
	[clsid.poltergeist] = "poltergeist",
}

local stalker_ids_cache = {}
local monster_ids_cache = {}
local zombie_ids_cache = {}
local cache_time = 0
local CACHE_TTL = 120000 -- [HE-PORT]
local cache_scan_pos = 1
local CACHE_SCAN_BATCH = 1024 -- [HE-PORT]
local cache_building = false
local cache_stalker_tmp = {}
local cache_monster_tmp = {}
local cache_zombie_tmp = {}

local function rebuild_cache(full) -- [HE-PORT]
	if not full and not cache_building and time_global() - cache_time < CACHE_TTL then return end
	local sim = g_sim
	if not sim then return end

	if not cache_building then
		cache_building = true
		cache_scan_pos = 1
		cache_stalker_tmp = {}
		cache_monster_tmp = {}
		cache_zombie_tmp = {}
	end

	local scan_end = full and MAX_OBJ_ID or (cache_scan_pos + CACHE_SCAN_BATCH - 1) -- [HE-PORT]
	if scan_end > MAX_OBJ_ID then scan_end = MAX_OBJ_ID end
	for id = cache_scan_pos, scan_end do
		local obj = sim:object(id)
		if obj and not obj.online and obj.health and obj:alive() then
			local cls = obj:clsid()
			if cls == clsid.script_stalker then
				if not olr_protected.is_no_offline_alife_obj(obj:name()) then
					local comm = obj:community()
					if not cache_stalker_tmp[comm] then cache_stalker_tmp[comm] = {} end
					table.insert(cache_stalker_tmp[comm], id)
				end
			elseif mutant_clsids[cls] then
				if not olr_protected.is_protected_monster(obj) then
					table.insert(cache_monster_tmp, id)
				end
			elseif cls == clsid.zombie_s or cls == clsid.zombie then
				table.insert(cache_zombie_tmp, id)
			end
		end
	end

	if scan_end >= MAX_OBJ_ID then
		stalker_ids_cache = cache_stalker_tmp
		monster_ids_cache = cache_monster_tmp
		zombie_ids_cache = cache_zombie_tmp
		cache_building = false
		cache_time = time_global()
		cache_scan_pos = 1
	else
		cache_scan_pos = scan_end + 1
	end
end

-- [HE-PORT]
function cached_stalkers( comm )
	rebuild_cache()
	if not comm then return {} end
	return stalker_ids_cache[ comm ] or {}
end

-- [HE-PORT]
function cached_monsters()
	rebuild_cache()
	return monster_ids_cache
end

-- [HE-PORT]
function prime_cache()
	cache_building = false
	rebuild_cache(true)
end

-- [HE-PORT]
function cache_tick()
	rebuild_cache()
end

local function current_smart_name(kill)
	local strn_id = kill:smart_terrain_id()
	if not strn_id or strn_id == BAD_OBJ_ID then return nil end
	local sim = g_sim or alife()
	if not sim then return nil end
	local smart = sim:object(strn_id)
	if smart then return smart:name() end
	return nil
end

-- [HE-PORT]
local WANDER_MIN_H  = 12
local WANDER_MAX_H  = 24
local WANDER_SHARE  = 0.5
local WANDER_ROLL   = 2
local MIGRATE_ROLL  = 4

-- [HE-PORT]
function has_wander_record( name )
	if not name then return false end
	return ( get_value( "nlc.olr_wanderers" ) or {} )[ name ] ~= nil
end

-- [HE-PORT]
function is_wandering( name )
	if not name then return false end
	local due = ( get_value( "nlc.olr_wanderers" ) or {} )[ name ]
	if not due then return false end
	return timers.Get_Game_Seconds() < due
end

-- [HE-PORT]
function set_wandering( name )
	if not name then return end
	local t = get_value( "nlc.olr_wanderers" ) or {}
	t[ name ] = timers.Get_Game_Seconds() + math.random( WANDER_MIN_H, WANDER_MAX_H ) * 3600
	set_value( "nlc.olr_wanderers", t )
end

-- [HE-PORT]
function clear_wandering( name )
	if not name then return end
	local t = get_value( "nlc.olr_wanderers" ) or {}
	if t[ name ] then
		t[ name ] = nil
		set_value( "nlc.olr_wanderers", t )
	end
end

-- [HE-PORT]
local function send_wandering( kill )
	local from = current_smart_name( kill )
	if olr_smart_index.is_locked( from ) then return false end
	if not olr_smart_index.can_release( from ) then return false end
	xrs_utils.clear_smart_terrain( kill )
	smart_terrain.unregister_npc( kill )
	if kill.brain then
		kill:brain():can_choose_alife_tasks( true )
	end
	if not xrs_utils.set_smart_terrain( kill, "none" ) then return false end
	set_wandering( kill:name() )
	return true
end

-- [HE-PORT]
local function wandering_count( id_list, sim )
	local n = 0
	local records = get_value( "nlc.olr_wanderers" ) or {}
	for _, id in ipairs( id_list ) do
		local o = sim:object( id )
		if live(o) and o:smart_terrain_id() == BAD_OBJ_ID and records[ o:name() ] ~= nil then
			n = n + 1
		end
	end
	return n
end

-- [HE-PORT]
local function pick_target(kill, community_name, exclude)
	if olr_cfg.on("migrate_neighbours") then
		return olr_smart_index.pick_migration(kill, community_name, exclude)
	end
	return olr_smart_index.pick_name(community_name, exclude)
end

local function migrate_stalker(kill, community_name)
	local exclude = current_smart_name(kill)
	if olr_smart_index.is_locked(exclude) then return false end
	-- [HE-PORT]
	if exclude and not olr_smart_index.can_release(exclude) then return false end
	local target = pick_target(kill, community_name, exclude)
	if not target then return false end
	local from_lvl = olr_smart_index.object_level(kill) -- [HE-PORT]

	xrs_utils.clear_smart_terrain(kill)
	smart_terrain.unregister_npc(kill)
	if kill.brain then
		kill:brain():can_choose_alife_tasks(true)
	end

	if not xrs_utils.set_smart_terrain(kill, target) then return false end
	if kill.brain then
		kill:brain():can_choose_alife_tasks(true)
		kill:brain():update(true)
	end
	olr_population.on_migrated_human(from_lvl, target) -- [HE-PORT]
	if olr_cfg.log_census() then log2("[olr_migrate] %s %s (%s): %s -> %s", olr_cfg.stamp(), kill:name(), kill:community(), tostring(exclude), tostring(target)) end
	return true
end

local function migrate_monster(kill, community_name)
	local exclude = current_smart_name(kill)
	if olr_smart_index.is_locked(exclude) then return false end
	-- [HE-PORT]
	if exclude and not olr_smart_index.can_release(exclude) then return false end
	local target = pick_target(kill, community_name, exclude)
	if not target then return false end
	local from_lvl = olr_smart_index.object_level(kill) -- [HE-PORT]

	smart_terrain.unregister_npc(kill)
	if kill.brain then
		kill:brain():can_choose_alife_tasks(true)
	end

	if not xrs_utils.set_smart_terrain(kill, target) then return false end
	if kill.brain then
		kill:brain():can_choose_alife_tasks(true)
		kill:brain():update(true)
	end
	if not olr_monster_squads.is_spawned(kill.id) then olr_population.on_migrated(kill, from_lvl, target) end -- [HE-PORT]
	return true
end

local function faction_migration(community_name)
	if not db.actor then return end
	if community_name == "military" and not olr_cfg.on("military_olr") then return end -- [HE-PORT]
	if not olr_smart_index.ensure() then return end
	if olr_smart_index.count(community_name) <= 0 then return end
	rebuild_cache()
	local id_list = stalker_ids_cache[community_name]
	if community_name == "stalker" then
		local extra = stalker_ids_cache["green"]
		if extra then
			local merged = {}
			if id_list then
				for _, id in ipairs(id_list) do table.insert(merged, id) end
			end
			for _, id in ipairs(extra) do table.insert(merged, id) end
			id_list = merged
		end
	end
	if not id_list then return end
	local sim = g_sim
	if not sim then return end

	-- [HE-PORT]
	local wanderers = wandering_count( id_list, sim )
	local wander_cap = math.floor( #id_list * WANDER_SHARE )
	local records = get_value( "nlc.olr_wanderers" ) or {} -- [HE-PORT] one read, not one per NPC

	for _, id in ipairs(id_list) do
		local kill = sim:object(id)
		if live(kill) and not kill.online and not olr_protected.is_no_offline_alife_obj(kill:name()) then -- [HE-PORT]
			local strn_id = kill:smart_terrain_id()
			local nm = kill:name()
			if strn_id == BAD_OBJ_ID then
				if records[ nm ] ~= nil and not is_wandering( nm ) then
					local ok, res = pcall( migrate_stalker, kill, community_name )
					if ok and res then
						clear_wandering( nm )
						wanderers = wanderers - 1
					end
				end
			elseif math.random(1, MIGRATE_ROLL) == 1 and olr_faction_policy.may_migrate(kill, kill:community()) then -- [HE-PORT]
				if wanderers < wander_cap and math.random( 1, WANDER_ROLL ) == 1 and not olr_faction_policy.no_wander( olr_smart_index.object_level( kill ) ) then -- [HE-PORT]
					local ok, res = pcall( send_wandering, kill )
					if ok and res then wanderers = wanderers + 1 end
				else
					pcall(migrate_stalker, kill, community_name)
				end
			end
		end
	end
end

function ecologs_neutral_task_select()
	faction_migration("ecolog")
end

function bandits_neutral_task_select()
	faction_migration("bandit")
end

function stalkers_neutral_task_select()
	faction_migration("stalker")
end

function dolgs_task_select()
	if olr_cfg.sleep_paused() then return end
	faction_migration("dolg")
end

function freedom_task_select()
	if olr_cfg.sleep_paused() then return end
	faction_migration("freedom")
end

function killers_task_select()
	if olr_cfg.sleep_paused() then return end
	faction_migration("killer")
end

function military_task_select()
	if olr_cfg.sleep_paused() then return end
	faction_migration("military")
end

-- [HE-PORT]
local function obj_level_name(obj)
	local sim = g_sim or alife()
	if not sim then return nil end
	local ok, lname = pcall(function()
		return sim:level_name(game_graph():vertex(obj.m_game_vertex_id):level_id())
	end)
	if ok then return lname end
	return nil
end

-- [HE-PORT]
function bar_sweep()
	if not db.actor then return end
	if not olr_smart_index.ensure() then return end
	local sim = g_sim
	if not sim then return end
	rebuild_cache()

	for comm, ids in pairs(stalker_ids_cache) do
		if olr_faction_policy.level_denied(comm, "l05_bar") then
			for _, id in ipairs(ids) do
				local kill = sim:object(id)
				if live(kill) and not kill.online and has_wander_record(kill:name()) and not olr_protected.is_no_offline_alife_obj(kill:name()) then -- [HE-PORT]
					if obj_level_name(kill) == "l05_bar" then
						local target = olr_smart_index.pick_name(comm, nil, "l05_bar")
						local smart = target and olr_smart_index.get_obj(target)
						if smart then
							pcall(function()
								sim:teleport_object(id, smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id)
								olr_smart_index.attach_to(kill, target)
							end)
						end
					end
				end
			end
		end
	end
end

-- [HE-PORT]
function guest_sweep()
	if not db.actor then return end
	if not olr_smart_index.ensure() then return end
	local sim = g_sim
	if not sim then return end
	rebuild_cache()

	for comm, ids in pairs(stalker_ids_cache) do
		for _, id in ipairs(ids) do
			local kill = sim:object(id)
			if live(kill) and not kill.online and not olr_protected.is_no_offline_alife_obj(kill:name())
				and not ( olr_cfg.on("quest_bound") and olr_protected.is_quest_bound(kill) ) -- [HE-PORT]
			then
				local lname = obj_level_name(kill)
				local okd, denied = pcall(olr_faction_policy.is_guest_denied, comm, lname)
				if okd and denied then
					local sname = current_smart_name(kill)
					local smart = sname and olr_smart_index.get_obj(sname)
					local guest = false
					if smart then
						local okg, res = pcall(olr_faction_policy.is_guest_smart, smart, comm)
						guest = okg and res == true
					end
					if guest and not olr_smart_index.is_locked(sname) then
						local target = olr_smart_index.pick_name(comm, nil, lname)
						local dst = target and olr_smart_index.get_obj(target)
						if dst then
							pcall(function()
								sim:teleport_object(id, dst.position, dst.m_level_vertex_id, dst.m_game_vertex_id)
								olr_smart_index.attach_to(kill, target)
							end)
						end
					end
				end
			end
		end
	end
end

-- [HE-PORT]
local function sweep_one( sim, kill, comm, lname )
	local sid = kill:smart_terrain_id()
	if sid ~= BAD_OBJ_ID then
		local smart = sim:object( sid )
		if not smart or smart.level_name == lname or olr_smart_index.near_actor( smart:name() ) then return end
		local task = smart.gulag and smart.gulag:get_obj_job_task( kill.id )
		if task then
			sim:teleport_object( kill.id, task:position(), task:level_vertex_id(), task:game_vertex_id() )
		else
			sim:teleport_object( kill.id, smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id )
		end
		return
	end
	if not has_wander_record( kill:name() ) and string.sub( kill:section_name(), 1, 4 ) ~= "olr_" then return end
	local target = olr_smart_index.pick_name( comm, nil, lname )
	local dst = target and olr_smart_index.get_obj( target )
	if not dst then return end
	sim:teleport_object( kill.id, dst.position, dst.m_level_vertex_id, dst.m_game_vertex_id )
	olr_smart_index.attach_to( kill, target )
	clear_wandering( kill:name() )
end

-- [HE-PORT]
function monster_level_sweep()
	if not db.actor then return end
	if not olr_smart_index.ensure() then return end
	local sim = g_sim
	if not sim then return end
	local levels = olr_faction_policy.monster_levels
	for comm, ids in pairs( stalker_ids_cache ) do
		for _, id in ipairs( ids ) do
			local kill = sim:object( id )
			if live(kill) and not kill.online and levels[ kill.level_name ]
				and not olr_protected.is_no_offline_alife_obj( kill:name() )
			then
				pcall( sweep_one, sim, kill, comm, kill.level_name )
			end
		end
	end
end

-- [HE-PORT]
local function zone_comm( comm )
	if comm == "green" or comm == "nebo" then return "stalker" end
	return comm
end

-- [HE-PORT]
local function zone_target( comm, lname )
	local target = olr_smart_index.pick_name( comm, nil, nil, { [ lname ] = true } ) or olr_smart_index.pick_name( comm )
	local dst = target and olr_smart_index.get_obj( target )
	if not dst then return nil end
	if olr_faction_policy.danger_zone( comm, olr_smart_index.get_level( target ), dst.position ) then return nil end
	return target, dst
end

-- [HE-PORT]
local function danger_one( sim, kill, comm, lname, pos, online )
	local zone = olr_faction_policy.danger_zone( comm, lname, pos )
	if not zone then return end
	local sid = kill:smart_terrain_id()
	if sid ~= BAD_OBJ_ID then
		if online then return end
		local smart = sim:object( sid )
		if not smart or olr_smart_index.near_actor( smart:name() ) then return end
		if olr_smart_index.get_level( smart:name() ) == lname and olr_faction_policy.in_zone( zone, smart.position ) then return end
		local task = smart.gulag and smart.gulag:get_obj_job_task( kill.id )
		if task then
			sim:teleport_object( kill.id, task:position(), task:level_vertex_id(), task:game_vertex_id() )
		else
			sim:teleport_object( kill.id, smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id )
		end
		return
	end
	if not has_wander_record( kill:name() ) and string.sub( kill:section_name(), 1, 4 ) ~= "olr_" then return end
	local target, dst = zone_target( zone_comm( comm ), lname )
	if not target then return end
	if not online and not olr_smart_index.near_actor( target ) then
		sim:teleport_object( kill.id, dst.position, dst.m_level_vertex_id, dst.m_game_vertex_id )
	end
	olr_smart_index.attach_to( kill, target )
	clear_wandering( kill:name() )
end

-- [HE-PORT]
function danger_sweep()
	if not db.actor then return end
	if not olr_smart_index.ensure() then return end
	local sim = g_sim
	if not sim then return end
	for comm, ids in pairs( stalker_ids_cache ) do
		for _, id in ipairs( ids ) do
			local kill = sim:object( id )
			if live(kill) and not kill.online and not olr_protected.is_no_offline_alife_obj( kill:name() ) then
				pcall( danger_one, sim, kill, comm, olr_smart_index.object_level( kill ), kill.position, false )
			end
		end
	end
	local lname = level.name()
	local actor_id = db.actor:id()
	for id, _ in pairs( db.storage ) do
		local npc = id ~= actor_id and level.object_by_id( id )
		if npc and IsStalker( npc ) and npc:alive() then
			local kill = sim:object( id )
			if kill and kill.online and not olr_protected.is_no_offline_alife_obj( kill:name() ) then
				pcall( danger_one, sim, kill, npc:character_community(), lname, npc:position(), true )
			end
		end
	end
end

-- [HE-PORT]
-- [HE-PORT] the spot olr_offline_walk used to clear: offline people stuck there go to their smart
local function cordon_unstick()
	if level.name() ~= "l01_escape" then return end
	local sim = g_sim
	if not sim then return end
	local spot = vector():set(-133, 1, 238)
	local function clear(ids)
		for _, id in ipairs(ids) do
			local o = sim:object(id)
			if live(o) and not o.online and olr_smart_index.object_level(o) == "l01_escape"
				and o.position:distance_to_xz(spot) < 30
			then
				local sid = o:smart_terrain_id()
				local smart = sid ~= BAD_OBJ_ID and sim:object(sid)
				if smart then
					sim:teleport_object(id, smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id)
				end
			end
		end
	end
	for _, ids in pairs(stalker_ids_cache) do clear(ids) end
	clear(monster_ids_cache)
end

local roam_next = 0
local roam_idx = 0
local roam_plan = {
	"stalker",
	"bandit",
	"dolg",
	"killer",
	"freedom",
	"military",
	"ecolog",
}

-- [HE-PORT]
function roam_update()
	if not db.actor then return end
	if device().precache_frame > 1 then return end
	if olr_cfg.sleep_paused() then return end
	if time_global() < roam_next then return end
	roam_next = time_global() + olr_cfg.get("migration_tick") * 1000
	roam_idx = roam_idx + 1
	if roam_idx > #roam_plan then roam_idx = 1 end
	pcall(faction_migration, roam_plan[roam_idx])
	pcall(bar_sweep)
	if olr_cfg.on("military_guests") then -- [HE-PORT]
		pcall(guest_sweep)
	end
	if olr_cfg.on("cordon_unstick") then
		cordon_unstick()
	end
end

-- [HE-PORT] olr_population.update, every half game hour or so: native monsters in free smarts, dt_h game hours since
-- the last pass, at most native_max_per_pass of them; the start is random so no part of the list is favoured
function native_pass(dt_h)
	if not db.actor then return 0 end
	if not olr_smart_index.ensure() then return 0 end
	rebuild_cache()
	local list = monster_ids_cache
	if not list or #list == 0 then return 0 end
	local sim = g_sim or alife()
	local left = olr_population.native_max_per_pass()
	local moved = 0
	local start = math.random(#list)
	for k = 0, #list - 1 do
		if left <= 0 then break end
		local id = list[ ( start + k - 1 ) % #list + 1 ]
		local kill = sim:object(id)
		if live(kill) and not kill.online and kill:smart_terrain_id() ~= BAD_OBJ_ID
			and not olr_monster_squads.is_spawned(id)
		then
			local p = olr_population.native_chance(kill, dt_h)
			if p and math.random() < p then
				left = left - 1
				local comm = monster_comm_by_clsid[kill:clsid()]
				if not comm then
					local okc, c = pcall(function() return kill:community() end)
					if okc then comm = c end
				end
				if comm then
					local ok, res = pcall(migrate_monster, kill, comm)
					if ok and res then moved = moved + 1 end
				end
			end
		end
	end
	return moved
end

local function monster_migration()
	if not db.actor then return end
	if olr_cfg.sleep_paused() then return end
	if not olr_smart_index.ensure() then return end
	rebuild_cache()
	if not monster_ids_cache or #monster_ids_cache == 0 then return end
	local sim = g_sim
	if not sim then return end

	for _, id in ipairs(monster_ids_cache) do
		local kill = sim:object(id)
		if live(kill) and not kill.online then
			local strn_id = kill:smart_terrain_id()
			-- [HE-PORT] OLR's own move here; natives move in native_pass, on game time
			if strn_id ~= BAD_OBJ_ID and ( olr_monster_squads.is_spawned(id) or not olr_cfg.on("garrisons_stay") ) then
				if math.random(1, MIGRATE_ROLL) == 1 then -- [HE-PORT]
					local cls = kill:clsid()
					local comm = monster_comm_by_clsid[cls]
					if not comm then
						local okc, c = pcall(function() return kill:community() end)
						if okc then comm = c end
					end
					if comm then
						pcall(migrate_monster, kill, comm)
					end
				end
			end
		end
	end
end

-- [HE-PORT] once per save: OLR people an earlier version left where they no longer belong
function old_save_sweep()
	if not ( olr_cfg.on("sweep_old_saves") and db.actor ) then return end
	if get_value( "nlc.olr_sweep_1" ) then return end
	set_value( "nlc.olr_sweep_1", 1 )
	local sim = g_sim
	if not sim then return end
	local here = level.name()
	local victims = {}
	for _, se in sim:objects() do
		if se.id ~= 0 and not se.online and IsStalker( se ) and se:alive()
			and string.sub( se:section_name(), 1, 4 ) == "olr_"
			and not olr_protected.is_no_offline_alife_obj( se:name() )
		then
			local lname = olr_smart_index.object_level( se )
			local comm = se:community()
			if lname and lname ~= here and (
				olr_faction_policy.level_denied( comm, lname )
				or ( comm == "military" and not olr_cfg.on( "military_olr" ) )
				or ( comm == "monolith" and not olr_cfg.mono_open() )
				or not olr_smart_index.level_rank_fits( lname, comm, se:rank() )
			) then
				table.insert( victims, se )
			end
		end
	end
	for i = 1, #victims do
		olr_squads.forget( victims[ i ].id )
		sim:release( victims[ i ], true )
	end
	-- the cache primed a moment ago still holds those ids, which can be reused by anything
	if #victims > 0 then prime_cache() end
	log2( "[olr_sweep] released %d OLR NPCs left over from before the rules", #victims )
end

function mutants_task_select()
	monster_migration()
end

function dogs_task_select()
	mutants_task_select()
end

function zombies_task_select()
	if not db.actor then return end
	if olr_cfg.on("garrisons_stay") then return end -- [HE-PORT]
	if olr_cfg.sleep_paused() then return end
	if not olr_smart_index.ensure() then return end
	rebuild_cache()
	if not zombie_ids_cache or #zombie_ids_cache == 0 then return end
	local sim = g_sim
	if not sim then return end
	for _, id in ipairs(zombie_ids_cache) do
		local kill = sim:object(id)
		if live(kill) and not kill.online then
			local strn_id = kill:smart_terrain_id()
			if strn_id ~= BAD_OBJ_ID then
				if math.random(1, MIGRATE_ROLL) == 1 then -- [HE-PORT]
					pcall(migrate_monster, kill, "zombied")
				end
			end
		end
	end
end
