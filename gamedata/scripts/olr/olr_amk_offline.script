-- [HE-PORT] AMK offline life, docs/ALIFE_DESIGN.md section 10 batch 12 (preset key amk_sight). amk_offline_alife asks
-- here what an offline stalker sees (its look_radius had been 0 since the August rewrite, so nobody saw mutants,
-- enemies, loose weapons or artefacts), who may take part, which level the next call goes to (overfull ones first),
-- and what the stalker does: one action rolled by weight from what he found, trade only when he found nothing.
-- Artefacts are earned: mutants near one are fought first. Config [amk_offline] in olr_alife.ltx. Log: [olr_amk].
-- fl olr_amk_offline.report()      sight radii, weights and what the calls did this session
-- fl olr_amk_offline.force(n)      n calls now (amk_offline_alife.offline_alife), for a test save
-- fl olr_amk_offline.fight_test("gar_bandit_blokpost05")  AMK's checks on one stalker, step by step, then his action
-- fl olr_amk_offline.watch_next()  hold the next road meeting instead of settling it; then fl olr_amk_offline.go()
-- fl olr_amk_offline.go_to("val_lager_bandit06")  teleport next to anyone, by name or id
-- fl olr_amk_offline.roads()        one road-encounter pass now (stalkers on the move meeting enemies)
-- fl olr_amk_offline.enemies("l02_garbage")  the nearest enemy of each offline stalker there, and how far
-- fl olr_amk_offline.arts("l02_garbage")  the loose artefacts AMK knows on a level, nearest offline stalker, guards
-- fl olr_amk_offline.odds_test(4306)  the odds he would see against the mutants in his sight now (id or object name)
-- fl olr_amk_offline.odds_table()   a lone stalker of each tier with a PM, a shotgun and an AK against 1-15 mutants;
--                                    odds_table(nil, nil, 0.8, 0.5) with other stalker and mutant damage factors
-- fl olr_amk_offline.trade_test(4306)  his weighted trade chance, term by term (id or object name)

local INI_PATH = "misc\\olr_alife.ltx"

local cfg = nil
local done = {}
local art_scan = {}   -- level -> game seconds of its last artefact scan
local art_scan_real = 0

local function config()
	if cfg then return cfg end
	cfg = {}
	local ini = ini_file(INI_PATH)
	for i = 0, ini:line_count("amk_offline") - 1 do
		local _, k, v = ini:r_line("amk_offline", i, "", "")
		cfg[k] = tonumber(v) or v
	end
	return cfg
end

-- [HE-PORT] how many of a kind a stalker keeps when he trades offline: trade_keep_<kind> with weighted trade on, else
-- AMK's own number. Artefacts are what loners live on, so with the default 0 they all go: sold on the spot, or carried
-- to a trader when a run is possible (olr_trader_runs.take_haul).
function keep_of(kind, default)
	local v = olr_cfg.on("amk_trade_weighted") and tonumber(config()["trade_keep_" .. kind]) or nil
	return v or default
end

local function alog(fmt, ...)
	if olr_cfg.log_census() then log2("[olr_amk] %s " .. fmt, olr_cfg.stamp(), ...) end
end

local function note(kind)
	done[kind] = ( done[kind] or 0 ) + 1
end

function active()
	return olr_cfg.on("amk_sight")
end

-- on the player's level nothing offline happens within this many metres of him
function player_clear()
	return config().player_clear
end

-- collect_info: weapon, friend, enemy, corpse, monster, artefact sight in metres (all 0 with amk_sight off, as before)
function radii()
	if not active() then return 0, 0, 0, 0, 0, 0 end
	local c = config()
	return c.sight_weapon, c.sight_friend, c.sight_enemy, c.sight_corpse, c.sight_monster, c.sight_art
end

-- collect_info: game_relations.ltx goodwill_enemy is -5000 while the matrix goes down to -2000 only, so no two stalkers
-- were ever enemies offline; enemy_goodwill (AMK's own default, -1000) takes its place
function enemy_goodwill(native)
	if not active() then return native end
	return config().enemy_goodwill
end

-- the stalker who acts, his friends and his enemies: never a quest NPC, a trader on a run, a party member, or someone
-- AMK has no item list for yet (its fight reads the weapons from that list)
function usable(se)
	if not active() then return true end
	if not ( se and se.id ) then return false end
	if olr_protected.is_no_offline_alife_obj(se:name()) then return false end
	-- quest-staged people (own logic, a written name, a quest scene) stay out of fights; story NPCs join as allies only
	if olr_protected.is_quest_bound(se) then return false end
	-- dormant: kept out of the world by a scene or a job (e.g. the Garbage bandit post once Duty holds it)
	if olr_census.is_dormant_creature(se, IsStalker(se)) then return false end
	for prefix in string.gmatch(config().skip_prefix, "[%w_]+") do -- scripted scenes, e.g. the Dark Valley raid
		if string.sub(se:name(), 1, string.len(prefix)) == prefix then return false end
	end
	if olr_trader_runs.on_run(se.id) or olr_patrols.is_member(se.id) then return false end
	return amk_offline_alife.items[se.id] ~= nil
end

-- collect_info, last: what he saw, trimmed. AMK's lists are rebuilt only on a level load, so a migrant may sit in his old
-- level's list (fights across levels); online people and mutants would drop dead in front of the player; a camp's own
-- guards (bound to a smart and within road_far of it, or at a quest-scene smart) are never anyone's enemy target, so
-- hostile camps do not wear each other down; and on the player's level nothing happens within player_clear m of him
local function at_post(se, sim)
	local sid = se:smart_terrain_id()
	if not sid or sid == BAD_OBJ_ID then return false end
	local smart = sim:object(sid)
	if not smart then return false end
	if olr_population.is_scene_smart(smart:name()) then return true end
	return smart.position:distance_to(se.position) < config().road_far
end

function trim_seen(victim, map, vdata)
	if not active() then return end
	local sim = alife()
	local lost = olr_smart_index.object_level(victim) ~= map
	local near = map == level.name() and db.actor ~= nil and victim.position:distance_to(db.actor:position()) < config().player_clear
	if lost then alog("%s is on AMK's list for %s but is on %s now: sees nothing", victim:name(), map, tostring(olr_smart_index.object_level(victim))) end
	local function keep(list, enemy)
		local out = {}
		if lost or near or not list then return out end
		for _, v in ipairs(list) do
			local o = sim:object(v.id)
			if o and o:name() == v.name and not o.online and olr_smart_index.object_level(o) == map
				and not ( enemy and at_post(o, sim) )
			then
				table.insert(out, v)
			end
		end
		return out
	end
	vdata.friends = keep(vdata.friends)
	vdata.enemies = keep(vdata.enemies, true)
	vdata.monsters = keep(vdata.monsters)
	if vdata.corpses then
		vdata.corpses.stalkers = keep(vdata.corpses.stalkers)
		vdata.corpses.monsters = keep(vdata.corpses.monsters)
	end
	if lost or near then
		vdata.artefacts, vdata.inv_boxes = {}, {}
		if vdata.weapons then vdata.weapons.seen = {} end
	end
end

-- after a fight: those hurt heal a little at each hunt tick (nothing else heals offline), and nobody's rank climbs past
-- the top of his level's band for his faction (AMK gives 25-100 a kill and 15 an artefact, with no ceiling)
local function fighters(victim, vdata)
	local list = { { id = victim.id } }
	for _, l in ipairs({ vdata.friends or {}, vdata.enemies or {} }) do
		for _, v in ipairs(l) do table.insert(list, v) end
	end
	return list
end

local function ranks_of(list)
	local t = {}
	for _, v in ipairs(list) do
		local o = alife():object(v.id)
		if o and IsStalker(o) then t[v.id] = o:rank() end
	end
	return t
end

local function after_fight(victim, list, before)
	olr_offline_hunts.note_wounded(victim, list)
	for id, old in pairs(before) do
		local o = alife():object(id)
		if o and IsStalker(o) and o:alive() and o:rank() > old then
			local cap = olr_smart_index.level_rank_cap(olr_smart_index.object_level(o), o:community())
			if cap then
				local new = math.max(old, math.min(o:rank(), cap))
				if new ~= o:rank() then
					alog("%s rank %d held at %d (top of the band on his level)", o:name(), o:rank(), new)
					o:set_rank(new)
				end
			end
		end
	end
end

-- AMK lists a level's artefacts only on a level load, so the ones born after (an emission, a visit) were unknown:
-- before a call goes to a level not scanned for art_refresh_h game hours, loose af_ objects there join its list
-- (at most one scan every 10 s of wall clock, the scan walks every object)
local function refresh_arts(lvl)
	local t = amk_offline_alife.off_npcs[lvl]
	if not t then return end
	local now = timers.Get_Game_Seconds()
	if art_scan[lvl] and now - art_scan[lvl] < config().art_refresh_h * 3600 then return end
	if os.time() - art_scan_real < 10 then return end
	art_scan[lvl], art_scan_real = now, os.time()
	local known = {}
	for _, a in ipairs(t.artefacts) do known[a.id] = true end
	local added = 0
	for _, se in alife():objects() do
		if not known[se.id] and string.sub(se:section_name(), 1, 3) == "af_" and art_ok(se)
			and ( se.parent_id == nil or se.parent_id == BAD_OBJ_ID )
			and olr_smart_index.object_level(se) == lvl
		then
			table.insert(t.artefacts, { id = se.id, name = se:name() })
			added = added + 1
		end
	end
	if added > 0 then alog("%s: %d loose artefacts joined the list (%d on it now)", lvl, added, #t.artefacts) end
end

-- story NPCs (AMK lists only nameless stalkers) join a fight as allies of the stalker who acts, never act or get
-- picked as a target themselves, and a fight wounds them instead of killing them
local function has_story_id(se)
	local sid = se.m_story_id
	return sid ~= nil and sid ~= NONE_SID and sid ~= NONE_CL_SID
end

function note_named(map, se)
	if not ( active() and se.id ~= 0 and has_story_id(se) and se:community() ~= "zombied" ) then return end
	local t = amk_offline_alife.off_npcs[map]
	t.named = t.named or {}
	table.insert(t.named, { id = se.id, name = se:name() })
end

function add_named_friends(victim, map, vdata, r, rel_friend)
	if not active() then return end
	local t = amk_offline_alife.off_npcs[map]
	if not ( t and t.named ) then return end
	for _, v in ipairs(t.named) do
		local se = alife():object(v.id)
		if se and IsStalker(se) and se:name() == v.name and se.id ~= victim.id and se:alive() and se:health() > 0.05
			and not se.online and not olr_protected.is_no_offline_alife_obj(se:name()) and not amk_offline_alife.IsTrader(se.id)
			and se.position:distance_to(victim.position) < r
			and not olr_census.is_dormant_creature(se, true) and not he_quest_target_lock.is_locked_id(se.id)
			and not ( olr_trader_runs.on_run(se.id) or olr_patrols.is_member(se.id) )
			and amk_offline_alife.items[se.id] ~= nil
			and ( amk_offline_alife.relation_check(victim, se) >= rel_friend or same_side(victim, se) )
		then
			table.insert(vdata.friends, { id = se.id, name = se:name() })
		end
	end
end

-- the fight rounds: a story NPC counts as one AMK may only wound (flags 2: no death, news, rank or loot for him)
function fight_flags(se, flags)
	if active() and has_story_id(se) then
		alog("%s (story NPC) fights; he can be wounded, not killed", se:name())
		return math.max(flags, 2)
	end
	return flags
end

-- a quest artefact copied by a pickup loses its story id, and the original is gone
function art_ok(se)
	return not ( active() and has_story_id(se) )
end

function spared(se)
	if active() and se and has_story_id(se) then
		alog("%s (story NPC) wounded, not killed", se:name())
		return true
	end
	return false
end

-- collect_info: the same faction stands together (the matrix gives bandits only 40 to each other), and in a fight
-- allies count as far as enemies do
function same_side(a, b)
	return active() and a:community() == b:community()
end

-- offline_alife: over_share % of the calls go to a level the shared count has well over its monster target (over_margin x)
local function pick_level_raw(maps)
	if active() and olr_population.active() and math.random(100) <= config().over_share then
		local over = {}
		for _, lvl in ipairs(maps) do
			local target = olr_population.target_of(lvl, "m")
			if target and target > 0 and olr_population.count_of(lvl, "m") >= target * config().over_margin then table.insert(over, lvl) end
		end
		if #over > 0 then return over[math.random(#over)] end
	end
	return maps[math.random(#maps)]
end

function pick_level(maps)
	local lvl = pick_level_raw(maps)
	if active() then refresh_arts(lvl) end
	return lvl
end

-- [HE-PORT] docs/ALIFE_NEXT_DESIGN.md 3.2: the odds before a mutant fight (preset key amk_odds). A dry run of
-- amk_offline_alife.on_monsters_found on plain tables, nothing touched. KEEP IN STEP with that function: max_rounds 10,
-- base_fp 1400, dist_coeff 8, health_wound 0.1, the hit chance and damage formulas below; odds_table() shows drift.
local ODDS_ROUNDS, ODDS_BASE_FP, ODDS_DIST, ODDS_WOUND = 10, 1400, 8, 0.1
local TIERS = { novice = true, experienced = true, veteran = true, master = true }
local warn_next = 0
local trade_rolls, trade_sum = 0, 0

-- the stalker and mutant damage factors of an offline fight: with amk_odds (Extended) odds_stalker_k and odds_monster_k,
-- tuned so a lone stalker beats one weak mutant and loses to a pack; otherwise the old factor and AMK's mutant damage
function fight_k(old_k)
	if olr_cfg.on("amk_odds") then return config().odds_stalker_k, config().odds_monster_k end
	return old_k, 1
end

-- [odds_monster_k]: the mutant damage factor by species (longest matching part of the section name), times the
-- preset-wide factor; 1 when the fight carries none (classic)
local species_k = nil

local function k_of_section(sec)
	if not species_k then
		species_k = {}
		local ini = ini_file(INI_PATH)
		for i = 0, ini:line_count("odds_monster_k") - 1 do
			local _, k, v = ini:r_line("odds_monster_k", i, "", "")
			table.insert(species_k, { key = k, k = tonumber(v) or 1 })
		end
		table.sort(species_k, function(a, b) return #a.key > #b.key end)
	end
	for _, rec in ipairs(species_k) do
		if string.find(sec, rec.key, 1, true) then return rec.k end
	end
	return 1
end

function monster_k(obj, vdata)
	if not ( vdata and vdata.monster_k and obj ) then return 1 end
	return vdata.monster_k * k_of_section(obj:section_name())
end

function tier_of(se)
	local t = se and ranks.get_obj_rank_name(se)
	return TIERS[t] and t or "novice"
end

local function money_of(se)
	local pk = get_netpk(se)
	local data = pk and pk:get()
	return data and data.money or 0
end

-- one fight on plain tables: true if the first of side A is still standing when side B is all down
local function sim_once(A0, B0, dist, k, kb)
	local A, B = {}, {}
	for _, a in ipairs(A0) do table.insert(A, { r = a, h = a.h }) end
	for _, b in ipairs(B0) do table.insert(B, { r = b, h = b.h }) end
	local dead_a, dead_b, lead = 0, 0, true
	for i = 1, ODDS_ROUNDS do
		if #A == 0 or #B == 0 then break end
		for j = 1, math.max(#A, #B) do
			local at, df = A[j], B[math.random(#B)]
			if at and df and at.h > 0 and df.h > 0 then
				local moved = dist[at.r.i][df.r.i] - df.r.speed * i * 5
				local dii = math.floor(moved)
				if dii <= 8 then dii = 45 end
				if math.random() * 100 < 100 - math.floor(dii / 1.5) + math.floor(( at.r.rank - df.r.rank ) / 50) then
					local hit = math.floor(k * at.r.fp / ( math.max(moved, ODDS_DIST) / ODDS_DIST ))
					if math.floor(hit * df.r.imm) >= ODDS_BASE_FP then df.h = 0
					else df.h = math.max(0, df.h - hit / ODDS_BASE_FP * df.r.imm) end
				end
			end
			local mb, da = B[j], A[math.random(#A)]
			if mb and da and mb.h > 0 and da.h > 0 and dist[da.r.i][mb.r.i] - mb.r.speed * i * 5 < mb.r.adist then
				if math.random() * 100 < 100 + math.floor(( mb.r.rank - da.r.rank ) / 50) then
					local fpb = math.floor(mb.r.fp * kb * ( mb.r.k or 1 ))
					if fpb >= ODDS_BASE_FP then da.h = 0 else da.h = math.max(0, da.h - fpb / ODDS_BASE_FP) end
				end
			end
		end
		local keep_a, keep_b = {}, {}
		for _, v in ipairs(A) do
			if v.h <= 0 then dead_a = dead_a + 1 end
			if v.h > ODDS_WOUND then table.insert(keep_a, v) elseif v.r.lead then lead = false end
		end
		for _, v in ipairs(B) do
			if v.h <= 0 then dead_b = dead_b + 1 end
			if v.h > ODDS_WOUND then table.insert(keep_b, v) end
		end
		A, B = keep_a, keep_b
	end
	return lead and #B == 0, dead_a, dead_b
end

-- side A and B as plain tables: { fp, rank, h, i } and { fp, speed, adist, imm, rank, h, i }; pos for the distances
function odds(A, B, k, trials, kb, engage_m)
	local dist = {}
	for _, a in ipairs(A) do
		dist[a.i] = {}
		for _, b in ipairs(B) do
			local d = math.floor(a.pos:distance_to(b.pos))
			if engage_m and d > engage_m then d = engage_m end
			dist[a.i][b.i] = d
		end
	end
	local wins, da, db = 0, 0, 0
	for _ = 1, trials do
		local won, x, y = sim_once(A, B, dist, k, kb or 1)
		if won then wins = wins + 1 end
		da, db = da + x, db + y
	end
	return wins / trials, da / trials, db / trials
end

local function stalker_side(victim, friends)
	local a = amk_offline_alife
	local out = {}
	local list = { { id = victim.id } }
	for _, f in ipairs(friends or {}) do table.insert(list, f) end
	for n, v in ipairs(list) do
		local o = alife():object(v.id)
		if o and IsStalker(o) and o:alive() and ( n == 1 or o:name() == v.name ) then
			table.insert(out, { i = n, lead = n == 1, fp = a.get_weapon_firepower(a.get_npc_weapon(o)), rank = o:rank(), h = o:health(), pos = o.position })
		end
	end
	return out
end

local function mutant_side(monsters)
	local out = {}
	for n, v in ipairs(monsters or {}) do
		local o = alife():object(v.id)
		local pr = o and o:name() == v.name and amk_offline_alife.get_monster_params(o)
		if pr then
			table.insert(out, { i = 100 + n, fp = math.floor(pr.attack * ODDS_BASE_FP), speed = pr.speed, adist = pr.dist, imm = pr.immunity, rank = o:rank(), h = o:health(), pos = o.position,
				k = olr_cfg.on("amk_odds") and k_of_section(o:section_name()) or 1, sec = o:section_name() })
		end
	end
	return out
end

local function warn_pack(victim, B)
	local c = config()
	local lvl = olr_smart_index.object_level(victim)
	local region = olr_smart_index.region_levels()
	if not ( lvl and region and region[lvl] and he_pda_model.get_pda() ) then return end
	local n = timers.Get_Game_Seconds()
	if n < warn_next or math.random(100) > c.backoff_news_chance then return end
	local key = olr_trader_runs.pick_line("olr_pack_warn_")
	if not key then
		alog("no text for olr_pack_warn_")
		return
	end
	warn_next = n + c.backoff_news_cd_h * 3600
	local where = news_main.where_text(lvl, B[1].pos)
	local text = string.gsub(game.translate_string(key), "%$where", function() return where end)
	sak.send_tip(text, olr_trader_runs.display_name(victim) or olr_trader_runs.other_name(), 0, 15, "default", "pda_news", "gray")
	alog("warns the net: %s, %s", key, where)
end

-- true: he fights; false: he backs off. ctx names the caller in the log
function weigh_fight(victim, friends, monsters, k, ctx, kb, engage_m)
	if not olr_cfg.on("amk_odds") then return true end
	local c = config()
	local A, B = stalker_side(victim, friends), mutant_side(monsters)
	if #A == 0 or #B == 0 then return true end
	for _, b in ipairs(B) do
		local d = b.pos:distance_to(victim.position)
		if d < c.odds_cornered_m and not engage_m then
			note("cornered")
			alog("odds %s: %s cornered, a mutant %.0f m away, fights whatever the odds", ctx, victim:name(), d)
			return true
		end
	end
	local win, dead = odds(A, B, k, c.odds_trials, kb, engage_m)
	local tier = tier_of(victim)
	local courage = olr_lives.courage(victim)
	local need = c["odds_need_" .. tier] + courage
	local noise = c["odds_noise_" .. tier]
	local believed = win * 100 + ( math.random() * 2 - 1 ) * noise
	local go = believed >= need
	local kinds, order = {}, {}
	for _, b in ipairs(B) do
		if not kinds[b.sec] then table.insert(order, b.sec) end
		kinds[b.sec] = ( kinds[b.sec] or 0 ) + 1
	end
	for n2, sec in ipairs(order) do order[n2] = kinds[sec] > 1 and ( sec .. " x" .. kinds[sec] ) or sec end
	alog("odds %s: %s id=%d (%s) with %d friends vs %d mutants (%s): wins %.0f%% (%.1f of his side die), he reckons %.0f%%, needs %d%s: %s",
		ctx, victim:name(), victim.id, tier, #A - 1, #B, table.concat(order, ", "), win * 100, dead, believed, need, courage ~= 0 and string.format(" (goal %+d)", courage) or "",
		go and "fights" or "backs off")
	if go then
		note(win < 0.5 and "fights_long_odds" or "fights")
	else
		note("backed_off")
		olr_digest.note("backoff", olr_smart_index.object_level(victim), { se = victim, pos = B[1].pos, sub = B[1].sec })
		warn_pack(victim, B)
	end
	return go
end

-- [HE-PORT] 3.5: how likely a stalker with nothing in sight sells on the spot (preset key amk_trade_weighted)
function trade_chance(victim, verbose)
	local c = config()
	if not olr_cfg.on("amk_trade_weighted") then return c.trade_chance end
	local a = amk_offline_alife
	local bag = 0
	for _, rec in pairs(a.items[victim.id] or {}) do
		local it = rec and alife():object(rec.id)
		if it and it.parent_id == victim.id and it:name() == rec.name then bag = bag + a.get_item_cost(it) end
	end
	local t_bag = math.min(c.trade_bag_max, math.max(0, math.floor(( bag - c.trade_bag_floor ) / 500)))
	local money = money_of(victim)
	local t_money = money < c.trade_poor_money and c.trade_poor_bonus or money > c.trade_rich_money and -c.trade_rich_malus or 0
	local tier = tier_of(victim)
	local t_rank = tier == "novice" and c.trade_novice_bonus or tier == "master" and -c.trade_master_malus or 0
	local t_goal = olr_lives.trade_bonus(victim)
	local p = math.max(c.trade_min, math.min(c.trade_max, c.trade_base + t_bag + t_money + t_rank + t_goal))
	if verbose then
		log2("[olr_amk] trade %s: base %d + bag %d (%d worth) + money %d (%d) + rank %d (%s) + goal %d = %d%%", victim:name(), c.trade_base,
			t_bag, bag, t_money, money, t_rank, tier, t_goal, p)
	end
	return p
end

-- a box is worth a look only with something in it (AMK lists every unowned box in 140 m, empty or not)
local function full_boxes(vdata)
	local out = {}
	for _, b in ipairs(vdata.inv_boxes) do
		local list = amk_offline_alife.items[b.id]
		if list and #list > 0 then table.insert(out, b) end
	end
	return out
end

-- the same: a body is worth a look while it still carries something (AMK lists every corpse in sight, looted or not,
-- and each look also sends a "found a body" line)
local function with_loot(list)
	local out = {}
	for _, c in ipairs(list) do
		local items = amk_offline_alife.items[c.id]
		if items and #items > 0 then table.insert(out, c) end
	end
	return out
end

local function found(vdata, map)
	-- a level under its target keeps its mutants (hunts and lairs already work on it)
	if olr_population.active() and olr_population.verdict(map, false) == "under" then vdata.monsters = {} end
	-- [HE-PORT] quest mutants are the player's (olr_protected.is_protected_monster)
	local mons = {}
	for _, m in ipairs(vdata.monsters) do
		local o = alife():object(m.id)
		if not ( o and olr_protected.is_protected_monster(o) ) then table.insert(mons, m) end
	end
	vdata.monsters = mons
	vdata.inv_boxes = full_boxes(vdata)
	vdata.corpses.stalkers = with_loot(vdata.corpses.stalkers)
	vdata.corpses.monsters = with_loot(vdata.corpses.monsters)
	return {
		monsters = #vdata.monsters,
		enemies = #vdata.enemies,
		corpses = #vdata.corpses.stalkers + #vdata.corpses.monsters,
		weapons = #vdata.weapons.seen,
		boxes = #vdata.inv_boxes,
		artefacts = #vdata.artefacts,
	}
end

-- [HE-PORT] each weight times what his life goal makes of it (olr_lives.weight, 1 with life_goals off)
local function roll(have, victim)
	local c = config()
	local w = {}
	local sum = 0
	for kind, n in pairs(have) do
		if n > 0 then
			w[kind] = ( c["w_" .. kind] or 0 ) * olr_lives.weight(victim, kind)
			sum = sum + w[kind]
		end
	end
	if sum <= 0 then return nil end
	local r = math.random() * sum
	for kind, n in pairs(have) do
		if n > 0 then
			r = r - w[kind]
			if r <= 0 then return kind end
		end
	end
	return nil
end

-- live mutants within art_guard_radius of an artefact, from AMK's own list of the level
local function guards_of(artefact, map)
	local out = {}
	local list = amk_offline_alife.off_npcs[map] and amk_offline_alife.off_npcs[map].monsters or {}
	local r = config().art_guard_radius
	for _, m in pairs(list) do
		local o = alife():object(m.id)
		if o and o:name() == m.name and IsMonster(o) and o:alive() and amk_offline_alife.can_be_online(o)
			and not o.online and olr_smart_index.object_level(o) == map
			and o.position:distance_to(artefact.position) <= r
		then
			table.insert(out, { id = o.id, name = o:name() })
		end
	end
	return out
end

-- one artefact: fight its guards first, take it only if he is still standing and they are all dead
local function earn(victim, vdata, map)
	local first = vdata.artefacts[1]
	local art = first and alife():object(first.id)
	if not ( art and art:name() == first.name ) then return end
	-- pick_item moves it by making a copy and releasing this one: nothing may touch art after the pickup
	local sec = art:section_name()
	vdata.artefacts = { first }
	local guards = guards_of(art, map)
	if #guards == 0 then
		amk_offline_alife.on_artifacts_found(victim, vdata)
		note("artefacts")
		alog("%s on %s takes %s, nobody guarding it", victim:name(), map, sec)
		return
	end
	local ka, kb = fight_k(config().amk_damage_k)
	if not weigh_fight(victim, vdata.friends, guards, ka, "artefact", kb) then
		note("artefacts_declined")
		alog("%s on %s leaves %s alone: %d guards", victim:name(), map, sec, #guards)
		return
	end
	local fight = { friends = vdata.friends, monsters = guards, damage_k = ka, monster_k = kb }
	local list = fighters(victim, vdata)
	local before = ranks_of(list)
	local size_a, died_a, size_b, died_b = amk_offline_alife.on_monsters_found(victim, fight)
	after_fight(victim, list, before)
	local standing = victim:alive() and victim:health() > config().art_min_health
	if standing and died_b == size_b then
		vdata.olr_earned = true
		news_main.on_offline_artifact_earned(victim, art)
		amk_offline_alife.on_artifacts_found(victim, vdata)
		note("artefacts_earned")
		alog("%s on %s fought %d mutants for %s and took it (%s of %s stalkers dead)", victim:name(), map, size_b or 0,
			sec, tostring(died_a), tostring(size_a))
	else
		note("artefacts_lost")
		alog("%s on %s went for %s: %s of %s guards dead, he %s", victim:name(), map, sec, tostring(died_b),
			tostring(size_b), victim:alive() and "fell back wounded" or "died")
	end
end

local function trade_roll(victim)
	local p = trade_chance(victim)
	trade_rolls, trade_sum = trade_rolls + 1, trade_sum + p
	return p
end

-- offline_alife, in place of the fixed order: true once the stalker did something (false: the call tries another)
function act(victim, vdata, map)
	local have = found(vdata, map)
	local kind = roll(have, victim)
	local a = amk_offline_alife
	local list = fighters(victim, vdata)
	local before = ( kind == "monsters" or kind == "enemies" ) and ranks_of(list) or nil
	local ka, kb = fight_k(config().amk_damage_k)
	if kind == "monsters" and not weigh_fight(victim, vdata.friends, vdata.monsters, ka, "amk", kb) then
		return false
	end
	if kind == "monsters" then
		vdata.damage_k, vdata.monster_k = ka, kb
		local size_a, died_a, size_b, died_b = a.on_monsters_found(victim, vdata)
		alog("%s on %s vs %d mutants: %s of %s stalkers dead, %s of %s mutants dead", victim:name(), map, have.monsters,
			tostring(died_a), tostring(size_a), tostring(died_b), tostring(size_b))
	elseif kind == "enemies" then
		a.on_enemies_found(victim, vdata)
		alog("%s (%s) on %s meets %d enemies", victim:name(), victim:community(), map, have.enemies)
	elseif kind == "corpses" then
		if #vdata.corpses.stalkers > 0 then a.on_npc_corpses_found(victim, vdata) else a.on_monster_corpses_found(victim, vdata) end
	elseif kind == "weapons" then
		a.on_weapons_found(victim, vdata)
	elseif kind == "boxes" then
		local snap = olr_stash.before_loot(victim, vdata) -- [HE-PORT] the player's stashes
		a.on_inv_boxes_found(victim, vdata)
		olr_stash.after_loot(victim, snap)
	elseif kind == "artefacts" then
		earn(victim, vdata, map)
		return true
	elseif a.items[victim.id] and #a.items[victim.id] > 0 and math.random(100) <= trade_roll(victim) then
		a.process_trade(victim, vdata)
		kind = "trade"
	else
		-- nothing in sight: the call looks at the next stalker (AMK tries up to 30 a call) instead of ending in a sale;
		-- only trade_chance % of such looks trade, so a stalker near a fight or a find gets his turn
		note("nothing_seen")
		return false
	end
	if before then after_fight(victim, list, before) end
	note(kind)
	return true
end

-- news_main: how many missed calls one news tick may run (time_factor)
function catch_up_calls()
	if not active() then return 1 end
	return config().catch_up_calls
end

function earned_news_chance()
	return config().earned_news_chance
end

function report()
	local c = config()
	log2("[olr_amk] on=%s sight: monster %d, enemy %d, friend %d, corpse %d, weapon %d, artefact %d (guards within %d m)",
		tostring(active()), c.sight_monster, c.sight_enemy, c.sight_friend, c.sight_corpse, c.sight_weapon, c.sight_art,
		c.art_guard_radius)
	log2("[olr_amk] weights: monsters %d, enemies %d, corpses %d, weapons %d, boxes %d, artefacts %d; overfull levels %d%%",
		c.w_monsters, c.w_enemies, c.w_corpses, c.w_weapons, c.w_boxes, c.w_artefacts, c.over_share)
	local list = {}
	for k, n in pairs(done) do table.insert(list, k .. "=" .. n) end
	table.sort(list)
	log2("[olr_amk] this session: %s", table.concat(list, " "))
	log2("[olr_amk] odds=%s (need %d/%d/%d/%d%%, noise %d/%d/%d/%d, cornered %d m) trade_weighted=%s: %d rolls, mean %.1f%%",
		tostring(olr_cfg.on("amk_odds")), c.odds_need_novice, c.odds_need_experienced, c.odds_need_veteran, c.odds_need_master,
		c.odds_noise_novice, c.odds_noise_experienced, c.odds_noise_veteran, c.odds_noise_master, c.odds_cornered_m,
		tostring(olr_cfg.on("amk_trade_weighted")), trade_rolls, trade_rolls > 0 and trade_sum / trade_rolls or 0)
end

local function find_listed(name)
	for m, t in pairs(amk_offline_alife.off_npcs) do
		for _, st in ipairs(t.stalkers or {}) do
			if st.name == name or st.id == tonumber(name) then return alife():object(st.id), m end
		end
	end
	return nil, nil
end

-- the odds he would see now against what is in his sight (on any level, the player's too)
function odds_test(name)
	local se, map = find_listed(name)
	if not se then
		log2("[olr_amk] odds_test %s: not on any AMK stalker list", tostring(name))
		return
	end
	local vdata = amk_offline_alife.collect_info(se, map)
	log2("[olr_amk] odds_test %s (%s, %s, rank %d) on %s: %d mutants, %d friends in sight", se:name(), se:community(), tier_of(se), se:rank(), map,
		#vdata.monsters, #vdata.friends)
	for _, m in ipairs(vdata.monsters) do
		local o = alife():object(m.id)
		local pr = o and amk_offline_alife.get_monster_params(o)
		if pr then
			log2("[olr_amk]   %s %.0f m: attack %.2f speed %.1f reach %.1f immunity %.2f health %.2f", o:section_name(), o.position:distance_to(se.position),
				pr.attack, pr.speed, pr.dist, pr.immunity, o:health())
		end
	end
	local wpn = amk_offline_alife.get_npc_weapon(se)
	log2("[olr_amk]   his weapon %s, firepower %d", wpn and wpn:section_name() or "none", amk_offline_alife.get_weapon_firepower(wpn))
	if #vdata.monsters > 0 then
		local old = olr_cfg.on("amk_odds")
		local ka, kb = fight_k(config().amk_damage_k)
		log2("[olr_amk]   decision: %s%s", tostring(weigh_fight(se, vdata.friends, vdata.monsters, ka, "test", kb)),
			old and "" or " (amk_odds is off: he would fight anyway)")
	end
end

-- section-based mirror of load_weapon_params / get_monster_params, for the table only
local function wpn_fp_of(sec)
	local ini = system_ini()
	local p = ini:line_exist(sec, "ef_weapon_type") and ini:r_float(sec, "ef_weapon_type") or 1
	local p2 = ini:line_exist(sec, "ef_main_weapon_type") and ini:r_float(sec, "ef_main_weapon_type") or 0
	if p > 1 and p2 > 0 then p = p + p2 end
	return math.ceil(p * 1000) - 5000
end

local function mon_of(sec)
	local ini = system_ini()
	local function num(s2, k, d) return ( s2 ~= "" and ini:section_exist(s2) and ini:line_exist(s2, k) ) and ini:r_float(s2, k) or d end
	local imm = ini:line_exist(sec, "immunities_sect") and ini:r_string(sec, "immunities_sect") or ""
	local att = ini:line_exist(sec, "attack_params") and ini:r_string(sec, "attack_params") or ""
	local attack = 0
	if att ~= "" and ini:section_exist(att) then
		for n = 0, ini:line_count(att) - 1 do
			local _, _, v = ini:r_line(att, n, "", "")
			local parts = {}
			for x in string.gmatch(v or "", "[^,]+") do table.insert(parts, x) end
			local a2 = tonumber(parts[2] or "")
			if a2 and a2 > attack then attack = a2 end
		end
	end
	return { speed = num(sec, "MaxSpeed", 5), adist = num(sec, "MaxAttackDist", 3), imm = num(imm, "fire_wound_immunity", 1), attack = attack }
end

function odds_table(guns, mutants, k, kb)
	local c = config()
	local ka0, kb0 = fight_k(c.amk_damage_k)
	k, kb = k or ka0, kb or kb0
	guns = guns or { "wpn_pm", "wpn_toz34", "wpn_ak74" }
	mutants = mutants or { "dog_weak", "pseudodog_weak", "boar_weak", "flesh_weak", "snork_weak", "bloodsucker_weak" }
	local ranks_of_tier = { novice = 100, experienced = 400, veteran = 800, master = 1200 }
	local base = db.actor:position()
	log2("[olr_amk] odds_table: a lone stalker, mutants at 40 m, %d trials, stalker damage %.2f, mutant damage %.2f; win %% per count 1,3,6,10,15",
		c.odds_trials, k, kb)
	for _, sec in ipairs(mutants) do
		if system_ini():section_exist(sec) then
			local m = mon_of(sec)
			for _, gun in ipairs(guns) do
				if system_ini():section_exist(gun) then
					local fp = wpn_fp_of(gun)
					local row = {}
					for _, tier in ipairs({ "novice", "experienced", "veteran", "master" }) do
						local cells = {}
						for _, count in ipairs({ 1, 3, 6, 10, 15 }) do
							local A = { { i = 1, lead = true, fp = fp, rank = ranks_of_tier[tier], h = 1, pos = base } }
							local B = {}
							for n = 1, count do
								local a = n * 2 * math.pi / count
								table.insert(B, { i = 100 + n, fp = math.floor(m.attack * ODDS_BASE_FP), speed = m.speed, adist = m.adist, imm = m.imm, rank = 0, h = 1, k = k_of_section(sec),
									pos = vector():set(base.x + 40 * math.cos(a), base.y, base.z + 40 * math.sin(a)) })
							end
							local win = odds(A, B, k, c.odds_trials, kb)
							table.insert(cells, string.format("%3.0f", win * 100))
						end
						table.insert(row, tier .. " " .. table.concat(cells, "/"))
					end
					log2("[olr_amk]   %s vs %s (fp %d; att %.2f x%.2f sp %.1f imm %.2f): %s", gun, sec, fp, m.attack, k_of_section(sec), m.speed, m.imm, table.concat(row, "  "))
				end
			end
		end
	end
end

function trade_test(name)
	local se = find_listed(name)
	if not se then
		log2("[olr_amk] trade_test %s: not on any AMK stalker list", tostring(name))
		return
	end
	trade_chance(se, true)
end

-- the loose artefacts AMK has on its list for a level (lists are rebuilt on every level load) and the nearest offline
-- stalker to each, with whether he would see it
function arts(map)
	map = map or level.name()
	local t = amk_offline_alife.off_npcs[map]
	if not t then
		log2("[olr_amk] %s arts on %s: AMK has no list for it", olr_cfg.stamp(), map)
		return
	end
	local sim = alife()
	local _, _, _, _, _, r_art = radii()
	log2("[olr_amk] %s arts on %s: %d on the list, %d stalkers, sight %d m", olr_cfg.stamp(), map, #t.artefacts, #t.stalkers, r_art)
	for _, a in ipairs(t.artefacts) do
		local art = sim:object(a.id)
		if not ( art and art:name() == a.name ) then
			log2("[olr_amk]   %s: gone", a.name)
		else
			local loose = art.parent_id == nil or art.parent_id == BAD_OBJ_ID
			local best, d = nil, nil
			for _, st in ipairs(t.stalkers) do
				local se = sim:object(st.id)
				if se and se:name() == st.name and se:alive() and not se.online then
					local dd = se.position:distance_to(art.position)
					if not d or dd < d then best, d = se, dd end
				end
			end
			log2("[olr_amk]   %s %s at %.0f,%.0f,%.0f %s; nearest offline stalker %s %s%s; guards %d", art:section_name(), a.name,
				art.position.x, art.position.y, art.position.z, loose and "loose" or "in a box or carried",
				best and best:name() or "none", d and string.format("%.0f m", d) or "", d and d < r_art and " (in sight)" or "",
				#guards_of(art, map))
		end
	end
end

-- for each offline stalker on a level, the nearest one he counts as an enemy (relation at or below enemy_goodwill):
-- why offline faction fights happen or not
function enemies(map)
	map = map or level.name()
	local t = amk_offline_alife.off_npcs[map]
	if not t then
		log2("[olr_amk] %s enemies on %s: AMK has no list for it", olr_cfg.stamp(), map)
		return
	end
	local sim = alife()
	local _, _, r_enemy = radii()
	local limit = enemy_goodwill(-5000)
	local list = {}
	for _, st in ipairs(t.stalkers) do
		local se = sim:object(st.id)
		if se and se:name() == st.name and se:alive() and not se.online then table.insert(list, se) end
	end
	local pairs_in, best = 0, {}
	for _, a in ipairs(list) do
		local near, d = nil, nil
		for _, b in ipairs(list) do
			if a.id ~= b.id and amk_offline_alife.relation_check(a, b) <= limit then
				local dd = a.position:distance_to(b.position)
				if not d or dd < d then near, d = b, dd end
			end
		end
		if near then
			if d < r_enemy then pairs_in = pairs_in + 1 end
			table.insert(best, { d = d, line = string.format("%s (%s) - %s (%s) %.0f m%s", a:name(), a:community(), near:name(),
				near:community(), d, usable(a) and usable(near) and "" or ", one of them may not take part") })
		end
	end
	table.sort(best, function(x, y) return x.d < y.d end)
	log2("[olr_amk] %s enemies on %s: %d offline stalkers, %d with an enemy within %d m (goodwill %d or less)", olr_cfg.stamp(), map,
		#list, pairs_in, r_enemy, limit)
	for i = 1, math.min(8, #best) do log2("[olr_amk]   %s", best[i].line) end
end

-- AMK looks at one stalker a call, about once in twelve game days each: two squads crossing on the road were never
-- seen. Every road_every_min game minutes, offline stalkers on the move (road_far m or more from their smart, or with
-- none) check for enemies in sight; road_fight_chance % of such meetings become a fight, road_max_fights a pass.
local road_t = nil
local road_real = 0

local function alive_count(list)
	local n = 0
	for _, v in ipairs(list) do
		local o = alife():object(v.id)
		if o and o:alive() then n = n + 1 end
	end
	return n
end

local function on_the_move(se, sim)
	local sid = se:smart_terrain_id()
	if not sid or sid == BAD_OBJ_ID then return true end
	local smart = sim:object(sid)
	return not smart or smart.position:distance_to(se.position) >= config().road_far
end

-- olr_offline_hunts: a stalker away from his smart (or with none) hunts; one at it only defends his camp
-- [HE-PORT] docs/ALIFE_NEXT_DESIGN.md 8.29 D1: AMK puts everyone friendly to the scanned man on his side and only his
-- direct enemies on the other, so a loner friendly to both Duty and Freedom fought for whichever of them was scanned,
-- even against his own campmate. Now a friend joins only if he is hostile to one of the enemies himself, and the
-- enemies' own friends nearby who are hostile to the scanned man join them (at most loyal_max).
function loyal_sides(victim, vdata)
	if not active() or not vdata.enemies or #vdata.enemies == 0 then return end
	local a = amk_offline_alife
	local sim = alife()
	local enemies, taken = {}, { [victim.id] = true }
	for _, e in ipairs(vdata.enemies) do
		local o = sim:object(e.id)
		if o and o:name() == e.name then
			table.insert(enemies, o)
			taken[o.id] = true
		end
	end
	if #enemies == 0 then return end
	local kept, out = {}, 0
	for _, f in ipairs(vdata.friends or {}) do
		local o = sim:object(f.id)
		local fights = false
		if o and o:name() == f.name then
			for _, e in ipairs(enemies) do
				if a.comm_hostile(o:community(), e:community()) then
					fights = true
					break
				end
			end
		end
		if fights then
			table.insert(kept, f)
			taken[o.id] = true
		else
			out = out + 1
		end
	end
	vdata.friends = kept
	local joined = 0
	local _, r_friend = radii()
	if not r_friend or r_friend <= 0 then r_friend = config().loyal_radius end
	local lvl = olr_smart_index.object_level(enemies[1])
	local list = lvl and a.off_npcs[lvl] and a.off_npcs[lvl].stalkers or {}
	for _, rec in pairs(list) do
		if joined >= config().loyal_max then break end
		local o = rec and not taken[rec.id] and sim:object(rec.id)
		-- [HE-PORT] review 8.30 R1: offline, really on this level, not a camp guard at his post, not in a peaceful smart
		if o and o:name() == rec.name and IsStalker(o) and o:alive() and usable(o) and not o.online
			and olr_smart_index.object_level(o) == lvl and not at_post(o, sim) and not a.npc_smart_is_peaceful(o)
			and a.comm_hostile(o:community(), victim:community())
		then
			for _, e in ipairs(enemies) do
				if o.position:distance_to(e.position) <= r_friend and a.comm_friends(o:community(), e:community()) then
					table.insert(vdata.enemies, { id = o.id, name = o:name() })
					taken[o.id] = true
					joined = joined + 1
					break
				end
			end
		end
	end
	if out > 0 or joined > 0 then
		alog("fight sides for %s (%s): %d of his friends sit it out, %d friends of the enemy join them", victim:name(), victim:community(), out, joined)
	end
end

function is_on_the_move(se)
	return on_the_move(se, alife())
end

-- watch mode: the next road meeting is not settled offline but held, so the player can go and see it online
local watch = false
local held = nil

function watch_next(on)
	watch = on ~= false
	alog("watch %s: %s", watch and "on" or "off", watch and "the next road meeting waits for you, then fl olr_amk_offline.go()" or "road meetings are settled offline")
end

function go()
	if not held then
		log2("[olr_amk] go: nothing held (fl olr_amk_offline.watch_next() first, then wait for a road meeting)")
		return
	end
	local h = held
	held = nil
	-- a little off the spot, so the player does not land between them
	local pos = vector():set(h.pos.x + 25, h.pos.y, h.pos.z + 25)
	alog("go: to %s on %s (%s)", h.who, h.map, h.what)
	if h.map == level.name() then
		db.actor:set_actor_position(pos)
	else
		new_compass_tp.create_level_changer(h.lv, h.gv, pos)
	end
end

-- teleport next to any creature by name or id (offline ones come online around the player)
function go_to(who)
	local se = type(who) == "number" and alife():object(who) or alife():object(tostring(who))
	if not se then
		log2("[olr_amk] go_to %s: no such object", tostring(who))
		return
	end
	local map = olr_smart_index.object_level(se)
	if IsStalker(se) and olr_census.is_dormant_creature(se, true) then
		alog("go_to: %s is dormant (kept out of the world until his scene), not going", se:name())
		return
	end
	alog("go_to: %s on %s", se:name(), tostring(map))
	go_spot(map, se.m_level_vertex_id, se.m_game_vertex_id, se.position)
end

-- to a spot: on this level the nav vertex itself (an object's own position can be off the mesh), else a level change
function go_spot(map, lv, gv, pos)
	if map == level.name() then
		db.actor:set_actor_position(lv and lv < 4294967295 and level.vertex_position(lv) or pos)
	else
		new_compass_tp.create_level_changer(lv, gv, pos)
	end
end

local function hold(victim, map, vdata)
	held = { pos = victim.position, lv = victim.m_level_vertex_id, gv = victim.m_game_vertex_id, map = map, who = victim:name(),
		what = string.format("%s (%s) with %d friends vs %d enemies", victim:name(), victim:community(), #vdata.friends, #vdata.enemies) }
	watch = false
	alog("road meeting held for you on %s: %s; fl olr_amk_offline.go()", map, held.what)
end

local function road_fight(victim, map, vdata)
	if watch then return hold(victim, map, vdata) end
	local side_a = { { id = victim.id } }
	for _, f in ipairs(vdata.friends) do table.insert(side_a, f) end
	local a0, b0 = #side_a, #vdata.enemies
	local list = fighters(victim, vdata)
	local before = ranks_of(list)
	amk_offline_alife.on_enemies_found(victim, vdata)
	after_fight(victim, list, before)
	local a1, b1 = alive_count(side_a), alive_count(vdata.enemies)
	note("road_fights")
	alog("road on %s: %s (%s) and %d friends met %d enemies: %d of %d dead on his side, %d of %d on theirs", map, victim:name(),
		victim:community(), #vdata.friends, b0, a0 - a1, a0, b0 - b1, b0)
end

function roads(forced)
	if not ( active() and db.actor ) then return end
	local c = config()
	local sim = alife()
	local here = level.name()
	local fights, met = 0, 0
	local movers = {}
	for map, t in pairs(amk_offline_alife.off_npcs) do
		if map ~= here and t.stalkers then
			for _, st in ipairs(t.stalkers) do
				local se = sim:object(st.id)
				if se and se:name() == st.name and IsStalker(se) and se:alive() and not se.online
					and se:health() > 0.1 and se:community() ~= "zombied" and on_the_move(se, sim)
				then
					table.insert(movers, { se = se, map = map })
				end
			end
		end
	end
	-- collect_info walks the whole level: road_max_checks of them a pass, picked at random
	local checked = 0
	while #movers > 0 and checked < c.road_max_checks and fights < c.road_max_fights do
		local m = table.remove(movers, math.random(#movers))
		if usable(m.se) then
			checked = checked + 1
			local vdata = amk_offline_alife.collect_info(m.se, m.map)
			if #vdata.enemies > 0 then
				met = met + 1
				if math.random(100) <= c.road_fight_chance then
					fights = fights + 1
					road_fight(m.se, m.map, vdata)
				end
			end
		end
	end
	movers = checked + #movers
	if forced or met > 0 then alog("road pass: %d on the move, %d met enemies, %d fights", movers, met, fights) end
end

-- olr_init, every few seconds; the pass itself runs every road_every_min game minutes (and not twice in 5 s of wall clock)
function roads_update()
	if not ( active() and db.actor ) then return end
	local now = timers.Get_Game_Seconds()
	if not road_t then
		road_t = now
		return
	end
	if now - road_t < config().road_every_min * 60 or os.time() - road_real < 5 then return end
	road_t, road_real = now, os.time()
	roads(false)
end

function fight_test(name)
	local sim = alife()
	local se, map = nil, nil
	for m, t in pairs(amk_offline_alife.off_npcs) do
		for _, st in ipairs(t.stalkers or {}) do
			if st.name == name then se, map = sim:object(st.id), m end
		end
	end
	if not se then
		log2("[olr_amk] fight_test %s: not on any AMK stalker list (dormant, story id, zombied, or born after the last level load)", name)
		return
	end
	log2("[olr_amk] fight_test %s (%s) on %s: online=%s health=%.2f can_switch_online=%s quest_lock=%s usable=%s on_the_move=%s",
		name, se:community(), map, tostring(se.online), se:health(), tostring(se:can_switch_online()),
		tostring(he_quest_target_lock.is_locked_id(se.id)), tostring(usable(se)), tostring(on_the_move(se, sim)))
	local vdata = amk_offline_alife.collect_info(se, map)
	log2("[olr_amk]   sees: monsters %d, enemies %d, friends %d, corpses %d+%d, weapons %d, boxes %d, artefacts %d",
		#vdata.monsters, #vdata.enemies, #vdata.friends, #vdata.corpses.stalkers, #vdata.corpses.monsters, #vdata.weapons.seen,
		#vdata.inv_boxes, #vdata.artefacts)
	for _, e in ipairs(vdata.enemies) do
		local o = sim:object(e.id)
		log2("[olr_amk]   enemy %s (%s) %.0f m", e.name, o and o:community() or "?", o and o.position:distance_to(se.position) or -1)
	end
	if #vdata.enemies > 0 then
		road_fight(se, map, vdata)
	else
		local ok = act(se, vdata, map)
		log2("[olr_amk]   acted: %s", tostring(ok))
	end
end

function force(n)
	for i = 1, n or 10 do amk_offline_alife.offline_alife() end
	report()
end
