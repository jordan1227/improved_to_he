-- [HE-PORT] Regrouping, docs/ALIFE_NEXT_DESIGN.md 8.24 (the AlifeBalance "squad refill" idea, preset key regroup).
-- OLR keeps no squads, only people bound to a smart, so a squad worn down by fights is a man left alone at his smart.
-- A generic man (OLR's own or respawned) of a side that migrates, alone of his side at his smart for alone_h game
-- hours, joins the nearest smart of his level within regroup_dist m where 1 to join_max of his side are: two lone men
-- make a pair, a lone man fills a thin camp. Nobody is created; the smart must accept him (move_or_stay). Never a man
-- busy elsewhere (a run, a party, a day trip, a rest, the night, a road watch, a goal journey), quest-bound, in sight
-- of the player, or one his smart needs. Config [regroup]. Log: [olr_regroup].
-- 8.29: men away for a while (a day trip, a trader run, a night at another fire) still count at their home smart (P2);
-- with regroup_allies a lone man may join a smart of his allies, friends both ways in [communities_relations] (P3);
-- never a smart holding anyone hostile to him (D2), so Duty and Freedom never share a camp.
-- fl olr_regroup.report()            who is alone now and since when, moves this session and why not more
-- fl olr_regroup.check(12345)        why he would or would not move
-- fl olr_regroup.force(12345)        he moves now if a smart will have him (alone or not, seen or not)

local INI_PATH = "misc\\olr_alife.ltx"
local KEY = "nlc.olr_regroup"
local COMMS = { "stalker", "green", "dolg", "freedom", "bandit", "killer", "ecolog" }
local ALL = { "stalker", "green", "dolg", "freedom", "bandit", "killer", "ecolog", "military", "monolith" }
local SIDE = { stalker = { "stalker", "green" }, green = { "stalker", "green" } }

local cfg = nil
local scan_index, scan_comm = 0, 1
local counts = {}
local census_cache, census_t, census_rt = {}, -1, -1

local function config()
	if cfg then return cfg end
	cfg = {}
	local ini = ini_file(INI_PATH)
	for i = 0, ini:line_count("regroup") - 1 do
		local _, k, v = ini:r_line("regroup", i, "", "")
		cfg[k] = tonumber(v) or v
	end
	for _, k in ipairs({ "regroup_scan_h", "regroup_scan", "regroup_scan_max", "alone_h", "regroup_dist", "join_max", "regroup_moves_tick",
		"regroup_allies" }) do
		if cfg[k] == nil then abort("olr_regroup: no key '%s' in [regroup]", k) end
	end
	return cfg
end

local function rlog(fmt, ...)
	log2("[olr_regroup] %s " .. fmt, olr_cfg.stamp(), ...)
end

local function note(k)
	counts[k] = ( counts[k] or 0 ) + 1
end

local function now()
	return timers.Get_Game_Seconds()
end

function active()
	return db.actor ~= nil and olr_cfg.on("regroup")
end

local function state()
	local st = olr_store.get(KEY)
	if not st then
		st = { alone = {} }
		olr_store.put(KEY, st)
	end
	st.alone = st.alone or {}
	return st
end

local function side_of(comm)
	return SIDE[comm] or { comm }
end

-- P2: id -> home smart of everyone away for a while
local function away_homes()
	local out = {}
	if olr_daytrips.away_homes then olr_daytrips.away_homes(out) end
	if olr_rest.away_homes then olr_rest.away_homes(out) end
	if olr_trader_runs.away_homes then olr_trader_runs.away_homes(out) end
	return out
end

-- who belongs to each smart of a level, by community: smart id -> { comm = n }. Those bound there, and those away from
-- it for a while (P2). Counted once a game minute at most
local function census(lvl)
	local t = now()
	-- [HE-PORT] review 8.30 R5: a game minute and 3 real seconds (at tf250 a game minute is a quarter second)
	if t - census_t >= 60 and time_global() - census_rt >= 3000 then
		census_cache, census_t, census_rt = {}, t, time_global()
	end
	if census_cache[lvl] then return census_cache[lvl] end
	local by = {}
	local sim = alife()
	local away = away_homes()
	for _, c in ipairs(ALL) do
		for _, id in ipairs(olr_offline_task.cached_stalkers(c)) do
			local se = sim:object(id)
			if se and IsStalker(se) and se:alive() then
				local sid = nil
				local hn = away[tostring(id)]
				local h = hn and olr_smart_index.get_level(hn) == lvl and sim:object(hn)
				if h then
					sid = h.id
				elseif not hn and olr_smart_index.object_level(se) == lvl then
					sid = se:smart_terrain_id()
				end
				if sid and sid ~= BAD_OBJ_ID then
					local m = by[sid] or {}
					m[c] = ( m[c] or 0 ) + 1
					by[sid] = m
				end
			end
		end
	end
	census_cache[lvl] = by
	return by
end

-- at a smart: his side, his allies (P3), and whether anyone there is hostile to him
local function company(comm, m)
	local side, allies, enemy = 0, 0, false
	local mine = {}
	for _, c in ipairs(side_of(comm)) do mine[c] = true end
	for c, n in pairs(m or {}) do
		if mine[c] then
			side = side + n
		elseif amk_offline_alife.comm_hostile(comm, c) then
			enemy = true
		elseif amk_offline_alife.comm_friends(comm, c) then
			allies = allies + n
		end
	end
	if config().regroup_allies ~= 1 then allies = 0 end
	return side, allies, enemy
end

local function generic(se)
	local name, sec = se:name(), se:section_name()
	if not ( string.sub(sec, 1, 4) == "olr_" or string.find(name, "_respawn", 1, true) ) then return false end
	if olr_protected.is_quest_bound(se) or olr_protected.is_no_offline_alife_obj(name) then return false end
	if olr_census.is_dormant_creature(se, true) then return false end
	return true
end

-- why he must stay where he is, nil if he is free to move
local function held(se, forced)
	if not generic(se) then return "not generic" end
	if not olr_faction_policy.may_migrate(se, se:community()) then return "his side does not migrate" end
	if olr_trader_runs.on_run(se.id) or olr_patrols.is_member(se.id) then return "on a run or in a party" end
	if olr_daytrips.is_out and olr_daytrips.is_out(se.id) then return "on a day trip" end
	if olr_rest.is_out and olr_rest.is_out(se.id) then return "resting" end
	if olr_night.is_out and olr_night.is_out(se.id) then return "out at night" end
	if olr_roadwatch.is_watcher and olr_roadwatch.is_watcher(se.id) then return "on road watch" end
	if olr_lives.is_travelling and olr_lives.is_travelling(se) then return "on his goal's journey" end
	if forced then return nil end
	if se.online then return "online" end
	if olr_smart_index.object_level(se) == level.name() and se.position:distance_to(db.actor:position()) <= olr_amk_offline.player_clear() then
		return "near the player"
	end
	return nil
end

-- his smart, if he may leave it
local function home_of(se)
	local sid = se:smart_terrain_id()
	local home = sid and sid ~= BAD_OBJ_ID and alife():object(sid)
	if not home then return nil, "no smart" end
	local name = home:name()
	if olr_population.is_scene_smart(name) then return nil, "a scene smart" end
	if olr_smart_index.is_locked(name) then return nil, "his smart is locked" end
	if not olr_smart_index.can_release(name) then return nil, "his smart needs him" end
	return home
end

-- smarts of his level within regroup_dist where 1 to join_max of his side or his allies are and nobody hostile to him,
-- those with his own side first, nearest first within each
local function camps_for(se, home)
	local c = config()
	local lvl = olr_smart_index.object_level(se)
	local by = census(lvl)
	local own, mixed = {}, {}
	for _, rec in ipairs(olr_smart_index.smarts_near(lvl, home.position.x, home.position.z)) do
		if rec.d > c.regroup_dist * c.regroup_dist then break end
		if rec.name ~= home:name() and not olr_population.is_scene_smart(rec.name) and olr_smart_index.may_take(rec.name, se:community(), se:rank(), se) then
			local smart = alife():object(rec.name)
			local side, allies, enemy = company(se:community(), smart and by[smart.id])
			local n = side + allies
			if not enemy and n >= 1 and n <= c.join_max then
				table.insert(side > 0 and own or mixed, { name = rec.name, n = n, side = side, allies = allies, d = math.sqrt(rec.d) })
			end
		end
	end
	for _, cand in ipairs(mixed) do table.insert(own, cand) end
	return own
end

local function move(st, se, home, forced)
	local list = camps_for(se, home)
	if #list == 0 then
		note("no_camp")
		if forced then rlog("force: %s id=%d, no smart of his side within reach", se:name(), se.id) end
		return false
	end
	for _, cand in ipairs(list) do
		if olr_smart_index.move_or_stay(se, cand.name) then
			local rec = st.alone[tostring(se.id)]
			rlog("%s id=%d (%s, %s) alone at %s%s joins %s, %d of his side and %d allies there, %.0f m", se:name(), se.id, se:community(),
				olr_amk_offline.tier_of(se), home:name(), rec and string.format(" for %.1f h", ( now() - rec.t ) / 3600) or "",
				cand.name, cand.side, cand.allies, cand.d)
			st.alone[tostring(se.id)] = nil
			note(cand.n == 1 and "paired" or "joined")
			if cand.side == 0 then note("with_allies") end
			return true
		end
		note("refused")
	end
	rlog("%s id=%d (%s): no smart of %d within reach would have him", se:name(), se.id, se:community(), #list)
	return false
end

-- is he alone at his smart: nobody else of his side or his allies belongs there (P2: those away count)
local function alone(se, home)
	local by = census(olr_smart_index.object_level(se))
	local side, allies = company(se:community(), by[home.id])
	return side + allies <= 1
end

function update()
	if not active() or olr_cfg.sleep_paused() then return end
	local c = config()
	local st = state()
	local sim = alife()
	local t = now()
	local changed, moves = false, 0
	for _ = 1, olr_cfg.budget("regroup", c.regroup_scan_h, c.regroup_scan, c.regroup_scan_max) do
		local ids = olr_offline_task.cached_stalkers(COMMS[scan_comm])
		scan_index = scan_index + 1
		if scan_index > #ids then
			scan_index = 0
			scan_comm = scan_comm % #COMMS + 1
		else
			local se = sim:object(ids[scan_index])
			local key = se and tostring(se.id)
			if se and IsStalker(se) and se:alive() then
				local home = not held(se) and home_of(se)
				if home and alone(se, home) then
					local rec = st.alone[key]
					if not ( rec and rec.n == se:name() and rec.at == home:name() ) then
						st.alone[key] = { n = se:name(), at = home:name(), t = t }
						changed = true
						note("alone")
					elseif t - rec.t >= c.alone_h * 3600 and moves < c.regroup_moves_tick then
						if move(st, se, home) then moves = moves + 1 end
						changed = true
					end
				elseif st.alone[key] then
					st.alone[key] = nil
					changed = true
				end
			end
		end
	end
	-- the dead and the renamed drop out now and then
	if math.random(30) == 1 then
		for key, rec in pairs(st.alone) do
			local se = sim:object(tonumber(key))
			if not ( se and IsStalker(se) and se:alive() and se:name() == rec.n ) then
				st.alone[key] = nil
				changed = true
			end
		end
	end
	if changed then olr_store.put(KEY, st) end
end

function report()
	local st = state()
	local n = 0
	for key, rec in pairs(st.alone) do
		n = n + 1
		if n <= 30 then rlog("  %s id=%s alone at %s for %.1f h", rec.n, key, rec.at, ( now() - rec.t ) / 3600) end
	end
	local list = {}
	for k, v in pairs(counts) do table.insert(list, k .. "=" .. v) end
	table.sort(list)
	rlog("on=%s, %d alone now; this session %s", tostring(active()), n, table.concat(list, " "))
end

function check(id)
	local se = alife():object(id)
	if not ( se and IsStalker(se) and se:alive() ) then
		rlog("check: no living stalker id=%s", tostring(id))
		return
	end
	local why = held(se)
	local home, hwhy = home_of(se)
	rlog("check %s id=%d (%s, %s): %s; smart %s (%s); alone %s", se:name(), id, se:community(), olr_amk_offline.tier_of(se),
		why or "free to move", home and home:name() or "-", hwhy or "may leave", home and tostring(alone(se, home)) or "-")
	if home then
		for _, cand in ipairs(camps_for(se, home)) do rlog("  could join %s, %d of his side and %d allies there, %.0f m", cand.name, cand.side, cand.allies, cand.d) end
	end
end

function force(id)
	local se = alife():object(id)
	if not ( se and IsStalker(se) and se:alive() ) then
		rlog("force: no living stalker id=%s", tostring(id))
		return
	end
	local why = held(se, true)
	if why then rlog("force: %s id=%d is %s: another system may pull him back", se:name(), id, why) end
	local home, hwhy = home_of(se)
	if not home then
		rlog("force: %s id=%d cannot leave: %s", se:name(), id, hwhy)
		return
	end
	local st = state()
	move(st, se, home, true)
	olr_store.put(KEY, st)
end
