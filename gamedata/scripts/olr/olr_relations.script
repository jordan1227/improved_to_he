-- [HE-PORT]
local CHECK_INTERVAL = 6000
local MAX_SCAN = 40
local GOODWILL_ACTOR = 2000
local GOODWILL_NPC = 1500
-- [HE-PORT]
local NEAR_SMART_DIST = 50
local GUEST_SPOT_TTL = 300000

local time_next = 0
local pacified = {}
local guest_spots = {}
local guest_of = {}

-- [HE-PORT]
local hostile = {}

local guest_comms = {
	military = true,
}

local friendly_comms = {
	stalker = true,
	green = true,
	ecolog = true,
	dolg = true,
	trader = true,
}

-- [HE-PORT]
local function guest_denied_here(comm)
	local ok, lname = pcall(function() return level.name() end)
	if not ok or not lname then return false end
	local okd, res = pcall(olr_faction_policy.is_guest_denied, comm, lname)
	return okd and res == true
end

local function smart_of(se)
	local sid = se:smart_terrain_id()
	if not sid or sid == BAD_OBJ_ID then return nil end
	local sim = g_sim or alife()
	if not sim then return nil end
	return sim:object(sid)
end

-- [HE-PORT]
local function mark_guest_spot(smart)
	if not smart then return end
	local ok, pos = pcall(function() return vector():set(smart.position) end)
	if not ok or not pos then return end
	guest_spots[smart.id] = { pos = pos, t = time_global(), lvl = level.name() }
end

-- [HE-PORT]
local function is_near_guest_spot(npc)
	local pos = npc:position()
	local t = time_global()
	local lvl = level.name()
	local res = false
	for sid, info in pairs(guest_spots) do
		if (t - info.t) > GUEST_SPOT_TTL then
			guest_spots[sid] = nil
		elseif not res and info.lvl == lvl and pos:distance_to(info.pos) <= NEAR_SMART_DIST then
			res = true
		end
	end
	return res
end

-- [HE-PORT]
local function mark_hostile(id)
	hostile[id] = true
	if db.actor then
		pcall(function() relation_registry.clear_personal_goodwill(id, db.actor:id()) end)
	end
end

-- [HE-PORT]
local function is_hostile_to_actor(npc)
	local id = npc:id()
	if hostile[id] then return true end
	if not db.actor then return false end
	local ok, enemy = pcall(function() return npc:best_enemy() end)
	if ok and enemy and enemy:id() == db.actor:id() then
		mark_hostile(id)
		return true
	end
	return false
end

-- [HE-PORT] pacified[npc_id] = { [target_id] = true } for every NPC target that got a
-- personal goodwill from this guest. restore() clears only those: the engine's
-- ClearGoodwill FATALs (clear_reverse_personal) on a pair that was never set, and
-- pcall cannot catch an engine FATAL.
local function pacify(npc, targets)
	-- [HE-PORT]
	if is_hostile_to_actor(npc) then
		pcall(function() relation_registry.clear_personal_goodwill(npc:id(), db.actor:id()) end)
	else
		pcall(function() npc:set_goodwill(GOODWILL_ACTOR, db.actor) end)
	end
	local set = pacified[npc:id()]
	if type(set) ~= "table" then
		set = {}
		pacified[npc:id()] = set
	end
	for i = 1, #targets do
		local tgt = targets[i]
		local ok = pcall(function() npc:set_goodwill(GOODWILL_NPC, tgt) end)
		if ok then set[tgt:id()] = true end
	end
end

local function restore(npc)
	local id = npc:id()
	pcall(function() relation_registry.clear_personal_goodwill(id, db.actor:id()) end)
	local set = pacified[id]
	if type(set) ~= "table" then return end
	for tid, _ in pairs(set) do
		-- the pair may be gone already (target released: ClearRelations dropped it, and
		-- its id may be reused); get_personal_goodwill returns 0 for an unset pair
		local okg, gw = pcall(relation_registry.get_personal_goodwill, id, tid)
		if okg and gw and gw ~= 0 then
			pcall(function() relation_registry.clear_personal_goodwill(id, tid) end)
		end
	end
end

function update()
	if not db.actor then return end
	if device().precache_frame > 1 then return end
	if time_global() < time_next then return end
	time_next = time_global() + CHECK_INTERVAL

	-- [HE-PORT]
	if not olr_cfg.on("military_guests") then
		for id, _ in pairs(pacified) do
			local npc = level.object_by_id(id)
			if npc then restore(npc) end
			pacified[id] = nil
			guest_of[id] = nil
		end
		return
	end

	local sim = g_sim
	if not sim then return end
	if not db.storage then return end

	local guests = {}
	local leavers = {}
	local targets = {}
	local strays = {}
	local scanned = 0

	for id, _ in pairs(db.storage) do
		if scanned >= MAX_SCAN then break end
		if id ~= db.actor:id() then
			local npc = level.object_by_id(id)
			if npc and npc:alive() and IsStalker(npc) then
				scanned = scanned + 1
				local comm = npc:character_community()
				if friendly_comms[comm] then
					table.insert(targets, npc)
				elseif guest_comms[comm] then
					local se = sim:object(id)
					local smart = se and smart_of(se)
					local guest = false
					-- [HE-PORT]
					if smart and not guest_denied_here(comm) then
						local ok, res = pcall(olr_faction_policy.is_guest_smart, smart, comm)
						guest = ok and res
					end
					if guest then
						table.insert(guests, npc)
						guest_of[id] = smart.id
						mark_guest_spot(smart)
					else
						table.insert(strays, npc)
					end
				end
			end
		end
	end

	for i = 1, #guests do
		pacify(guests[i], targets)
	end

	-- [HE-PORT]
	for i = 1, #strays do
		local npc = strays[i]
		if is_near_guest_spot(npc) then
			pacify(npc, targets)
		elseif pacified[npc:id()] then
			table.insert(leavers, npc)
		end
	end

	for i = 1, #leavers do
		restore(leavers[i])
		pacified[leavers[i]:id()] = nil
		guest_of[leavers[i]:id()] = nil
	end
end

function guest_smart_id(id)
	return guest_of[id]
end

-- [HE-PORT]
function on_npc_hit(npc, amount, local_direction, who, bone_index)
	if not (db.actor and npc and who) then return end
	if who:id() ~= db.actor:id() then return end
	if not IsStalker(npc) then return end
	if not guest_comms[npc:character_community()] then return end
	mark_hostile(npc:id())
end

-- [HE-PORT]
function on_npc_death(npc)
	if not npc then return end
	local id = npc:id()
	hostile[id] = nil
	pacified[id] = nil
	guest_of[id] = nil
end
