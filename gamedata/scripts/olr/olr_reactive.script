-- [HE-PORT] Reactive life, docs/ALIFE_DESIGN.md Phase 5: the Zone answers what happened in it.
-- Moves people who already exist; creates nobody, except a stalker the Scorcher turned.
-- Every decision is logged as [olr_reactive], whatever the outcome.
-- fl olr_reactive.report()                          timers and counters
-- fl olr_reactive.force_investigate("esc_lager","stalker")  a group heads for that smart now
-- fl olr_reactive.force_scavenge("esc_lager")       mutants near that smart drift to it, day or night
-- fl olr_reactive.force_gossip("dolg")              one gossip line about a move onto this level
-- fl olr_reactive.force_chapter(4)                  the chapter 4 wave, the north flag and the expedition now
-- fl olr_reactive.force_pending(4) / force_due(4)   schedule a chapter's delayed wave / make it due now
-- fl olr_reactive.force_scorcher()                  someone sets off for the Scorcher now
-- fl olr_reactive.scorcher_finish()                 and is lost now
-- fl olr_reactive.carrion()                          the carrion sites: weight, age, and whether each would be used now
-- fl olr_reactive.force_carrion("l02_garbage")       scavengers go to the heaviest site on that level now, day or night

local INI_PATH = "misc\\olr_alife.ltx"
local KEY = "nlc.olr_reactive"
local NEAR_ACTOR = 165
local SCAVENGERS = { "flesh", "tushkano", "rat" }
local GOSSIP_GROUP = { green = "stalker", nebo = "stalker" }
local GOSSIP_KINDS = { stalker = true, dolg = true, freedom = true, ecolog = true, killer = true, bandit = true }
local WAVE_LINES = 3
local WAVE_GAP = 25

local cfg = nil

local function config()
	if cfg then return cfg end
	cfg = {}
	local ini = ini_file(INI_PATH)
	for i = 0, ini:line_count("reactive") - 1 do
		local _, key, val = ini:r_line("reactive", i, "", "")
		cfg[key] = tonumber(val) or val
	end
	return cfg
end

local function rlog(fmt, ...)
	log2("[olr_reactive] " .. fmt, ...)
end

local function now()
	return timers.Get_Game_Seconds()
end

local function get_state()
	return olr_store.get(KEY) or { deaths = {}, smart_cd = {}, scav_cd = {} }
end

local function put_state(st)
	olr_store.put(KEY, st)
end

local function say(key, who, delay, subs)
	local text = game.translate_string(key)
	for name, value in pairs(subs or {}) do
		text = string.gsub(text, "%$" .. name, function() return value end)
	end
	sak.send_tip(text, who, delay or 0, 15, "default", "pda_news", "gray")
end

local function say_line(prefix, who, delay, subs)
	local key = olr_trader_runs.pick_line(prefix)
	if key then
		say(key, who or olr_trader_runs.other_name(), delay, subs)
	else
		rlog("no text for %s", prefix)
	end
	return key
end

local function where_of(smart)
	return news_main.where_text(olr_smart_index.object_level(smart), smart.position)
end

local function heard_here(lvl)
	local region = olr_smart_index.region_levels()
	return region ~= nil and region[lvl] == true and he_pda_model.get_pda() ~= nil
end

-- ---------------------------------------------------------------------------
-- investigate: people die at a smart, others of their faction come to look
-- ---------------------------------------------------------------------------
local function send_group(name, comm)
	olr_smart_index.ensure()
	local smart = olr_smart_index.get_obj(name)
	if not smart then
		rlog("investigate %s: no such smart", tostring(name))
		return 0
	end
	local lvl = olr_smart_index.get_level(name)
	if not olr_smart_index.is_story_open(name) or olr_smart_index.is_locked(name) then
		rlog("investigate %s: smart closed or locked", name)
		return 0
	end
	local allowed = olr_smart_index.neighbour_levels(lvl)
	allowed[lvl] = true
	local sim = alife()
	local ids = olr_offline_task.cached_stalkers(comm)
	local sent, seen, refused = 0, 0, {}
	for _, id in ipairs(ids) do
		if sent >= config().investigate_group then break end
		local se = sim:object(id)
		local here = se and IsStalker(se) and se:alive() and olr_smart_index.object_level(se)
		if here and allowed[here] then
			seen = seen + 1
			local ok, reason = olr_trader_runs.may_travel(se)
			if ok and not olr_smart_index.rank_fits(name, comm, se:rank()) then
				ok, reason = false, "rank"
			end
			if ok and se:smart_terrain_id() == smart.id then
				ok, reason = false, "already_there"
			end
			if ok then
				if olr_smart_index.attach_checked(se, name) then
					sent = sent + 1
					rlog("investigate %s: %s id=%d rank=%d from %s", name, se:name(), id, se:rank(), here)
				else
					refused.attach = ( refused.attach or 0 ) + 1
				end
			else
				refused[reason] = ( refused[reason] or 0 ) + 1
			end
		end
	end
	local why = {}
	for reason, n in pairs(refused) do table.insert(why, reason .. "=" .. n) end
	rlog("investigate %s for %s: sent %d of %d nearby, list %d, refused %s", name, comm, sent, seen, #ids, table.concat(why, " "))
	if sent > 0 and heard_here(lvl) then
		say_line("olr_investigate_", nil, 0, { where = where_of(smart) })
	end
	return sent
end

local function note_investigate(st, name, comm)
	local c = config()
	local n = now()
	local key = name .. "|" .. comm
	local rec = st.deaths[key]
	if not rec or n - rec.t > c.investigate_window_h * 3600 then
		rec = { c = 0, t = n }
		st.deaths[key] = rec
	end
	rec.c = rec.c + 1
	rlog("death at %s, %s: %d of %d", name, comm, rec.c, c.investigate_deaths)
	if rec.c < c.investigate_deaths then return end
	if n < ( st.smart_cd[name] or 0 ) or n < ( st.inv_next or 0 ) then
		rlog("investigate %s: on cooldown", name)
		return
	end
	st.deaths[key] = nil
	if send_group(name, comm) > 0 then
		st.smart_cd[name] = n + c.investigate_smart_cd_h * 3600
		st.inv_next = n + c.investigate_cd_h * 3600
	end
end

-- ---------------------------------------------------------------------------
-- scavenge: small mutants drift to fresh bodies, offline and unseen
-- ---------------------------------------------------------------------------
local function is_scavenger(section)
	for _, prefix in ipairs(SCAVENGERS) do
		if string.sub(section, 1, #prefix) == prefix then return true end
	end
	return false
end

local function is_night()
	local h = level.get_time_hours()
	return h >= 21 or h < 5
end

local function drift_to(pos, lv, gv, lvl)
	local c = config()
	local sim = alife()
	local moved = 0
	for _, id in ipairs(olr_offline_task.cached_monsters()) do
		if moved >= c.scavenge_max then break end
		local se = sim:object(id)
		if se and IsMonster(se) and se:alive() and not se.online and is_scavenger(se:section_name())
			and se.position:distance_to(pos) <= c.scavenge_radius
			and se.position:distance_to(pos) > 15
			and olr_smart_index.object_level(se) == lvl
		then
			sim:teleport_object(id, pos, lv, gv)
			moved = moved + 1
			rlog("scavenge: %s id=%d drifts to the bodies on %s", se:section_name(), id, lvl)
		end
	end
	rlog("scavenge on %s: %d moved", lvl, moved)
	return moved
end

local function unseen(lvl, pos)
	return lvl ~= level.name() or pos:distance_to(db.actor:position()) > NEAR_ACTOR
end

local function note_scavenge(st, name, se, lvl)
	if not is_night() then return end
	if olr_cfg.camp_list()[name] then
		rlog("scavenge: %s is a camp, no", name)
		return
	end
	if not unseen(lvl, se.position) then
		rlog("scavenge: bodies at %s are in the player's range, no", name)
		return
	end
	local n = now()
	if n < ( st.scav_cd[lvl] or 0 ) then return end
	st.scav_cd[lvl] = n + config().scavenge_cd_h * 3600
	drift_to(se.position, se.m_level_vertex_id, se.m_game_vertex_id, lvl)
end

-- ---------------------------------------------------------------------------
-- deaths, online from the signal and offline from news_main
-- ---------------------------------------------------------------------------
-- ---------------------------------------------------------------------------
-- carrion: docs/ALIFE_NEXT_DESIGN.md 5.2 (preset key carrion). Every death feeds a ledger of sites; at dusk and every
-- carrion_every_h of the night the heaviest unseen site of each level in the player's region draws scavengers from
-- around it, and dawn sends them home (the olr_night ledger). Parts on a body they reached are spoiled.
-- ---------------------------------------------------------------------------
local CARRION_KEY = "nlc.olr_carrion"
local carrion_why = {}
local carrion_moves = 0

local function carrion_state()
	return olr_store.get(CARRION_KEY) or { sites = {}, gnawed = {} }
end

local function carrion_weight(se)
	if IsStalker(se) then return 2 end
	local sec = se:section_name()
	if string.find(sec, "gigant", 1, true) then return 4 end
	if string.sub(sec, 1, 8) == "tushkano" or string.sub(sec, 1, 3) == "rat" then return 0 end
	if string.sub(sec, 1, 3) == "dog" then return 1 end
	return 2
end

-- fresh bodies of any death the ledger saw stay in the world for carrion_keep_h (sak_off_corpses releases far corpses at
-- every level change), so the player can find what happened
local FRESH_KEY = "nlc.olr_fresh_bodies"

local function fresh_t(v)
	return type(v) == "table" and v.t or v
end

-- cap: the best a part cut from this body can be (a mutant that died offline, nobody tended it)
local function note_fresh(id, cap)
	local t = olr_store.get(FRESH_KEY) or {}
	local n = now()
	local keep = config().carrion_keep_h * 3600
	for k, v in pairs(t) do
		if n - fresh_t(v) > keep then t[k] = nil end
	end
	t[tostring(id)] = cap and { t = n, cap = cap } or n
	olr_store.put(FRESH_KEY, t)
end

-- an offline death: about half of what he carried is lost (broken, scattered), so offline fights are no loot fountain
local function thin_loot(se)
	local c = config()
	local items = amk_offline_alife.items[se.id]
	if not items then return end
	local sim = alife()
	local kept, lost = 0, {}
	for k, rec in pairs(items) do
		local it = rec and sim:object(rec.id)
		if it and it.parent_id == se.id and it:name() == rec.name then
			local sec = it:section_name()
			if not get_bool(sec, "quest_item", false) and math.random(100) > c.offline_loot_keep then
				table.insert(lost, sec)
				amk_offline_alife.forget_item(se.id, rec.id)
				misc.release_obj(rec.id, "olr_reactive.thin_loot")
			else
				kept = kept + 1
			end
		end
	end
	if #lost > 0 then rlog("offline death of %s id=%d: %d things lost, %d left: %s", se:name(), se.id, #lost, kept, table.concat(lost, ",")) end
end

-- sak_off_corpses: true keeps this corpse for now
function keeps_corpse(id)
	if not ( db.actor and olr_cfg.on("carrion") ) then return false end
	local v = ( olr_store.get(FRESH_KEY) or {} )[tostring(id)]
	return v ~= nil and now() - fresh_t(v) <= config().carrion_keep_h * 3600
end

local function note_carrion(se, offline)
	if not ( se and se.position and ( IsStalker(se) or IsMonster(se) ) ) then return end
	local cap = nil
	if offline and IsMonster(se) then
		local a, b = string.match(tostring(config().offline_part_cap), "([%d%.]+)%s*,%s*([%d%.]+)")
		cap = tonumber(a) + math.random() * ( tonumber(b) - tonumber(a) )
	end
	note_fresh(se.id, cap)
	if offline and IsStalker(se) and se.id ~= 0 then thin_loot(se) end
	local lvl = olr_smart_index.object_level(se)
	if not lvl then return end
	local w = carrion_weight(se)
	local cs = carrion_state()
	local n = now()
	for _, site in ipairs(cs.sites) do
		if site.lvl == lvl and not site.fed and vector():set(site.x, site.y, site.z):distance_to(se.position) < 25 then
			site.w, site.t = site.w + w, n
			if IsMonster(se) and #site.ids < 8 then table.insert(site.ids, se.id) end
			olr_store.put(CARRION_KEY, cs)
			return
		end
	end
	if w <= 0 then return end
	table.insert(cs.sites, { x = se.position.x, y = se.position.y, z = se.position.z, lv = se.m_level_vertex_id, gv = se.m_game_vertex_id,
		lvl = lvl, t = n, w = w, ids = IsMonster(se) and { se.id } or {} })
	while #cs.sites > 24 do table.remove(cs.sites, 1) end
	olr_store.put(CARRION_KEY, cs)
end

local function carrion_species(when)
	local list = {}
	for name in string.gmatch(config()[when == "day" and "carrion_species_day" or "carrion_species_night"], "[%w_]+") do table.insert(list, name) end
	return list
end

local function site_pos(site)
	return vector():set(site.x, site.y, site.z)
end

-- why this site is not used now, nil if it is fine
local function site_refusal(site, when, camps)
	local c = config()
	if site.fed then return "fed" end
	if now() - site.t > c.carrion_h * 3600 then return "old" end
	if when == "day" and site.w < c.carrion_day_weight then return "light_for_day" end
	local pos = site_pos(site)
	local _, outer = olr_cfg.switch_radii()
	if site.lvl == level.name() and pos:distance_to(db.actor:position()) <= outer + c.carrion_unseen_margin then return "player_near" end
	for _, cp in ipairs(camps) do
		if cp:distance_to(pos) < c.carrion_camp_dist then return "camp" end
	end
	return nil
end

local function carrion_pool(site, when)
	local c = config()
	local pos = site_pos(site)
	local kept = news_encounters.tracked_ids()
	local species = carrion_species(when)
	local out = {}
	local sim = alife()
	for _, id in ipairs(olr_offline_task.cached_monsters()) do
		local se = sim:object(id)
		if se and IsMonster(se) and se:alive() and not se.online and not kept[id] and not olr_night.is_out(id)
			and olr_smart_index.object_level(se) == site.lvl and not olr_protected.is_protected_monster(se)
		then
			local sec = se:section_name()
			local ok = false
			for _, prefix in ipairs(species) do
				if string.sub(sec, 1, #prefix) == prefix then ok = true end
			end
			local d = ok and se.position:distance_to(pos)
			if d and d <= c.carrion_radius and d > 15 then table.insert(out, { se = se, d = d }) end
		end
	end
	table.sort(out, function(a, b) return a.d < b.d end)
	return out
end

local function feed_site(cs, site, when, forced)
	local c = config()
	local want = math.min(c.carrion_max, c.scavenge_max + math.floor(math.max(0, site.w - 2) / 2))
	local pool = carrion_pool(site, when)
	local pos = site_pos(site)
	-- they stay to feed for carrion_stay_h whatever the hour (a night move would otherwise go home at the first daylight tick)
	local back_at = now() + c.carrion_stay_h * 3600
	local moved = 0
	for _, rec in ipairs(pool) do
		if moved >= want then break end
		olr_night.note_out(rec.se, "carrion", back_at)
		alife():teleport_object(rec.se.id, pos, site.lv, site.gv)
		moved = moved + 1
		rlog("carrion: %s id=%d comes %.0f m to the bodies on %s", rec.se:section_name(), rec.se.id, rec.d, site.lvl)
	end
	carrion_moves = carrion_moves + moved
	rlog("carrion on %s (%s%s): site weight %d, %.1f h old, %d scavengers in %d m, %d wanted, %d came", site.lvl, when, forced and ", forced" or "",
		site.w, ( now() - site.t ) / 3600, #pool, c.carrion_radius, want, moved)
	if moved == 0 then
		carrion_why.nobody_near = ( carrion_why.nobody_near or 0 ) + 1
		return 0
	end
	site.fed = now()
	olr_digest.note("carrion", site.lvl, { pos = pos }) -- [HE-PORT]
	if c.carrion_spoils > 0 then
		for _, id in ipairs(site.ids) do cs.gnawed[tostring(id)] = now() end
	end
	if heard_here(site.lvl) and math.random(100) <= c.carrion_news_chance then
		say_line("olr_carrion_", nil, 0, { where = news_main.where_text(site.lvl, pos) })
	end
	return moved
end

-- the heaviest usable site on a level
local function feed_level(cs, lvl, when, forced)
	local camps = olr_night.camp_points(lvl)
	local best = nil
	for _, site in ipairs(cs.sites) do
		if site.lvl == lvl then
			local why = site_refusal(site, when, camps)
			if why then
				if not site.fed then carrion_why[why] = ( carrion_why[why] or 0 ) + 1 end
			elseif not best or site.w > best.w then
				best = site
			end
		end
	end
	if best then return feed_site(cs, best, when, forced) end
	if forced then rlog("carrion on %s: no usable site", lvl) end
	return 0
end

local function carrion_tick()
	local c = config()
	local cs = carrion_state()
	local n = now()
	local kept = {}
	for _, site in ipairs(cs.sites) do
		if n - site.t <= c.carrion_h * 3600 then table.insert(kept, site) end
	end
	cs.sites = kept
	for key, t in pairs(cs.gnawed) do
		if n - t > 72 * 3600 then cs.gnawed[key] = nil end
	end
	if olr_cfg.grace_active() then
		olr_store.put(CARRION_KEY, cs)
		return
	end
	local when = nil
	local h = level.get_time_hours()
	if is_night() then
		if n >= ( cs.next or 0 ) then
			cs.next = n + c.carrion_every_h * 3600
			when = "night"
		end
	elseif h >= 12 and h < 14 and cs.noon ~= level.get_time_days() then
		cs.noon = level.get_time_days()
		when = "day"
	end
	if when then
		olr_smart_index.ensure()
		for lvl in pairs(olr_smart_index.region_levels() or {}) do feed_level(cs, lvl, when) end
	end
	olr_store.put(CARRION_KEY, cs)
end

-- monster_parts harvest: a part from a body the scavengers reached comes out worse
function carrion_spoil(id, cond)
	if not ( db.actor and olr_cfg.on("carrion") ) then return cond end
	local out = cond
	local f = ( olr_store.get(FRESH_KEY) or {} )[tostring(id)]
	if type(f) == "table" and f.cap and out > f.cap then
		rlog("the body id=%d died offline, nobody cut it in time: part %.2f -> %.2f", id, out, f.cap)
		out = f.cap
	end
	if carrion_state().gnawed[tostring(id)] then
		local g = math.max(0.1, out - config().carrion_spoils)
		rlog("carrion: the body id=%d was gnawed, part %.2f -> %.2f", id, out, g)
		out = g
	end
	return out
end

function on_monster_death(monster)
	if monster and db.actor and olr_cfg.on("reactive") and olr_cfg.on("carrion") then note_carrion(alife():object(monster:id())) end
end

local function on_death(se, offline)
	if not ( se and db.actor and olr_cfg.on("reactive") ) then return end
	if olr_cfg.on("carrion") and se.id ~= db.actor:id() then note_carrion(se, offline) end
	if se.id == db.actor:id() or not IsStalker(se) then return end
	local sid = se:smart_terrain_id()
	local smart = sid ~= BAD_OBJ_ID and alife():object(sid)
	if not smart then
		rlog("death of %s id=%d: no smart, ignored", se:name(), se.id)
		return
	end
	local name = smart:name()
	olr_smart_index.ensure()
	local st = get_state()
	if olr_cfg.on("investigate") then note_investigate(st, name, se:community()) end
	if olr_cfg.on("scavenge") and not olr_cfg.on("carrion") then note_scavenge(st, name, se, olr_smart_index.get_level(name)) end
	put_state(st)
end

function on_npc_death(npc)
	if npc then on_death(alife():object(npc:id())) end
end

function on_offline_death(victim)
	on_death(victim, true)
end

-- ---------------------------------------------------------------------------
-- gossip: olr_smart_index.attach_to reports every move between levels
-- ---------------------------------------------------------------------------
function on_move(se, smart_name, from)
	if not ( db.actor and IsStalker(se) and olr_cfg.on("reactive") and olr_cfg.on("gossip") ) then return end
	olr_smart_index.ensure()
	local to = olr_smart_index.get_level(smart_name)
	if not to or to == from or olr_trader_runs.on_run(se.id) then return end
	local comm = se:community()
	comm = GOSSIP_GROUP[comm] or comm
	if not GOSSIP_KINDS[comm] then return end
	local region = olr_smart_index.region_levels()
	if not ( region and ( region[to] or region[from or ""] ) ) or not he_pda_model.get_pda() then return end
	local st = get_state()
	local n = now()
	if n < ( st.gossip_next or 0 ) then return end
	if math.random(100) > config().gossip_chance then return end
	st.gossip_next = n + config().gossip_cd_h * 3600
	put_state(st)
	local smart = olr_smart_index.get_obj(smart_name)
	local key = say_line("olr_gossip_" .. comm .. "_", nil, 0, { where = smart and where_of(smart) or "" })
	rlog("gossip %s: %s %s -> %s, line %s", comm, se:name(), tostring(from), to, tostring(key))
end

-- ---------------------------------------------------------------------------
-- chapter change: a wave on the net, and at the end the north opens
-- ---------------------------------------------------------------------------
local function send_expedition()
	local sim = alife()
	local sent, seen, no_target = 0, 0, 0
	for _, id in ipairs(olr_offline_task.cached_stalkers("stalker")) do
		if sent >= config().expedition_size then break end
		local se = sim:object(id)
		local here = se and IsStalker(se) and se:alive() and olr_smart_index.object_level(se)
		if ( here == "l05_bar" or here == "l07_military" ) and olr_trader_runs.may_travel(se) then
			seen = seen + 1
			local target = olr_smart_index.pick_name("stalker", nil, nil, { l10_radar = true }, { no_territory = true, rank = se:rank() })
			if target and olr_smart_index.attach_checked(se, target) then
				sent = sent + 1
				rlog("expedition: %s id=%d rank=%d from %s to %s", se:name(), id, se:rank(), here, target)
			else
				no_target = no_target + 1
			end
		end
	end
	rlog("expedition to Radar: %d sent, %d could go, %d found no open smart there", sent, seen, no_target)
end

local function chapter_wave(ch, max_lines)
	local prefix = "olr_chapter_" .. ch .. "_"
	local n = olr_trader_runs.line_total(prefix)
	rlog("chapter %d: wave of %d lines available", ch, n)
	if n > 0 and he_pda_model.get_pda() then
		local first = math.random(n)
		for i = 0, math.min(n, max_lines or WAVE_LINES) - 1 do
			say(prefix .. ( ( first + i - 1 ) % n + 1 ), olr_trader_runs.other_name(), i * WAVE_GAP)
		end
	end
end

-- the world side of chapter 4: the north opens to OLR humans, and the first of them set off
local function open_north()
	olr_cfg.set_flag("north_open")
	send_expedition()
end

-- the coma at the X-6 exit is over: war_zone_sleeps is set when it starts, magic_sleep is true while it lasts
local function coma_over()
	return has_alife_info("war_zone_sleeps") and not ( sleep_manager and sleep_manager.magic_sleep )
end

-- can a PDA line be seen right now? Mirrors he_pda_news.available(), plus the blowout block of sak.send_tip
local function pda_can_receive()
	if not db.actor then return false end
	if db.actor:has_info("pda_is_broken") or db.actor:has_info("pda_will_be_broken") then return false end
	local pda = he_pda_model.get_pda()
	if not pda or pda:condition() <= 0 then return false end
	if pda_battery.is_charging() or db.blowout_active == true then return false end
	if sleep_manager.is_sleep_active() or db.actor:is_talking() then return false end
	if he_pda_access.is_busy() then return false end
	if sivol_pda.reception_blocked() then return false end
	return true
end

-- game seconds from [reactive] news_delay_N = min,max (hours); no line means no delay
local function news_delay(ch)
	local lo, hi = string.match(tostring(config()["news_delay_" .. ch] or ""), "([%d%.]+)%s*,%s*([%d%.]+)")
	lo, hi = tonumber(lo) or 0, tonumber(hi) or 0
	return ( lo + math.random() * ( hi - lo ) ) * 3600
end

-- a story point was reached: the news follows later, as gossip does. Chapter 4 waits for the end of the coma.
local function schedule_wave(st, ch)
	if ch == 4 and not coma_over() then
		st.pending[ch] = { wait_coma = true }
		rlog("chapter %d reached, the wave waits for the end of the coma", ch)
		return
	end
	local delay = news_delay(ch)
	st.pending[ch] = { due = now() + delay }
	rlog("chapter %d reached, wave in %.1f h", ch, delay / 3600)
end

local function later_wave_due(st, ch)
	for k = ch + 1, 4 do
		local rec = st.pending[k]
		if rec and not rec.wait_coma and now() >= rec.due then return true end
	end
	return false
end

local function run_pending(st)
	local c = config()
	for ch = 1, 4 do
		local rec = st.pending[ch]
		if rec and rec.wait_coma and coma_over() then
			local delay = news_delay(ch)
			rec.wait_coma = nil
			rec.due = now() + delay
			rlog("chapter %d: the coma is over, wave in %.1f h", ch, delay / 3600)
		end
		if rec and not rec.wait_coma and now() >= rec.due then
			if ch == 4 and not rec.world then
				rec.world = true
				open_north()
			end
			if later_wave_due(st, ch) then
				rlog("chapter %d: wave dropped, a later one is due", ch)
				st.pending[ch] = nil
			elseif pda_can_receive() then
				local late_h = ( now() - rec.due ) / 3600
				local lines = ( c.news_late_h and late_h >= c.news_late_h ) and ( c.news_late_lines or WAVE_LINES ) or WAVE_LINES
				rlog("chapter %d: wave goes out, %.1f h after its time, %d lines at most", ch, late_h, lines)
				chapter_wave(ch, lines)
				st.pending[ch] = nil
			end
		end
	end
end

local function chapter_tick(st)
	local ch = olr_cfg.chapter()
	st.pending = st.pending or {}
	if st.chapter == nil then
		st.chapter = ch
		rlog("chapter on record: %d", ch)
	end
	if ch < st.chapter then
		-- the lever of an earlier build counted as chapter 4; now it needs the coma too
		rlog("chapter fell from %d to %d, record reset", st.chapter, ch)
		for k in pairs(st.pending) do
			if k > ch then st.pending[k] = nil end
		end
		st.chapter = ch
	end
	if ch > st.chapter then
		for i = st.chapter + 1, ch do schedule_wave(st, i) end
		st.chapter = ch
	end
	run_pending(st)
	-- a save that was past chapter 4 before the north flag existed has nothing pending for it: open the north now
	if ch >= 4 and not st.pending[4] and not olr_cfg.flag_is_set("north_open") then
		olr_cfg.set_flag("north_open")
		rlog("chapter 4 already behind this save: the north is open")
	end
end

-- ---------------------------------------------------------------------------
-- the Scorcher takes the careless: a real loner says he is going, then falls silent
-- ---------------------------------------------------------------------------
local function schedule_scorcher(st, hours)
	st.scorch_next = now() + hours * 3600
end

local function scorcher_start(st)
	local sim = alife()
	for _, id in ipairs(olr_offline_task.cached_stalkers("stalker")) do
		local se = sim:object(id)
		if se and IsStalker(se) and se:alive() and olr_smart_index.object_level(se) == "l07_military" and olr_trader_runs.may_travel(se) then
			local c = config()
			local who = olr_trader_runs.display_name(se)
			st.scorch = { id = id, who = who, due = now() + math.random(c.scorcher_delay_min_h, c.scorcher_delay_max_h) * 3600 }
			say_line("olr_scorcher_go_", who)
			rlog("scorcher: %s id=%d (%s) sets off, lost in %.1f h", se:name(), id, who, ( st.scorch.due - now() ) / 3600)
			return true
		end
	end
	rlog("scorcher: nobody eligible on Military")
	return false
end

local function scorcher_lost(st)
	local rec = st.scorch
	local sim = alife()
	local se = sim:object(rec.id)
	if not ( se and IsStalker(se) and se:alive() ) then
		rlog("scorcher: %s died first, no message", rec.who)
		st.scorch = nil
		return
	end
	if se.online then
		rlog("scorcher: %s is online, waiting", rec.who)
		return
	end
	local name = olr_smart_index.any_on_level("l10_radar")
	local smart = name and olr_smart_index.get_obj(name)
	sim:release(se, true)
	if smart then
		local obj = sim:create("stalker_fresh_zombied", smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id)
		if obj then
			local pk = get_netpk(obj)
			local data = pk:get()
			data.custom_data = "[smart_terrains]\n" .. name .. " = true\n"
			pk:set(data)
		end
		rlog("scorcher: %s is lost, zombied id=%s at %s", rec.who, tostring(obj and obj.id), name)
	else
		rlog("scorcher: %s is lost, no Radar smart for the zombied", rec.who)
	end
	st.scorch = nil
	say_line("olr_scorcher_lost_", nil, 0, { name = rec.who })
end

local function scorcher_tick(st)
	if olr_cfg.chapter() >= 4 then
		-- the Scorcher is off: nobody is lost to it now, and a message sent during the coma would be dropped anyway
		if st.scorch then
			rlog("scorcher: %s was on the way, the Scorcher fell first, no message", st.scorch.who)
			st.scorch = nil
		end
		return
	end
	if st.scorch then
		if now() >= st.scorch.due then scorcher_lost(st) end
		return
	end
	local c = config()
	if not st.scorch_next then
		schedule_scorcher(st, math.random(c.scorcher_min_h, c.scorcher_max_h))
		rlog("scorcher: first one in %.1f h", ( st.scorch_next - now() ) / 3600)
		return
	end
	if now() < st.scorch_next then return end
	if scorcher_start(st) then
		schedule_scorcher(st, math.random(c.scorcher_min_h, c.scorcher_max_h))
	else
		schedule_scorcher(st, 12)
	end
end

function update()
	if not ( db.actor and olr_cfg.on("reactive") ) then return end
	local st = get_state()
	if olr_cfg.on("chapter_events") then chapter_tick(st) end
	if olr_cfg.on("scorcher_losses") then scorcher_tick(st) end
	put_state(st)
	if olr_cfg.on("carrion") then carrion_tick() end
end

-- ---------------------------------------------------------------------------
-- test helpers
-- ---------------------------------------------------------------------------
function report()
	local st = get_state()
	local n = now()
	rlog("on=%s investigate=%s scavenge=%s gossip=%s chapter_events=%s scorcher=%s night=%s", tostring(olr_cfg.on("reactive")), tostring(olr_cfg.on("investigate")),
		tostring(olr_cfg.on("scavenge")), tostring(olr_cfg.on("gossip")), tostring(olr_cfg.on("chapter_events")), tostring(olr_cfg.on("scorcher_losses")), tostring(is_night()))
	rlog("chapter on record %s, now %d; next investigate in %.1f h; next gossip in %.1f h; next scorcher in %.1f h", tostring(st.chapter), olr_cfg.chapter(),
		( ( st.inv_next or n ) - n ) / 3600, ( ( st.gossip_next or n ) - n ) / 3600, ( ( st.scorch_next or n ) - n ) / 3600)
	rlog("coma over %s, north_open %s", tostring(coma_over()), tostring(olr_cfg.flag_is_set("north_open")))
	for ch, rec in pairs(st.pending or {}) do
		if rec.wait_coma then
			rlog("pending chapter %d: waits for the end of the coma", ch)
		else
			rlog("pending chapter %d: due in %.1f h, world done %s", ch, ( rec.due - n ) / 3600, tostring(rec.world == true))
		end
	end
	for key, rec in pairs(st.deaths) do
		rlog("deaths %s: %d, %.1f h ago", key, rec.c, ( n - rec.t ) / 3600)
	end
	if st.scorch then rlog("scorcher pending: %s id=%d, lost in %.1f h", st.scorch.who, st.scorch.id, ( st.scorch.due - n ) / 3600) end
end

function carrion()
	local cs = carrion_state()
	local n = now()
	local why = {}
	for k, v in pairs(carrion_why) do table.insert(why, k .. "=" .. v) end
	local gn = 0
	for _ in pairs(cs.gnawed) do gn = gn + 1 end
	rlog("carrion on=%s spoils=%.2f: %d sites, %d gnawed bodies, %d moves this session, next night pass in %.1f h; refused %s",
		tostring(olr_cfg.on("carrion")), config().carrion_spoils, #cs.sites, gn, carrion_moves, ( ( cs.next or n ) - n ) / 3600, table.concat(why, " "))
	local camps = {}
	for _, site in ipairs(cs.sites) do
		camps[site.lvl] = camps[site.lvl] or olr_night.camp_points(site.lvl)
		rlog("  %s %.0f,%.0f weight %d, %.1f h old, %d mutant bodies%s: %s", site.lvl, site.x, site.z, site.w, ( n - site.t ) / 3600, #site.ids,
			site.fed and string.format(", fed %.1f h ago", ( n - site.fed ) / 3600) or "", site_refusal(site, is_night() and "night" or "day", camps[site.lvl]) or "usable")
	end
	for key in pairs(cs.gnawed) do rlog("  gnawed body id=%s", key) end
end

function force_carrion(lvl)
	olr_smart_index.ensure()
	local cs = carrion_state()
	feed_level(cs, lvl or level.name(), "night", true)
	olr_store.put(CARRION_KEY, cs)
end

function force_investigate(name, comm)
	send_group(name, comm or "stalker")
end

function force_scavenge(name)
	olr_smart_index.ensure()
	local smart = olr_smart_index.get_obj(name)
	if not smart then
		rlog("force_scavenge: no smart %s", tostring(name))
		return
	end
	drift_to(smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id, olr_smart_index.get_level(name))
end

function force_gossip(comm)
	local key = say_line("olr_gossip_" .. ( comm or "stalker" ) .. "_", nil, 0, { where = news_main.where_text(level.name(), db.actor:position()) })
	rlog("force_gossip: line %s", tostring(key))
end

function force_chapter(ch)
	chapter_wave(ch)
	if ch == 4 then open_north() end
end

-- fl olr_reactive.force_due(4): the pending wave of that chapter is due now (and the coma counts as over)
function force_due(ch)
	local st = get_state()
	st.pending = st.pending or {}
	local rec = st.pending[ch]
	if not rec then
		rlog("force_due: nothing pending for chapter %d", ch)
		return
	end
	rec.wait_coma = nil
	rec.due = now()
	put_state(st)
	rlog("force_due: chapter %d is due now", ch)
end

-- fl olr_reactive.force_pending(3): schedule a wave as if the chapter had just been reached
function force_pending(ch)
	local st = get_state()
	st.pending = st.pending or {}
	schedule_wave(st, ch)
	put_state(st)
end

function force_scorcher()
	local st = get_state()
	scorcher_start(st)
	put_state(st)
end

function scorcher_finish()
	local st = get_state()
	if st.scorch then
		st.scorch.due = 0
		scorcher_lost(st)
		put_state(st)
	else
		rlog("scorcher_finish: nobody on the way")
	end
end
