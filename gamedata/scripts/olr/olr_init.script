-- [HE-PORT]

-- [HE-PORT] olr_store: the live tables back into the save store
function store_flush()
	local t0 = time_global()
	local n = olr_store.flush()
	log2("[olr_init] save: %d OLR tables written to the store in %d ms", n, time_global() - t0)
end

function prime_stalker_cache()
	timed("prime_cache", olr_offline_task.prime_cache)
end

