local initialized = false

local function timed(name, fn, arg)
	local timer = profile_timer()
	timer:start()
	fn(arg)
	timer:stop()
	local ms = timer:time() / 1000
	if ms >= 15 and olr_cfg.log_census() then
		log2("[olr_perf] %s %.1f ms", name, ms)
	end
end

function attach(sm)
	if initialized then return end
	initialized = true

	if olr_timers and olr_timers.upd then
		sm:subscribe({ signal = "on_update", fun = this.upd_timers })
	end

	if olr_offline_walk and olr_offline_walk.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_offline_walk })
	end

	if olr_monsters_sim and olr_monsters_sim.sim_location_traveling then
		sm:subscribe({ signal = "on_update", fun = this.upd_location_traveling })
	end

	if olr_squads and olr_squads.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_squads })
	end

	if olr_raids and olr_raids.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_raids })
	end

	if olr_monster_squads and olr_monster_squads.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_monster_squads })
	end

	if olr_online_depart and olr_online_depart.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_online_depart })
	end

	if olr_monsters_sim and olr_monsters_sim.sim_kill_stalkers then
		sm:subscribe({ signal = "on_first_update", fun = this.sim_kill_stalkers_once })
	end

	-- [HE-PORT]
	if olr_offline_task and olr_offline_task.roam_update then
		sm:subscribe({ signal = "on_update", fun = this.upd_faction_roam })
	end

	-- [HE-PORT]
	if olr_squads and olr_squads.roam_update then
		sm:subscribe({ signal = "on_update", fun = this.upd_squad_roam })
	end

	-- [HE-PORT]
	if olr_relations and olr_relations.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_relations })
	end

	-- [HE-PORT]
	if olr_relations and olr_relations.on_npc_hit then
		sm:subscribe({ signal = "on_npc_hit", fun = olr_relations.on_npc_hit })
	end

	-- [HE-PORT]
	if olr_relations and olr_relations.on_npc_death then
		sm:subscribe({ signal = "on_npc_death", fun = olr_relations.on_npc_death })
	end

	-- [HE-PORT]
	if olr_post_watch and olr_post_watch.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_post_watch })
	end

	-- [HE-PORT]
	if olr_offline_task and olr_offline_task.prime_cache then
		sm:subscribe({ signal = "on_first_update", fun = this.prime_stalker_cache })
		sm:subscribe({ signal = "on_update", fun = this.upd_stalker_cache })
	end

	-- [HE-PORT]
	if olr_offline_task and olr_offline_task.monster_level_sweep then
		sm:subscribe({ signal = "on_update", fun = this.upd_monster_level_sweep })
	end

	-- [HE-PORT]
	if olr_offline_task and olr_offline_task.danger_sweep then
		sm:subscribe({ signal = "on_update", fun = this.upd_danger_sweep })
	end

	if olr_trader_runs and olr_trader_runs.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_trader_runs })
	end

	if olr_offline_hunts then
		sm:subscribe({ signal = "on_update", fun = this.upd_hunts })
	end

	if olr_patrols then
		sm:subscribe({ signal = "on_update", fun = this.upd_patrols })
		sm:subscribe({ signal = "on_npc_death", fun = olr_patrols.on_npc_death })
	end

	if olr_night then
		sm:subscribe({ signal = "on_update", fun = this.upd_night })
	end

	if olr_steering then
		sm:subscribe({ signal = "on_update", fun = this.upd_steering })
	end

	if olr_amk_offline then
		sm:subscribe({ signal = "on_update", fun = this.upd_amk_roads })
	end

	if olr_population then
		sm:subscribe({ signal = "on_update", fun = this.upd_population })
		sm:subscribe({ signal = "on_first_update", fun = olr_population.on_first_update })
		sm:subscribe({ signal = "on_npc_before_hit", fun = olr_population.on_npc_before_hit })
	end

	if olr_lab_giants then
		sm:subscribe({ signal = "on_update", fun = this.upd_lab_giants })
	end

	if olr_underground then
		sm:subscribe({ signal = "on_update", fun = this.upd_underground })
	end

	if olr_glut then
		sm:subscribe({ signal = "on_trade", fun = olr_glut.on_trade })
	end

	if olr_alpha then
		sm:subscribe({ signal = "on_update", fun = this.upd_alpha })
		sm:subscribe({ signal = "on_npc_death", fun = olr_alpha.on_npc_death })
		sm:subscribe({ signal = "on_monster_death", fun = olr_alpha.on_monster_death })
		sm:subscribe({ signal = "on_monster_before_hit", fun = olr_alpha.on_monster_before_hit })
		sm:subscribe({ signal = "on_actor_before_hit", fun = olr_alpha.on_actor_before_hit })
		sm:subscribe({ signal = "on_npc_before_hit", fun = olr_alpha.on_npc_before_hit })
	end

	if olr_reactive then
		sm:subscribe({ signal = "on_update", fun = this.upd_reactive })
		sm:subscribe({ signal = "on_npc_death", fun = olr_reactive.on_npc_death })
	end

	if olr_camp_law then
		sm:subscribe({ signal = "on_npc_before_hit", fun = olr_camp_law.on_npc_before_hit })
		sm:subscribe({ signal = "on_npc_death", fun = olr_camp_law.on_npc_death })
	end

	if olr_offline_task and olr_offline_task.old_save_sweep then
		sm:subscribe({ signal = "on_first_update", fun = olr_offline_task.old_save_sweep })
	end

	if olr_census and olr_census.on_first_update then
		sm:subscribe({ signal = "on_first_update", fun = olr_census.on_first_update })
	end
end

function upd_hunts(delta)
	ogse_signals.get_mgr():reschedule(30000)
	timed("hunts", olr_offline_hunts.update)
end

function upd_patrols(delta)
	ogse_signals.get_mgr():reschedule(15000)
	timed("patrols", olr_patrols.update)
end

function upd_night(delta)
	ogse_signals.get_mgr():reschedule(20000)
	timed("night", olr_night.update)
end

function upd_steering(delta)
	ogse_signals.get_mgr():reschedule(60000)
	timed("steering", olr_steering.update)
end

function upd_amk_roads(delta)
	ogse_signals.get_mgr():reschedule(10000)
	timed("amk_roads", olr_amk_offline.roads_update)
end

function upd_population(delta)
