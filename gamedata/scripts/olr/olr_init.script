local initialized = false

function attach(sm)
	if initialized then return end
	initialized = true

	if olr_timers and olr_timers.upd then
		sm:subscribe({ signal = "on_update", fun = this.upd_timers })
	end

	if olr_offline_walk and olr_offline_walk.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_offline_walk })
	end

	if olr_monsters_sim and olr_monsters_sim.sim_location_traveling then
		sm:subscribe({ signal = "on_update", fun = this.upd_location_traveling })
	end

	if olr_squads and olr_squads.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_squads })
	end

	if olr_raids and olr_raids.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_raids })
	end

	if olr_monster_squads and olr_monster_squads.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_monster_squads })
	end

	if olr_online_depart and olr_online_depart.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_online_depart })
	end

	if olr_monsters_sim and olr_monsters_sim.sim_kill_stalkers then
		sm:subscribe({ signal = "on_first_update", fun = this.sim_kill_stalkers_once })
	end

	-- [HE-PORT]
	if olr_offline_task and olr_offline_task.roam_update then
		sm:subscribe({ signal = "on_update", fun = this.upd_faction_roam })
	end

	-- [HE-PORT]
	if olr_squads and olr_squads.roam_update then
		sm:subscribe({ signal = "on_update", fun = this.upd_squad_roam })
	end

	-- [HE-PORT]
	if olr_relations and olr_relations.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_relations })
	end

	-- [HE-PORT]
	if olr_post_watch and olr_post_watch.update then
		sm:subscribe({ signal = "on_update", fun = this.upd_post_watch })
	end
end

-- [HE-PORT]
function upd_post_watch(delta)
	ogse_signals.get_mgr():reschedule(10000)
	olr_post_watch.update()
end

-- [HE-PORT]
function upd_relations(delta)
	ogse_signals.get_mgr():reschedule(3000)
	olr_relations.update()
end

-- [HE-PORT]
function upd_squad_roam(delta)
	ogse_signals.get_mgr():reschedule(15000)
	olr_squads.roam_update()
end

-- [HE-PORT]
function upd_faction_roam(delta)
	ogse_signals.get_mgr():reschedule(10000)
	olr_offline_task.roam_update()
end

function upd_timers(delta)
	ogse_signals.get_mgr():reschedule(1000)
	olr_timers.upd()
end

function upd_offline_walk(delta)
	ogse_signals.get_mgr():reschedule(1000)
	olr_offline_walk.update(delta)
end

function upd_location_traveling(delta)
	ogse_signals.get_mgr():reschedule(5000)
	olr_monsters_sim.sim_location_traveling()
end

function upd_squads(delta)
	ogse_signals.get_mgr():reschedule(3000)
	olr_squads.update()
end

function upd_raids(delta)
	ogse_signals.get_mgr():reschedule(5000)
	olr_raids.update()
end

function upd_monster_squads(delta)
	ogse_signals.get_mgr():reschedule(3000)
	olr_monster_squads.update()
end

function upd_online_depart(delta)
	ogse_signals.get_mgr():reschedule(2000)
	olr_online_depart.update()
end

function sim_kill_stalkers_once()
	if db.actor then
		olr_monsters_sim.sim_kill_stalkers()
	end
end
