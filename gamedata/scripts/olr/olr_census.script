-- [HE-PORT] read-only population count per level, docs/ALIFE_DESIGN.md Phase 0
-- Everything goes to xray.log with the [olr_census] tag.
-- fl olr_census.report()                 every level, one block each
-- fl olr_census.report("l01_escape")     one level, also names everyone breaking its preset
-- fl olr_census.near(60)                 everyone within 60 m and who spawned them
-- fl olr_census.objects()                 all objects, what NPCs carry, for save growth on a long game
-- fl olr_census.gates("l10_radar")       which smarts OLR could pick there right now, per community
-- fl olr_census.fauna_roll("esc_rats1")  1000 rolls of what that respawner would spawn
-- fl olr_census.respawners("l01_escape") timers of the level's creature respawners
-- fl olr_census.npc(3880)                why an NPC behaves as it does: enemy, weapon, ammo, restrictors
-- fl olr_census.budgets()                chapter, OLR budgets and respawner ceilings per level
-- fl olr_census.tick(5)                  runs 5 OLR spawn ticks now and lists what appeared (adds population, use a test save)
-- fl olr_census.kit()                    for testers: census, steering, respawn rules, lab giants, parties, runs, hunts, night, underground

local RANK_BANDS = { "novice", "experienced", "veteran", "master" }
local GATE_COMMS = { "stalker", "bandit", "dolg", "freedom", "ecolog", "killer", "military", "monolith", "zombied", "dog", "boar", "snork", "bloodsucker", "burer" }

local function new_row()
	return {
		humans = 0, monsters = 0,
		smartless_h = 0, smartless_m = 0,
		dormant_h = 0, dormant_m = 0,
		comm = {}, species = {},
		origin_h = {}, origin_m = {},
		broken_olr = 0, broken_other = 0, broken = {},
	}
end

local function add(t, k)
	t[k] = (t[k] or 0) + 1
end

local function joined(t)
	local keys = {}
	for k in pairs(t) do table.insert(keys, k) end
	table.sort(keys)
	for i = 1, #keys do
		keys[i] = keys[i] .. "=" .. t[keys[i]]
	end
	return table.concat(keys, " ")
end

local function any_smart()
	for _, smart in pairs(smart_terrain.get_registry_by_name()) do
		return smart
	end
	return nil
end

-- id of a spawned creature -> name of its respawner
local function respawner_ids(sim)
	local ids = {}
	for _, se in sim:objects() do
		local list = se.spawned_obj
		if list then
			for _, id in pairs(list) do ids[id] = se.amk_name or se:name() end
		end
	end
	return ids
end

-- exists in alife, but its [spawner] cond or gulag job keeps it from ever coming online now
local function is_dormant(se, human)
	if se.get_job_online and se:get_job_online() == false then return true end
	if human then
		if se.dont_spawn_online == true then return true end
		return se.spawner ~= nil and db.actor ~= nil
			and xr_logic.pick_section_from_condlist(db.actor, se, se.spawner) == nil
	end
	return xr_spawner.check_spawn(se) == false
end

-- [HE-PORT] olr_population counts the same way
function is_dormant_creature(se, human)
	return is_dormant(se, human)
end

local function human_origin(se, from_respawner)
	local section = se:section_name()
	if olr_squads.is_spawned(se.id) then
		if string.sub(section, 1, 13) == "olr_monolith_" then return "olr_monolith" end
		return "olr_squad"
	end
	-- an olr_ section nobody tracks can only be a raid
	if string.sub(section, 1, 4) == "olr_" then return "olr_raid" end
	if from_respawner then return "respawner" end
	return "other"
end

local function monster_origin(se, from_respawner)
	if olr_monster_squads.is_spawned(se.id) then return "olr_squad" end
	if from_respawner then return "respawner" end
	return "other"
end

local function origin_of(se, human, from_respawner)
	if human then return human_origin(se, from_respawner) end
	return monster_origin(se, from_respawner)
end

-- rats share the tushkano class, but the presets list them apart
local function community_of(probe, se)
	if string.sub(se:section_name(), 1, 4) == "rat_" then return "rat" end
	return probe:get_obj_community(se)
end

local function is_creature(se)
	local human = IsStalker(se)
	return (human or IsMonster(se)) and se.id ~= 0 and se:alive(), human
end

local function collect()
	local sim = alife()
	local probe = any_smart()
	if not (sim and probe) then return nil end
	local from_respawner = respawner_ids(sim)
	local rows = {}
	for _, se in sim:objects() do
		local creature, human = is_creature(se)
		if creature then
			local lname = olr_smart_index.object_level(se) or "?"
			local row = rows[lname]
			if not row then
				row = new_row()
				rows[lname] = row
			end
			local comm = community_of(probe, se)
			local smartless = se:smart_terrain_id() == BAD_OBJ_ID
			local dormant = is_dormant(se, human)
			local origin = origin_of(se, human, from_respawner[se.id])
			if human then
				row.humans = row.humans + 1
				if smartless then row.smartless_h = row.smartless_h + 1 end
				if dormant then row.dormant_h = row.dormant_h + 1 end
				local band = ranks.get_obj_rank_name(se) or "?"
				row.comm[comm] = row.comm[comm] or {}
				add(row.comm[comm], band)
				if dormant then add(row.comm[comm], "dormant") end
				add(row.origin_h, origin)
			else
				row.monsters = row.monsters + 1
				if smartless then row.smartless_m = row.smartless_m + 1 end
				if dormant then row.dormant_m = row.dormant_m + 1 end
				add(row.species, comm or se:section_name())
				add(row.origin_m, origin)
			end
			if comm and comm ~= "trader" and not probe:check_preset(comm, se:rank(), lname) then
				if string.sub(origin, 1, 3) == "olr" then
					row.broken_olr = row.broken_olr + 1
				elseif not dormant then
					row.broken_other = row.broken_other + 1
				end
				local resp = from_respawner[se.id]
				table.insert(row.broken, string.format("%s %s rank=%d %s%s%s", se:name(), tostring(comm), se:rank(), origin,
					resp and ("(" .. resp .. ")") or "", dormant and " dormant" or ""))
			end
		end
	end
	return rows
end

local function print_row(lname, row, verbose)
	log2("[olr_census] %s: humans=%d dormant=%d smartless=%d monsters=%d dormant=%d smartless=%d broken_preset olr=%d other=%d",
		lname, row.humans, row.dormant_h, row.smartless_h, row.monsters, row.dormant_m, row.smartless_m, row.broken_olr, row.broken_other)
	local comms = {}
	for comm in pairs(row.comm) do table.insert(comms, comm) end
	table.sort(comms)
	for i = 1, #comms do
		local parts = {}
		for _, band in ipairs(RANK_BANDS) do
			local n = row.comm[comms[i]][band]
			if n then table.insert(parts, band .. "=" .. n) end
		end
		if row.comm[comms[i]].dormant then table.insert(parts, "of_them_dormant=" .. row.comm[comms[i]].dormant) end
		log2("[olr_census]   %s: %s", comms[i], table.concat(parts, " "))
	end
	if row.humans > 0 then log2("[olr_census]   human origin: %s", joined(row.origin_h)) end
	if row.monsters > 0 then
		log2("[olr_census]   monsters: %s", joined(row.species))
		log2("[olr_census]   monster origin: %s", joined(row.origin_m))
	end
	if verbose then
		for i = 1, #row.broken do
			log2("[olr_census]   broken: %s", row.broken[i])
		end
	end
end

local function totals(rows)
	local t = new_row()
	for _, row in pairs(rows) do
		t.humans = t.humans + row.humans
		t.monsters = t.monsters + row.monsters
		t.dormant_h = t.dormant_h + row.dormant_h
		t.dormant_m = t.dormant_m + row.dormant_m
		t.broken_olr = t.broken_olr + row.broken_olr
		t.broken_other = t.broken_other + row.broken_other
		for k, n in pairs(row.origin_h) do t.origin_h[k] = (t.origin_h[k] or 0) + n end
		for k, n in pairs(row.origin_m) do t.origin_m[k] = (t.origin_m[k] or 0) + n end
	end
	return t
end

local function summary_line(t)
	return string.format("preset=%s humans=%d dormant=%d monsters=%d dormant=%d broken_preset olr=%d other=%d | humans: %s | monsters: %s",
		olr_cfg.preset_name(), t.humans, t.dormant_h, t.monsters, t.dormant_m, t.broken_olr, t.broken_other, joined(t.origin_h), joined(t.origin_m))
end

local function news(text)
	if db.actor then
		db.actor:give_game_news(text, "ui\\ui_iconsTotal", Frect():set(0, 0, 83, 47), 0, 15000)
	end
end

function report(level_name)
	local rows = collect()
	if not rows then return end
	if level_name then
		local row = rows[level_name]
		if row then
			print_row(level_name, row, true)
		else
			log2("[olr_census] %s: nobody alive", level_name)
		end
		return
	end
	local names = {}
	for lname in pairs(rows) do table.insert(names, lname) end
	table.sort(names)
	for i = 1, #names do
		print_row(names[i], rows[names[i]], false)
	end
	local line = summary_line(totals(rows))
	log2("[olr_census] TOTAL %s", line)
	news("olr_census: " .. line)
end

-- [HE-PORT] for olr_steering: active humans and monsters per level, without the dormant ones and vermin
function counts()
	local rows = collect()
	if not rows then return nil end
	local out = {}
	for lname, row in pairs(rows) do
		local vermin = ( row.species.rat or 0 ) + ( row.species.tushkano or 0 )
		out[lname] = { h = row.humans - row.dormant_h, m = row.monsters - row.dormant_m - vermin }
	end
	return out
end

-- [HE-PORT] one command for testers: the whole A-life picture in the log
function kit()
	log2("[olr_census] ===== kit: day %d %02d:%02d on %s =====", level.get_time_days(), level.get_time_hours(), level.get_time_minutes(), level.name())
	log2("[olr_census] preset=%s chapter=%d grace=%s", olr_cfg.preset_name(), olr_cfg.chapter(), tostring(olr_cfg.grace_active()))
	report()
	olr_steering.report()
	olr_population.report()
	olr_respawn_rules.report()
	olr_lab_giants.report()
	olr_patrols.report()
	olr_trader_runs.report()
	olr_trader_runs.parts_census()
	olr_offline_hunts.report()
	olr_alpha.report()
	olr_night.report()
	olr_underground.report()
	log2("[olr_census] ===== kit end =====")
end

function on_first_update()
	if not olr_cfg.log_census() then return end
	local rows = collect()
	if rows then
		log2("[olr_census] on load %s: %s", level.name(), summary_line(totals(rows)))
	end
end

function near(radius)
	radius = radius or 60
	local sim = alife()
	if not (sim and db.actor) then return end
	local probe = any_smart()
	local from_respawner = respawner_ids(sim)
	local here = level.name()
	local pos = db.actor:position()
	local out = {}
	for _, se in sim:objects() do
		local creature, human = is_creature(se)
		if creature and olr_smart_index.object_level(se) == here then
			local d = pos:distance_to(se.position)
			if d <= radius then
				table.insert(out, { d = d, se = se, human = human })
			end
		end
	end
	table.sort(out, function(a, b) return a.d < b.d end)
	log2("[olr_census] near %d m on %s: %d", radius, here, #out)
	for i = 1, #out do
		local se = out[i].se
		local resp = from_respawner[se.id]
		local sid = se:smart_terrain_id()
		local smart = sid ~= BAD_OBJ_ID and sim:object(sid)
		-- bound to another level and held offline: seen here, invisible in the world
		local elsewhere = smart and out[i].human and smart.level_name ~= here
		log2("[olr_census]   %3.0f m %s id=%d %s rank=%d origin=%s%s smart=%s online=%s%s",
			out[i].d, se:section_name(), se.id, tostring(community_of(probe, se)), se:rank(),
			origin_of(se, out[i].human, resp), resp and ("(" .. resp .. ")") or "", smart and smart:name() or "none", tostring(se.online),
			elsewhere and ( " BOUND_ELSEWHERE:" .. smart.level_name .. " can_online=" .. tostring(se:can_switch_online()) ) or "")
	end
end

function objects()
	local sim = alife()
	local total, carried, on_npc = 0, 0, 0
	local counts = {}
	for _, se in sim:objects() do
		total = total + 1
		if se.parent_id ~= BAD_OBJ_ID then
			carried = carried + 1
			local owner = sim:object(se.parent_id)
			if owner and IsStalker(owner) then
				on_npc = on_npc + 1
				local section = se:section_name()
				counts[section] = ( counts[section] or 0 ) + 1
			end
		end
	end
	local list = {}
	for section, n in pairs(counts) do table.insert(list, { s = section, n = n }) end
	table.sort(list, function(a, b) return a.n > b.n end)
	log2("[olr_census] objects: %d in all, %d carried, %d on stalkers", total, carried, on_npc)
	for i = 1, math.min(25, #list) do
		log2("[olr_census]   %5d %s", list[i].n, list[i].s)
	end
end

function gates(level_name)
	level_name = level_name or level.name()
	log2("[olr_census] gates %s (preset %s, closed to incoming humans: %s)", level_name, olr_cfg.preset_name(), tostring(olr_cfg.level_closed(level_name)))
	olr_smart_index.rebuild(true)
	for _, comm in ipairs(GATE_COMMS) do
		local open, shut = olr_smart_index.level_picks(comm, level_name)
		if #open > 0 or #shut > 0 then
			log2("[olr_census]   %s: open=%d [%s] story_shut=%d [%s]", comm, #open, table.concat(open, " "), #shut, table.concat(shut, " "))
		else
			log2("[olr_census]   %s: nothing", comm)
		end
	end
end

local function respawner_matches(se, name)
	return se.spawned_obj and (se.amk_name == name or se:name() == name)
end

function fauna_roll(name, count)
	count = count or 1000
	local found = false
	for _, se in alife():objects() do
		if respawner_matches(se, name) then
			found = true
			for _, entry in pairs(se.respawn_section) do
				local got = {}
				for i = 1, count do
					add(got, he_random_fauna.pick(se, entry.section))
				end
				log2("[olr_census] fauna %s: %s -> %s", name, entry.section, joined(got))
			end
		end
	end
	if not found then
		log2("[olr_census] fauna %s: no such respawner", name)
	end
end

-- [HE-PORT] debug marks on the PDA map of this level (or the level named):
-- fl olr_census.mark("stalker")   a community; "humans", "monsters", "trips" (out on a day trip), "watch" (road watch)
-- fl olr_census.mark("stalker", "all")  the same on every level (the PDA's global map shows the other levels)
-- fl olr_census.unmark()          removes them
-- green: loners, novices, ecologs; blue: Duty, Freedom; red: everyone else; yellow flag: mutants. The hint says who.
local marked = {}
local SPOT = { stalker = "green_location", green = "green_location", ecolog = "green_location", dolg = "blue_location",
	freedom = "blue_location" }

function unmark()
	for id, spot in pairs(marked) do level.map_remove_object_spot(id, spot) end
	marked = {}
end

function mark(what, lvl)
	unmark()
	lvl = lvl or level.name()
	what = what or "humans"
	local only = what == "trips" and olr_daytrips.out_ids() or what == "watch" and olr_roadwatch.watcher_ids() or nil
	local n = 0
	for _, se in alife():objects() do
		local human = IsStalker(se)
		local monster = not human and IsMonster(se)
		local here = olr_smart_index.object_level(se)
		if ( human or monster ) and se.id ~= 0 and se:alive() and ( lvl == "all" or here == lvl ) then
			local comm = human and se:community() or nil
			local hit
			if only then hit = only[se.id] == true
			elseif what == "humans" then hit = human
			elseif what == "monsters" then hit = monster
			else hit = comm == what end
			if hit then
				local spot = monster and "yellow_flag_location" or SPOT[comm] or "red_location"
				local sid = se:smart_terrain_id()
				local smart = sid and sid ~= BAD_OBJ_ID and alife():object(sid)
				local hint = string.format("%s id=%d %s, smart %s%s%s", se:name(), se.id, comm or se:section_name(),
					smart and smart:name() or "none", se.online and ", online" or "", lvl == "all" and ( ", " .. tostring(here) ) or "")
				level.map_add_object_spot_ser(se.id, spot, hint)
				marked[se.id] = spot
				n = n + 1
			end
		end
	end
	log2("[olr_census] mark %s on %s: %d on the PDA map (fl olr_census.unmark() removes them)", what, lvl, n)
end

-- [HE-PORT] where the Lua heap goes: every loaded script module's tables, by the number of entries reached under each
-- top-level field (shared tables are counted once, at the first field that reaches them). Heavy: a debug tool only.
-- fl olr_census.heap()      the 30 biggest module fields and the heap size
-- fl olr_census.heap(60)    the 60 biggest
heap_prev, heap_prev_kb, heap_shapes = nil, 0, nil

function heap(top)
	top = tonumber(top) or 30
	collectgarbage("collect")
	local kb = collectgarbage("count")
	local seen = {}
	local bytes = 0
	local function walk(t, depth)
		if seen[t] then return 0 end
		seen[t] = true
		local n = 0
		for k, v in pairs(t) do
			n = n + 1
			if type(v) == "string" then bytes = bytes + #v end
			if type(k) == "string" then bytes = bytes + #k end
			if type(v) == "table" and depth < 12 then n = n + walk(v, depth + 1) end
			if type(k) == "table" and depth < 12 then n = n + walk(k, depth + 1) end
		end
		return n
	end
	local function measure(v)
		bytes = 0
		local n = walk(v, 1)
		return n, bytes
	end
	-- the global namespace and the module tables themselves are not counted as fields
	seen[_G] = true
	local mods = {}
	for name, m in pairs(_G) do
		if type(m) == "table" and m ~= _G and not seen[m] then table.insert(mods, { name = name, m = m }) end
	end
	for _, rec in ipairs(mods) do seen[rec.m] = true end
	local rows = {}
	local getup = debug and debug.getupvalue
	for _, rec in ipairs(mods) do
		for k, v in pairs(rec.m) do
			if type(v) == "table" then
				local n, sb = measure(v)
				if n >= 200 or sb >= 100000 then table.insert(rows, { key = rec.name .. "." .. tostring(k), n = n, b = sb }) end
			elseif type(v) == "function" and getup then
				-- file-local tables (local cache = {}) are reached through the upvalues of the module's functions
				local i = 1
				while true do
					local uname, uv = getup(v, i)
					if not uname then break end
					if type(uv) == "table" then
						local n, sb = measure(uv)
						if n >= 200 or sb >= 100000 then table.insert(rows, { key = rec.name .. ".local " .. uname, n = n, b = sb }) end
					end
					i = i + 1
				end
			end
		end
	end
	-- what only the registry holds (luabind objects, engine callbacks, binders): walked after the modules, so what a
	-- module already reached is not counted again. Kind of each registry entry: its key type and value type.
	local reg = debug and debug.getregistry and debug.getregistry()
	if reg then
		local kinds = {}
		local cnt = 0
		for k, v in pairs(reg) do
			cnt = cnt + 1
			local kind = "reg " .. type(k) .. "->" .. type(v)
			if type(v) == "table" then
				local n2, sb = measure(v)
				local r = kinds[kind] or { n = 0, b = 0, c = 0 }
				r.n, r.b, r.c = r.n + n2, r.b + sb, r.c + 1
				kinds[kind] = r
			else
				local r = kinds[kind] or { n = 0, b = 0, c = 0 }
				r.c = r.c + 1
				kinds[kind] = r
			end
		end
		for kind, r in pairs(kinds) do
			table.insert(rows, { key = string.format("%s (%d registry slots)", kind, r.c), n = r.n + r.c, b = r.b })
		end
		log2("[olr_census] registry: %d slots", cnt)
		-- what the registry's tables are: by the string keys they hold (a class instance shows its fields), with
		-- the 12 most common shapes and their growth since the last call
		local shapes = {}
		for k, v in pairs(reg) do
			if type(k) == "number" and type(v) == "table" then
				local keys = {}
				for kk in pairs(v) do
					if type(kk) == "string" then table.insert(keys, kk) end
					if #keys >= 40 then break end
				end
				table.sort(keys)
				local sig = table.concat(keys, ",", 1, math.min(6, #keys))
				if sig == "" then sig = "(no string keys)" end
				shapes[sig] = ( shapes[sig] or 0 ) + 1
			end
		end
		local prev_shapes = heap_shapes or {}
		local list = {}
		for sig, c in pairs(shapes) do table.insert(list, { sig = sig, c = c, d = c - ( prev_shapes[sig] or 0 ) }) end
		table.sort(list, function(a, x) return a.d > x.d end)
		for i = 1, math.min(12, #list) do
			log2("[olr_census]   shape %6d %+6d  %s", list[i].c, heap_shapes and list[i].d or 0, string.sub(list[i].sig, 1, 150))
		end
		heap_shapes = shapes
	end
	-- growth since the previous call: the first call is the baseline (sorted by size), later ones sort by growth
	local first = heap_prev == nil
	local prev = heap_prev or {}
	local snap = {}
	for _, r in ipairs(rows) do
		local id = string.gsub(r.key, " %(%d+ registry slots%)", "")
		snap[id] = r.n
		r.d = r.n - ( prev[id] or 0 )
	end
	table.sort(rows, function(a, b)
		if first then return a.n > b.n end
		return a.d > b.d
	end)
	log2("[olr_census] heap: %.0f MB after a full collection (%s); %d module fields with 200+ entries or 100 KB of strings:",
		kb / 1024, first and "baseline" or string.format("%+.0f MB since the last heap()", ( kb - heap_prev_kb ) / 1024), #rows)
	heap_prev, heap_prev_kb = snap, kb
	log2("[olr_census]   %9s %9s %8s  %s", "entries", "growth", "str KB", "field")
	for i = 1, math.min(top, #rows) do
		local r = rows[i]
		log2("[olr_census]   %9d %+9d %8.0f  %s", r.n, first and 0 or r.d, r.b / 1024, r.key)
	end
end

-- [HE-PORT] fl olr_census.signals(): how many slots each ogse_signals signal holds, normal and scheduled, by the script
-- that subscribed them (quick timers record their creator in script_name). Subscribe and unsubscribe scan a queue
-- linearly, so a queue of tens of thousands makes every timer start and stop slow.
function signals(top)
	top = tonumber(top) or 20
	local mgr = ogse_signals.get_mgr()
	local rows = {}
	local total = 0
	for signal, t in pairs(mgr.signals or {}) do
		for _, qn in ipairs({ "normal", "scheduled" }) do
			local by = {}
			for _, slot in ipairs(t[qn] or {}) do
				local src = tostring(slot.script_name or "?")
				src = string.match(src, "([^/" .. string.char(92) .. "]+)$") or src
				if slot.unsubscribed then src = src .. " (unsubscribed)" end
				by[src] = ( by[src] or 0 ) + 1
				total = total + 1
			end
			for src, c in pairs(by) do table.insert(rows, { key = signal .. " " .. qn .. " " .. src, c = c }) end
		end
	end
	table.sort(rows, function(a, x) return a.c > x.c end)
	log2("[olr_census] signals: %d slots in all; the biggest groups:", total)
	for i = 1, math.min(top, #rows) do log2("[olr_census]   %7d  %s", rows[i].c, rows[i].key) end
end

-- [HE-PORT] fl olr_census.timers(): the quick timers (dsh.timeout and the like) the registry still holds, by the script
-- that created them, and whether they are finished; then memory after one and after a second full collection (a
-- luabind object's table is freed only one collection after its finalizer released it)
function timers(top)
	top = tonumber(top) or 20
	local reg = debug and debug.getregistry and debug.getregistry()
	if not reg then
		log2("[olr_census] timers: no debug.getregistry")
		return
	end
	collectgarbage("collect")
	local kb1 = collectgarbage("count")
	local by, total = {}, 0
	for k, v in pairs(reg) do
		if type(k) == "number" and type(v) == "table" and v.start_time ~= nil and v.sm ~= nil then
			local src = tostring(v.script_name or "?")
			src = string.match(src, "([^/" .. string.char(92) .. "]+)$") or src
			local key = src .. ( v.slot_desc and " (running)" or " (finished)" )
			by[key] = ( by[key] or 0 ) + 1
			total = total + 1
		end
	end
	local rows = {}
	for key, c in pairs(by) do table.insert(rows, { key = key, c = c }) end
	table.sort(rows, function(a, x) return a.c > x.c end)
	collectgarbage("collect")
	local kb2 = collectgarbage("count")
	log2("[olr_census] timers: %d quick timers held; heap %.0f MB after one full collection, %.0f MB after a second", total,
		kb1 / 1024, kb2 / 1024)
	for i = 1, math.min(top, #rows) do log2("[olr_census]   %7d  %s", rows[i].c, rows[i].key) end
end

-- [HE-PORT] fl olr_census.respawners_all("bandit"): every respawner of the Zone whose name or sections have that word
function respawners_all(word)
	local now = game.get_game_time()
	local n = 0
	for _, se in alife():objects() do
		if se.spawned_obj and se.item_spawn == false then
			local secs = {}
			for _, entry in pairs(se.respawn_section) do table.insert(secs, entry.section) end
			local name = se.amk_name or se:name()
			local all = name .. " " .. table.concat(secs, " ")
			if not word or string.find(all, word, 1, true) then
				local left = 0
				if now < se.respawn_time then left = se.respawn_time:diffSec(now) / 3600 end
				n = n + 1
				log2("[olr_census]   %s on %s idle=%.0f-%.0f h next_in=%.1f h alive=%d [%s]", name, tostring(olr_smart_index.object_level(se)),
					se.idle_spawn_min / 3600, se.idle_spawn_max / 3600, left, #se.spawned_obj, table.concat(secs, " "))
			end
		end
	end
	log2("[olr_census] respawners_all(%s): %d", tostring(word), n)
end

function respawners(level_name)
	level_name = level_name or level.name()
	local now = game.get_game_time()
	for _, se in alife():objects() do
		if se.spawned_obj and se.item_spawn == false and olr_smart_index.object_level(se) == level_name then
			local secs = {}
			for _, entry in pairs(se.respawn_section) do
				table.insert(secs, entry.section)
			end
			local left = 0
			if now < se.respawn_time then left = se.respawn_time:diffSec(now) / 3600 end
			log2("[olr_census]   %s monster=%s idle=%.0f-%.0f h next_in=%.1f h alive=%d [%s]",
				se.amk_name or se:name(), tostring(se.he_monster_respawn == true),
				se.idle_spawn_min / 3600, se.idle_spawn_max / 3600, left, #se.spawned_obj, table.concat(secs, " "))
		end
	end
end

function npc(id)
	local se = alife():object(id)
	if not se then
		log2("[olr_census] npc %s: no such object", tostring(id))
		return
	end
	local sid = se:smart_terrain_id()
	local smart = sid ~= BAD_OBJ_ID and alife():object(sid)
	log2("[olr_census] npc %d %s section=%s comm=%s rank=%d online=%s level=%s smart=%s dormant=%s", id, se:name(), se:section_name(),
		tostring(se:community()), se:rank(), tostring(se.online), tostring(olr_smart_index.object_level(se)),
		smart and smart:name() or "none", tostring(is_dormant(se, IsStalker(se))))
	local obj = level.object_by_id(id)
	if not obj then return end
	local enemy = obj:best_enemy()
	if enemy then
		log2("[olr_census]   best_enemy=%s dist=%.0f relation=%d sees=%s", enemy:name(), obj:position():distance_to(enemy:position()),
			obj:relation(enemy), tostring(obj:see(enemy)))
	else
		log2("[olr_census]   best_enemy=none")
	end
	local active = obj:active_item()
	if active then
		log2("[olr_census]   active=%s mag=%d", active:section(), active:get_ammo_in_magazine())
	else
		log2("[olr_census]   active=none")
	end
	local best = obj:best_weapon()
	if best then
		log2("[olr_census]   best_weapon=%s mag=%d total=%d", best:section(), best:get_ammo_in_magazine(), best:get_ammo_total())
	else
		log2("[olr_census]   best_weapon=none")
	end
	local weapons, ammo = {}, {}
	obj:iterate_inventory(function(_, item)
		local sect = item:section()
		if string.sub(sect, 1, 4) == "wpn_" then table.insert(weapons, sect) end
		if string.sub(sect, 1, 5) == "ammo_" then add(ammo, sect) end
	end, obj)
	log2("[olr_census]   weapons: %s | ammo boxes: %s", table.concat(weapons, " "), joined(ammo))
	local st = db.storage[id]
	log2("[olr_census]   wounded=%s out=[%s] in=[%s] scheme=%s", tostring(obj:wounded()), obj:out_restrictions(), obj:in_restrictions(),
		tostring(st and st.active_section))
end

function budgets()
	local names = {}
	for lname in pairs(olr_cfg.budget_levels()) do table.insert(names, lname) end
	table.sort(names)
	local front = olr_cfg.frontier_levels()
	local humans, monsters = olr_squads.level_counts(), olr_monster_squads.level_counts()
	log2("[olr_census] budgets preset=%s chapter=%d grace=%s", olr_cfg.preset_name(), olr_cfg.chapter(), tostring(olr_cfg.grace_active()))
	for i = 1, #names do
		local lname = names[i]
		log2("[olr_census]   %s open=%s olr_humans=%d/%.1f olr_monsters=%d/%.1f respawner_monsters=%d/%s", lname,
			tostring(front == nil or front[lname] == true), humans[lname] or 0, olr_cfg.budget_of(1, lname),
			monsters[lname] or 0, olr_cfg.budget_of(2, lname), se_respawn.level_monster_count(lname), tostring(olr_cfg.monster_ceiling(lname)))
	end
	olr_population.report() -- [HE-PORT] with population on, the ceiling above is not used: these targets are
end

local function new_ids(before, after)
	local out = {}
	for id in pairs(after) do
		if not before[id] then table.insert(out, id) end
	end
	return out
end

local function copy_keys(t)
	local out = {}
	for k in pairs(t) do out[k] = true end
	return out
end

local function print_new(sim, probe, kind, ids)
	for _, id in ipairs(ids) do
		local se = sim:object(id)
		if se then
			local lname = olr_smart_index.object_level(se) or "?"
			local comm = community_of(probe, se)
			log2("[olr_census]   %s %s on %s rank=%d preset_ok=%s online=%s", kind, se:section_name(), lname, se:rank(),
				tostring(comm == nil or probe:check_preset(comm, se:rank(), lname)), tostring(se.online))
		end
	end
end

function tick(count)
	count = count or 1
	local sim = alife()
	local probe = any_smart()
	if not (sim and probe) then return end
	local before_h, before_m = copy_keys(olr_squads.known_ids()), copy_keys(olr_monster_squads.known_ids())
	for i = 1, count do
		olr_squads.debug_tick()
		olr_monster_squads.debug_tick()
	end
	local ids_h, ids_m = new_ids(before_h, olr_squads.known_ids()), new_ids(before_m, olr_monster_squads.known_ids())
	log2("[olr_census] tick x%d on preset %s from %s: humans +%d, monsters +%d", count, olr_cfg.preset_name(), level.name(), #ids_h, #ids_m)
	print_new(sim, probe, "human", ids_h)
	print_new(sim, probe, "monster", ids_m)
end
