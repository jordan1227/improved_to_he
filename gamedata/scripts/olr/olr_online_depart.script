-- [HE-PORT]
local CHECK_INTERVAL     = 90000
local LEAVE_CHANCE       = 20
local MAX_LEAVES_PER_TICK = 1
local SMART_LEAVE_WINDOW = 600000
local SMART_LEAVE_MAX    = 2
local REST_MIN_MS        = 30000
local REST_MAX_MS        = 90000
local DEPART_COOLDOWN    = 15 * 60000

-- [HE-PORT]
local TIME_FACTOR          = system_ini():r_float("alife", "time_factor")
local SMART_LEAVE_WINDOW_G = SMART_LEAVE_WINDOW / 1000 * TIME_FACTOR
local DEPART_COOLDOWN_G    = DEPART_COOLDOWN / 1000 * TIME_FACTOR
local DEPART_KEY           = "nlc.olr_depart_until"
local SMART_T0_KEY         = "nlc.olr_smart_leave_t0"
local SMART_CNT_KEY        = "nlc.olr_smart_leave_cnt"

local time_next_check = 0
local started = false
local pending = {}

local allowed_comms = {
	stalker = true,
	green = true,
	bandit = true,
	dolg = true,
	freedom = true,
	ecolog = true,
	killer = true,
	military = true,
}

local function now_ms()
	return time_global()
end

-- [HE-PORT]
local function now_g()
	return timers.Get_Game_Seconds()
end

local function cleanup_departed()
	local t = now_g()
	local sim = g_sim or alife()
	local store = get_value(DEPART_KEY) or {}
	local dirty = false
	for key, due in pairs(store) do
		local drop = false
		if t >= due then
			drop = true
		elseif sim then
			local se = sim:object(tonumber(key))
			if not se or not se:alive() then
				drop = true
			end
		end
		if drop then
			store[key] = nil
			dirty = true
		end
	end
	if dirty then
		set_value(DEPART_KEY, store)
	end
end

local function is_departed(id)
	local store = get_value(DEPART_KEY) or {}
	local key = tostring(id)
	local due = store[key]
	if not due then return false end
	if now_g() >= due then
		store[key] = nil
		set_value(DEPART_KEY, store)
		return false
	end
	return true
end

-- [HE-PORT]
local function mark_departed(id)
	local store = get_value(DEPART_KEY) or {}
	store[tostring(id)] = now_g() + DEPART_COOLDOWN_G
	set_value(DEPART_KEY, store)
end

local function cleanup_recent_smarts()
	local t = now_g()
	local t0s = get_value(SMART_T0_KEY) or {}
	local cnts = get_value(SMART_CNT_KEY) or {}
	local dirty = false
	for name, t0 in pairs(t0s) do
		if (t - t0) > SMART_LEAVE_WINDOW_G then
			t0s[name] = nil
			cnts[name] = nil
			dirty = true
		end
	end
	if dirty then
		set_value(SMART_T0_KEY, t0s)
		set_value(SMART_CNT_KEY, cnts)
	end
end

local function can_leave_smart(smart_name)
	if not smart_name then return true end
	cleanup_recent_smarts()
	local cnt = (get_value(SMART_CNT_KEY) or {})[smart_name]
	if not cnt then return true end
	return cnt < SMART_LEAVE_MAX
end

local function mark_smart_leave(smart_name)
	if not smart_name then return end
	local t0s = get_value(SMART_T0_KEY) or {}
	local cnts = get_value(SMART_CNT_KEY) or {}
	if not cnts[smart_name] then
		t0s[smart_name] = now_g()
		cnts[smart_name] = 1
	else
		cnts[smart_name] = cnts[smart_name] + 1
	end
	set_value(SMART_T0_KEY, t0s)
	set_value(SMART_CNT_KEY, cnts)
end

local function get_smart_name(se)
	local strn_id = se:smart_terrain_id()
	if not strn_id or strn_id == BAD_OBJ_ID then return nil end
	local sim = g_sim or alife()
	if not sim then return nil end
	local smart = sim:object(strn_id)
	if smart then return smart:name() end
	return nil
end

local function is_actor_dialog_with(npc)
	if not db.actor or not db.actor:is_talking() then
		return false
	end
	if not npc then return true end
	local ok, talking = pcall(function()
		if npc.is_talking then
			return npc:is_talking()
		end
		return false
	end)
	if ok and talking then
		return true
	end
	if db.actor:position():distance_to(npc:position()) <= 3.5 then
		return true
	end
	return false
end

local function is_eligible_client(npc)
	if not npc or not npc:alive() then return false end
	if not IsStalker(npc) then return false end
	if npc:id() == db.actor:id() then return false end
	if olr_protected and olr_protected.is_no_offline_alife_obj(npc:name()) then
		return false
	end
	if is_actor_dialog_with(npc) then
		return false
	end
	local ok_w, wounded = pcall(function()
		if npc.critically_wounded then
			return npc:critically_wounded()
		end
		return false
	end)
	if ok_w and wounded then return false end
	return true
end

local function pick_mode()
	local roll = math.random(1, 100)
	if roll <= 50 then
		return "job_transfer"
	elseif roll <= 85 then
		return "wander"
	end
	return "rest_then_leave"
end

local function migrate_comm(se)
	local comm = se:community()
	if comm == "green" or comm == "nebo" then
		return "stalker"
	end
	return comm
end

local function apply_depart(se, mode)
	if not se or not se:alive() then return false end
	if is_departed(se.id) then return false end
	if olr_protected and olr_protected.is_no_offline_alife_obj(se:name()) then
		return false
	end

	local comm = migrate_comm(se)
	if not allowed_comms[comm] and not allowed_comms[se:community()] then
		return false
	end
	if not olr_smart_index.ensure() then
		return false
	end

	local smart_name = get_smart_name(se)
	if not can_leave_smart(smart_name) then
		return false
	end
	if olr_smart_index.is_locked(smart_name) then
		return false
	end
	-- [HE-PORT]
	if not olr_smart_index.can_release(smart_name) then
		return false
	end
	-- [HE-PORT]
	if olr_post_watch and not olr_post_watch.may_release(smart_name, se.id) then
		return false
	end

	-- [HE-PORT]
	local assigned = nil
	local ok = pcall(function()
		local target
		if mode == "job_transfer" then
			target = olr_smart_index.pick_name(comm, smart_name)
		end
		assigned = target

		smart_terrain.unregister_npc(se)
		xrs_utils.set_smart_terrain(se, target or "none")

		if se.brain then
			se:brain():can_choose_alife_tasks(true)
			se:brain():update(true)
		end
	end)

	if not ok then
		return false
	end

	-- [HE-PORT]
	if assigned then
		olr_offline_task.clear_wandering(se:name())
	else
		olr_offline_task.set_wandering(se:name())
	end

	mark_departed(se.id)
	mark_smart_leave(smart_name)
	return true
end

local function process_pending()
	local t = now_ms()
	local sim = g_sim or alife()
	if not sim then return end
	local done = {}
	for id, info in pairs(pending) do
		if t >= info.at then
			local se = sim:object(id)
			local npc = level.object_by_id(id)
			if se and se:alive() then
				if npc and is_actor_dialog_with(npc) then
					info.at = t + 5000
					pending[id] = info
				else
					apply_depart(se, info.mode)
					table.insert(done, id)
				end
			else
				table.insert(done, id)
			end
		end
	end
	for _, id in ipairs(done) do
		pending[id] = nil
	end
end

local function try_depart_one(se, npc)
	if pending[se.id] or is_departed(se.id) then return false end
	local strn_id = se:smart_terrain_id()
	if not strn_id or strn_id == BAD_OBJ_ID then return false end
	local comm = migrate_comm(se)
	if not allowed_comms[comm] and not allowed_comms[se:community()] then return false end

	local mode = pick_mode()
	if mode == "rest_then_leave" then
		pending[se.id] = {
			at = now_ms() + math.random(REST_MIN_MS, REST_MAX_MS),
			mode = (math.random(1, 100) <= 60) and "job_transfer" or "wander",
		}
		return true
	end
	return apply_depart(se, mode)
end

function update()
	if not db.actor then return end
	if device().precache_frame > 1 then return end
	if sleep_manager and sleep_manager.is_sleep_active and sleep_manager.is_sleep_active() then
		return
	end

	process_pending()

	local t = now_ms()
	-- [HE-PORT]
	if not started then
		started = true
		time_next_check = t + CHECK_INTERVAL
		return
	end
	if t < time_next_check then return end
	time_next_check = t + CHECK_INTERVAL

	cleanup_departed()

	local sim = g_sim or alife()
	if not sim then return end
	olr_smart_index.ensure()

	local left = 0
	local checked = 0
	local MAX_CHECK = 25
	if db.storage then
		for id, _ in pairs(db.storage) do
			if left >= MAX_LEAVES_PER_TICK then break end
			if checked >= MAX_CHECK then break end
			if id ~= db.actor:id() and not pending[id] and not is_departed(id) then
				local npc = level.object_by_id(id)
				if npc and IsStalker(npc) then
					checked = checked + 1
					if is_eligible_client(npc) then
						local se = sim:object(id)
						if se and se.online and se:alive() then
							if math.random(1, 100) <= LEAVE_CHANCE then
								if try_depart_one(se, npc) then
									left = left + 1
								end
							end
						end
					end
				end
			end
		end
	end
end
