-- [HE-PORT]
local CHECK_INTERVAL     = 30000
local LEAVE_CHANCE       = 12
local MAX_LEAVES_PER_TICK = 1
local SMART_LEAVE_WINDOW = 600000
local SMART_LEAVE_MAX    = 2
local REST_MIN_MS        = 30000
local REST_MAX_MS        = 90000

local time_next_check = 0
local pending = {}
local recent_smart_leaves = {}
local departed_ids = {}

