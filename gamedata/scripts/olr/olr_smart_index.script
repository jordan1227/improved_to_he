-- [HE-PORT]
local index = {}
local name_to_obj = {}
local built = false
local last_build = 0
local BUILD_TTL = 120000

local human_comms = {
	stalker = true,
	bandit = true,
	dolg = true,
	freedom = true,
	ecolog = true,
	killer = true,
	military = true,
	green = true,
	monolith = true,
	zombied = true,
	trader = true,
	stranger = true,
	nebo = true,
}

local probe_comms = {
	"stalker", "bandit", "dolg", "freedom", "ecolog", "killer", "military", "green",
	"monolith", "zombied",
	"dog", "pseudodog", "boar", "flesh", "snork", "bloodsucker", "tushkano",
	"burer", "controller", "poltergeist", "cat", "chimera", "giant", "fracture",
}

local blacklist_sub = {
	"arena",
	"test_",
}

local function is_blacklisted(name)
	local n = string.lower(tostring(name or ""))
	for i = 1, #blacklist_sub do
		if string.find(n, blacklist_sub[i], 1, true) then
			return true
		end
	end
	return false
end

local function expand_comm(community)
	if community == "green" or community == "nebo" then
		return { community, "stalker", "green" }
	end
	if community == "stalker" then
		return { "stalker", "green" }
	end
	if community == "dolg" then
		return { "dolg", "military" }
	end
	if community == "military" then
		return { "military", "dolg" }
	end
	return { community }
end

local function is_stalker_comm(c)
	return human_comms[c] == true
end

local function is_bar_smart(name)
	local n = string.lower(tostring(name or ""))
	return string.sub(n, 1, 4) == "bar_"
end

local function smart_accepts(smart, community)
	if not smart then return false end
	if smart.disabled then return false end
	if smart.population_locked then return false end

	local sname = smart:name()
	if is_blacklisted(sname) then return false end

	local probes = expand_comm(community)
	local acc = smart.accepted_communities
	if acc then
		for i = 1, #probes do
			if acc[probes[i]] then
				return true
			end
		end
		return false
	end

	local gp = smart.gparams
	if not gp or not gp.type then
		return false
	end
	local gtype = gp.type
	for i = 1, #probes do
		local c = probes[i]
		local ok, res = pcall(function()
			return xr_gulag.checkNpc(c, is_stalker_comm(c), gtype, nil, nil)
		end)
		if ok and res then
			return true
		end
	end
	return false
end

function rebuild(force)
	if not force and built and (time_global() - last_build) < BUILD_TTL then
		return built
	end
	if not db or not db.smart_terrain_by_id then
		return false
	end

	local new_index = {}
	local new_map = {}
	local any = false

	for id, smart in pairs(db.smart_terrain_by_id) do
		if smart and smart.name then
			any = true
			local sname = smart:name()
			new_map[sname] = smart
			for i = 1, #probe_comms do
				local comm = probe_comms[i]
				if smart_accepts(smart, comm) then
					if not new_index[comm] then
						new_index[comm] = {}
					end
					table.insert(new_index[comm], sname)
				end
			end
		end
	end

	if any then
		index = new_index
		name_to_obj = new_map
		built = true
		last_build = time_global()
		return true
	end
	return false
end

local function merge_lists(comms)
	local out = {}
	local seen = {}
	for i = 1, #comms do
		local list = index[comms[i]]
		if list then
			for j = 1, #list do
				local n = list[j]
				if not seen[n] then
					seen[n] = true
					table.insert(out, n)
				end
			end
		end
	end
	return out
end

function get_names(community)
	rebuild(false)
	if not community then
		return {}
	end
	local list
	if community == "green" or community == "nebo" or community == "stalker"
		or community == "dolg" or community == "military"
	then
		list = merge_lists(expand_comm(community))
	else
		list = index[community] or {}
	end
	if community == "dolg" or community == "military" then
		local filtered = {}
		for i = 1, #list do
			local n = list[i]
			if not is_bar_smart(n) then
				table.insert(filtered, n)
			end
		end
		return filtered
	end
	return list
end

function pick_name(community, exclude_name)
	local list = get_names(community)
	local n = #list
	if n == 0 then
		return nil
	end
	if n == 1 then
		if list[1] == exclude_name then
			return nil
		end
		return list[1]
	end
	for i = 1, 12 do
		local name = list[math.random(n)]
		if name ~= exclude_name then
			return name
		end
	end
	return list[math.random(n)]
end

function get_obj(name)
	rebuild(false)
	local o = name_to_obj[name]
	if not o then
		return nil
	end
	local sim = g_sim or alife()
	if sim and sim:object(o.id) then
		return o
	end
	return nil
end

function ensure()
	return rebuild(false)
end

function count(community)
	local list = get_names(community)
	return #list
end
