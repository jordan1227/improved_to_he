-- [HE-PORT]
local index = {}
local name_to_obj = {}
local name_to_level = {}
local built = false
local last_build = 0
local last_signature = ""
local merged_names = {}
-- [HE-PORT]
local ACTOR_KEEPOUT = 260

local probe_comms = {
	"stalker", "bandit", "dolg", "freedom", "ecolog", "killer", "military", "green",
	"monolith", "zombied",
	"dog", "pseudodog", "boar", "flesh", "snork", "bloodsucker", "tushkano",
	"burer", "controller", "poltergeist", "cat", "chimera", "giant",
}

local blacklist_sub = {
	"arena",
	"test_",
	"rad_killers_lager",
}

local locked_smarts = {
	esc_bridge = true,
}

-- [HE-PORT]
local cordon_pinned_smarts = {
	esc_blokpost = true,
	esc_bridge = true,
	esc_specnaz = true,
	esc_private = true,
}

local function is_blacklisted(name)
	local n = string.lower(tostring(name or ""))
	for i = 1, #blacklist_sub do
		if string.find(n, blacklist_sub[i], 1, true) then
			return true
		end
	end
	return false
end

function is_locked(name)
	if locked_smarts[name] == true then return true end
	-- [HE-PORT]
	if cordon_pinned_smarts[name] == true then
		local ok, lname = pcall(function() return level.name() end)
		if ok and lname == "l01_escape" then return true end
	end
	return false
end

local function is_bar_smart(name)
	local n = string.lower(tostring(name or ""))
	return string.sub(n, 1, 4) == "bar_"
end

local function live(name)
	local id = name_to_obj[name]
	if not id then return nil end
	local sim = g_sim or alife()
	local o = sim and sim:object(id)
	if o and o:name() == name then return o end
	return nil
end

local function smart_open(smart)
	if not smart then return false end
	if smart.disabled then return false end
	if smart.population_locked then return false end
	if is_blacklisted(smart:name()) then return false end
	return true
end

-- [HE-PORT] the smart's own story gate (cond), read at pick time
local function story_open(name)
	local smart = live(name)
	return smart_open(smart) and smart:is_gulag_available()
end

-- [HE-PORT]
local function band_fits(level_name, preset_name, community, rank)
	local preset = smart_terrain_params.get_preset(olr_cfg.chapter_preset(preset_name or olr_cfg.preset_for(level_name)))
	if preset == false then return true end
	local band = preset[community]
	return band ~= nil and rank >= band[1] and rank <= band[2]
end

local function smart_preset(name)
	local lname = name_to_level[name]
	local borrowed = olr_cfg.preset_for(lname)
	if borrowed ~= lname then return borrowed end
	local smart = live(name)
	return smart and smart.gparams.preset_name or lname
end

-- [HE-PORT] every smart on a level, nearest first
function smarts_near(lname, x, z)
	rebuild(false)
	local list = {}
	for name, lvl in pairs(name_to_level) do
		local smart = lvl == lname and live(name)
		if smart then
			local dx, dz = smart.position.x - x, smart.position.z - z
			table.insert(list, { name = name, d = dx * dx + dz * dz })
		end
	end
	table.sort(list, function(a, b) return a.d < b.d end)
	return list
end

-- [HE-PORT] nearest smart on a level, open or not, for places the story does not gate
function nearest_on_level(lname, x, z)
	rebuild(false)
	local best, best_d = nil, nil
	for name, lvl in pairs(name_to_level) do
		local smart = lvl == lname and live(name)
		if smart then
			local dx, dz = smart.position.x - x, smart.position.z - z
			local d = dx * dx + dz * dz
			if not best_d or d < best_d then best, best_d = name, d end
		end
	end
	return best
end

-- [HE-PORT] any smart on a level, closed to OLR or not; a story-open one if there is one
function any_on_level(lname)
	rebuild(false)
	local any = nil
	for name, lvl in pairs(name_to_level) do
		if lvl == lname then
			if story_open(name) then return name end
			any = any or name
		end
	end
	return any
end

-- [HE-PORT]
function is_story_open(name)
	return story_open(name)
end

-- [HE-PORT] docs/ALIFE_NEXT_DESIGN.md 8.26: would this smart take a man of this community now? Its community lists
-- (the index), its story gate and room left. Day trips and regroup ask before a move: the tf250 soak had 195 trips
-- refused by smart:enabled() (lairs, other sides' bases, full camps). Returns true, or false and why
-- [HE-PORT] 8.28: and his rank against the smart's preset (check_preset), and the non-exclusive room it counts
-- [HE-PORT] 8.29 D2: someone registered at this smart that se is hostile to, or who is hostile to him; nil if none
function enemy_at(name, se)
	local smart = live(name)
	if not ( smart and se ) then return nil end
	local sim = alife()
	local mine = se:community()
	for id in pairs(smart.npc_info or {}) do
		local o = id ~= se.id and sim:object(id)
		if o and IsStalker(o) and o:alive() and amk_offline_alife.comm_hostile(mine, o:community()) then return o end
	end
	return nil
end

local accept_sets = {}
function may_take(name, community, rank, se)
	local list = get_names(community)
	local s = accept_sets[community]
	if not s or s.list ~= list then
		s = { list = list, names = {} }
		for i = 1, #list do s.names[list[i]] = true end
		accept_sets[community] = s
	end
	if not s.names[name] then return false, "community" end
	if not story_open(name) then return false, "closed" end
	if rank and not rank_fits(name, community, rank) then return false, "rank" end
	if se and enemy_at(name, se) then return false, "enemy there" end
	local smart = live(name)
	local g = smart and smart.gulag
	if g and g.capacity_non_exclusive and g.get_non_exclusive_population and g:get_non_exclusive_population() >= g.capacity_non_exclusive then
		return false, "full"
	end
	return true
end

function rank_fits(name, community, rank)
	return band_fits(name_to_level[name], smart_preset(name), community, rank)
end

-- [HE-PORT] the top of a level's rank band for a faction, nil when the level sets none
function level_rank_cap(level_name, community)
	if not level_name then return nil end
	local preset = smart_terrain_params.get_preset(olr_cfg.chapter_preset(olr_cfg.preset_for(level_name)))
	if not preset then return nil end
	local band = preset[community]
	return band and band[2] or nil
end

-- [HE-PORT] for people who are already somewhere, not at a smart
function level_rank_fits(level_name, community, rank)
	return band_fits(level_name, nil, community, rank)
end

-- [HE-PORT] can this section's rank range live at this smart at all
function section_fits(name, community, section)
	local preset = smart_terrain_params.get_preset(olr_cfg.chapter_preset(smart_preset(name)))
	if preset == false then return true end
	local band = preset[community]
	if not band then return false end
	local ini = system_ini()
	if ini:line_exist(section, "spec_rank") then
		local range = ranks.get_rank_interval(ini:r_string(section, "spec_rank"))
		return range ~= nil and range[1] <= band[2] and range[2] >= band[1]
	end
	local rank = ini:line_exist(section, "rank") and ini:r_s32(section, "rank") or 0
	return rank >= band[1] and rank <= band[2]
end

function sections_fitting(name, community, sections)
	local out = {}
	for i = 1, #sections do
		if section_fits(name, community, sections[i]) then
			table.insert(out, sections[i])
		end
	end
	return out
end

local function smart_accepts(smart, community, level_name)
	if not smart_open(smart) then return false end
	return olr_faction_policy.accepts(smart, community, level_name)
end

local function smart_level_name(smart)
	local ok, lname = pcall(function()
		if smart.get_level_name then
			return smart:get_level_name()
		end
		return smart.level_name
	end)
	if ok and lname then return lname end
	ok, lname = pcall(function()
		local sim = g_sim or alife()
		return sim:level_name(game_graph():vertex(smart.m_game_vertex_id):level_id())
	end)
	if ok and lname then return lname end
	return nil
end

local function add_smart(smart, new_index, new_map, new_level)
	if not smart or not smart.name then return false end
	local sname = smart:name()
	if new_map[sname] then return true end
	new_map[sname] = smart.id
	local lname = smart_level_name(smart)
	new_level[sname] = lname
	for i = 1, #probe_comms do
		local comm = probe_comms[i]
		-- [HE-PORT]
		local barred = false
		local okd, denied = pcall(olr_faction_policy.smart_denied, comm, sname, lname)
		if okd and denied then barred = true end
		if smart_accepts(smart, comm, lname) and not barred then
			if not new_index[comm] then
				new_index[comm] = {}
			end
			table.insert(new_index[comm], sname)
		end
	end
	return true
end

local function global_registry()
	if not smart_terrain or not smart_terrain.get_registry_by_name then
		return nil
	end
	local ok, reg = pcall(smart_terrain.get_registry_by_name)
	if ok and reg then return reg end
	return nil
end

function rebuild(force)
	local signature = olr_cfg.closed_signature()
	if not force and built and signature == last_signature and (time_global() - last_build) < olr_cfg.get("index_ttl") * 1000 then
		return built
	end
	last_signature = signature
	local timer = profile_timer()
	timer:start()

	local new_index = {}
	local new_map = {}
	local new_level = {}
	local any = false

	local reg = global_registry()
	if reg then
		for _, smart in pairs(reg) do
			if add_smart(smart, new_index, new_map, new_level) then
				any = true
			end
		end
	end

	if db and db.smart_terrain_by_id then
		for _, smart in pairs(db.smart_terrain_by_id) do
			if add_smart(smart, new_index, new_map, new_level) then
				any = true
			end
		end
	end

	if any then
		index = new_index
		merged_names = {} -- [HE-PORT]
		name_to_obj = new_map
		name_to_level = new_level
		built = true
		last_build = time_global()
		timer:stop()
		if olr_cfg.log_census() then
			log2("[olr_index] rebuilt in %.1f ms", timer:time() / 1000)
		end
		return true
	end
	return false
end

local function merge_lists(comms)
	local out = {}
	local seen = {}
	for i = 1, #comms do
		local list = index[comms[i]]
		if list then
			for j = 1, #list do
				local n = list[j]
				if not seen[n] then
					seen[n] = true
					table.insert(out, n)
				end
			end
		end
	end
	return out
end

function get_names(community)
	rebuild(false)
	if not community then
		return {}
	end
	-- [HE-PORT] merged once per index build, not per NPC
	if merged_names[community] then return merged_names[community] end
	local list
	if community == "green" or community == "nebo" or community == "stalker"
		or community == "dolg" or community == "military"
	then
		list = merge_lists(olr_faction_policy.expand_comm(community))
	else
		list = index[community] or {}
	end
	if community == "military" then -- [HE-PORT]
		local filtered = {}
		for i = 1, #list do
			local n = list[i]
			if not is_bar_smart(n) then
				table.insert(filtered, n)
			end
		end
		merged_names[community] = filtered
		return filtered
	end
	merged_names[community] = list
	return list
end

function get_level(name)
	rebuild(false)
	return name_to_level[name]
end

-- [HE-PORT]
function near_actor( name )
	if not db.actor then return false end
	local smart = live( name )
	if not smart then return false end
	local ok, res = pcall( function()
		if name_to_level[ name ] ~= level.name() then return false end
		return db.actor:position():distance_to( smart.position ) < ACTOR_KEEPOUT
	end )
	if ok then return res == true end
	return false
end

-- [HE-PORT]
local function drop_near_actor( list )
	if not db.actor then return list end
	local pool = {}
	for i = 1, #list do
		if not near_actor( list[ i ] ) then
			table.insert( pool, list[ i ] )
		end
	end
	if #pool > 0 then return pool end
	return list
end

local function pick_from(list, exclude_name)
	local n = #list
	if n == 0 then
		return nil
	end
	if n == 1 then
		if list[1] == exclude_name then
			return nil
		end
		return list[1]
	end
	for i = 1, 12 do
		local name = list[math.random(n)]
		if name ~= exclude_name then
			return name
		end
	end
	return list[math.random(n)]
end

-- [HE-PORT]
local function pick_story_open(list, exclude_name, community, rank, se)
	local n = #list
	if n == 0 then return nil end
	local start = math.random(n)
	for i = 0, n - 1 do
		local name = list[(start + i - 1) % n + 1]
		-- [HE-PORT] 8.29 D2: a migrant never picks a smart holding an enemy of his
		if name ~= exclude_name and story_open(name) and not ( rank and not rank_fits(name, community, rank) )
			and not ( se and enemy_at(name, se) )
		then
			return name
		end
	end
	return nil
end

-- [HE-PORT]
local function keep_levels(list, levels, drop)
	local pool = {}
	for i = 1, #list do
		local inside = levels[ name_to_level[ list[ i ] ] or "" ] == true
		if inside ~= ( drop == true ) then
			table.insert( pool, list[ i ] )
		end
	end
	return pool
end

-- [HE-PORT] most people pick a home level, some a visit
local function territory_list(list, community)
	local home, all = olr_cfg.territory(community)
	if not home then return list end
	if math.random(100) <= 80 then
		local pool = keep_levels(list, home)
		if #pool > 0 then return pool end
	end
	return keep_levels(list, all)
end

function pick_name(community, exclude_name, exclude_level, only_levels, opts)
	local list = get_names(community)
	if exclude_level then
		local pool = {}
		for i = 1, #list do
			if name_to_level[list[i]] ~= exclude_level then
				table.insert(pool, list[i])
			end
		end
		if #pool > 0 then
			list = pool
		end
	end
	-- [HE-PORT]
	if only_levels then
		local pool = {}
		for i = 1, #list do
			if only_levels[ name_to_level[ list[ i ] ] or "" ] then
				table.insert( pool, list[ i ] )
			end
		end
		if #pool == 0 then return nil end
		list = pool
	end
	-- [HE-PORT]
	local okp, pref = pcall(olr_faction_policy.is_bar_preferred, community)
	if okp and pref then
		local boosted = {}
		for i = 1, #list do
			local n = list[i]
			table.insert(boosted, n)
			if olr_faction_policy.is_bar_smart_name(n) then
				table.insert(boosted, n)
				table.insert(boosted, n)
			end
		end
		list = boosted
	end
	-- [HE-PORT] opts.home (olr_population.keep_home): a lair placing its own offspring on its own level, so the
	-- frontier, the Cordon grace and the player's nearness do not apply
	local home = opts and opts.home
	local front = not home and olr_cfg.frontier_levels()
	if front then
		list = keep_levels( list, front )
	end
	if not ( opts and opts.no_territory ) then
		list = territory_list( list, community )
	end
	local quiet = not home and olr_cfg.grace_blocked_levels()
	if quiet then
		list = keep_levels( list, quiet, true )
	end
	if not home then list = drop_near_actor( list ) end
	if olr_cfg.on("story_gates") then return pick_story_open(list, exclude_name, community, opts and opts.rank, opts and opts.se) end
	return pick_from(list, exclude_name)
end

-- [HE-PORT] one level over at most, inside the territory, fitting the rank
function pick_migration(se, community, exclude_name)
	local here = object_level(se)
	if not here then return nil end
	local allowed = neighbour_levels(here)
	allowed[here] = true
	local _, all = olr_cfg.territory(community)
	if all and all[here] then
		for lvl in pairs(allowed) do
			if not all[lvl] then allowed[lvl] = nil end
		end
	end
	local human = olr_faction_policy.is_stalker_comm(community)
	local open
	if olr_population.active() then -- [HE-PORT] migrants, native or OLR, go where the shared count is under target
		open = olr_population.open_levels(human and 1 or 2)
	else
		open = olr_cfg.budget_open(human and 1 or 2, human and olr_squads.level_counts() or olr_monster_squads.level_counts())
	end
	if open then
		for lvl in pairs(allowed) do
			if not open[lvl] and lvl ~= here then allowed[lvl] = nil end
		end
	end
	allowed = olr_steering.steer_levels(allowed, here, human) -- [HE-PORT]
	return pick_name(community, exclude_name, nil, allowed, { no_territory = true, rank = se:rank(), se = se })
end

-- [HE-PORT] test helper: what a pick for this community could choose on a level right now
function level_picks(community, lname)
	local open, shut = {}, {}
	local list = get_names(community)
	for i = 1, #list do
		if name_to_level[list[i]] == lname then
			if story_open(list[i]) then
				table.insert(open, list[i])
			else
				table.insert(shut, list[i])
			end
		end
	end
	return open, shut
end

-- [HE-PORT]
-- ignore_closed: Monolith may use Radar and Pripyat before the north is open to OLR humans
function pick_any_on_levels(allowed_levels, exclude_name, ignore_closed)
	rebuild(false)
	local pool = {}
	for name, lvl in pairs(name_to_level) do
		if ((not allowed_levels) or allowed_levels[lvl]) and ( ignore_closed or not olr_cfg.level_closed(lvl) ) then
			if smart_open(live(name)) then
				table.insert(pool, name)
			end
		end
	end
	-- [HE-PORT]
	pool = drop_near_actor( pool )
	if olr_cfg.on("story_gates") then return pick_story_open(pool, exclude_name) end
	return pick_from(pool, exclude_name)
end

-- [HE-PORT]
function population( name )
	local smart = live( name )
	if not smart or not smart.gulag then return nil end
	local ok, pop = pcall( function() return smart.gulag:get_population() end )
	if ok and pop then return pop end
	return nil
end

-- [HE-PORT]
function capacity( name )
	local smart = live( name )
	if not smart or not smart.gulag then return nil end
	local ok, cap = pcall( function() return smart.gulag.capacity end )
	if ok and cap then return cap end
	return nil
end

-- [HE-PORT]
function can_release( name )
	if not name then return true end
	if olr_post_watch and olr_post_watch.is_refilled( name ) then return true end
	rebuild( false )
	local pop = population( name )
	if not pop then return true end
	local cap = capacity( name ) or 0
	local floor = 2
	if cap <= 3 then floor = 1 end
	return ( pop - 1 ) >= floor
end

-- [HE-PORT]
local neighbours = {
	l01_escape     = { "l02_garbage", "marsh", "lost_village", "k01_darkscape", "hospital" },
	marsh          = { "l01_escape", "lost_village", "l03_agroprom", "k01_darkscape" },
	lost_village   = { "l01_escape", "marsh", "l02_garbage", "l03_agroprom" },
	k01_darkscape  = { "l01_escape", "marsh", "hospital", "l04_darkvalley" },
	hospital       = { "l01_escape", "k01_darkscape", "l02_garbage" },
	l02_garbage    = { "l01_escape", "l03_agroprom", "l04_darkvalley", "l05_bar", "lost_village", "hospital" },
	l03_agroprom   = { "l02_garbage", "l08_yantar", "marsh", "lost_village" },
	l04_darkvalley = { "l02_garbage", "k01_darkscape", "aver" },
	aver           = { "l04_darkvalley", "l02_garbage", "l07_military" },
	l05_bar        = { "l02_garbage", "l06_rostok", "l07_military" },
	l06_rostok     = { "l05_bar", "l08_yantar", "red_forest" },
	l08_yantar     = { "l03_agroprom", "l06_rostok", "red_forest" },
	l07_military   = { "l05_bar", "l10_radar", "red_forest", "generators", "limansk" },
	red_forest     = { "l06_rostok", "l08_yantar", "l07_military", "limansk" },
	limansk        = { "red_forest", "l07_military", "generators" },
	generators     = { "l07_military", "limansk", "deadcity", "l10_radar" },
	l10_radar      = { "l07_military", "l11_pripyat", "generators", "deadcity" },
	l11_pripyat    = { "l10_radar", "deadcity" },
	deadcity       = { "l11_pripyat", "generators", "l10_radar" },
}

-- [HE-PORT]
local parent_level = {
	l03u_agr_underground = "l03_agroprom",
	l04u_labx18          = "l04_darkvalley",
	labx10               = "l04_darkvalley",
	l08u_brainlab        = "l08_yantar",
	l10u_bunker          = "l10_radar",
	labx8                = "l10_radar",
	warlab               = "generators",
	av_peshera           = "red_forest",
}

-- [HE-PORT]
function region_levels()
	local ok, cur = pcall( level.name )
	if not ok or not cur then return nil end
	local base = parent_level[ cur ] or cur
	local set = { [ cur ] = true, [ base ] = true }
	local nb = neighbours[ base ]
	if nb then
		for i = 1, #nb do set[ nb[ i ] ] = true end
	end
	return set
end

function neighbour_levels( lname )
	local set = {}
	local nb = lname and neighbours[ parent_level[ lname ] or lname ]
	if nb then
		for i = 1, #nb do set[ nb[ i ] ] = true end
	end
	return set
end

-- [HE-PORT]
function object_level( sobj )
	local ok, lname = pcall( function()
		local sim = g_sim or alife()
		return sim:level_name( game_graph():vertex( sobj.m_game_vertex_id ):level_id() )
	end )
	if ok then return lname end
	return nil
end

-- [HE-PORT]
function actor_dist( name )
	if not db.actor then return nil end
	local smart = live( name )
	if not smart then return nil end
	local ok, d = pcall( function()
		if name_to_level[ name ] ~= level.name() then return nil end
		return db.actor:position():distance_to( smart.position )
	end )
	if ok then return d end
	return nil
end

function get_obj(name)
	rebuild(false)
	return live(name)
end

function ensure()
	return rebuild(false)
end

function count(community)
	local list = get_names(community)
	return #list
end

-- [HE-PORT]
-- [HE-PORT] a smart that refuses him leaves him with none, and a stalker with none wanders the whole map
function attach_checked(sobj, smart_name)
	local smart = alife():object(smart_name)
	local from = object_level(sobj)
	-- [HE-PORT] the move is reported (olr_reactive.on_move) only once the smart has taken him
	if not ( smart and attach_to(sobj, smart_name, true) ) then return false end
	if smart:enabled(sobj) then
		olr_reactive.on_move(sobj, smart_name, from)
		return true
	end
	xrs_utils.clear_smart_terrain(sobj)
	return false
end

-- [HE-PORT] attach_checked, and on a refusal back to the smart he had: attach_checked alone leaves him with none
-- (he would wander the whole map)
function move_or_stay(sobj, smart_name)
	local sid = sobj:smart_terrain_id()
	local old = sid and sid ~= BAD_OBJ_ID and alife():object(sid)
	local old_name = old and old:name()
	if attach_checked(sobj, smart_name) then return true end
	if old_name and old_name ~= smart_name and not attach_checked(sobj, old_name) then
		log2("[olr_smart_index] %s id=%d: %s would not have him, nor %s again; he has no smart now", sobj:name(), sobj.id,
			smart_name, old_name)
	end
	return false
end

function attach_to(sobj, smart_name, quiet)
	if not (sobj and smart_name) then return false end
	local from = object_level(sobj) -- [HE-PORT]
	xrs_utils.clear_smart_terrain(sobj)
	smart_terrain.unregister_npc(sobj)
	if sobj.brain then
		sobj:brain():can_choose_alife_tasks(true)
	end
	if not xrs_utils.set_smart_terrain(sobj, smart_name) then return false end
	if sobj.brain then
		sobj:brain():can_choose_alife_tasks(true)
		sobj:brain():update(true)
	end
	if not quiet then olr_reactive.on_move(sobj, smart_name, from) end -- [HE-PORT] attach_checked reports it itself
	return true
end

-- [HE-PORT] AlifeTactics rout: the nearest smart on the NPC's level that its community may use, with room
-- for one more, and not closer to the enemy than the NPC is. Returns a smart name or nil.
function pick_nearest_friendly(sobj, community, from_pos, enemy_pos)
	if not (sobj and from_pos and enemy_pos) then return nil end
	rebuild(false)
	local lname = object_level(sobj)
	if not lname then return nil end
	local own = sobj:smart_terrain_id()
	local sim = g_sim or alife()
	local own_name = nil
	if own and own ~= BAD_OBJ_ID and sim then
		local o = sim:object(own)
		own_name = o and o:name() or nil
	end
	local list = get_names(community)
	local here_e = from_pos:distance_to(enemy_pos)
	local gates = olr_cfg.on("story_gates")
	local ranked = olr_cfg.on("rank_gates")
	local best, best_d = nil, nil
	for i = 1, #list do
		local name = list[i]
		if name ~= own_name and name_to_level[name] == lname and not is_locked(name) then
			local smart = live(name)
			if smart and smart_open(smart) and ( not gates or story_open(name) ) and ( not ranked or rank_fits(name, community, sobj:rank()) ) then
				local pop, cap = population(name), capacity(name)
				if not ( pop and cap and pop >= cap ) and smart.position:distance_to(enemy_pos) > here_e then
					local d = from_pos:distance_to(smart.position)
					if not best_d or d < best_d then best, best_d = name, d end
				end
			end
		end
	end
	return best
end
