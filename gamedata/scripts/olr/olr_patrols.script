-- [HE-PORT] Hunting parties, docs/ALIFE_DESIGN.md Phase 3.5: real Duty men and hunters from nearby levels gather at
-- one smart, go after an alpha or a mutant lair together, and afterwards go back to their lives; what they cut
-- goes the usual way to a trader. Nobody is created and nobody vanishes. One party at a time. Log: [olr_patrols].
-- Online they walk through olr_group_walk; if nobody sees the end, it is rolled from their ranks.
-- fl olr_patrols.report()                the party and when the next one is due
-- fl olr_patrols.force("alpha")          starts one now, "alpha" or "raid", near this level
-- fl olr_patrols.force_hunt()            skips the gathering: those offline are put at the gathering place at once
-- fl olr_patrols.force_resolve()         the fight is decided now, as if nobody saw it
-- fl olr_patrols.test_walk(60)           the online stalkers nearest you walk 60 m ahead as a group, no story
-- fl olr_patrols.go()                   puts you by the party's leader, on any level
-- fl olr_patrols.test_here()             a party of spawned men starts 25 m from you, for the nearest lair on this level
-- fl olr_patrols.test_here("alpha")      the same for an alpha on this level; spawns one about 150 m away if there is none
-- fl olr_patrols.watch()                 every member now: distances, action, enemy, health, parts
-- fl olr_patrols.stop()                  ends the party, everyone goes home

local INI_PATH = "misc\\olr_alife.ltx"
local KEY = "nlc.olr_patrol"
local NEAR_ACTOR = 165
local LAG_DIST = 25
local LAG_WAIT_MS = 20000
local LAG_RESET_MS = 30000
local HARDNESS = { pseudodog = 3, boar = 3, snork = 3, bloodsucker = 5, burer = 6, chimera = 8 }

local cfg = nil
local cur = nil
local lag_since = {}
local stall = {}
local STALL_MOVE = 1.5
local STALL_STEP_MS = 15000
local STALL_STEP_DIST = 40
local STALL_TRIES = 8
local goal_cache = {}
local trace_next = 0
local SECTIONS = { dolg = { "olr_dolg_regular", "olr_dolg_veteran" }, stalker = { "olr_stalker_general", "olr_stalker_veteran" } }

local function config()
	if cfg then return cfg end
	cfg = { prey = {}, levels = {} }
	local ini = ini_file(INI_PATH)
	for i = 0, ini:line_count("patrols") - 1 do
		local _, key, val = ini:r_line("patrols", i, "", "")
		cfg[key] = tonumber(val) or val
	end
	for name in string.gmatch(cfg.patrol_prey, "[%w_]+") do table.insert(cfg.prey, name) end
	for name in string.gmatch(cfg.patrol_levels, "[%w_]+") do cfg.levels[name] = true end
	return cfg
end

local function plog(fmt, ...)
	log2("[olr_patrols] day %d %02d:%02d " .. fmt, level.get_time_days(), level.get_time_hours(), level.get_time_minutes(), ...)
end

local function now()
	return timers.Get_Game_Seconds()
end

local function state()
	if not cur then cur = get_value(KEY) or {} end
	return cur
end

local function save()
	set_value(KEY, cur)
end

function is_member(id)
	if not db.actor then return false end
	local p = state().p
	return p ~= nil and p.members[tostring(id)] ~= nil
end

local function say(prefix, p, who)
	local region = olr_smart_index.region_levels()
	if not ( region and region[p.level] and he_pda_model.get_pda() ) then return end
	local key = olr_trader_runs.pick_line(prefix)
	if not key then
		plog("no text for %s", prefix)
		return
	end
	local where = news_main.localized_where(p.level, vector():set(p.x, p.y, p.z))
	local text = game.translate_string(key)
	text = string.gsub(text, "%$where", function() return where end)
	text = string.gsub(text, "%$name", function() return p.prey_name or "" end)
	sak.send_tip(text, who or olr_trader_runs.other_name(), 0, 15, "default", "pda_news", "gray")
	plog("line %s", key)
end

local function is_prey(section)
	for _, name in ipairs(config().prey) do
		if string.find(section, name, 1, true) then return true end
	end
	return false
end

-- ---------------------------------------------------------------------------
-- who they go after
-- ---------------------------------------------------------------------------
local function pick_alpha(region)
	local list = {}
	for _, a in ipairs(olr_alpha.list()) do
		local se = alife():object(a.id)
		if se and config().levels[a.level] and region[a.level] then
			table.insert(list, { kind = "alpha", alpha = a.id, prey_name = a.name, prey_kind = a.kind, level = a.level,
				x = se.position.x, y = se.position.y, z = se.position.z, lv = se.m_level_vertex_id })
		end
	end
	return #list > 0 and list[math.random(#list)] or nil
end

-- a lair is a smart with prey around it: most mutants have no smart of their own
local function pick_lair(region)
	local sim = alife()
	local c = config()
	local prey = {}
	for _, id in ipairs(olr_offline_task.cached_monsters()) do
		local se = sim:object(id)
		local lvl = se and IsMonster(se) and se:alive() and is_prey(se:section_name()) and olr_smart_index.object_level(se)
		if lvl and region[lvl] and c.levels[lvl] then
			prey[lvl] = prey[lvl] or {}
			table.insert(prey[lvl], se.position)
		end
	end
	local list = {}
	for lvl, spots in pairs(prey) do
		for _, rec in ipairs(olr_smart_index.smarts_near(lvl, 0, 0)) do
			local smart = olr_smart_index.get_obj(rec.name)
			if smart and not olr_cfg.camp_list()[rec.name] and olr_smart_index.is_story_open(rec.name) and not olr_smart_index.is_locked(rec.name) then
				local n = 0
				for _, pos in ipairs(spots) do
					if pos:distance_to(smart.position) <= c.patrol_lair_dist then n = n + 1 end
				end
				if n >= c.patrol_lair_min then table.insert(list, { name = rec.name, level = lvl, smart = smart, n = n }) end
			end
		end
	end
	plog("lairs near here: %d", #list)
	-- in random order, a few at most: not every lair has somewhere friendly to gather
	local out = {}
	for _ = 1, math.min(#list, 5) do
		local pick = table.remove(list, math.random(#list))
		local pos = pick.smart.position
		table.insert(out, { kind = "raid", lair = pick.name, level = pick.level, x = pos.x, y = pos.y, z = pos.z, lv = pick.smart.m_level_vertex_id, count = pick.n })
	end
	return out
end

-- ---------------------------------------------------------------------------
-- who goes
-- ---------------------------------------------------------------------------
local function may_join(se, allowed)
	if not ( se and IsStalker(se) and se:alive() ) or se.online then return false end
	if se.m_story_id ~= nil and se.m_story_id ~= NONE_SID and se.m_story_id ~= NONE_CL_SID then return false end
	if olr_trader_runs.has_story_name(se) then return false end
	-- only those with no written part: scripted camps (bar_dolg_bunker, dsc_dolg_sniper, Bes and Seryi) stay out
	if string.sub(se:section_name(), 1, 4) ~= "olr_" and not string.find(se:name(), "_respawn", 1, true) then return false end
	if olr_trader_runs.on_run(se.id) or olr_protected.is_no_offline_alife_obj(se:name()) then return false end
	if se:rank() < config().patrol_min_rank or se:health() < config().patrol_min_health then return false end
	if not allowed[olr_smart_index.object_level(se)] then return false end
	local sid = se:smart_terrain_id()
	local smart = sid ~= BAD_OBJ_ID and alife():object(sid)
	if smart and ( olr_smart_index.is_locked(smart:name()) or not olr_smart_index.can_release(smart:name()) ) then return false end
	return true
end

local function pick_from(comms, allowed, want, x, z)
	local sim = alife()
	local list = {}
	for _, comm in ipairs(comms) do
		for _, id in ipairs(olr_offline_task.cached_stalkers(comm)) do
			local se = sim:object(id)
			if may_join(se, allowed) then
				local dx, dz = se.position.x - x, se.position.z - z
				table.insert(list, { se = se, score = math.sqrt(dx * dx + dz * dz) - se:rank() * 0.2 + math.random(200) })
			end
		end
	end
	table.sort(list, function(a, b) return a.score < b.score end)
	local out = {}
	for i = 1, math.min(want, #list) do table.insert(out, list[i].se) end
	return out
end

local function pick_squad(t)
	local c = config()
	local allowed = olr_smart_index.neighbour_levels(t.level)
	allowed[t.level] = true
	local half = math.ceil(c.patrol_size / 2)
	local duty = pick_from({ "dolg" }, allowed, half, t.x, t.z)
	local hunters = pick_from({ "stalker", "green" }, allowed, c.patrol_size - #duty, t.x, t.z)
	if #hunters < c.patrol_size - half then
		duty = pick_from({ "dolg" }, allowed, c.patrol_size - #hunters, t.x, t.z)
	end
	plog("squad for %s: %d Duty, %d hunters could go", t.level, #duty, #hunters)
	local out = {}
	for _, se in ipairs(duty) do table.insert(out, se) end
	for _, se in ipairs(hunters) do table.insert(out, se) end
	return out
end

-- people who would shoot a party on sight: a soldiers' post is no place to gather or to bed down
local function enemies_around(smart, lvl)
	local sim = alife()
	for _, comm in ipairs({ "military", "bandit", "killer", "monolith", "zombied" }) do
		for _, id in ipairs(olr_offline_task.cached_stalkers(comm)) do
			local se = sim:object(id)
			if se and IsStalker(se) and se:alive() and se.position:distance_to(smart.position) <= config().patrol_lair_dist and olr_smart_index.object_level(se) == lvl then return true end
		end
	end
	return false
end

local function mutants_around(smart, lvl)
	local sim = alife()
	for _, id in ipairs(olr_offline_task.cached_monsters()) do
		local se = sim:object(id)
		if se and IsMonster(se) and se:alive() and ( is_prey(se:section_name()) or string.find(se:section_name(), "dog", 1, true) ) and se.position:distance_to(smart.position) <= config().patrol_lair_dist and olr_smart_index.object_level(se) == lvl then return true end
	end
	return false
end

-- binds him to the nearest smart here that will have him, from "from" metres out; nil if none will.
-- A place to gather (from given) has no mutants around it
local function bind_near(se, lvl, x, z, from)
	local min2 = ( from or 0 ) * ( from or 0 )
	for _, rec in ipairs(olr_smart_index.smarts_near(lvl, x, z)) do
		local smart = rec.d >= min2 and olr_smart_index.get_obj(rec.name)
		if smart and not ( from and ( string.find(rec.name, "lair", 1, true) or mutants_around(smart, lvl) ) ) and not enemies_around(smart, lvl) and olr_smart_index.is_story_open(rec.name) and not olr_smart_index.is_locked(rec.name) and smart:enabled(se)
			and olr_smart_index.attach_checked(se, rec.name)
		then
			return rec.name, smart
		end
	end
	return nil
end

local function send_home(id, m)
	local se = alife():object(id)
	if not ( se and IsStalker(se) and se:alive() ) then return end
	if m.spawned then
		-- he stays in the Zone, a stalker like any other
		xrs_utils.clear_smart_terrain(se)
		se:brain():can_choose_alife_tasks(true)
		plog("%s id=%d is on his own now", se:name(), id)
		return
	end
	if m.home and olr_smart_index.attach_checked(se, m.home) then
		plog("%s id=%d goes back to %s", se:name(), id, m.home)
	else
		plog("%s id=%d: %s will not have him back, left as he is", se:name(), id, tostring(m.home))
	end
	olr_trader_runs.haul_ready_now(id)
end

-- news reacts to parties here; on_olr_event is absent until the news overhaul lands
local function notify(event, p, result)
	if p.kind == "test" or not news_main.on_olr_event then return end
	local n = 0
	for _ in pairs(p.members) do n = n + 1 end
	news_main.on_olr_event(event, { party_kind = p.kind, level = p.level, members = n, deaths = p.deaths or 0, result = result })
end

local function finish(p, result)
	notify("party_end", p, result)
	plog("%s party on %s over: %s", p.kind, p.level, result)
	if p.kind ~= "test" then
		-- those who came back with fewer men say it differently; plain lines if there are none
		local line = "olr_patrol_" .. result .. "_" .. p.kind .. "_"
		local hurt = "olr_patrol_" .. result .. "_hurt_" .. p.kind .. "_"
		if ( p.deaths or 0 ) > 0 and olr_trader_runs.line_total(hurt) > 0 then line = hurt end
		plog("%d men lost, line set %s", p.deaths or 0, line)
		say(line, p)
	end
	local members = p.members
	state().p = nil
	if p.kind ~= "test" then
		for key, m in pairs(members) do send_home(tonumber(key), m) end
		local c = config()
		cur.next = now() + math.random(c.patrol_cd_min_h, c.patrol_cd_max_h) * 3600
	end
	save()
	lag_since, goal_cache, stall = {}, {}, {}
end

-- a friendly place to gather; the reasons others were passed over go to the log
local function find_rally(t)
	local c = config()
	local min2 = c.patrol_rally_dist * c.patrol_rally_dist
	local why = { close = 0, lair = 0, closed = 0, enemies = 0, mutants = 0, you = 0 }
	for _, rec in ipairs(olr_smart_index.smarts_near(t.level, t.x, t.z)) do
		local smart = olr_smart_index.get_obj(rec.name)
		if smart then
			if rec.d < min2 then why.close = why.close + 1
			elseif string.find(rec.name, "lair", 1, true) then why.lair = why.lair + 1
			elseif not olr_smart_index.is_story_open(rec.name) or olr_smart_index.is_locked(rec.name) then why.closed = why.closed + 1
			elseif t.level == level.name() and smart.position:distance_to(db.actor:position()) <= NEAR_ACTOR then why.you = why.you + 1
			elseif enemies_around(smart, t.level) then why.enemies = why.enemies + 1
			elseif mutants_around(smart, t.level) then why.mutants = why.mutants + 1
			else
				plog("gathering at %s; passed over: %d too close, %d lairs, %d closed, %d near you, %d with enemies, %d with mutants", rec.name, why.close, why.lair, why.closed, why.you, why.enemies, why.mutants)
				return smart
			end
		end
	end
	plog("nowhere to gather on %s: %d too close, %d lairs, %d closed, %d near you, %d with enemies, %d with mutants", t.level, why.close, why.lair, why.closed, why.you, why.enemies, why.mutants)
	return nil
end

-- a new man at this spot: no smart, no brain of his own until the party is over
local function spawn_man(comm, pos, lv, gv)
	local list = SECTIONS[comm]
	local section = list[math.random(#list)]
	if not system_ini():section_exist(section) then
		plog("no section %s", section)
		return nil
	end
	local se = alife():create(section, pos, lv, gv)
	if not se then return nil end
	local pk = get_netpk(se)
	local data = pk:get()
	data.custom_data = "[smart_terrains]\nnone = true\n"
	pk:set(data)
	se.smart_terrain_conditions = { none = xr_logic.parse_condlist(se, "smart_terrains", "none", "true") }
	se.has_none_true = true
	smart_terrain.unregister_npc(se)
	se:brain():can_choose_alife_tasks(false)
	olr_squads.track(se.id, comm)
	plog("%s id=%d rank=%d spawned for the party", se:name(), se.id, se:rank())
	return se
end

local function add_spawned(t, comm, pos, lv, gv, idx)
	local se = spawn_man(comm, pos, lv, gv)
	if not se then return nil end
	t.members[tostring(se.id)] = { spawned = true, rank = se:rank(), idx = idx, who = olr_trader_runs.display_name(se) }
	return se
end

local function best_leader(t)
	local best = -1
	t.leader = nil
	for key, m in pairs(t.members) do
		if m.rank > best then t.leader, best = tonumber(key), m.rank end
	end
end

local function start(t)
	local c = config()
	local n = now()
	t.stage = "gather"
	t.members = {}
	t.due = n + c.patrol_gather_h * 3600
	t.deadline = n + c.patrol_deadline_h * 3600
	local rally = find_rally(t)
	if not rally then return false end
	t.rally, t.rx, t.ry, t.rz, t.rlv = rally:name(), rally.position.x, rally.position.y, rally.position.z, rally.m_level_vertex_id
	-- is_member must hold before the smart is asked, so that it takes them as travellers
	state().p = t
	local sim = alife()
	local idx = 0
	local duty, hunters = 0, 0
	for _, se in ipairs(pick_squad(t)) do
		local sid = se:smart_terrain_id()
		local home = sid ~= BAD_OBJ_ID and sim:object(sid)
		local key = tostring(se.id)
		t.members[key] = { home = home and home:name() or nil, rank = se:rank(), idx = idx, who = olr_trader_runs.display_name(se) }
		if rally:enabled(se) and olr_smart_index.attach_checked(se, t.rally) then
			idx = idx + 1
			if se:community() == "dolg" then duty = duty + 1 else hunters = hunters + 1 end
			plog("%s id=%d rank=%d %s from %s heads for %s", se:name(), se.id, se:rank(), se:community(), home and home:name() or "no smart", t.rally)
		else
			plog("%s id=%d: %s will not have him, he stays out", se:name(), se.id, t.rally)
			t.members[key] = nil
		end
	end
	-- the rest are new faces: the Zone has few to spare, so a party stays a rare sight
	local half = math.ceil(c.patrol_size / 2)
	while idx < c.patrol_size do
		local comm = duty < half and "dolg" or "stalker"
		if not add_spawned(t, comm, rally.position, rally.m_level_vertex_id, rally.m_game_vertex_id, idx) then break end
		idx = idx + 1
		if comm == "dolg" then duty = duty + 1 else hunters = hunters + 1 end
	end
	if idx < c.patrol_min then
		plog("%s on %s: only %d men, called off", t.kind, t.level, idx)
		for key, m in pairs(t.members) do send_home(tonumber(key), m) end
		state().p = nil
		save()
		return false
	end
	best_leader(t)
	save()
	plog("%s party gathers at %s on %s, %d men (%d Duty, %d hunters), leader id=%d, target %.0f,%.0f", t.kind, t.rally, t.level, idx, duty, hunters, t.leader, t.x, t.z)
	notify("party_start", t)
	say("olr_patrol_start_" .. t.kind .. "_", t, t.members[tostring(t.leader)].who)
	return true
end

function try_start(kind)
	local region = olr_smart_index.region_levels()
	if not region then return false end
	local t = nil
	if kind ~= "raid" and ( kind == "alpha" or math.random(100) <= config().patrol_alpha_chance ) then t = pick_alpha(region) end
	if t then return start(t) end
	if kind ~= "alpha" then
		for _, lair in ipairs(pick_lair(region)) do
			if start(lair) then return true end
		end
	end
	plog("nothing to hunt near here, or nowhere to gather (%s)", tostring(kind))
	return false
end

-- ---------------------------------------------------------------------------
-- on foot
-- ---------------------------------------------------------------------------
local function parts_on(npc)
	local n = 0
	npc:iterate_inventory(function(_, item)
		if string.sub(item:section(), 1, 7) == "mutant_" then n = n + 1 end
	end)
	return n
end

-- every member as he is now
function watch()
	local p = state().p
	if not p then
		plog("watch: no party")
		return
	end
	local sim = alife()
	local target = vector():set(p.x, p.y, p.z)
	local leader = sim:object(p.leader)
	plog("watch: %s %s on %s, you are on %s, reached=%s clear=%s returning=%s", p.kind, p.stage, p.level, level.name(), tostring(p.reached ~= nil), tostring(p.clear ~= nil), tostring(p.returning == true))
	for key, m in pairs(p.members) do
		local se = sim:object(tonumber(key))
		local npc = se and se.online and level.object_by_id(se.id)
		if npc then
			local e = npc:best_enemy()
			plog("  id=%s %s%s online, %.0f m to target, %.0f m to leader, action=%s enemy=%s hp=%.2f parts=%d", key, se:name(), tonumber(key) == p.leader and " LEADER" or "",
				npc:position():distance_to(target), leader and se.position:distance_to(leader.position) or -1, tostring(npc:motivation_action_manager():current_action_id()),
				e and e:name() or "none", npc.health, parts_on(npc))
			if tonumber(key) == p.leader then
				local pos = npc:position()
				plog("  leader at %.1f,%.1f,%.1f vertex %d, goal vertex %d is %.1f m from the target, goal_ok=%s path_done=%s moving=%s lag=%s", pos.x, pos.y, pos.z, npc:level_vertex_id(), p.lv, level.vertex_position(p.lv):distance_to(target), tostring(npc:accessible(p.lv)), tostring(npc:path_completed()), tostring(npc:movement_enabled()), tostring(lag_since[se.id] ~= nil))
			end
		elseif se then
			plog("  id=%s %s%s offline on %s, %.0f m to target, %.0f m to leader, hp=%.2f", key, se:name(), tonumber(key) == p.leader and " LEADER" or "",
				tostring(olr_smart_index.object_level(se)), se.position:distance_to(target), leader and se.position:distance_to(leader.position) or -1, se:health())
		end
	end
end

-- the leader's goal, with a way round: a vertex can be closed (anomaly on it) or cut off, and then the path never comes.
-- Stood still while walking: steps toward the target by any open direction; still nothing, the party gives up.
local function leader_goal(npc, p)
	local t = time_global()
	local pos = npc:position()
	if npc:best_enemy() or npc:motivation_action_manager():current_action_id() ~= olr_group_walk.evid then
		stall = {}
		return p.lv
	end
	if not stall.pos or pos:distance_to(stall.pos) >= STALL_MOVE then
		stall.pos, stall.since = vector():set(pos.x, pos.y, pos.z), t
	end
	if stall.step and pos:distance_to(level.vertex_position(stall.step)) <= 3 then stall.step = nil end
	if not stall.said_closed and not npc:accessible(p.lv) then
		stall.said_closed = true
		local nearest = utils.send_to_nearest_accessible_vertex(npc, p.lv)
		plog("goal vertex %d is closed to %s, nearest open %d is %.1f m from it, in=[%s]", p.lv, npc:name(), nearest, level.vertex_position(nearest):distance_to(level.vertex_position(p.lv)), npc:in_restrictions())
	end
	if t - stall.since >= STALL_STEP_MS and t >= ( stall.next_try or 0 ) then
		stall.next_try = t + STALL_STEP_MS
		stall.tries = ( stall.tries or 0 ) + 1
		if stall.tries > STALL_TRIES then
			if not p.stalled then plog("%s id=%d cannot get anywhere near the target, the party gives up", npc:name(), npc:id()) end
			p.stalled = true
			return p.lv
		end
		local to = level.vertex_position(p.lv)
		local dx, dz = to.x - pos.x, to.z - pos.z
		local len = math.sqrt(dx * dx + dz * dz)
		local own = npc:level_vertex_id()
		stall.step = nil
		for _, a in ipairs({ 0, 45, -45, 90, -90, 135, -135 }) do
			local r = math.rad(a)
			local dir = vector():set(( dx * math.cos(r) - dz * math.sin(r) ) / len, 0, ( dx * math.sin(r) + dz * math.cos(r) ) / len)
			local lvid = level.vertex_in_direction(own, dir, STALL_STEP_DIST)
			if lvid ~= own and npc:accessible(lvid) then
				stall.step = lvid
				plog("%s id=%d stood still %d s, try %d: steps %d deg off the line to vertex %d", npc:name(), npc:id(), ( t - stall.since ) / 1000, stall.tries, a, lvid)
				break
			end
		end
	end
	return stall.step or p.lv
end

-- olr_group_walk asks: a vertex and a pace, or nil if this NPC has nowhere to go with the group
function walk_goal(npc)
	if not db.actor then return nil end
	local p = state().p
	if not ( p and p.stage == "hunt" and p.level == level.name() ) then return nil end
	local id = npc:id()
	local m = p.members[tostring(id)]
	if not m then return nil end
	-- two planner goals that each wait for the other leave him with no plan at all
	if olr_trader_runs.on_run(id) then return nil end
	if config().patrol_trace == 1 and time_global() >= trace_next then
		trace_next = time_global() + 5000
		watch()
	end
	local dist = npc:position():distance_to(level.vertex_position(p.lv))
	local leader = id ~= p.leader and level.object_by_id(p.leader) or nil
	if id == p.leader or not leader then
		if dist <= config().patrol_reach_dist then
			if not p.reached then
				p.reached = now()
				save()
				plog("%s id=%d reached the target", npc:name(), id)
			end
			return p.lv, "hold"
		end
		if id == p.leader then
			local t = time_global()
			local lag = false
			for key in pairs(p.members) do
				local o = tonumber(key) ~= id and level.object_by_id(tonumber(key))
				if o and o:alive() and o:position():distance_to(npc:position()) > LAG_DIST then lag = true end
			end
			if lag then
				lag_since[id] = lag_since[id] or t
				if t - lag_since[id] < LAG_WAIT_MS then return p.lv, "hold" end
				if t - lag_since[id] > LAG_WAIT_MS + LAG_RESET_MS then lag_since[id] = nil end
			else
				lag_since[id] = nil
			end
		end
		return id == p.leader and leader_goal(npc, p) or p.lv, "walk"
	end
	-- in his wake: rows of two behind him
	local back = leader:direction()
	local row = math.floor(m.idx / 2) + 1
	local side = m.idx % 2 == 0 and 1 or -1
	local ox, oz = -back.x * 3 * row - back.z * 2.5 * side, -back.z * 3 * row + back.x * 2.5 * side
	local len = math.sqrt(ox * ox + oz * oz)
	local lvid = level.vertex_in_direction(leader:level_vertex_id(), vector():set(ox / len, 0, oz / len), len)
	local from_leader = npc:position():distance_to(leader:position())
	local from_spot = npc:position():distance_to(level.vertex_position(lvid))
	if from_leader > LAG_DIST then return lvid, "catch" end
	if from_spot <= 2.5 then return npc:level_vertex_id(), "hold" end
	return lvid, "walk"
end

-- ---------------------------------------------------------------------------
-- how it ends if nobody sees it
-- ---------------------------------------------------------------------------
local function take_prey_part(p, se, winner)
	local part = monster_parts.get_monster_part(se:section_name())
	if part and part ~= "" and winner then
		local item = misc.spawn_to(part, winner)
		misc.process_spawn()
		plog("%s id=%d cut a %s: %s", winner:name(), winner.id, part, tostring(item ~= nil))
	end
end

local function lair_mutants(p)
	local sim = alife()
	local out = {}
	local here = vector():set(p.x, p.y, p.z)
	for _, id in ipairs(olr_offline_task.cached_monsters()) do
		local se = sim:object(id)
		if se and IsMonster(se) and se:alive() and not se.online and is_prey(se:section_name()) and se.position:distance_to(here) <= config().patrol_lair_dist
			and olr_smart_index.object_level(se) == p.level
		then
			table.insert(out, se)
		end
	end
	return out
end

-- whatever is alive around the target, online or not
function prey_near(p)
	local sim = alife()
	local here = vector():set(p.x, p.y, p.z)
	local out = {}
	for _, id in ipairs(olr_offline_task.cached_monsters()) do
		local se = sim:object(id)
		if se and IsMonster(se) and se:alive() and is_prey(se:section_name()) and se.position:distance_to(here) <= config().patrol_lair_dist and olr_smart_index.object_level(se) == p.level then
			table.insert(out, se)
		end
	end
	return out
end

local function resolve(p)
	local c = config()
	local sim = alife()
	local alive = {}
	local power = 0
	for key in pairs(p.members) do
		local se = sim:object(tonumber(key))
		if se and IsStalker(se) and se:alive() then
			table.insert(alive, se)
			power = power + math.min(se:rank(), 1200) / 300
		end
	end
	if #alive == 0 then return finish(p, "dead") end
	local hard, prey
	if p.kind == "alpha" then
		prey = sim:object(p.alpha)
		-- what makes it an alpha: it has beaten men before, a party is no sure thing
		hard = ( HARDNESS[p.prey_kind] or 5 ) * c.patrol_alpha_hard
	else
		local list = lair_mutants(p)
		prey = list[1]
		hard = #list * 1.2
		if #list == 0 then return finish(p, "won") end
	end
	if not prey then return finish(p, "won") end
	local chance = math.max(c.patrol_chance_min, math.min(c.patrol_chance_max, 100 * power / ( power + hard )))
	local won = math.random(100) <= chance
	-- not won: most often beaten with losses, sometimes driven off with hardly a scratch on either side
	local driven_off = not won and p.kind == "alpha" and math.random(100) <= c.patrol_driven_off
	local losses = won and math.random(0, 1) or driven_off and math.random(0, 1) or math.random(1, 2)
	plog("%s on %s decided unseen: %d men, power %.1f against %.1f, chance %.0f, won=%s, losses %d", p.kind, p.level, #alive, power, hard, chance, tostring(won), losses)
	for i = 1, losses do
		if #alive == 0 then break end
		local se = table.remove(alive, math.random(#alive))
		plog("%s id=%d dies in the fight", se:name(), se.id)
		p.members[tostring(se.id)] = nil
		p.deaths = ( p.deaths or 0 ) + 1
		news_main.on_offline_death(se, prey)
		sim:release(se, true)
	end
	if won then
		if p.kind == "alpha" then
			take_prey_part(p, prey, alive[1])
			olr_alpha.killed_offline(p.alpha, false)
			sim:release(prey, true)
		else
			local list = lair_mutants(p)
			for i = 1, math.min(#list, c.patrol_raid_kills) do
				take_prey_part(p, list[i], alive[i % math.max(#alive, 1) + 1])
				sim:release(list[i], true)
			end
		end
	end
	if #alive == 0 then return finish(p, "dead") end
	finish(p, won and "won" or driven_off and "driven" or "lost")
end

-- who killed a member, and an anomaly on the way home ends the march: the rest would follow him in
function on_npc_death(npc, who)
	local p = db.actor and state().p
	if not ( p and npc and p.members[tostring(npc:id())] ) then return end
	local name = who and who:name() or "nobody"
	plog("%s id=%d killed by %s, %.1f m from it, %.0f m from the target", npc:name(), npc:id(), name, who and npc:position():distance_to(who:position()) or -1, npc:position():distance_to(vector():set(p.x, p.y, p.z)))
	if p.returning and string.find(name, "zone", 1, true) and not p.spooked then
		p.spooked = true
		plog("an anomaly on the way back: they stop here and go their own ways")
	end
end

local function begin_hunt(p)
	local n = now()
	local c = config()
	p.stage = "hunt"
	p.due = n + c.patrol_hunt_h * 3600
	p.deadline = n + c.patrol_deadline_h * 3600
	local idx = 0
	for key, m in pairs(p.members) do
		local se = alife():object(tonumber(key))
		if se then
			m.idx = idx
			idx = idx + 1
			local name = not m.spawned and bind_near(se, p.level, p.x, p.z)
			plog("%s id=%s moves out, %s", se:name(), key, m.spawned and "no smart" or ( "bound to " .. tostring(name) ))
		end
	end
	save()
	plog("%s party moves out with %d men", p.kind, idx)
	say("olr_patrol_out_" .. p.kind .. "_", p, p.members[tostring(p.leader)] and p.members[tostring(p.leader)].who)
end

local function drop_dead(p)
	local sim = alife()
	local left = 0
	for key in pairs(p.members) do
		local se = sim:object(tonumber(key))
		if se and IsStalker(se) and se:alive() then
			left = left + 1
		else
			plog("id=%s is dead", key)
			p.members[key] = nil
			p.deaths = ( p.deaths or 0 ) + 1
			if tonumber(key) == p.leader then
				p.leader = tonumber(( next(p.members) ))
				plog("id=%s leads now", tostring(p.leader))
			end
		end
	end
	return left
end

local function gather_tick(p, n)
	local sim = alife()
	local here = 0
	local total = 0
	local rally = vector():set(p.rx, p.ry, p.rz)
	for key in pairs(p.members) do
		local se = sim:object(tonumber(key))
		total = total + 1
		if se and olr_smart_index.object_level(se) == p.level and se.position:distance_to(rally) <= config().patrol_arrive_dist then
			here = here + 1
		end
	end
	if here < total and n < p.due then return end
	plog("%d of %d gathered at %s", here, total, p.rally)
	if here < 2 then return finish(p, "called") end
	for key, m in pairs(p.members) do
		local se = sim:object(tonumber(key))
		if se and not ( olr_smart_index.object_level(se) == p.level and se.position:distance_to(rally) <= config().patrol_arrive_dist ) then
			plog("%s id=%s did not make it", se:name(), key)
			p.members[key] = nil
			if tonumber(key) == p.leader then p.leader = nil end
			send_home(tonumber(key), m)
		end
	end
	if not p.leader then p.leader = tonumber(( next(p.members) )) end
	begin_hunt(p)
end

local function hunt_tick(p, n)
	if p.stalled then return finish(p, "trail") end
	local sim = alife()
	if p.kind == "alpha" then
		local a = sim:object(p.alpha)
		if not p.clear then
			if not ( a and IsMonster(a) and a:alive() ) then
				-- as after a raid: they see to the body, then go back together
				p.clear = now()
				plog("'%s' is dead, they see to the body and hold together", tostring(p.prey_name))
			elseif olr_smart_index.object_level(a) ~= p.level then
				return finish(p, "trail")
			else
				p.x, p.y, p.z, p.lv = a.position.x, a.position.y, a.position.z, a.m_level_vertex_id
			end
		end
	end
	local online = false
	for key in pairs(p.members) do
		local se = sim:object(tonumber(key))
		if se and se.online then online = true end
	end
	if p.reached and p.kind == "raid" and not p.clear then
		local left = #prey_near(p)
		if left ~= p.prey_left then
			plog("%d mutants left around the target", left)
			p.prey_left = left
		end
		if left == 0 then
			p.clear = now()
			plog("nothing left around the target, they see to the bodies and hold together")
		end
	end
	if p.kind == "test" and p.reached and now() - p.reached >= 120 then return finish(p, "done") end
	-- looting comes before the walk in the planner, so holding them does not stop it
	if p.clear and not p.returning and now() - p.clear >= config().patrol_linger_h * 3600 then
		p.returning = true
		p.x, p.y, p.z, p.lv = p.rx, p.ry, p.rz, p.rlv
		p.reached = nil
		p.due = n + config().patrol_return_h * 3600
		plog("they walk back to the gathering place together")
		save()
	end
	if p.returning and ( p.reached or p.spooked ) then return finish(p, "won") end
	if n >= p.deadline then return finish(p, "trail") end
	if online or n < p.due then return end
	if p.returning then return finish(p, "won") end
	if p.level == level.name() and vector():set(p.x, p.y, p.z):distance_to(db.actor:position()) <= NEAR_ACTOR then return end
	resolve(p)
end

function update()
	if not ( db.actor and olr_cfg.on("patrols") ) then return end
	olr_smart_index.ensure()
	local st = state()
	local n = now()
	local p = st.p
	if p then
		if drop_dead(p) == 0 then return finish(p, "dead") end
		if p.stage == "gather" then gather_tick(p, n) else hunt_tick(p, n) end
		if st.p then save() end
		return
	end
	if not st.next then
		st.next = n + config().patrol_first_h * 3600
		save()
		return
	end
	if n < st.next or olr_cfg.grace_active() then return end
	if not try_start() then
		st.next = n + 6 * 3600
		save()
	end
end

-- ---------------------------------------------------------------------------
-- test helpers
-- ---------------------------------------------------------------------------
function report()
	local st = state()
	local n = now()
	plog("on=%s next in %.1f h", tostring(olr_cfg.on("patrols")), ( ( st.next or n ) - n ) / 3600)
	local p = st.p
	if not p then return end
	plog("  %s on %s stage=%s prey=%s leader=%s rally=%s due in %.1f h, deadline %.1f h, reached=%s", p.kind, p.level, p.stage, tostring(p.prey_name or p.lair), tostring(p.leader),
		tostring(p.rally), ( p.due - n ) / 3600, ( p.deadline - n ) / 3600, tostring(p.reached ~= nil))
	for key, m in pairs(p.members) do
		local se = alife():object(tonumber(key))
		plog("  id=%s %s %s rank=%d on %s online=%s home=%s", key, se and se:name() or "?", se and se:community() or "?", se and se:rank() or 0,
			se and tostring(olr_smart_index.object_level(se)) or "?", se and tostring(se.online) or "?", tostring(m.home))
	end
end

-- an alpha for test_here: one already on this level, or a new one in the most open direction
local function alpha_here()
	local here = level.name()
	local t = pick_alpha({ [here] = true })
	if t then return t end
	-- at a place with no people, far enough for a walk
	local pos = db.actor:position()
	local spot = nil
	local camps = olr_cfg.camp_list()
	for _, rec in ipairs(olr_smart_index.smarts_near(here, pos.x, pos.z)) do
		local smart = olr_smart_index.get_obj(rec.name)
		if smart and rec.d >= 100 * 100 and not camps[rec.name] and not enemies_around(smart, here) then
			spot = smart
			break
		end
	end
	if not spot then
		plog("test_here: no empty smart 100 m or more from you")
		return nil
	end
	local best_d = spot.position:distance_to(pos)
	local se = alife():create("bloodsucker_normal", spot.position, spot.m_level_vertex_id, spot.m_game_vertex_id)
	if not se then return nil end
	plog("test_here: bloodsucker_normal id=%d spawned %.0f m from you, make=%s", se.id, best_d, tostring(olr_alpha.make(se.id)))
	return pick_alpha({ [here] = true })
end

function test_here(kind)
	if state().p and state().p.kind ~= "test" then
		plog("test_here: a party is already out")
		return
	end
	if state().p then finish(state().p, "done") end
	olr_smart_index.ensure()
	local lair = nil
	local here = level.name()
	if kind == "alpha" then
		lair = alpha_here()
	else
		for _, t in ipairs(pick_lair({ [here] = true })) do
			local dist = vector():set(t.x, t.y, t.z):distance_to(db.actor:position())
			if dist >= 60 and ( not lair or dist < lair.d2 ) then
				lair = t
				lair.d2 = dist
			end
		end
	end
	if not lair then
		plog("test_here: no target 60 m or more from you on %s, patrol_levels counts too", here)
		return
	end
	local n = now()
	lair.d2 = nil
	lair.stage, lair.members = "gather", {}
	lair.due, lair.deadline = n, n + config().patrol_deadline_h * 3600
	lair.rally, lair.rx, lair.ry, lair.rz, lair.rlv = "here", db.actor:position().x, db.actor:position().y, db.actor:position().z, db.actor:level_vertex_id()
	state().p = lair
	local dir = db.actor:direction()
	local lv = level.vertex_in_direction(db.actor:level_vertex_id(), vector():set(dir.x, 0, dir.z), 25)
	local pos = level.vertex_position(lv)
	for i = 0, config().patrol_size - 1 do
		add_spawned(lair, i % 2 == 0 and "dolg" or "stalker", pos, lv, db.actor:game_vertex_id(), i)
	end
	best_leader(lair)
	plog("test_here: %s %s is %.0f m from you", lair.kind, tostring(lair.lair or lair.prey_name), vector():set(lair.x, lair.y, lair.z):distance_to(db.actor:position()))
	begin_hunt(lair)
end

function force(kind)
	olr_smart_index.ensure()
	local old = state().p
	if old and old.kind == "test" then
		finish(old, "done")
	elseif old then
		plog("force: a party is already out")
		return
	end
	plog("force %s: %s", tostring(kind), tostring(try_start(kind)))
end

function force_hunt()
	local p = state().p
	if p and p.stage == "gather" then
		local smart = olr_smart_index.get_obj(p.rally)
		for key in pairs(p.members) do
			local se = alife():object(tonumber(key))
			if se and not se.online and smart then alife():teleport_object(se.id, smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id) end
		end
		begin_hunt(p)
	else plog("force_hunt: nobody is gathering") end
end

function force_resolve()
	local p = state().p
	if p then resolve(p) else plog("force_resolve: no party") end
end

function stop()
	local p = state().p
	if p then finish(p, "called") else plog("stop: no party") end
end

function go()
	local p = state().p
	local se = p and ( alife():object(p.leader) or alife():object(tonumber(( next(p.members) ))) )
	if not se then
		plog("go: no party")
		return
	end
	plog("go: to %s id=%d on %s", se:name(), se.id, tostring(olr_smart_index.object_level(se)))
	if olr_smart_index.object_level(se) == level.name() then
		db.actor:set_actor_position(se.position)
	else
		spawner.create_level_changers(se.m_level_vertex_id, se.m_game_vertex_id, se.position)
	end
end

-- the farthest of eight directions, up to dist: walls stop vertex_in_direction short
local function open_vertex(dist)
	local a0 = db.actor:level_vertex_id()
	local here = db.actor:position()
	local best, best_d = a0, 0
	local dir = db.actor:direction()
	local base = math.atan2(dir.z, dir.x)
	for i = 0, 7 do
		local a = base + i * math.pi / 4
		local lv = level.vertex_in_direction(a0, vector():set(math.cos(a), 0, math.sin(a)), dist)
		local d = level.vertex_position(lv):distance_to(here)
		if d > best_d + 5 then best, best_d = lv, d end
	end
	return best, best_d
end

function test_walk(dist)
	local old = state().p
	if old and old.kind ~= "test" then
		plog("test_walk: a party is already out")
		return
	end
	cur.p = nil
	local list = {}
	local here = db.actor:position()
	for id in pairs(db.storage) do
		local npc = id ~= db.actor:id() and level.object_by_id(id)
		if npc and IsStalker(npc) and npc:alive() and not npc:is_talking() and npc:story_id() >= 4294967295 and not olr_trader_runs.on_run(id) and npc:position():distance_to(here) <= 100
			and not olr_protected.is_no_offline_alife_obj(npc:name())
		then
			table.insert(list, { npc = npc, d = npc:position():distance_to(here) })
		end
	end
	table.sort(list, function(a, b) return a.d < b.d end)
	if #list == 0 then
		plog("test_walk: no stalker online")
		return
	end
	local lv, away = open_vertex(dist or 60)
	plog("test_walk: target %.0f m from you", away)
	local pos = level.vertex_position(lv)
	local n = now()
	local p = { kind = "test", stage = "hunt", level = level.name(), x = pos.x, y = pos.y, z = pos.z, lv = lv, members = {}, due = n + 999 * 3600, deadline = n + 24 * 3600 }
	for i = 1, math.min(4, #list) do
		local id = list[i].npc:id()
		p.members[tostring(id)] = { idx = i - 1 }
		if i == 1 then p.leader = id end
		plog("test_walk: %s id=%d, %.0f m from you", list[i].npc:name(), id, list[i].d)
	end
	cur.p = p
	save()
end
