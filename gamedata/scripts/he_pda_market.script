-- [HE-PORT]

local HEARTBEAT_MS = 5000
local MARKET_INFO  = "he_pda_market_open"
local STARTED_KEY  = "he_pda_started"
local ACQUIRED_KEY = "he_pda_legitimate_acquired"
local PENDING_KEY  = "he_pda_drop_pending"
local START_LEVEL  = "l01_escape"
local DROP_TRIES   = 6
local TRADER_IDS   = { 3, 500 }
local trader_states = {}
local last_update_state

local function report_trader( sid, state )
	if trader_states[ sid ] == state then return end
	trader_states[ sid ] = state
	log2( "[he_pda_market] trader=%s %s", tostring( sid ), state )
end

function attach( sm )
	log2( "[he_pda_market] attach" )
	sm:subscribe( { signal = "on_late_init_all", fun = this.on_late_init } )
	sm:subscribe( { signal = "on_update", fun = this.on_update } )
	sm:subscribe( { signal = "on_trade", fun = this.on_trade } )
	sm:subscribe( { signal = "on_trade_open", fun = this.on_trade_open } )
end

function cancel_startup_removal()
	set_value( ACQUIRED_KEY, true )
	remove_value( PENDING_KEY )
	log2( "[he_pda_market] startup_removal_cancelled" )
end

function on_trade( item, sell_buy, money )
	if sell_buy == false and item and item.section and he_pda_model.is_pda_section(item:section()) then
		cancel_startup_removal()
		log2( "[he_pda_market] acquired_from_trade item=%s", tostring( item:id() ) )
	end
end

local function drop_actor_pda()
	if he_pda_access.is_busy() then return false end
	if get_value( ACQUIRED_KEY ) == true then
		remove_value( PENDING_KEY )
		return true
	end
	local pda = he_pda_model.get_pda()
	level.set_actor_allow_pda( false )
	if not pda then return false end
	misc.release_obj( pda )
	return true
end

local function sync_actor_pda()
	local pda = he_pda_model.get_pda()
	if not pda then
		level.set_actor_allow_pda( false )
	elseif db.actor:has_info("pda_is_broken") and not pda_battery.is_charging() then
		level.set_actor_allow_pda(true) -- open the retained model; screen/input are locked by sivol_pda
	elseif pda:condition() > 0 and not db.actor:has_info( "pda_is_broken" )
		and not pda_battery.is_charging() then
		level.set_actor_allow_pda( true )
	end
end

local function sync_trader( sid, sobj )
	if not sobj then
		report_trader( sid, "story_object=nil" )
		return
	end
	if not sobj.online then
		report_trader( sid, "online=0" )
		return
	end
	local npc = level.object_by_id( sobj.id )
	if not npc then
		report_trader( sid, "online=1 client=nil" )
		return
	end
	local pda = npc:object( "device_pda" )
	if pda then misc.release_obj( pda ) end
	report_trader( sid, string.format( "name=%s online=1 client=1 dialogue_only=true removed=%s", npc:name(), tostring( pda ~= nil ) ) )
end

function on_late_init()
	if not db.actor then return end
	if get_value( ACQUIRED_KEY ) == true then
		remove_value( PENDING_KEY )
		log2( "[he_pda_market] late_init skip=legitimate_acquisition" )
		return
	end
	log2( "[he_pda_market] late_init level=%s info=%s started=%s", level.name(), tostring( db.actor:has_info( MARKET_INFO ) ), tostring( get_value( STARTED_KEY ) ~= nil ) )
	if get_value( STARTED_KEY ) ~= nil then return end
	set_value( STARTED_KEY, true )
	if db.actor:has_info( MARKET_INFO ) then return end
	if level.name() ~= START_LEVEL then return end
	if not drop_actor_pda() then
		set_value( PENDING_KEY, DROP_TRIES )
	end
end

function on_update()
	ogse_signals.get_mgr():reschedule( HEARTBEAT_MS )
	if not db.actor then return end
	-- Updates run before late-init: never classify the starter as an acquisition.
	if get_value(STARTED_KEY) == nil then return end
	local update_state = string.format( "level=%s info=%s", level.name(), tostring( db.actor:has_info( MARKET_INFO ) ) )
	if last_update_state ~= update_state then
		last_update_state = update_state
		log2( "[he_pda_market] update %s", update_state )
	end
	if he_pda_access.is_busy() then return end
	local pending = get_value( PENDING_KEY )
	if pending then
		if drop_actor_pda() or pending <= 1 then
			remove_value( PENDING_KEY )
		else
			set_value( PENDING_KEY, pending - 1 )
		end
	else
		sync_actor_pda()
		if he_pda_model.get_pda() and get_value(ACQUIRED_KEY) ~= true then cancel_startup_removal() end
	end
	local unlocked = db.actor:has_info( MARKET_INFO )
	if not unlocked and level.name() == "l03_agroprom" then
		local before = db.actor:has_info( MARKET_INFO )
		db.actor:give_info_portion( MARKET_INFO )
		local after = db.actor:has_info( MARKET_INFO )
		log2( "[he_pda_market] auto_give info=%s before=%s after=%s", MARKET_INFO, tostring( before ), tostring( after ) )
		unlocked = true
	end
	local sim = alife()
	if not sim then return end
	for _, sid in pairs( TRADER_IDS ) do
		local sobj = sim:story_object( sid )
		sync_trader( sid, sobj )
	end
end

function on_trade_open()
	if not alife() then return end
	for _, sid in ipairs(TRADER_IDS) do sync_trader(sid, alife():story_object(sid)) end
end
