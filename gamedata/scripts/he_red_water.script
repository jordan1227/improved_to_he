local LEVEL = "red_forest"
local PERIOD = 500

local X1, X2 = -153.0, -121.0
local Y1, Y2 = -16.0, 0.5
local Z1, Z2 = -306.0, -249.0

local BARRIER = {
	"rf_kill_restr",
	"rf_kill_restr_2",
	"rf_zone_mosquito_bald_strong_1",
	"rf_zone_mosquito_bald_strong_2",
}

local cleaned = false

function attach( sm )
	sm:subscribe( { signal = "on_update", fun = this.on_update } )
end

local function drop_barrier()
	for i = 1, #BARRIER do
		pcall( release, BARRIER[ i ] )
	end
end

local function inside( pos )
	return pos.x > X1 and pos.x < X2
		and pos.y > Y1 and pos.y < Y2
		and pos.z > Z1 and pos.z < Z2
end

function on_update()
	ogse_signals.get_mgr():reschedule( PERIOD )

	if not db.actor then return end
	if level.name() ~= LEVEL then
		cleaned = false
		return
	end

	if not cleaned then
		cleaned = true
		drop_barrier()
	end

	if has_alife_info( "red_scaut_pass_fire" ) then return end
	if has_alife_info( "red_lim_pass_on" ) then return end
	if not inside( db.actor:position() ) then return end

	db.actor:give_info_portion( "red_scaut_pass_fire" )
	db.actor:disable_info_portion( "red_scaut_pass_on" )
end
