local obj_name --имя медицинской прибамбасины
local obj_id --ID медицинской прибамбасины
local flag_help = false -- флаг помощи раненому (true - оказывается помощь, false - помощь не оказывается)
local help_id = -1
local msg_last = 0
local med_overdose = 0
local med_overdose_max = 1
local overdose_last_tick = 0
local overdose_medkits = {
    medkit = true,
    medkit_army = true,
    medkit_scientic = true,
    antirad = true
}
local overdose_occurred = {}
-- Таблицы для хранения активных эффектов и использованных предметов
local active_effects = {} -- флаги активности эффектов
local heal_start = {} -- время начала эффекта
local heal_last = {} -- время последнего применения
local heal_time = {} -- длительность эффекта
local delta_health = {} -- изменение здоровья
local delta_power = {} -- изменение выносливости
local delta_radiation = {} -- изменение радиации
local post_eff = {} -- номер пост-эффекта
local visual_effects_active = {} -- активные визуальные эффекты
local wnd_ar
med = {
    medkit = true,
    medkit_army = true,
    medkit_scientic = true,
    bandage = true,
    energy_drink = true,
    energy_drink_new = true,
    antirad = true
}
local vis_post_eff = {
    "intoxication_1.ppe",
    "intoxication_2.ppe",
    --"black_q.ppe",
    "yantar_underground_psi.ppe",
    "psychic.ppe",
    "escape.ppe",
    "noise.ppe",
    "brighten.ppe"
}

local snd_eff = {
    "scripts\\inv_medkit",
    "scripts\\inv_softdrink",
    "scripts\\inv_pills",
    "scripts\\inv_bandage",
    "device\\tiski_avto_2",
    "device\\tiski_bronik_2",
    "scripts\\inv_medkit_arm",
    "scripts\\inv_medkit_sci",
    "scripts\\inv_antirad"
}
local sound_tip = {
    medkit = 1,
    medkit_army = 7,
    medkit_scientic = 8,
    bandage = 4,
    energy_drink = 2,
    energy_drink_new = 2,
    antirad = 9,
    suvorotka = 2
}
local function active_medkits_count()
    local count = 0
    for k in pairs(active_effects) do
        if overdose_medkits[k] then
            count = count + 1
        end
    end
    return count
end
function use_item(sect, id, flag)
    local obj_name = sect
    local obj_id = id
    if not med[obj_name] then
        log2(string.format("[vergas_medical]: Попытка использовать недопустимый предмет: %s", obj_name))
        return
    end
    log2(string.format("[vergas_medical]: Использование предмета: %s (ID: %d)", obj_name, obj_id))
    if active_effects[obj_name] or (flag_help and obj_id == help_id) then
        log2(string.format("[vergas_medical]: Эффект для %s уже активен.", obj_name))
        if active_effects[obj_name] then
            heal_start[obj_name] = game.get_game_time()
            heal_last[obj_name] = game.get_game_time()
            log2(string.format("[vergas_medical]: Время лечения для %s обновлено.", obj_name))
        end
        flag_help = false
        return
    end
    if overdose_medkits[obj_name] then
        local medkits_active = 0
        for k in pairs(active_effects) do
            if overdose_medkits[k] then
                medkits_active = medkits_active + 1
            end
        end
        if medkits_active > 0 then
            med_overdose = math.min(med_overdose + 1, med_overdose_max)
            log2(string.format("[vergas_medical]: Передозировка +1, текущее %d", med_overdose))
        end
    end
    -- Инициализируем лечение
    init_treatment(obj_name)
end
local function get_heal_coefficient(obj_name, overdose_value)
    local gd = level.get_game_difficulty()
    local current_overdose = overdose_value
    if current_overdose == nil then current_overdose = med_overdose end
    local heal_coef
    if gd == 0 then -- Novice
        heal_coef = 1.225
    elseif gd == 1 then -- Stalker
        heal_coef = 1.2
    elseif gd == 2 then -- Veteran
        heal_coef = 1.175
    elseif gd == 3 then -- Master
        heal_coef = 1.15
    else
        heal_coef = 1.3
    end
    if current_overdose > 0 and overdose_medkits[obj_name] then
        heal_coef = heal_coef / (1 + current_overdose * 0.4)
    end
    return heal_coef
end

-- Read-only preview for inventory UI. Keep this derived from the same
-- coefficient and config fields used by init_treatment().
function get_treatment_preview(obj_name)
    if not med[obj_name] or obj_name == "bandage" then return nil end

    if active_effects[obj_name] and heal_time[obj_name] then
        return {
            duration = heal_time[obj_name] / 60,
            health_per_min = delta_health[obj_name] * 60 * 100,
            power_per_min = delta_power[obj_name] * 60 * 100,
            radiation_per_min = delta_radiation[obj_name] * 60 * 10,
        }
    end

    local duration = vergas_lib.set_pr_from_config(obj_name, "mr_time")
    if not duration or duration <= 0 then return nil end

    local preview_overdose = med_overdose
    if overdose_medkits[obj_name] and active_medkits_count() > 0 then
        preview_overdose = math.min(preview_overdose + 1, med_overdose_max)
    end
    local coef = get_heal_coefficient(obj_name, preview_overdose)
    return {
        duration = duration,
        health_per_min = vergas_lib.set_pr_from_config(obj_name, "mr_eat_health") * coef * 100 / duration,
        power_per_min = vergas_lib.set_pr_from_config(obj_name, "mr_eat_power") * coef * 300 / duration,
        radiation_per_min = vergas_lib.set_pr_from_config(obj_name, "mr_eat_radiation") * coef * 10 / duration,
    }
end

function init_treatment(obj_name)
    local heal_coef = get_heal_coefficient(obj_name)

    heal_time[obj_name] = vergas_lib.set_pr_from_config(obj_name, "mr_time")
    delta_health[obj_name] = vergas_lib.set_pr_from_config(obj_name, "mr_eat_health") / heal_time[obj_name] / 60.0
    delta_power[obj_name] = vergas_lib.set_pr_from_config(obj_name, "mr_eat_power") / heal_time[obj_name] / 20.0
    delta_radiation[obj_name] = vergas_lib.set_pr_from_config(obj_name, "mr_eat_radiation") / heal_time[obj_name] / 60.0
    post_eff[obj_name] = vergas_lib.set_pr_from_config(obj_name, "post_eff")
	
    heal_time[obj_name] = heal_time[obj_name] * 60.0
    delta_health[obj_name] = delta_health[obj_name] * heal_coef
    delta_power[obj_name] = delta_power[obj_name] * heal_coef
    delta_radiation[obj_name] = delta_radiation[obj_name] * heal_coef
	
    heal_start[obj_name] = game.get_game_time()
    heal_last[obj_name] = game.get_game_time()
    log2(string.format("[vergas_medical]: Лечение для %s инициализировано. Время: %d мин.", obj_name, heal_time[obj_name] / 60))
	
    if heal_time[obj_name] > 0 and post_eff[obj_name] and post_eff[obj_name] ~= 0 then
        level.add_pp_effector(vis_post_eff[post_eff[obj_name]], 1021 + #active_effects, true)
        visual_effects_active[obj_name] = true
    end

    active_effects[obj_name] = true
    snd_eat_med(sound_tip[obj_name])

    -- Используем dsh.timeout для периодического вызова medical_procedures
    dsh.timeout(200, function() medical_procedures(obj_name) end)
end
function medical_procedures(obj_name)
    if not active_effects[obj_name] then
        log2(string.format("[vergas_medical]: Лечение для %s завершено, эффект не активен.", obj_name))
        return
    end
    local time_cur = game.get_game_time()
    local d_sec = time_cur:diffSec(heal_last[obj_name])
    local d_heal = time_cur:diffSec(heal_start[obj_name])
	    -- log2(string.format("[vergas_medical]:  Обhаботка медицинских процедур для %s. Прошло времени: секунд..", obj_name, d_sec))
	if d_sec >= 10 then
        heal_last[obj_name] = time_cur
        -- критическая интоксикация
        if med_overdose >= med_overdose_max and overdose_medkits[obj_name] then
            if db.actor then
                overdose_occurred[obj_name] = true -- доп действие по окончании, в зависимости от секции
                db.actor.health = -0.09
                db.actor.power = -0.22
                db.actor.satiety = -0.12
                log3("overdose")
                level.add_pp_effector("surge_shock_old.ppe", 1001, true)
            end
        end
        if d_heal >= heal_time[obj_name] then
            log2(string.format("[vergas_medical]: Время лечения для %s истекло.", obj_name))
            end_treatment(obj_name)
        else
            if db.actor then
                db.actor.health = delta_health[obj_name] * d_sec
                db.actor.power = delta_power[obj_name] * d_sec
                db.actor.radiation = delta_radiation[obj_name] * d_sec
                log2(string.format("[vergas_medical]: Здоровье, выносливость и радиация обновлены для %s.", obj_name))
            end

            -- перезапускаем тайм-аут для следующего вызова
            dsh.timeout(200, function() medical_procedures(obj_name) end)
        end
    else
        -- перезапускаем тайм-аут для следующего вызова
        dsh.timeout(200, function() medical_procedures(obj_name) end)
    end
    -- медленное восстановление организма
    if med_overdose > 0 then
        if d_heal - overdose_last_tick >= 60 then
            med_overdose = med_overdose - 1
            overdose_last_tick = d_heal
        end
    end
end
function end_treatment(obj_name)
    if not active_effects[obj_name] then
        log2(string.format("[vergas_medical]: Завершение лечения для %s не требуется, эффект не активен.", obj_name))
        return
    end

    if visual_effects_active[obj_name] then
        level.remove_pp_effector(1021 + #active_effects)
        visual_effects_active[obj_name] = nil
    end

    active_effects[obj_name] = nil
    heal_start[obj_name] = nil
    heal_last[obj_name] = nil
    heal_time[obj_name] = nil
    delta_health[obj_name] = nil
    delta_power[obj_name] = nil
    delta_radiation[obj_name] = nil
    post_eff[obj_name] = nil
    log2(string.format("[vergas_medical]: Лечение для %s завершено.", obj_name))
    -- небольшое облегчение после завершения курса
    if med_overdose > 0 then
        med_overdose = med_overdose - 1
    end
    -- Обработка передозировки после окончания лечения
    if overdose_occurred[obj_name] then
        overdose_occurred[obj_name] = nil
        -- level.add_pp_effector("alcohol.ppe", 1000, true)
        level.add_cam_effector("camera_effects\\drunk.anm", 150, true, "")
        log2("[vergas_medical]: Передозировка обработана после лечения.")
    end
end
function get_flag_help()
    return flag_help
end
function set_flag_help(item)
    if item and item.id then help_id = item:id() end

    if not type(item) == "string" then item = item:section() end
    if med[item] then
        flag_help = true
    end
end
function snd_eat_med(tips)
    local snd_obj = xr_sound.get_safe_sound_object(snd_eff[tips])
    snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
end
function use_antirad()
    if db.actor:object("antirad") ~= nil then
        db.actor:eat(db.actor:object("antirad"))
    else
        sak.send_tip_local("А ведь нету антирада", "Худуть твою железа мать!", 1, 10, "g_g", "sak", "red")
        vergas_lib.s_play([[device\antirad_no]], 1)
    end
end
function encode_value(v)
    if type(v) ~= "userdata" then
        return v
    end
    return pack_args(v:get())
end
function decode_value(k, v)
    if type(v) ~= "table" or #v ~= 7 then
        return v
    end
    local tmp = game.CTime()
    tmp:set(unpack(v))
    return tmp
end
function save()
    local tbl = {
        active_effects = active_effects,
        heal_start = {},
        heal_last = {},
        heal_time = heal_time,
        delta_health = delta_health,
        delta_power = delta_power,
        delta_radiation = delta_radiation,
        post_eff = post_eff,
        visual_effects_active = visual_effects_active,
    }

    -- Кодируем значения времени
    for obj_name, time in pairs(heal_start) do
        if time then
            tbl.heal_start[obj_name] = encode_value(time)
        end
    end

    for obj_name, time in pairs(heal_last) do
        if time then
            tbl.heal_last[obj_name] = encode_value(time)
        end
    end
    set_value("medical", tbl)
    log2("[vergas_medical]: Состояние успешно сохранено.")
end
function load()
    local tbl = get_value("medical")
    if not tbl then
        return
    end
    remove_value("medical")

    active_effects = tbl.active_effects or {}
    heal_time = tbl.heal_time or {}
    delta_health = tbl.delta_health or {}
    delta_power = tbl.delta_power or {}
    delta_radiation = tbl.delta_radiation or {}
    post_eff = tbl.post_eff or {}
    visual_effects_active = tbl.visual_effects_active or {}

    -- Декодируем значения времени
    heal_start = {}
    for obj_name, encoded_time in pairs(tbl.heal_start or {}) do
        heal_start[obj_name] = decode_value(obj_name, encoded_time)
    end

    heal_last = {}
    for obj_name, encoded_time in pairs(tbl.heal_last or {}) do
        heal_last[obj_name] = decode_value(obj_name, encoded_time)
    end

    for obj_name, active in pairs(active_effects) do
        if active then
            if post_eff[obj_name] and post_eff[obj_name] ~= 0 then
                level.add_pp_effector(vis_post_eff[post_eff[obj_name]], 1021 + #active_effects, true)
                visual_effects_active[obj_name] = true
            end
            dsh.timeout(200, function() medical_procedures(obj_name) end)
        end
    end
end
function _G.caption_use(num, id)
    local obj = client_obj(id or BAD_OBJ_ID)
    if (nil == id) or (nil == obj) then
        return "st_use_" .. tostring(num)
    end
    local sn = obj:section()
    if strpos(sn, "arc_art_box_") then
        local arts = arc_ui_container_common.decode_container(id)
        local cs = get_u32(sn, "container_slots", 0)
        return sprintf("%d/%d/%d %s", #arts, cs, (cs - #arts), id)
    end
    if strpos(sn, 'bandage') or strpos(sn, 'medkit') or strpos(sn, 'antirad') or sn == 'batt_torch' then
        return 'st_use_' .. tostring(num)
    end
    if strpos(sn, "pda") then
        local cd = vergas_pda.get_pda_cdata(id)
        if cd then
            local info = SplitStr(cd, '|')
            local serial = info[4] or '?' .. sn
            return translate("device-PDA") .. ' №' .. serial .. " " .. translate("pda_cond_" .. string.sub(serial, 13, 13))
        end
    end
    return game.translate_string("st_use") .. sprintf(" %d", id)
end
function _G.batt_gps_charge(id)
    local batt = client_obj(id)
    if batt == nil then return end
    local tbl = {}
    db.actor:iterate_inventory(function(_, obj)
        if obj:section() == "amk_metka" then
            table.insert(tbl, obj:id())
        end
    end)
    local count = #tbl
    if count == 0 then
        return
    elseif count > 1 then
        table.sort(tbl, function(a, b) return client_obj(a):condition() < client_obj(b):condition() end)
    end
    local gps = client_obj(tbl[1])
    if gps then
        gps:set_condition(1)
        misc.release_obj(id)
    end
end
function _G.batt_torch_charge(id)
    local obj = client_obj(id)
    if obj == nil then return end
    -- [HE-PORT]
    if obj:is_outfit() then
        if get_value("lab_protection") then
            undergrounds_hits.remove_ballon_with_anim()
        end
        return
    end
    sak.new_batt_torch(id)
end