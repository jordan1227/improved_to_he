-- sivol: English password pools for the NPC PDAs.
-- The Russian pools (vergas_pda.set_pass_rang / set_pass_grup) stay as they are; when the game
-- language is English the same functions hand out the words below instead, so the password is
-- something an English keyboard can type and the login (an anagram of it) can be solved.
-- Rank tiers and faction codes mirror the Russian pools (novice < 300, stalker < 600,
-- veteran < 900, master above; faction codes 01..09 as in vergas_pda.set_community).
-- Pure ASCII, lowercase: the reader compares passwords case-insensitively.

local RANG = {
	novice = {
		"noob", "rookie", "newbie", "greenhorn", "tenderfoot", "pupil", "dunce", "sucker",
		"novice", "cadet", "trainee", "recruit", "apprentice", "fledgling", "beginner",
		"amateur", "bumpkin", "scrub", "tyro",
	},
	stalker = {
		"stalker", "seasoned", "savvy", "cunning", "nimble", "deft", "clever", "tracker",
		"forager", "raider", "fighter", "shrewd", "crafty", "scout", "hardened",
		"pathfinder", "scavenger", "runner", "wiry",
	},
	veteran = {
		"veteran", "guide", "grizzled", "mentor", "resourceful", "rogue", "streetwise",
		"sharpshooter", "absolute", "legend", "virtuoso", "wolfpack", "battletested",
		"resilient", "unkillable", "survivor", "oldtimer", "tenacious", "ironclad",
		"schemer", "inventive", "foreman",
	},
	master = {
		"professional", "specialist", "hardboiled", "battlehardened", "invincible",
		"elusive", "indestructible", "untouchable", "legendary", "fearless", "flawless",
		"irreplaceable", "undaunted",
	},
}

local GRUP = {
	[ "01" ] = { -- loners
		"loner", "stalker", "freelancer", "neutral", "drifter", "wanderer", "scavenger",
		"hustler", "seeker", "rover", "lucky", "restless", "outcast", "adventurer", "nomad",
		"hermit", "freeman", "swag", "campfire", "nightstop", "ranger", "tramp",
	},
	[ "02" ] = { -- military
		"soldier", "army", "federal", "shorttimer", "oldtimer", "patrol", "cordon", "sentry",
		"fighter", "partisan", "serviceman", "militia", "orderly", "conscript", "guard",
		"cipher", "sergeant", "lieutenant", "captain", "warrant", "barracks", "checkpoint",
		"commandant", "specops",
	},
	[ "03" ] = { -- bandits
		"bandit", "gangster", "thief", "bucks", "outlaw", "convict", "payoff", "ruffian",
		"lackey", "stooge", "safecracker", "pickpocket", "swindler", "shady", "mayhem",
		"crooked", "godfather", "fence", "junkie", "punk", "cardsharp", "hitman", "sidekick",
		"kingpin", "mobster", "hoodlum", "extortion", "racket", "conman", "lawless",
	},
	[ "04" ] = { -- Duty
		"duty", "cleaner", "silent", "stern", "strength", "precise", "loyal", "guardian",
		"warden", "steadfast", "responsible", "principle", "unyielding", "watchman",
		"protector", "relentless", "statute", "oath", "discipline", "order", "watch",
		"frontier", "commander", "general", "stoic",
	},
	[ "05" ] = { -- Freedom
		"freedom", "liberty", "easygoing", "sharp", "anarchy", "hippie", "stoned", "musiclover",
		"weed", "grass", "carefree", "slacker", "rebel", "cheerful", "reckless", "rowdy",
		"daredevil", "sloppy", "guitar", "party", "music", "jester", "wild", "chill",
	},
	[ "06" ] = { -- Monolith
		"monolith", "faith", "devout", "holy", "sect", "zealot", "jesuit", "pagan", "chosen",
		"inquisitor", "apostle", "righteous", "fanatic", "wish", "acolyte", "flock", "prayer",
		"altar", "atonement", "penance", "preacher", "cultist", "believer",
	},
	[ "07" ] = { -- mercenaries
		"mercenary", "killer", "assassin", "annihilator", "shadow", "maniac", "ninja",
		"cutthroat", "saboteur", "coldblooded", "accurate", "ruthless", "vulture", "contract",
		"liquidator", "butcher", "executioner", "client", "executor", "fee",
	},
	[ "08" ] = { -- scientists
		"scientist", "ecologist", "flora", "fauna", "researcher", "brainiac", "egghead",
		"boffin", "experiment", "testtube", "nerd", "theorist", "practitioner", "intellectual",
		"luminary", "bookworm", "knowitall", "expert", "flask", "microscope", "formula",
		"hypothesis", "assistant", "postgrad", "dissertation", "reagent", "professor",
	},
	[ "09" ] = { -- hunters
		"hunter", "huntsman", "antibloodsucker", "scout", "pathfinder", "ranger", "rifleman",
		"cowboy", "forager", "trapper", "poacher", "woodsman", "ambush", "snare", "lair",
		"beater", "bait", "tracks", "prey", "gamekeeper",
	},
}

-- true when the game runs in English (the pools above replace the Russian ones)
function active()
	local lang = get_console():get_token( "g_language" )
	return lang == "eng"
end

local function pick( tbl )
	return tbl[ vergas_pda.random( 1, #tbl ) ]
end

function rang( rang_n )
	local n = tonumber( rang_n ) or 0
	if n < 300 then
		return pick( RANG.novice )
	elseif n < 600 then
		return pick( RANG.stalker )
	elseif n < 900 then
		return pick( RANG.veteran )
	end
	return pick( RANG.master )
end

-- same long-word preference as the Russian pool: owners of rank 600+ get words of 6+ letters
function grup( grup_n, rang_n )
	local tbl = GRUP[ grup_n ] or GRUP[ "01" ]
	if rang_n and rang_n >= 600 then
		local long = {}
		for _, v in ipairs( tbl ) do
			if string.len( v ) >= 6 then long[ #long + 1 ] = v end
		end
		if #long >= 3 then tbl = long end
	end
	return pick( tbl )
end

-- A password still made of Russian lowercase letters only (digits or Latin mean a deliberate
-- lock code such as the disabled-PDA passwords, which must stay untouched).
function is_legacy_word( pass )
	pass = tostring( pass or "" )
	return string.len( pass ) > 0 and string.find( pass, "^[\184\224-\255]+$" ) ~= nil
end

-- A PDA generated in a Russian game and opened in English: give it an English password and
-- login from its own serial (faction code at 7-8, owner rank at 9-12) so it can be hacked.
-- Returns true when the record was changed (the caller re-reads tbl_info).
function convert_legacy( pda_id, info )
	if not pda_id or not info or not is_legacy_word( info[ 2 ] ) then return false end
	local serial = tostring( info[ 4 ] or "" )
	local grup_n = string.sub( serial, 7, 8 )
	local rang_n = tonumber( string.sub( serial, 9, 12 ) ) or 150
	rang_n = math.max( 0, math.min( rang_n, 1999 ) )
	local pass
	if vergas_pda.random( 1, 2 ) == 1 then
		pass = rang( rang_n )
	else
		pass = grup( grup_n, rang_n )
	end
	local login = vergas_pda.set_pass_login( pass, rang_n )
	vergas_pda.set_pda_pass( pda_id, { name = login, pass = pass } )
	return true
end
