function take_flask_army( obj, id )
	local flask = client_obj( misc.get_object_id( obj ) )
	if flask then 
		local eat = flask:get_eatable_item()
		if eat.eat_portions_num == 0 then
			eat.eat_portions_num = 1
		end
		replace_flask_weight( flask:id(), eat.eat_portions_num )
	end
end

function replace_flask_weight( flask_id, water_amount )
    local add_weight = 0.2 * ( water_amount - 1 )  -- Вычитаем 1, так как 1 - это пустая фляжка
    local sys_weight = system_ini():r_float( "flask_army", "inv_weight" )
    local new_weight = sys_weight + add_weight
    params.set_inv_weight( flask_id, new_weight )
    local cond = ( water_amount - 1 ) / 4
    params.upd_condition( flask_id, cond )
end

function get_flask_water( obj )
    if not obj then 
        return 0
    end
    
    local eat = obj:get_eatable_item()
    if not eat then 
        return 0
    end
    
    return eat.eat_portions_num or 0
end

function set_flask_water( obj, amount )
	if not obj then return end
	if not amount then amount = 1 end
    local eat = obj:get_eatable_item()
	if eat then 	
		eat.eat_portions_num = amount
	end	
	vergas_flask.replace_flask_weight( obj.id, amount )
end

function data_collection(mode)
    local tbl_ch = {}    -- фляжка в чехле
    local tbl_r  = {}    -- фляжки в рюкзаке
    local tbl_n  = {}    -- номера фляжек
    
    if db.actor then
        for i = 0, db.actor:object_count() - 1 do
            local obj = db.actor:object(i)
            if razgruzka.check_obj(obj) then
                if obj:section() == "flask_army" then
                    table.insert(tbl_r, obj:id())
                    table.insert(tbl_r, get_flask_water(obj))
                end
            end
        end
    end
  
    -- Если надо, добавляю в таблицы записи-пустышки
    if #tbl_r < 8 then
        tbl_r = razgruzka.set_record_nil(tbl_r, 8)
    end
    if #tbl_ch == 0 then
        table.insert(tbl_ch, "?")
        table.insert(tbl_ch, 0)
    end
    
    -- присваиваю фляжкам номера
    local n = 1
    for i = 1, #tbl_r, 2 do
        if tbl_r[i] ~= "?" then
            table.insert(tbl_n, tbl_r[i])
            table.insert(tbl_n, n)
            n = n + 1
        end
    end
    if tbl_ch[1] ~= "?" then
        table.insert(tbl_n, tbl_ch[1])
        table.insert(tbl_n, n)
    end  
  
    if mode == 1 then
        return tbl_r, tbl_ch, tbl_n
    elseif mode == 2 then
        return tbl_ch
    end
end

function wash_glass( flask_id, request )
    used_items.set_get_flag_use_gadget( 1, false )
    local obj = client_obj( misc.get_object_id( flask_id ) )
    if not obj then return 0 end

    local current_water = get_flask_water( obj )	-- кол-во воды во фляге
    if current_water == 1 then 
		sak.send_tip( 
			"Так фляга уже пустая...", 
			"Мысли вслух", 0, 5, "g_g", "no", "red" 
		)	
		vergas_lib.s_play( [[device\antirad_no]], 1 )
		sak.restore_weap()
        return current_water 
    end 

    -- Проверяем наличие маски на костюме
    local mask, armor = vergas_masks.mask_definition()
    if mask == "?" then
        sak.send_tip( 
			"Совсем из головы вылетело, маски-то и нету...", 
			"Мысли вслух", 0, 5, "g_g", "no", "red" 
		)
		vergas_lib.s_play( [[device\antirad_no]], 1 )
        schedule.add( "chow_wash", "sak.restore_weap()", tmr )
        return current_water
    end

    -- Проверяем загрязненность маски
    local armor_custom = vergas_masks.set_get_armor_custom( 2 )
    local tbl_custom = vergas_lib.str_explode( "|", armor_custom, true )
    local dirt_level = tonumber( tbl_custom[ 2 ] )

    if dirt_level <= 1 then
        sak.send_tip( 
			"Маска ведь чистая, зачем её мыть...", 
			"Мысли вслух", 0, 5, "g_g", "no", "yellow" 
		)	
		vergas_lib.s_play( [[device\sleeping_bag\sleep_cancel]] )
        schedule.add("chow_wash", "sak.restore_weap()", tmr )
        return current_water
    end

	if not request then request = 1 end
	local tmr = 1000		
    -- Если маска не надета - надеваем
    if not vergas_masks.get_flag_mask() then
        vergas_masks.on_off_mask( true )
		tmr = 3000
    end
	
	local f = current_water - 1			-- Кол-во воды во фляге, с учетом того, что 1 - пустая
	local w = math.min( request, f )  	-- Наш запрос не должен превышать кол-во во фляге
	local d = dirt_level - 1            -- Загрязненность ,1 - чистая
	local r = math.min( w, d )          -- Итог: запрос не больше загрязненности

	log2( "Запрос [%s], Во фляге [%s], Загрязнение [%s], Используемое количество [%s], Итог: [%s]", request, f, d, w, r )
	
    -- Моем грязную маску
	sak.actor_hide_weapon()
    set_flask_water( obj, current_water - r )

	level.add_pp_effector( "black_off_slowly.ppe", 2121, false )
	dsh.timeout( tmr, function() 
		anim_duration = game.play_hud_motion( 2, "flask_new_use", "anm_show", false, 0.9 )
		vergas_lib.s_play("interface\\item_usage\\wash_glass",1)
		log2( "anim_duration is %s", anim_duration )
		
		--level.add_pp_effector( "black_off_slowly.ppe", 2121, false )
			
		dsh.timeout( 3400, function()
			level.remove_pp_effector( 2121 )
			game.stop_hud_motion()
			swipe( r )
		end )			
	end )
	
    return get_flask_water(obj)
end

function replace_dirt_phase()
	local armor = db.actor:item_in_slot(6)
	if armor then
		local armor_custom = vergas_masks.set_get_armor_custom(2)
		if armor_custom ~= "none|none|none" then
			--vergas_masks.mask_clearing()
			local t = vergas_lib.str_explode("|",armor_custom,true)
			local number_dirt_phase = tonumber(t[2])
			number_dirt_phase = number_dirt_phase - lua_random(2)
			if number_dirt_phase < 1 then
				number_dirt_phase = 1
			end
			armor_custom = t[1].."|"..tostring(number_dirt_phase).."|0"
			vergas_masks.set_get_armor_custom(1,armor_custom)
		else
			--vergas_lib.s_play("device\\masks\\water_flask",5)
		end
	else
		--vergas_lib.s_play("device\\masks\\water_flask",5)
	end
end

