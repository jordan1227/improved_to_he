local snd_gasmask = sound_object("interface\\inv_mask_clean_2")

function swipe( amnt )
	local cycles_needed = amnt  
    local cycles_completed = 0
	level.only_allow_movekeys(true)
    
    log2("swipe: требуетсЯ циклов: %s", cycles_needed)
    
    local function play_cycle()
        log2("swipe: выполнЯетсЯ цикл %s из %s", cycles_completed + 1, cycles_needed)
        
        if cycles_completed >= cycles_needed then
            log2("swipe: все циклы завершены (%s из %s)", cycles_completed, cycles_needed)
            return
        end
        
        set_dof_params(1, 1, 1, 1)
        level.add_cam_effector("camera_effects\\gasmask_swipe1.anm", 7538, false, "", 0, false)	
		snd_gasmask:play(db.actor, 0, sound_object.s2d)			
        
		local anim_duration = game.play_hud_motion(1, "anim_mask_clean", "anm_wipe", false, 0.5, false)
        log2("swipe: запущена анимация, длительность = %s", anim_duration)
        
        dsh.timeout(anim_duration, function()
            set_dof_params(0, 0, 0, 0)
            cycles_completed = cycles_completed + 1
            log2("swipe: цикл %s завершен", cycles_completed)
            replace_dirt_phase()
            log2("swipe: пауза перед следующим циклом")
            dsh.timeout(500, function()
                play_cycle()
            end)
        end)
    end
    
    log2("swipe: запускаем первый цикл")
    play_cycle()
    
    dsh.wait_condition(function() return cycles_completed >= cycles_needed end, function()
        log2("swipe: завершение анимации, восстанавливаем параметры")
        level.only_allow_movekeys(false)
		sak.restore_weap()
        game.stop_hud_motion(1)
        set_dof_params(0, 0, 0, 0)
    end)
end

function drink_water( flask_id )
	used_items.set_get_flag_use_gadget( 1, false )
	local obj = client_obj( misc.get_object_id( flask_id ) )
	if not obj then return end
	
    local current_water = get_flask_water( obj )
    if current_water == 1 then 
		vergas_lib.s_play( [[device\sleeping_bag\sleep_cancel]] )		
		sak.send_tip( 
			"Ни капельки не осталось...", 
			"Мысли вслух", 0, 5, "g_g", "no", "red" 
		)			
		sak.restore_weap()
		return 
	end 

	set_flask_water( obj, current_water - 1 )
	local new_water = get_flask_water( obj )

	--thirst.on_food_use( obj )
	sak.restore_weap()	-- Заглушка 
	
	return new_water
end

