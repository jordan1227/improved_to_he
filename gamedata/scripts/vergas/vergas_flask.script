function create_water_flask( num )
	local portions = num or 1
	local flask = misc.spawn_to( "flask_army", db.actor)
	if not flask then return end
	misc.process_spawn()
    
	dsh.wait_condition(
		function()
			local flask_obj = level.object_by_id( flask.id )
			return flask_obj and flask_obj:get_eatable_item() ~= nil
		end,
        
		function()
			local flask_obj = level.object_by_id( flask.id )
			local eat = flask_obj:get_eatable_item()
			eat.eat_portions_num = portions
			replace_flask_weight( flask.id, portions )
			sak.relocate_item( "in", "flask_army", 1 )
			log( "~ SUCCESS: Flask created with " .. portions .. " portion( s )" )
		end
	)
end

-- g_loadstring vergas_flask.create_water_flask( 5 )

function get_armor_dirt_level(armor_obj)
    if not armor_obj then return 0 end
    
    local sobj = alife():object(armor_obj:id())
    if not sobj then return 0 end
    
    local pk = get_netpk(sobj, 1)
    if not pk:isOk() then return 0 end
    
    local data = pk:get()
    local custom = data.custom_data
    
    if not custom or custom == "" then 
        return 0 
    end
    
    local t = vergas_lib.str_explode("|", custom, true)
    
    if #t < 2 or t[1] == "none" then 
        return 0 
    end
    
    local number_dirt_phase = tonumber(t[2])
    
    return number_dirt_phase or 0
end

function restore_armor_dirt_level(armor_obj, dirt_level)
    if not armor_obj or not dirt_level or dirt_level <= 0 then return end
    
    local sobj = alife():object(armor_obj:id())
    if not sobj then return end
    
    local current_custom = set_get_armor_custom(2)
    
    log2("[restore_armor_dirt_level] Current custom: %s", tostring(current_custom))
    
    if not current_custom or current_custom == "" then 
        current_custom = "none|none|none"
    end
    
    local t = vergas_lib.str_explode("|", current_custom, true)
    
    local mask_part = (t[1] ~= "none" and t[1] or "none")
    
    log2("[restore_armor_dirt_level] Mask part: %s", tostring(mask_part))
    
    local armor_custom
    
    if mask_part == "none" then
        local combez = armor_obj:section()
        local ms = vergas_lib.set_pr_from_config_str("list_masks", combez)
        
        log2("[restore_armor_dirt_level] Combez: %s, Found mask: %s", tostring(combez), tostring(ms))
        
        if ms ~= "?" then
            mask_part = ms
        end
    end
    
    armor_custom = mask_part .. "|" .. tostring(dirt_level) .. "|0"
    
    log2("[restore_armor_dirt_level] Final armor_custom: %s", tostring(armor_custom))
    
    local pk = get_netpk(sobj, 1)
    if pk:isOk() then
        local data = pk:get()
        data.custom_data = armor_custom
        pk:set(data)
    end
end