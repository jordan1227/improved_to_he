end

function sleep_management()
  sleeping_bag.stop_pp(2002)
  sleep_manager.sleep_nine_hours()
  --local spwn=ui_cheat.cheat(get_hud())
    --level.start_stop_menu(spwn,true)
end

-- [HE-PORT]
function used_items.used_special_art_container(obj_id)
  local obj = client_obj(obj_id)
  if not obj then return end
  sak.close_window()
  misc.easy_sound("scripts\\special_container_hit")
  local cond = obj:condition()
  local pos = obj:position()
  local gv = obj:game_vertex_id()
  local lv = obj:level_vertex_id()
  db.actor:drop_item(obj)
  if cond <= 0.15 then
    sak.send_tip(
      "Ќаконец-то открылс€. Ѕольше нет надобности в этом хламе...",
      "ћысли вслух", 1, 5, "g_g", "no", "yellow"
    )
    local se_obj = alife():object(obj_id)
    local custom = ""
    if se_obj then
      local pk = get_netpk(se_obj, 1)
      if pk then
        local data = pk:get()
        custom = data.custom_data or ""
      end
    end
    if custom == "" then return end
    amk.spawn_item(custom, sak.v3f(pos.x, pos.y, pos.z + 0.2), gv, lv)
    dsh.timeout(200, function() misc.release_obj(obj_id, "freeman_case_open") end)
  end
end
