function used_repair_boxoutfit(obj_id)
  local rem={}
  local sobj = alife():object(obj_id)
  local pk = get_netpk(sobj)
  local data = pk:get()
  local str=data.custom_data
  rem = vergas_lib.str_explode(",",str,true)
  local out=tonumber(rem[1]) or 0
  local weap=tonumber(rem[2]) or 0
  --sak.send_tip("В ремонтном ящике будет:\\nОружейных ремкомплектов - "..weap.." шт.\\nКомплектов для брони - "..out.." шт.",nil,2,5,"g_g","no", "green")
  sak.repair_boxoutfit(out,weap)
end

function used_bag_on_belt(flag,flag_h)
--flag = true - открываю с пополнением сумки
--flag = false - открываю только на использование(по гор€чей клавише)
--flag_h = true - руки пр€тать
--flag_h = false - руки не пр€тать
  flag_use_gadget = false
  if flag_h then
    bind_stalker.hide_weapon()
  end
  local spwn
  if flag then
    spwn=ui_cheat_bag_on_belt.bag_dialog(get_hud())
  end
  level.start_stop_menu(spwn,true)
end

