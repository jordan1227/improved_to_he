function used_items.used_pda_npc( obj_id )
	local txt = vergas_pda.get_pda_cdata( obj_id )
	if type( txt ) ~= "string" then
		log2("#WARN(used_pda_npc): bad pda data for obj_id=%s", tostring(obj_id))
		return
	end

	sak.close_window()

	local function open_pda_menu()
		local npc = db.actor
		local serial = SplitStr(txt, '|')[4] or 'nil'
		local sobj = alife():create( "device_pda_npc", npc:position(), npc:level_vertex_id(), npc:game_vertex_id(), npc:id() )
		if not sobj then return end

		vergas_pda.set_pda(sobj.id, txt)
		vergas_pda.set_info_pda(obj_id, sobj.id)
		vergas_pda.set_tbl_sn()
		vergas_pda.set_pda_condition( sobj.id, tonumber( string.sub( serial, 13, 13 ) ) or 3 )
		flag_use_gadget = false
		bind_stalker.hide_weapon()
		vergas_pda.start_search_pda(2, serial)
	end

	if get_value( "inv_full" ) then
		dsh.wait_condition( function() return not get_value( "inv_full" ) end, open_pda_menu )
	else
		open_pda_menu()
	end
end

