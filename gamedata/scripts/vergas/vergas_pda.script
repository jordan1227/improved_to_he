--[[
PDA npc
Vergas
© NLC 6.0
]]--

local tbl_spwn_pda = {}

-- sivol: reload-stable PDA content (docs/LOOT_RNG_DESIGN.md 3.2-3.3). While
-- set_pda_info fills one entry, pda_rng is that PDA's stream and every rnd()
-- in this module draws from it; otherwise rnd() is lua_random.
local PDA_STASH_CHANCE = 0.35 -- one stash roll; broken PDAs (status 3) never get a stash
local SEEDS_KEY = "vergas_pda.seeds"     -- [pda id] = stream key
local PENDING_KEY = "vergas_pda.pending" -- tbl_spwn_pda entries not yet filled
local pda_rng = nil
local pending_restored = false

local function rnd(a, b)
	if pda_rng then return pda_rng:random(a, b) end
	return lua_random(a, b)
end

-- Same as rnd(), for helpers outside this module (vergas_scrambling).
function random(a, b)
	return rnd(a, b)
end

function set_pda_seed(pda_id, key)
	local seeds = get_value(SEEDS_KEY, {})
	seeds[tostring(pda_id)] = key
	set_value(SEEDS_KEY, seeds)
end

local function take_pda_seed(pda_id)
	local seeds = get_value(SEEDS_KEY, {})
	local key = seeds[tostring(pda_id)]
	if key ~= nil then
		seeds[tostring(pda_id)] = nil
		set_value(SEEDS_KEY, seeds)
	end
	return key
end

-- Runs fn with rnd() drawing from stream (for callers outside set_pda_info).
function with_rng(stream, fn)
	local prev = pda_rng
	pda_rng = stream
	fn()
	pda_rng = prev
end

local function save_pending()
	local list = {}
	for _, e in ipairs(tbl_spwn_pda) do
		if e ~= 0 then table.insert(list, e) end
	end
	set_value(PENDING_KEY, list)
end

-- A save made between a PDA drop and the next update_2 would lose the entry.
local function restore_pending()
	if pending_restored then return end
	pending_restored = true
	for _, e in ipairs(get_value(PENDING_KEY, {})) do
		local found = false
		for _, cur in ipairs(tbl_spwn_pda) do
			if cur == e then found = true break end
		end
		if not found then table.insert(tbl_spwn_pda, e) end
	end
end
local tbl_info = {}
local number_record
local tbl_sn = {} 	--таблица служебных номеров  ПДА
local number_pda	--номер текущего ПДА
local steklo

local tbl_steklo = {}

function set_pda_info()
    local i, j, npc, pda, s_n, name_1, name_2, name
    local grup_n, grup_s, rang_s, rang_n, login, pass, msg, info_string, shron

    restore_pending()
    if #tbl_spwn_pda ~= 0 then
        for i = 1, #tbl_spwn_pda do
            if tbl_spwn_pda[ i ] ~= 0 then
                local tbl_inf = vergas_lib.str_explode( "|", tbl_spwn_pda[ i ], true )
                for j = 1, 3 do
                    tbl_inf[ j ] = tonumber( tbl_inf[ j ] )
                end
                -- tbl_inf[1] = npc_id, tbl_inf[2] = pda_id, tbl_inf[3] = status, tbl_inf[4] = forced_msg
                local forced_msg = tbl_inf[ 4 ]
                if forced_msg == "" then forced_msg = nil end
                local profile    = tbl_inf[ 7 ] or ""
                local only_flag  = tbl_inf[ 6 ] == "only"

                -- нпс ищем через client_obj (нужен живой объект для ранга и группировки)
                npc = client_obj( tbl_inf[ 1 ] )
                
                -- пда ищем через alife (работает и для объектов в ящиках)
                local sobj_pda = alife():object( tbl_inf[ 2 ] )
                -- sivol: reset per entry, so a missing PDA never reuses the previous entry's object
                pda = sobj_pda
                if sobj_pda == nil then
                    tbl_spwn_pda[ i ] = 0
                    take_pda_seed( tbl_inf[ 2 ] )
                end

                if pda ~= nil then
                    tbl_spwn_pda[ i ] = 0
                    local seed_key = take_pda_seed( tbl_inf[ 2 ] )
                    pda_rng = seed_key and sivol_seeded_rng.new( seed_key ) or nil
                    
                    -- генерируем имя владельца
                    local m, n = translate( "anl.fnames_" .. rnd( 177 ) ), translate( "anl.snames_" .. rnd( 816 ) ) -- sivol: was amk_names_lists.get_strings()
                    name_1 = vergas_lib.register_change( m, 1 )
                    name_2 = vergas_lib.register_change( n, 1 )
                    name = m.." "..n
                    if string.len( name_2 ) == 0 then
                        name_2 = name_1
                    end

                    -- sivol: community and owner rank (docs/PDA_FACTION_TEXT_DESIGN.md 9.4, 10.3).
                    -- owner_real: grup_s is the corpse's own community, so the stash may use the npc.
                    -- rank_real: owner rank for the stash pick, stash chance and message filter.
                    local owner_real = false
                    local rank_real = nil
                    if npc ~= nil and npc:id() == db.actor:id() then
                        -- traded or reward PDA
                        if profile ~= "" then
                            grup_s, rank_real = roll_profile( profile )
                        else
                            grup_s = set_community_str()
                        end
                        rang_s = nil
                    elseif npc ~= nil and IsStalker( npc ) then
                        grup_s = npc:character_community()
                        if not PDA_COMMUNITIES[ grup_s ] then
                            grup_s = set_community_str()
                        elseif grup_s == "bandit" and rnd( 1, 10 ) >= 8 then
                            grup_s = set_community_str()
                        else
                            owner_real = true
                        end
                        rang_s = npc:character_rank()
                        rank_real = rang_s
                    else
                        -- no owner (box) - random
                        grup_s = set_community_str()
                        rang_s = nil
                    end

                    -- sivol: a corpse's own PDA carries its name; looted, remapped and traded
                    -- PDAs keep the random owner. Password parts keep only letters/digits.
                    if owner_real then
                        local real = npc:character_name()
                        local a, b = set_2_names( real or "" )
                        a = string.gsub( vergas_lib.register_change( a, 1 ), "[^%w\168\184\192-\255]", "" )
                        b = string.gsub( vergas_lib.register_change( b, 1 ), "[^%w\168\184\192-\255]", "" )
                        if string.len( a ) > 0 then
                            name = real
                            name_1 = a
                            name_2 = string.len( b ) > 0 and b or a
                        end
                    end

                    rang_n = rnd( 150, 1500 )
                    grup_n = set_community( grup_s )
                    
                    -- если нет реального ранга от нпс - используем числовой rang_n
                    local s_n_rang = rang_s or tostring( rang_n )
                    s_n = set_s_n( grup_n, s_n_rang, npc, tbl_inf[ 3 ] )
                    
                    -- sivol: password words and scrambling follow the owner rank (capped: scrambling has no case at 2000+)
                    local pass_rank = math.max( 0, math.min( tonumber( rank_real or rang_n ) or rang_n, 1999 ) )
                    pass  = set_pass_section( name_1, name_2, pass_rank, grup_n )
                    login = set_pass_login( pass, pass_rank )

                    if forced_msg then
                        shron = 0
                        local msg_parts = {}
                        local shron_list = {}
                        for item in string.gmatch( forced_msg, "([^;]+)" ) do
                            local trimmed = vergas_lib.trim( item )
                            if string.sub( trimmed, 1, 4 ) == "enc_" then
                                table.insert( msg_parts, trimmed )
                            elseif string.sub( trimmed, 1, 12 ) == "pda_actions." then
                                table.insert( msg_parts, trimmed )
                            else
                                local id = vergas_lib.set_pr_from_config( "list_treasure_pda", trimmed )
                                if id and id ~= 0 then
                                    -- резервируем через единую систему, может вернуть другой тайник
                                    local tm = treasure_manager.get_treasure_manager()
                                    local reserved = tm:reserve_treasure( trimmed, true ) -- Если передали прямо
                                    if reserved then
                                        if reserved ~= trimmed then
                                            --log2( "set_pda_info: treasure '%s' already given, replaced with '%s'", trimmed, reserved )
                                        end
                                        table.insert( shron_list, reserved )
                                        local reserved_id = vergas_lib.set_pr_from_config( "list_treasure_pda", reserved )
                                        table.insert( msg_parts, tostring( reserved_id ) )
                                    else
                                        --log2( "set_pda_info: treasure '%s' already given, no similar found", trimmed )
                                    end
                                end
                            end
                        end
                        shron = #shron_list > 0 and table.concat( shron_list, "," ) or "0"

                        if not only_flag then
                            local std_msg = set_msg( grup_s, 0, rang_n, treasure_manager.rank_name( rank_real or rang_n ) )
                            if std_msg and std_msg ~= "" then
                                for part in string.gmatch( std_msg, "([^,]+)" ) do
                                    table.insert( msg_parts, part )
                                end
                            end
                        end
                        msg = table.concat( msg_parts, "," )
					else
						-- forced_msg не передан - рандомим тайник с низкой вероятностью
						-- 35% шанс получить тайник, в остальных случаях shron = 0
						if tonumber( tbl_inf[ 3 ] ) ~= 3 and rnd() < stash_chance( rank_real or rang_n ) then
							-- sivol: stash community follows the text community (docs/PDA_FACTION_TEXT_DESIGN.md 9.4)
							if owner_real then
								shron = treasure_manager.get_treasure_manager():use( npc, nil, nil, pda_rng )
							else
								shron = treasure_manager.get_treasure_manager():use( nil, grup_s, rank_real or rang_n, pda_rng )
							end
							-- резервируем только здесь, когда тайник реально записывается в PDA
							if shron and shron ~= 0 then
								local reserved = treasure_manager.get_treasure_manager():reserve_treasure( shron, nil, pda_rng )
								shron = reserved or 0
							end
						else
							shron = 0
						end
						if not shron then shron = 0 end
						msg = set_msg( grup_s, shron, rang_n, treasure_manager.rank_name( rank_real or rang_n ) )
					end

                    info_string = login.."|"..pass.."|"..name.."|"..s_n.."|"..msg.."|"..shron.."|0"
                    
                    -- пишем через netpk напрямую на серверный объект
                    local pk = get_netpk( sobj_pda )
                    if pk then
                        local data = pk:get()
                        data.custom_data = info_string
                        pk:set( data )
                        --log2( "set_pda_info: written '%s' for id=%d", info_string, sobj_pda.id )
                    else
                        -- fallback на прямую запись
                        sobj_pda.custom_data = info_string
                        --log2( "set_pda_info: written direct '%s' for id=%d", info_string, sobj_pda.id )
                    end
                end
            end
        end

        -- чистим очередь если все обработаны
        local flag = true
        for i = 1, #tbl_spwn_pda do
            if tbl_spwn_pda[ i ] ~= 0 then
                flag = false
                break
            end
        end
        if flag then
            tbl_spwn_pda = {}
        end
        pda_rng = nil
        save_pending()
    end
end

function get_or_create_steklo(sn, kind)
    local key = sn .. "_" .. kind
    if not tbl_steklo[key] then
        tbl_steklo[key] = set_steklo()
    end
    return tbl_steklo[key]
end

-- sivol: message pool (docs/PDA_FACTION_TEXT_DESIGN.md 7.1, 7.3, 10.2). Ids 000..n;
-- [list_msg_rank] keeps ids tagged for the owner tier (all ids when fewer than 3 remain);
-- ids shown in earlier PDAs are skipped until fewer than 5 unseen remain, then the
-- faction's list starts over.
local SEEN_KEY = "vergas_pda.seen"

local function build_msg_pool( grup, tier )
    local ltx = system_ini()
    local n = vergas_lib.set_pr_from_config( "list_quantity", grup.."_quantity" )
    local all, ranked = {}, {}
    for i = 0, n do
        local id = string.format( "%03d", i )
        table.insert( all, id )
        local key = grup.."_"..id
        if tier == nil or not ltx:line_exist( "list_msg_rank", key ) then
            table.insert( ranked, id )
        else
            local tags = ","..string.gsub( ltx:r_string( "list_msg_rank", key ), "%s", "" )..","
            if string.find( tags, ","..tier..",", 1, true ) then
                table.insert( ranked, id )
            end
        end
    end
    local pool = ( #ranked >= 3 ) and ranked or all
    local seen = get_value( SEEN_KEY, {} )
    local shown = seen[ grup ] or {}
    local unseen = {}
    for _, id in ipairs( pool ) do
        -- "m" prefix keeps the saved keys strings
        if not shown[ "m"..id ] then table.insert( unseen, id ) end
    end
    if #unseen < 5 then
        shown = {}
        unseen = pool
    end
    return unseen, seen, shown
end

function set_msg( grup, shron, rang_n, tier )

    local rank_config = {
        { min = 0,    max = 299,  tbl = nil,                  			chance = 0    },
        { min = 300,  max = 599,  tbl = kotovod.first_level,  			chance = 0.02 },
        { min = 600,  max = 899,  tbl = kotovod.second_level, 			chance = 0.03 },
        { min = 900,  max = 1199, tbl = kotovod.third_level,  			chance = 0.05 },
        { min = 1200, max = 9999, tbl = kotovod.modifications_level,  	chance = 0.05 },
    }

    local pool, seen, shown = build_msg_pool( grup, tier )
    local tbl_msg = {}
    for i = 1, rnd( 2, 5 ) do
        if #pool == 0 then break end
        local k = rnd( 1, #pool )
        table.insert( tbl_msg, pool[k] )
        shown[ "m"..pool[k] ] = true
        table.remove( pool, k )
    end
    seen[ grup ] = shown
    set_value( SEEN_KEY, seen )

    -- схрон
    if shron ~= 0 then
        local ids = {}
        for s in string.gmatch( tostring( shron ), "([^,]+)" ) do
            local id = vergas_lib.set_pr_from_config( "list_treasure_pda", vergas_lib.trim( s ) )
            if id and id ~= 0 then
                table.insert( ids, tostring( id ) )
            end
        end
        if #ids > 0 then
            table.insert( tbl_msg, table.concat( ids, "+" ) )
        end
    end

    -- рецепт по рангу
    if rang_n then
        for _, cfg in ipairs( rank_config ) do
            if rang_n >= cfg.min and rang_n <= cfg.max then
                if cfg.tbl and #cfg.tbl > 0 and rnd() < cfg.chance then
                    local info_id = cfg.tbl[ rnd( 1, #cfg.tbl ) ]
                    table.insert( tbl_msg, "enc_" .. string.sub( info_id, 6 ) .. "_desc" )
                end
                break
            end
        end
    end

    -- перемешиваем
    local shuffled = {}
    while #tbl_msg > 0 do
        local k = rnd( 1, #tbl_msg )
        table.insert( shuffled, tbl_msg[k] )
        table.remove( tbl_msg, k )
    end
    tbl_msg = shuffled

    -- фильтруем уже выданные enc_* рецепты
    tbl_msg = filter_enc_messages( tbl_msg )

    -- форматируем числовые записи
    local formatted = {}
    for _, v in ipairs( tbl_msg ) do
        if string.sub( v, 1, 4 ) == "enc_" then
            table.insert( formatted, v )
        elseif string.find( v, "+" ) then
            -- составная запись тайников — не трогаем
            table.insert( formatted, v )
        else
            local len = string.len( v )
            local pad = len == 1 and "00" or len == 2 and "0" or ""
            table.insert( formatted, pad .. v )
        end
    end

    -- многоуровневость
    formatted = insert_levels_msg( formatted, grup )

    return table.concat( formatted, "," )
end

function insert_levels_msg(tbl, grup)
	local i
	local j
	local n
	local tbl_tmp = {}
	
	for i = 1, #tbl do
		-- пропускаем рецепты (enc_*) через многоуровневость не гоним
		if string.sub( tbl[i], 1, 4 ) == "enc_" then
			table.insert( tbl_tmp, tbl[i] )
		else
			n = vergas_lib.set_pr_from_config("list_multilevel", grup.."_"..tbl[i])
			if n ~= 0 then
				-- sivol: whole thread, or a tail of it that ends on the last line, so a
				-- reply never shows without what it answers (PDA_FACTION_TEXT_DESIGN.md 7.4)
				if rnd() < 0.6 then
					table.insert(tbl_tmp, tbl[i])
					for j = 1, n do
						table.insert(tbl_tmp, tbl[i].."_"..tostring(j))
					end
				else
					local s = rnd(1, math.max(1, n - 1))
					for j = s, n do
						table.insert(tbl_tmp, tbl[i].."_"..tostring(j))
					end
				end
			else
				table.insert(tbl_tmp, tbl[i])
			end
		end
	end
	
	return tbl_tmp
end

function set_2_names(name_npc)
	local flag = 1
	local i
	local symbol
	local name_1 = ""
	local name_2 = ""
	
	for i = 1, string.len (name_npc) do
		symbol = string.sub (name_npc, i , i)
		if symbol ~= " " then
			if flag == 1 then
				name_1 = name_1..symbol
			else
				name_2 = name_2..symbol
			end
		else
			flag = 2
		end
	end

	return name_1, name_2
end

function set_community(grup)
	local grup_n
	
	if grup == "stalker" then
		grup_n = "01"
	elseif grup == "military" then
		grup_n = "02"
	elseif grup == "bandit" then
		grup_n = "03"
	elseif grup == "dolg" then
		grup_n = "04"
	elseif grup == "freedom" then
		grup_n = "05"
	elseif grup == "monolith" then
		grup_n = "06"
	elseif grup == "killer" then
		grup_n = "07"
	elseif grup == "ecolog" then
		grup_n = "08"
	elseif grup == "green" then
		grup_n = "09"
	else
		grup_n = "01"
	end
	
	return grup_n
end

-- sivol: communities with their own PDA text (docs/PDA_FACTION_TEXT_DESIGN.md 9.4).
-- Others (zombied, green, ...) carry a looted stalker/bandit/Duty/Freedom PDA.
PDA_COMMUNITIES = {
	stalker = true, bandit = true, dolg = true, freedom = true,
	ecolog = true, killer = true, military = true, monolith = true,
}

local PROFILE_COMMUNITIES = { "stalker", "bandit", "dolg", "freedom", "ecolog", "killer", "military", "monolith" }
local PROFILE_TIERS = { "novice", "experienced", "veteran", "master" }
local PROFILE_TIER_RANK = { novice = { 150, 299 }, experienced = { 300, 599 }, veteran = { 600, 899 }, master = { 900, 1500 } }

local function pick_weighted( names, weights )
	local sum = 0
	for i = 1, #names do sum = sum + ( weights[ i ] or 0 ) end
	if sum <= 0 then return nil end
	local r = rnd() * sum
	for i = 1, #names do
		local w = weights[ i ] or 0
		r = r - w
		if r <= 0 and w > 0 then return names[ i ] end
	end
	for i = #names, 1, -1 do
		if ( weights[ i ] or 0 ) > 0 then return names[ i ] end
	end
end

local function read_weights( ltx, sec, key )
	local w = {}
	for s in string.gmatch( ltx:r_string( sec, key ), "[%d%.]+" ) do
		table.insert( w, tonumber( s ) or 0 )
	end
	return w
end

-- Traded PDA owner from [pda_profile_<name>] (docs/PDA_FACTION_TEXT_DESIGN.md 10.3):
-- community weights by name, then rank_<community> or rank (novice, experienced,
-- veteran, master). Returns community and a numeric rank.
function roll_profile( profile )
	-- debug profile "dbg:<community>:<tier>" (sivol_pda_debug.spawn)
	local dc, dt = string.match( profile, "^dbg:(%w+):(%w+)$" )
	if dc then
		local b = PROFILE_TIER_RANK[ dt ] or PROFILE_TIER_RANK.experienced
		return dc, rnd( b[ 1 ], b[ 2 ] )
	end
	local sec = "pda_profile_" .. profile
	local ltx = system_ini()
	if not ltx:section_exist( sec ) then
		return set_community_str(), nil
	end
	local w = {}
	for i, c in ipairs( PROFILE_COMMUNITIES ) do
		w[ i ] = ltx:line_exist( sec, c ) and ltx:r_float( sec, c ) or 0
	end
	local grup = pick_weighted( PROFILE_COMMUNITIES, w ) or set_community_str()
	local key = ltx:line_exist( sec, "rank_" .. grup ) and ( "rank_" .. grup ) or "rank"
	if not ltx:line_exist( sec, key ) then
		return grup, nil
	end
	local tier = pick_weighted( PROFILE_TIERS, read_weights( ltx, sec, key ) )
	local band = tier and PROFILE_TIER_RANK[ tier ]
	if not band then
		return grup, nil
	end
	return grup, rnd( band[ 1 ], band[ 2 ] )
end

-- Stash chance by owner rank from [pda_stash_chance] (docs/PDA_FACTION_TEXT_DESIGN.md 10.4).
function stash_chance( rank )
	local tier = treasure_manager.rank_name( rank )
	local ltx = system_ini()
	if tier and ltx:line_exist( "pda_stash_chance", tier ) then
		return ltx:r_float( "pda_stash_chance", tier )
	end
	return PDA_STASH_CHANCE
end

function set_community_str()

	local grup
	local com_n = rnd( 1, 4 )
	if com_n == 1 then
		grup = "stalker"
	elseif com_n == 2 then
		grup = "bandit"
	elseif com_n == 3 then
		grup = "dolg"
	elseif com_n == 4 then
		grup = "freedom"
	end
	return grup	
end

function set_s_n( grup_n, rang_s, npc, statuc )
    local s_n = ""
    local i
    
    --две рандомные цифры
    for i = 1, 2 do
        local a = rnd( 1, 10 )
        if a == 10 then
            a = 0
        end
        s_n = s_n .. tostring( a )
    end
    
    -- game_vertex_id, всегда 4 символа
    if npc then
        local a = tostring( npc:game_vertex_id() )
        if string.len( a ) == 1 then
            s_n = s_n .. "000" .. a
        elseif string.len( a ) == 2 then
            s_n = s_n .. "00" .. a
        elseif string.len( a ) == 3 then
            s_n = s_n .. "0" .. a
        elseif string.len( a ) == 4 then
            s_n = s_n .. a
        end
    else
        local a = tostring( rnd( 1000, 9999 ) )
        s_n = s_n .. a
    end
    
    --цифирь группировки
    s_n = s_n .. grup_n
    
    --цифирь ранга, всегда 4 символа
    if string.len( rang_s ) == 1 then
        s_n = s_n .. "000" .. rang_s
    elseif string.len( rang_s ) == 2 then
        s_n = s_n .. "00" .. rang_s
    elseif string.len( rang_s ) == 3 then
        s_n = s_n .. "0" .. rang_s
    elseif string.len( rang_s ) == 4 then
        s_n = s_n .. rang_s
    end
    
    --состояние ПДА (13й) + флаг прочтения (14й)
    s_n = s_n .. tostring( statuc ) .. "0"
    return s_n
end

function press_table( tbl )
	local tbl_tmp = {}
	local k
	for k = 1, #tbl do
		if tbl[k] ~= 0 then
			table.insert( tbl_tmp, tbl[ k ] )
		end
	end
	
	return tbl_tmp	
	
end

--[[ --old 
