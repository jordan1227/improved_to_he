function set_info_pda(old_id,new_id)

	local i
	local j
	local k
	
	for i, k in pairs( sak_inventory.eatable ) do
		if i == "device_pda_npc" then
			for j = 1, table.getn( k ) do
				if k[ j ] ~= old_id and k[ j ] ~= new_id then
					set_info_pda_record( k[ j ] )
				end
			end
		end
	end
	set_info_pda_record( new_id )
end

function set_info_pda_record(sobj_id)
    local sobj = alife():object(sobj_id)
    if sobj then
        local net_pak = get_netpk(sobj,1)
        local data = net_pak:get()
        --log2("set_info_pda_record id=%d cdata='%s'", sobj_id, tostring(data.custom_data))
        table.insert(tbl_info, data.custom_data)
    end
end
	
function change_info_pda_record(r_old,r_new)
	local i
	for i = 1,#tbl_info do
		if tbl_info[i] == r_old then
			tbl_info[i] = r_new
			break
		end
	end
end

function get_pda_info()
	return tbl_info
end

function get_current_pda_id()
    local tbl = get_pda_info()
    local n = get_number_record()
    if not tbl or not n or not tbl[n] then return end
    local info = vergas_lib.str_explode( "|", tbl[n], true )
    local serial = info[4]
    for i, k in pairs( sak_inventory.eatable ) do
        if i == "device_pda_npc" then
            for j = 1, #k do
                local sobj = alife():object( k[j] )
                if sobj then
                    local pk = get_netpk( sobj, 1 )
                    if pk then
                        local data = pk:get()
                        if strpos( data.custom_data, serial ) then
                            return sobj.id
                        end
                    end
                end
            end
        end
    end
end

function set_pda_pass( pda_id, params )
    local sobj = alife():object( pda_id )
    if not sobj then return end
    local pk = get_netpk( sobj, 1 )
    if not pk then return end
    local data = pk:get()
    local old_cdata = data.custom_data
    local info = vergas_lib.str_explode( "|", old_cdata, true )
    if not info or not info[2] then return end

    info[1] = params.name  or info[1]
    info[2] = params.pass  or info[2]
    info[3] = params.login or info[3]

    if params.remove_action then
        local parts = vergas_lib.str_explode( ",", info[5], true )
        local new_parts = {}
        for _, v in ipairs( parts ) do
            if vergas_lib.trim( v ) ~= params.remove_action then
                table.insert( new_parts, v )
            end
        end
        info[5] = table.concat( new_parts, "," )
    end

    data.custom_data = table.concat( info, "|" )
    pk:set( data )
    change_info_pda_record( old_cdata, data.custom_data )
end

