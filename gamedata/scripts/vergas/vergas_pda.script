-- roll: optional 1..10 value from a reload-stable stream (death_manager).
function set_status_pda( roll )
	local n = roll or rnd( 1, 10 )
	
	if n < 6 then
		return 1		--пда рабочий
	elseif n < 9 then
		return 2		--пда разряженный
	elseif n <= 10 then
		return 3		--пда битый
	end
end

-- profile: optional [pda_profile_<name>] for traded PDAs (field 7)
function add_tbl_pda( npc, pda, status, messages, only, profile )
    -- npc|pda|status|messages||only|profile
    local entry = tostring(npc).."|"..tostring(pda).."|"..tostring(status)
    if messages or only or profile then
        entry = entry.."|"..( messages or "" ).."||"..( only and "only" or "" )
        if profile then
            entry = entry.."|"..profile
        end
    end
    table.insert( tbl_spwn_pda, entry )
    save_pending()
end

function get_pda_packet( obj_id )
	local sobj = alife():object( obj_id )
	if sobj == nil then
		return false
	end
	return get_netpk( sobj )
end

function get_pda_data( obj_id )
   local pk = get_pda_packet( obj_id )
   if pk then         
      return pk:get()
   else
      return false
   end   
end

function get_pda_cdata( obj_id )
	local data = get_pda_data( obj_id )
	if data then 
		return data.custom_data
	else
		return false
	end
end


function set_pda(obj_id,info_str)	
	local pk = get_pda_packet (obj_id)
    if pk then
	  local data = pk:get()
	  data.custom_data = info_str
	  pk:set(data)
	  return true
    else
      return false
    end      
end

function set_info_pda(old_id,new_id)

	local i
	local j
	local k
	
	for i, k in pairs( sak_inventory.eatable ) do
		if i == "device_pda_npc" then
			for j = 1, table.getn( k ) do
				if k[ j ] ~= old_id and k[ j ] ~= new_id then
					set_info_pda_record( k[ j ] )
				end
			end
		end
	end
	set_info_pda_record( new_id )
end

function set_info_pda_record(sobj_id)
    local sobj = alife():object(sobj_id)
    if sobj then
        local net_pak = get_netpk(sobj,1)
        local data = net_pak:get()
        --log2("set_info_pda_record id=%d cdata='%s'", sobj_id, tostring(data.custom_data))
        table.insert(tbl_info, data.custom_data)
    end
end
	
function change_info_pda_record(r_old,r_new)
	local i
	for i = 1,#tbl_info do
		if tbl_info[i] == r_old then
			tbl_info[i] = r_new
			break
		end
	end
end

function get_pda_info()
	return tbl_info
end

function get_current_pda_id()
    local tbl = get_pda_info()
    local n = get_number_record()
    if not tbl or not n or not tbl[n] then return end
    local info = vergas_lib.str_explode( "|", tbl[n], true )
    local serial = info[4]
    for i, k in pairs( sak_inventory.eatable ) do
        if i == "device_pda_npc" then
            for j = 1, #k do
                local sobj = alife():object( k[j] )
                if sobj then
                    local pk = get_netpk( sobj, 1 )
                    if pk then
                        local data = pk:get()
                        if strpos( data.custom_data, serial ) then
                            return sobj.id
                        end
                    end
                end
            end
        end
    end
end

function set_pda_pass( pda_id, params )
    local sobj = alife():object( pda_id )
    if not sobj then return end
    local pk = get_netpk( sobj, 1 )
    if not pk then return end
    local data = pk:get()
    local old_cdata = data.custom_data
    local info = vergas_lib.str_explode( "|", old_cdata, true )
    if not info or not info[2] then return end

    info[1] = params.name  or info[1]
    info[2] = params.pass  or info[2]
    info[3] = params.login or info[3]

    if params.remove_action then
        local parts = vergas_lib.str_explode( ",", info[5], true )
        local new_parts = {}
        for _, v in ipairs( parts ) do
            if vergas_lib.trim( v ) ~= params.remove_action then
                table.insert( new_parts, v )
            end
        end
        info[5] = table.concat( new_parts, "," )
    end

    data.custom_data = table.concat( info, "|" )
    pk:set( data )
    change_info_pda_record( old_cdata, data.custom_data )
end

function set_tbl_sn()
	tbl_sn = get_pda_sn_tbl()
end

function get_tbl_sn_count()
    return #tbl_sn
end

function set_number_pda(param)
	number_pda = param
end

function get_number_pda()
	return number_pda
end

function set_tbl_sn_nil()
	number_pda = nil
	tbl_sn = {}
end

function start_search_pda(mode, forced_serial, no_open, dir)
    local current_serial = forced_serial or tbl_sn[ number_pda ]

    local temp_tbl = {}
    for i = 1, #tbl_sn do
        temp_tbl[i] = {sn = tbl_sn[i], info = tbl_info[i]}
    end
    table.sort(temp_tbl, function(a, b)
        local status_a = tonumber(a.sn:sub(13, 13))
        local status_b = tonumber(b.sn:sub(13, 13))
        if status_a ~= status_b then
            return status_a < status_b
        else
            return a.sn < b.sn
        end
    end)
    tbl_sn = {}
    tbl_info = {}
    for i = 1, #temp_tbl do
        table.insert(tbl_sn, temp_tbl[i].sn)
        table.insert(tbl_info, temp_tbl[i].info)
    end

    if mode == 1 then
        dir = dir or 1
        number_pda = ( (number_pda - 1 + dir) % #tbl_sn ) + 1
    else
        set_active_pda( current_serial )
    end
    
    local spwn = ui_cheat_pda_menu.cheat(get_hud())
    -- [HE-PORT]
    if no_open then return spwn end
    he_pda_3d.ui_open(spwn)        
end

function start_search_pda_after_drop()
    local obj_id = 0
    local dropped_pda = nil

    -- Находим и выбрасываем ПДА
    for i, k in pairs(sak_inventory.eatable) do
        if i == "device_pda_npc" then
            for j = 1, #k do
                local sobj = alife():object(k[j])
                if sobj then
                    local net_pak = get_netpk(sobj, 1)
                    local record = net_pak:get()
                    if record.custom_data == tbl_info[number_pda] then
                        local obj = client_obj(sobj.id)
                        if obj then
                            db.actor:drop_item(obj)
                            dropped_pda = record.custom_data
                            break
                        end
                    end
                end
            end
            if dropped_pda then break end
        end
    end

    if dropped_pda then
        -- Удаляем выброшенный ПДА из списков
        for i = 1, #tbl_info do
            if tbl_info[i] == dropped_pda then
                table.remove(tbl_info, i)
                table.remove(tbl_sn, i)
                break
            end
        end

        -- Пересортировываем оставшиеся ПДА
        local temp_tbl = {}
        for i = 1, #tbl_sn do
            temp_tbl[i] = {sn = tbl_sn[i], info = tbl_info[i]}
        end
		table.sort(temp_tbl, function(a, b)
			local status_a = tonumber(a.sn:sub(13, 13))
			local status_b = tonumber(b.sn:sub(13, 13))
			if status_a ~= status_b then
				return status_a < status_b
			else
				return a.sn < b.sn
			end
		end)
        
        -- Обновляем отсортированные списки
        tbl_sn = {}
        tbl_info = {}
        for i = 1, #temp_tbl do
            table.insert(tbl_sn, temp_tbl[i].sn)
            table.insert(tbl_info, temp_tbl[i].info)
        end

        -- Обновляем номер текущего ПДА
        if #tbl_info > 0 then
            number_pda = 1
            schedule.add("stop_show_pda", "vergas_pda.start_search_pda(2)", 500)
        else
            bind_stalker.restore_weapon()
            used_items.set_get_flag_use_gadget(1, true)
        end
    end
end

--[[
function sort_function( a, b )
   a = tonumber( a:sub( a:len() ) )
   b = tonumber( b:sub( b:len() ) )
   return a < b
end
]]--

function sort_function(a, b)
    a = tonumber(a:sub(13, 13))
    b = tonumber(b:sub(13, 13))
    return a < b
end


function get_pda_sn_tbl()
	local i
	local tbl = get_pda_info()
	local t = {}
	
	for i = 1, #tbl do
		local tt = vergas_lib.str_explode( "|", tbl[ i ], true )
		table.insert( t, tt[ 4 ] )
	end
	table.sort( t, sort_function )
	local temp_tbl = {}
	for i = 1,#t do
		for j = 1, #tbl do
			if strpos( tbl[ j ], t[ i ] ) then
				table.insert( temp_tbl, tbl[ j ] )
				break
			end
		end
	end
	tbl_info = temp_tbl
	--dump_table( t )
	--dump_table( tbl_info )
	return t
end

function get_pda_sn()
	--вывод служебного номера текущего ПДА
	local n
	if not tbl_sn[number_pda] or type(tbl_sn[number_pda])~="string" then 
		n = "0000000000003"		--битый ПДА
	else
		n = tbl_sn[number_pda]
	end
	return n
end

function set_active_pda(serial)
  number_pda = 1
  for i, sn in ipairs(tbl_sn) do
    if sn == serial then 
       wprintf(" found PDA~C0F %s~C07 at ~C0D %d~C07", serial, i)
       number_pda = i
    end
  end  
end

function set_get_steklo(param)
	if param ~= nil then
		steklo = param
	else
		return steklo
	end
end

function set_number_record(n)
	number_record = n
end

function get_number_record()
	return(number_record)
end

function set_info_pda_nil()
	tbl_info = {}
	number_record = nil
end

function read_message( msg_id, custom_msg )
    local text = ""
    local line, i, file_msg, text_tmp
    if msg_id ~= "custom" then
        if string.find( msg_id, "stalker" ) then
            file_msg = "$game_config$\\text\\rus\\string_table_pda_stalker.xml"
        elseif string.find( msg_id, "military") then
            file_msg = "$game_config$\\text\\rus\\string_table_pda_military.xml"
        elseif string.find( msg_id, "bandit") then
            file_msg = "$game_config$\\text\\rus\\string_table_pda_bandit.xml"
        elseif string.find( msg_id, "dolg") then
            file_msg = "$game_config$\\text\\rus\\string_table_pda_dolg.xml"
        elseif string.find( msg_id, "freedom") then
            file_msg = "$game_config$\\text\\rus\\string_table_pda_freedom.xml"
        elseif string.find( msg_id, "monolith") then
            file_msg = "$game_config$\\text\\rus\\string_table_pda_monolith.xml"
        elseif string.find( msg_id, "killer") then
            file_msg = "$game_config$\\text\\rus\\string_table_pda_killer.xml"
        elseif string.find( msg_id, "ecolog") then
            file_msg = "$game_config$\\text\\rus\\string_table_pda_ecolog.xml"
        elseif string.find( msg_id, "green") then
            file_msg = "$game_config$\\text\\rus\\string_table_pda_green.xml"
        elseif string.find( msg_id, "treasure") then
            file_msg = "$game_config$\\text\\rus\\string_table_pda_treasure.xml"
        end
        local file_text = FileLoad( file_msg )
        local lines     = SplitStr( file_text, "\n" )
        local sample    = string.format( "id=\"%s\"", msg_id )
        for i, line in pairs( lines ) do
            if string.find( line, sample ) then
                local lstart = string.find( line, "<text>" ) + 6
                local lend   = string.find( line, "</text>" ) - 1
                text_tmp     = string.sub( line, lstart, lend )
            end
        end
    end
    if custom_msg then text_tmp = custom_msg end
    local on = false
    local off, sumbol
    for i = 1, string.len( text_tmp ) do
        sumbol = string.sub( text_tmp, i, i )
        if sumbol == "\\" then
            on = true
        else
            if sumbol == "n" and on then
                text = text .. "|["
                on   = false
            else
                text = text .. sumbol
            end
        end
    end
    return text
end

function charge_pda( pda_id )
	local good = false
	local pk = get_pda_packet( pda_id )
	local data = pk:get()
	local cust = data.custom_data
	if cust == "" then return good end
	local info = vergas_lib.str_explode("|",cust,true)
	local status = string.sub(info[4],13,13) or "3"
	if status == "3" then
		good = false
	elseif status == "2" then
		-- [sivol] сохраняем 14-й символ (флаг прочтения), иначе логин/пароль/тайник пропадали из описания
		info[4] = string.sub(info[4],1,12).."1"..string.sub(info[4],14)
		data.custom_data = info[1].."|"..info[2].."|"..info[3].."|"..info[4].."|"..info[5].."|"..info[6].."|"..info[7]
        wprintf("[~T].~C0F #CODE_OPT:~C07 compare it~C0E \n\t%s~C0F \n\t%s~C07", data.custom_data, table.concat(info, '|'))    
		pk:set(data)
        params.upd_condition( pda_id, 1 )		
		good = true
	elseif status == "1" then	
		good = true
	end
	return good
end

function good_pda_have( pda_id )	 
	local info = vergas_lib.str_explode("|", get_pda_cdata (pda_id), true)
	if not info or not info[4] then return end
	local status = string.sub(info[4],13,13) or "3"
	local good = false
	if status == "3" or status == "2" then
		good = false
	elseif status == "1" then	
		good = true
	end
	return good
end

