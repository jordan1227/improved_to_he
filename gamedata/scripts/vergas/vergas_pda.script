function set_left_pda()
    local s_n = ""
    s_n = tostring( lua_random( 10, 99 ) )
    s_n = s_n .. tostring( lua_random( 1000, 9999 ) )
    s_n = s_n .. tostring( lua_random( 10, 99 ) )
    s_n = s_n .. tostring( lua_random( 1000, 9999 ) )
    s_n = s_n .. "30"  -- 13й статус + 14й флаг прочтения
    local msg = "0|0|0|" .. s_n .. "|0|0|0"
    return msg
end

function set_treasure_in_dialog( shron )
    local tm = treasure_manager.get_treasure_manager()
    local reserved = tm:reserve_treasure( shron )
    if not reserved then
        --log2( "set_treasure_in_dialog: treasure '%s' already given, no similar found", shron )
        return
    end
    if reserved ~= shron then
        --log2( "set_treasure_in_dialog: treasure '%s' already given, replaced with '%s'", shron, reserved )
    end
    if db.actor:object( "klava" ) ~= nil then
        local msg_id = "treasure" .. "_" .. vergas_lib.set_pr_from_config( "list_treasure_pda", reserved )
                    .. "_" .. ReadIni( db.stor_ltx, "stor", "r_treas_items" )
        vergas_lib.add_record_in_klava( msg_id )
    end
    tm:give_treasure( reserved, true )
end

