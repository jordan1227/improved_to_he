function set_tbl_sn_nil()
	number_pda = nil
	tbl_sn = {}
end

function start_search_pda(mode, forced_serial)
    local current_serial = forced_serial or tbl_sn[ number_pda ]

    local temp_tbl = {}
    for i = 1, #tbl_sn do
        temp_tbl[i] = {sn = tbl_sn[i], info = tbl_info[i]}
    end
    table.sort(temp_tbl, function(a, b)
        local status_a = tonumber(a.sn:sub(13, 13))
        local status_b = tonumber(b.sn:sub(13, 13))
        if status_a ~= status_b then
            return status_a < status_b
        else
            return a.sn < b.sn
        end
    end)
    tbl_sn = {}
    tbl_info = {}
    for i = 1, #temp_tbl do
        table.insert(tbl_sn, temp_tbl[i].sn)
        table.insert(tbl_info, temp_tbl[i].info)
    end

    if mode == 1 then
        number_pda = ( number_pda % #tbl_sn ) + 1
    else
        set_active_pda( current_serial )
    end
    
    local spwn = ui_cheat_pda_menu.cheat(get_hud())
    level.start_stop_menu(spwn, true)        
end

function start_search_pda_after_drop()
    local obj_id = 0
    local dropped_pda = nil

    -- Находим и выбрасываем ПДА
    for i, k in pairs(sak_inventory.eatable) do
        if i == "device_pda_npc" then
            for j = 1, #k do
                local sobj = alife():object(k[j])
                if sobj then
                    local net_pak = get_netpk(sobj, 1)
                    local record = net_pak:get()
                    if record.custom_data == tbl_info[number_pda] then
                        local obj = client_obj(sobj.id)
                        if obj then
                            db.actor:drop_item(obj)
                            dropped_pda = record.custom_data
                            break
                        end
                    end
                end
            end
            if dropped_pda then break end
        end
    end

    if dropped_pda then
        -- Удаляем выброшенный ПДА из списков
        for i = 1, #tbl_info do
            if tbl_info[i] == dropped_pda then
                table.remove(tbl_info, i)
                table.remove(tbl_sn, i)
                break
            end
        end

        -- Пересортировываем оставшиеся ПДА
        local temp_tbl = {}
        for i = 1, #tbl_sn do
            temp_tbl[i] = {sn = tbl_sn[i], info = tbl_info[i]}
        end
		table.sort(temp_tbl, function(a, b)
			local status_a = tonumber(a.sn:sub(13, 13))
			local status_b = tonumber(b.sn:sub(13, 13))
			if status_a ~= status_b then
				return status_a < status_b
			else
				return a.sn < b.sn
			end
		end)
        
        -- Обновляем отсортированные списки
        tbl_sn = {}
        tbl_info = {}
        for i = 1, #temp_tbl do
            table.insert(tbl_sn, temp_tbl[i].sn)
            table.insert(tbl_info, temp_tbl[i].info)
        end

        -- Обновляем номер текущего ПДА
        if #tbl_info > 0 then
            number_pda = 1
            schedule.add("stop_show_pda", "vergas_pda.start_search_pda(2)", 500)
        else
            bind_stalker.restore_weapon()
            used_items.set_get_flag_use_gadget(1, true)
        end
    end
end

--[[
function sort_function( a, b )
   a = tonumber( a:sub( a:len() ) )
   b = tonumber( b:sub( b:len() ) )
   return a < b
end
]]--

function sort_function(a, b)
    a = tonumber(a:sub(13, 13))
    b = tonumber(b:sub(13, 13))
    return a < b
end


function get_pda_sn_tbl()
	local i
	local tbl = get_pda_info()
	local t = {}
	
	for i = 1, #tbl do
		local tt = vergas_lib.str_explode( "|", tbl[ i ], true )
		table.insert( t, tt[ 4 ] )
	end
	table.sort( t, sort_function )
	local temp_tbl = {}
	for i = 1,#t do
		for j = 1, #tbl do
			if strpos( tbl[ j ], t[ i ] ) then
				table.insert( temp_tbl, tbl[ j ] )
				break
			end
		end
	end
	tbl_info = temp_tbl
	--dump_table( t )
	--dump_table( tbl_info )
	return t
end

function get_pda_sn()
	--вывод служебного номера текущего ПДА
	local n
	if not tbl_sn[number_pda] or type(tbl_sn[number_pda])~="string" then 
		n = "0000000000003"		--битый ПДА
	else
		n = tbl_sn[number_pda]
	end
	return n
end

