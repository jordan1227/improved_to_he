local tbl_spwn_pda = {}
local tbl_info = {}
local number_record
local tbl_sn = {} 	--таблица служебных номеров  ПДА
local number_pda	--номер текущего ПДА
local steklo

local tbl_steklo = {}

function set_pda_info()
    local i, j, npc, pda, s_n, name_1, name_2, name
    local grup_n, grup_s, rang_s, rang_n, login, pass, msg, info_string, shron

    if #tbl_spwn_pda ~= 0 then
        for i = 1, #tbl_spwn_pda do
            if tbl_spwn_pda[ i ] ~= 0 then
                local tbl_inf = vergas_lib.str_explode( "|", tbl_spwn_pda[ i ], true )
                for j = 1, 3 do
                    tbl_inf[ j ] = tonumber( tbl_inf[ j ] )
                end
                -- tbl_inf[1] = npc_id, tbl_inf[2] = pda_id, tbl_inf[3] = status, tbl_inf[4] = forced_msg
                local forced_msg = tbl_inf[ 4 ]
                local only_flag  = tbl_inf[ 6 ] == "only"

                -- нпс ищем через client_obj (нужен живой объект для ранга и группировки)
                npc = client_obj( tbl_inf[ 1 ] )
                
                -- пда ищем через alife (работает и для объектов в ящиках)
                local sobj_pda = alife():object( tbl_inf[ 2 ] )
                if sobj_pda ~= nil then
                    pda = sobj_pda
                end

                if pda ~= nil then
                    tbl_spwn_pda[ i ] = 0
                    
                    -- генерируем имя владельца
                    local m, n = amk_names_lists.get_strings()
                    name_1 = vergas_lib.register_change( m, 1 )
                    name_2 = vergas_lib.register_change( n, 1 )
                    name = m.." "..n
                    if string.len( name_2 ) == 0 then
                        name_2 = name_1
                    end

                    -- определяем группировку и ранг
                    if npc ~= nil then
                        -- берём с живого нпс
                        grup_s = npc:character_community()
                        if grup_s ~= "bandit" and grup_s ~= "stalker" and grup_s ~= "dolg" and grup_s ~= "freedom" then
                            grup_s = set_community_str()
                        end
                        if grup_s == "bandit" then
                            local k = lua_random( 1, 10 )
                            if k >= 8 then
                                grup_s = set_community_str()
                            end
                        end
                        rang_s = npc:character_rank()
                    else
                        -- нпс нет (ящик) - рандомим
                        grup_s = set_community_str()
                        rang_s = nil
                    end

                    rang_n = lua_random( 150, 1500 )
                    grup_n = set_community( grup_s )
                    
                    -- если нет реального ранга от нпс - используем числовой rang_n
                    local s_n_rang = rang_s or tostring( rang_n )
                    s_n = set_s_n( grup_n, s_n_rang, npc, tbl_inf[ 3 ] )
                    
                    pass  = set_pass_section( name_1, name_2, rang_n )
                    login = set_pass_login( pass, rang_n )

                    if forced_msg then
                        shron = 0
                        local msg_parts = {}
                        local shron_list = {}
                        for item in string.gmatch( forced_msg, "([^;]+)" ) do
                            local trimmed = vergas_lib.trim( item )
                            if string.sub( trimmed, 1, 4 ) == "enc_" then
                                table.insert( msg_parts, trimmed )
                            elseif string.sub( trimmed, 1, 12 ) == "pda_actions." then
                                table.insert( msg_parts, trimmed )
                            else
                                local id = vergas_lib.set_pr_from_config( "list_treasure_pda", trimmed )
                                if id and id ~= 0 then
                                    -- резервируем через единую систему, может вернуть другой тайник
                                    local tm = treasure_manager.get_treasure_manager()
                                    local reserved = tm:reserve_treasure( trimmed, true ) -- Если передали прямо
                                    if reserved then
                                        if reserved ~= trimmed then
                                            --log2( "set_pda_info: treasure '%s' already given, replaced with '%s'", trimmed, reserved )
                                        end
                                        table.insert( shron_list, reserved )
                                        local reserved_id = vergas_lib.set_pr_from_config( "list_treasure_pda", reserved )
                                        table.insert( msg_parts, tostring( reserved_id ) )
                                    else
                                        --log2( "set_pda_info: treasure '%s' already given, no similar found", trimmed )
                                    end
                                end
                            end
                        end
                        shron = #shron_list > 0 and table.concat( shron_list, "," ) or "0"

                        if not only_flag then
                            local std_msg = set_msg( grup_s, 0, rang_n )
                            if std_msg and std_msg ~= "" then
                                for part in string.gmatch( std_msg, "([^,]+)" ) do
                                    table.insert( msg_parts, part )
                                end
                            end
                        end
                        msg = table.concat( msg_parts, "," )
					else
						-- forced_msg не передан - рандомим тайник с низкой вероятностью
						-- 35% шанс получить тайник, в остальных случаях shron = 0
						if lua_random() < 0.35 then
							if npc ~= nil then
								if npc:character_name() == "Меченный" then
									shron = treasure_manager.get_treasure_manager():use( nil, grup_s, rang_n )
								else
									shron = treasure_manager.get_treasure_manager():use( npc )
								end
							else
								shron = treasure_manager.get_treasure_manager():use( nil, grup_s, rang_n )
							end
							-- резервируем только здесь, когда тайник реально записывается в PDA
							if shron and shron ~= 0 then
								local reserved = treasure_manager.get_treasure_manager():reserve_treasure( shron )
								shron = reserved or 0
							end
						else
							shron = 0
						end
						if not shron then shron = 0 end
						msg = set_msg( grup_s, shron, rang_n )
					end

                    info_string = login.."|"..pass.."|"..name.."|"..s_n.."|"..msg.."|"..shron.."|0"
                    
                    -- пишем через netpk напрямую на серверный объект
                    local pk = get_netpk( sobj_pda )
                    if pk then
                        local data = pk:get()
                        data.custom_data = info_string
                        pk:set( data )
                        --log2( "set_pda_info: written '%s' for id=%d", info_string, sobj_pda.id )
                    else
                        -- fallback на прямую запись
                        sobj_pda.custom_data = info_string
                        --log2( "set_pda_info: written direct '%s' for id=%d", info_string, sobj_pda.id )
                    end
                end
            end
        end

        -- чистим очередь если все обработаны
        local flag = true
        for i = 1, #tbl_spwn_pda do
            if tbl_spwn_pda[ i ] ~= 0 then
                flag = false
                break
            end
        end
        if flag then
            tbl_spwn_pda = {}
        end
    end
end

function get_or_create_steklo(sn, kind)
    local key = sn .. "_" .. kind
    if not tbl_steklo[key] then
        tbl_steklo[key] = set_steklo()
    end
    return tbl_steklo[key]
end

function set_msg( grup, shron, rang_n )

    local rank_config = {
        { min = 0,    max = 299,  tbl = nil,                  			chance = 0    },
        { min = 300,  max = 599,  tbl = kotovod.first_level,  			chance = 0.02 },
        { min = 600,  max = 899,  tbl = kotovod.second_level, 			chance = 0.03 },
        { min = 900,  max = 1199, tbl = kotovod.third_level,  			chance = 0.05 },
        { min = 1200, max = 9999, tbl = kotovod.modifications_level,  	chance = 0.05 },
    }

    local n = vergas_lib.set_pr_from_config( "list_quantity", grup.."_quantity" )
    local pool = {}
    for i = 1, n do pool[i] = i end

    local tbl_msg = {}
    for i = 1, lua_random( 2, 5 ) do
        local k = lua_random( 1, #pool )
        table.insert( tbl_msg, tostring( pool[k] ) )
        pool[k] = 0
        pool = press_table( pool )
    end

    -- схрон
    if shron ~= 0 then
        local ids = {}
        for s in string.gmatch( tostring( shron ), "([^,]+)" ) do
            local id = vergas_lib.set_pr_from_config( "list_treasure_pda", vergas_lib.trim( s ) )
            if id and id ~= 0 then
                table.insert( ids, tostring( id ) )
            end
        end
        if #ids > 0 then
            table.insert( tbl_msg, table.concat( ids, "+" ) )
        end
    end

    -- рецепт по рангу
    if rang_n then
        for _, cfg in ipairs( rank_config ) do
            if rang_n >= cfg.min and rang_n <= cfg.max then
                if cfg.tbl and #cfg.tbl > 0 and dsh.get_next_random( "vergas_pda.rec_chance" ) < cfg.chance then
                    local info_id = cfg.tbl[ dsh.get_next_random( "generate_rec", 1, #cfg.tbl ) ]
                    table.insert( tbl_msg, "enc_" .. string.sub( info_id, 6 ) .. "_desc" )
                end
                break
            end
        end
    end

    -- перемешиваем
    local shuffled = {}
    while #tbl_msg > 0 do
        local k = lua_random( 1, #tbl_msg )
        table.insert( shuffled, tbl_msg[k] )
        table.remove( tbl_msg, k )
    end
    tbl_msg = shuffled

    -- фильтруем уже выданные enc_* рецепты
    tbl_msg = filter_enc_messages( tbl_msg )

    -- форматируем числовые записи
    local formatted = {}
    for _, v in ipairs( tbl_msg ) do
        if string.sub( v, 1, 4 ) == "enc_" then
            table.insert( formatted, v )
        elseif string.find( v, "+" ) then
            -- составная запись тайников — не трогаем
            table.insert( formatted, v )
        else
            local len = string.len( v )
            local pad = len == 1 and "00" or len == 2 and "0" or ""
            table.insert( formatted, pad .. v )
        end
    end

    -- многоуровневость
    formatted = insert_levels_msg( formatted, grup )

    return table.concat( formatted, "," )
end

function insert_levels_msg(tbl, grup)
	local i
	local j
	local n
	local tbl_tmp = {}
	
	for i = 1, #tbl do
		-- пропускаем рецепты (enc_*) через многоуровневость не гоним
		if string.sub( tbl[i], 1, 4 ) == "enc_" then
			table.insert( tbl_tmp, tbl[i] )
		else
			n = vergas_lib.set_pr_from_config("list_multilevel", grup.."_"..tbl[i])
			if n ~= 0 then
				if lua_random() > 0.6 then
					table.insert(tbl_tmp, tbl[i])
					for j = 1, n do
						table.insert(tbl_tmp, tbl[i].."_"..tostring(j))
					end
				else
					local nn = lua_random(1, n+1)
					if nn == n+1 then
						table.insert(tbl_tmp, tbl[i])
					else
						table.insert(tbl_tmp, tbl[i].."_"..tostring(nn))
					end
				end
			else
				table.insert(tbl_tmp, tbl[i])
			end
		end
	end
	
	return tbl_tmp
end

function set_2_names(name_npc)
	local flag = 1
	local i
	local symbol
	local name_1 = ""
	local name_2 = ""
	
	for i = 1, string.len (name_npc) do
		symbol = string.sub (name_npc, i , i)
		if symbol ~= " " then
			if flag == 1 then
				name_1 = name_1..symbol
			else
				name_2 = name_2..symbol
			end
		else
			flag = 2
		end
	end

	return name_1, name_2
end

function set_community(grup)
	local grup_n
	
	if grup == "stalker" then
		grup_n = "01"
	elseif grup == "military" then
		grup_n = "02"
	elseif grup == "bandit" then
		grup_n = "03"
	elseif grup == "dolg" then
		grup_n = "04"
	elseif grup == "freedom" then
		grup_n = "05"
	elseif grup == "monolith" then
		grup_n = "06"
	elseif grup == "killer" then
		grup_n = "07"
	elseif grup == "ecolog" then
		grup_n = "08"
	elseif grup == "green" then
		grup_n = "09"
	else
		grup_n = "01"
	end
	
	return grup_n
end

function set_community_str()
	local grup
	local com_n = lua_random( 1, 4 )
	if com_n == 1 then
		grup = "stalker"
	elseif com_n == 2 then
		grup = "bandit"
	elseif com_n == 3 then
		grup = "dolg"
	elseif com_n == 4 then
		grup = "freedom"
	end
	return grup	
end

function set_s_n( grup_n, rang_s, npc, statuc )
    local s_n = ""
    local i
    
    --две рандомные цифры
    for i = 1, 2 do
        local a = lua_random( 1, 10 )
        if a == 10 then
            a = 0
        end
        s_n = s_n .. tostring( a )
    end
    
    -- game_vertex_id, всегда 4 символа
    if npc then
        local a = tostring( npc:game_vertex_id() )
        if string.len( a ) == 1 then
            s_n = s_n .. "000" .. a
        elseif string.len( a ) == 2 then
            s_n = s_n .. "00" .. a
        elseif string.len( a ) == 3 then
            s_n = s_n .. "0" .. a
        elseif string.len( a ) == 4 then
            s_n = s_n .. a
        end
    else
        local a = tostring( lua_random( 1000, 9999 ) )
        s_n = s_n .. a
    end
    
    --цифирь группировки
    s_n = s_n .. grup_n
    
    --цифирь ранга, всегда 4 символа
    if string.len( rang_s ) == 1 then
        s_n = s_n .. "000" .. rang_s
    elseif string.len( rang_s ) == 2 then
        s_n = s_n .. "00" .. rang_s
    elseif string.len( rang_s ) == 3 then
        s_n = s_n .. "0" .. rang_s
    elseif string.len( rang_s ) == 4 then
        s_n = s_n .. rang_s
    end
    
    --состояние ПДА (13й) + флаг прочтения (14й)
    s_n = s_n .. tostring( statuc ) .. "0"
    return s_n
end

function press_table( tbl )
	local tbl_tmp = {}
	local k
	for k = 1, #tbl do
		if tbl[k] ~= 0 then
			table.insert( tbl_tmp, tbl[ k ] )
		end
	end
	
	return tbl_tmp	
	
end

