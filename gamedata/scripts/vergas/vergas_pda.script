--Функции обработки разрешения экрана
--------------------------------------------
function set_ratio(mode)
--mode = 1 расчет основного окна (подложка)
--mode = 2 вывод окна ПДА
--mode = 3 вывод стекла
--mode = 4 вывод сл. номера

	local x
	local y
	local dx
	local dy
	--нахожу коэф. горизонтали и вертикали
	local cof_g = device().width/1024		--горизонталь
	local cof_v = device().height/768		--вертикаль
	
	if mode == 1 then
		x = math.ceil (256*cof_g)
		y = math.ceil (192*cof_v)
		dx = 1024-x
		dy = 768-y
	elseif mode == 2 then
		x = math.ceil (256*cof_g)
		y = math.ceil (192*cof_v)
		dx = 1024-x
		dy = 768-y
		x = 0
		y = 0
	elseif mode == 3 then
		x = math.ceil(97*cof_g)
		y = math.ceil(84*cof_v)
		dx = 784-(x - 97)
		dy = 535-(y - 84)
		
	elseif mode == 4 then
		x = math.ceil(90*cof_g)
		y = math.ceil(40*cof_v)
		dx = 50-(x-90)
		dy = 24-(y-40)
	end
	
	return x,y,dx,dy

end

-- New added by kotovod

-- sivol: grup_n = the PDA's own faction code (password words then hint at the owner)
function set_pass_section( name_1, name_2, rang_n, grup_n )
    local pas
    
	if game_options.BalanceValue then
		-- На легкой оставим логины
        local n = rnd( 1, 4 )    
        if n == 1 then
            pas = name_1
        elseif n == 2 then
            pas = name_2
        elseif n == 3 then
            pas = set_pass_rang( rang_n )
        elseif n == 4 then
            pas = set_pass_grup( grup_n or ( "0" .. tostring( rnd( 1, 9 ) ) ), rang_n )
        end
    else
		-- На сложной генерируем
        local n = rnd( 1, 2 )    
        if n == 1 then
            pas = set_pass_rang( rang_n )
        else
            pas = set_pass_grup( grup_n or ( "0" .. tostring( rnd( 1, 9 ) ) ), rang_n )
        end
    end
    
    return pas
end

function set_pass_login( login, rang_n )
    local pass
	
	if game_options.BalanceValue then
        pass = vergas_scrambling.set_number_scrambling( login, rang_n )
    else
        local scrambled = generate_anagram( login )
        pass = vergas_scrambling.set_number_scrambling( scrambled, rang_n )
    end
    
    return pass
end

function generate_anagram( word )
    local chars = {}
    for c in word:gmatch( "." ) do
        table.insert( chars, c )
    end
    local result = ""
    while #chars > 0 do
        local index = rnd( 1, #chars )
        result = result .. chars[ index ]
        table.remove( chars, index )
    end
    return result
end


-- Проверка: был ли этот enc_* рецепт уже выдан на ПДА
function is_enc_given( enc_id )
	local tbl = get_value( "tbl_given_enc_pda", {} )
    --log2( "=== is_enc_given '%s' = %s, tbl size=%d", enc_id, tostring(tbl[ enc_id ] == true), #tbl )
	--misc.dump_table( tbl )
    return tbl[ enc_id ] == true
end

-- Отметить enc_* рецепт как выданный
function mark_enc_given( enc_id )
    local tbl = get_value( "tbl_given_enc_pda", {} )
    tbl[ enc_id ] = true
	set_value( "tbl_given_enc_pda", tbl )
end

-- Фильтрация списка enc_* — убираем уже выданные
function filter_enc_messages( msg_list )
    local filtered = {}
    for _, v in ipairs( msg_list ) do
        if string.sub( v, 1, 4 ) == "enc_" then
            if not is_enc_given( v ) then
                table.insert( filtered, v )
                mark_enc_given( v )  -- помечаем как выданный
            end
        else
            table.insert( filtered, v )
        end
    end
    return filtered
end

function filter_enc_given( messages )
    if not messages or messages == "" then return messages end
    --log2( "filter_enc_given input: %s", tostring(messages) )
    local parts = vergas_lib.str_explode( ";", messages, true )
    --log2( "filter_enc_given parts count: %d", #parts )
    local clean = {}
    for _, part in ipairs( parts ) do
        local trimmed = vergas_lib.trim( part )
		--log2( "filter_enc_given trimmed: '%s'", tostring(trimmed) )
        if string.sub( trimmed, 1, 4 ) == "enc_" then
            if not is_enc_given( trimmed ) then
                table.insert( clean, trimmed )
                mark_enc_given( trimmed )
				--log2( "filter_enc_given2 trimmed: '%s'", tostring(trimmed) )
            end
        else
            if trimmed ~= "" then
                table.insert( clean, trimmed ) 
            end
        end
    end
	--log2( "filter_enc_given clean count: %d", #clean )
    return #clean > 0 and table.concat( clean, ";" ) or nil
end

-- это для Mike и выдачи рандомных по уровням, не повторяющихся
function process_lvl_messages( messages )
    if not messages or messages == "" then return messages end
    
    -- нормализуем . и , как разделители к ; Для kotovod функций отдельная обработка!
	if not string.find( messages, "pda_actions%." ) then
		messages = string.gsub( messages, "[%.%,]", ";" )
	end
    
    messages = string.gsub( messages, "lvl(%d+)u", function( lvl )
        return kotovod.get_rnd_recipe_for_pda( tonumber( lvl ) ) or ""
    end)
    messages = string.gsub( messages, "lvl(%d+)", function( lvl )
        local tables = {
            [ "1" ] = kotovod.first_level,
            [ "2" ] = kotovod.second_level,
            [ "3" ] = kotovod.third_level,
            [ "4" ] = kotovod.dummy_level,
            [ "5" ] = kotovod.modifications_level,
        }
        local tbl = tables[ lvl ]
        if tbl and #tbl > 0 then
            local info = tbl[ rnd( 1, #tbl ) ]
            return "enc_" .. string.sub( info, 6 ) .. "_desc"
        end
        return ""
    end)
    
    -- дедупликация: убираем одинаковые enc_* в рамках одной строки
    local seen = {}
    local parts = vergas_lib.str_explode( ";", messages, true )
    local result = {}
    for _, part in ipairs( parts ) do
        if string.sub( part, 1, 4 ) == "enc_" then
            if not seen[ part ] then
                seen[ part ] = true
                table.insert( result, part )
            end
        else
            table.insert( result, part )
        end
    end
    return table.concat( result, ";" )
end

function add_action_to_current_pda( action, only )
    local pda_id = get_current_pda_id()
    if not pda_id then return false end

    local sobj = alife():object( pda_id )
    if not sobj then return false end

    local pk = get_netpk( sobj, 1 )
    if not pk then return false end

    local data = pk:get()
    local old_cdata = data.custom_data
    local info = vergas_lib.str_explode( "|", old_cdata, true )
    if not info or not info[5] then return false end

    -- если only — затираем все существующие записи
    if only then
        info[5] = action
    else
        if info[5] == "" or info[5] == "0" then
            info[5] = action
        else
            info[5] = info[5] .. "," .. action
        end
    end

    data.custom_data = table.concat( info, "|" )
    pk:set( data )

    local n = get_number_record()
    if n and tbl_info[ n ] == old_cdata then
        tbl_info[ n ] = data.custom_data
    else
        change_info_pda_record( old_cdata, data.custom_data )
    end

    return true
end

function update_current_pda_tbl_info()
    local n = get_number_record()
    local pda_id = get_current_pda_id()
    if not n or not pda_id then return end
    local cdata = get_pda_cdata( pda_id )
    if cdata then
        tbl_info[ n ] = cdata
    end
end

--[[	 Более предсказуемая, Может даже легче Вергасовской

function generate_anagram( word )
    local chars = {}
    for c in word:gmatch( "." ) do
        table.insert( chars, c )
    end
    
    local result = ""
    local word_length = #chars
    
    -- Разделим слово на части
    local parts = math.floor( word_length / 3 )
    if parts < 2 then parts = 2 end
    
    for i = 1, parts do
        local start = math.floor( ( i - 1 ) * word_length / parts ) + 1
        local ende = math.floor( i * word_length / parts )
        
        -- Перемешаем каждую часть отдельно
        local part = {}
        for j = start, ende do
            table.insert( part, chars[ j ] )
        end
        
        -- Перевернем часть с вероятностью 50%
        if rnd() > 0.5 then
            local reversed = {}
            for j = #part, 1, -1 do
                table.insert( reversed, part[ j ] )
            end
            part = reversed
        end
        
        -- Добавим перемешанную часть к результату
        while #part > 0 do
            local index = rnd( 1, #part )
            result = result .. part[ index ]
            table.remove( part, index )
        end
    end
    
    -- Добавим дополнительное перемешивание
    if rnd() > 0.5 then
        result = string.reverse( result )
    end
    
    return result
end

]]


function set_pda_condition( id, status_pda )
    local status = 1
    if status_pda then
        status = status_pda
    else
        local cdata = vergas_pda.get_pda_cdata( id )
        --log2("set_pda_condition id=%s cdata=%s", tostring(id), tostring(cdata))
        local info = vergas_lib.str_explode( "|", cdata, true )
        if not info or not info[ 4 ] then
            --log2("set_pda_condition: no info[4], returning")
            return
        end
        status = tonumber( string.sub( info[ 4 ], 13, 13 ) ) or 3
        --log2("set_pda_condition: status=%s", tostring(status))
    end
    if status == 3 then
        params.upd_condition( id, 0.5 )
    elseif status == 2 then
        params.upd_condition( id, 0.75 )
    end
end

function sort_actor_pda_on_load()
    db.actor:iterate_inventory(
    function( dummy, item )
        if item:section() == "device_pda_npc" then
            set_pda_condition( item:id() )
        end
    end, db.actor )
end

-- [HE-PORT]
function get_pda_status( pda_id )
	local info = vergas_lib.str_explode( "|", get_pda_cdata( pda_id ), true )
	if not info or not info[ 4 ] then return nil end
	local status = string.sub( info[ 4 ], 13, 13 ) or "3"
	return tonumber( status )
end
