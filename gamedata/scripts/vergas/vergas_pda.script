function set_status_pda()
	local n = lua_random( 1, 10 )
	
	if n < 6 then
		return 1		--пда рабочий
	elseif n < 9 then
		return 2		--пда разряженный
	elseif n <= 10 then
		return 3		--пда битый
	end
end

function add_tbl_pda( npc, pda, status, messages, only )
    local entry = tostring(npc).."|"..tostring(pda).."|"..tostring(status)
    if messages then
        entry = entry.."|"..messages
    end
    if only then
        entry = entry.."||only"
    end
    table.insert( tbl_spwn_pda, entry )
end

