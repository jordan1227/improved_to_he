-- ==========================================
-- FDDA blackout tuning: which ppe cover to use and how long it holds.
-- deimos_short.ppe is the original brief blink; deimos_longer.ppe is the
-- new ~2s cover for filthy/wrecked masks. Below the threshold we use the
-- short one (old behavior); at/above it, the long one.
-- ==========================================

-- EQUIP SEQUENCE (Putting mask on)
local FADE_LEAD_MIN_EQ = 350   -- ms before anim end to start fade (clean mask)
local FADE_LEAD_MAX_EQ = 1400  -- ms before anim end to start fade (worst-case dirty mask)

-- UNEQUIP SEQUENCE (Taking mask off)
local FADE_START_UN    = 50    -- ms after unequip anim starts to trigger fade (fixed)
local FADE_HOLD_MIN_UN = 200   -- Minimum blackout duration for clean masks
local FADE_HOLD_MAX_UN = 600   -- Maximum blackout duration for dirty masks

-- POST-PROCESS EFFECTS (PPE) FILES
local PPE_SHORT_EQ = "deimos_short.ppe" -- Brief blink for clean masks
local PPE_LONG_EQ  = "deimos_longer.ppe" -- Longer cover (~2s) for filthy/wrecked masks

-- PPE HOLD TIMES (How long the engine enforces the effect)
local PPE_SHORT_HOLD_EQ = 300   -- ms; matches old working behavior for mild cases
local PPE_LONG_HOLD_EQ  = 1400  -- ms; matches deimos_longer's authored length

-- THRESHOLDS
-- Severity is a 0.0 to 1.0 scale based on mask dirt/damage.
-- If severity is >= 0.35, the engine swaps to the longer PPE and hold times.
local SEVERITY_LONG_THRESHOLD_EQ = 0.35 

-- Reads severity straight off the string mask_definition() already returns
-- (format ends "..._<condition 1-6>_<dirt phase 1-6>"), no extra lookups needed.
local function get_mask_severity(mask)
    if not mask or mask == "?" then return 0 end
    local dmg, dirt = mask:match("_(%d)_(%d)$")
    dmg, dirt = tonumber(dmg), tonumber(dirt)
    if not dmg or not dirt then return 0 end
    dmg = math.min(math.max(dmg, 1), 6)
    dirt = math.min(math.max(dirt, 1), 6)
    return math.max((dmg - 1) / 5, (dirt - 1) / 5) -- swap to an average if max feels too harsh
end

local last_mask_toggle = 0 -- Sivol mask 
local MASK_TOGGLE_COOLDOWN = 3500 -- ms

function is_animating()
    return is_headgear_animating
end

-- Emergency cleanup to prevent the "busy hands" softlock
function abort_animation()
    if is_headgear_animating then
        bind_stalker.restore_weapon()
        level.only_allow_movekeys(false)
        sivol.remove_move_penalty("mask") -- sivol.script 
        level.remove_pp_effector(4277) -- Clear any stuck fade
        is_headgear_animating = false
    end
end

function on_off_mask()
    local now = time_global()
    if now - last_mask_toggle < MASK_TOGGLE_COOLDOWN then return end
    last_mask_toggle = now
    if is_headgear_animating then return end

	local out = db.actor:get_current_outfit()
	local ms = out and get_mask_config(out:section()) or "?"
	if ms == "?" then return end
	local is_resp = is_respirator_outfit(out:section())   

    -- If no FDDA anim data exists for this mask, fallback to original NLC behavior
    if not fdda_headgear_data[ms] then
        level.only_allow_movekeys(true)
        bind_stalker.hide_weapon()
        sivol.add_move_penalty("mask", 0.4) -- sivol.script 
        schedule.add("off_mask", "vergas_masks.on_off_mask_end()", 2000)
        return
    end

    -- Start FDDA Sequence
    is_headgear_animating = true
    level.only_allow_movekeys(true)
    sivol.add_move_penalty("mask", 0.4) -- sivol.script 

    -- Check if the player is actually holding something right now
    local has_weapon = db.actor:active_item() ~= nil
    local WEAPON_HIDE_DELAY = has_weapon and 1200 or 75

    bind_stalker.hide_weapon()

    dsh.timeout(WEAPON_HIDE_DELAY, function()
        -- Safety check: did the actor die while waiting for weapon to lower?
        if not db.actor:alive() then
            abort_animation()
            return
        end

        local anim_data = fdda_headgear_data[out:section()] or fdda_headgear_data[ms]
        
        -- If somehow there is still no anim_data, bail out safely
        if not anim_data then
            abort_animation()
            return
        end
        
        if mask_on_off == false then
            -- ==========================================
            -- ===== EQUIP SEQUENCE =====================
            -- ==========================================
            local mask, armor = mask_definition()
            if mask ~= "?" then
                tip_breath = tip_brth[string.sub(mask, 1, 7)]
            end

            -- Play FDDA Equip Sound
            if anim_data.snd_e then
                local snd = xr_sound.get_safe_sound_object(anim_data.snd_e)
                if snd then
                    snd:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
                end
            end

            -- Attempt to play the 3D animation using anim_data's section
            local anm_duration = game.play_hud_motion(2, anim_data.hud_sec, "anm_equip", true, 1, true) or 2500
            
            -- FDDA's camera animation using anim_data's camera path
            level.add_cam_effector(anim_data.cam_e, 7538, false, "", 0, false)

            -- FDDA Fade Trick timing, scaled by how dirty/damaged the mask is right now.
            local severity = get_mask_severity(mask)
            local use_long_ppe = severity >= SEVERITY_LONG_THRESHOLD_EQ
            local ppe_name = use_long_ppe and PPE_LONG_EQ or PPE_SHORT_EQ
            local ppe_hold = use_long_ppe and PPE_LONG_HOLD_EQ or PPE_SHORT_HOLD_EQ

            local fade_lead = FADE_LEAD_MIN_EQ + (FADE_LEAD_MAX_EQ - FADE_LEAD_MIN_EQ) * severity
            fade_lead = math.max(fade_lead, ppe_hold) -- lead must cover at least the ppe's own duration

            local fade_time = math.max(0, anm_duration - fade_lead)
            local fade_remove_time = fade_time + ppe_hold
            
            -- NEW: Swap the 2D HUD state EARLY in the fade hold (200ms in, or halfway if hold is short).
            -- This guarantees the HUD triggers while the screen is fully black, 
            -- hiding the pop-up before the fade begins to clear.
            local swap_offset = math.min(800, ppe_hold * 0.5)
            local state_swap_time = math.max(fade_time, fade_time + swap_offset)
			
            
            -- Total sequence duration is unchanged, tied to the max of anim end or fade end
            local cleanup_time = math.max(anm_duration, fade_remove_time)

			if not is_resp then
				dsh.timeout(fade_time, function()
					level.add_pp_effector(ppe_name, 4277, false)
				end)
			end

			dsh.timeout(state_swap_time, function()
				set_mask_on_off_flag(true)
				if is_resp then
					flag_blurs, flag_cmd = false, false
				else
					flag_blurs, flag_cmd = true, true
				end
			end)

			if not is_resp then
				dsh.timeout(fade_remove_time, function()
					level.remove_pp_effector(4277)
				end)
			end

            -- 4. Cleanup
            dsh.timeout(cleanup_time, function()
                abort_animation() -- Safely cleans up and restores weapon
            end)

        else
            -- ==========================================
            -- ===== UNEQUIP SEQUENCE =====
            local mask, armor = mask_definition()
            local unequip_breath = "neutral"
            if mask ~= "?" then
                unequip_breath = tip_brth[string.sub(mask, 1, 7)] or "neutral"
            end

            -- 1. Play Sound immediately
            local sound = "device\\masks\\" .. unequip_breath .. "_off"
            snd_obj = xr_sound.get_safe_sound_object(sound)
            snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1)

            -- 2. Start Camera immediately
            level.add_cam_effector(anim_data.cam_u, 7538, false, "", 0, false)

            -- 3. Drop HUD state immediately
            set_mask_on_off_flag(false)
            flag_blurs, flag_cmd = false, false
            if nvd_params and nvd_params.off_pnv then
                nvd_params.off_pnv()
            end

            -- 4. Calculate Fade (runs immediately, doesn't wait for 250ms)
            local severity = get_mask_severity(mask)
            local fade_hold = FADE_HOLD_MIN_UN + (FADE_HOLD_MAX_UN - FADE_HOLD_MIN_UN) * severity
            local fade_time = math.min(FADE_START_UN, 2500) 
            local fade_remove_time = math.max(fade_time, math.min(2500, fade_time + fade_hold))

			if not is_resp then
				dsh.timeout(fade_time, function()
					level.add_pp_effector("deimos_short.ppe", 4277, false)
				end)
				dsh.timeout(fade_remove_time, function()
					level.remove_pp_effector(4277)
				end)
			end

            -- 5. Delay ONLY the 3D hands animation by 250ms
            dsh.timeout(250, function()
                -- Safety check inside the delay
                if not db.actor:alive() then
                    abort_animation()
                    return
                end
                
                local anm_duration = game.play_hud_motion(2, anim_data.hud_sec, "anm_unequip", true, 1, true) or 2500
                
                -- Cleanup only after the 3D animation actually finishes
                dsh.timeout(anm_duration, function()
                    abort_animation()
                end)
            end)
        end
    end)
end

function on_off_mask_eye()
	level.add_pp_effector("black_q.ppe", 1237, false)
end

function on_off_mask_end()
    -- This function is no longer called by our new logic, 
    -- but we leave it here in case other scripts call it.
    if is_headgear_animating then return end
    
    -- Original fallback logic if something else calls this
    bind_stalker.restore_weapon()
    level.only_allow_movekeys(false)
    sivol.remove_move_penalty("mask") -- sivol.script 
	return true	-- Не удалять, нужно для воспроизведения анимок
end

function save_mask_on_off()
	set_value("var_mask_on_off", mask_on_off)
end


function update_zoom()
	ogse_signals.get_mgr():reschedule(53)
	if mask_on_off then
		local act = get_actor_obj()
		if act and act:is_zoom_aiming_mode() then
			if flag_zoom then
				return
			else
				mask_zoom_stretchy(true)
			end
		else
			if flag_zoom then
				mask_zoom_stretchy(false)
			else
				return
			end
		end
	end
end

--[=[]]
local d_fov = 67.49
function update_zoom()
	ogse_signals.get_mgr():reschedule(53)
	if mask_on_off then
		local fov_n = device().fov
		local dlt = d_fov-fov_n
		if dlt>0.1 then
			d_fov = fov_n
			if flag_zoom then
				return
			else
				mask_zoom_stretchy(true)
			end
		elseif dlt<-0.1 then
			d_fov = fov_n
			if flag_zoom then
				mask_zoom_stretchy(false)
			else
				return
			end
		end
	end
end
--]=]
function mask_zoom_stretchy(param)
	if param then
		local wpn = db.actor:active_item()
		if not wpn then return end
		if  wpn:is_binoculars() then
			wnd_mask:Init(-512,-384-192,2048,1536+384)
		elseif 	wpn:is_weapon_magazined() then
			wnd_mask:Init(-512,-32,1536,800)
		end
		flag_blurs = false
		flag_zoom = true
	else
		wnd_mask:Init(0,0,1024,768)
		flag_blurs = true
		flag_zoom = false
	end
end

local function manual_hold_breath_active()
    return sivol_weapon and sivol_weapon.is_manual_hold_breath_active
        and sivol_weapon.is_manual_hold_breath_active()
end

function update_blurs()
    local armor = db.actor and db.actor:item_in_slot(6)
    local is_resp = armor and is_respirator_outfit(armor:section())
    if is_resp or manual_hold_breath_active() then
        -- Freeze the breath cycle while holding breath so releasing it does not
        -- apply the elapsed time as a large condensation/decay step.
        if not is_resp then
            blurlt = time_global()
            blurcyctime = blurlt
            blurlastphase = 0
        end
        set_blurs(false)
    else
        set_blurs(flag_blurs)
    end
end

function set_blurs(enabled)
	local rect = set_zoom_stretchy_rect()
	if not blurs then return end
	if not enabled then
		for i = 1,4 do
          if blurs[i] then blurs[i]:SetWidth(0) end
		end
		return		
	end
	local power = db.actor.power
	local period = 1.0+power^2 -- ??????? ??????? ??????? ?? 30 ?? 120 ?????? ? ??????
	local expirt = 0.3
	local breathpower = 3
	
	local delta = (time_global()-blurlt)/1000
	local phase = (time_global()-blurcyctime)/1000
	blurlt = time_global()
	if phase>period then
		phase = phase%period
		blurcyctime = blurlt-phase*1000
	end
	if blurlastphase>phase then
		blurlastphase = 0
	end
	
	local blurdelta = delta*-0.7
	if blurlastphase<expirt and phase<expirt then
		blurdelta = blurdelta+(phase-blurlastphase)*breathpower
	elseif blurlastphase<expirt then
		blurdelta = blurdelta+(expirt-blurlastphase)*breathpower
	end
	blurlastphase = phase
	
	blurval = blurval+blurdelta
	if blurval>0.999 then
		blurval = 0.999
	elseif blurval<0 then
		blurval = 0
	end
	
	local tm = math.floor(blurval*3)
	local tmn = (tm+1)
	local v = blurval*3-math.floor(blurval*3)
	v = 1-v
	local v1 = 1-v
	if tm~= 0 then
		blurs[tm]:SetColor(GetARGB(v*255,255,255,255))
	end
	if tmn~= 0 then
		blurs[tmn]:SetColor(GetARGB(v1*255,255,255,255))
	end
	for i = 1,4 do
		if i == tm or i == tmn then
			blurs[i]:SetWndRect(rect.x,rect.y,rect.w,rect.h)
		else
			blurs[i]:SetWndRect(rect.x,rect.y,0,0)
		end	
	end
end

local con_fov = get_console():get_float("fov") or 67.5
function set_zoom_stretchy_rect()
	local zoom = con_fov/device().fov
	zoom = (zoom-1)*1.5+1
	if zoom<1.001 then
		zoom = 1.001
	end
	local stretchy = 0.75/(math.floor(device().aspect_ratio*1000)/1000)
	if stretchy<1 then 
		stretchy = 1 
	end
	local rect = {x = -768*zoom+768,y = (-512*zoom+512)*stretchy-(stretchy-1)*300,w = 1024*zoom,h = 768*zoom*stretchy}
	
	return rect
end

function set_flag_dirt(param)
	flag_dirt = param
end
function replace_dirt_phase()
	local armor = db.actor:item_in_slot(6)
	if armor then
		local armor_custom = set_get_armor_custom(2)
		if armor_custom ~= "none|none|none" then
			mask_clearing()
			local t = vergas_lib.str_explode("|",armor_custom,true)
			local number_dirt_phase = tonumber(t[2])
			number_dirt_phase = number_dirt_phase - lua_random(2)
			if number_dirt_phase < 1 then
				number_dirt_phase = 1
			end
			armor_custom = t[1].."|"..tostring(number_dirt_phase).."|0"
			set_get_armor_custom(1,armor_custom)
		else
			vergas_lib.s_play("device\\masks\\water_flask",5)
		end
	else
		vergas_lib.s_play("device\\masks\\water_flask",5)
	end
end

function mask_clearing()
	vergas_lib.s_play("device\\masks\\mask_"..lua_random(1,5),1)
	schedule.add("clean_end", "vergas_masks.mask_clean_end()", 1500) 
end

function mask_clean_end()
	level.add_pp_effector("black_off_slowly.ppe", 2121, false)
	schedule.add("cleaned_end", "vergas_masks.mask_cleaned_end()", 4000) 
	schedule.add("flask_end", "sak.restore_weap()", 9000) 
end

function mask_cleaned_end()
	used_items.set_get_flag_use_gadget(1,true)
	flag_dirt = false
	mask_old = "?" 
end

function fill_flask()
	-- [HE-PORT]
	local flag_fill = false
	local portions_of_water = math.floor( vergas_lib.set_pr_from_config( "flask_army", "portions_of_water" ) )
	if portions_of_water < 2 then portions_of_water = 5 end
	level.disable_input()
	bind_stalker.hide_weapon()
	if db.actor then
		for i = 0, db.actor:object_count() - 1 do
			local flask = db.actor:object( i )
			local sect = flask and flask:section()
			if sect == "flask_army" or sect == "flask_army_on_belt" then
				vergas_flask.set_flask_water( flask, portions_of_water )
				flag_fill = true
			end
		end
	end
	if flag_fill then
		vergas_lib.s_play([[ambient\waterflow]],1)
		timers.start_timer("fill_timer",14,"vergas_masks.end_fill_timer()")					--???????? ??????
		sak.send_tip_local(game.translate_string("fill_flask_1"),game.translate_string("fill_flask_2"), 1, 10, "g_g", "sak", "sky_blue")
	else
		sak.send_tip_local(game.translate_string("fill_flask_3"),game.translate_string("fill_flask_4"), 1, 10, "g_g", "sak", "red")
		--vergas_lib.s_play([[device\masks\water_no]],1)
		vergas_lib.s_play( [[device\antirad_no]], 1 )
		bind_stalker.restore_weapon()
		level.enable_input()
	end
end

function end_fill_timer()
	bind_stalker.restore_weapon()
	vergas_lib.s_play([[device\masks\water_ok]],1)
	level.enable_input()
end

-- [HE-PORT-R2] ??????? ??????? NLC HE ?? vergas\vergas_masks.script

-- [HE-PORT] proxy: staroe hranilishche nlc_vars poverh dvizhkovogo xvars (get_value/set_value iz _g)
if nlc_vars == nil then
  nlc_vars = setmetatable( {}, {
    __index    = function( t, k ) return get_value( "nlc_vars." .. k ) end,
    __newindex = function( t, k, v ) set_value( "nlc_vars." .. k, v ) end,
  } )
end
function have_dsc_water()
    if not nlc_vars.dsc_fill_time then return true end
	local saved_time = unpack_time_from_string( nlc_vars.dsc_fill_time )	
	local time_diff_sec = saved_time:diffSec( game.get_game_time() )
	local time_diff_hours = math.floor( math.abs( time_diff_sec / 3600 ) ) -- ??????? ? ????	
	return time_diff_hours >= 22	-- ????? ?????
end
function not_have_dsc_water()
	return not have_dsc_water()
end



-- ??? ????????? ???????
function manage_armor_mask_params(armor_obj, mode, custom)
    local sobj = g_sim:object(armor_obj:id())
    if not sobj then return end
    local ini = sobj:spawn_ini()
    
    if mode == "get" then
        local custom, cond = "", 100
        if ini and ini:section_exist("mask") then
            local st1 = get_string("mask", "t1", nil, ini)
            local st2 = get_string("mask", "t2", nil, ini)
            local st3 = get_string("mask", "t3", nil, ini)
            cond = get_u32("mask", "t4", 100, ini)
            if st1 and st2 and st3 then
                custom = st1 .. "|" .. st2 .. "|" .. st3
            end
        end
        return custom, cond / 100
    elseif mode == "set" then
        ini.readonly = false
        local custom_parts = vergas_lib.str_explode("|", custom, true)
        log3("Saving to ini: t1 = %s, t2 = %s, t3 = %s", 
              tostring(custom_parts[1] or "none"), 
              tostring(custom_parts[2] or "none"), 
              tostring(custom_parts[3] or "none"))
        ini:w_string("mask", "t1", tostring(custom_parts[1] or "none"))
        ini:w_string("mask", "t2", tostring(custom_parts[2] or "none"))
        ini:w_string("mask", "t3", tostring(custom_parts[3] or "none"))
        sobj:save_spawn_ini()
    end
end

function mask_definition_new(armor_obj)
    local mask = "?"
    local n_phase
    local combez
    
    if armor_obj then
        combez = armor_obj:section()
        local custom, cond = manage_armor_mask_params(armor_obj, "get")
        
        if custom then
            cond = set_hud_textur(cond)
            
            if custom == "none" then
                local ms = get_mask_config(combez)
                if ms ~= "?" then
                    mask = ms
                    mask = mask..cond
                    
                    local new_params = {}
                    new_params.t1 = ms
                    
                    if tonumber(string.sub(cond, 2, 2)) == 1 then
                        n_phase = 1
                        new_params.t2 = "1"
                        new_params.t3 = tostring(lua_random(1, 6))
                    else
                        n_phase = lua_random(1, 6)
                        new_params.t2 = tostring(n_phase)
                        new_params.t3 = tostring(lua_random(1, 6))
                    end
                    mask = mask.."_"..n_phase
                    
                    manage_armor_mask_params(armor_obj, "set", new_params)
                else
                    mask = "?"
                    manage_armor_mask_params(armor_obj, "set", "none|none|none")
                end
            else
                local custom_parts = vergas_lib.str_explode("|", custom, true)
                mask = custom_parts[1]..cond.."_"..(custom_parts[2] or "none")
            end
        end
    else
        mask, combez, tip_breath = "?", "?", tip_brth["?"]
    end
    
    return mask, combez
end
