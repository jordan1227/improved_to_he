-- [HE-PORT]
-- ----סענוכüבא מע בוהנא----

local DEV_MAX = 0.15
local T_MIN   = 1000
local T_MAX   = 10000
local RESCHED = 70

local apply_const_dev = true
local next_dev_t      = 0

local function get_bool(sect, field, def)
	if sys_ini and sys_ini:line_exist(sect, field) then
		return sys_ini:r_bool(sect, field)
	end
	return def
end

local function calc_dev()
	return DEV_MAX * math.random() * 2 - DEV_MAX
end

local function zero_dev(w)
	if w and w.const_deviation then
		w.const_deviation.pitch = 0
		w.const_deviation.yaw   = 0
	end
end

local function configure(item)
	if not game_options.WeaponFirePenalties then
		local ok_w, w = pcall(item.get_weapon, item)
		if ok_w then zero_dev(w) end
		next_dev_t = 0
		return
	end
	if not apply_const_dev then return end
	local actor = db.actor
	if actor then
		local ok_zm, zm = pcall(actor.zoom_mode, actor)
		if ok_zm and zm then return end
	end
	local ok, mag = pcall(item.is_weapon_magazined, item)
	if not ok or not mag then return end
	if not get_bool(item:section(), "zoom_enabled", true) then return end
	if next_dev_t >= time_global() then return end
	local ok_w, w = pcall(item.get_weapon, item)
	if not ok_w or not w then return end
	w.const_deviation.pitch = calc_dev()
	w.const_deviation.yaw   = calc_dev()
	next_dev_t = time_global() + math.random(T_MIN, T_MAX)
end

local function on_update()
	ogse_signals.get_mgr():reschedule(RESCHED)
	local actor = db.actor
	if not actor then return end
	local item = actor:active_item()
	if not (item and item.section) then return end
	local ok, err = pcall(configure, item)
	if not ok then
		wprintf("[~T].~C0C #ERROR he_hipfire: %s", tostring(err))
	end
end

local function on_zoom_in(obj)
	apply_const_dev = false
	next_dev_t      = 0
	if obj and obj.section then
		pcall(zero_dev, obj:get_weapon())
	end
end

local function on_zoom_out(obj)
	apply_const_dev = true
end

function attach(sm)
	sm:subscribe({ signal = "on_update", fun = on_update })
	sm:subscribe({ signal = "on_actor_weapon_zoom_in", fun = on_zoom_in })
	sm:subscribe({ signal = "on_actor_weapon_zoom_out", fun = on_zoom_out })
end