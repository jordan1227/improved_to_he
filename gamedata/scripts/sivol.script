-- ===== Универсальное замедление ГГ (маски, еда, бинты и т.п.; можно подвзяать на что угодно по идее - какие-то абилки мутантов в bind_monster, например) =====
local move_penalties = {} -- [name] = coef (0..1)
local MOVE_PENALTY_FLOOR = 0.2 -- нижний предел суммарного коэффициента, чтобы несколько штрафов разом не занулили скорость

function add_move_penalty(name, coef)
	local old_coef = get_move_penalty_coef()
	move_penalties[name] = coef
	local new_coef = get_move_penalty_coef()
	-- масштабируем ТЕКУЩИЙ speed_multiplier напрямую — не форсируем check_artefact(),
	-- он может попасть на переходное состояние (напр. во время смены предмета/маски)
	-- и временно занулить артефактный бонус до следующего планового пересчёта
	db.actor.speed_multiplier = db.actor.speed_multiplier / old_coef * new_coef
end

function remove_move_penalty(name)
	if move_penalties[name] then
		local old_coef = get_move_penalty_coef()
		move_penalties[name] = nil
		local new_coef = get_move_penalty_coef()
		db.actor.speed_multiplier = db.actor.speed_multiplier / old_coef * new_coef
	end
end

function get_move_penalty_coef()
	local total = 1
	for _, coef in pairs(move_penalties) do
		total = total * coef
	end
	if total < MOVE_PENALTY_FLOOR then total = MOVE_PENALTY_FLOOR end
	return total
end
