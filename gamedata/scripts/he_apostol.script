local NPC_STORY_ID = 292
local INFO_ARMED = "he_apostol_armed"
local CAMP_PATH = "gar_angar_seryi_drug4_walk"
local CAMP_DIST = 3
local ITEMS = { "wpn_ak74", "wpn_pm", "ammo_5.45x39_fmj" }

function arm( actor, npc )
	if has_alife_info( INFO_ARMED ) then return end
	if not npc:alive() or xr_wounded.is_wounded( npc ) then return end
	if npc:position():distance_to( patrol( CAMP_PATH ):point( 0 ) ) > CAMP_DIST then return end
	if db.actor:see( npc ) then return end
	local sim = alife()
	for _, sec in ipairs( ITEMS ) do
		sim:create( sec, npc:position(), npc:level_vertex_id(), npc:game_vertex_id(), npc:id() )
	end
	db.actor:give_info_portion( INFO_ARMED )
end

function release( actor, npc )
	sak.make_any_npc_free( NPC_STORY_ID )
end
