-- "(!) Reminders" for the PDA Notes tab and the Journal pointer line (docs/PDA_UPGRADE_DESIGN.md section 6).
-- The text itself is built by engine_callbacks.reminders_text (rental, repair and charging timers, fuel
-- needs, running cooks); this module only decides what each place shows.
local function tr(id) return game.translate_string(id) end

-- Journal article "reminders_main": one line for every PDA. The records live in the Notes tab.
function journal_text()
	return tr(he_pda_access.has_notes() and "he_reminders_in_notes" or "he_reminders_need_module")
end

-- Body of the pinned Reminders entry (colour codes and escaped line breaks, like the Journal article).
function notes_text()
	local txt = engine_callbacks.reminders_text(false)
	local probe = string.gsub(txt or "", "\\n", "")
	probe = string.gsub(probe, "%s", "")
	if probe == "" then return tr("he_reminders_empty") end
	return txt
end
