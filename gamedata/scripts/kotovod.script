function hide_zub_recipes( except_lvl )
	local npc = g_sim:object( "bar_zub" )
	if not npc then return end

	local zub = level.object_by_id( npc.id )
	local to_release = {}
	local except_recipes = kotovod[ except_lvl ] or {}

	for i = 0, zub:object_count() - 1 do
		local rec = zub:object( i )
		if rec then
			local name = rec:section()
			local info = name:gsub( "doc", "info_artmod" )
			if has_alife_info( info ) or not str_in_tab( info, except_recipes ) then
                table.insert( to_release, rec )
                if not has_alife_info( info ) then
                    table.insert( hidden_recipes, name )
                end
            end
        end
    end

	for _, rec in ipairs( to_release ) do
		misc.release_obj( rec )
	end
end
function isBarterAvailable( treshold, npc_koeff )
    local day = timers.Get_Game_Days() or 1
	if day < 1  then day = 1 end
    if day > 45 then day = 45 end
    local chance = dsh.get_fixed_random( "kotovod.isBarterAvailable." .. npc_koeff, day, ( 80 - day ), 100 )
    wprintf( "----------CHANSE: "..chance.." --------- TRESHOLD: "..treshold.. " -------- DAY: "..day.." ------ npc_koeff: ".. npc_koeff )
    if chance >= treshold then return true end
    return false
end
function ivar_art_needed()
    local ind  = amk_vars.r_treas_items + amk_vars.r_task_reward -1
    if ind > 7 or ind < 1 then ind = 7 end
    local art_sect = kotovod.tbl_arts.lvl3[ ind ]
	local art_sect_text = game.translate_string( system_ini():r_string( art_sect, "inv_name" ) )		
    db.actor:give_talk_message(
        "Попробуй мне артефакт, как он там наз... тся: " .. art_sect_text .. " найти. Хочу сравнить со своим, одинаковые свойства или нет...",
        "ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item"
    )
	if db.actor:object( "klava" ) ~= nil then
		local req_txt = game.translate_string( "Ивар просит принести ему: " .. art_sect_text )		
		vergas_lib.add_record_in_klava( "custom", req_txt, "Просьба Ивара" )		
	end			
end
