function timer_gar_dm()
	schedule.add( "kill_gar_dm", "kotovod.kill_gar_dm()", 2000 )
end
function transfer_actor_items_to( name )
	local created_rucksack = misc.spawn_to( "rucksack", db.actor )
	misc.process_spawn()
	kotovod.add_box_protection( created_rucksack:name() )
	nlc_vars[ name .. "_rucksack" ] = created_rucksack.id
	-- [HE-PORT-R2] fix: в OGSR process_spawn — заглушка, клиентский объект рюкзака
	-- появляется на следующем кадре; перенос вещей выполняем отложенно
	kotovod.transfer_actor_items_to_deferred( name, created_rucksack.id, 10 )
end
function transfer_actor_items_to_deferred( name, rid, tries )
	local created_rucksack_id = level.object_by_id( rid )
	if created_rucksack_id == nil then
		if tries and tries > 0 then
			schedule.add( "transfer_rucksack", string.format( "kotovod.transfer_actor_items_to_deferred(%q,%d,%d)", name, rid, tries - 1 ), 300 )
		end
		return
	end
	local whom = level.object_by_id( g_sim:object( name ).id )
	local items = get_shadow_inv():get_content( true )
	for i, rec in items:ipairs() do
		local sect = sak_inventory.dyn_art_base( rec.sect )
		if 
			   rec.obj:is_weapon() 
			or rec.obj:is_grenade() 
			or rec.obj:is_outfit() 
		then
			local owner = rec.obj:parent()
			owner:transfer_item( rec.obj, created_rucksack_id )
			sak.relocate_item( "out", rec.obj:section(), 1 )
		end
	end
	if whom then
		db.actor:transfer_item( created_rucksack_id, whom )
	end
	sak_inventory.need_update_inventory()
end
function transfer_to_actor_from( name )
	if nlc_vars[ name .. "_rucksack" ] == nil then return end
	
	-- registry хреново пашет и не всегда сразу обрабатывает
	local ruck = client_obj( tonumber( nlc_vars[ name .. "_rucksack" ] ) )
	if ruck then 
		local items_to_transfer = {}
		for i = 0, ruck:object_count() - 1 do
			local item = ruck:object( i )
			if item then
				table.insert( items_to_transfer, item )
			end
		end
		
		for _, item in ipairs( items_to_transfer ) do
			ruck:transfer_item( item, db.actor )
			sak.relocate_item( "in", item:section(), 1 )
			if item:is_outfit() then 
				if db.actor:get_current_outfit() == nil then 
					level.client_spawn_manager():add(
						item:id(), -1,
						function( id, item )
							db.actor:move_to_slot( item )
						end
					)	
				end	
			end
		end
		remove_box_protection( ruck:name() )	
	end
	misc.release_obj( nlc_vars[ name .. "_rucksack" ] )
	nlc_vars[ name .. "_rucksack" ] = nil	
end
function uncharged_pda( flag, amount )
    local items = get_shadow_inv():get_content( true )
    local real = 0
    local matching_items = {}

    for i, rec in items:ipairs() do    
        local sect = sak_inventory.dyn_art_base( rec.sect )
        if sect == "device_pda_npc" and rec.obj:condition() == 0.75 then            
            local item_amount = nlc_container.amount_in_batch( rec.obj )
            
            table.insert( matching_items, { obj = rec.obj, amount = item_amount } )
            real = real + item_amount

            if flag == "have" then 
                if real >= amount then return true end
            end
        end
    end

    if flag == "give" and real >= amount then
        for _, item in ipairs( matching_items ) do
            misc.release_obj( item.obj )
        end
		sak.relocate_item( "out", "device_pda_npc", real )
    end

    return false    
end
function ungroup_ammo()
	db.actor:iterate_inventory( function ( dummy, item )
		if strpos( item:section(), "^ammo_" ) then
			if item:get_ammo().current ~= vergas_lib.get_box_size( item:section() ) then
				set_item_ungroupable( item )
				table.insert( arny_table, item:id() )
			end	
		end 
	end, nil )
end
function zub_assisted_treasure( flag )
	local payment  = ReadIni( db.stor_ltx, "stor", "zub_payment" ) 
	local zub_stor = vergas_lib.str_explode( "|", payment, true ) 
	local treasure = tonumber( zub_stor[ 1 ] )
	local amount   = tonumber( zub_stor[ 2 ] )	
	local money    = tonumber( zub_stor[ 3 ] )
	
	if flag == "not_payed" then
		if money ~= 0 then return true end
		return false
	end
	
	if flag == "scammed" then
		if treasure ~= 0 and amount ~= 0 and money ~= 0 and not has_alife_info( "info_zub_payment_waiting" ) then return true end
		return false
	end	
	
	if flag == "money_have" then
		if money == 0 then return false end	
		return db.actor:money() >= money	
	end

	if flag == "money_give" then 
		db.actor:give_money( -money )
		sak.show_relocated_money( "out", money )
		WriteIni( db.stor_ltx, "stor", "zub_payment", 0 .. "|" .. 0 .. "|" .. 0 )			
		timers.stop_timer( "empty_assisted_treasure" )		
		db.actor:disable_info_portion( "info_zub_payment_waiting" )		
	end	
	
	if flag == "scammed_have" or flag == "scammed_give" then 
		if ( treasure == 0 and amount == 0 and money == 0 ) then return false end
		local items = get_shadow_inv():get_content( true )
		for i, rec in items:ipairs() do
			if sak_inventory.dyn_art_base( rec.sect ) == "device_pda_npc" then
				if rec.obj:condition() == 1 then
					local ini 	= ini_file( "misc\\treasure_manager.ltx" )		
					local data 	= vergas_pda.get_pda_cdata( rec.obj:id() )	
					local info 	= vergas_lib.str_explode( "|", data, true ) 				
					local place = info[ 6 ]	
					if place == 0 then return end
					local id 	= utils.cfg_get_number( ini, place, "target", nil, false )					
					if ( id == treasure and db.actor:money() >= money ) then 					
						if flag == "scammed_have" then
							return true
						end
						if flag == "scammed_give" then 	
							db.actor:give_money( -money )
							sak.show_relocated_money( "out", money )
							misc.release_obj( rec.obj )	
							sak.relocate_item( "out", "device_pda_npc", 1 )	
							db.actor:disable_info_portion( "info_zub_payment_waiting" )
							WriteIni( db.stor_ltx, "stor", "zub_payment", 0 .. "|" .. 0 .. "|" .. 0 )
						end
					end
				end
			end	
		end	
	end	
end
function zub_have_any_recipes()
    return check_any_recipes( first_level, second_level, third_level, dummys )
end

