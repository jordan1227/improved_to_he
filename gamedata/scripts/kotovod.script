            if v[ i ] == info then
                rec_name = game.translate_string( sak_artmods.artmod_resiepts[ k ][ 7 ] )
				sect = sak_artmods.artmod_resiepts[ k ][ 6 ]
				sect = sect:gsub( "_capsule", "" )		
				colour = "%c[ 255, 238, 153, 26 ]"
            end
        end
    end
    for k, v in pairs( sak_artmods.amk_resiepts ) do
        for i = 1, #v do
            if v[ i ] == info then
                rec_name = game.translate_string( sak_artmods.amk_resiepts[ k ][ 3 ] )
				sect = string.gsub( sak_artmods.amk_resiepts[ k ][ 3 ], "_name", "" )
				colour = "%c[ 255, 20, 120, 215 ]"			
            end
        end
    end
    for k, v in pairs( sak_artmods.unique_resiepts ) do
        for i = 1, #v do
            if v[ i ] == info then
				db.actor:give_info_portion( info )	   		
                rec_name = game.translate_string( sak_artmods.unique_resiepts[ k ][ 2 ] )
				sect = sak_artmods.unique_resiepts[ k ][ 3 ]			
				colour = "%c[ 255, 245, 85, 105 ]"					
            end
        end
    end
	-- TODO: Kotovod добавить потом
	--if game_options.IconsDialogue == true and db.actor:is_talking() then
	--	local icon_group, x, y, dx, dy, iconed_item	= sak.get_talk_item_icon( sect )
	--	local news_text = "%c[ 255, 160, 160, 160 ]" .. game.translate_string( "Получен рецепт преобразования артефакта: " ) .. colour .. "«" .. rec_name .. "»"	
	--	db.actor:give_talk_message( news_text, icon_group, Frect():set( x, y, dx, dy ), iconed_item )
	--else	
		sak.send_tip( 
			colour .. "«" .. rec_name .. "»", 
			"Получен рецепт преобразования артефакта:", 0, 15, "artmod", "pda_news", "gray" 
		)
	--end
end
function generate_recipes_table()
    local table_recipes = {
        first     = {},
        second    = {},
        third     = {},
        dummy     = {},
        modificat = {}
    }

    -- Единая функция для добавления рецептов уровня
    local function add_level_recipes(source, target)
        for _, recipe in pairs(source) do 
            if not has_alife_info(recipe) then 
                table.insert(table_recipes[target], recipe)
            end 
        end
    end

    -- Добавляем рецепты для каждого уровня
    add_level_recipes(kotovod.first_level, "first")
    add_level_recipes(kotovod.second_level, "second")
    add_level_recipes(kotovod.third_level, "third")
    add_level_recipes(kotovod.dummys, "dummy")
    add_level_recipes(kotovod.modifications_level, "modificat")
    
	set_value( "table_recipes", table_recipes )
end
function add_recipes_to_actor(lvl)
	if get_value( "table_recipes", nil ) == nil then generate_recipes_table() end    
    
    local table_recipes = get_value( "table_recipes", {} )

    -- Обработка абсолютов в отдельной функции
    if str_in_tab(lvl, absoluts) then 
        handle_absolut(lvl, table_recipes)
        return
    end

    -- Поиск конкретного рецепта
    if type(lvl) ~= "number" then 
        if find_specific_recipe(lvl, table_recipes) then
            return
        end
    end

    -- Основной цикл выдачи рецептов    
    while true do
        local level_name = RECIPE_LEVELS[lvl]
        local current_table = table_recipes[level_name]
        
        -- Если есть рецепты - выдаём случайный
        if #current_table > 0 then
            local index = dsh.get_next_random("kotovod.add_recipes_to_actor", #current_table)
            give_recipe(current_table[index])
            table.remove(current_table, index)        
            set_value( "table_recipes", table_recipes )
            return
        end

        -- Особая обработка уровня модификаций
        if lvl == 5 and not get_value( "add_absoluts" ) then 
            add_remaining_absoluts(table_recipes)
			set_value( "table_recipes", true )
            -- Продолжаем цикл для выдачи добавленных рецептов
        else
            -- Ищем рецепты на других уровнях
            local found = false
            local direction = lvl > 3 and -1 or 1
            
            repeat 
                lvl = lvl + direction
                if #table_recipes[RECIPE_LEVELS[lvl]] > 0 then
                    found = true
                    break
                end
            until lvl == 3

            if not found then
                add_rnd_treasure()
                return
            end
        end
    end    
end    

-- Для выдачи рандомных рецептов из пдашек тайниковых
function get_rnd_recipe_for_pda( lvl )
    if not get_value( "table_recipes" ) then generate_recipes_table() end
    local table_recipes = get_value( "table_recipes", {} )
    
    local levels_to_try = { lvl }
    for i = 1, 3 do
        if i ~= lvl then
            table.insert( levels_to_try, i )
        end
    end
    
    for _, try_lvl in ipairs( levels_to_try ) do
        local level_name = RECIPE_LEVELS[ try_lvl ]
        if level_name then
            local current_table = table_recipes[ level_name ]
            if current_table and #current_table > 0 then
                local index = dsh.get_next_random( "kotovod.get_rnd_recipe_for_pda", #current_table )
                local info = current_table[ index ]
                table.remove( current_table, index )
				set_value( "table_recipes", table_recipes )
                return "enc_" .. string.sub( info, 6 ) .. "_desc"
            end
        end
    end
    
    -- table_recipes пуст - пробуем из полных таблиц, исключая уже выданные на пда
	local all_tables = { kotovod.first_level, kotovod.second_level, kotovod.third_level, kotovod.dummy_level, kotovod.modifications_level }
    for _, try_lvl in ipairs( levels_to_try ) do
        local tbl = all_tables[ try_lvl ]
        if tbl and #tbl > 0 then
            local not_given = {}
            for _, info in ipairs( tbl ) do
                local enc_id = "enc_" .. string.sub( info, 6 ) .. "_desc"
                if not vergas_pda.is_enc_given( enc_id ) then
                    table.insert( not_given, enc_id )
                end
            end
            if #not_given > 0 then
                local enc_id = not_given[ lua_random( 1, #not_given ) ]
                return enc_id
            end
        end
    end
    
    return nil
end

function handle_absolut(recipe, table_recipes)
    give_recipe(recipe)
    if get_value( "add_absoluts" ) then 
        remove_recipe(recipe, table_recipes)
    end
end
function find_specific_recipe(recipe, table_recipes)
    for _, level_recipes in pairs(table_recipes) do
        for i = #level_recipes, 1, -1 do  
            if string.find(level_recipes[i], recipe, 1, true) then  
                give_recipe(recipe)
                table.remove(level_recipes, i)  
                set_value( "table_recipes", table_recipes )
                return true
            end  
        end  
    end
    return false
end
function give_recipe(recipe)
    db.actor:give_info_portion(recipe)
    sms_recipt_found(recipe)
end
function add_remaining_absoluts(table_recipes)
    for _, recipe in pairs(absoluts) do 
        if not has_alife_info(recipe) then 
            table.insert(table_recipes.modificat, recipe)    
        end    
    end
    set_value( "table_recipes", table_recipes )
end
function remove_recipe(recipe, table_recipes)
    for _, level_recipes in pairs(table_recipes) do
        for i = #level_recipes, 1, -1 do
            if level_recipes[i]:find(recipe) then        
                table.remove(level_recipes, i)
                set_value( "table_recipes", table_recipes )
            end    
        end
    end    
end
