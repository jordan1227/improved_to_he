function semenov_accum( flag, val )
    local stored_given_arts = xray_vars.load_table( nlc_vars, "stored_given_arts", {} )

	if flag == "get" then 
		if stored_given_arts[ "semenov" ] and stored_given_arts[ "semenov" ][ 1 ] then
			local cond = stored_given_arts[ "semenov" ][ 1 ].cond
			return cond
		else
			return nil
		end
		
	elseif flag == "show_available" then 
		local get_cond = semenov_accum( "get" )
		if get_cond == nil then return end
		local charges = round2( get_cond / 0.04 )
		db.actor:give_talk_message(	
			"Твой «Аккумулятор» потянет ещё около " .. "%c[255, 238, 153, 26]" .. charges .. "%c[default]" .. " зарядок, не более...",	
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item"
		)
	
    elseif flag == "update" then 
        for key, data in pairs( stored_given_arts ) do
            if key == "semenov" and data[ 1 ] and data[ 1 ].art == "af_dummy_dummy_new" then
                -- Уменьшаем кондицию артефакта
                data[ 1 ].cond = math.max( 0, data[ 1 ].cond + val )
                
                if data[ 1 ].cond <= 0 then
                    stored_given_arts[ key ] = nil
					db.actor:disable_info_portion( "info_semenov_pda_usage" ) -- Арт закончился, нужен новый
                end
                
                -- Сохраняем изменения
                nlc_vars.stored_given_arts = stored_given_arts 
                break
            end
        end
		
	elseif flag == "clear" then 
		db.actor:disable_info_portion( "info_semenov_pda_usage" )
		stored_given_arts[ "semenov" ] = nil
		nlc_vars.stored_given_arts = stored_given_arts
	end	
end
function semenov_charged_pda( flag )
	local amount = collect_pda_info()
	local price, cost
	
	if amount >= 1 then 
		price = sak_dialog.calc_money( 1000, 21, 250 )
		cost  = math.ceil( price * amount * ( 1 + ( amount * 0.03 ) ) )	
	end	
	
	if flag == "show" then 
		db.actor:give_talk_message( string.format( 
			"Зарядил %d %s. Стоимость: %s рублей. Устраивает?", amount, declension( amount, "прибор", "прибора", "приборов" ), "%c[255, 238, 153, 26]" .. cost .. "%c[default]" ),
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item"
		)		
	end
	
	if flag == "charged_pda_have" then 
		return amount >= 1
	end
	
	if flag == "charged_pda_not_have" then 
		return not semenov_charged_pda( "charged_pda_have" )
	end

	if flag == "money_have" then 
		if amount == 0 then return false end	
		return db.actor:money() >= cost
	end
	
	if flag == "money_give" then 
		db.actor:give_money( -cost )
		sak.show_relocated_money( "out", cost )
	end			
	
	if flag == "transfer" then
		local tbl_pda_ids = {}
		local pda_count = 0	
		
		local semenov = level_object_by_sid( 905 )
		if not semenov then return end		
	
		for i = 0, semenov:object_count() - 1 do
			local item = semenov:object( i )
			if item and item:section() == "device_pda_npc" and params.get_condition( item, 0.999 ) >= 0.99 then
				table.insert( tbl_pda_ids, item:id() )
				pda_count = pda_count + 1 
			end	
		end		
		
		for _, v in pairs( tbl_pda_ids ) do
			local pda = level.object_by_id( v )
			if pda then 
				semenov:transfer_item( pda, db.actor )	
			end	
		end
		tbl_pda_ids = {}
		sak.relocate_item( "in", "device_pda_npc", pda_count )		
		db.actor:disable_info_portion( "info_semenov_pda_charging" )		
	end
end
