function make_picture( item, amnt )
	local icon_group 	= sak.get_ui_icon_equipment_name( item )
	local x  			= vergas_lib.set_pr_from_config( item, "inv_grid_x"      ) * 50
	local y  			= vergas_lib.set_pr_from_config( item, "inv_grid_y"      ) * 50
	local dx 			= vergas_lib.set_pr_from_config( item, "inv_grid_width"  ) * 50
	local dy 			= vergas_lib.set_pr_from_config( item, "inv_grid_height" ) * 50	
	local iconed_item 	= "ico_item_" .. dx / 50 .. "_" .. dy / 50
	if amnt == nil then amnt = 1 end
	db.actor:give_talk_message( 
		"%c[ 255, 160, 160, 160 ]" .. get_inv_name( item ) .. " - ".. amnt .." шт.", 
		icon_group, Frect():set( x, y, dx, dy ), iconed_item 
	)
end	
function mil_couriers_done()
    local done_tasks_table = xray_vars.load_table(nlc_vars, "done_tasks_table", {})
    local couriers = {
        "skraga_courier_1", "skraga_courier_2", "skraga_courier_3", "skraga_courier_4", "skraga_courier_5",
        "freedom_courier_1", "freedom_courier_2", "freedom_courier_3", "freedom_courier_4"
    }
    
    local completed = 0
    for _, courier in ipairs(couriers) do
        if done_tasks_table[courier] then
            completed = completed + 1
        end
    end
    
    return completed == #couriers
end
function noBarterAvailable( treshold, npc_koeff )
	return not isBarterAvailable( treshold, npc_koeff )
end
function notify_cache_clear()
    nlc_vars.notify_cache = 0
    local found = timers.check_timer( "notify_tasks_check" )
    if not found then
        local check_interval = nlc_vars.notify_check_interval or 25
        timers.start_timer( "notify_tasks_check", 0, 0, check_interval, "task_manager.check_all_tasks_notify()" )
    end
end
function notify_cache_is_filling()
    local cache = nlc_vars.notify_cache or 0
    return cache > 0
end
function notify_can_decrease()
    local min = nlc_vars.notify_min or notify_interval_default.min
    return min > notify_interval_min_limit
end
function notify_can_increase()
    local max = nlc_vars.notify_max or notify_interval_default.max
    return max < notify_interval_max_limit + 20
end
function notify_is_active()
    local found = timers.check_timer( "notify_tasks_check" )
    return found == true
end
function notify_is_not_active()
    local found = timers.check_timer( "notify_tasks_check" )
    return found ~= true
end
function notify_is_not_default()
    return nlc_vars.notify_min ~= nil or nlc_vars.notify_check_interval ~= nil
end
function notify_mode_decrease()
    local min = nlc_vars.notify_min or notify_interval_default.min
    local max = nlc_vars.notify_max or notify_interval_default.max
    nlc_vars.notify_min = math.max( min - notify_interval_step, notify_interval_min_limit )
    nlc_vars.notify_max = math.max( max - notify_interval_step, notify_interval_min_limit + 15 )
    
    local check = nlc_vars.notify_check_interval or notify_check_interval_default
    nlc_vars.notify_check_interval = math.max( check - notify_check_step, 15 )
end
function notify_mode_increase()
    local min = nlc_vars.notify_min or notify_interval_default.min
    local max = nlc_vars.notify_max or notify_interval_default.max
    nlc_vars.notify_min = math.min( min + notify_interval_step, notify_interval_max_limit )
    nlc_vars.notify_max = math.min( max + notify_interval_step, notify_interval_max_limit + 20 )
    
    local check = nlc_vars.notify_check_interval or notify_check_interval_default
    nlc_vars.notify_check_interval = math.min( check + notify_check_step, 35 )
end
function pahom_mutant_request( flag )
	local table = { "mutant_psevdogigant_hand", "mutant_hand_kontroler", "mutant_poltergeist_glas" } 
	local rand  = amk_vars.r_treas_items or 1 
	local part  = table[ rand ]
	
	if flag == "show" then 
		local text = {
			"Про бройлеров-переростков. Ну и спустили до меня пожелание: тому, кто добудет часть от него, от гиганта, стало быть, тому почёт и уважение. Ну или, как в нашем случае, динамит и до свидания. Могу дать наводку. Наши говорили, что в Кишке есть мясник местный, Прошей кличут. Он может тебе в этом деле подсобить. Ну как?",
			"О том, как возникли такие мутанты как контролёры. Ну и спустили до меня пожелание: тому, кто добудет часть генного материала от него, от контролёра стало быть, тому почёт и уважение. Ну или, как в нашем случае, динамит и до свидания. Могу дать наводку. Наши говорили, что в Кишке есть мясник местный, Прошей кличут. Он может тебе в этом деле подсобить. Ну как?",
			"Про полтергейстов. Ну и спустили до меня пожелание: тому, кто добудет их глаз, от полтергейста, стало быть, тому почёт и уважение. Ну или, как в нашем случае, динамит и до свидания. Могу дать наводку. Наши говорили, что в Кишке есть мясник местный, Прошей кличут. Он может тебе в этом деле подсобить. Ну как?"
		}
		db.actor:give_talk_message(
			text[ rand ],
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item"
		)
	end	
	
	if flag == "show_again" then 
		local text = { "кусок гиганта", "от контролёра часть", "глаз полтергейста" }
		db.actor:give_talk_message(
			"Обговорили же всё! Принесёшь ".. text[ rand ] .. " тогда и про взрывчатку можно будет поговорить.",
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item"
		)		
	end
	
	if flag == "check_store" then 
		local pahom_mutants = xray_vars.load_table( nlc_vars, "pahom_mutants", {} )
		for k, v in pairs( pahom_mutants ) do 
			if strpos( v, part ) then 
				return true
			end
		end
		return false
	end
		
	if flag == "give_store" then 
		oxyr.remove_stored( part )
	end
	
	if flag == "have" then	
		return sak.have_items_count( part, 1 )		
	end			
	
	if flag == "give" then
		sak_inventory.release_actor_items( part, 1 )	
	end
	
	if flag == "prosha" then
		kotovod.add_bad_item( part, 0.44 )
	end
end
function petrenko_art_needed()
    local ind  = amk_vars.r_treas_items + amk_vars.r_task_reward -1
    if ind > 7 or ind < 1 then ind = 7 end
    local art_sect = kotovod.tbl_arts.lvl2[ ind ]
	local art_sect_text = game.translate_string( system_ini():r_string( art_sect, "inv_name" ) )		
    db.actor:give_talk_message(
        get_inv_name( art_sect )
        .. ". Только вот у меня нет такого артефакта... Если принесёшь, то я с тобой рецептом поделюсь.",
        "ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item"
    )
	if db.actor:object( "klava" ) ~= nil then
		local req_txt = game.translate_string( "Петренко просит принести ему: " .. get_inv_name( art_sect ) )		
		vergas_lib.add_record_in_klava( "custom", req_txt, "Артефакт для Петренко" )		
	end			
end
function petrenko_trade_process( item, sell_buy, money )
	if sell_buy == true then return end
	local sect = item:section()
	local petrenko_respawn_table = xray_vars.load_table( nlc_vars, "petrenko_respawn_table", {} )
	if type( petrenko_items[ sect ] ) == "table" then
		if #petrenko_items[ sect ] < 1 then return end
		for k, v in pairs( petrenko_items[ sect ] ) do 
			misc.release_by_name( "bar_petrenko_item_" .. v ) 
			table.insert( petrenko_respawn_table, "bar_petrenko_item_" .. v )
			table.remove( petrenko_items[ sect ], k )			
			break
		end	
	else
		misc.release_by_name( petrenko_items[ sect ] )
		table.insert( petrenko_respawn_table, petrenko_items[ sect ] )
	end	
	nlc_vars.petrenko_respawn_table = petrenko_respawn_table
end
function petrenko_trade_subscribe()
	if not petrenko_signal then
		petrenko_signal = {
			{ signal = "on_trade", 		fun = this.petrenko_trade_process 	  },
			{ signal = "on_trade_hide",	fun = this.petrenko_trade_unsubscribe },
		}
		local sm = ogse_signals.get_mgr()
		for _, s in ipairs( petrenko_signal ) do
			sm:subscribe( s )			
		end
	end
end
function random_saharov_art( flag_to_remove, show_needed )
    local ind  = amk_vars.r_treas_items + amk_vars.r_task_reward - 1
    if ind > 6 or ind < 1 then ind = 6 end
    local art_sect = kotovod.tbl_arts.lvl4[ ind ]
	local art_sect_text = game.translate_string( system_ini():r_string( art_sect, "inv_name" ) )
	
	if show_needed == true then 
		db.actor:give_talk_message(
			"Всё верно, было. Но как говорится, баш на баш." .. "\\n" .. 
			"Мы тут проводим эксперимент с редкими артефактами и нас очень интересует явление обратимой ремиссии живых клеток, которое наблюдается при воздействии на организм испытуемого аномальным образованием 	«A-67"..tostring( ind ).."», известным в среде сталкеров как: " .. art_sect_text .. "" .. "\\n" ..
			"Наверняка вы слышали о таком? Принесёте, покажу вам дорогу.",
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item"
		)
		if db.actor:object( "klava" ) ~= nil then
			local req = game.translate_string( 
				"Профессор Сахаров за тропку на «Север» просит принести ему артефакт:\\n" .. art_sect_text
			)		
			vergas_lib.add_record_in_klava( "custom", req, "Тропка от Сахарова" )
		end	
	end	
		
	if flag_to_remove == false then	
		return sak.have_items_count( art_sect, 1 )		
	end			
	
	if flag_to_remove == true then
		sak_inventory.release_actor_items( art_sect, 1 )	
	end
end
function remove_box_protection( name )	
	if name == "esc_inventory_box" and timers.Get_Game_Days() < 3 then return end
	local tbl = xray_vars.load_table( nlc_vars, "unstealable_boxes", {} )
	if #tbl < 1 then return end
	for k, v in pairs( tbl ) do 
		if v == name then 	
			table.remove( tbl, k )		
			-- sak.send_tip( name, "REMOVED", 0, 15, "g_g", "no", "red" )			
			-- kotovod.get_nlc( "unstealable_boxes" )				
		end
	end	
	nlc_vars.unstealable_boxes = tbl
end
function remove_known_saharov_recipes()
	local npc = g_sim:object( "yan_ecolog_saharov" )
	if not npc then return end
	
	local saharov = level.object_by_id( npc.id )
	local to_release = {}
	
	for i = 0, saharov:object_count() - 1 do
		local rec = saharov:object( i )
		if rec then
			local name = rec:section()
			local info = name:gsub( "doc", "info_amk" )
			if has_alife_info( info ) then
                table.insert( to_release, rec )
            end
        end
    end	
	
	for _, rec in ipairs( to_release ) do
		misc.release_obj( rec )
	end	
end
