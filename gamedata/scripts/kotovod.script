		{ "mutant_zombie_hand",  	 8, "руки зомбированных. Восемь"			},			
		{ "mutant_flesh_eye", 	  	 4, "глаза плотей. Четыре"					},
		{ "mutant_face_tushkano", 	13, "головы тушканов. Тринадцать"			},
		{ "mutant_tail_cat", 	 	 3, "хвосты котов... Три" 					}			
	}	
	local section 	= tbl[ ind ][ 1 ]
	local amount 	= tbl[ ind ][ 2 ]
	local translate = tbl[ ind ][ 3 ]
	local monster 	= get_inv_name( section )
	
	if show_needed == true then
		db.actor:give_talk_message(
			"Я могу предоставить коробочку образцов, но не за так. Нам вот сейчас необходимы " .. translate .." соберёшь и тогда по рукам. Идёт?",
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item"
		)
		if db.actor:object( "klava" ) ~= nil then
			local translate = string.lower( translate:match( "(%S+)$" ) )
			local req_txt = game.translate_string( 
				"Игнат предоставит колбаску долговцам на пробу за:\\n" .. monster .. " - " .. translate .. " шт."
			)		
			vergas_lib.add_record_in_klava( "custom", req_txt, "Охотничьи колбаски для Долга" )		
		end			
	end	
	
	if flag_to_remove == false then
		return sak.have_items_count( section, amount )
	end	
	
	if flag_to_remove == true then
		sak_inventory.release_actor_items( section, amount )	
	end	
end
