	local lname = level.name()
	return lname == name 
end
function demyan_outfit_coating( flag )
    -- Инициализируем значение
    nlc_vars.demyan_outfit_coating = nlc_vars.demyan_outfit_coating or 0
	
	if flag == "have" then 
		return nlc_vars.demyan_outfit_coating >= 7
		
	elseif flag == "have_not" then 
		return not demyan_outfit_coating( "have" )

	elseif flag == "show" then 
		if nlc_vars.demyan_outfit_coating == 6 then
			db.actor:give_talk_message(
				"Хотя тут вот какое дело... С руками этими ты нам уже здорово подсобил. Поступим иначе: можешь теперь за артефакты пропитку получить. Нам так сподручнее будет, база не на одних исследованиях держится, сам понимаешь... \nДа и тебе, 	глядишь, проще артефакты найти, чем по всей Зоне зомбаков выискивать. Но если попадутся ошмётки в нужном количестве - от них тоже не откажемся. Исследования-то продолжаются.",
				"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item"
			)
			nlc_vars.demyan_outfit_coating = 7
		end	
	
	elseif flag == "add" then 
		if nlc_vars.demyan_outfit_coating >= 7 then return end
		nlc_vars.demyan_outfit_coating = ( nlc_vars.demyan_outfit_coating or 0 ) + 1 
	end
end
function den_give_ammo()
	local dan_ammo = get_value( "ammo_den_buck", 0 )
	local ammo_to_give = math.min( sak_dialog.add_some_ammo_to_actor( 20, "ammo_12x70_buck", false ), dan_ammo )
	if ammo_to_give > 0 then
		dan_ammo_new = dan_ammo - ammo_to_give
		set_value( "ammo_den_buck", dan_ammo_new )
		local add_text = dan_ammo_new == 0 and "\\nУчти - это последние патроны на сегодняшний день, завтра подходи." or ""
		db.actor:give_talk_message( "Держи вот дроби в помощь дальнейшей очистке и проходи с миром..." .. add_text, "ui\\ui_iconsTotal", Frect():set(0, 0, 0, 0), "simple_answer_item" )	
		sak_dialog.add_some_ammo_to_actor( ammo_to_give, "ammo_12x70_buck" )
	else
		db.actor:give_talk_message(
			"К сожалению, в этот раз патронами не получится тебя обрадовать... \\nВсё и так тебе раздали, имей совесть, самим надо для отстрела монстрятины! Приходи в другой день, может чего и получится выделить...", "ui\\ui_iconsTotal", Frect():set(0, 0, 0, 0), "simple_answer_item"
		)	
	end
end
function den_have_buck()
	local dan_ammo = get_value( "ammo_den_buck", 0 )
    return dan_ammo > 0
end
function den_not_have_buck() return not den_have_buck() end
