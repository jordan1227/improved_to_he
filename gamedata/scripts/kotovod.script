	sak.send_tip(
		info.text, 
		info.name, 1, 15, "code", "pda_news", "sky_blue"
	)
end
function show_treasure_spot()
	local amount, money, id = 0, 0, nil
    local items = get_shadow_inv():get_content( true )
    for i, rec in items:ipairs() do
        if sak_inventory.dyn_art_base( rec.sect ) == "device_pda_npc" then
            if rec.obj:condition() == 1 then
				local ini 	= ini_file( "misc\\treasure_manager.ltx" )		
				local data 	= vergas_pda.get_pda_cdata( rec.obj:id() )	
				local info 	= vergas_lib.str_explode( "|", data, true ) 				
				local place = info[ 6 ]
				if place == 0 then return end
				
				misc.release_obj( rec.obj )
				amount = amount + 1
				
				if ini:line_exist( place, "target" ) then
					id = utils.cfg_get_number( ini, place, "target", nil, false )
					local sobj = alife():story_object( id )
					if sobj then 
						local spot = lua_random( 1, 4 )
						local name = ini:r_string( place, "name" )
						local desc = ini:r_string( place, "description" .. amk_vars.r_treas_items or 1 )
						local text = "%c[255,238,155,23]" .. game.translate_string( name ) .. "\\n" .. "%c[default]" .. game.translate_string( desc )
						level.map_add_object_spot_ser( sobj.id, "crlc_big_treasure" .. spot , text )
						sak.send_treasure( name )
					end	
				end
			end
		end
	end
	money = sak_dialog.calc_money( 3000, 15, 250 ) * amount 
	WriteIni( db.stor_ltx, "stor", "zub_payment", id .. "|" .. amount .. "|" .. money )	
	sak.relocate_item( "out", "device_pda_npc", amount )
	local hours = lua_random( 36, 65 )
	money = "%c[255, 238, 153, 26]" .. money .."%c[default]"
	db.actor:give_talk_message( 
		"Хорошо, с пда разобрались, но с тебя дополнительно - ".. money .." рублей. \\nСоветую не затягивать, а то я могу огорчиться и тогда ПДА окажется у кого-нибудь порасторопнее. Намёк понятен?", 
		"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item" 
	)	
	timers.start_timer( "empty_assisted_treasure", 0, hours, 0, "kotovod.empty_assisted_treasure()" )
	db.actor:give_info_portion( "info_zub_payment_waiting" )
end
function sidor_art_have_give( flag_to_remove )
    local itm = amk_vars.r_task_reward or 1
    local art = tbl_sidor_art[ itm ] .. tostring( "_dyn" .. amk_vars.r_treas_items .. "d" )
    for i, k in pairs( sak_inventory.rucksack ) do
		if strpos( i,  art, 1, true ) then   				
            for m = 1, #k do
                local obj = client_obj( k[ m ] )
				if flag_to_remove == false then
					if params.get_condition( obj, 0.999 ) > 0.8 then return true end
				else
					misc.release_obj( obj, true )
					sak.relocate_item( "out", art, 1 )
				end	
			end
		end
	end	   
    return false
end
function special_container( flag, name )
	if flag == "give" then 
		local obj = db.actor:object( "special_art_container" )
		if obj then 
			local pk 	= get_netpk( obj )
			local data 	= pk:get()
			nlc_vars[ "special_container_" .. name ] = data.custom_data
			sak.relocate_item( "out", obj:section(), 1 )
			misc.release_obj( obj )		
		end	
	end
	
	if flag == "add" then 
		local container = misc.spawn_to( "special_art_container", db.actor )
		if container then 
			local pk	= get_netpk( container )
			local data 	= pk:get()
			data.custom_data = nlc_vars[ "special_container_" .. name ]
			pk:set( data )
			nlc_vars[ "special_container_" .. name ] = nil
			sak.relocate_item( "in", "special_art_container", 1 )
		end		
	end
end
function start_dsc_controller_time()
	local hours_to_set		= 0
	local minutes_to_set	= 0
	local seconds_to_set	= 0
	local pt				= { game.get_game_time():get() }
	local now				= pt[ 4 ] * 3600 + pt[ 5 ] * 60 + pt[ 6 ] + pt[ 7 ] / 1000
	local seconds 			= hours_to_set * 3600 + minutes_to_set * 60 + seconds_to_set
	if now > seconds then
		seconds = ( 86400 - now ) + seconds
	else
		seconds = seconds - now
	end
	seconds = seconds / 60	
	timers.start_timer( "dsc_controller_time", 0, 0, seconds, "kotovod.spawn_dsc_controller()" )
end
function table_level_arts( table_name )
	if #table_name < 1 then return false end    
	for k in pairs( table_name ) do 
		while db.actor:has_info( table_name[ k ] ) do
			table.remove( table_name, k )
		end
	end
	return #table_name > 0
end    	
