function ammo_box( type, custom )
	if type == "create" then 
		local box = misc.spawn_to( "inventory_sakbox_01", db.actor )
		if box then 
			local pk         = get_netpk( box )
			local data       = pk:get()
			data.custom_data = custom
			pk:set( data )
			sak.relocate_item( "in", "inventory_sakbox_01", 1 )			
		end

	elseif type == "have" or type == "give" then 
		for i, k in pairs( sak_inventory.rucksack ) do
			if i == "inventory_sakbox_01" then 		
				for m = 1, #k do
					local box = client_obj( k[ m ] )
					if box then 
						local pk   = get_netpk( box )
						local data = pk:get()
						if type == "have" then 
							if data.custom_data == custom then 
								return true 
							end
						elseif type == "give" then 
							if data.custom_data == custom then
								misc.release_obj( box )
								sak.relocate_item( "out", i, 1 )
							end	
						end	
					end
				end
			end
		end
	end	
	return false	
end

function remove_freedom_grenades()
	local blokpost_nades = {}
	for id, npc in pairs( db.creatures ) do
		if client_obj( id ) then
			if 
				id ~= 0
				and npc 
				and IsStalker( npc )
				and npc:alive() 		
				and amk.get_npc_community( npc ) == "freedom"
			then 	
				local gulag = xr_gulag.get_npc_gulag( npc )
				if gulag.name == "mil_fblockpost" then 
					for _, nade_type in ipairs( { "grenade_f1", "grenade_rgd5" } ) do
						local nade = npc:object( nade_type )
						if nade then 
							misc.release_obj( nade )
							table.insert( blokpost_nades, { id = id, nade = nade_type } )
						end    
					end
				end	
			end
		end
	end	
	nlc_vars.blokpost_nades = blokpost_nades
end
function set_untradedable_items( name )
    local items = get_shadow_inv():get_content( true )
    local list = untradeable_items[ name ]
    local hidden_items = {}
    
    for i, rec in items:ipairs() do
        local obj = rec.obj
        local sect = sak_inventory.dyn_art_base( rec.sect )
        
        if list and not strposx( obj:name(), "active_rucksack" ) and list.check( sect, list.excluded_sects ) then
            params.cant_trade_add( obj:id() )
            table.insert( hidden_items, obj:id() )
        end
        
        if name == "vahtang" and strposx( obj:section(), "device_pda_npc" ) then
			local price_pda = {
				[ 1    ] = { 400, 500 },	
				[ 0.75 ] = { 323, 485 },	-- 485 около 3000 и 0.5 - 627 для около 3000
				[ 0.5  ] = { 314, 314 }	-- 418 - 2002, 314 - 1501, 209 - 1001
			}
            local cond = obj:condition()
			-- При выполнении квеста с бусами - поднимем цену пдашек
			local num = has_alife_info( "volkodav_dt_art_done" ) and 2 or 1
			obj:set_cost( price_pda[ cond ][ num ] or 0 )
		elseif name == "millitary" and strposx( obj:section(), "vodka" ) then 
			local add_cost = nlc_vars.esc_bridge_crossing or 0 
			local increment = math.floor( add_cost / 15 ) * 50
			obj:set_cost( 500 + increment )			
        end
    end
end
function additional_reward( name )
    local barter = nlc_vars.barter -- [HE-PORT] fiks pod proxy
    if not barter or not barter[ name ] then
        return
    end
	
	local tbl = {
		[ "red_forest_lesnik" ] = { amount = 10, reward = "wpn_knife_m1" }
	}
	
    local info = tbl[ name ]
    if not info then return end
	
	local current_amount = barter[ name ]	
	
	if current_amount >= info.amount then
		db.actor:give_talk_message( 
			"Кстати, у меня есть небольшой подарок, который пригодится в нашем общем деле, пользуйся:", 
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item" 
		)	
		sak.create_items( tbl[ name ].reward, 1 )
		barter[ name ] = nil
		nlc_vars.barter = barter
	end
end 
function turn_off_val_monsters()
	local table_val_monsters = {}
	for id, obj in pairs( db.creatures ) do
		if g_sim:object( id ) then
			if obj and IsMonster( obj ) and obj:alive() then 	
				table.insert( table_val_monsters, id )
				alife():set_switch_offline( id, true )
				alife():set_switch_online( id, false )
				alife():set_interactive( id, false ) 			
			end			
		end			
	end		
	nlc_vars.table_val_monsters = table_val_monsters	
end
function uncharged_accum( flag, amount )
    local items = get_shadow_inv():get_content( true )
    local real = 0
    local matching_items = {}

    for i, rec in items:ipairs() do    
        local sect = sak_inventory.dyn_art_base( rec.sect )
        if sect == "af_full_akkum" and params.get_condition( rec.obj:id(), 0.999 ) < 0.999 then            
            local item_amount = nlc_container.amount_in_batch( rec.obj )
            
            table.insert( matching_items, { obj = rec.obj, amount = item_amount } )
            real = real + item_amount

            if flag == "have" then 
                if real >= amount then return true end
            end
        end
    end

    if flag == "give" and real >= amount then
        for _, item in ipairs( matching_items ) do
            misc.release_obj( item.obj )
        end
		sak.relocate_item( "out", "af_full_akkum", real )
    end

    return false    
end

