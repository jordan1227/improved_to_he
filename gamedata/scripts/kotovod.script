--[[	
function add_junkman_items()
	local sobj 	 = g_sim:object( "hos_junkman" )
	local amount = 0		
	if sobj then
		for a, v in pairs( table_junkman_items ) do
			if lua_random( 15, 115 ) > v then 
				amount = amount + 1
				local obj = misc.spawn_to( a, sobj.id )	
				misc.process_spawn()
				if obj then
					local random = ( lua_random( 45, 60 ) / 100 )
					if a == "scientific_outfit" or a == "outfit_stalker_m2" then random = lua_random( 50, 60 ) / 100 end
					params.upd_condition( obj, random )	
					schedule.add( "unload_weapon", "sak_dialog.weapon_unload( ".. obj.id .." )", 250 )					
					if amount >= 4 then return end
				end	
			end
		end	
	end
end
]]--


