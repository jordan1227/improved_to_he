------------------------------------------------------------
------- Ищем артефакты в инвентаре ГГ, контейнер т.д -------
------------------------------------------------------------

-- "af_soul_dyn4d:75"			Душа ровно 4 дана и с кондицией выше 75%
-- "af_drops:10|3"				Капля 3 дана и выше с кондицией больше 10%
-- "af_dummy_buliz"				Любой булыжник
-- "af_dummy_simbion:20"		Симбион с кондицией выше 20%
-- "af_rusty_thorn|1"			Колючка 1-го дана и выше с любой кондицией
-- "3-af_rusty_thorn_dyn5d:15"	3 Колючки 5-го дана c кондицией 15% и выше

-- Можно использовать для удаления арта вместе с контейнером и его последующим возвращением через stored_given_arts, для этого в save пишем "_with_box"
-- Во флаге give мы это срежем, поэтому искать надо без него. Смотри пример в "saharov_mayatnik_with_box"
-- amount не удаляет элементы из таблицы при их нахождении!
-- Можно запрашивать не повторяющиеся артефакты из одной таблицы, тогда добавляем количество перед названием: "1-"

function get_containers_id()
	local actor_container_ids = {}
	for i = 0, db.actor:object_count() - 1 do
		local obj = db.actor:object( i )	
		if strpos( obj:section(), "arc_art_box_", 1, true ) then 
			table.insert( actor_container_ids, obj:id() )
		end
	end	
	return actor_container_ids
end
local temp_storage = {}

function gg_inventory_artefacts( name, flag, amount, save )
    if flag == "have" then 	
	
        local tbl = {
            [ "volk" ] = {
                "1-af_medusa_dyn1d:20", "1-af_rusty_thorn_dyn1d:20", "1-af_blood_dyn5d:50", "1-af_drops_dyn5d:50"
            },		
            [ "cart_or_capsule" ] = {
                "af_cristall", "af_electra_moonlight", "af_night_star", "af_gold_fish",
                "af_rusty_sea_urchin", "af_soul", "af_ameba_mica",
                "af_dummy_spring_capsule", "af_dummy_dummy_capsule", "af_dummy_battery_capsule",
                "af_dummy_pellicle_capsule", "af_dummy_kolobok_capsule", "af_dummy_glassbeads_capsule"				
            },	
            [ "bart" ] = {
                "af_cristal_flower:75|2", "af_gravi:75|2", "af_mincer_meat:75|2", "af_electra_flash:75|2",
                "af_fireball:75|2", "af_ameba_slug:75|2", "af_rusty_kristall:75|2",			
            },				
            [ "cart" ] = {
                "af_cristall:75|2", "af_electra_moonlight:75|2", "af_night_star:75|2", "af_gold_fish:75|2",
                "af_rusty_sea_urchin:75|2", "af_soul:75|2", "af_ameba_mica:75|2",		
            },					
            [ "dummy" ] = {
                unpack( kotovod.tbl_arts[ "lvl4" ] )			
            },	
            [ "any_dummy" ] = {
                "af_dummy_spring:80", "af_dummy_dummy:80", "af_dummy_battery:80", "af_dummy_pellicle:80", "af_dummy_glassbeads:80", "af_dummy_kolobok:80",
                "af_flower_new:80", "af_dummy_fire:90", "af_dummy_dummy_new:80",
                "af_red_dummy_spring:70", "af_red_dummy_battery:70", "af_red_dummy_pellicle:70",
                "af_battery:50", "af_sul_new:50", "af_ice:50"		
            },				
            [ "absolut" ] = {		
                unpack( kotovod.tbl_arts[ "lvl10" ] )			
            },				
            [ "capsule" ] = { 
                unpack( kotovod.tbl_arts[ "lvl14" ] )
            },			
            [ "mayatnik_capsule" ] = {
                unpack( kotovod.tbl_arts[ "lvl12" ] )		
            },			
            [ "rashpil_1" ] = { 
                "af_medusa:80|3", "af_vyvert:80|3", "af_blood:80|3", "af_electra_sparkler:80|3",
                "af_drops:70|2", "af_ameba_slime:60|2", "af_rusty_thorn:60|2"		
            },		
            [ "rashpil_2" ] = {
                "af_cristal_flower:70|3", "af_gravi:70|3", "af_mincer_meat:60|3", "af_electra_flash:60|3",
                "af_fireball:60|3", "af_ameba_slug:50|3", "af_rusty_kristall:55|3"	
            },
            [ "rashpil_3" ] = {
                "af_cristall|2", "af_electra_moonlight|2", "af_night_star|2", "af_gold_fish|2",
                "af_rusty_sea_urchin|2", "af_soul|2", "af_ameba_mica|2",
                "af_dummy_spring", "af_dummy_dummy", "af_dummy_battery",
                "af_dummy_pellicle", "af_dummy_glassbeads", "af_dummy_kolobok",
                "af_armor", "af_babka", "af_cry", "af_dik", "af_dummy_simbion",
                "af_kol", "af_pudd", "af_spirit", 
                "af_dummy_buliz", "mayatnik", "capsule",
                "af_crist_new", "af_flower_new", "af_dummy_fire", "af_battery", "af_ice", "af_sul_new",
                "af_mayatnik",			
            },
            [ "amk_art" ] = { 
				get_value( name )
            },
            [ "accum" ] = {
                "af_dummy_dummy_new"
            },
            [ "red_dummy" ] = { 
                "af_red_dummy_spring", "af_red_dummy_battery", "af_red_dummy_pellicle"
            },					
            [ "modificats" ] = {
                "af_armor_1", "af_babka_1", "af_cry_1", "af_dik_1", "af_dummy_simbion",
                "af_kol_1", "af_pudd_1", "af_spirit_1", "af_dummy_buliz",	
                "af_armor_2", "af_babka_2", "af_cry_2", "af_dik_2",
                "af_kol_2", "af_pudd_2", "af_spirit_2",	
                "af_armor_3", "af_babka_3", "af_cry_3", "af_dik_3",
                "af_kol_3", "af_pudd_3", "af_spirit_3",		
                "af_armor_4", "af_babka_4", "af_cry_4", "af_dik_4",
                "af_kol_4", "af_pudd_4", "af_spirit_4",					
            },
            [ "test" ] = {
                "3-af_rusty_thorn_dyn5d:15", "1-af_armor_3", "1-af_dummy_buliz" 
            }
        }	
        
        if not amount then
            for _, v in ipairs(tbl[name]) do
                if not v:match("^%d+%-") then
                    log2("ERROR (%s): amount is nil and no N- prefix: %s", script_name(), v)
                    return false
                end
            end
        end		
        
        local function parse_art_info( v )
            local t_max, t_art, t_con, t_dyn
            if v:match( "^%d+%-" ) then
                t_max, v = v:match( "^(%d+)-(.+)$" )
                t_max = tonumber( t_max )
            end
            t_art = v:match( "^([%a%d_]+)" )
            if not t_art then
                log2("ERROR (%s): invalid art string: %s", script_name(), tostring(v))
                return nil
            end			
            if v:match( ":" ) then
                t_con = tonumber( v:match(":(%d+)") ) or 0
                t_dyn = tonumber( v:match("|(%d+)") )
            else
                t_con = 0
                t_dyn = nil
            end
            return t_art, t_con, t_dyn, t_max
        end

        local inventory_artefacts = {}
        local container_artefacts = {}
        local copied_table  = kotovod.copy_tbl( tbl[ name ] )
        local actor_containers = get_containers_id()	
        local already_j_cont = {}		
        local already_inv_art = {}

		-- Их не обрабатываем с _capsule
		local no_capsule_names = {
			cart      = true,
			any_dummy = true,
			dummy     = true,
		}

        -- Обработка контейнеров
        for _, id in pairs( actor_containers ) do
            local box = level.object_by_id( id )
            if box then 
                local pk = get_netpk( box )
                local box_data = pk:get()
                local sect = box:section()
                local slots = get_u32( sect, "container_slots" ) or 8
                local arts = arc_radiation.decode_custom_data( box_data.custom_data, sect, slots )

                for k = #copied_table, 1, -1 do
                    local v = copied_table[ k ]
                    local t_art, t_con, t_dyn, t_max = parse_art_info( v )
                    if not t_art then return false end

                    for slot_idx, art in ipairs( arts ) do
                        if art.section and strpos( art.section, t_art, 1, true ) then
                            local c_dyn = tonumber( string.sub( art.section, -2, -2 ) )
                            local cond_ok = art.condition >= t_con / 100
                            local dyn_ok = not t_dyn or ( c_dyn and c_dyn >= t_dyn )
                            local not_capsule = not no_capsule_names[ name ] or not strpos( art.section, "_capsule", 1, true )
                            local not_used = ( not amount or not already_j_cont[ id ] or not already_j_cont[ id ][ slot_idx ] )
                            local not_six = ( c_dyn ~= 6 )

                            if cond_ok and dyn_ok and not_capsule and not_used and not_six then
                                already_j_cont[ id ] = already_j_cont[ id ] or {}
                                already_j_cont[ id ][ slot_idx ] = true

                                table.insert( container_artefacts, { 
                                    id   = id, 
                                    slot = slot_idx, 
                                    art  = art.section, 
                                    cond = art.condition, 
                                    cust = art.custom_data,
                                    size = slots 
                                })

                                if t_max then
                                    t_max = t_max - 1
                                    if t_max <= 0 then
                                        table.remove( copied_table, k )
                                        break
                                    else
                                        copied_table[ k ] = string.format( "%d-%s:%d", t_max, t_art, t_con )
                                        if t_dyn then
                                            copied_table[ k ] = copied_table[ k ] .. "|" .. t_dyn
                                        end
                                    end
                                else
                                    if amount and #container_artefacts >= amount then
                                        break
                                    end
                                end
                            end
                        end
                    end
                    
                    if ( amount and #container_artefacts >= amount and not t_max ) or #copied_table == 0 then 
                        break
                    end
                end
            end
        end	
        
        -- Поиск в инвентаре
        if #copied_table ~= 0 or ( amount and #container_artefacts < amount ) then 
            for k = #copied_table, 1, -1 do				
                local v = copied_table[ k ]
                local art, con, dyn, max = parse_art_info( v )

                local items = get_shadow_inv():get_content( true ) 
                for i, rec in items:ipairs() do	
                    local sect = rec.obj:section()
                    local cond = rec.obj:condition()
                    local dyn_have = tonumber( string.sub( sect, -2, -2 ) )

                    if 
                        strpos( sect, art, 1, true ) 
						and ( not no_capsule_names[ name ] or not strpos( sect, "_capsule", 1, true ) )
                        and ( not dyn or ( dyn_have and dyn_have >= dyn ) ) 
                        and cond >= con / 100 
                        and not ( amount and already_inv_art[ rec.obj:id() ] )
                        and dyn_have ~= 6					
                    then
                        table.insert( inventory_artefacts, { id = rec.obj:id(), art = sect, cond = cond } )
            
                        if not amount or max then	
                            already_inv_art[ rec.obj:id() ] = true 
                            if max then
                                max = max - 1
                                if max == 0 then 
                                    table.remove( copied_table, k )
                                    break
                                end	
                            end
                        end															
                    end	
                    
                    if ( amount and ( #inventory_artefacts + #container_artefacts ) == amount ) or #copied_table == 0 then
                        break
                    end	
                end
            end			
        end
        
        temp_storage[ name ] = {
            inventory_artefacts = inventory_artefacts,
            container_artefacts = container_artefacts
        }
        
        return #copied_table == 0 or ( amount and ( #container_artefacts + #inventory_artefacts ) >= amount )


	elseif flag == "give" then
		local stored_given_arts = get_value( "stored_given_arts", {} )
		local added_cont_ids = {}
		local saved_data = temp_storage[ name ] or {}
		local inventory_artefacts = saved_data.inventory_artefacts or {}
		local container_artefacts = saved_data.container_artefacts or {}
		
		local with_box = save and save:match( "with_box" )
		local used_slots = {}
		
		if #container_artefacts >= 1 then
			for _, vv in ipairs( container_artefacts ) do
				if ui_arc_container_menu.put_out_art( vv.id, vv.slot, vv.art, vv.cond ) then
					log2( "Передан артефакт %s из контейнера %d, слот %d", vv.art, vv.id, vv.slot )
				end		
				sak.send_tip(
					get_inv_name( vv.art ),
					"Передали из контейнера [" .. vv.id .. "]:",
					0, 7, "con_" .. vv.size .. "_out", "no", "red"
				)				
				if save then
					local new_save = save:gsub( "_with_box", "" )
					stored_given_arts[ new_save ] = stored_given_arts[ new_save ] or {}
					table.insert( stored_given_arts[ new_save ], { art = vv.art, cond = vv.cond } )
					
					if vv.id and not added_cont_ids[ vv.id ] then
						added_cont_ids[ vv.id ] = true
						if with_box then
							table.insert( stored_given_arts[ new_save ], { container = "arc_art_box_" .. vv.size .. "basic" } )
						end
					end
				end
				
				used_slots[ vv.id ] = used_slots[ vv.id ] or {}
				used_slots[ vv.id ][ vv.slot ] = true
			end
		end
		
		if with_box then
			local actor_containers = get_containers_id()
			for _, id in pairs( actor_containers ) do
				local box = level.object_by_id( id )
				if box then
					local pk = get_netpk( box )
					local box_data = pk:get()
					local sect = box:section()
					local slots = get_u32( sect, "container_slots" ) or 8
					local arts = arc_radiation.decode_custom_data( box_data.custom_data, sect, slots )
					
					for slot_idx, art in ipairs( arts ) do
						if art.section and not ( used_slots[ id ] and used_slots[ id ][ slot_idx ] ) then
							kotovod.add_bad_item( art.section, art.condition )
							log2( "Возвращён неподошедший арт %s из контейнера %d, слот %d", art.section, id, slot_idx )
						end
					end
				end
			end
		end
		
		if #inventory_artefacts >= 1 then
			for _, v in ipairs( inventory_artefacts ) do 
				local obj = client_obj( v.id )
				if obj then 
					misc.release_obj( obj )
					sak.relocate_item( "out", v.art, 1 )
				
					if save then
						if save:match( "with_box" ) then
							save = save:gsub( "_with_box", "" )
						end				
						stored_given_arts[ save ] = stored_given_arts[ save ] or {}
						table.insert( stored_given_arts[ save ], { art = v.art, cond = v.cond } )
					end						
				end
			end
		end
		set_value( "stored_given_arts", stored_given_arts )
		temp_storage[ name ] = nil
	end
end

function parse_container_data( data )
	local result = {}

	-- разбиваем строку на подстроки по запятой и пробелу
	local substrings = {}
	for substring in string.gmatch( data, "[^,%s]+" ) do
		table.insert( substrings, substring )
	end

	-- распарсиваем каждую подстроку и записываем в таблицу
	for i, substring in ipairs( substrings ) do
		if substring ~= "_" then
			-- находим разделитель между артикулом и значением cond
			local delimiter = string.find( substring, ":" )
			if delimiter then
				local art = string.sub( substring, 1, delimiter - 1 )
				local cond = tonumber( string.sub( substring, delimiter + 1 ) )
				table.insert( result, { art = art, cond = cond } )
			end
		end
	end
	return result
end


