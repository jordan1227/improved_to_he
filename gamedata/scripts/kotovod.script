--[[
Строка передаётся как есть без кавычек — kotovod.give_something(name) kotovod.give_something(fake_green_blood)
function give_something( id )
    local info = "info_" .. id
    if not has_alife_info( info ) then
        db.actor:give_info_portion( info )
    end
    return game.translate_string( "text_" .. id )
end

--------------------- Лучше так, как актор тейк выйдет
elseif string.sub( txt_msg, 1, 8 ) == "kotovod." then
    local call = string.sub( txt_msg, 9 )
    local func, arg = string.match( call, "^([^%(]+)%((.-)%)$" )
    if not func then func = call end
    if type( kotovod[func] ) == "function" then
        local text = (arg and arg ~= "") and kotovod[func]( arg ) or kotovod[func]()
        if text then
            self.kotovod_texts = self.kotovod_texts or {}
            self.kotovod_texts[ txt_msg ] = text
            self:set_wnd_sms_direct( text )
        elseif self.kotovod_texts and self.kotovod_texts[ txt_msg ] then
            self:set_wnd_sms_direct( self.kotovod_texts[ txt_msg ] )
        end
    end

local pda_tbl = {}

pda_tbl[ "fake_green_blood" ] = function()
    local text
    if not has_alife_info( "info_fake_green_blood" ) then
        db.actor:give_info_portion( "info_fake_green_blood" )
        this.bes_after_resque()
        text = game.translate_string( "text_fake_green_blood" )
    end
    return text
end
	
function pda_event( id )
    if pda_tbl[ id ] then
        return pda_tbl[ id ]()
    end
end	
]]--







