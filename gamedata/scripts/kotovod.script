--[[
function notify_show_mode()
    local min = nlc_vars.notify_min or 30
    local check = nlc_vars.notify_check_interval or 25
    local cache = nlc_vars.notify_cache or 0
    
    local freq_colour
    if min >= 80 then
        freq_colour = "%c[255,255,100,100]"
    elseif min >= 50 then
        freq_colour = "%c[255,255,180,100]"
    elseif min >= 30 then
        freq_colour = "%c[255,255,220,100]"
    else
        freq_colour = "%c[255,100,255,100]"
    end

    local freq_desc
    if min >= 80 then
        freq_desc = freq_colour .. "очень редко, раз в несколько часов%c[default]"
    elseif min >= 50 then
        freq_desc = freq_colour .. "редко, примерно раз в час и больше%c[default]"
    elseif min >= 30 then
        freq_desc = freq_colour .. "умеренно, раз в полчаса или час%c[default]"
    else
        freq_desc = freq_colour .. "часто, каждые 15-30 минут%c[default]"
    end
    
    local scan_colour
    if check >= 30 then
        scan_colour = "%c[255,255,100,100]"
    elseif check >= 20 then
        scan_colour = "%c[255,255,220,100]"
    else
        scan_colour = "%c[255,100,255,100]"
    end

    local scan_desc
    if check >= 30 then
        scan_desc = "    • Антенна проверяет сеть раз в " .. scan_colour .. check .. " минут%c[default], свежий заказ может прийти с задержкой"
    elseif check >= 20 then
        scan_desc = "    • Антенна проверяет сеть раз в " .. scan_colour .. check .. " минут%c[default]"
    else
        scan_desc = "    • Антенна проверяет сеть раз в " .. scan_colour .. check .. " минут%c[default], заказы приходят быстро"
    end
    
    local cache_colour
    if cache >= 75 then
        cache_colour = "%c[255,255,100,100]"
    elseif cache >= 50 then
        cache_colour = "%c[255,255,180,100]"
    elseif cache > 0 then
        cache_colour = "%c[255,255,220,100]"
    else
        cache_colour = "%c[255,100,255,100]"
    end

    local cache_desc
    if cache >= 75 then
        cache_desc = "    • Кэш почти полный (" .. cache_colour .. cache .. "%%c[default]), скоро начнёт тормозить"
    elseif cache >= 50 then
        cache_desc = "    • Кэш заполнен на " .. cache_colour .. cache .. "%%c[default]"
    elseif cache > 0 then
        cache_desc = "    • Кэш в норме (" .. cache_colour .. cache .. "%%c[default])"
    else
        cache_desc = "    • Кэш чистый (" .. cache_colour .. "0%%c[default])"
    end
    
    db.actor:give_talk_message(
        string.format( "    • Уведомления: %s.\\n%s.\\n%s.", freq_desc, scan_desc, cache_desc ),
        "ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item"
    )
end
]]--




