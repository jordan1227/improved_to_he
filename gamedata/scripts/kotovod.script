function money_have( amount )
    return db.actor:money() >= amount
end

function relocate_money( num, type )
	if db.actor == nil then return end
	if type == "in" then
		db.actor:give_money( num )
	elseif type == "out" then
		db.actor:give_money( -num )
    end
	this.show_relocated_money( type, num )
end


function show_relocated_money( type, amount )
	local actor = db.actor
	if actor == nil then return end 
	
	local tbl = {
		[ "in"	] = { colour = "%c[255,105,239,146]", whom = "general_in_money"		},
		[ "out"	] = { colour = "%c[255,255,085,085]", whom = "general_out_money"	},
		[ "sah"	] = { colour = "%c[255,20,120,215]",  whom = "general_in_saharov"	},
		[ "pah"	] = { colour = "%c[255,20,120,215]",  whom = "general_in_pahom"		}
	}
	if not tbl[ type ] then return end
	
	local pos = { 800, 0, 100, 100 }	
	
	local icons = {
		{    0,  1000,  	400 },
		{ 1000,  5000, 	 	500 },
		{ 5000,  10000, 	600 },
		{ 10000, 20000, 	700 },
		{ 20000, 40000, 	800 },
		{ 40000, math.huge, 900 }
	}	
	
	local function get_icon_position( amount )
		for _, v in ipairs( icons ) do
			if amount >= v[ 1 ] and amount < v[ 2 ] then
				return { pos[1], v[3], pos[3], pos[4]}
			end
		end
		return { pos[ 1 ], icons[ #icons ][ 3 ], pos[ 3 ], pos[ 4 ] }
	end
	
	local transfer = tbl[ type ]
    local is_talking = actor:is_talking()
    -- local tab = ( is_talking and game_options.IconsDialogue ) and " " or "\\n"	
	local tab = "\\n"

	local news_text = transfer.colour .. game.translate_string( transfer.whom ) .. tab .. "%c[default]" .. game.translate_string( tonumber( amount ) .. " рублей" )
	local task_texture, task_rect = get_texture_info( "ui_iconsTotal_found_money" )

--[[
	if game_options.IconsDialogue then
		local icon_group = "ui\\ui_icon_equipment_3"
		local icon_pos = get_icon_position( amount )
    
		if is_talking then
			actor:give_talk_message( news_text, icon_group, Frect():set( unpack( icon_pos ) ), "ico_item_2_2" )
		else
			actor:give_game_news( news_text, task_texture, task_rect, 0, 3000 )
		end
	else
		if is_talking then 
			actor:give_talk_message( news_text, task_texture, task_rect, "iconed_answer_item" )	
		else
			actor:give_game_news( news_text, task_texture, task_rect, 0, 3000 )
		end			
	end	
]]--

		if is_talking then 
			actor:give_talk_message( news_text, task_texture, task_rect, "iconed_answer_item" )	
		else
			actor:give_game_news( news_text, task_texture, task_rect, 0, 3000 )
		end	
end


function respawn_addons( obj )
	if not obj then return end

	local weapon = obj:get_weapon()
	if not weapon then return end

	local tbl_addons = {
		{ name = "scope_name", fun = ogse_wpn_utils.get_scope_flag },
		{ name = "silencer_name", fun = ogse_wpn_utils.get_silencer_flag },
		{ name = "grenade_launcher_name", fun = ogse_wpn_utils.get_grenade_launcher_flag }
	}

	for _, addon in ipairs( tbl_addons ) do
		if addon.fun( obj ) then
			local name = weapon[ addon.name ]
			if name and name ~= "" then
				sak.create_items( name, 1 )
			end
		end
	end  

	-- Получение типов патронов и их количества
	local idx_ammo, idx_gl_ammo, cnt_ammo, cnt_gl_ammo

	if obj:get_gl_mode() then
		idx_ammo = obj:get_underbarrel_ammo_type()
		idx_gl_ammo = obj:get_ammo_type()
		cnt_ammo = obj:get_ammo_in_magazine2()
		cnt_gl_ammo = obj:get_ammo_in_magazine()
	else
		idx_ammo = obj:get_ammo_type()
		idx_gl_ammo = obj:get_underbarrel_ammo_type()
		cnt_ammo = obj:get_ammo_in_magazine()
		cnt_gl_ammo = obj:get_ammo_in_magazine2()
	end        

	local function get_ammo_sect_from_idx( sect, idx, class )
		local ammo_str = sak_dialog.read_string_if_exist( system_ini(), sect, class )
		if ammo_str then
			local ammo_t = vergas_lib.str_explode( ",", ammo_str, true )
			return ammo_t[ idx + 1 ]
		end
	end

	-- Функция для спавна патронов
	local function spawn_ammo( ammo_count, ammo_type, class_name )
		if ammo_count > 0 then 
			local ammo_section = get_ammo_sect_from_idx( obj:section(), ammo_type, class_name )
			if ammo_section then 
				vergas_lib.spawn_ammo_in_inv( ammo_section, ammo_count, db.actor )
				sak.relocate_item( "in", ammo_section, ammo_count, true )	
			end
		end
	end

	spawn_ammo( cnt_ammo, idx_ammo, "ammo_class" )
	spawn_ammo( cnt_gl_ammo, idx_gl_ammo, "grenade_class" )
end

function attach()
    local wpn = db.actor:active_item()
    if not wpn then return end
    
    local wm = wpn:get_weapon_m()
    if not wm then return end
    
    local obj = db.actor:object("wpn_addon_1pso")
    if obj then
        local ascope = obj:get_inventory_item()
        wm:attach_addon(ascope, true)
        log2("attaching %s to %s", obj:name(), wpn:name())
    else
        log2("addon wpn_addon_1pso not found in inventory")
    end
end

function dettach()
    local wpn = db.actor:active_item()
    if not wpn then return end
    
    local wm = wpn:get_weapon_m()
    if not wm then return end
    
    wm:detach_addon( "wpn_addon_1pso", true)
end

-----------------------------------------------------------
----------------- Вспомогательные функции -----------------
-----------------------------------------------------------

function get_nlc( name )
	local value = get_value( name )
	if value == nil then
		value = "nil"
	elseif type( value ) == "boolean" then
		value = "" .. tostring( value )
	elseif type( value ) == "userdata" then
		value = "userdata - не могу прочитать"
	elseif type( value ) == "number" or type( value ) == "string" then
		value = value
	elseif type( value ) == "table" then
		log3( "ogse_var: %s: - \n%s", name, value )
		value = "Информация добавлена в консоль и лог, для быстрого поиска: vars_dumped_table"
	else
		value = "Неизвестный тип: " .. type( value )
	end
	sak.send_tip(
		value, name, 0, 12, "g_g", "no", "green"
	)
end

