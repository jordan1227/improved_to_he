	if not has_alife_info( "oksana_go_to_kordon" ) then return end
	local obj = g_sim:object( "mar_oksana" )
	if not obj then return end
	-- misc.spawn_by_name( "mar_xod_outbaze" )	
	local obj_pos = obj.position
