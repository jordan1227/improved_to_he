function random_npc_request( num, flag_to_remove )
    local ind = amk_vars.r_treas_items or 1
    local tbl = {
		-- Сидорович и компоненты для рецепта 		-- tm_monster_part5_dialog
        {
            { "mutant_face_tushkano", 6 },
            { "mutant_dog_tail", 5 },
			{ "mutant_zombie_hand", 3 }
        },
		-- Толик и компоненты для рецепта 			-- artmod_111_dialog	
        {
            { "mutant_flesh_eye", 1 },
            { "mutant_psevdodog_tail", 1 },
			{ "mutant_boar_leg", 3 }
        },
		-- Лис и аптечки/антирады					-- artmod_161_dialog
        {
            { "antirad", 5 },
            { "medkit_army", 4 },
			{ "medkit", 10 }
        },
		-- Прапор первый квест после агропрома		-- artmod_311_dialog
        {
            { "mutant_tail_cat", 3 },
            { "mutant_flesh_eye", 4 }, 
			{ "mutant_snork_leg", 3 }
        },	
		-- Прапор последний квест					-- artmod_712_dialog
        {
            { "mutant_psevdogigant_hand", 1 },
            { "mutant_poltergeist_glas", 1 }, 
			{ "mutant_hand_kontroler", 1 }
        },
		-- Назар, информация для Сидора				-- tm_kill_stalker_dlg_107
        {
            { "ammo_12x70_buck", 60 },
            { "ammo_12x76_dart", 30 }, 
			{ "ammo_12x76_zhekan", 20 }
        }			
	}
	local item 	 = tbl[ num ][ ind ][ 1 ]
	local amount = tbl[ num ][ ind ][ 2 ]
	
	if flag_to_remove == false then
		if str_in_tab( item, { "ammo_", "energy_drink", "medkit", "antirad" } ) then
			return vergas_lib.search_items( item, amount, 1 )
		else
			return sak.have_items_count( item, amount ) ~= false
		end	
	end	
	
	if flag_to_remove == true then
		if str_in_tab( item, { "ammo_", "energy_drink", "medkit", "antirad" } ) then
			vergas_lib.search_items( item, amount, 2 )	
		else	
			sak_inventory.release_actor_items( item, amount )
		end	
	end	
end	
