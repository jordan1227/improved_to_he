function add_random_art_cond( lvl, dyn, rand1, rand2 )
	local sect = kotovod.rnd_rec_art_info( kotovod.tbl_arts, lvl, dyn )
	local rand = dsh.get_next_random( "add_random_art_cond",  rand1, rand2 ) / 100
	kotovod.add_bad_item( sect, rand )
end
function already_have_ruck( name )
	return nlc_vars[ name .. "_rucksack" ] == nil
end
function anagramm_docent_dialog( flag )
	if flag == "update" then 
		nlc_vars.angm_doc_dlg = pack_time_to_string( game.get_game_time() )
		return
		
	elseif flag == "available" then 
		if nlc_vars.angm_doc_dlg == nil then
			return true
		end

		local last_time = unpack_time_from_string( nlc_vars.angm_doc_dlg )
		local current_time = game.get_game_time()
    
		local time_diff_sec = current_time:diffSec( last_time )
		local time_diff_hours = math.floor( math.abs( time_diff_sec / 3600 ) )
    
		if time_diff_hours >= 24 then
			return true
		end
    
		return false
	end	
end
function arny_barter_subscribe()
	if not arny_signal then
		arny_signal = {
			{ signal = "on_group_items", fun = this.ungroup_ammo 	 		},				
		--	{ signal = "on_trade", 		 fun = this.arny_barter_unsubscribe },	-- Иногда возникает ошибка при попадании в инвентарь			
			{ signal = "on_trade", 		 fun = this.arny_trade_process 		},			
			{ signal = "on_trade_hide",	 fun = this.arny_barter_unsubscribe },		
		}
		local sm = ogse_signals.get_mgr()
		for _, s in ipairs( arny_signal ) do
			sm:subscribe( s )			
		end
	end
end
function arny_barter_unsubscribe()
	if arny_signal then
		local sm = ogse_signals.get_mgr()
		for _, s in ipairs( arny_signal ) do
			sm:unsubscribe( s )	
		end
		arny_signal = nil
	end
	if #arny_table < 1 then return end
	for k, v in pairs( arny_table ) do
		local item = client_obj( v )
		if item then 
			set_item_default_grouping( item )
		end	
	end
	arny_table = {}
end
function arny_trade_process()
	misc.process_spawn()
end

function add_art_to_vars( id )
    if id ~= nil then
        local lname = level.name()
        local tbl   = get_value( "tbl_bio_art", {} )
        if tbl[ lname ] == nil then tbl[ lname ] = {} end
        table.insert( tbl[ lname ], id )
		set_value( "tbl_bio_art", tbl )
    end 
end

function art_is_bio_art( id )
    local lname = level.name()
    local tbl   = get_value( "tbl_bio_art", {} )
    if tbl ~= nil then
        for k, v in pairs( tbl ) do
            if k == lname then
                for i = 1, #v do
                    if id == v[ i ] then 
                        v[ i ] = -1
                        set_value( "tbl_bio_art", tbl )
                        return true
                    end
                end
            end
        end
    end
    return false
end
function change_time_min( num )
    local gt = game.get_game_time()
    local y, m, d, hh, mm, ss, ms = gt:get()
    gt:updHMS( hh, mm + num, ss )
    game.set_game_time( gt )
end
function check_any_recipes( ... )
	for _, table_name in ipairs( { ... } ) do
		if table_level_arts( table_name ) then
			return true
		end
	end
	return false
end
function check_info_table( tbl, flag )
    if not tbl then return false end

    if flag == "have_all" then
        local amount = 0
        for _, v in pairs( tbl ) do
            if has_alife_info( v ) then
                amount = amount + 1
            end
        end
        return amount == #tbl
		
    elseif flag == "have_any" then 
		for _, v in pairs( tbl ) do
            if has_alife_info( v ) then 
                return true
            end
        end
        return false
		
	elseif flag == "have_not" then
		for _, v in pairs( tbl ) do
            if not has_alife_info( v ) then 
                return true
            end
        end		
		return false
    end
end
function collect_pda_info()
	local semenov = level_object_by_sid( 905 )
	if not semenov then return end
	
	local amount = 0
	for i = 0, semenov:object_count() - 1 do
		local item = semenov:object( i )
		-- Без округления иногда теряет ПДА
		if item and item:section() == "device_pda_npc" and params.get_condition( item, 0.999 ) >= 0.99 then
			amount = amount + 1	
		end	
	end	
	return amount
end
