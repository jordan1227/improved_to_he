function have_shustryi_art()
    local ind  = amk_vars.r_treas_items + amk_vars.r_task_reward - 1
    if ind > 7 or ind < 1 then ind = 7 end
    shustr_art_sect = kotovod.tbl_arts.lvl1[ ind ]
    if sak.have_items_count( shustr_art_sect, 1 ) then return true end
    return false
end
function rnd_item( tbl )
    if #tbl < 1 then return end
	local t_len  = #tbl   
	local rand = dsh.get_next_random( "kotovod.rnd_item", t_len )
	t_len = t_len == 1 and #tbl - 1 or t_len - 1	
	local sect = tbl[ rand ][ 1 ]	
	local amnt = dsh.get_next_random( "kotovod.rnd_item_amount", tbl[ rand ][ 2 ], tbl[ rand ][ 3 ] )	
	return sect, amnt, rand	
end	
function add_random_item( lvl, amount ) 
	local level = "lvl" .. tostring( lvl )
	if amount == nil then amount = 2 end
	-- TODO: ЧТО ЗА ХУЙНЯ С ЭТИМ?
	--local diff = tonumber( level.get_game_difficulty() )
	--if diff == 0 then amount = amount + 1 end
	for a = 1, amount do 
		local section, count, random = rnd_item( tbl_rnd_items[ level ] )
		sak.create_items( section, count )		
		table.remove( tbl_rnd_items[ level ], random )		
	end	
end
function newbie_reward() 
	local random = dsh.get_next_random( "kotovod.newbie_reward", #unique_starter_items )
	sak.create_items( unique_starter_items[ random ], 1 )	  	   
end
function copy_tbl( obj )
    if type( obj ) ~= 'table' then return obj end
    local res = {}
    for k, v in pairs( obj ) do res[ copy_tbl( k ) ] = copy_tbl( v ) end
    return res
end
function rashpil_items( flag )
    local ind = amk_vars.r_treas_items or 1
	local tbl = {
        {
            { "wpn_val"					 },
			{ "wpn_sig550" 				 },
			{ "wpn_wincheaster1300" 	 }	
        },	
        {
            { "ammo_9x39_ap", 		 90, 	"девяносто бронебойных патронов к нему"  		},
			{ "ammo_5.56x45_ap", 	120, 	"сто двадцать бронебойных натовских патронов" 	},
            { "ammo_12x76_dart", 	 50, 	"пятьдесят патронов картечи"					}		
        }	
	}	
	local item = tbl[ 1 ][ ind ][ 1 ]
	local type = tbl[ 2 ][ ind ][ 1 ]
	local amnt = tbl[ 2 ][ ind ][ 2 ]
	local text = tbl[ 2 ][ ind ][ 3 ]
	
	if flag == "show" then
		local weap_text = game.translate_string( system_ini():r_string( item, "inv_name" ) )
		local ammo_text = game.translate_string( system_ini():r_string( type, "inv_name" ) )
		db.actor:give_talk_message(
			"%c[255,216,186,140]" .. game.translate_string( 
				"Слышал про " .. weap_text .. "?" .. "\\n" .. 
				"Братки Боровские говорили, что это очень крутая и полезная шняга, хотелось бы заиметь такую же, новенькую..." .. "\\n" ..
				"А чтобы совсем всё у нас на мази было, докинь " .. text .. "\\n" ..
				"Ну чё, давай краба?" 
			),
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item"
		) 
		if db.actor:object( "klava" ) ~= nil then
			local req_txt = game.translate_string( 
				"Рашпиль просит принести ему:\\n" .. weap_text .." и "..  text
			)		
			vergas_lib.add_record_in_klava( "custom", req_txt, "Запрос Рашпиля" )		
		end			
	end	

	if flag == "have_without_condition" then
		return sak.have_items_count( item, 1 ) and vergas_lib.search_items( type, amnt, 1 ) 
	end	
	
	if flag == "have_with_condition" then
		return kotovod.have_with_cond( item, 1, 0.95 ) and vergas_lib.search_items( type, amnt, 1 ) 
	end	
	
	if flag == "give_with_condition" then
		kotovod.have_with_cond( item, 1, 0.95, false, true )
		vergas_lib.search_items( type, amnt, 2 )			
	end	
end
function have_rashpil_items_no_cond()
	return rashpil_items( "have_without_condition" )
end	
