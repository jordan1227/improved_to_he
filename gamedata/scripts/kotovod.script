	--shadow_inv:get_hide_ids()
end

function dirt()
	-- костюм не надет, возврат
	local armor = db.actor:item_in_slot( 6 )
	if not armor then return end
	
	-- костюм без маски, возврат		
	local armor_custom = vergas_masks.set_get_armor_custom( 2 )
	if 
			not armor_custom 
		or armor_custom == "none|none|none" 
	then 
		return 
	end 
	
	-- маска снята, возврат
	if vergas_masks.get_flag_mask() == false then 
        misc.easy_sound( "scripts\\actor_gripp" )
        level.add_pp_effector( "black_cats.ppe", 1039, false )
        params.health_add( -0.12 )	
		return 
	end
	
	local t = vergas_lib.str_explode( "|", armor_custom, true )
	local number_dirt_phase = tonumber( t[ 2 ] )
	number_dirt_phase = number_dirt_phase + lua_random( 2 )
	if number_dirt_phase > 6 then
		number_dirt_phase = 6
	end
	armor_custom = t[ 1 ] .. "|" .. tostring( number_dirt_phase ) .. "|0"
	vergas_masks.set_get_armor_custom( 1, armor_custom )
end

function upgrade( slot, cond, mask )
	local actor = db.actor	
    local item  = actor:item_in_slot( slot )	
	local sect 	= item:section()
	if sect then 
		params.upd_condition( item, cond )	
		if slot == 6 then 
			local outfit = db.actor:get_current_outfit()
			if outfit and mask then
				vergas_masks.set_mask_condition( outfit:id(), cond, true)
			end		
		end
	end	
end

function ct( min )
	local ms = min * 60 * 1000
	level.advance_game_time( ms )
end

