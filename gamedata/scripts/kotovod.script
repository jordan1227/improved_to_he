-- выдаем/дисаблим поршни в игре. Без пробелов! Пример: flush !kotovod.give_info("tesla_gift_info")

function give_info( info )
    db.actor:give_info_portion( info )	
    sak.send_tip(
		"Выдан поршень: ".. info .."", nil, 1, 7, "g_g", "no", "green" 
	)	
end

function disable_info( info )
	db.actor:disable_info_portion( info )
    sak.send_tip(
		"Поршень отключен: ".. info .."", nil, 1, 7, "g_g", "no", "red" 
	)		
end	

function has_info( info )
	if db.actor:has_info( info ) then
		sak.send_tip(
			"ПОРШЕНЬ ПРИСУТСВУЕТ: ".. info .."", nil, 1, 7, "g_g", "no", "green" 
		)	
	else
		sak.send_tip(
			"ПОРШЕНЬ ОТСУТСТВУЕТ: ".. info .."", nil, 1, 7, "g_g", "no", "red" 
		)		
	end	
end	

function check_info_table( tbl, flag )
    if not tbl then return false end

    if flag == "have_all" then
        local amount = 0
        for _, v in pairs( tbl ) do
            if has_alife_info( v ) then
                amount = amount + 1
            end
        end
        return amount == #tbl
		
    elseif flag == "have_any" then 
		for _, v in pairs( tbl ) do
            if has_alife_info( v ) then 
                return true
            end
        end
        return false
		
	elseif flag == "have_not" then
		for _, v in pairs( tbl ) do
            if not has_alife_info( v ) then 
                return true
            end
        end		
		return false
    end
end




