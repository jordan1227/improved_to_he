function gg_good_table_items_have_give( tbl, need_amount, dyn_flag, dyn, condition, flag_remove, capsule )
    local amnt = tonumber( need_amount )
	local num  = 0
    local diff = tonumber( level.get_game_difficulty() )
    local cond = ( diff == 0 ) and 0.01 or tonumber( condition )	
    for a = 1, #tbl do
        for i, k in pairs( sak_inventory.rucksack ) do
		    if dyn_flag == false then
				if capsule == true then
					if strpos( i,  tbl[ a ], 1, true ) and not strpos( i, "_capsule", 1, true ) then   				
						for m = 1, #k do
							local obj = client_obj( k[ m ] )
							if obj:condition() >= cond then
								num = num + 1
								if flag_remove == true then
									misc.release_obj( obj, true )
									sak.relocate_item( "out", tbl[ a ], 1 )
									amnt = amnt - 1								
									if amnt == 0 then return end
								end	
							end
						end
					end
				else
					if strpos( i,  tbl[ a ], 1, true ) then   				
						for m = 1, #k do
							local obj = client_obj( k[ m ] )
							if obj:condition() >= cond then
								num = num + 1
								if flag_remove == true then
									misc.release_obj( obj, true )
									sak.relocate_item( "out", tbl[ a ], 1 )
									amnt = amnt - 1								
									if amnt == 0 then return end
								end	
							end
						end
					end
				end	
			elseif dyn_flag == true then
			    if 
					strpos( i,  tbl[ a ], 1, true ) 
					and not strpos( i, "_dyn6d", 1, true )
					and ( tonumber( string.sub( i, -2, -2 ) ) >= dyn )			
           	    then 			
                    for m = 1, #k do
                        local obj = client_obj( k[ m ] )					
                        if obj:condition() >= cond then
				  	        num = num + 1
					   	    if flag_remove == true then
								misc.release_obj( obj, true )
								sak.relocate_item( "out", tbl[ a ], 1 )
								amnt = amnt - 1
								if amnt == 0 then return end
						    end	
					  	end
			        end	
                end					  								
            end
	    end
    end	   
    if num >= amnt and flag_remove == false then return true end
end
