function gg_identic_arts(tbl, amount, flag, table_to_add)
    local section, dyn
    local ii = 1
    
    if flag == "have" or flag == "give" then
        for a = 1, #tbl do
            for i, k in pairs(sak_inventory.rucksack) do
                -- Проверяем только артефакты (начинающиеся с "af_")
                if strpos(i, "af_", 1, true) then
                    -- Базовые проверки на соответствие артефакта
                    local exact_match = (i == tbl[a])  -- Точное совпадение
                    local partial_match = strpos(i, tbl[a], 1, true)  -- Частичное совпадение
                    local matches_artifact = exact_match or (partial_match and partial_match > 0)
                    local has_enough = #k >= amount  -- Достаточное количество
                    
                    -- Определяем, является ли артефакт динамическим (имеет _dyn в названии)
                    local is_dyn = strpos(i, "_dyn", -6, true)
                    
                    -- Новая логика проверки валидности артефакта
                    local valid_art = false
                    local is_degenerate = false
                    if is_dyn then
                        -- Для динамических артефактов
                        local dyn_level = tonumber(string.sub(i, -2, -2))
                        -- Артефакт валиден если это обычный (1-5 дан) или вырожденный (6 дан)
                        valid_art = dyn_level and (dyn_level < 5 or dyn_level == 6)
                        -- Отмечаем вырожденные артефакты (6 дан)
                        is_degenerate = dyn_level and dyn_level == 6
                    else
                        -- Для обычных артефактов всегда valid_art = true
                        valid_art = true
                    end
                    
                    log2("gg_identic_arts: проверка артефакта [%s]: exact_match=[%s], partial_match=[%s], is_dyn=[%s], matches=[%s], has_enough=[%s], valid_art=[%s], is_degenerate=[%s]", 
                        i, tostring(exact_match), tostring(partial_match), tostring(is_dyn), tostring(matches_artifact), 
                        tostring(has_enough), tostring(valid_art), tostring(is_degenerate))
                    
                    if matches_artifact and has_enough and valid_art then
                        if flag == "have" then
                            return true
                        end
                        
                        if flag == "give" then
                            temp_conditions = {}
                            
                            if not is_dyn and table_to_add then
                                -- Для обычных артефактов: выбираем случайный из доступных
                                identic_art = table_to_add[dsh.get_next_random("kotovod.gg_identic_item_have_give", 1, #table_to_add)]
                                log2("gg_identic_arts: выбран обычный артефакт для обмена: [%s]", identic_art)
                            else
                                -- Для динамических артефактов
                                section = tostring(tbl[a])
                                if is_degenerate then
                                    -- Если отдаём вырожденный артефакт (6 дан), получаем артефакт 1 дана
                                    dyn = 1
                                else
                                    local current_dyn = tonumber(string.sub(i, -2, -2))
                                    -- Обычная прогрессия для артефактов 1-5 дан
                                    dyn = current_dyn + 1
                                    -- Не даём подняться выше 5 дана
                                    if dyn > 5 then dyn = 5 end
                                end
                                identic_art = section .. "_dyn" .. dyn .. "d"
                                log2("gg_identic_arts: выбран динамический артефакт для обмена: [%s] (из вырожденного: %s)", identic_art, tostring(is_degenerate))
                            end
                            
                            -- Обработка выбранных артефактов
                            local processed = 0
                            for m = 1, #k do
                                if processed < amount then
                                    local obj = client_obj(k[m])
                                    if obj then
                                        -- Сохраняем состояние артефакта
                                        temp_conditions[ii] = obj:condition()
                                        misc.release_obj(obj, true)
                                        sak.relocate_item("out", i, 1)
                                        ii = ii + 1
                                        processed = processed + 1
                                    end
                                end
                            end
                            return
                        end
                    end
                end
            end
        end
        log2("gg_identic_arts: не найдены подходящие артефакты")
    end
    
    if flag == "add" and identic_art ~= "" then
        misc.dump_table(temp_conditions)
        log2("gg_identic_arts:")
        -- Расчёт среднего состояния артефактов
        local total_condition = 0
        local count = 0
        for _, condition in pairs(temp_conditions) do
            total_condition = total_condition + condition
            count = count + 1
        end
        
        -- Разные случайные факторы для разных типов артефактов
        local is_regular = not strpos(identic_art, "_dyn", 1, true)
        local random_factor = is_regular and lua_random(3, 8) or lua_random(5, 12)
        local b = (random_factor / 100) * ((math.random() > 0.5) and 1 or -1)
        local cond = (total_condition / count) + b
        
        -- Ограничение состояния артефакта
        if cond <= 0.3 then cond = 0.3 end
        if cond > 1.0 then cond = 1.0 end
        
        log2("gg_identic_arts: параметры нового артефакта - состояние: [%s], случайный фактор: [%s]", cond, random_factor)
        
        -- Создание нового артефакта
        local item = misc.spawn_to(identic_art, db.actor)
        misc.process_spawn()
        params.upd_condition(item, cond)
        sak.relocate_item("in", identic_art, 1)
        
        -- Очистка временных данных
        temp_conditions = {}
        identic_art = ""
    end
end
function get_level_from_gv( num )
    local name = "???"
    for k, v in pairs( const.game_vertices ) do
        if num >= v[ 1 ] and num <= v[ 2 ] then
            name = k
            break
        end
    end
    return name
end
function have_with_cond( sect, need_amount, condition, flag_loaded, flag_to_release )
    local have_tbl, num = {}, 0
    local amnt  = tonumber( need_amount )
    local items = get_shadow_inv():get_content( true )
    for i, rec in items:ipairs() do
        if sak_inventory.dyn_art_base( rec.sect ) == sect then
			local dif = tonumber( level.get_game_difficulty() )
			if dif == 0 then condition = condition / 2 end			
            if rec.obj:condition() >= tonumber( condition ) then				
                if flag_loaded then
                    local def_mag = system_ini():r_float( rec.sect, "ammo_mag_size" ) or 1
                    if rec.obj:get_ammo_in_magazine() == def_mag then
                        if num < amnt then
                            table.insert( have_tbl, rec.id )
                            num = num + 1
                        end
                    end
                else
                    if num < amnt then
                        table.insert( have_tbl, rec.id )
                        num = num + 1
                    end     
                end
            end
        end
    end
    if #have_tbl >= amnt then
        have_with_cond_tbl = have_tbl
        if not flag_to_release then return true
        else
            for _, v in ipairs( have_tbl ) do
                local obj1 = g_sim:object( v )
                if obj1 then g_sim:release( obj1, true ) end
            end
            sak.relocate_item( "out", sect, #have_tbl )
            have_with_cond_tbl = {}
        end
    end
    return false
end
function isGamblingAvailable( name )
    local loses, wins = 0, 0
    local treshold    = 0.45
    local day         = timers.Get_Game_Days() or 1
    if day < 5 then treshold = 0.7 end
    local tbl    = xray_vars.load_table( nlc_vars, "tbl_gambling", {} )
    misc.dump_table( tbl )
    local chance = dsh.get_fixed_random( "kotovod.isGamblingAvailable." .. name, day, 1, 100 ) / 100
    if tbl[ name ] ~= nil then
        wins  = tbl[ name ].wins
        loses = tbl[ name ].loses
    end
    treshold = treshold + ( loses / ( wins + 1 ) )
    wprintf(
        "@-------------     NPC: %s  |  GAMES: %s  |  WINS: %s  |  LOSES: %s  |  CHANSE: %s  |  TRESHOLD: %s",
        name, ( wins + loses ), wins, loses, chance, treshold
    )
    if
        chance <= treshold		
    then
        return true
    end
    return false
end
function noGamblingAvailable( name )
    return not isGamblingAvailable( name )
end
function gambling_tbl_add_points( name, n_wins, n_loses )
    local tbl = xray_vars.load_table( nlc_vars, "tbl_gambling", {} )
    if tbl ~= nil then misc.dump_table( tbl ) end
    if tbl[ name ] == nil then tbl[ name ] = { wins = 0, loses = 0 } end
    tbl[ name ].wins  = tbl[ name ].wins  + n_wins
    tbl[ name ].loses = tbl[ name ].loses + n_loses
    misc.dump_table( tbl )
    nlc_vars.tbl_gambling = tbl
end
function specific_art( flag )
    local ini = system_ini()
	local stats_list = {
		{ "fire_wound_immunity", 			"замедляющий скорость полета пули"					},
		{ "wound_immunity", 				"уменьшающий чувствительность кожи к разрыву"		},
		{ "telepatic_immunity", 			"улучшающий восприимчивость к телепатии" 			},
		{ "radiation_immunity", 			"снижающий уровень радиации в организме" 			},
		{ "strike_immunity", 				"абсорбирующий ударные волны" 						},
		{ "shock_immunity", 				"уменьшающий подверженность организма электрошоку" 	},
		{ "explosion_immunity", 			"защищающий от взрывных волн" 						},
		{ "chemical_burn_immunity", 		"отторгающий едкие химические компоненты."		 	}		
	}
	local rand = nlc_vars.saharov_opening_capsule or 1
	local stat = stats_list[ rand ][ 1 ]
	local desc = stats_list[ rand ][ 2 ]	

	if flag == "show" then 
		db.actor:give_talk_message(
			"Так что прошу и нам оказать помощь. На сегодняшний день сгодится любой артефакт ".. desc ..". Если принесёте такой - вскроем вашу капсулу.",
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item"
		)	
	end
		
	if flag ~= "show" then 	
		for a = 1, #spawner.table_arts_dynamic do
			for i, k in pairs( sak_inventory.rucksack ) do
				if strpos( i, spawner.table_arts_dynamic[ a ] ) and not strpos( i, "_capsule", 1, true ) then
					local count = #k
					for m = 1, count do
						local obj = client_obj( k[ m ] )
						--if obj:condition() >= 0.75 then				
							if ini:section_exist( obj:section() ) then
								local art_stat = ini:r_float( obj:section() .. tostring( "_absorbation" ), stat )	
								if flag == "have" and art_stat <= 0.95 then 
									return true	
								end	
								if flag == "give" and art_stat <= 0.95 then
									misc.release_obj( obj )
									sak.relocate_item( "out", spawner.table_arts_dynamic[ a ], 1 )
									return
								end	
							end	
                        --end
                    end
                end
            end
        end
    end
end
