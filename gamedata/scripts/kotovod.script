function set_untrade_af_flag()
	local condition = 0.5
	if 
		   has_alife_info( "info_dolg_bad_reputation" ) and level.name() == "l05_bar" 
		or has_alife_info( "info_freedom_bad_reputation" ) and level.name() == "l07_military"
	then 
		condition = 0.7 
	end
	for i, k in pairs( sak_inventory.rucksack ) do
		if strpos( i,  "^af_" ) then   				
			for m = 1, #k do
				local obj = client_obj( k[ m ] )
				if obj:condition() <= condition then
					params.cant_trade_add( obj:id() )
					table.insert( trade_arts, obj:id() )
				end
			end
		end
	end	
end
