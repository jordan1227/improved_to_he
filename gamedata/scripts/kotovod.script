function add_bad_item( sect, cond, hide )
    local obj = misc.spawn_to( sect, db.actor )
    misc.process_spawn()
    if obj then
		local obj_id = level.object_by_id( obj.id )
		if obj_id and obj_id:is_weapon() then 
			schedule.add( "unload_weapon", "sak_dialog.weapon_unload( ".. obj.id .." )", 250 )	
		end	
        params.upd_condition( obj.id, cond )
		if not hide then 
			sak.relocate_item( "in", sect, 1 )
		end
    end
end
function update_item_condition( sect, cond )
	local pk = get_netpk( sect )
	local data = pk:get()
	data.condition = cond
	pk:set( data )
end
function have_selected_item( section, count ) 
	local items = get_shadow_inv():get_content( true ) 
	local real = 0
	for i, rec in items:ipairs() do	
		local sect = sak_inventory.dyn_art_base( rec.sect )
		if sect == section then			
			local amount =  nlc_container.amount_in_batch( rec.obj )
			real = real + amount  
			if real >= count then return true end
		end
	end		
	return false
end
function release_selected_item( section, count )  
	local items = get_shadow_inv():get_content( true ) 
	local real = 0
	for i, rec in items:ipairs() do
		local sect = sak_inventory.dyn_art_base( rec.sect )
		if sect == section then			
			local amount =  nlc_container.amount_in_batch( rec.obj )
			misc.release_obj( rec.id, "kotovod.release_selected_item" )
			real = real + amount  
			if real >= count then break end
		end
	end
	if real > 0 then
		sak.relocate_item( "out", section, real, true )   
		sak_inventory.need_update_inventory()
	end  
	return ( real == count )
end
function get_lc_data( obj )
	local packet = net_packet()
	obj:STATE_Write(packet)
	local size = packet:w_tell()
	packet:r_seek( 0 )
	local t = {}
	t.game_vertex_id = packet:r_u16()
	t.distance = packet:r_float()
	t.direct_control = packet:r_s32()
	t.level_vertex_id = packet:r_s32()
	t.object_flags = packet:r_s32()
	t.custom_data = packet:r_stringZ()
	t.story_id = packet:r_s32()
	t.spawn_story_id = packet:r_s32()
	local shape_count = packet:r_u8()
	t.shapes = {}

	for i = 1, shape_count do
		local shape_type = packet:r_u8()
		t.shapes = {}
		t.shapes.shtype = shape_type

		if shape_type == 0 then
			t.shapes.center = packet:r_vec3()
			t.shapes.radius = packet:r_float()
		else
			t.shapes.v1 = packet:r_vec3()
			t.shapes.v2 = packet:r_vec3()
			t.shapes.v3 = packet:r_vec3()
			t.shapes.offset = packet:r_vec3()
		end
	end
	t.restrictor_type = packet:r_u8()
	t.dest_game_vertex_id = packet:r_u16()
	t.dest_level_vertex_id = packet:r_s32()
	t.dest_position = packet:r_vec3()
	t.dest_direction = packet:r_vec3()
	t.dest_level_name = packet:r_stringZ()
	t.dest_graph_point = packet:r_stringZ()
	t.silent_mode = packet:r_u8()
	if packet:r_elapsed() ~= 0 then
		log2( "abort get_lc_data" )
	end
	return t
end
function declension( num, a1, a2, a3 )
	return ( num%10 == 1 and num%100 ~= 11 ) and a1 or ( num%10 >= 2 and num%10 <= 4 and ( num%100 < 10 or num%100 >= 20 ) and a2 or a3 )
end
