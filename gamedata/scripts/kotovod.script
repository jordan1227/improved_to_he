function move_bugged_garik()
	local sobj = g_sim:object( "bar_garik" )
	if sobj then 
		local pos = sobj.m_level_vertex_id
		if pos ~= 35765 then
			g_sim:teleport_object( sobj.id, 1236, 35765, sak.v3f( 128.13557434082, -4.82401657104492, 25.2285690307617 ) )		
		end	
	end
end

