function add_rnd_art_to_actor( lvl, dyn )
    local sect = ""
    local test_lvl = tonumber( lvl )
    if dyn ~= nil then
        sect = rnd_rec_art_info( tbl_arts, test_lvl, dyn )
    else
        sect = rnd_rec_art_info( tbl_arts, test_lvl )
    end
    sak.create_items( sect, 1 )
    return sect
end
function rnd_rec_art_info( tbl, lvl, dyn )
    local tbl1 = tbl[ ( "lvl" .. tostring( lvl ) ) ]
    local info = tbl1[ dsh.get_next_random( "kotovod.rec_art_info", 1, #tbl1 ) ] or ""
    if strposx( info, "af_" ) then
        if lvl <= 3 or lvl == 5 then
            if dyn == nil then
                info = info .. "_dyn" .. tostring( dsh.get_next_random( "kotovod.rec_art_info", 1, 4 ) ) .. "d"  -- без зелени
            else
                info = info .. "_dyn" .. dyn .. "d"
            end
        end
    end
    return info
end
function add_random_unknown_art()
	local item = mike.table_arts_unknown[ dsh.get_next_random( "table_random", 1, #mike.table_arts_unknown ) ][ dsh.get_next_random( "table_position", 1, 3 ) ]	
	local sobj = misc.spawn_to( item, db.actor )
	misc.process_spawn()
	if sobj then
		local ini  = system_ini()	
		local inv_weight = sak_dialog.read_if_exist( ini, item, "inv_weight", nil )		
		local condition = inv_weight / dsh.get_next_random( "generic_rnd", 7, 12 )
		if condition < 0.45 then condition = 0.45 end		
		local obj = level.object_by_id( sobj.id )	
		if obj then	
			params.upd_condition( obj:id(), condition )
		end	
		sak.relocate_item( "in", item, 1 )				
	end	
end
