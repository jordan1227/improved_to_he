function gg_any_dart( type )
    for a = 1, #sak_dialog.table_dart do 
        for i, k in pairs( sak_inventory.rucksack ) do	
			if strpos( i, sak_dialog.table_dart[ a ], 1, true ) then 
				for m = 1, #k do
					local obj = client_obj( k[ m ] )					
					if obj:condition() >= 0.5 then
						if type == "have" then
							return true
						elseif type == "give" then
							local npc = sleep_manager.get_target_obj()		
							if npc ~= nil then 
								db.actor:transfer_item( obj, npc )
							else
								misc.release_obj( obj )
							end	
							sak.relocate_item( "out", obj:section(), 1 )
							return
						end
					end
				end
			end
		end
	end
end
