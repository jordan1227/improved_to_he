	if not has_alife_info( "info_docent_incoming_broken_talked" ) then return end
	db.actor:give_talk_message(
		"Или тащи свой ПДА и два арта второго уровня. Предложение в силе.",
		"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item"
	)
end
function docent_anagramm_flash( flag )
	if flag == "have" then 
		for i, k in pairs( sak_inventory.rucksack ) do
			if i == "anagramm_flash" then                     
				local obj = client_obj( k[ 1 ] )
				if obj:condition() == 0 then
					flash_id = obj:id()                    
					return true
				end
			end
		end
	elseif flag == "update" then
		local flash = level.object_by_id( flash_id )
		if flash then 
			nlc_vars.stored_docent_flash = xray_vars.load_table( nlc_vars, "stored_docent_flash", {} )
			nlc_vars.stored_docent_flash[ flash_id ] = ( nlc_vars.stored_docent_flash[ flash_id ] or 0 ) + 1 
			local amount = nlc_vars.stored_docent_flash[ flash_id ]
            
			local new_cond = condition_loss[ math.min( amount, 5 ) ]	-- 5 циклов перезаписи, с каждым разом меньше и меньше
			local text, where
            
			if new_cond == 1 then
				misc.release_obj( flash_id )
				nlc_vars.stored_docent_flash[ flash_id ] = nil	
				local ucp = rawget( _G, "ui_cheat_pda" )
				if ucp and ucp.removeFlashData then ucp.removeFlashData( flash_id ) end
				text = "К сожалению эту флэшку уже не восстановить, слишком большой цикл перезаписей. Теперь только новую покупать."
				where = "out"
			else
				flash:set_condition( 1 - new_cond )
				local ucp = rawget( _G, "ui_cheat_pda" )
				if ucp and ucp.UpdateFlashData then ucp.UpdateFlashData( flash_id, ( 1 - new_cond ) ) end
				text = string.format( "Получилось, но с небольшим нюансом, флэшка потеряла: %.0f%% объема. С каждым циклом это значение будет возрастать.", new_cond * 100 )
				where = "in"
			end

			db.actor:give_talk_message(
				text, 
				"ui\\ui_iconsTotal", Frect():set(0, 0, 0, 0), "simple_answer_item" 
			)         		
			sak.relocate_item( where, "anagramm_flash", 1 )

			--sak.send_tip( new_cond, "цикл: " .. nlc_vars.stored_docent_flash[ flash_id ], 0, 5, "g_g", "sak", "yellow" )
			-- test( flash_id )
			flash_id = nil
        end    
    end    
end
function docent_broken_pda( flag )
	if flag == "have" then 
		for i, k in pairs( sak_inventory.eatable ) do	
			if strpos( i, "device_pda_npc", 1, true ) then 
				for m = 1, #k do
					local pda = alife():object( k[ m ] )
					if pda then 
						local pk = get_netpk( pda, 1 )
						if not pk then return false end
						local data = pk:get()
						local info = vergas_lib.str_explode( "|", data.custom_data, true )
						if not info or not info[4] then return false end
						local serial = info[ 4 ]
						local broken_serial = nlc_vars.pda_docent
						if serial == broken_serial then 
							broken_docent_pda = pda.id
							return true 
						end	
					end
				end
			end
		end		
		return false
	end
	
	if flag == "give" then 
		if not broken_docent_pda then return end
		local obj = client_obj( broken_docent_pda )
		if not obj then return end
		misc.release_obj( obj )
		nlc_vars.pda_docent = nil
		broken_docent_pda = nil
		sak.relocate_item( "out", obj:section(), 1 )
	end
end
function docent_contracts_not_ready()
    return not docent_contracts_ready()
end
function docent_contracts_ready()
    local minutes = nlc_vars.docent_contracts_timer_minutes or 720
    return sak_dialog.is_ready_time( "docent_contracts_timer", minutes )
end
function docent_contracts_start( broken_pda )
    local target_hour = 18
    local pt          = { game.get_game_time():get() }
    local now         = pt[4] * 3600 + pt[5] * 60 + pt[6]
    local target      = target_hour * 3600
    local seconds     = ( 86400 - now ) + target
    local minutes     = math.floor( seconds / 60 )
	
	if broken_pda then 
        -- послезавтра к вечеру — добавляем ещё сутки, если пдашку отдали и 2 арта
        minutes = minutes + 1440
    end
	
    -- сохраняем минуты ожидания чтобы передать в is_ready_time
    nlc_vars.docent_contracts_timer_minutes = minutes
    sak_dialog.start_time( "docent_contracts_timer" )
end
function docent_contracts_time_left()
    local gtime = timers.Get_Game_Minutes()
    local start = sak_dialog.dialog_timer_value( "docent_contracts_timer", 0 )
    local minutes = nlc_vars.docent_contracts_timer_minutes or 720
    local left = minutes - ( gtime - start )
    
    if left <= 0 then return end
    
    local diff = left / 60
    local when = ""

    if diff < 1 then
        when = "В течении часа подваливай."
    elseif diff < 3 then
        when = "Часа через два-три закончу."
    elseif diff < 6 then
        when = "Часов пять-шесть уйдёт, не меньше."
    elseif diff < 9 then
        when = "Часов семь-восемь ещё понадобится."
    elseif diff < 12 then
        when = "К вечеру будет готово."
	elseif diff < 24 then
		when = "Завтра к вечеру управлюсь, не раньше."
	else
		when = "Послезавтра к вечеру. Работа тонкая, не торопи."
	end

    db.actor:give_talk_message(
        "%c[255,216,186,140]" .. when,
        "ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item"
    )
end
function dolgovazyi_accum( flag )
	if flag == "start" then 
		if not nlc_vars.dolgovazyi_accums then 
			nlc_vars.dolgovazyi_accums = 5 
		end	
	end	
	
	if flag == "have" then 
		return nlc_vars.dolgovazyi_accums >= 1
	end
	
	if flag == "have_not" then 
		return not dolgovazyi_accum( "have" )
	end
	
	if flag == "add" then 
		nlc_vars.dolgovazyi_accums = ( nlc_vars.dolgovazyi_accums or 0 ) + 1 
	end
	
	if flag == "remove" then 
		nlc_vars.dolgovazyi_accums = ( nlc_vars.dolgovazyi_accums or 0 ) - 1
	end
end
function dolgovazyi_exo_charge( flag )
	local act_outfit = db.actor:get_current_outfit()
	if act_outfit == nil then return false end
	if not strpos( act_outfit:section(), "exo", 1, true ) then return false end
	--if flag == "have" and ( gg_any_aart_have() or gg_any_bart_have() or gg_any_cart_have() ) then return true end
	if flag == "have" then return true end
	if flag == "give" then sak_dialog.give_upgrade_outfit( "bar" ) end
end
