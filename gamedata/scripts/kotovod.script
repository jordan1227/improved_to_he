function gar_dv_lc( type )
	if type == "remove" then 
		misc.release_by_name( "gar_exit_to_darkvalley_117" )
	
		local shape = { shtype = 0, radius = 3.0, center = { 0, 2.0, 0 } }	
		local anomaly = amk_anoms.spawn_anomaly( "amk_zone_greedy_strong", sak.v3f( 253.01, -5.01, -106.57 ), 405, 369615, shape, "on" ) 	
		nlc_vars.gar_dv_anomaly = anomaly.id	
	
	elseif type == "spawn" then
		local obj = g_sim:object( nlc_vars.gar_dv_anomaly )
		if obj then 
			misc.release_obj( obj )
			nlc_vars.gar_dv_anomaly = nil
		end
		local obj = g_sim:object( "gar_exit_to_darkvalley_117" )
		if obj then return end		
		misc.release_by_name( "gar_exit_to_darkvalley_117" )	-- на всякий
		local lc = misc.spawn_by_name( "gar_exit_to_darkvalley_117" )
		if lc then 
			level.map_add_object_spot_ser( lc.id, "level_changer_self", "to_darkvalley" )	
		end
	end	
end
function gar_oreh_yurik_timer()	
	timers.start_timer( "gar_oreh_yurik_timer", 0, 5, 0, "kotovod.gar_oreh_yurik_timer_end()" )	
	db.actor:give_info_portion( "gar_dm_bandits_yurik_timer" )

	local lname = level.name()
	local new_lv, pos = const.random_level_point( lname )
	if ( new_lv == nil ) then return end
	local new_gv = const.best_game_vertex( pos, lname )
	local sect = kotovod.rnd_rec_art_info( kotovod.tbl_arts, 1 )
	local obj = amk.spawn_item( sect, pos, new_gv, new_lv )
	if obj then 
		vergas_art.add_in_tbl( obj ) 
	end	
end	
