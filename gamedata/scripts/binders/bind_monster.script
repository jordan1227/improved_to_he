end

-- [HE-PORT]
function panic_item_drop( coeff )
    local actor  = db.actor
    local sleep_k = 0
    local sleep_curr = sleep_manager.get_sleepiness()
    if     sleep_curr > 190 then sleep_k = 0.05
    elseif sleep_curr > 140 then sleep_k = 0.02
    elseif sleep_curr <= 70 then sleep_k = -0.05
    end
    if coeff == nil then coeff = 0.05 end
    local active_slot = actor:active_slot()
    local slot_k = 1
    if active_slot == 1 or active_slot == 4 then
        slot_k = 0.7
    end
    local drop = ( coeff + sleep_k + ( 0.03 * game_difficulty ) ) * dog_shield * slot_k
    local armor = actor:item_in_slot( 6 )
    if armor and string.find( armor:section(), "exo", 1, true ) then
        drop = drop * 0.7
    end
    -- Future Monolith-outfit hook (deliberately inactive):
    -- if actor_in_monolith_outfit() then drop = drop * 0.5 end
    if lua_random() < drop then
        local active_item = actor:active_item()
        if active_item and active_item:section() ~= "bolt" and active_item:get_slot() ~= 7 then
            actor:drop_item( active_item )
			diagnostic_log( "panic_drop", 250, "psy drop item=%s chance=%.3f dog_shield=%.3f", active_item:section(), drop, dog_shield )
            return true
        end
    end
    return false
end

-- Deliberately exposed but not wired into active mutant behavior yet.
function actor_in_monolith_outfit()
	local armor = db.actor and db.actor:item_in_slot( 6 )
	return armor ~= nil and string.find( armor:section(), "monolit", 1, true ) ~= nil
end

function burer_mask_item_drop()
	local actor = db.actor
	if not actor then return false end
	local sleep_k = 0
	local sleep_curr = sleep_manager.get_sleepiness()
	if sleep_curr > 180 then
		sleep_k = 0.05
	elseif sleep_curr > 120 then
		sleep_k = 0.02
	elseif sleep_curr <= 70 then
		sleep_k = -0.05
	end
	local active_slot = actor:active_slot()
	local slot_k = ( active_slot == 1 or active_slot == 4 ) and 0.7 or 1
	local drop = ( 0.42 + sleep_k + ( 0.03 * game_difficulty ) ) * dog_shield * slot_k
	local armor = actor:item_in_slot( 6 )
	if armor and string.find( armor:section(), "exo", 1, true ) then
		drop = drop * 0.7
	end
	if lua_random() >= drop then return false end

	add_dirt_outfit()
	local active_item = actor:active_item()
	if not active_item or active_item:section() == "bolt" then return false end
	local item_id = active_item:id()
	local section = active_item:section()
	actor:drop_item( active_item )
	local no_unload = section == "wpn_knife"
		or string.find( section, "_toz", 1, true )
		or string.find( section, "wpn_spas", 1, true )
		or string.find( section, "wpn_bm16", 1, true )
		or string.find( section, "wpn_winchester", 1, true )
		or string.find( section, "wpn_mp153", 1, true )
	if not no_unload and lua_random( 1, 60 ) < 20 then
		schedule.add( "unload_weapon", "sak_dialog.weapon_unload(" .. item_id .. ")", 250 )
	end
	return true
end

function add_dirt_outfit()
	local armor = db.actor and db.actor:item_in_slot( 6 )
	if not armor then return end
	local armor_custom = vergas_masks.set_get_armor_custom( 2 )
	if not armor_custom or armor_custom == "none|none|none" then return end
	if vergas_masks.get_flag_mask() == false then
		diagnostic_log( "burer_mask", 250, "burer mask effect mode=mask_off health=-0.12" )
		misc.easy_sound( "scripts\\actor_gripp" )
		level.add_pp_effector( "black_cats.ppe", 1039, false )
		params.health_add( -0.12 )
		return
	end
	local custom = vergas_lib.str_explode( "|", armor_custom, true )
	local dirt_phase = tonumber( custom[ 2 ] ) or 0
	local previous_dirt_phase = dirt_phase
	dirt_phase = math.min( dirt_phase + lua_random( 2 ), 6 )
	armor_custom = custom[ 1 ] .. "|" .. tostring( dirt_phase ) .. "|0"
	vergas_masks.set_get_armor_custom( 1, armor_custom )
	diagnostic_log( "burer_mask", 250, "burer mask dirt phase=%d->%d", previous_dirt_phase, dirt_phase )
end

local weap_class_tbl = {}
function check_weapon_class(sec)
	if weap_class_tbl[sec] == nil then
		weap_class_tbl[sec] = vergas_lib.set_pr_from_config_str(sec,"weapon_class")
	end
	return weap_class_tbl[sec]
end
