local hold_keys        = {}
local accepted_keys    = {}
local key_press_time   = {}
local long_press_fired = {}
local last_action_time = {}
local ACTION_COOLDOWN  = 200

-- [HE-PORT]
hud_fx_busy = false

local function is_input_blocked()
	return level.main_input_receiver() ~= nil
		or device():is_paused()
		or db.actor:ph_capture()
		or hud_fx_busy
end

function actor_binder:on_cell_item_focus(obj)
	self.am:call("on_cell_item_focus", obj)
end

function actor_binder:on_cell_item_focus_lost(obj)
	self.am:call("on_cell_item_focus_lost", obj)
end

function actor_binder:on_cell_item_mouse( obj, x, y, action )
	if hold_keys[DIK_keys.DIK_U] then
		if self.last_manual_ungroup_id ~= obj:id() then
			local success = ui_inv_descr.try_manual_ungroup( obj )
			if success then
				self.last_manual_ungroup_id = obj:id()
			end
		end
	else
		self.last_manual_ungroup_id = nil
	end
	self.am:call("on_cell_item_mouse", obj, x, y, action )
end

function actor_binder:on_wheel_rotation(vol)
	self.am:call("on_wheel_rotation", vol)
end

function actor_binder:on_key(key, bind)
	hold_keys[key] = true
	--
	if key == DIK_keys.DIK_NUMPAD0 and is_debug_mode then
		cmd("demo_record 1")
	end

	--
	if key == DIK_keys.DIK_ADD or key == DIK_keys.DIK_MULTIPLY then he_info_giver.open() end
	--
	local tbl = key_actions[bind]
	if tbl and not is_input_blocked() then
		local now = time_global()
		if not (last_action_time[key] and now - last_action_time[key] < ACTION_COOLDOWN) then
			accepted_keys[key]    = bind
			key_press_time[key]   = now
			long_press_fired[key] = false

			if not tbl.long_press and not tbl.on_hold_start then
				if tbl.func then
					last_action_time[key] = now
					tbl.func()
				end
			end
		end
	end
	--
	self.am:call("on_key", key, bind)
end

function actor_binder:on_key_hold(key, bind)
	local accepted_bind = accepted_keys[key]
	local tbl = accepted_bind and key_actions[accepted_bind]
	if tbl and not long_press_fired[key] and not is_input_blocked() then
		local t = key_press_time[key]
		if t then
			local elapsed = time_global() - t

			if tbl.on_hold_start and elapsed >= 150 then
				long_press_fired[key] = true
				tbl.on_hold_start()
			elseif tbl.long_press and elapsed >= (tbl.long_press_timer or 500) then
				long_press_fired[key] = true
				if not tbl.no_cooldown then
					last_action_time[key] = time_global()
				end
				tbl.long_press()
			end
		end
	end

	self.am:call("on_key_hold", key, bind)
end

function actor_binder:on_key_free(key, bind)
	hold_keys[key] = nil

	local accepted_bind = accepted_keys[key]
	local tbl = accepted_bind and key_actions[accepted_bind]
	local fired = long_press_fired[key]

	accepted_keys[key] = nil

	if tbl and tbl.on_hold_end and fired then
		tbl.on_hold_end()
	elseif tbl and tbl.long_press and not tbl.on_hold_start and not fired and tbl.func and not is_input_blocked() then
		last_action_time[key] = time_global()
		tbl.func()
	end

	key_press_time[key]   = nil
	long_press_fired[key] = nil

	self.am:call("on_key_up", key, bind)
end

function actor_binder:level_changer_action( obj, wnd )
  local sobj = obj:get_alife_object()
  local lc   = sobj:get_level_changer()
  local dest_vertex = lc.dest_game_vertex_id
  local dest_lname  = alife():level_name(
    game_graph():vertex( dest_vertex ):level_id()
  )
  log2( "dest_lname is %s", dest_lname )
  local msg_text_wnd = wnd:FindChild( "message_box_change_level:message_text" )
   log2( "msg_text_wnd is %s", msg_text_wnd ) 
  msg_text_wnd:GetCUIStatic():SetText(
    game.translate_string( dest_lname ) .. ": "
    .. game.translate_string( "level_changer_invitation" )
  )
  self.am:call( "level_changer_action", obj, wnd )
end

function actor_binder:item_to_belt(obj)
	local sobj = g_sim:object(obj:id())
	if sobj then
		self.am:call("on_item_to_belt", obj, sobj)
	end
end

local cur_outfit_id
function actor_binder:item_to_backpack(obj)
	local sobj = g_sim:object(obj:id())
	if sobj then
		-- такое бывает, когда спавним в инвентарь предмет, а потом его тут же
		-- удаляем ещё до выхода в онлайн
		self.am:call("on_item_to_ruck", obj, sobj)
	end
end

function actor_binder:item_to_slot(obj)
	local sobj = g_sim:object(obj:id())
	if sobj then
		self.am:call("on_item_to_slot", obj, sobj)
	end
end

function actor_binder:take_item_from_box(box, item)
	--wprintf(" actor_binder:take_item_from_box, item = %s ", DumpVar(item))
	amk_offline_alife.take_item_from_box(box, item)
	
	gps_habar.on_item_take_from_box(box, item)
	
	-- Стори айди для ПДАшек и отметки в юи, что нашли
	local story_id = box:story_id()
	if story_id == nil then
		return
	end	
	
	treasure_manager.take_item_from_box(box, story_id)	
end

