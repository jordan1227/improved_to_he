function level_change_list()
	local list = get_value("lc_history",{})
	local lname = level.name()
	local count = 1
	local last  = #list
	if (last == 0) or (lname ~= list[last]) then
		if last > 0 then
			log2("#DBG: level change detected from %s to %s", list[last], lname)
		end
		table.insert(list, lname)
		set_value("lc_history",list)
	end
end

