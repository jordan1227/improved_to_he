-- ************************************************
-- **										Imp										**
-- **			Биндер самодельных телепортов				**
-- ** Поддерживает работу самопальных телепортов **
-- ************************************************

local teleport_binders ={}

function abs_comp(a,b)
	if (a < b) then
		return(b - a)
	else
		return(a - b)
	end
end

function teleportate(x,y,z)
	local a = vector()
	a.x = x
	a.y = y
	a.z = z
	db.actor:set_actor_position(a)
	sak.eff_vodka()
	local snd_obj = xr_sound.get_safe_sound_object([[anomaly\teleport_work_1]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)

end


function actor_update()
	local i,v,acter_poz,s
	acter_poz = db.actor:position() this.exit_hint_update(acter_poz) -- sivol: exit hint
	for i, v in pairs(teleport_binders) do
		s = v.parametrs
		local obj = client_obj(i)
		if obj~=nil then
			if s.teleporte~=nil and s.teleporte~=false then
				if (time_global() <= s.time) then
					teleportate(s.poz_x,s.poz_y,s.poz_z)
					if s.rotate~=nil then
						db.actor:set_actor_direction(s.rotate)
					end
					s.teleporte = false
				end
				return
			end
			if (abs_comp(s.x, acter_poz.x)< v.parametrs.radius	and
					abs_comp(s.z, acter_poz.z)< v.parametrs.radius	and
					abs_comp(s.y, acter_poz.y)< v.parametrs.z_radius) then
					local tname = obj:name()
					if strposx(tname,"labirint") then
						if sak.arts_operate and sak_inventory.belt_items["af_battery"] then
							arc_arts.discharge_art_on_belt("af_battery", 0.001)
							return
						end
					end
				s.teleporte = true this.exit_turn(s) -- sivol
				s.time = time_global() + 1000
				level.add_pp_effector("teleport.ppe", 50, false)
			end
		end
	end
end

function bind(obj)
	obj:bind_object(restrictor_teleport(obj)) 
end

class "restrictor_teleport"(object_binder)

function restrictor_teleport:__init(obj, char_ini) super(obj)
end

function restrictor_teleport:net_spawn(data)
	local char_ini = system_ini()
	if self.teleport==true then
		teleport_binders[self.object:id()] = self
		self["parametrs"] = {}
		if char_ini:line_exist(self.section, "radius") then
			self.parametrs["radius"] = tonumber(char_ini:r_string(self.section, "radius"))
		else
			self.parametrs["radius"] = 5
		end
		if char_ini:line_exist(self.section, "z_radius") then
			self.parametrs["z_radius"] = tonumber(char_ini:r_string(self.section, "z_radius"))
		else
			self.parametrs["z_radius"] = self.parametrs["radius"]
		end

		local s_obj = alife():object(self.object:id())
		self.parametrs["x"] = tonumber(s_obj.position.x);
		self.parametrs["y"] = tonumber(s_obj.position.y);
		self.parametrs["z"] = tonumber(s_obj.position.z);

		local rand=(self.object:id() % 4) + 1 -- sivol: fixed for the life of the object, a reload does not change the exit (was lua_random(1,4))
		self.parametrs["poz_x"] = tonumber(char_ini:r_string(self.section, "poz_x"..rand))
		self.parametrs["poz_y"] = tonumber(char_ini:r_string(self.section, "poz_y"..rand))
		self.parametrs["poz_z"] = tonumber(char_ini:r_string(self.section, "poz_z"..rand))

		if char_ini:line_exist(self.section, "rotate") then
			self.parametrs["rotate"] = tonumber(char_ini:r_string(self.section, "rotate"))
		end
	end
	return true
end

function restrictor_teleport:net_destroy()
	teleport_binders[self.object:id()] = nil
	self.parametrs = nil
	object_binder.net_destroy(self)
end

function restrictor_teleport:reload(section)
	local char_ini = system_ini()

	self.section = section
	if char_ini~=nil and char_ini:line_exist(self.section, "teleport") then
		self["teleport"] = true
	end
end




-- ************************************************
-- sivol: exit hint (docs/ANOMALY_DESIGN.md 5)
-- The exit of a teleport is fixed for the life of the object (chosen from its id, so a
-- reload does not change it; a new set of anomalies after an emission does). Now and
-- then a short run of puffs leaves the teleport toward its exit, for a player who watches.
-- Console: fl bind_mteleport.exit_hint_now()   fl bind_mteleport.set_exit_hint(false)
-- ************************************************
local HINT_ENABLED   = true
local HINT_PARTICLE  = [[anomaly2\teleport_damage_smoke_00]]
local HINT_RANGE     = 30      -- m: only teleports this close to the actor
local HINT_GAP_MS    = { 6000, 11000 }
local HINT_STEPS     = { 1.2, 2.4, 3.6 }  -- m from the centre, toward the exit
local HINT_STEP_MS   = 200
local HINT_LIFE_MS   = 1400
local HINT_HEIGHT    = 1.0

local hint_next  = {}   -- [teleport id] = time_global of its next hint
local hint_queue = {}   -- { time, pos }
local hint_live  = {}   -- { stop_time, particle }

function set_exit_hint(v)
	HINT_ENABLED = v and true or false
end

local function hint_emit(s, now)
	local dx, dz = s.poz_x - s.x, s.poz_z - s.z
	local len = math.sqrt(dx * dx + dz * dz)
	if len < 1 then return end
	dx, dz = dx / len, dz / len
	for n, d in ipairs(HINT_STEPS) do
		table.insert(hint_queue, {
			time = now + (n - 1) * HINT_STEP_MS,
			pos = vector():set(s.x + dx * d, s.y + HINT_HEIGHT, s.z + dz * d),
		})
	end
end

function exit_hint_now()
	local now = time_global()
	for id, v in pairs(teleport_binders) do
		if v.parametrs and v.parametrs.poz_x then hint_emit(v.parametrs, now) end
	end
end

function exit_hint_update(actor_pos)
	local now = time_global()

	for n = #hint_live, 1, -1 do
		if now >= hint_live[n].stop_time then
			hint_live[n].particle:stop()
			table.remove(hint_live, n)
		end
	end
	for n = #hint_queue, 1, -1 do
		local q = hint_queue[n]
		if now >= q.time then
			local p = particles_object(HINT_PARTICLE)
			p:play_at_pos(q.pos)
			table.insert(hint_live, { stop_time = now + HINT_LIFE_MS, particle = p })
			table.remove(hint_queue, n)
		end
	end

	if not HINT_ENABLED then return end
	for id, v in pairs(teleport_binders) do
		local s = v.parametrs
		if s and s.poz_x and s.x then
			local dx, dz = s.x - actor_pos.x, s.z - actor_pos.z
			if dx * dx + dz * dz < HINT_RANGE * HINT_RANGE and math.abs(s.y - actor_pos.y) < 10 then
				if not hint_next[id] then
					hint_next[id] = now + lua_random(HINT_GAP_MS[1], HINT_GAP_MS[2])
				elseif now >= hint_next[id] then
					hint_next[id] = now + lua_random(HINT_GAP_MS[1], HINT_GAP_MS[2])
					hint_emit(s, now)
				end
			else
				hint_next[id] = nil
			end
		end
	end
end

-- sivol: the view turns toward the exit as the corridor effect starts (toggle; the puffs are the main hint)
-- Console: fl bind_mteleport.set_exit_turn(false)   fl bind_mteleport.set_exit_turn(true, 1)  (the sign flips the side)
local TURN_ENABLED = true
local TURN_SIGN    = -1

function set_exit_turn(v, sign)
	TURN_ENABLED = v and true or false
	if sign then TURN_SIGN = sign end
end

function exit_turn(s)
	if not (TURN_ENABLED and s and s.poz_x and s.x) then return end
	local dx, dz = s.poz_x - s.x, s.poz_z - s.z
	if dx * dx + dz * dz < 1 then return end
	db.actor:set_actor_direction(TURN_SIGN * math.atan2(dx, dz))
end
