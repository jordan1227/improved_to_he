	{ "af_unknown_24_new", 12 }
}

-- [HE-PORT]
function refresh_mikhalych_arts( npc )
	local have = 0
	for i = 0, npc:object_count() - 1 do
		local o = npc:object( i )
		if o and strposx( o:section(), "af_unknown_" ) then have = have + 1 end
	end
	if have >= 6 then return end
	for _, v in ipairs( mikhalych_arts ) do
		if lua_random( 1, 100 ) <= v[ 2 ] then
			local spawned = misc.spawn_to( v[ 1 ], npc:id() )
			if spawned and sivol_unknown_arts
				and type(sivol_unknown_arts.initialize_new) == "function"
			then
				sivol_unknown_arts.initialize_new(spawned)
			end
		end
	end
	misc.process_spawn()
end

-- [HE-PORT]
function refresh_junkman_items( npc )
	local have = 0
	for i = 0, npc:object_count() - 1 do
		local o = npc:object( i )
		if o and kotovod.table_junkman_items[ o:section() ] then have = have + 1 end
	end
	if have >= 4 then return end
	kotovod.add_junkman_items()
end

-- [HE-PORT]
function hos_junkman_barter( npc1, npc2 )
	local npc = npc1:is_actor() and npc2 or npc1
	refresh_junkman_items( npc )
	npc:set_money( 1000000	)
	set_value( "tradein_npc", npc:name() )
	tradein_start( npc, "junkman_barter_buy", "junkman_barter_sell", true, false )
end

-- [HE-PORT]
local hermit_goods_count = 5
local hermit_conserva_count = 10

function refresh_hermit_goods( npc )
	local arts, food = 0, 0
	for i = 0, npc:object_count() - 1 do
		local o = npc:object( i )
		if o then
			local sect = o:section()
			if strposx( sect, "af_electra_sparkler" ) or strposx( sect, "af_electra_flash" )
			or strposx( sect, "af_dummy_battery" ) or sect == "af_capsule" or sect == "m_capsule" then
				arts = arts + 1
			elseif sect == "conserva" then
				food = food + 1
			end
		end
	end

	if arts < hermit_goods_count then
		misc.spawn_to( "af_electra_sparkler_dyn" .. lua_random( 1, 3 ) .. "d", npc:id() )
		misc.spawn_to( "af_electra_flash_dyn" .. lua_random( 1, 3 ) .. "d", npc:id() )
		misc.spawn_to( "af_dummy_battery", npc:id() )
		nlc_capsules.spawn_to( nlc_capsules.regular( "af_electra_moonlight", lua_random( 1, 3 ) ), npc:id() )
		nlc_capsules.spawn_to( nlc_capsules.mayatnik( "af_mayatnik_tesla_new" ), npc:id() )
	end

	for i = food + 1, hermit_conserva_count do
		misc.spawn_to( "conserva", npc:id() )
	end

	misc.process_spawn()
end

function gen_hermit_barter( npc1, npc2 )
	local npc = npc1:is_actor() and npc2 or npc1
	refresh_hermit_goods( npc )
	npc:set_money( 1000000	)
	set_value( "tradein_npc", npc:name() )
	tradein_start( npc, "hermit_barter_buy", "hermit_barter_sell", false, false )
