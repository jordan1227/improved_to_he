local hidden_recipes = {}

function hide_zub_recipes( except_lvl )
	local npc = g_sim:object( "bar_bar_osvedomitel" )
	if not npc then return end

	local zub = level.object_by_id( npc.id )
	local to_release = {}
	local except_recipes = kotovod[ except_lvl ] or {}

	for i = 0, zub:object_count() - 1 do
		local rec = zub:object( i )
		if rec then
			local name = rec:section()
			local info = name:gsub( "doc", "info_artmod" )
			if has_alife_info( info ) or not str_in_tab( info, except_recipes ) then
                table.insert( to_release, rec )
                if not has_alife_info( info ) then
                    table.insert( hidden_recipes, name )
                end
            end
        end
    end
	
	for _, rec in ipairs( to_release ) do
		misc.release_obj( rec )
	end
end

function remove_known_saharov_recipes()
	local npc = g_sim:object( "yantar_ecolog_general" )
	if not npc then return end
	
	local saharov = level.object_by_id( npc.id )
	local to_release = {}
	
	for i = 0, saharov:object_count() - 1 do
		local rec = saharov:object( i )
		if rec then
			local name = rec:section()
			local info = name:gsub( "doc", "info_amk" )
			if has_alife_info( info ) then
                table.insert( to_release, rec )
            end
        end
    end	
	
	for _, rec in ipairs( to_release ) do
		misc.release_obj( rec )
	end	
end

function respawn_hidden_recipes()
	if #hidden_recipes < 1 then return end
	local npc = g_sim:object( "bar_bar_osvedomitel" )
	for _, v in pairs( hidden_recipes ) do
		misc.spawn_to( v, npc )
	end
	hidden_recipes = {}
end

--[[	-- Этот вариант на сабскрайп ванс не совсем корректно работает. 
		-- Т.к после трейда, можем нажать на "уйти" и со второго раза можно будет открывать торговлю через кнопку без необходимости стартовать диалог. Сделаем обычным методом
local tradein_sig

function switch_to_tradein( npc )
	if tradein_sig then
		tradein_sig.self = npc
	else
		tradein_sig = {
			[ "signal" ] = "on_trade_hide",
			[ "fun"    ] = this.tradein_stop,
			[ "self"   ] = npc,
		}
	end
	sak.send_tip("SUBSCRIBED",nil,1,5,"g_g","no", "green")
	ogse_signals.get_mgr():subscribe_once( tradein_sig )
	npc:enable_trade()
	db.actor:switch_to_trade()
	log2( "subscribed" )
end


function tradein_stop( npc )
	local tt = get_cfg( npc )
	ASSERT( tt, "trade_manager[ npc:id() ] npc found: %s", npc:name() )

	remove_value( "tradein_npc" )
	npc:disable_trade()
	
	npc:trade_virtual_cost( 0, false )
	npc:ignore_trade_cond_factor( false )
	npc:buy_condition( tt.config, tt.current_buy_condition )
	npc:sell_condition( tt.config, tt.current_sell_condition )
	tt.noupdate = nil

	if actor_money >= 0 then
		db.actor:set_money( actor_money )
		actor_money = -1
	end
	log2( "unsubscribed" )
		sak.send_tip("UNSUBSCRIBED",nil,1,5,"g_g","sak", "red")
	tradein_sig.self = nil
end
]]--