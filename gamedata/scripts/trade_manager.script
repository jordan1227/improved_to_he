local trade_manager = {}

local enable_trade = {
	[ "escape_trader" ] = true,
	[ "yan_ecolog_kruglov" ] = true,
	-- [HE-PORT]
	[ "hos_junkman" ] = true,
	[ "lim_trader" ] = true
}

-- Перед сменой листа для tradein_npc добавляем нужные приписки, если потребуется сохранение одному нпц нескольких видов бартерных денег
local saving_money = {
	"bar_bar_osvedomitel",
	"yantar_ecolog_general_barter",
	"yantar_ecolog_general_recipes",
	"yan_ecolog_kruglov",
	"yantar_semenov",
	-- [HE-PORT]
	"hos_junkman",
	"lim_trader",
	"gen_hermit"
}

-- === PDA charging via yantar_semenov trade (price 0 to hand in) ===
local PDA_SECTION      = "device_pda_npc"
local PDA_CHARGE_BASE      = 30 * 60   -- база: 30 минут на одну пда
local PDA_TIME_GROWTH_MIN  = 0.05      -- случайный прирост за каждую следующую пда, от 5%
local PDA_TIME_GROWTH_MAX  = 0.12      -- случайный прирост за каждую следующую пда, до 12%
local PDA_QUEUE_KEY    = "pda_charge_queue"

-- цена ВОЗВРАТА заряженной пда (сдача трейдеру остаётся бесплатной)
local PDA_PRICE_BASE      = 1500   -- базовая цена за 1 пда на старте
local PDA_PRICE_STEP      = 250    -- на сколько растёт база инфляции
local PDA_PRICE_PERIOD_D  = 7      -- раз в сколько игровых суток растёт база
local PDA_PRICE_GROWTH    = 0.15   -- +15% к цене за каждую следующую пда в одной партии
local PDA_PRICE_EPOCH_KEY = "pda_price_epoch"

function attach(sm)
    sm:subscribe({ signal = "on_trade_open",  fun = this.on_trade_open 	})
    sm:subscribe({ signal = "on_trade", 	  fun = this.on_trade	  	})
    sm:subscribe({ signal = "on_trade_hide",  fun = this.on_trade_hide 	})
    sm:subscribe({ signal = "on_trade_money", fun = this.on_trade_money })
	sm:subscribe({ signal = "on_safe_spawn",  fun = this.on_safe_spawn })	
end 

local buy_items     = {}
local sold_items    = {}
local price_items_table = {}
local pda_sold_ids = {}            -- id сданных за этот трейд пда (для зарядки у yantar_semenov)

function on_trade_open()
	buy_items  = {}
	sold_items = {}
	pda_sold_ids = {}

--	local npc = level:get_second_talker()
--	if npc and npc:name() == "yantar_semenov" then
--		pda_charge_check()
--	end
end

function on_trade( item, sell_buy, money )
	local id = item:id()
	local trader = level:get_second_talker()	
	if sell_buy and item ~= "amk_metka" then
		buy_items[  id ] = nil
		sold_items[ id ] = true
		log2("Sold item added: %s - %s", id, item:name() )
		-- Нужно получить актуальную цену предмета тут, на закрытии уже не произойдет расчёт
		if trader and trader:name() == "yan_ecolog_kruglov" then 
			price_items_table[ item:id() ] = get_cost( item )
		end
		if trader and trader:name() == "yantar_semenov" and item:section() == PDA_SECTION then
			local status = vergas_pda.get_pda_status( id )
			if status == 2 then  -- берём в зарядку только разряженные (2); рабочие (1) и битые (3) не принимаем
				table.insert( pda_sold_ids, id )
				local obj = client_obj( id )
				if obj then
					set_item_inv_hidden( obj )
				end				
			end
		end
	else
		buy_items[  id ] = true
		sold_items[ id ] = nil
	end
end

function get_cost( obj )
    log2( "[actual_cost] Начало расчета стоимости для предмета %s", obj:name() )
    
    local trade_wnd = level.get_trade_wnd()
    if trade_wnd and trade_wnd:IsShown() then
        log2("[actual_cost] Обнаружено открытое окно торговли")
        
        local b_buying = obj:parent() and obj:parent():id() == db.actor:id()
        log2("[actual_cost] Режим покупки: %s", b_buying)
        
        local trader = level:get_second_talker()
        if trader then
            log2( "[actual_cost] Торговец найден: %s", trader:name() )
            
            local cur_price = trader:calculate_item_price( obj, b_buying )
            log2("[actual_cost] Расчетная цена от торговца: %s", cur_price )
            
            local result = string.format( "%.0f", cur_price )
            log2( "[actual_cost] Итоговая стоимость (окно торговли): %s", result )
            return result
        else
            log2( "[actual_cost] Торговец не найден" )
        end
    end
end

function on_trade_money( trader, money_out, money_in )
    if trader:name() == "yan_ecolog_kruglov" then 
        log2( "%s - потраченные деньги: %s, полученные деньги: %s", trader:name(), money_out, money_in )
        local barter_money = get_value( "barter_money", {} )
        log3( "barter_money перед сделкой: %s", barter_money )
        
        dsh.wait_condition( function() return has_alife_info( "ui_trade_hide" ) end, function()
            -- Обработка проданных предметов (если они есть)
            local has_good_art = false
            local current_trade_art = 0
            
            if sold_items and next(sold_items) then
                log3( "Текущие проданные арты: %s", sold_items )
                
                for id in pairs(sold_items) do
                    local item = level.object_by_id( id )
                    if item then 
                        local section = item:section()
                        local dyn = tonumber( string.sub( section, -2, -2 ) )
                        local actual_cost = price_items_table[ id ] or 5000
                        log2( "%s - dyn: %s, стоимость: %s", section, dyn, actual_cost )
                        
                        if dyn == 4 or dyn == 5 then 
                            has_good_art = true
                        else
                            current_trade_art = current_trade_art + actual_cost
                            log2( "%s - dyn: %s, пропуск - низкий дан", section, dyn )
                        end    
                    end
                end
            end
            
            -- Обработка текущего баланса
			local saved_money = barter_money[ trader:name() ] or 0
			log2( "barter_money перед обновлением: %s", saved_money )

			-- Если это сделка с обменом (и покупка и продажа)
			if money_out > 0 and money_in > 0 then
				-- Проверяем наличие "хороших" артефактов
				if has_good_art then
					-- Добавляем разницу между полученными и потраченными деньгами
					local profit = money_in - money_out
					saved_money = saved_money + profit
					log2( "Добавляем чистую прибыль от данового арта: %s", profit )
				else
					-- Оставляем существующую логику для обычных артефактов
					local remaining_cost = money_out - current_trade_art
					log2( "Стоимость отданного арта: %s, стоимость покупаемого: %s", current_trade_art, remaining_cost )
					
					if remaining_cost > 0 then
						saved_money = math.max( saved_money - remaining_cost, 0 )
						log2( "Вычитаем оставшуюся стоимость из сохраненных денег: %s", remaining_cost )
					end
				end
			else
				-- Существующая логика для покупки/продажи без обмена
				-- Обычная покупка (только расход)
				if money_out > 0 then
					saved_money = math.max( saved_money - money_out, 0 )
					log2( "Вычитаем потраченные деньги: %s", money_out )
				end
				
				-- Обычная продажа (только доход)
				if money_in > 0 then
					local good_art_value = 0
					for id, art_cost in pairs( price_items_table ) do
						local item = level.object_by_id( id )
						if item then
							local section = item:section()
							local dyn = tonumber( string.sub( section, -2, -2 ) )
							if dyn == 4 or dyn == 5 then
								good_art_value = good_art_value + art_cost
							end
						end
					end
					
					if good_art_value > 0 then
						saved_money = saved_money + good_art_value
						log2( "Учитываем стоимость данового арта: %s", good_art_value )
					end
				end				
			end
            
            barter_money[ trader:name() ] = saved_money
            log2( "Новая переменная для %s: %s", trader:name(), barter_money[ trader:name() ] )
            set_value( "barter_money", barter_money )

            -- Очищаем список купленных и проданных предметов
			buy_items = {}
			sold_items = {}
			price_items_table = {}
        end )
    end    
end

function count_sold_items( items )
    local counts = {}
    for id, _ in pairs( items ) do
        local obj = level.object_by_id( id )
        if obj then
            local trader = obj:parent()
            if trader and not trader:is_actor() then
                local tt = trade_manager[ trader:id() ]
                if tt and tt.buy_supplies then
                    local t = counts[ trader:name() ]
                    if not t then
                        t = {}
                        counts[ trader:name() ] = t
                    end
                    local sect = obj:section()
                    if t[ sect ] then
                        t[ sect ] = t[ sect ] + 1
                    else
                        t[ sect ] = 1
                    end
                end
            end
        end
    end
    return counts
end

function count_buy_items( items )
	local counts = {}
	for id, _ in pairs( items ) do
		local obj = level.object_by_id( id )
		if obj then
			local parent = obj:parent()
			if parent and parent:is_actor() then
				local sect = obj:section()
				if counts[ sect ] then
					counts[ sect ] = counts[ sect ] + 1
				else
					counts[ sect ] = 1
				end
			end
		end
	end
	return counts
end

function on_trade_hide()
    local sold_counts = count_sold_items( sold_items )
    local buy_counts = count_buy_items( buy_items )

    process_trade_counts( sold_counts, buy_counts )

    for _, id in ipairs( sold_items ) do
        local obj = client_obj( id )
        if obj then
            local trader = obj:parent()
            if trader then
                local tt = trade_manager[ trader:id() ]
                if tt and tt.buy_supplies then
                    -- log3("[%s]: Удаление проданного объекта у трейдера: [%s]", script_name(), obj:name())
                    release( obj )
                elseif trader:is_stalker() and not ( obj:is_ammo() or obj:is_weapon() or obj:is_outfit() ) then
                    -- log3("[%s]: Удаление проданного объекта у NPC: [%s]", script_name(), obj:name())
                    release( obj )
                end
            end
        end
    end
	
	-- Нужно для того, чтобы лист правильно обновился, иначе до первой манипуляции в торговле останется старый. Может есть нормальный вариант это поправить, но я хз
	local npc = level:get_second_talker()
	-- Ну, остается такой вариант, раз дш вейт не получается совместить работу обеих систем. Очистим уже в самом процессе, т.к нам важно получить айтемы
	-- Лучше получать через эту переменную, т.к у него еще обычная остается, там это ни к чему
	local name = get_value( "tradein_npc", false )
	--if name and name == "yan_ecolog_kruglov" then 
	if npc:name() == "yan_ecolog_kruglov" then
		return 
	end	

	if npc and npc:name() == "yantar_semenov" and #pda_sold_ids > 0 then
		pda_add_to_queue( pda_sold_ids )
	end

    buy_items = {}
    sold_items = {}
	respawn_hidden_recipes()
end

-- === PDA charging via yantar_semenov trade ===

function pda_get_queue()
	return get_value( PDA_QUEUE_KEY, {} )
end

function pda_set_queue( queue )
	set_value( PDA_QUEUE_KEY, queue )
end

function pda_get_epoch()
	local epoch = get_value( PDA_PRICE_EPOCH_KEY, nil )
	if not epoch then
		epoch = pack_time_to_string( game.get_game_time() )
		set_value( PDA_PRICE_EPOCH_KEY, epoch )
	end
	return unpack_time_from_string( epoch )
end

-- база цены: растёт на PDA_PRICE_STEP раз в PDA_PRICE_PERIOD_D игровых суток
--[[
function pda_base_price()
	local epoch = pda_get_epoch()
	local now = game.get_game_time()
	local elapsed_days = math.floor( now:diffSec( epoch ) / 86400 )
	local periods = math.floor( elapsed_days / PDA_PRICE_PERIOD_D )
	return PDA_PRICE_BASE + PDA_PRICE_STEP * periods
end
]]--

function pda_base_price()
	return sak_dialog.calc_money( PDA_PRICE_BASE, PDA_PRICE_PERIOD_D, PDA_PRICE_STEP )
end

-- цена конкретного экземпляра по его номеру в выдаваемой партии (n = 1, 2, 3...):
-- 1-й по базовой цене, каждый следующий на PDA_PRICE_GROWTH дороже базы
function pda_price_for_position( n )
	local base = pda_base_price()
	return math.floor( base * ( 1 + PDA_PRICE_GROWTH * ( n - 1 ) ) )
end

-- время конкретного экземпляра по его номеру в сдаваемой партии (n = 1, 2, 3...):
-- 1-й по базовому времени, каждый следующий получает случайный прирост
-- PDA_TIME_GROWTH_MIN..PDA_TIME_GROWTH_MAX поверх суммарного прироста предыдущих
function pda_time_for_position( n, cum_growth )
	return math.floor( PDA_CHARGE_BASE * ( 1 + cum_growth ) )
end

function pda_add_to_queue( id_list )
	local queue = pda_get_queue()
	local now = game.get_game_time()

	local last_end = now
	if #queue > 0 then
		local stored = unpack_time_from_string( queue[ #queue ].end_time )
		if stored:diffSec( now ) > 0 then
			last_end = stored
		end
	end

	local cum_growth = 0
	for n, id in ipairs( id_list ) do
		if n > 1 then
			local step = lua_random( PDA_TIME_GROWTH_MIN * 1000, PDA_TIME_GROWTH_MAX * 1000 ) / 1000
			cum_growth = cum_growth + step
		end
		local charge_time = pda_time_for_position( n, cum_growth )
		last_end = last_end + seconds2ctime( charge_time )
		table.insert( queue, { id = id, end_time = pack_time_to_string( last_end ) } )
	end
	pda_set_queue( queue )
end

-- вызывается из on_trade_open в момент открытия трейда с yantar_semenov.
-- Работаем с ТЕМ ЖЕ объектом, который сдал игрок (release() при продаже его
-- не уничтожает, а просто передаёт трейдеру в ассортимент) - никакого
-- нового спавна, только смена статуса/кондиции у существующего id.
function pda_charge_check()
	local queue = pda_get_queue()
	if #queue == 0 then return end

	local now = game.get_game_time()
	local remaining = {}
	local position = 0
	local changed = false

	for _, e in ipairs( queue ) do
		local sobj = alife():object( e.id )

		if not sobj then
			-- объект пропал (подобрали/уничтожили где-то ещё) - выкидываем из очереди
			changed = true
		else
			local end_time = unpack_time_from_string( e.end_time )
			if end_time:diffSec( now ) <= 0 then
				position = position + 1
				if vergas_pda.charge_pda( e.id ) then
					local obj = client_obj( e.id )
					if obj then
						-- цену конкретного экземпляра ставим сами, как у vahtang;
						-- хватит ли денег - решает штатное трейд-окно, как обычно
						obj:set_cost( pda_price_for_position( position ) )			
							log2( "cost is %s", pda_price_for_position( position ) )
						set_item_inv_visible( obj )
						set_item_ungroupable( obj )
					end
				end
				changed = true
			else
				-- ещё заряжается - прячем из инвентаря/списка трейдера
				local obj = client_obj( e.id )
				if obj then
					set_item_inv_hidden( obj )
				end
				table.insert( remaining, e )
			end
		end
	end

	if changed then
		pda_set_queue( remaining )
	end
end

function process_trade_counts( t, b )
	if t.bar_bar_osvedomitel then
		for k, v in pairs( b ) do 
			if not strposx( k, "doc_" ) then return end
			local info = k:gsub( "doc", "info_artmod" )	
			kotovod.give_info( info )
			kotovod.sms_recipt_found( info )
			local rec = db.actor:object( k ) 
			if rec then 
				misc.release_obj( rec )
			end	
		end	
	end	   
	
	if t.yantar_ecolog_general then 
		for k, v in pairs( b ) do 
			if not strposx( k, "doc_recipt" ) then return end
			local info = k:gsub( "doc", "info_amk" )	
			kotovod.give_info( info )
			kotovod.sms_recipt_found( info )
			local rec = db.actor:object( k ) 
			if rec then 
				misc.release_obj( rec )
			end	
		end			
	end
end

