local trade_manager = {}


function attach(sm)
    sm:subscribe({signal = "on_trade_open", fun = this.on_trade_open})
    sm:subscribe({signal = "on_trade", fun = this.on_trade})
    sm:subscribe({signal = "on_trade_hide", fun = this.on_trade_hide})
end

local sold_items = {}
function on_trade_open()
	sold_items = {}
end

function on_trade(item, is_sold, money)
	if is_sold and item:section() ~= "amk_metka" then
		table.insert(sold_items, item:id())
	elseif not is_sold and item:section() == "flask_army" then
		vergas_flask.take_flask_army(item,item:id(),true)
	end
	local barter = rawget(_G, "ui_barter")
	if barter and barter.on_trade then barter.on_trade(item, is_sold, money) end
end

function on_trade_hide()
	for _, id in ipairs(sold_items) do
		local obj = client_obj(id)
		if obj then
			local trader = obj:parent()
			if trader then
				local tt = trade_manager[trader:id()]
				if tt and tt.buy_supplies then
					-- log3("[%s]: Deletion of a sold object from trader: [%s]", script_name(), obj:name())
					release(obj)
				elseif trader:is_stalker() and not (obj:is_ammo() or obj:is_weapon() or obj:is_outfit()) then
					-- log3("[%s]: Deletion of a sold object from NPC: [%s]", script_name(), obj:name())
					release(obj)
				end
			end
		end
	end
	sold_items = {}
end

function trade_init( npc, cfg )
	-- log2("[~T] trade_init for %s",npc:name())
    local tt = {}
    trade_manager[ npc:id() ] = tt
    tt.cfg_ltx = cfg
    tt.config  = dsh.cached_ini_file( cfg )

    local str  = get_string( "trader", "buy_condition", nil, tt.config )
    ASSERT( str, "Incorrect trader settings. Cannot find buy_condition. [%s]->[%s]", npc:name(), cfg )
    tt.buy_condition = xr_logic.parse_condlist( npc, "trade_manager", "buy_condition", str )
    
    str = get_string( "trader", "sell_condition", nil, tt.config )
    ASSERT( str, "Incorrect trader settings. Cannot find sell_condition. [%s]->[%s]", npc:name(), cfg )
    tt.sell_condition = xr_logic.parse_condlist( npc, "trade_manager", "sell_condition", str )

    str = get_string( "trader", "buy_supplies", nil, tt.config )
    if str then

        tt.skip_updates = 10

        tt.buy_supplies = xr_logic.parse_condlist( npc, "trade_manager", "buy_supplies", str )
        if not tt.resuply_time then
            local sobj = alife():object( npc:id() )
            if sobj and sobj.s_storage and sobj.s_storage ~= "_" then
                local data = amk.parse_custom_data( sobj.s_storage )
                if data.trade_manager and data.trade_manager.resuply_time then
                    tt.resuply_time = unpack_time_from_string( data.trade_manager.resuply_time )
                    -- log2(
                     -- "TRADE INIT[%s] resuply_time in %s seconds",
                     -- npc:name(), tt.resuply_time:diffSec( game.get_game_time() )
                    -- )
                end
            end
        end
    else
        tt.buy_supplies = nil
    end
end

function update( npc )
    local tt = trade_manager[ npc:id() ]
	local nname = npc:name()
    ASSERT( tt, "trade_manager[ npc:id() ] npc found: %s", nname )

    if tt.skip_updates and tt.skip_updates > 0 then
        tt.skip_updates = tt.skip_updates - 1
        return
    end

    if tt.update_time ~= nil and tt.update_time > time_global() then return end
	local update_t = lua_random( 600, 1400 ) * 1000
    tt.update_time = time_global() + update_t

    local str = xr_logic.pick_section_from_condlist( db.actor, npc, tt.buy_condition )
    if tt.current_buy_condition ~= str then
        -- log2( "[~T]TRADE UPDATE[%s]: buy condition = %s", npc:name(), str )
        npc:buy_condition( tt.config, str )
        tt.current_buy_condition = str
    end

    str = xr_logic.pick_section_from_condlist( db.actor, npc, tt.sell_condition )
    if tt.current_sell_condition ~= str then
        -- log2( "[~T]TRADE UPDATE[%s]: sell condition = %s", npc:name(), str )
        npc:sell_condition( tt.config, str )
        tt.current_sell_condition = str
    end

    if tt.buy_supplies then
        if tt.resuply_time and tt.resuply_time:diffSec( game.get_game_time() ) > 0 then
            return
        end
        str = xr_logic.pick_section_from_condlist( db.actor, npc, tt.buy_supplies )
        if tt.current_buy_supplies ~= str then
            -- log2( "TRADE UPDATE[%s]: buy_supplies = %s", npc:name(), str )
            npc:buy_supplies( tt.config, str )
            tt.current_buy_supplies = str
        end
        if nname == "escape_trader" or nname == "bar_barman" then
            tt.resuply_time = game.get_game_time() + seconds2ctime( lua_random( 20, 30 ) * 3600 )
		elseif nname == "dsc_part_exchanger" then
			tt.resuply_time = game.get_game_time() + seconds2ctime( lua_random( 12, 17 ) * 3600 )
        else
            tt.resuply_time = game.get_game_time() + seconds2ctime( lua_random( 30, 40 ) * 3600 )	
        end
        -- log2(
          -- "TRADE UPDATE[%s] resuply_time in %s seconds",
          -- npc:name(), tt.resuply_time:diffSec( game.get_game_time() )
        -- )
        local sobj = alife():object( npc:id() )
        if sobj then
            local data
            if sobj.s_storage and sobj.s_storage ~= "_" then
                data = amk.parse_custom_data( sobj.s_storage )
            else
                data = {}
            end
            data.trade_manager = {
                [ "resuply_time" ] = pack_time_to_string( tt.resuply_time )
            }
            sobj.s_storage = amk.gen_custom_data( data )
            -- log2( "TRADE UPDATE[%s] s_storage = %s", npc:name(), sobj.s_storage )
        end
    end
end

function save( obj, packet )
    local tt = trade_manager[ obj:id() ]
    --' Сохраняем присутствует ли инициализированная торговля в принципе.
    if tt == nil then
        packet:w_bool( false )
        return
    else
        packet:w_bool( true )
    end
    packet:w_stringZ( tt.cfg_ltx )
    if tt.current_buy_condition == nil or type( tt.current_buy_condition ) == "number" then
        packet:w_stringZ( "" )
    else
        packet:w_stringZ( tostring( tt.current_buy_condition ) )
    end
    if tt.current_sell_condition == nil or type( tt.current_sell_condition ) == "number" then
        packet:w_stringZ( "" )
    else
        packet:w_stringZ( tostring( tt.current_sell_condition ) )
    end
    if tt.current_buy_supplies == nil or type( tt.current_buy_supplies ) == "number" then
        packet:w_stringZ( "" )
    else
        packet:w_stringZ( tostring( tt.current_buy_supplies ) )
    end
    local cur_tm = time_global()
    if tt.update_time == nil then
        packet:w_s32( -1 )
    else
        packet:w_s32( tt.update_time - cur_tm )
        -- log2(
        --         "TRADE SAVE[%s]: update_time = %s",
        --         obj:name(), ( tt.update_time - cur_tm ) / 1000
        --     )
    end
    if tt.resuply_time then
        -- log2(
        --   "TRADE SAVE[%s]: resuply_time = %s",
        --   obj:name(), tt.resuply_time:diffSec( game.get_game_time() )
        -- )
        packet:w_s32( tt.resuply_time:diffSec( game.get_game_time() ) * 1000 )
    else
        packet:w_s32( -1 )
    end
end

function load( obj, packet, ver )
	-- log2("[~T] trade_load called for %s",obj:name())
    local a = packet:r_bool()
    if a == false or ( ver and ver < 7 ) then
        -- printf("TRADE LOAD [%s]: ignored", obj:name())
        return
    end
    trade_manager[ obj:id() ] = {}
    local tt   = trade_manager[ obj:id() ]
    tt.cfg_ltx = packet:r_stringZ()
    -- ODS("[~T]. #DBG: погнали вещь загружать ~C0A"..obj:name().." и вещь "..tostring(tt.cfg_ltx).."~C07")
    tt.config = dsh.cached_ini_file( tt.cfg_ltx )
    a = packet:r_stringZ()
    -- ODS("[~T]. #DBG: погнали buy_condition загружать ~C0A"..obj:name().." и вещь "..tostring(a).."~C07")
	if a == nil or a == "" then
		a = get_string( "trader", "buy_condition", nil, tt.config )
		a = string.gsub(a,"{.*}","")
		a = string.gsub(a,".*,","")
	end
    if a ~= nil and a~= "" then
        tt.current_buy_condition = a
        obj:buy_condition( tt.config, a )
    end
    a = packet:r_stringZ()
    -- ODS("[~T]. #DBG: погнали sell_condition загружать ~C0A"..obj:name().." и вещь "..tostring(a).."~C07")
	if a == nil or a == "" then
		a = get_string( "trader", "sell_condition", nil, tt.config )
		a = string.gsub(a,"{.*}","")
		a = string.gsub(a,".*,","")
	end
    if a ~= nil and a~= "" then
        tt.current_sell_condition = a
        obj:sell_condition( tt.config, a )
    end
    a = packet:r_stringZ()
    -- ODS("[~T]. #DBG: погнали buy_supplies загружать ~C0A"..obj:name().." и вещь "..tostring(a).."~C07")
    if a ~= "" then
        tt.current_buy_supplies = a
    end
    local cur_tm = time_global()
    a = packet:r_s32()
    -- ODS("[~T]. #DBG: погнали время загружать ~C0A"..obj:name().." и вещь "..tostring(a).."~C07")
    if a ~= -1 then
        tt.update_time = cur_tm + a
    end
    a = packet:r_s32()
    -- log2(
      -- "TRADE LOAD[%s]: resuply_time = %s", obj:name(), tostring( a )
    -- )
    if a > 0 then
        tt.resuply_time = game.get_game_time() + seconds2ctime( a / 1000 )
    end
end

function get_trade_info(id, mode)
	if trade_manager[id] then
		if mode == 1 then
			return trade_manager[id].cfg_ltx
		elseif mode == 2 then
			return trade_manager[id].config
		elseif mode == 3 then
			return trade_manager[id].current_buy_supplies
		elseif mode == 4 then
			return trade_manager[id].current_buy_condition
		elseif mode == 5 then
			return trade_manager[id].current_sell_condition
		end
	end
end

function is_npc_using_trade_section(id)
	local cfg = get_trade_info(id,1)
	if cfg ~= nil then
		if not strpos(cfg,"trade_logic") then
			return true
		end
	end
	return false
end

-- [HE-PORT] perenos kvestovyh funkcij iz NLC HE (trade_manager.script)
local trader_configs = {
    [ "escape_trader" ] = {
        default = {
            buy = "trader_generic_buy",
            sell = "trader_start_sell",
            supplies = "supplies_start"
        },
        barter = {
            info = "info_sidor_switch_to_barter",
            buy = "sidor_barter_buy",
            sell = "sidor_barter_sell",
            supplies = "sidor_barter_supplies"
        },
        modificats = {
            info = "info_sidor_switch_to_modificats",
            buy = "sidor_modificats_buy",
            sell = "sidor_modificats_sell",
            supplies = "sidor_modificats_supplies"
        }
    },
	
    [ "yan_ecolog_saharov" ] = {
        default = {
            buy = "ecolog_generic_buy",
            sell = "ecolog_start_sell",
            supplies = "supplies_start"
        },
		after_brain = {
            buy = "ecolog_generic_buy",		
			sell = "ecolog_after_brain_sell",
			supplies = "supplies_after_brain"
		},		
        barter = {
            info = "info_saharov_switch_to_recipes",
            buy = "saharov_barter_buy",
            sell = "saharov_barter_sell",
            supplies = "saharov_barter_supplies"
        }
    },	
}

local saved_inventories = {}

function save_trader_inventory(npc_name, trader)
    local sobj = g_sim:object(npc_name)
    if not sobj then return false end

    trader = trader or level.object_by_id(sobj.id)
    if not trader then return false end

    local tt = trade_manager[sobj.id]
    if not tt then return false end

    local original_ids = {}
    for i = 0, trader:object_count() - 1 do
        local item = trader:object(i)
        if item then original_ids[item:id()] = true end
    end

    saved_inventories[npc_name] = {
        original_ids = original_ids,
        buy_condition = tt.current_buy_condition,
        sell_condition = tt.current_sell_condition,
        buy_supplies = tt.current_buy_supplies,
        update_time = tt.update_time,
        resuply_time = tt.resuply_time,
        skip_updates = tt.skip_updates,
    }
    return true
end

function is_temporary_trade_item(npc_name, id)
    local snapshot = saved_inventories[npc_name]
    return snapshot ~= nil and snapshot.original_ids[id] ~= true
end

function restore_trader_inventory(npc_name)
    local sobj = g_sim:object(npc_name)
    local snapshot = saved_inventories[npc_name]
    if not sobj or not snapshot then return end

    local trader = level.object_by_id(sobj.id)
    if not trader then return end

    -- Original OGSR stock never leaves the trader and is merely hidden.
    -- Remove only temporary barter stock and artefacts paid by the actor.
    for i = trader:object_count() - 1, 0, -1 do
        local item = trader:object(i)
        if item and not snapshot.original_ids[item:id()] then
            misc.release_obj(item)
        end
    end

    local tt = trade_manager[sobj.id]
    if tt then
        tt.current_buy_condition = snapshot.buy_condition
        tt.current_sell_condition = snapshot.sell_condition
        tt.current_buy_supplies = snapshot.buy_supplies
        tt.update_time = snapshot.update_time
        tt.resuply_time = snapshot.resuply_time
        tt.skip_updates = snapshot.skip_updates

        if snapshot.buy_condition then
            trader:buy_condition(tt.config, snapshot.buy_condition)
        end
        if snapshot.sell_condition then
            trader:sell_condition(tt.config, snapshot.sell_condition)
        end
    end

    saved_inventories[npc_name] = nil
end
-- [HE-PORT] Apply a temporary trade profile from a shared ini to any dialog trader.
function start_temporary_trade(npc, ini_path, buy_section, sell_section, supplies_section)
    if not npc then return false end
    local npc_name = npc:name()
    local tt = trade_manager[npc:id()]
    if not tt or not save_trader_inventory(npc_name, npc) then return false end

    local ini = ini_path and dsh.cached_ini_file(ini_path) or system_ini()
    tt.current_buy_condition = buy_section
    tt.current_sell_condition = sell_section
    tt.current_buy_supplies = supplies_section
    npc:buy_condition(ini, buy_section)
    npc:sell_condition(ini, sell_section)
    npc:buy_supplies(ini, supplies_section)
    -- Keep the regular trade manager from replacing this profile on its next tick.
    tt.update_time = time_global() + 24 * 60 * 60 * 1000
    tt.skip_updates = 0
    tt.resuply_time = game.get_game_time() + seconds2ctime(24 * 60 * 60)
    trade_subscribe(npc_name)
    return true
end

function switch(npc_name, config_name)
    local sobj = alife():object(npc_name)
    if not sobj then 
        --log2("[trade_manager]: Нет объекта alife для %s", npc_name)
        return false
    end
    
    local npc_id = sobj.id
    local npc = level.object_by_id(npc_id)
    if not npc then
        --log2("[trade_manager]: Нет объекта уровня для %s", npc_name)
        return false
    end

    local tt = trade_manager[npc_id]
    if not tt then
        --log2("[trade_manager]: Нет менеджера торговли для %s", npc_name)
        return false
    end

    local trader_config = trader_configs[npc_name]
    if not trader_config then
        --log2("[trade_manager]: Нет конфигурации для %s", npc_name)
        return false
    end

    local new_config = trader_config[config_name]
	
	-- Эксклюзив для Сахаревича
	if npc_name == "yan_ecolog_saharov" and config_name == "default" and has_alife_info( "yan_kill_brain_done" ) then
		new_config = trader_config[ "after_brain" ]
	else
		new_config = trader_config[ config_name ]
	end	
	
    if not new_config then
        --log2("[trade_manager]: Нет конфигурации %s для %s", config_name, npc_name)
        return false
    end
    
    if config_name ~= "default" and not save_trader_inventory(npc_name) then
        return false
    end

    -- Применяем новую конфигурацию
    tt.current_buy_condition = new_config.buy
    tt.current_sell_condition = new_config.sell
	if config_name ~= "default" then 
		tt.current_buy_supplies = new_config.supplies
	end
	
    -- Обновляем торговлю
    npc:buy_condition(tt.config, tt.current_buy_condition)
    npc:sell_condition(tt.config, tt.current_sell_condition) 
	if config_name ~= "default" then 	
		npc:buy_supplies(tt.config, tt.current_buy_supplies)
	end

    -- Устанавливаем info
    if new_config.info then
        db.actor:give_info_portion(new_config.info)
    end
    disable_other_configs(npc_name, config_name)

    -- Сбрасываем время обновления и пополнения
	if config_name ~= "default" then 
		tt.update_time = nil
		tt.skip_updates = 0
		tt.resuply_time = game.get_game_time()
	end	

    --log2("[trade_manager]: Переключено %s на конфигурацию %s", npc_name, config_name)
    --sak.send_tip("Обновили торговлю на " .. config_name, npc_name, 0, 5, "uniq", "no", "yellow")

    trade_subscribe(npc_name)
    return true
end
function disable_other_configs(npc_name, active_config)
    local trader_config = trader_configs[npc_name]
    if not trader_config then return end
    
    for config_name, config in pairs(trader_config) do
        if config_name ~= active_config and config_name ~= "default" and config.info then
			--kotovod.disable_info( config.info )
           db.actor:disable_info_portion( config.info )
        end
    end
end
function trade_subscribe( npc_name )
	if not trade_signal then
		trade_npc_name = npc_name
		--sak.send_tip( trade_npc_name, "on sub", 0, 5, "uniq", "no", "green")
		trade_signal = {
		--	{ signal = "on_trade", 		fun = this.trade_process 	  },
			{ signal = "on_trade_hide",	fun = this.trade_unsubscribe },
		}
		local sm = ogse_signals.get_mgr()
		for _, s in ipairs( trade_signal ) do
			sm:subscribe( s )			
		end
	end
end
function trade_unsubscribe()
	if trade_signal then
		local sm = ogse_signals.get_mgr()
		for _, s in ipairs( trade_signal ) do
			sm:unsubscribe( s )	
		end
		restore_trader_inventory(trade_npc_name)
		disable_other_configs(trade_npc_name, "default")

		local barter = rawget(_G, "ui_barter")
		if barter and barter.finish then barter.finish(trade_npc_name) end

		trade_signal = nil
		trade_npc_name = nil
		gnzi.trade_many_add()
	end
end	  
