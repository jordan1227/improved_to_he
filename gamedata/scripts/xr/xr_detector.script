local def_idle = 10
local idle = 10
local art_tbl = {}
local first_update = false
local time_to_discharge_1 = 24 * 5 * 60 * 60
local time_to_discharge_2 = 24 * 2 * 60 * 60

-- Battery drain for the passive detectors (class D_SIMDET: Geiger counter, Kisel, anomaly detectors).
-- They have no on/off switch: the engine runs them whenever the item sits in a slot
-- (CCustomDetectorSHOC::OnMoveToSlot), so "active" here means "in a detector slot" (8, 13-16).
-- Items in the ruck or in a razgruzka pocket (shadow inventory) do not drain.
-- Condition is the charge. Drain is game-time based, like he_watch_battery. detector_art keeps its
-- own slower drain in actor_detector:update below and is not drained here.
--
-- NOTE (engine option): CCustomDetectorSHOC has no condition check at all (only the COP-style
-- CCustomDetector ignores zones at condition <= 0.01), so a drained detector is taken off by script.
-- Gating IsWorking/shedule_Update/UpdateCL in CCustomDetectorSHOC would be the cleaner implementation.
-- NOTE (trade): item price is expected to scale with condition, so a drained detector sells for
-- next to nothing until a battery is fitted. Accepted for now (not verified in game).
local DAY = 24 * 60 * 60
local BATTERY_SLOTS = { 8, 13, 14, 15, 16 }
local BATTERY_TICK = 60      -- game seconds between condition writes
local BATTERY_CHECK_MS = 500 -- real-time cadence of the slot scan
local BATTERY_DEAD = 0.001
-- Game seconds of continuous use per full battery. Tuning values: keep elite/advanced in step with
-- the Kisel detectors until their advantages are rebalanced.
local battery_life = {
	detector_simple         = 3 * DAY,
	detector_advances       = 3 * DAY,
	detector_elite          = 3 * DAY,
	detector_sakbuzz_simple = 3 * DAY,
	detector_sakbuzz_elite  = 3 * DAY,
}
local battery_state = {}    -- [item id] = game time of the last condition write
local battery_check_at = 0

local function detector_name(sect)
	return game.translate_string(get_string(sect, "inv_name_short", sect))
end

local function battery_tip(key, sect, colour)
	sak.send_tip_local(
		string.format(game.translate_string(key), detector_name(sect)),
		game.translate_string("thinking_out_loud"), 0, 5, "g_g", "no", colour)
end

local function battery_dead(obj)
	local sect = obj:section()
	db.actor:move_to_ruck(obj)
	razgruzka.check_detectors() -- refresh the slot cache after the detector leaves its slot
	battery_tip("detector_battery_dead", sect, "red")
	vergas_lib.s_play([[device\antirad_no]], 1)
end

local function update_batteries()
	local act = db.actor
	if not act or not act:alive() then return end
	local t = time_global()
	if t < battery_check_at then return end
	battery_check_at = t + BATTERY_CHECK_MS

	local now = game.get_game_time()
	local seen = {}
	for _, slot in ipairs(BATTERY_SLOTS) do
		local obj = act:item_in_slot(slot)
		local life = obj and battery_life[obj:section()]
		if life then
			local id = obj:id()
			seen[id] = true
			local cond = obj:condition()
			if cond > BATTERY_DEAD then
				local last = battery_state[id]
				if not last then
					battery_state[id] = now
				else
					local elapsed = now:diffSec(last)
					if elapsed < 0 then
						battery_state[id] = now
					elseif elapsed >= BATTERY_TICK then
						battery_state[id] = now
						cond = math.max(0, cond - elapsed / life)
						obj:set_condition(cond)
					end
				end
			end
			-- also catches a dead detector that was put back into a slot
			if cond <= BATTERY_DEAD then battery_dead(obj) end
		end
	end
	for id in pairs(battery_state) do
		if not seen[id] then battery_state[id] = nil end
	end
end

-- Drag a battery (batt_torch) onto a detector. Returns true when the battery was used.
function recharge_detector(battery, detector)
	local act = db.actor
	if not (act and act:alive() and battery and detector) then return false end
	if battery:id() == detector:id() then return false end
	local bp, dp = battery:parent(), detector:parent()
	if not (bp and dp and bp:id() == act:id() and dp:id() == act:id()) then return false end

	local sect = detector:section()
	if detector:condition() >= 0.99 then
		battery_tip("detector_battery_full", sect, "yellow")
		vergas_lib.s_play([[device\antirad_no]], 1)
		return false
	end
	-- No yield between the checks above and consuming the battery.
	misc.release_obj(battery)
	detector:set_condition(1)
	battery_state[detector:id()] = game.get_game_time()
	battery_tip("detector_battery_replaced", sect, "green")
	vergas_lib.s_play([[device\use_battery]], 1)
	return true
end

class "actor_detector"
function actor_detector:__init()
	-- self.last_update_time = game.get_game_time()
	battery_state = {} -- a fresh binder means a fresh load: drop stale timestamps
	battery_check_at = 0
end

function actor_detector:update()
	if not first_update and sak.game_began then
		create_tbl()
		local a_det = get_value("active_detector")
		if a_det ~= nil then
			set_proper_det(a_det)
		else
			log2("set_proper_det: returned nil")
		end
		razgruzka.check_detectors()
		first_update = true
	end
	-- if #art_tbl == 0 then
	-- 	-- log2("[~T]. actor_detector: return due to empty art_tbl")
	-- 	return
	-- end
	-- log2("[~T]. actor_detector: start")
	update_batteries()
	local detector_record = razgruzka.active_detectors[8]
	if detector_record and strpos(detector_record,"art") then
		if not self.last_update_time then
			self.last_update_time = game.get_game_time()
		end
		local delta = game.get_game_time():diffSec(self.last_update_time)
		if delta < idle then
			-- log2("[~T]. actor_detector: timeout (diff = %s)",game.get_game_time():diffSec(self.last_update_time))
			return 
		end
		local cond_dec
		if strpos(detector_record,"upgr") then
			cond_dec = delta / time_to_discharge_2
		else
			cond_dec = delta / time_to_discharge_1
		end
		
		local det = server_obj(detector_record)
		if det then
			local c_det = client_obj(det.id)
			if c_det then
				local cond = c_det:condition()
				if cond <= 0 then return end
				local new_cond = cond - cond_dec
				if new_cond < 0 then
					new_cond = 0
				end
				c_det:set_condition(new_cond)
				-- log2("actor_detector:update: setting new_cond for [%s] = [%.6f]",detector_record,new_cond)
			end
		end
		
		self.last_update_time = game.get_game_time()
		local pos = db.actor:position()
		local a_pos
		for v,_ in pairs(art_tbl) do
			local obj = client_obj(v)
			if obj and isArt(obj) and obj:parent() == nil then
				a_pos = obj:position()
				local dist = pos:distance_to_xz(a_pos)
				if dist <= 33 then
					idle = def_idle * math.max( 0.1, ( dist * 3 / 100 ) )
					-- log2("actor_detector: art = %s, idle = %s",obj:name(),idle)
					local snd_obj = xr_sound.get_safe_sound_object("detectors\\da_beep_03")
					snd_obj:play(db.actor, 0, sound_object.s2d)
					break
				end
			else
				idle = def_idle
			end
		end
	else
		self.last_update_time = nil
		idle = def_idle
	end
end

function create_tbl()
	local lvl = level.name()
	local temp = get_value("tbl_bio_art", {})
	if not has_alife_info("gluzov_final_reward_done_info") and temp[lvl] and #temp[lvl] > 0 then
		for _,v in pairs(temp[lvl]) do
			if v ~= -1 then
				art_tbl[v] = true
			end
		end
		-- dump_table(art_tbl,"xr_detector.art_tbl")
	elseif has_alife_info("gluzov_final_reward_done_info") then
		art_tbl = bind_det_arts.share_art_tbl()
	else
		-- log2("xr_detector.create_tbl: unable to form a table")
	end
end
function get_art_tbl()
	return art_tbl
end
function del_from_tbl(id)
	art_tbl[id] = nil
end
-- ставим на первом апдейте правильный детектор из карамана разгрузки в слот (раньше для этого могло потребоваться открыть-закрыть диалог разгрузки)
function set_proper_det(det)
	local obj = server_obj(det)
	if obj and obj.parent_id and obj.parent_id == 0 and strpos(obj:name(),"detector")then
		local act = db.actor
		local item_in_slot = act:item_in_slot(8)
		if item_in_slot and item_in_slot:name() ~= obj:name() then
			act:move_to_ruck(item_in_slot)
		end
		local c_obj = client_obj(obj.id)
		if c_obj then
			nlc_container.try_to_slot(c_obj,8)
			-- log2("set_proper_det: done for %s",c_obj:name())
		end
		razgruzka.check_detectors()
	end
end