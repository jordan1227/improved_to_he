-- [HE-PORT]
local artifact_stat_rows = {
	"st_pda_otherstats_arts_found_1",
	"st_pda_otherstats_arts_found_2",
	"st_pda_otherstats_arts_found_3",
	"st_pda_otherstats_arts_found_mayat",
	"st_pda_otherstats_arts_found_uniq",
}

local artifact_stats_initialized = false

local function artifact_matches(section, entries)
	if not section or not entries then return false end
	for _, entry in ipairs(entries) do
		if string.find(section, entry, 1, true) then return true end
	end
	return false
end

local function artifact_stat_section(sect, id)
	if not sect then return nil end
	local is_capsule = sect == "af_capsule" or sect == "m_capsule"
		or string.find(sect, "_capsule", 1, true) ~= nil
	if is_capsule and id and nlc_capsules and nlc_capsules.read_server then
		local ok, payload = pcall(nlc_capsules.read_server, id)
		if ok and payload and nlc_capsules.content_section then
			local content_ok, content = pcall(nlc_capsules.content_section, payload)
			if content_ok and content then return content end
		end
	end
	return sect
end

local function artifact_category(section)
	if not section then return nil end
	local base = string.gsub(section, "_capsule$", "")
	local arts = kotovod and kotovod.tbl_arts
	local dialog_arts = sak_dialog

	if section == "m_capsule" or string.find(section, "^af_mayatnik_") then
		return "st_pda_otherstats_arts_found_mayat", 5
	end
	if dialog_arts and artifact_matches(base, dialog_arts.table_mayatniks) then
		return "st_pda_otherstats_arts_found_mayat", 5
	end
	if arts and artifact_matches(base, arts.lvl12) then
		return "st_pda_otherstats_arts_found_mayat", 5
	end
	if arts and artifact_matches(base, arts.lvl11) then
		return "st_pda_otherstats_arts_found_uniq", 4
	end
	if (arts and artifact_matches(base, arts.lvl1))
		or (dialog_arts and artifact_matches(base, dialog_arts.table_aart)) then
		return "st_pda_otherstats_arts_found_1", 1
	end
	if (arts and artifact_matches(base, arts.lvl2))
		or (dialog_arts and artifact_matches(base, dialog_arts.table_bart)) then
		return "st_pda_otherstats_arts_found_2", 2
	end
	if section == "af_capsule" then
		return "st_pda_otherstats_arts_found_3", 3
	end
	if arts and (artifact_matches(base, arts.lvl5) or artifact_matches(base, arts.lvl6)) then
		return "st_pda_otherstats_arts_found_3", 3
	end
	if dialog_arts and artifact_matches(base, dialog_arts.table_capsule) then
		return "st_pda_otherstats_arts_found_3", 3
	end
	return nil
end

function init_artifact_stats()
	if artifact_stats_initialized then return end
	if not actor_stats or not game or not game.translate_string then return end
	local initialized = true
	for _, key in ipairs(artifact_stat_rows) do
		local ok = pcall(function()
			actor_stats.add_points("otherstats", game.translate_string(key), 0, 0)
		end)
		if not ok then initialized = false end
	end
	if initialized then artifact_stats_initialized = true end
end

function add_found_artifact(sect, id)
	init_artifact_stats()
	local semeckiy_id = nil
	if get_value then semeckiy_id = get_value("nlc_vars.semeckiy_art_id") end
	if semeckiy_id ~= nil and semeckiy_id == id then
		local anomaly_key = game.translate_string("st_pda_otherstats_arts_found_3")
		local semeckiy_key = game.translate_string("st_pda_otherstats_arts_found_semeckiy")
		add_pts("otherstats", anomaly_key, 1, 3)
		local function replace_semeckiy_stat()
			add_pts("otherstats", anomaly_key, -1, -3)
			add_pts("otherstats", semeckiy_key, 1, 6)
		end
		if dsh and dsh.timeout then
			dsh.timeout(1000, replace_semeckiy_stat)
		else
			replace_semeckiy_stat()
		end
		return
	end

	local section = artifact_stat_section(sect, id)
	local key, points = artifact_category(section)
	if key then
		add_pts("otherstats", game.translate_string(key), 1, points)
	end
end

function init_module()
  monster_classes = {
    [ CLID_TUSHKANO           ] = "tushkano",
    [ CLID_FLESH              ] = "flesh",
    [ CLID_BOAR               ] = "boar",
    [ CLID_CAT                ] = "cat",
    [ CLID_ZOMBIE             ] = "zombie",
    [ CLID_BURER              ] = "burer",
    [ CLID_CHIMERA            ] = "chimera",
    [ CLID_DOG                ] = "dog",
    [ CLID_PSEUDODOG          ] = "pseudodog",
    [ CLID_PSY_DOG            ] = "psy_dog",
    [ clsid.psy_dog_phantom_s ] = "psy_dog_phantom",
    [ CLID_SNORK              ] = "snork",
    [ CLID_POLTERGEIST        ] = "poltergeist",
    [ CLID_GIGANT             ] = "pseudo_gigant",
    [ CLID_CONTROLLER         ] = "controller",
    [ CLID_BLOODSUCKER        ] = "bloodsucker"
  }    
  init_artifact_stats()
  -- [HE-PORT]
  init_game_time_counter()
end    

-- обновляем статистику на странице "Данные" в ПДА
-- используются глобальные переменные:
--	set_value("add_pts__flag_initialize_monsterkills	- если nil или false, то нужна инициализация раздела monsterkills в ПДА
--	set_value("add_pts__flag_initialize_stalkerkills	- если nil или false, то нужна инициализация раздела stalkerkills в ПДА
-- варианты props (см. gamedata\config\ui\actor_statistic.xml):
--	"monsterkills"	- убито мутантов
--	"stalkerkills"	- убито людей
--	"exp"		- вылечено людей
--	"quests"	- выполнено заданий
--	"arts"		- найдено артефактов
--	"artefacts"	- сварено артефактов
--	"otherstats"	- прочая статистика
--	"total"		- всего
--
function add_pts(props, sect_name, count, pts)
	if pts == nil then return end

	if false then
		-- [HE-PORT]
	end

	-- wprintf(
		-- " points for~C0F %s ~C0A %s~C07 ~C0B x ~C0D %d~C0B =~C0D %.3f~C07 ",
		-- props, sect_name, count, pts
	-- )
	actor_stats.add_points(props, sect_name, count, pts)
	local temp
	if (actor_stats.get_points("total") == nil) or type(actor_stats.get_points("total"))~="number" then
		temp = db.actor:character_rank() + (pts * count)
	else
		temp = actor_stats.get_points("total")
		temp = temp - temp % 1			-- целая часть числа
	end
	db.actor:set_character_rank(temp)
end

-- убили существо, обновляем статистику в ПДА
function addKillCount(npc)
	if npc == nil then
		return
	end

	local isS, isM = false, false
	if IsStalker(npc) then
		isS = true
	elseif IsMonster(npc) then
		isM = true
	else
		return
	end

	local npc_section = npc:section() or ""
	local npc_character_community, npc_reputation = "", 0
	if isS then
		npc_character_community = npc:character_community() or ""
		npc_reputation = npc:character_reputation() or 0
		-- log2("[addKillCount]: npc_name = %s, npc_section = %s, npc_character_community = %s, npc_reputation = %d", npc:name(), npc_section, npc_character_community, npc_reputation)
	end

	-- ранг существа в npc_rank (1..3 для монстров, 1..4 для НПС), в npc_rank_string ранг существа строчкой
	local table_ranks = {
		none = 1,												-- nil rank
		novice = 1, experienced = 2, veteran = 3, master = 4,	-- stalkers ranks
		weak = 1, normal = 2, strong = 3						-- monsters ranks
	}
	local npc_rank_string = ranks.get_obj_rank_name(npc) or "none"
	local npc_rank = table_ranks[npc_rank_string] or 1

	-- в npc_index_to_search что будем искать в table_statistic_kill_data для соответствия убитому существу
	local npc_index_to_search = npc_section						-- для монстров используем section
	if isS and npc_character_community ~= "" then
		npc_index_to_search = npc_character_community			-- для сталкеров используем character_community
	end

	-- ищем в ключах таблицы table_statistic_kill_data лучшее совпадение со строкой npc_index_to_search
	local npc_index_bestfind = "unknown_monster"				-- ключ лучшего совпадения
	if isS then
		npc_index_bestfind = "unknown_stalker"
	end
	if npc_index_to_search ~= "" then
		local length_bestfind = 1								-- длина лучшего совпадения (ищем совпадения length_bestfind+1 и лучше)
		for k, _ in pairs(table_statistic_kill_data) do
			local x,y = string.find(npc_index_to_search, k)
			x = x or 1
			y = y or 0
			local length = y - x + 1							-- длина текущего совпадения
			if length > length_bestfind then					-- лучшее совпадение?
				length_bestfind = length
				npc_index_bestfind = k
			end
		end
	end

	-- название убитого существа в ПДА в pda_alias_data
	local pda_alias_data = table_statistic_kill_data[npc_index_bestfind].pda_alias[npc_rank]
	if pda_alias_data == nil then
		-- если в нашей таблице нет информации, как назвать существо в ПДА, пусть будет "unknown_stalker"
		pda_alias_data = table_statistic_kill_data["unknown_stalker"].pda_alias[npc_rank]
	end
	-- очков в ПДА за убитое существо в pda_pts_data. Если в нашей таблице не информации об очках, пусть будет 0
	local pda_pts_data = table_statistic_kill_data[npc_index_bestfind].pda_pts[npc_rank] or 0

	-- Если репутация у существа плохая, то за его убийство не снимаем очки в ПДА
	if (pda_pts_data < 0) and (npc_reputation < 0) then
		pda_pts_data = 0
	end
	-- attitude_neutal_threshold (из game_relations.ltx) будем использовать? Eсли будем, то смотреть
	-- amk_offline_alife.script, news_main.script (использование utils.cfg_get_number для загрузки параметров из game_relations.ltx)
	-- Но аккуратно, т.к. плохим человеком игра считает НПС с репутацией -150 и ниже, а, например, бандиты на
	-- Свалке имеют репутацию -50..-100

-- debug. Если раскомментировать строки ниже, то при убийстве существа будет выводится на экран:
--local debug1 = ""
--debug1 = debug1.."npc_section="..npc_section				-- section существа
--debug1 = debug1..", npc_character_community="..npc_character_community	-- character_community существа
--debug1 = debug1..", npc_reputation="..npc_reputation			-- reputation существа
--debug1 = debug1..", npc_rank_string="..npc_rank_string		-- ранг существа
--debug1 = debug1..", npc_index_to_search="..npc_index_to_search	-- название существа для поиска в таблице table_statistic_kill_data
--debug1 = debug1..", npc_index_bestfind="..npc_index_bestfind	-- что нашлось про существо в таблице table_statistic_kill_data
--debug1 = debug1..", pda_alias_data="..pda_alias_data		-- какое название у существа будет в статистике ПДА
--debug1 = debug1..", pda_pts_data="..tostring(pda_pts_data)	-- сколько очков будет дано за убитое существо в статистике ПДА
--jack.show(debug1,30)

	if isM then
		add_pts("monsterkills", pda_alias_data, 1, pda_pts_data)
	elseif isS then
		-- [HE-PORT]
	end
end

-- сварили артефакт, обновляем статистику в ПДА, начисляем экспу
function addCookingPoints(sect_name)
	if strpos(sect_name, "_capsule") then
		sect_name = string.gsub(sect_name, "_capsule", "")
	end
	local translatedSection = ""
	local mod_flag = false
	local pts = 0.5
	for _,v in pairs(sak_dialog.table_modarts) do
		for _,vv in ipairs(v) do
			if sect_name == vv then
				mod_flag = true
				break
			end
		end
		if mod_flag then
			break
		end
	end
	if mod_flag then
		translatedSection = game.translate_string("st_pda_mods_artefacts")
	elseif str_in_tab(sect_name, {"af_dummy_green", "af_red_dummy", "af_dummy_sparkler", "af_dummy_dummy_new"} ) then
		translatedSection = game.translate_string("st_pda_other_artefacts")
	else
		translatedSection = get_string(sect_name,"inv_name",game.translate_string("unknown_art"))
		pts = get_cooking_exp(sect_name)
	end
	add_pts("artefacts", translatedSection, 1, pts)
end

function get_cooking_exp(sect_name)
	local pts = 0
	if str_in_tab(sect_name,sak_dialog.table_aart) then
		pts = 0.5
	elseif str_in_tab(sect_name,sak_dialog.table_bart) then
		pts = 1
	elseif str_in_tab(sect_name,sak_dialog.table_cart) then
		pts = 1.5
	else
		pts = 2
	end
	return pts
end

-- [HE-PORT]

class "QuestStat" (CUIScriptWnd)

function QuestStat:__init(owner) super()
   self.owner = owner
   self:InitControls()
end

function QuestStat:InitControls()
	self:SetWndRect(168,405,240,120)
	self:SetAutoDelete(true)
	self:Show(false)
	self.owner:AttachChild( self )
	
	self.game_st = CUIStatic()
	self.game_st:SetAutoDelete(true)
	self.game_st:SetFont(GetFontLetterica18Russian())
	self.game_st:SetWidth(210)
	self.game_st:SetHeight(20)
	self.game_st:SetTextX(8)
	self.game_st:SetTextY(130)
	self.game_st:SetTextColor(160,170,170,170)
	self.game_st:SetTextAlign(CGameFont.alLeft)
	self.game_st:SetText( game.translate_string( "st_pda_actor_games" ) )
	self:AttachChild(self.game_st)

	self.game = CUIStatic()
	self.game:SetAutoDelete(true)
	self.game:SetFont(GetFontLetterica18Russian())
	self.game:SetWidth(200)
	self.game:SetHeight(20)
	self.game:SetTextColor(200,255,255,255)
	self.game:SetTextAlign(CGameFont.alLeft)
	self.game:SetTextX(8)
	self.game:SetTextY(152)
	self.game:SetText( gametime( get_death_count( "game_time" ) ) )
	self:AttachChild(self.game)	

	self.diff_st = CUIStatic()
	self.diff_st:SetAutoDelete(true)
	self.diff_st:SetFont(GetFontLetterica18Russian())
	self.diff_st:SetWidth(210)
	self.diff_st:SetHeight(20)
	self.diff_st:SetTextColor(200,255,255,255)
	self.diff_st:SetTextAlign(CGameFont.alLeft)
	self.diff_st:SetTextX(0)
	self.diff_st:SetTextY(174)
	self:AttachChild(self.diff_st)
end

function QuestStat:RefreshTime()
	if self.game then
		self.game:SetText( gametime( get_death_count( "game_time" ) ) )
	end
end

-- [HE-PORT]
local difficulty_names = {
	[0] = "ui_mm_novice",
	[1] = "ui_mm_stalker",
	[2] = "ui_mm_veteran",
	[3] = "ui_mm_master"
}

-- [HE-PORT]
local difficulty_colors = {
	[0] = "%c[255,105,240,145]",
	[3] = "%c[255,255,85,85]"
}

-- [HE-PORT]
function QuestStat:UpdateDifficulty()
	if not self.diff_st then return end
	local d = level.get_game_difficulty() or 1
	if d < 0 or d > 3 then d = 1 end
	self.diff_st:SetTextComplexMode(true)
	self.diff_st:SetText(
		game.translate_string( "ui_mm_difficulty" ) .. ": "
		.. ( difficulty_colors[d] or "" )
		.. game.translate_string( difficulty_names[d] )
	)
end

function QuestStat:Update()
	CUIScriptWnd.Update(self)
	-- [HE-PORT]
	local pda = level.get_pda_wnd()
	local show = db.actor ~= nil and pda ~= nil and pda:IsShown() and pda:FindChild("master_list") ~= nil
	if show and not self.shown then
		self.shown = true
		self:RefreshTime()
		self:UpdateDifficulty()
		self:Show(true)
	elseif not show and self.shown then
		self.shown = false
		self:Show(false)
		save_gametime()
	end
end

function QuestStat:HideWnd()
	self:Show(false)
	self.owner:DetachChild(self)
end

local quest_stat = nil

function ShowQuestStat()
	save_gametime()
	local r = level.get_pda_wnd() or level.main_input_receiver()
	if not r then
		return
	end
	if quest_stat then
		pcall(function() quest_stat:HideWnd() end)
		quest_stat = nil
	end
	quest_stat = QuestStat( r )
	if quest_stat then
		quest_stat:RefreshTime()
		quest_stat:UpdateDifficulty()
		quest_stat.shown = true
		quest_stat:Show(true)
	end
end

function HideQuestStat()
	save_gametime()
	if quest_stat then
		pcall(function() quest_stat:HideWnd() end)
		quest_stat = nil
	end
end
-- [HE-PORT]
function show_quest_stat()
	init_artifact_stats()
	ShowQuestStat()
end

function hide_quest_stat()
	HideQuestStat()
end

-- [HE-PORT]
function pda_stats_active()
	local pda = level.get_pda_wnd()
	return db.actor ~= nil and pda ~= nil and pda:IsShown() and pda:FindChild("master_list") ~= nil
end

-- [HE-PORT]
function pda_stats_update()
	ogse_signals.get_mgr():reschedule( 250 )
	local active = pda_stats_active()
	if active and not quest_stat then
		ShowQuestStat()
	elseif not active and quest_stat and quest_stat.shown == false then
		HideQuestStat()
	end
	if active and quest_stat then
		quest_stat:RefreshTime()
	end
end


function gametime( time )
	time = math.floor( ( time or 0 ) * 1.1 + 0.5 )
	local str = ""
	local val = 0
	
	if time >= 60 * 24 * 365 then
		val = math.floor( time / ( 60 * 24 * 365 ) )
		time = time - val * 60 * 24 * 365
		str = str .." ".. tostring( val ) .." ".. timename( val, "ui_stat_year_0", "ui_stat_year_1", "ui_stat_year_2" )
	end

	if time >= 60 * 24 * 30.417 then
		val = math.floor( time / ( 60 * 24 * 30.417 ) )
		time = time - math.floor( val * 60 * 24 * 30.417 + 0.5 )
		str = str .." ".. tostring( val ) .." ".. timename( val, "ui_stat_mon_0", "ui_stat_mon_1", "ui_stat_mon_2" )
	end

	if time >= 60 * 24 then
		val = math.floor( time / ( 60 * 24 ) )
		time = time - val * 60 * 24
		str = str .." ".. tostring( val ) .." ".. timename( val, "ui_stat_day_0", "ui_stat_day_1", "ui_stat_day_2" )
	end

	if time >= 60 then
		val = math.floor( time / 60 )
		time = time - val * 60
		str = str .." ".. tostring( val ) .." ".. timename( val, "ui_stat_hour_0", "ui_stat_hour_1", "ui_stat_hour_2" )
	end

	if time > 0 then
		str = str .." "..tostring( time ) .." ".. timename( time, "ui_stat_min_0", "ui_stat_min_1", "ui_stat_min_2" )
	end
	if str == "" then
		str = " 0 " .. game.translate_string( "ui_stat_min_2" )
	end
	return str
end

function timename( val, s1, s2, s3 )
	if val > 20 then
		val = math.fmod( val, 10 )
	end
	if val == 0 or val >= 5 then
		return game.translate_string( s3 )
	elseif val >= 2 then
		return game.translate_string( s2 )
	else
		return game.translate_string( s1 )
	end
end

-- [HE-PORT]
local game_time_key = "he_stat_game_time_minutes"
local _gametime_saved_at = nil
local game_time_migrated = false

local function current_game_time()
	if not time_global then return nil end
	local ok, value = pcall(time_global)
	if ok and type(value) == "number" then return value end
	return nil
end

local function legacy_death_count( what )
	local fs_ok, f = pcall(getFS)
	if not fs_ok or not f then return 0 end
	local list_ok, flist = pcall(function()
		return f:file_list_open_ex(
			"$game_stats$", bit_or( FS.FS_ListFiles, FS.FS_RootOnly ),
			"*." .. what
		)
	end)
	if not list_ok or flist == nil then return 0 end
	local size_ok, size = pcall(function() return flist:Size() end)
	if not size_ok or not size or size <= 0 then
		pcall(function()
			local f1 = f:update_path( "$fs_root$", "fsgame.ltx" )
			local f2 = f:update_path( "$game_stats$", "0." .. what )
			f:file_copy( f1, f2 )
		end)
		return 0
	end
	local name_ok, name = pcall(function() return flist:GetAt( 0 ):NameFull() end)
	if not name_ok then return 0 end
	return tonumber( string.match( tostring( name or "" ), "^(%d+)" ) ) or 0
end

local function stored_game_time()
	local value = get_value( game_time_key, nil )
	if value == nil and not game_time_migrated then
		value = legacy_death_count( "game_time" )
		if value > 0 then set_value( game_time_key, value ) end
		game_time_migrated = true
	elseif value ~= nil then
		game_time_migrated = true
	end
	return tonumber( value ) or 0
end

function get_death_count( what )
	if what == "game_time" then
		local total = stored_game_time()
		local now = current_game_time()
		if now then
			if _gametime_saved_at == nil then
				_gametime_saved_at = now
			elseif now >= _gametime_saved_at then
				total = total + ( now - _gametime_saved_at ) / 60000
			else
				_gametime_saved_at = now
			end
		end
		return total
	end
	return legacy_death_count( what )
end

function set_death_count( what, value )
    if what == "game_time" then
        set_value( game_time_key, tonumber( value ) or 0 )
        game_time_migrated = true
        local now = current_game_time()
        if now then _gametime_saved_at = now end
        return
    end
    local f = getFS()
    local ok, flist = pcall( function()
        return f:file_list_open_ex( "$game_stats$",
            bit_or( FS.FS_ListFiles, FS.FS_RootOnly ),
            "*." .. what )
    end )
    if not ok or flist == nil then return end
    local fileName = ""
    if flist:Size() > 0 then
        fileName = flist:GetAt( 0 ):NameFull() or ""
    end
    local fileNameNew = ( tostring( value ) .. "." .. what ) or ""
    if fileName == "" then
        local f1 = f:update_path( "$fs_root$", "fsgame.ltx" )
        local f2 = f:update_path( "$game_stats$", fileNameNew )
        pcall( function() f:file_copy( f1, f2 ) end )
        return
    end
    if fileNameNew ~= fileName then
        local f1 = f:update_path( "$game_stats$", fileName )
        local f2 = f:update_path( "$game_stats$", fileNameNew )
        pcall( function() f:file_rename( f1, f2, true ) end )
    end
end

function reset_death_count( what )
    if what == "game_time" then
        set_value( game_time_key, 0 )
        game_time_migrated = true
        local now = current_game_time()
        if now then _gametime_saved_at = now end
        return
    end
    local f  = getFS()
    local f1 = f:update_path( "$fs_root$", "fsgame.ltx" )
    local f2 = f:update_path( "$game_stats$", "0." .. what )
    pcall( function() f:file_copy( f1, f2 ) end )
end

function init_game_time_counter()
	if _gametime_saved_at ~= nil then save_gametime() end
	stored_game_time()
	local now = current_game_time()
	if now then _gametime_saved_at = now end
end

function save_gametime()
	if not ( db and db.actor ) then return end
	local now = current_game_time()
	if not now then return end
	if _gametime_saved_at == nil then
		_gametime_saved_at = now
		return
	end
	local delta = now - _gametime_saved_at
	if delta < 0 then
		_gametime_saved_at = now
		return
	end
	if delta <= 0 then return end
	local total = stored_game_time()
	set_death_count( "game_time", total + delta / 60000 )
end
