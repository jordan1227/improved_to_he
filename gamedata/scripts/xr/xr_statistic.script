-- таблица названий монстров в ПДА (из gamedata\config\text\rus\stable_statistic_caption.xml) для инициализации
-- в начале игры (для сортировки).
--

function attach(sm)
  sm:subscribe({signal = "on_init_modules", fun = this.init_module})
  sm:subscribe({signal = "on_pda_actor_info", fun = this.show_quest_stat})
  sm:subscribe({signal = "on_update", fun = this.pda_stats_update})
  -- [HE-PORT]
  sm:subscribe({signal = "on_before_save_game", fun = this.save_gametime})
  sm:subscribe({signal = "on_stop_modules", fun = this.save_gametime})
  for _, s in ipairs({
    "on_pda_open",
    "on_pda_contacts_open", "on_pda_contacts_hide",
    "on_pda_diary_open", "on_pda_diary_hide",
    "on_pda_encyclopedia_open", "on_pda_encyclopedia_hide",
    "on_pda_events",
    "on_pda_jobs_open", "on_pda_jobs_accomplished", "on_pda_jobs_current", "on_pda_jobs_failed", "on_pda_jobs_hide",
    "on_pda_map_global", "on_pda_map_local",
    "on_pda_news_open", "on_pda_news_hide",
    "on_pda_hide",
    "on_pda_ranking",
  }) do
    sm:subscribe({signal = s, fun = this.hide_quest_stat})
  end
--   sm:subscribe({signal = "on_late_init_all", fun = this.late_init})
--   sm:subscribe({signal = "on_before_save_game", fun = this.on_before_save})
end

