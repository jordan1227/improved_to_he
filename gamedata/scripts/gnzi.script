
-- [HE-PORT] perenos kvestovyh funkcij iz NLC HE (gnzi.script)

-- [HE-PORT] proxy: staroe hranilishche nlc_vars poverh dvizhkovogo xvars (get_value/set_value iz _g)
if nlc_vars == nil then
  nlc_vars = setmetatable( {}, {
    __index    = function( t, k ) return get_value( "nlc_vars." .. k ) end,
    __newindex = function( t, k, v ) set_value( "nlc_vars." .. k, v ) end,
  } )
end
function trade_many_remove()
  	local sum = db.actor:money()
	if sum > 0 then db.actor:give_money(-sum) nlc_vars.trade_me_re = sum end
end
function trade_many_add()
	if nlc_vars.trade_me_re == nil then return end
	local sum = db.actor:money()
	if sum > 0 then db.actor:give_money(-sum) end
  	sum = nlc_vars.trade_me_re or 1
	if sum > 0 then db.actor:give_money(sum) nlc_vars.trade_me_re = nil end
	kotovod.set_trade_af_flag()
	kotovod.petrenko_trade_unsubscribe()
end
function fox_monsters_timer()
	local rnd = lua_random( 2, 4 )
  	timers.start_timer( "t1_lys_monsters", 0, 0, rnd, "gnzi.add_fox_monsters()" )
  	timers.start_timer( "t2_lys_monsters", 0, 0, rnd + 6, "gnzi.add_fox_monsters()" )
end

-- [HE-PORT-R2] перенос функций NLC HE из gnzi.script
function remove_and_set_barter_money( name )
	if not name then return end
	npc_name = name

	-- Получаем деньги у гг
    local sum = db.actor:money()
	-- Обнуляем и сохраняем
    if sum > 0 then 
		db.actor:give_money( -sum ) 
        nlc_vars.money_before_barter = sum
    end
	
	local barter_money = xray_vars.load_table( nlc_vars, "barter_money", {} )
	if not barter_money[ name ] then return end
	-- Даем сохраненные
	db.actor:give_money( tonumber( barter_money[ name ] or 0 ) )
end

-- [HE-PORT]
function add_fox_monsters()
	local points = {
		{ 150.080459594727, -0.030008643866, 342.286254882813 },
		{ 134.686370849609, -0.910186171532, 304.119506835938 },
		{ 126.506011962891,  0.132115632296, 345.048858642578 }
	}
	local ind = lua_random( #points )
	local rnd = lua_random( 1, 2 )
	for i = 1, rnd do
		local obj = misc.spawn_obj( "pseudodog_normal", sak.v3f( points[ ind ][ 1 ], points[ ind ][ 2 ], points[ ind ][ 3 ] ) )
		if obj then
			he_fox_dogs.register_wave_monster( obj.id )
		end
		if obj and obj.online then
			g_sim:set_switch_online( obj.id, false )
			g_sim:set_switch_offline( obj.id, true )
			amk.convert_npc[ obj.id ] = 1
		end
	end
end
