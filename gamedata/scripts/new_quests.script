-- [HE-PORT]
function generate_rnd_item_npc( table_name )
	if #table_name < 1 then return end
	local random = dsh.get_next_random( "kotovod.generate_rnd_item_npc", #table_name )
	return table_name[ random ] and table.remove( table_name, random )
end

-- [HE-PORT]
function generate_voron_arts()
	remove_value( "nlc_vars.voron_random" )
	remove_value( "nlc_vars.voron_reward" )
	remove_value( "nlc_vars.tbl_voron_arts" )

	local voron_arts = {}
	local random = dsh.get_next_random( "generate_voron_arts", 1, 4 )

	if random == 1 then
		for a = 1, 3 do
			table.insert( voron_arts, generate_rnd_item_npc( generate_arts.lvl1 ) )
		end
	end

	if random == 2 then
		for a = 1, 3 do
			table.insert( voron_arts, generate_rnd_item_npc( generate_arts.lvl2 ) )
		end
	end

	if random == 3 then
		for a = 1, 2 do
			table.insert( voron_arts, generate_rnd_item_npc( generate_arts.lvl3 ) )
		end
	end

	if random == 4 then
		local level  = dsh.get_next_random( "generate_voron_arts", 1, 3 )
		local amount = ( level == 1 and 3 ) or ( level == 2 and 2 ) or 1
		for a = 1, amount do
			table.insert( voron_arts, generate_rnd_item_npc( generate_arts[ "lvl" .. level ] ) )
		end
		table.insert( voron_arts, generate_rnd_item_npc( generate_arts.lvl4 ) )
	end

	set_value( "nlc_vars.voron_random", random )
	set_value( "nlc_vars.tbl_voron_arts", voron_arts )
end

-- [HE-PORT]
function voron_arts_end()
	generate_voron_arts()
	db.actor:give_info_portion( "val_voron_arts_have" )

	if get_value( "nlc_vars.voron_amount", 0 ) == 5 then
		remove_value( "nlc_vars.voron_random" )
		remove_value( "nlc_vars.voron_reward" )
		remove_value( "nlc_vars.tbl_voron_arts" )
		db.actor:disable_info_portion( "val_voron_arts_generate" )
		db.actor:disable_info_portion( "val_voron_arts_have" )
		db.actor:give_info_portion( "val_voron_arts_done" )
		return
	end

	local tbl = get_value( "nlc_vars.tbl_voron_arts", {} )
	if #tbl >= 1 then
		local arts = ""
		for _, v in pairs( tbl ) do
			arts = arts .. get_inv_name( v ) .. ", "
		end
		arts = string.sub( arts, 1, string.len( arts ) - 2 )
		sak.send_tip(
			game.translate_string( "he_voron_arts_order" ) .. arts,
			game.translate_string( "he_voron_arts_order_name" ), 0, 25, "voron", "sak", "gray"
		)
	end

	local days = lua_random( 4, 7 )
	timers.start_timer( "voron_arts", days, 0, 0, "new_quests.voron_arts_end()" )
end

