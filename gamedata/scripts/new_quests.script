-- [HE-PORT]
local new_tasks_eliminate = {
	[ "esc_wolf" ] = {
		monsters = {
			{ "esc_bridge_boar",  "esc_small_home2" },
			{ "esc2_dogs_zamost", "esc_small_home1" },
			{ "esc_flesh_1",      "esc_flesh_2"     },
			{ "esc_dogs_swarm",   "esc_small_home6" }
		},
		infos = { "esc_wolf_1_mutants", "esc_wolf_2_mutants" },
		comm = "stalker", time = 12, whom = "esc_wolf_name"
	}
}

-- [HE-PORT]
local function eliminate_tbl( parent )
	local task = new_tasks_eliminate[ parent ]
	if not task then return end
	if parent == "esc_wolf" then
		local rnd = get_value( "r_task_reward", 1 )
		if rnd >= 5 then rnd = 4 end
		return task.monsters[ rnd ]
	end
	return task.monsters
end

-- [HE-PORT]
function gg_has_infos( tbl )
	local num, count = nil, 0
	for k, v in pairs( tbl ) do
		num = k
		if has_alife_info( v ) then count = count + 1 end
	end
	return count == num
end

-- [HE-PORT]
function format_mutants_text( tbl )
	local lname = level.name()
	local text  = ""
	for k, v in pairs( tbl ) do
		local obj = g_sim:object( v )
		if obj then
			local where = news_main.get_point_description( lname, vector():set( obj.position ) )
			text = text .. k .. " группа " .. where .. ";\\n"
		end
	end
	return text
end

-- [HE-PORT]
function eliminate_lager_timer_end( parent )
	if has_alife_info( parent .. "_eliminate_mutants_done" ) then return end
	local task = new_tasks_eliminate[ parent ]
	if not task then return end

	db.actor:give_info_portion( parent .. "_task_failed" )
	for _, v in pairs( task.infos ) do
		db.actor:disable_info_portion( v )
	end
	eliminate_monsters( "remove_spot", parent )
	sak.send_tip(
		"Меченный, время вышло, задача провалена!",
		game.translate_string( task.whom ), 0, 30, task.comm, "sak", "red"
	)
end

-- [HE-PORT]
function eliminate_monsters( flag, parent )
	local task = new_tasks_eliminate[ parent ]
	if not task then return end
	local tbl = eliminate_tbl( parent )
	if not tbl then return end

	if flag == "talk_about" then
		local task_texture, task_rect = get_texture_info( "ui_iconsTotal_eliminate_lager" )
		db.actor:give_talk_message( format_mutants_text( tbl ), task_texture, task_rect, "iconed_trade_info" )
	end

	if flag == "have_mutants" then
		return gulag_mutants_have( tbl )
	end

	if flag == "have_not" then
		return gulag_mutants_have_not( tbl )
	end

	if flag == "add_spot" then
		timers.start_timer( parent .. "_eliminate_lager", 0, task.time, 0,
			"new_quests.eliminate_lager_timer_end( \"".. parent .."\" )" )
		monster_spot_on_map( tbl, "add" )
		if parent == "esc_wolf" then
			sak.create_items( "ammo_9x18_fmj", 2 )
			sak.create_items( "bandage", 2 )
			sak.create_items( "medkit", 1 )
		end
	end

	if flag == "remove_spot" then
		monster_spot_on_map( tbl, "remove" )
	end

	if flag == "have_done" then
		return ( gulag_mutants_done( tbl ) or gg_has_infos( task.infos ) )
	end

	if flag == "not_done" then
		return not ( gulag_mutants_done( tbl ) or gg_has_infos( task.infos ) )
	end

	if flag == "reward" then
		relation_registry.change_community_goodwill( task.comm, db.actor:id(), 25 )
		db.actor:change_character_reputation( 25 )
		xr_statistic.add_pts( "quests", game.translate_string( "task_new_eliminate" ), 1, 25 )
		db.actor:disable_info_portion( parent .. "_eliminate_mutants_start" )
		db.actor:give_info_portion( parent .. "_eliminate_mutants_done" )
		for _, v in pairs( task.infos ) do
			db.actor:disable_info_portion( v )
		end
		if parent == "esc_wolf" then
			kotovod.add_rnd_art_to_actor( 1, 3 )
		end
		timers.stop_timer( parent .. "_eliminate_lager" )
	end
end

-- [HE-PORT]
function new_task_eliminate_lager_start( dlg, parent )
	local task = new_tasks_eliminate[ parent ]
	if not task then return end
	local random = lua_random( 1, 10 )
	local phr = task_manager.Dlg_AddPhrase( dlg, gg_seek_job[ random ], "0", "", -10000 )
	local phrase_script = phr:GetPhraseScript()

	phr = task_manager.Dlg_AddPhrase( dlg,
		"Здравствуй, Меченный! Перейдем сразу к делу, есть одно заданьице. \\nНеобходимо уничтожить мутантов за " ..
		task.time .. " часов, тут недалеко:", "1", "0", -10000 )
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddAction( "new_quests.eliminate_monsters( 'talk_about', \"".. parent .."\" )" )
	phrase_script:AddDontHasInfo( parent .. "_eliminate_mutants_start" )
	phrase_script:AddPrecondition( "new_quests.eliminate_monsters( 'have_mutants', \"".. parent .."\" )" )

	phr = task_manager.Dlg_AddPhrase( dlg, gg_job_yes[ random ], "110", "1", -10000 )
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddAction( "new_quests.eliminate_monsters( 'add_spot', \"".. parent .."\" )" )
	phrase_script:AddGiveInfo( parent .. "_eliminate_mutants_start" )

	phr = task_manager.Dlg_AddPhrase( dlg, "Хорошо, будем ждать вестей...", "111", "110", -10000 )
	phrase_script = phr:GetPhraseScript()

	phr = task_manager.Dlg_AddPhrase( dlg, gg_job_refuse[ random ], "120", "1", -10000 )
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddGiveInfo( parent .. "_eliminate_mutants_done" )
	phrase_script:AddAction( "dialogs.break_dialog" )

	phr = task_manager.Dlg_AddPhrase( dlg, "Как знаешь, тогда я кого-нибудь другого подыщу.", "121", "120", -10000 )
	phrase_script = phr:GetPhraseScript()

	phr = task_manager.Dlg_AddPhrase( dlg,
		"Так я ведь недавно давал задание. Необходимо его сперва выполнить, потом о другом поговорим.",
		"2", "0", -10000 )
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddHasInfo( parent .. "_eliminate_mutants_start" )

	phr = task_manager.Dlg_AddPhrase( dlg, "Хорошо, понял.", "21", "2", -10000 )
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddAction( "dialogs.break_dialog" )

	phr = task_manager.Dlg_AddPhrase( dlg, gg_not_job[ random ], "3", "0", -10000 )
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddPrecondition( "new_quests.eliminate_monsters( 'have_not', \"".. parent .."\" )" )

	phr = task_manager.Dlg_AddPhrase( dlg, "Загляну в другой раз, авось чего появится...", "4", "3", -10000 )
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddAction( "dialogs.break_dialog" )
end

-- [HE-PORT]
function new_task_eliminate_lager_done( dlg, parent )
	if not new_tasks_eliminate[ parent ] then return end
	local random = lua_random( 1, 10 )
	local phr = task_manager.Dlg_AddPhrase( dlg, "Потолкуем насчёт задания?", "0", "", -10000 )
	local phrase_script = phr:GetPhraseScript()

	phr = task_manager.Dlg_AddPhrase( dlg, "Мутанты ликвидированы?", "1", "0", -10000 )
	phrase_script = phr:GetPhraseScript()

	phr = task_manager.Dlg_AddPhrase( dlg, "Всё сделано, мутанты мертвы.", "110", "1", -10000 )
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddPrecondition( "new_quests.eliminate_monsters( 'have_done', \"".. parent .."\" )" )

	phr = task_manager.Dlg_AddPhrase( dlg, gg_give_reward[ random ], "111", "110", -10000 )
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddAction( "new_quests.eliminate_monsters( 'reward', \"".. parent .."\" )" )
	phrase_script:AddAction( "new_quests.eliminate_monsters( 'remove_spot', \"".. parent .."\" )" )

	phr = task_manager.Dlg_AddPhrase( dlg, "Что же... Спасибо и на этом.", "112", "111", -10000 )
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddAction( "dialogs.break_dialog" )

	phr = task_manager.Dlg_AddPhrase( dlg, "В процессе...", "120", "1", -10000 )
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddAction( "dialogs.break_dialog" )
	phrase_script:AddPrecondition( "new_quests.eliminate_monsters( 'not_done', \"".. parent .."\" )" )
end

-- [HE-PORT]
function esc_wolf_eliminate_lager_start( dlg ) new_task_eliminate_lager_start( dlg, "esc_wolf" ) end
-- [HE-PORT]
function esc_wolf_eliminate_lager_done( dlg )  new_task_eliminate_lager_done( dlg, "esc_wolf" )  end

-- [HE-PORT]
function mutants_esc_info_done( num )
	if level.name() ~= "l01_escape" then return end
	local esc_tbl = eliminate_tbl( "esc_wolf" )
	if not esc_tbl then return end
	if gulag_npces_active( { esc_tbl[ num ] } ) == 0 then
		if num == 1 then
			db.actor:give_info_portion( "esc_wolf_1_mutants" )
			monster_spot_on_map( esc_tbl[ 1 ], "remove" )
		end
		if num == 2 then
			db.actor:give_info_portion( "esc_wolf_2_mutants" )
			monster_spot_on_map( esc_tbl[ 2 ], "remove" )
		end
	end
end

-- [HE-PORT]
function esc_1_group() mutants_esc_info_done( 1 ) end
-- [HE-PORT]
function esc_2_group() mutants_esc_info_done( 2 ) end
