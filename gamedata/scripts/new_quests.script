local valuable_arts = {}

function format_voron_text( reward_list )
	local reward_text = ""
	for k, v in pairs( reward_list ) do
		if string.sub( k, 1, 4 ) == "ammo" then
			reward_text = reward_text .. get_inv_name( k ) .. " - ".. v .." пачек;\\n"
		else
			reward_text = reward_text .. get_inv_name( k ) .. " - ".. v .." шт.;\\n"
		end
	end
	return reward_text
end
function get_population( name )
	local strn = name and alife():object( name )
	local g = strn and strn.gulag
	return ( g and g.population_comed ) or 0
end
function gulag_mutants_done( name )
	local t = type( name )
	if t == "string" then 
		return ( gulag_npces_active( { name } ) == 0 ) ~= false
	elseif t == "table" then
		local count = 0
		local num
		for k, v in pairs( name ) do
			num = k
			if type( v ) == "string" then
				if gulag_npces_active( { v } ) == 0 then
					count = count + 1
				end								
			end			
		end
		if count == num then return true else return false end		
	end	
end
function gulag_mutants_have( name )
	local t = type( name )
	if t == "string" then 
		return ( gulag_npces_active( { name } ) > 0 ) ~= false
	elseif t == "table" then
		local count = 0
		local num
		for k, v in pairs( name ) do
			num = k
			if type( v ) == "string" then
				if gulag_npces_active( { v } ) > 0 then
					count = count + 1
				end								
			end			
		end
		if count == num then return true else return false end			
	end	
end
function gulag_mutants_have_not( name )
	return not gulag_mutants_have( name )
end
function gulag_npces_active( p )
	local gulag = xr_gulag.get_gulag_by_name( p[ 1 ] )
	if not gulag then
		return 0
	end
	local val = 0
	for k, v in pairs( gulag.Object ) do
		if ( v == true or ( v:alive() and not ( xr_wounded.is_heavy_wounded_by_id( k ) or xr_wounded.is_psy_wounded_by_id( k ) ) ) ) and gulag.Object_begin_job[ k ] == true then
			val = val + 1
		end
	end
	return val
end
function monster_spot_on_map( name, flag )
	local mob_val_text = ""
	local names = {
		{ " тварь",  " особь",  " мутант"   },
		{ " твари",  " особи",  " мутанта"  },
		{ " тварей", " особей", " мутантов" },
	}
	local t = type( name )
	if t == "string" then 
		local mobj = g_sim:object( name )
		if mobj then
			if flag == "add" then 
				local gulag_val = tostring( get_population( name ) )	
				if 
					gulag_val == 1 then mob_val_text = names[ 1 ][ lua_random( 1, #names ) ] 
				elseif 
					str_in_tab( gulag_val, { 2, 3, 4 } ) then mob_val_text = names[ 2 ][ lua_random( 1, #names ) ] 
				else
					mob_val_text = names[ 3 ][ lua_random( 1, #names ) ]
				end	
				amk.add_spot_on_map( mobj.id, "eliminate_lager_location", "Логово монстров \\nПо последним данным тут обитает: ".. tonumber( gulag_val ) .. mob_val_text .."" )
			end
			if flag == "remove" then
				amk.remove_spot_from_map( mobj.id, "eliminate_lager_location" )					
			end			
		end
	elseif t == "table" then	
        for k, v in pairs( name ) do		
			if type( v ) == "string" then 
				local mobj = g_sim:object( v )
				if mobj then 
					if flag == "add" then 
						local gulag_val = tostring( get_population( v ) )	
						local mob_val_text = ""
							if 
								gulag_val == 1 then mob_val_text = names[ 1 ][ lua_random( 1, #names ) ] 
							elseif 
								str_in_tab( gulag_val, { 2, 3, 4 } ) then mob_val_text = names[ 2 ][ lua_random( 1, #names ) ] 
							else
								mob_val_text = names[ 3 ][ lua_random( 1, #names ) ]
							end
						amk.add_spot_on_map( mobj.id, "eliminate_lager_location", "Логово монстров \\nПо последним данным тут обитает: ".. tonumber( gulag_val ) .. mob_val_text .."" )
					end	
					if flag == "remove" then
						amk.remove_spot_from_map( mobj.id, "eliminate_lager_location" )					
					end
				end	
			end
		end
	end				
end	
function voron_come_when()
	local voron_timer = check_timer( "voron_arts", "new_quests.voron_arts_end()" )
	if voron_timer == nil then return end
	local days = math.round( voron_timer / 24 / 60 )
	if days > 7 then days = 7 end	
	if days <= 1 then 
		db.actor:give_talk_message(
			"Через ".. kotovod.declension( math.round( voron_timer / 60 ), ' час', ' часа', ' часов' ) .." обещают новым заказом обеспечить, тогда и подходи, обсудим.",
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item"
		)	
	else
		db.actor:give_talk_message(
			"Приходи через ".. days .." суток. Может чего-нибудь и придумаем...",
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item"
		)
	end	
end
function voron_generated_items( flag )
    local tbl = xray_vars.load_table( nlc_vars, "tbl_voron_arts", {} )

	if flag == "show" then 
		local voron_timer = check_timer( "voron_arts", "new_quests.voron_arts_end()" )
		
		local days = 
			voron_timer <= 60 and voron_timer 
			or voron_timer <= 1440 and math.round( voron_timer / 60 ) 
			or math.round( voron_timer / 24 / 60 )
			
		local days_text = 
			voron_timer <= 60 and kotovod.declension( days, ' минуту', ' минуты', ' минут' ) 
			or voron_timer <= 1440 and kotovod.declension( days, ' час', ' часа', ' часов' ) 
			or kotovod.declension( days, ' сутки', ' суток', ' суток' )

		local text  = {
			"Для одного человека с Большой земли за " .. days .. days_text .. " необходимо предоставить:",
			"Есть у меня заказик. От ювелиров, между прочим, так не будем расстраивать прекрасных дам, а? Посему надо уложиться за " .. days .. days_text .. "",
			"Есть одно заданьице, сроку - " .. days .. days_text .. ". Заказик от военных, вернее от военно-обязанных учёных - они занимаются какими-то секретными разработками. И нужны им, значится, артефакты:",
			"Недавно заказ пришёл, одна фирма хочет выйти на рынок с новым защитным снаряжением для охотников. За " .. days .. days_text .. " надо бы успеть. Для обеспечения защиты необходимы:",
			"Тут недавно охотнички заходили, заказ оставили. Сам знаешь, есть у них интерес к этому делу, условленный срок - " .. days .. days_text .. "... Вот, что запросили:",
			"Головастикам срочно понадобились материалы для продолжения исследований в области альтернативной энергетики. Уверяют, что они научились генерировать электроэнергию при помощи артефактов. Правда, пока КПД недостаточно высокий. Для наилучших результатов необходимо за " .. days .. days_text .. " доставить:",
			"Одна из компаний за рубежом очень интересуется различными свойствами артефактов. Необходимо успеть за " .. days .. days_text .. ". От них есть заказ на:",	
			"Есть парочка нетерпеливых клиентов, которые хотят испытать новые ощущения, но ждать согласны всего лишь " .. days .. days_text .. ". Вот их заказ:",
			"Один из перекупщиков проявляет интерес к различным артефактам, нужно успеть обеспечить его необходимым за " .. days .. days_text .. "",
		}
		if nlc_vars.voron_reward == nil then nlc_vars.voron_reward = dsh.get_next_random( "voron_generated_items", #text ) end
		
		db.actor:give_talk_message(
			"" .. text[ nlc_vars.voron_reward ] .. "",
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item"
		)					
	
		for k, v in pairs( tbl ) do	
			if game_options.IconsDialogue == false then 
				local colour = "%c[ 255, 255, 255, 255 ]"
				db.actor:give_talk_message(
					"   • " .. colour .. get_inv_name( v ) .. "%c[default]" .. " - 1 шт.",
					"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item"			
				)
			else	
				kotovod.make_picture( v )
			end	
		end	
		local task_texture, task_rect = get_texture_info( "ui_iconsTotal_find_item" )
		local level  		= ( "lvl" .. tostring( nlc_vars.voron_random ) )
		local reward 		= generate_reward[ level ][ nlc_vars.voron_reward ]
		local reward_text   = format_voron_text( reward )
		local reward_money 	= generate_reward[ level ][ 10 ][ 1 ] 
		local money_texture, money_rect = get_texture_info( "ui_iconsTotal_found_money" )
		db.actor:give_talk_message( "За выполнение получишь следующее:", "ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item" )		
		db.actor:give_talk_message( reward_text, task_texture, task_rect, "iconed_trade_info" )
		db.actor:give_talk_message( "Ну, или ".. reward_money .." рублей", money_texture, money_rect, "iconed_trade_info" )		
		return 
	end
	
	if flag == "have" then 
		valuable_arts = {}		-- Вдруг поговорили, но передумали	
		for _, v in pairs( tbl ) do 
			for i, k in pairs( sak_inventory.rucksack ) do		
				if 
							strpos( i,  v, 1, true ) 
					and not strpos( i, "_dyn1d", 1, true )		
					and not strpos( i, "_dyn6d", 1, true )						
				then   	
					local obj = client_obj( k[ 1 ] )	
					if obj and obj:condition() >= 0.5 then
						table.insert( valuable_arts, obj:id() )
						break
					end
				end
			end
		end	
		if #valuable_arts == #tbl then return true end
	end	
	
	if flag == "give" then
		for _, v in pairs( valuable_arts ) do 
			local obj = client_obj( v )
			if obj then 
				misc.release_obj( obj )
				sak.relocate_item( "out", obj:section(), 1 )
			end
		end
		valuable_arts = {}			
		db.actor:disable_info_portion( "val_voron_arts_have" )	
		if nlc_vars.voron_random == 3 or nlc_vars.voron_random == 4 then 
			local count = ( nlc_vars.voron_amount or 0 ) + 1 			
			nlc_vars.voron_amount = count					
		end	
	end
end	
function voron_reward( flag )
	if flag == "item" then 
		local items = generate_reward[ ( "lvl" .. tostring( nlc_vars.voron_random ) ) ][ nlc_vars.voron_reward ]
		sak.create_items( items )
	end
	if flag == "money" then 
		local moneys = generate_reward[ ( "lvl" .. tostring( nlc_vars.voron_random ) ) ][ 10 ][ 1 ]
		sak_dialog.relocate_money( moneys, "in" )			
	end
end
function yan_petrenko_zombies( flag )

	if flag == "have_mutants" then 
		return gulag_mutants_have( "yan_st_stalker1" )
	end

	if flag == "have_not" then
		return gulag_mutants_have_not( "yan_st_stalker1" )
	end

	if flag == "add_spot" then 
		monster_spot_on_map( "yan_st_stalker1", "add" )		
	end
	
	if flag == "remove_spot" then
		monster_spot_on_map( "yan_st_stalker1", "remove" )		
	end	
	
	if flag == "have_done" then
		return gulag_mutants_done( "yan_st_stalker1" )	
	end	
	
	if flag == "not_done" then
		return not gulag_mutants_done( "yan_st_stalker1" )	
	end		
end
