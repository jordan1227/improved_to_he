--Меню настроек геймплея. Используется скриптом ui_mm_opt_main.script

local options = {
	{ section = "ui_mm_section_hud_interface" },
	{"cap_font_scale_y", "InitStatic", {"track_font_scale_y", "InitTrackBar"}, "ui_mm_font_scale_y", "ui_mm_font_scale_y_desc"},
	{"cap_font_scale_x", "InitStatic", {"track_font_scale_x", "InitTrackBar"}, "ui_mm_font_scale_x", "ui_mm_font_scale_x_desc"},
	{"check_3d_pda", "InitCheck", false, "ui_mm_3d_pda", "ui_mm_3d_pda_desc"},
	{"check_3d_scopes", "InitCheck", false, "ui_mm_3d_scopes", "ui_mm_3d_scopes_desc"},
	{"check_tips", "InitCheck", false, "ui_mm_tips", "ui_mm_tips_desc"},
	{"check_crosshair", "InitCheck", false, "ui_mm_show_crosshair", "ui_mm_show_crosshair_desc"},
	{"check_dyn_crosshair", "InitCheck", false, "ui_mm_dyn_crosshair", "ui_mm_dyn_crosshair_desc"},
	{"check_show_weapon", "InitCheck", false, "ui_mm_show_weapon", "ui_mm_show_weapon_desc"},
	{"check_dist", "InitCheck", false, "ui_mm_crosshair_distance", "ui_mm_crosshair_distance_desc"},
	{"check_build_crosshair", "InitCheck", false, "ui_mm_build_crosshair", "ui_mm_build_crosshair_desc"},
	{"check_crosshair_hard", "InitCheck", false, "ui_mm_crosshair_hard", "ui_mm_crosshair_hard_desc"},
	{"check_hide_untradable_items", "InitCheck", false, "ui_mm_g_hide_untradable_items", "ui_mm_g_hide_untradable_items_desc"},
	{"check_show_status_icons", "InitCheck", false, "ui_mm_hud_show_status_icons", "ui_mm_hud_show_status_icons_desc"},
	{"dialog_icons", "InitCheck", false, "ui_mm_dialog_icons", "ui_mm_dialog_icons_desc", true},
	{"magic_box_ui", "InitCheck", false, "ui_mm_magic_box_ui", "ui_mm_magic_box_ui_desc", true},

	{ section = "ui_mm_section_input_camera" },
	{"check_autopause", "InitCheck", false, "ui_mm_keypress_on_start", "ui_mm_keypress_on_start_desc"},
	{"check_aim_toggle", "InitCheck", false, "ui_mm_aim_toggle", "ui_mm_aim_toggle_desc"},
	{"check_switch_slot", "InitCheck", false, "ui_mm_switch_slot", "ui_mm_switch_slot_desc"},
	{"check_disable_cam_inert", "InitCheck", false, "ui_mm_disable_cam_inert", "ui_mm_disable_cam_inert_desc"},
	{"manual_hold_breath_toggle", "InitCheck", false, "ui_mm_manual_hold_breath_toggle", "ui_mm_manual_hold_breath_toggle_desc", true},
	{"visible_body", "InitCheck", false, "ui_mm_visible_body", "ui_mm_visible_body_desc", true},

	{ section = "ui_mm_section_gameplay_effects" },
	{"check_ambient", "InitCheck", false, "ui_mm_ambient", "ui_mm_ambient_desc"},
	{"release_artefacts", "InitCheck", false, "ui_mm_release_artefacts", "ui_mm_release_artefacts_desc", true},
	{"short_story", "InitCheck", false, "ui_mm_short_story", "ui_mm_short_story_desc", true},
	{"sprint_fov", "InitCheck", false, "ui_mm_sprint_fov", "ui_mm_sprint_fov_desc", true},
	{"gravity_anomaly_shake", "InitCheck", false, "ui_mm_gravity_anomaly_shake", "ui_mm_gravity_anomaly_shake_desc", true},
	{"weapon_fire_penalties", "InitCheck", false, "ui_mm_weapon_fire_penalties", "ui_mm_weapon_fire_penalties_desc", true},
	{"ads_edge_dof", "InitCheck", false, "ui_mm_ads_edge_dof", "ui_mm_ads_edge_dof_desc", true}
}
class "opt_gameplay" (CUIWindow)
function opt_gameplay:__init() super()
end

function opt_gameplay:__finalize()
end

function opt_gameplay:InitControls(x, y, xml, handler)
	self:Init(x, y, 738, 416)
	self:SetAutoDelete(true)
	xml:InitFrame("frame", self)
	self.scroll_v = xml:InitScrollView("tab_gameplay:scroll_v", self)

	for i = #options, 1, -1 do
		local row = options[i]
		if row.section then
			local section_id = row.section
			local _st = xml:InitLabel("tab_gameplay:templ_section", self.scroll_v)
			_st:SetText(game.translate_string(section_id))
			handler:Register(_st, "tab_gameplay_section_"..section_id)
			handler:AddCallback("tab_gameplay_section_"..section_id, ui_events.STATIC_FOCUS_RECEIVED, function()
				handler.hint_name:SetText(game.translate_string(section_id))
				handler.hint_caption:SetText(game.translate_string(section_id.."_desc"))
			end)
		else
			local opt, ctr_type, second_element, hint_caption, hint_string, save_to_handler = unpack(row)
			local _st = xml:InitStatic("tab_gameplay:templ_item", self.scroll_v)
			local ctl = xml[ctr_type](xml, "tab_gameplay:"..opt, _st)

			if save_to_handler then
				handler[opt] = ctl
			end

			if second_element then
				xml[second_element[2]](xml, "tab_gameplay:"..second_element[1], _st)
			end

			handler:Register(_st, "tab_gameplay_cap"..opt)
			handler:AddCallback("tab_gameplay_cap"..opt, ui_events.STATIC_FOCUS_RECEIVED, function()
				handler.hint_name:SetText(hint_caption and game.translate_string(hint_caption) or "")
				handler.hint_caption:SetText(hint_string and game.translate_string(hint_string) or "")
			end)

			if opt == "ads_edge_dof" then
				handler:Register(ctl, "gameplay_ads_edge_dof")
				handler:AddCallback("gameplay_ads_edge_dof", ui_events.BUTTON_CLICKED, handler.OnAdsEdgeDofChanged, handler)
			end
		end
	end

	handler.btn_gameplay_default = xml:Init3tButton("tab_gameplay:btn_gameplay_default", self)
	handler:Register(handler.btn_gameplay_default, "btn_gameplay_default")
end