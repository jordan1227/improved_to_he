-- Меню сохранения/загрузки сейвов для Теней Чернобыля.
-- KRodin (c) 2018
-- Собрал из двух скриптов в один, выкинул весь мусор, убрал тормоза.
-- Так же исправлен вылет из-за большого кол-ва сейвов в папке.
-- Сделано специально для использования с движком OGSR.
--
-- Добавлено (перенесено из CS):
--   - Кнопка «Бекап» (button_bkp) — копирует сейв с новым именем
--   - Поле ввода имени (edit_filename) — для переименования при бекапе
--   - Кнопка переключения раскладки RUS/ENG (btn_lang)
--   - Ввод русских букв с клавиатуры в поле имени
--   - Backspace, DEL (очистка поля), Enter (запуск бекапа)
--   - Кнопки «Удалить сохранения» и «Удалить автосохр.» (button_delete_saves / button_delete_autosaves)

-- Таблица русской раскладки для ручного ввода (DIK -> { нижний, верхний })
local keyboard_rus = {
	[  1 ] = { "\xb8", "\xa8" },   [ 16 ] = { "\xe9", "\xc9" },   [ 30 ] = { "\xf4", "\xf4" },   [ 44 ] = { "\xff", "\xdf" },
	[  2 ] = { "1",    "!"    },   [ 17 ] = { "\xf6", "\xd6" },   [ 31 ] = { "\xfb", "\xdb" },   [ 45 ] = { "\xf7", "\xd7" },
	[  3 ] = { "2",    "'"    },   [ 18 ] = { "\xf3", "\xd3" },   [ 32 ] = { "\xe2", "\xc2" },   [ 46 ] = { "\xf1", "\xd1" },
	[  4 ] = { "3",    "\xb9" },   [ 19 ] = { "\xea", "\xca" },   [ 33 ] = { "\xe0", "\xc0" },   [ 47 ] = { "\xec", "\xcc" },
	[  5 ] = { "4",    ";"    },   [ 20 ] = { "\xe5", "\xc5" },   [ 34 ] = { "\xef", "\xcf" },   [ 48 ] = { "\xe8", "\xc8" },
	[  6 ] = { "5",    "%"    },   [ 21 ] = { "\xed", "\xcd" },   [ 35 ] = { "\xf0", "\xd0" },   [ 49 ] = { "\xf2", "\xd2" },
	[  7 ] = { "6",    ":"    },   [ 22 ] = { "\xe3", "\xc3" },   [ 36 ] = { "\xee", "\xce" },   [ 50 ] = { "\xfc", "\xdc" },
	[  8 ] = { "7",    "?"    },   [ 23 ] = { "\xf8", "\xd8" },   [ 37 ] = { "\xeb", "\xcb" },   [ 51 ] = { "\xe1", "\xc1" },
	[  9 ] = { "8",    "*"    },   [ 24 ] = { "\xf9", "\xd9" },   [ 38 ] = { "\xe4", "\xc4" },   [ 52 ] = { "\xfe", "\xde" },
	[ 10 ] = { "9",    "("    },   [ 25 ] = { "\xe7", "\xc7" },   [ 39 ] = { "\xe6", "\xc6" },   [ 57 ] = { " ",   " "    },
	[ 11 ] = { "0",    ")"    },   [ 26 ] = { "\xf5", "\xd5" },   [ 40 ] = { "\xfd", "\xdd" },
	[ 12 ] = { "-",    "_"    },   [ 27 ] = { "\xfa", "\xda" },
}

-- ============================================================
-- Вспомогательные функции (локальные, уровень модуля)
-- ============================================================

function fill_savedgames_list(wnd)
	if wnd.is_save_dlg then
		local edit_box = wnd:GetEditBox("edit_filename")
		edit_box:SetText("")
	else
		local picture = wnd:GetStatic("static_pict")
		wnd.file_caption:SetText("")
		wnd.file_data:SetText("")
		picture:ResetOriginalRect()
		picture:InitTexture("ui\\ui_noise")
	end

	local list_box = wnd:GetListWnd("list_window")
	if list_box:GetSize() > 0 then
		list_box:RemoveAll()
		list_box:SetSelectedItem(-1)
	end

	local flist = getFS():file_list_open_ex("$game_saves$", FS.FS_ListFiles + FS.FS_ClampExt + FS.FS_RootOnly + FS.FS_NoLower, "*.sav")
	flist:Sort(FS.FS_sort_by_modif_down)
	for file in flist:GetAll() do
		wnd:AddItemToList(file:NameFull(), file:Modif())
	end
end

local function delete_save_game(filename)
	local f = getFS()
	f:file_delete("$game_saves$", filename .. ".sav")
	if f:exist("$game_saves$", filename .. ".dds") then
		f:file_delete("$game_saves$", filename .. ".dds")
	end
end

-- Копирует сейв (и скриншот .dds если есть) под новым именем
local function bkp_save_game(filename, filename_new)
	local f       = getFS()
	local src_sav = f:update_path("$game_saves$", filename     .. ".sav")
	local src_dds = f:update_path("$game_saves$", filename     .. ".dds")
	local dst_sav = f:update_path("$game_saves$", filename_new .. ".sav")
	local dst_dds = f:update_path("$game_saves$", filename_new .. ".dds")
	f:file_copy(src_sav, dst_sav)
	if f:exist("$game_saves$", filename .. ".dds") then
		f:file_copy(src_dds, dst_dds)
	end
end

local function AddTimeDigit(dig)
	return dig > 9 and tostring(dig) or ("0" .. dig)
end

local function GetDaysByMonth(month)
	local days_left     = 0
	local days_in_month = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }
	for i = 1, month - 1 do
		days_left = days_left + days_in_month[i]
	end
	return days_left
end

local function TimeOfDay(hour)
    if     hour == 0                  then return "Полночь"
    elseif hour >= 22 or hour <= 4    then return "Ночь"
    elseif hour >= 5  and hour <= 11  then return "Утро"
    elseif hour == 12                 then return "Полдень"
    elseif hour >= 13 and hour <= 16  then return "День"
    elseif hour >= 17                 then return "Вечер"
    end
end

local function file_data(fname)
    if getFS():exist("$game_saves$", fname .. ".sav") then
        local sg = CSavedGameWrapper(fname)
        local y, m, d, h, min, sec, ms = sg:game_time():get()
        local days = GetDaysByMonth(m) - GetDaysByMonth(5) + d
		local result =
			game.translate_string(sg:level_name()) .. "\\n" ..
			game.translate_string("st_days_in_zone") .. ": " .. days .. "\\n" ..
			--TimeOfDay(h) .. "\\n" ..
			"Дата: " .. AddTimeDigit(d) .. "." .. AddTimeDigit(m) .. "." .. y .. "\\n" ..
			game.translate_string("ui_inv_time") .. ": " .. AddTimeDigit(h) .. ":" .. AddTimeDigit(min) .. "\\n" ..
			string.format("%s: %d%%", game.translate_string("ui_inv_health"), sg:actor_health() * 100)
        return result
    else
        return "no file data"
    end
end

-- Генерирует имя бекапа из данных сейва (используется если поле пустое)
local function make_bkp_name(fname)
	local sg           = CSavedGameWrapper(fname)
	local y, m, d, h, min, sec, ms = sg:game_time():get()
	local days         = GetDaysByMonth(m) - GetDaysByMonth(5) + d
	local levname      = game.translate_string(sg:level_name())
	local name         = string.format("%d \xf1\xf3\xf2\xea\xe8 %02d.%02d [%s]", days, h, min, levname)
	-- Если нет скриншота — это автосейв, помечаем
	if not getFS():exist("$game_saves$", fname .. ".dds") then
		name = name .. "_auto"
	end
	return name
end

-- ============================================================
-- Элемент списка
-- ============================================================

class "save_load_item" (CUIListItemEx)
function save_load_item:__init() super()
	self:SetWndRect(0, 0, 430, 22)

	self.fn = CUIStatic()
	self.fn:SetAutoDelete(true)
	self:AttachChild(self.fn)
	self.fn:SetWndRect(0, 0, 230, 22)
	self.fn:SetText("filename")
	self.fn:SetFont(GetFontLetterica18Russian())
	self.fn:SetTextColor(255, 216, 186, 140)
	self.fn:SetTextAlign(CGameFont.alLeft)

	self.fage = CUIStatic()
	self.fage:SetAutoDelete(true)
	self:AttachChild(self.fage)
	self.fage:SetWndRect(260, 0, 150, 22)
	self.fage:SetText("fileage")
	self.fage:SetFont(GetFontLetterica16Russian())
	self.fage:SetTextColor(255, 216, 186, 140)
	self.fage:SetTextAlign(CGameFont.alRight)
end
function save_load_item:__finalize() end

-- ============================================================
-- Диалог сохранения/загрузки
-- ============================================================

class "save_load_dialog" (CUIScriptWnd)
function save_load_dialog:__init(is_save_dlg) super()
	self.is_save_dlg  = is_save_dlg
	self.msgbox_id    = 0
	-- Состояние поля ввода имени (для диалога загрузки)
	self.edit_text    = ""
	self.lang         = "RUS"
	self.shiftPressed = false
	self.need_lang    = false

	if self.is_save_dlg then
		self:InitControlsSave()
	else
		self:InitControlsLoad()
	end
	self:InitCallBacks()
	self:MakeBackground()
end

function save_load_dialog:MakeBackground()
	local f     = getFS()
	local flist = f:file_list_open_ex("$game_saves$", FS.FS_ListFiles + FS.FS_ClampExt + FS.FS_RootOnly + FS.FS_NoLower, "*.sav")
	local f_cnt = flist:Size()
	if f_cnt > 0 then
		flist:Sort(FS.FS_sort_by_modif_down)
		local file    = flist:GetAt(0)
		local fname   = file:NameFull()
		local sg      = CSavedGameWrapper(fname)
		local level   = sg:level_name()
		local picture = self:GetStatic("static_background")
		picture:InitTexture("ui\\ui_load_dialog\\" .. level .. "_background")
	end
end

function save_load_dialog:__finalize() end

-- ------------------------------------------------------------
-- InitControls — диалог сохранения
-- ------------------------------------------------------------
function save_load_dialog:InitControlsSave()
	self:Init(0, 0, 1024, 768)

	local xml  = CScriptXmlInit()
	xml:ParseFile("ui_mm_save_dlg.xml")

	local ctrl = xml:InitStatic("background", self)
	ctrl:SetWindowName("static_background")

	self.form = xml:InitStatic("form", self)
	xml:InitStatic("form:caption", self.form)

	ctrl = xml:InitEditBox("form:edit", self.form)
	self:Register(ctrl, "edit_filename")

	xml:InitFrame("form:list_frame", self.form)

	ctrl = xml:InitList("form:list", self.form)
	ctrl:ShowSelectedItem(true)
	self:Register(ctrl, "list_window")

	ctrl = xml:Init3tButton("form:btn_save", self.form)
	self:Register(ctrl, "button_ok")

	ctrl = xml:Init3tButton("form:btn_delete", self.form)
	self:Register(ctrl, "button_del")

	ctrl = xml:Init3tButton("form:btn_cancel", self.form)
	self:Register(ctrl, "button_cancel")

	self.message_box = CUIMessageBoxEx()
	self:Register(self.message_box, "message_box")
end

-- ------------------------------------------------------------
-- InitControls — диалог загрузки
-- (добавлены: edit_filename, btn_bkp, btn_lang,
--             button_delete_saves, button_delete_autosaves)
-- ------------------------------------------------------------
function save_load_dialog:InitControlsLoad()
	self:Init(0, 0, 1024, 768)

	local xml  = CScriptXmlInit()
	xml:ParseFile("ui_mm_load_dlg.xml")

	-- Фон
	local ctrl = xml:InitStatic("background", self)
	ctrl:SetWindowName("static_background")

	-- Инфо-панель с чёрной подложкой
	local info_wnd = xml:InitStatic("info", self)

	-- Превью — дочерний элемент info, рисуется поверх подложки
	xml:InitStatic("info:picture", info_wnd):SetWindowName("static_pict")

	-- Текстовые поля
	self.file_caption = xml:InitStatic("info:file_caption", info_wnd)
	self.file_data    = xml:InitStatic("info:file_data",    info_wnd)

	-- Список сейвов
	local file_list = xml:InitStatic("file_list", self)
	xml:InitFrame("file_list:list_frame", file_list)
	ctrl = xml:InitList("file_list:list", file_list)
	ctrl:ShowSelectedItem(true)
	self:Register(ctrl, "list_window")

	-- Поле ввода имени для бекапа
	ctrl = xml:InitEditBox("edit", self)
	self:Register(ctrl, "edit_filename")

	-- Кнопки
	ctrl = xml:Init3tButton("btn_load", self)
	self:Register(ctrl, "button_load")

	ctrl = xml:Init3tButton("btn_delete", self)
	self:Register(ctrl, "button_del")

	ctrl = xml:Init3tButton("btn_cancel", self)
	self:Register(ctrl, "button_back")

	ctrl = xml:Init3tButton("btn_bkp", self)
	self:Register(ctrl, "button_bkp")

	ctrl = xml:Init3tButton("button_delete_saves", self)
	self:Register(ctrl, "button_delete_saves")

	-- Кнопка раскладки
	self.btn_lang = CUIButton()
	self.btn_lang:Init("ui\\ui_hud", 55, 687, 37, 25)
	self.btn_lang:SetText(self.lang)
	self.btn_lang:SetTextAlign(CGameFont.alCenter)
	self.btn_lang:SetTextY(1)
	self.btn_lang:SetTextColor(255, 240, 165, 25)
	self.btn_lang:SetOriginalRect(65, 704, 37, 25)
	self:Register(self.btn_lang, "btn_lang")
	self:AttachChild(self.btn_lang)

	self.message_box = CUIMessageBoxEx()
	self:Register(self.message_box, "message_box")
end

-- ------------------------------------------------------------
-- Коллбеки
-- ------------------------------------------------------------
function save_load_dialog:InitCallBacks()
	self:AddCallback("list_window", ui_events.LIST_ITEM_CLICKED,       self.OnListItemClicked, self)
	self:AddCallback("button_del",  ui_events.BUTTON_CLICKED,          self.OnButton_del_clicked, self)
	self:AddCallback("message_box", ui_events.MESSAGE_BOX_YES_CLICKED, self.OnMsgYes, self)

	if self.is_save_dlg then
		self:AddCallback("button_ok",     ui_events.BUTTON_CLICKED, self.OnButton_ok_clicked,   self)
		self:AddCallback("button_cancel", ui_events.BUTTON_CLICKED, self.OnButton_back_clicked, self)
	else
		self:AddCallback("button_load",   ui_events.BUTTON_CLICKED,            self.OnButton_ok_clicked,          self)
		self:AddCallback("button_back",   ui_events.BUTTON_CLICKED,            self.OnButton_back_clicked,        self)
		self:AddCallback("button_bkp",    ui_events.BUTTON_CLICKED,            self.OnButton_bkp_clicked,         self)
		self:AddCallback("button_delete_saves",     ui_events.BUTTON_CLICKED,  self.OnButtonDeleteSaves,          self)
		self:AddCallback("btn_lang",      ui_events.BUTTON_DOWN,               self.ClickBtnLang,                 self)
		self:AddCallback("message_box",   ui_events.MESSAGE_BOX_OK_CLICKED,    self.OnMsgYes,                     self)
		self:AddCallback("list_window",   ui_events.WINDOW_LBUTTON_DB_CLICK,   self.OnButton_ok_clicked,          self)
	end
end

-- ------------------------------------------------------------
-- Клик по элементу списка
-- ------------------------------------------------------------
function save_load_dialog:OnListItemClicked()
	if self.is_save_dlg then
		self:OnListItemClickedSave()
	else
		self:OnListItemClickedLoad()
	end
end

function save_load_dialog:OnListItemClickedSave()
	local list_box = self:GetListWnd("list_window")
	local edit_box = self:GetEditBox("edit_filename")
	edit_box:SetText("")
	if list_box:GetSize() == 0 then return end
	local item = list_box:GetItem(list_box:GetFocusedItem())
	if not item then return end
	edit_box:SetText(item.fn:GetText())
end

function save_load_dialog:OnListItemClickedLoad()
	local list_box = self:GetListWnd("list_window")
	local picture  = self:GetStatic("static_pict")

	self.file_caption:SetText("")
	self.file_data:SetText("")
	picture:ResetOriginalRect()
	picture:InitTexture("ui\\ui_noise")

	-- Синхронизируем edit_text с полем ввода при смене выбора
	local edit_box = self:GetEditBox("edit_filename")
	edit_box:SetText("")
	self.edit_text = ""

	if list_box:GetSize() == 0 then return end

	local itm_index = list_box:GetSelectedItem()
	local item      = list_box:GetItem(itm_index)
	if not item then return end

	local item_text = item.fn:GetText()
	self.file_caption:SetText(item_text)
	self.file_data:SetText(file_data(item_text))

	if not getFS():exist("$game_saves$", item_text .. ".sav") then
		list_box:RemoveItem(itm_index)
		return
	end

	if getFS():exist("$game_saves$", item_text .. ".dds") then
		picture:ResetOriginalRect()
		picture:InitTexture(item_text)
	end
end

-- ------------------------------------------------------------
-- Бекап сейва
-- ------------------------------------------------------------
function save_load_dialog:OnButton_bkp_clicked()
	local list = self:GetListWnd("list_window")
	if list:GetSize() == 0 then return end
	local index = list:GetSelectedItem()
	if index == -1 then return end

	local fname = list:GetItem(index).fn:GetText()
	-- [HE-PORT]
	local edit_box = self:GetEditBox("edit_filename")
	local fname_new = ""
	if edit_box then
		local raw = edit_box:GetText()
		if raw and raw ~= "" then
			fname_new = raw:clear():gsub("[%(%)]*", ""):trim()
		end
	end
	if (not fname_new or fname_new == "") and self.edit_text and self.edit_text ~= "" then
		fname_new = self.edit_text
	end

	if string.len(fname_new) == 0 or getFS():exist("$game_saves$", fname_new .. ".sav") then
		fname_new = make_bkp_name(fname)
	end

	bkp_save_game(fname, fname_new)

	self.edit_text = ""
	if edit_box then edit_box:SetText("") end
	fill_savedgames_list(self)
end

-- ------------------------------------------------------------
-- Удаление выбранного сейва
-- ------------------------------------------------------------
function save_load_dialog:delete_selected_file()
	local list = self:GetListWnd("list_window")
	if list:GetSize() == 0 then return end
	local index = list:GetSelectedItem()
	if index == -1 then return end
	local filename = list:GetItem(index).fn:GetText()
	delete_save_game(filename)
	list:RemoveItem(index)
	self:OnListItemClicked()
end

-- ------------------------------------------------------------
-- Удаление лишних сохранений (все, кроме последних N)
-- ------------------------------------------------------------
--[[
function save_load_dialog:OnButtonDeleteSaves()
	self.msgbox_id = 5
	self.message_box:Init("message_box_delete_file_name")
	self:GetHolder():start_stop_menu(self.message_box, true)
end
]]--

function save_load_dialog:OnButtonDeleteSaves()
	local list = self:GetListWnd( "list_window" )
	local last_saves_count = game_options and game_options.LastSavesCount or 5
	if 
		list:GetSize() <= last_saves_count 
	then 
		local not_enough = string.gsub( game.translate_string( "ui_mm_not_enough_saves" ), "%$cnt", tostring( last_saves_count ) )
		self.message_box:Init( "message_box_not_enough_saves" )
		self.message_box:SetText( not_enough )
		self:GetHolder():start_stop_menu( self.message_box, true )	
		return 
	end

	self.msgbox_id = 5
	local text = string.gsub( game.translate_string( "ui_mm_delete_saves_box"), "%$cnt", tostring( last_saves_count ) )
	self.message_box:Init( "message_box_delete_file_name" )
	self.message_box:SetText( text )
	self:GetHolder():start_stop_menu( self.message_box, true )
end

function save_load_dialog:DeleteExcessFiles()
	local last_saves_count = game_options and game_options.LastSavesCount or 5
	local fs    = getFS()
	local flist = fs:file_list_open_ex("$game_saves$", FS.FS_ListFiles + FS.FS_ClampExt + FS.FS_RootOnly + FS.FS_NoLower, "*.sav")
	local f_cnt = flist:Size()
	if f_cnt <= last_saves_count then return end
	flist:Sort(FS.FS_sort_by_modif_down)
	for it = last_saves_count, f_cnt - 1 do
		local file_name = flist:GetAt(it):NameFull()
		local dds_name  = file_name .. ".dds"
		local sav_name  = file_name .. ".sav"
		if fs:exist("$game_saves$", sav_name) then fs:file_delete("$game_saves$", sav_name) end
		if fs:exist("$game_saves$", dds_name) then fs:file_delete("$game_saves$", dds_name) end
	end
	fill_savedgames_list(self)
end

-- ------------------------------------------------------------
-- Загрузка сейва
-- ------------------------------------------------------------
function save_load_dialog:load_game_internal()
	local list = self:GetListWnd("list_window")
	if list:GetSize() == 0 then return end
	local index = list:GetSelectedItem()
	if index == -1 then return end
	local fname = list:GetItem(index).fn:GetText()
	if not alife() then
		cmd("disconnect")
		cmd("start server(" .. fname .. "/single/alife/load)")
	else
		cmd("load " .. fname)
	end
	self:OnButton_back_clicked()
end

function save_load_dialog:SaveFile(fileName)
	cmd("save " .. fileName)
end

-- ------------------------------------------------------------
-- OnMsgYes — обрабатывает все msgbox_id
-- ------------------------------------------------------------
function save_load_dialog:OnMsgYes()
	if self.is_save_dlg then
		if self.msgbox_id == 1 then
			self:SaveFile(self.new_save)
			self:OnButton_back_clicked()
		elseif self.msgbox_id == 2 then
			self:delete_selected_file()
		end
	else
		if self.msgbox_id == 1 then
			self:delete_selected_file()
		elseif self.msgbox_id == 2 then
			self:load_game_internal()
		elseif self.msgbox_id == 5 then
			self:DeleteExcessFiles()
		end
	end
	self.msgbox_id = 0
end

-- ------------------------------------------------------------
-- Кнопки OK / Back / Delete
-- ------------------------------------------------------------
function save_load_dialog:OnButton_ok_clicked()
	if self.is_save_dlg then
		self:OnButton_save_clicked()
	else
		self:OnButton_load_clicked()
	end
end

function save_load_dialog:OnButton_save_clicked()
	local edit_box = self:GetEditBox("edit_filename")
	self.new_save  = edit_box:GetText():clear():gsub('[%(%)]*', ""):trim()
	if self.new_save:len() == 0 then
		self.msgbox_id = 0
		self.message_box:Init("message_box_empty_file_name")
		self:GetHolder():start_stop_menu(self.message_box, true)
		return
	end
	if getFS():exist("$game_saves$", self.new_save .. ".sav") then
		self.msgbox_id = 1
		self.message_box:Init("message_box_file_already_exist")
		self:GetHolder():start_stop_menu(self.message_box, true)
		return
	end
	self:SaveFile(self.new_save)
	self:OnButton_back_clicked()
end

function save_load_dialog:OnButton_load_clicked()
	local list = self:GetListWnd("list_window")
	if list:GetSize() == 0 then return end
	local index = list:GetSelectedItem()
	if index == -1 then return end
	local fname = list:GetItem(index).fn:GetText()
	if valid_saved_game(fname) then
		if level.present() and db.actor_proxy.online and db.actor:alive() then
			self.msgbox_id = 2
			self.message_box:Init("message_box_confirm_load_save")
			self:GetHolder():start_stop_menu(self.message_box, true)
		else
			self:load_game_internal()
		end
	else
		self.msgbox_id = 0
		self.message_box:Init("message_box_invalid_saved_game")
		self:GetHolder():start_stop_menu(self.message_box, true)
	end
end

function save_load_dialog:OnButton_back_clicked()
	self:GetHolder():start_stop_menu(self, true)
	self.owner:Show(true)
end

function save_load_dialog:OnButton_del_clicked()
	local list = self:GetListWnd("list_window")
	if list:GetSize() == 0 then return end
	local index = list:GetSelectedItem()
	if index == -1 then return end
	self.msgbox_id = self.is_save_dlg and 2 or 1
	self.message_box:Init("message_box_delete_file_name")
	self:GetHolder():start_stop_menu(self.message_box, true)
end

-- ------------------------------------------------------------
-- Переключение раскладки RUS/ENG
-- ------------------------------------------------------------
function save_load_dialog:ClickBtnLang()
	self.lang = (self.lang == "RUS" and "ENG") or "RUS"
	self.btn_lang:SetText(self.lang)
end

-- ------------------------------------------------------------
-- Ввод символов в поле имени (только для диалога загрузки)
-- ------------------------------------------------------------
function save_load_dialog:AppendChar(letter)
	local edit_box = self:GetEditBox("edit_filename")
	if string.len(self.edit_text) >= 35 then return end
	self.edit_text = self.edit_text .. tostring(letter)
	edit_box:SetText(self.edit_text)
end

function save_load_dialog:Backspace()
	if not self.edit_text or self.edit_text == "" then return end
	self.edit_text = string.sub(self.edit_text, 1, string.len(self.edit_text) - 1)
	self:GetEditBox("edit_filename"):SetText(self.edit_text)
end

-- ------------------------------------------------------------
-- Клавиатура
-- ------------------------------------------------------------
function save_load_dialog:OnKeyboard(dik, keyboard_action)
	CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)

	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then

		if self.is_save_dlg then
			-- В диалоге сохранения — только Enter для сохранения и Escape
			if dik == DIK_keys.DIK_RETURN or dik == DIK_keys.DIK_NUMPADENTER then
				self:OnButton_ok_clicked()
			elseif dik == DIK_keys.DIK_DELETE then
				self:OnButton_del_clicked()
			elseif dik_to_bind(dik) == key_bindings.kQUIT then
				self:OnButton_back_clicked()
			end
		else
			-- В диалоге загрузки — полный ввод имени для бекапа
			if dik == DIK_keys.DIK_RETURN or dik == DIK_keys.DIK_NUMPADENTER then
				-- Enter запускает бекап
				self:OnButton_bkp_clicked()
				self.edit_text = ""

			elseif dik == DIK_keys.DIK_DELETE then
				-- DEL очищает поле ввода
				self:GetEditBox("edit_filename"):SetText("")
				self.edit_text = ""

			elseif dik == DIK_keys.DIK_BACK then
				self:Backspace()

			elseif dik == DIK_keys.DIK_LMENU then
				self.need_lang = true

			elseif dik == DIK_keys.DIK_CAPITAL and self.need_lang then
				self.need_lang = false
				self:ClickBtnLang()

			elseif dik == DIK_keys.DIK_LSHIFT or dik == DIK_keys.DIK_RSHIFT then
				self.shiftPressed = not self.shiftPressed

			elseif dik_to_bind(dik) == key_bindings.kQUIT then
				self:OnButton_back_clicked()

			elseif self.lang == "RUS" and keyboard_rus[dik] then
				-- Ввод русских букв
				local ch = self.shiftPressed and keyboard_rus[dik][2] or keyboard_rus[dik][1]
				self:AppendChar(ch)
			end
		end
	end

	return true
end

-- ------------------------------------------------------------
-- Добавление элемента в список
-- ------------------------------------------------------------
function save_load_dialog:AddItemToList(file_name, date_time)
	local itm = save_load_item()
	itm.fn:SetText(file_name)
	itm.fage:SetText(date_time)
	self:GetListWnd("list_window"):AddItem(itm)
end
