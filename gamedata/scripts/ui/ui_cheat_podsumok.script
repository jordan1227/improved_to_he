--����������� ������ � ���������� �� �������
-------------------------------------------------------------------------
function load_record(tbl, index) -- ������������� �������� ���� "������, ����������"
 if not tbl then return "?", 0 end
 local rec = tbl[index]
 if not rec then return "?", 0 end
 if rec.sect ~= nil then
    return rec.sect, rec.count 
 else
    for sect, count in pairs(rec) do
      return sect, count
    end
 end   
 return "?", 0
end



function pouch_dialog:set_btn_n(btn_num)
    self:del_windows(btn_num, btn_num)

    -- [HE-PORT] HD rects for bottom seats 1-5 (do NOT touch pouch icons here)
    local rects = { }
    rects[1] = {
        { 46,349,43,35  },
        { 106,349,43,35 },
        { 166,349,43,35 },
        { 224,349,43,35 },
        { 307,349,43,35 }
    }
    rects[2] = {
        { 33,349,53,35 },
        { 93,349,53,35 },
        { 152,349,53,35 },
        { 211,349,53,35 },
        { 293,349,53,35 }
    }

    if btn_num < 6 then
        local info_t = inv_items
        local n_rec = btn_num
        if btn_num == 5 then
            info_t = inv_items_heavy
            n_rec  = 1
        end
        local sect, count = load_record(info_t, n_rec)
        if count == 0 then return end
        local ik_t = vergas_lib.set_pr_from_config(sect, "inv_grid_width")
        if ik_t ~= 1 and ik_t ~= 2 then ik_t = 1 end
        local rect = rects[ik_t][btn_num]
        return self:add_static("btn_"..tostring(btn_num), rect, count, nil, "", sect)
    end

    -- btn 6: single pouch slot; icon centered in the middle black seat
    self:remove_static("btn_6_icon")
    self:remove_static("btn_6_1")
    self:remove_static("btn_6_2")
    local pouch = pouch_content(true)
    if pouch == nil then return end
    local sect, count = load_record(pouch, 1)
    if count == 0 or sect == "?" then return end
    local ik_t = vergas_lib.set_pr_from_config(sect, "inv_grid_width")
    if ik_t ~= 1 and ik_t ~= 2 then ik_t = 1 end
    -- center of glass/dialog content (~196); match icon width 43/53
    local icon_w = (ik_t == 2) and 53 or 43
    local cx = 196
    local rect = { cx - math.floor(icon_w / 2), 275, icon_w, 35 }
    self:add_static("btn_6_icon", rect, count, nil, "", sect)
end

function pouch_dialog:btn_n(btn_num)
	local info_t = inv_items 
	local n_rec = btn_num
	   
	if btn_num == 5 then
		info_t = inv_items_heavy
		n_rec  = 1
	elseif btn_num == 6 then
		info_t = pouch_content(true)
		n_rec = 1
	end

	local names = { "ui_btn_4", "ui_btn_5", "ui_btn_5", "ui_btn_6" }
	local rects = {
{ 30,349,53,36 },
{ 89,349,53,36 },
{ 149,349,53,36 },
{ 209,349,53,36 },
{ 280,349,80,36 },
}

	local sect, count = load_record(info_t, n_rec)
	if count == 0 then return end

	self:set_click(btn_num)
	if click == 1 then            -- ������ ����
		-- ����������� ������
		self:set_static_colour( rects[btn_num], names[btn_num] )
		self:set_btn_n(btn_num)
	else                  -- ������ ����
		self:del_windows_colour()
		old_click = 0
		-- ��������� �������� ����������� � ��������
		self:take_in_podsumok(btn_num)
		self:set_btn_n(btn_num)
	end
end


function pouch_dialog:btn_1()            -- ������ 1
  button = 1
   self:btn_n(1)
end

function pouch_dialog:btn_2()            -- ������ 2
   button = 2
   self:btn_n(2)
end

function pouch_dialog:btn_3()            -- ������ 3
   button = 3
   self:btn_n(3)
end

function pouch_dialog:btn_4()            -- ������ 4 
   button = 4
   self:btn_n(4) 
end

function pouch_dialog:btn_5()            -- ������� ������
	local sect, count = load_record(inv_items_heavy, 1)
	button = 5
	if count ~= 0 then
		self:set_click(5)
		if click == 1 then            	-- ������ ����
			--����������� ������
			self:set_static_colour( {405,352,143,33} ,"ui_btn_3")
			self:set_btn_n(5)
		else                  			-- ������ ����
			self:del_windows_colour()
			old_click = 0
			self:take_in_podsumok(5)
			self:del_windows(5, 5)
			self:set_btn_n(5)
		end
	end
end



function pouch_dialog:btn_6_1()
    self:btn_empty(1)
end

function pouch_dialog:btn_6_2()
    -- visual seat for wide icons; data always lives in pouch slot 1
    self:btn_empty(1)
end
function pouch_dialog:set_click(j)
	--������ ������ �� ������� �������� ������

	if old_click == 0 then    -- �� ������� �� �������
		click = 1        -- ������ j ������ ����
	elseif old_click == j  then  -- ������ j ��� ��������
		click = 2        -- ������ j ������ ����
	elseif (old_click ~= j) and (old_click ~= 0)  then   -- ������� �� ������ ������
		click = 1
	end

	old_click = j
end

function pouch_dialog:set_static_colour(rect, textr)
  self:del_windows_colour()
  self:add_static("wnd_colour", rect, "", textr)
end

