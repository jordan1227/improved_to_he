	["green"]  = { 255, 0, 128, 0 },
	["yellow"] = { 255, 186, 149, 0 },
	["red"]    = { 255, 255, 0, 0 },
}

-- { option id, control, restart prompt, hint color, caption, description }
-- Restart prompt 1: the value changes compiled shaders, so it applies after a game restart.
-- Resolution only sizes render targets: the engine restarts the renderer itself on Accept.
