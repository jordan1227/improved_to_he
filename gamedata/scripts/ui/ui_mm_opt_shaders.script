-- Reset to defaults ( Defaults button ): SSS 23 effects on at their default quality. The switches
-- need a game restart ( the main dialog shows the prompt ). Values match xrRender_console.cpp.
local shaders_defaults = {
	r_ao_mode            = "st_ssfx_ao",
	r2_ssao              = "st_opt_high",
	ssfx_indirect_light  = "on",
	ssfx_sss_enable      = "on",
	ssfx_ao_resolution   = "1",
	ssfx_ao_intensity    = "1",
	ssfx_ao_radius       = "2.5",
	ssfx_il_resolution   = "6",
	ssfx_il_quality      = "3",
	ssfx_il_intensity    = "1",
	ssfx_il_flashlight   = "1",
	ssfx_sss_quality     = "2",
	ssfx_sss_lights      = "1",
	ssfx_sss_length      = "1",
	ssfx_flora_variation = "1",
	ssfx_water_enable    = "on",
	ssfx_water_resolution = "2",
	ssfx_water_quality   = "2",
	ssfx_water_parallax  = "2",
	ssfx_water_blur      = "0.8",
	ssfx_water_reflection = "1",
	ssfx_ssr_enable      = "on",
	ssfx_ssr_blur        = "0.5",
	ssfx_ssr_dry         = "0",
	ssfx_volumetric_resolution = "2",
	ssfx_fog_scattering  = "0.5",
	ssfx_tree_variation  = "1",
	ssfx_foliage_mask    = "off",
	ssfx_glass_enable    = "on",
	ssfx_spec_occlusion  = "1",
	ssfx_ao_direct       = "0.3",
	ssfx_ssr_resolution  = "1",
	ssfx_fog_sun         = "0.5",
	ssfx_ground_mist     = "0.5",
	ssfx_sunshafts       = "1",
	ssfx_rain_beams      = "on",
	ssfx_terrain_grass_slope = "0.5",
	ssfx_look            = "st_ssfx_look_nlc",
	ssfx_contrast        = "1",
	ssfx_color_r         = "1",
	ssfx_color_g         = "1",
	ssfx_color_b         = "1",
	ssfx_wind_gusts      = "0.5",
	ssfx_bloom_hud       = "0.5",
	ssfx_cloud_shadows   = "1",
	ssfx_step_ripples    = "1",
	ssfx_spec_aa         = "on",
	ssfx_mblur_objects   = "off",
	ssfx_compare         = "off",
	ssfx_effects_off     = "off",
}

function reset_to_defaults()
	local con = get_console()
	for cmd_name, value in pairs(shaders_defaults) do
		con:execute(cmd_name .. " " .. value)
	end
end

local control_init_funs = {
	["track"] = "InitTrackBar",
	["list"]  = "InitComboBox",
	["check"] = "InitCheck",
}

class "opt_shaders" (CUIWindow)
function opt_shaders:__init() super()
end

function opt_shaders:__finalize()
end

function opt_shaders:InitControls(x, y, xml, handler)
	self:Init(x, y, 738, 416)
	self:SetAutoDelete(true)

	xml:InitFrame("frame", self)
	self.scroll_v = xml:InitScrollView("tab_shaders:scroll_v", self)

	-- Reverse order: the scroll view uses flip_vert="1" ( see ui_mm_opt_video_adv.script )
	for i = #shaders_opt_params, 1, -1 do
		local row = shaders_opt_params[i]
		if row.section then
			local section_id = row.section
			local _st = xml:InitLabel("tab_shaders:templ_section", self.scroll_v)
			_st:SetText(game.translate_string(section_id))
			handler:Register(_st, "tab_shaders_section_"..section_id)
			handler:AddCallback("tab_shaders_section_"..section_id, ui_events.STATIC_FOCUS_RECEIVED, function()
				handler.hint_name:SetText(game.translate_string(section_id))
				handler.hint_caption:SetText(game.translate_string(section_id.."_desc"))
			end)
		else
			local opt, ctr_type, need_restart, color, hint_caption, hint_string = unpack(row)

			local _st = xml:InitStatic("tab_shaders:templ_item", self.scroll_v)
			local _st2 = xml:InitStatic("tab_shaders:cap_"..opt, _st)
			local ctl = xml[control_init_funs[ctr_type]](xml, "tab_shaders:"..ctr_type.."_"..opt, _st)

			if color then
				_st2:SetTextColor(unpack(color))
			end

			handler:Register(_st, "tab_shaders_cap_"..opt)
			handler:AddCallback("tab_shaders_cap_"..opt, ui_events.STATIC_FOCUS_RECEIVED, function()
				handler.hint_name:SetText(game.translate_string(hint_caption))
				handler.hint_caption:SetText(handler:HintCaption(hint_string, "tab_shaders:"..ctr_type.."_"..opt))
			end)

			if need_restart == 1 then
				handler:Register(ctl, "tab_shaders:"..ctr_type.."_"..opt)
				handler:AddCallback(
					"tab_shaders:"..ctr_type.."_"..opt,
					ctr_type == "list" and ui_events.LIST_ITEM_SELECT or ui_events.BUTTON_CLICKED,
					handler.show_need_restart_wnd, handler
				)
			end
		end
	end

	local btn = xml:Init3tButton("tab_shaders:btn_default", self)
	handler:Register(btn, "btn_shaders_default")

	btn = xml:Init3tButton("tab_shaders:btn_back", self)
	handler:Register(btn, "btn_shaders_back")
end
