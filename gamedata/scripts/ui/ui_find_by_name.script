class "load_item" (CUIListItemEx)

function load_item:__init() super()
	self:SetWndRect		( 0, 0, 430, 22 )
	
	local ca = 255
	local cr = 255 -- 255
	local cg = 255 -- 234
	local cb = 255 -- 104
	
	self.fn					= CUIStatic()
	self.fn:SetAutoDelete	( true)
	self:AttachChild		( self.fn )
	self.fn:SetWndRect		( 0, 0, 230, 22 )
	self.fn:SetText			( "item" )
	self.fn:SetFont			( GetFontLetterica18Russian() )
	self.fn:SetTextColor	( ca, cr, cg, cb )
end

function find_by_name:AddItemToList( sect )
	local list = self:GetListWnd( "list_window" )
	local _itm				= load_item()
	_itm.fn:SetText			( sect )
	_itm.fn:SetFont( GetFontMedium() )
	list:AddItem		( _itm )
end

function dozent_npc_search_finalize()
	table_npc_name = {}
end

function find_by_name:dozent_npc_search_init()
	dozent_npc_search_finalize()

	count_npc_total = 0
	for i = 1, MAX_OBJ_ID do
		local obj = alife():object( i )
		if 
			obj 
			and obj.m_game_vertex_id 
			and db.actor and db.actor:id() ~= obj.id 
			and (
				IsStalker( obj ) or 
				( obj:name() == "escape_trader" or obj:name() == "lim_trader" )
			)
			and obj:community() ~= "zombied" 
			and obj:community() ~= "monolith" 
			and obj:community() ~= "military" 
			and obj:community() ~= "killer" 
			and obj:name() ~= "stalker_osoznanie"
		then
			--[[
			if obj.can_switch_online and obj:can_switch_online() == true then
		
				local name_temp = ""
				if news_main.isGameObject( obj ) then
					if obj.character_name then name_temp = obj:character_name() end
				else
					local obj2 = news_main.get_obj( obj.id )
					if obj2 and obj2.character_name then
						name_temp = obj2:character_name()
					else
						local data = get_netpk( obj ):get()
						if data then name_temp = data.checked_characters end
						data = nil
					end
				end

				if ( name_temp ~= nil ) and ( name_temp ~= "" ) then
					count_npc_total = count_npc_total + 1
					table_npc_name[ count_npc_total ] = name_temp .. " [" .. i .. "]"
				end
			end
			]]--
			
			if obj.can_switch_online and obj:can_switch_online() then
				local name_temp = news_main.get_npc_name( obj )

				if name_temp and name_temp ~= "" then
					count_npc_total = count_npc_total + 1
					table_npc_name[count_npc_total] = name_temp .. " [" .. i .. "]"
				end
			end			
			
		end
	end
end

function find_by_name:FillList()
    local list = self:GetListWnd( "list_window" )
    if list:GetSize() > 0 then
        list:RemoveAll()
    end

    for k, v in pairs( table_npc_name ) do
        table.insert( sortedTable, v )
    end

    table.sort( sortedTable )

    for _, v in ipairs( sortedTable ) do
        self:AddItemToList( v )
    end
end

function find_by_name:RemoveText()
	self.text = ""
	self.search:SetText( "_" )
	self.was_found = -1
end

function find_by_name:SearchText(letter)
    if not letter or letter == "" then return end
    local lett = self.translit[letter] or letter
    if lett == "" or lett == "%" then return end
    if string.len(self.text) >= 60 then return end
    
    if string.sub(self.text, -1) == "_" then
        self.text = string.sub(self.text, 1, -2)
    end
    
    self.text = self.text .. lett
    self.search:SetText(self.text)
    
    self:SearchNPC()
end

function find_by_name:SearchNPC()
    if self.text == "" then return end
    
    local size = self.list:GetSize()
    local search_text = this.string_lower(self.text)
    
    for i = 0, size - 1 do
        local item = self.list:GetItem(i)
        local item_text = this.string_lower(item.fn:GetText())
        
        if item_text:find(search_text) then
            self.list:ScrollToPos(i)
            self.list:SetFocusedItem(i)
            self.list:SetSelectedItem(i)
            self.was_found = i
            break
        end
    end
end

local special_traders = {
    [ "escape_trader" ] = {
        status = function() 
            return sak_dialog.is_holiday_sidor() and "%c[red]Выходной\\n%c[default]" or "%c[green]На месте\\n%c[default]"
        end,
        group = "trader"
    },
    [ "lim_trader" ] = {
        status = function() 
            return "%c[green]На месте\\n%c[default]"
        end,
        group = "trader"
    }
}								

function find_by_name:AddSpotNPC()
    if not self or not self.list then return end
    
    if self.detail then 
        self:DetachChild(self.detail) 
        self.detail = nil 
    end    
    
    if self.icon_texture then 
        self:DetachChild(self.icon_texture) 
        self.icon_texture = nil 
    end    
    
    if self.cost_static then 
        self:DetachChild(self.cost_static)
        self.cost_static = nil
    end
	
    local list = self:GetListWnd("list_window")
    local selected_index = list:GetSelectedItem()
    
    if selected_index == -1 then return end
    
    local selected_item = list:GetItem(selected_index)
    local full_item_text = selected_item.fn:GetText()
    
    self.last_added_npc_text = full_item_text:gsub("%[.*", ""):gsub("^%s*(.-)%s*$", "%1")
    
    local id = full_item_text:match('%[(%d+)%]')

    if not id then return end
    
    local diff = tonumber(level.get_game_difficulty())    
    local money_needed = calc_money(1000, 15, 500)        
    
    if db.actor:money() >= money_needed then
        local npc = g_sim:object(tonumber(id))
        
        if npc then 
            local pk = get_netpk(npc)
            local data = pk:get()
            
            local icon = npc:character_icon() or "ui_npc_u_trups"
            local name = full_item_text:gsub("%[.*", ""):gsub("^%s*(.-)%s*$", "%1")

            local trader_info = special_traders[npc:name()]
            local group = trader_info and game.translate_string(trader_info.group) or game.translate_string(npc:community())
            local status = trader_info and trader_info.status() or (
                (npc.alive and npc:alive() and npc.health and npc:health() > 0) 
                and "%c[green]Жив\\n%c[default]" or "%c[red]Мёртв\\n%c[default]"
            )
            
            local m_level = news_main.get_point_description(news_main.get_object_levelname(npc), news_main.get_object_position(npc))
            m_level = (m_level == "" and "неизвестно") or m_level        
            db.actor:give_money(-money_needed)    
            local colour = db.actor:money() >= money_needed and "%c[green]" or "%c[red]"
            local transfer = string.format("\\nПереведено: %d. Остаток: %s%d\\n%%c[default]", money_needed, colour, db.actor:money())

            local text = string.format("Пользователь: %s \\nГруппировка: %s \\nСтатус: %s \\nМестоположение: %s \\n%s", name, group, status, m_level, transfer)
        
            self.icon_texture = make_static_picture("picture", self, nil, icon, 505, 210, 165, 108)
            self.detail = make_static("detail", self, text, 505, 340, 330, 20)
            
            if diff == 0 then 
                if level.map_has_object_spot(npc.id, 'blue_location') > 0 then 
                    level.map_remove_object_spot(npc.id, 'blue_location')
                end    
                level.map_add_object_spot_ser(npc.id, 'blue_location', name)
            
                if self.detail then 
                    self:DetachChild(self.detail) 
                    text = text .. "\\nУстановлена метка в ПДА на 24 часа"
                    self.detail = make_static("detail", self, text, 505, 340, 330, 20)    
                    timers.start_timer("remove_map_spot", 1, 0, 0, "ui_find_by_name.remove_map_spot(".. npc.id ..")")                        
                end    
            end                    
        end
    elseif db.actor:money() < money_needed then
        self.message_box:Init("msg_box_not_enough_search_money")    
        self:GetHolder():start_stop_menu(self.message_box, true)            
    end    
end

function find_by_name:BackSpace()
	if self.text ~= "" then
		local old_text = self.text
		if string.len(self.text) > 1 then
			self.text = string.sub(self.text, 1, -2)
		else
			self.text = "_"
		end
		self.search:SetText(self.text)
	end
	
	self.was_found = -1
	self:SearchNPC()
	misc.easy_sound("device\\key_click") 		
end

function find_by_name:Restore()
	self.text = ""
	self.was_found = -1
	self.search:SetText( self.text )
	self.list:SetFocusedItem( 0 )
	self.list:ScrollToPos( 0 )	
end

function find_by_name:NavigateList( direction )
	local list = self:GetListWnd( "list_window" )
	if list:GetSize() == 0 then return end

	local current_index = list:GetSelectedItem()
	local new_index

	if direction == "up" then
		new_index = ( current_index > 0 ) and ( current_index - 1 ) or ( list:GetSize() - 1 )
	else
		new_index = ( current_index < list:GetSize() - 1 ) and ( current_index + 1 ) or 0
	end

	list:SetSelectedItem( new_index )
	list:ScrollToPos(new_index)
	self:UpdateCurrentItem( new_index )

	if self.detail then 
		self:DetachChild( self.detail )
		self.detail = nil
	end
    
	if self.cost_static then 
		self:DetachChild( self.cost_static )
		self.cost_static = nil
	end
    
	if self.icon_texture then 
		self:DetachChild( self.icon_texture )
	end
    
	self.icon_texture = make_static_picture( "picture", self, nil, "ui_npc_u_trups", 505, 210, 165, 108 )
    
	local money_needed = calc_money( 1000, 15, 500 )
	local actor_money = db.actor:money()
    
	local cost_text
	if actor_money >= money_needed then
		cost_text = string.format(
			'Стоимость: %%c[green]%d%%c[default] / Доступно: %%c[green]%d%%c[default] руб. \\nНажмите "Enter" или "Найти"', 
			money_needed, actor_money
		)
	else
		cost_text = string.format(
			'%%c[default]Стоимость: %%c[red]%d%%c[default] / %%c[red]Недостаточно средств%%c[default]',
			money_needed
		)
	end
    
	self.cost_static = make_static( "cost_static", self, cost_text, 505, 320, 165, 30 )
    
	-- Сохраняем текст для двойного клика
	self.text = sortedTable[ new_index + 1 ]:gsub( "%[.*", "" ):gsub( "^%s*(.-)%s*$", "%1" )
end

function find_by_name:ClearSearchInfo()
	if self.detail then 
		self:DetachChild( self.detail )
		self.detail = nil
	end
	if self.icon_texture then 
		self:DetachChild( self.icon_texture )
		self.icon_texture = nil
	end
end

function find_by_name:OnKeyboard( dik, keyboard_action )
	CUIScriptWnd.OnKeyboard(self,dik,keyboard_action)
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_ESCAPE then self:OnQuit()
		elseif dik == DIK_keys.DIK_RETURN then self:AddSpotNPC()
		elseif dik == DIK_keys.DIK_BACK then self:BackSpace()
		elseif dik == DIK_keys.DIK_DOWN then self:NavigateList( "down" )
		elseif dik == DIK_keys.DIK_UP then self:NavigateList( "up" )	
		elseif dik == DIK_keys.DIK_END then self:Restore()		
		else
			local letter = string.sub( self.edit_box:GetText(), -1 )

			if letter and letter ~= "" then
				self:SearchText( letter )
				self.edit_box:SetText( "" )
				self:SearchNPC()	
				misc.easy_sound( "device\\key_click" ) 				
			end
		end
	end
	return true
end

function find_by_name:OnQuit()
	if self then
		self:ClearCallbacks()
		local holder = self:GetHolder()
		if holder then 
			holder:start_stop_menu( self, true )
		end
	end

	dozent_npc_search_finalize()
	sak.actor_hide_weapon()		
	misc.easy_sound( "device\\windows_shutdown" ) 	
	schedule.add( "restor_wpn", "sak.restore_weap()", 2000 )
	sortedTable = {}	

	_dialog = nil	
	used_items.set_use_gadget( false )
end

function find_by_name:UpdateCurrentItem( index )
    self.was_found = index
    
    local text = sortedTable[ index + 1 ]
    local search_text = text:gsub( "%[.*", "" ):gsub( "^%s*(.-)%s*$", "%1" )
    
    self.text = search_text
    
    if self.search then
        self.search:SetText( search_text ) 
    end

    if self.edit_box then
        self.edit_box:SetText( "" )
    end
end

function find_by_name:OnListItemClicked()
    local list = self:GetListWnd( "list_window" )    
    if list:GetSize() == 0 then return end    
    
    local current_time = os.time()
    local itm_index = list:GetSelectedItem()

    local selected_item = self.list:GetItem( itm_index )
    local item_text = selected_item.fn:GetText()

	-- Через дблклик не пашет
    -- Проверяем, тот ли это же элемент, что был ранее
    if self.last_selected_index == itm_index and 
        current_time - ( self.last_click_time or 0 ) <= 0.5 then
        -- Двойной клик на тот же элемент
        self:AddSpotNPC()
        self.last_click_time = nil
        self.last_selected_index = nil
        return
    end
    
    -- Первый клик или клик на новый элемент
    self.last_selected_index = itm_index
    self.last_click_time = current_time
    
    self:UpdateCurrentItem( itm_index )

    if self.detail then 
        self:DetachChild( self.detail )
        self.detail = nil
    end
    
    if self.cost_static then 
        self:DetachChild( self.cost_static )
        self.cost_static = nil
    end
    
    if self.icon_texture then 
        self:DetachChild( self.icon_texture )
    end
    
    self.icon_texture = make_static_picture( "picture", self, nil, "ui_npc_u_trups", 505, 210, 165, 108 )
    
    local money_needed = calc_money( 1000, 15, 500 )
    local actor_money = db.actor:money()
    
    local cost_text
    if actor_money >= money_needed then
        cost_text = string.format(
            'Стоимость: %%c[green]%d%%c[default] / Доступно: %%c[green]%d%%c[default] руб. \\nНажмите "Enter" или "Найти"', 
            money_needed, actor_money
        )
    else
        cost_text = string.format(
            '%%c[default]Стоимость: %%c[red]%d%%c[default] / %%c[red]Недостаточно средств%%c[default]',
            money_needed
        )
    end
    
    self.cost_static = make_static( "cost_static", self, cost_text, 505, 320, 165, 30 )
    
    -- Сохраняем полный текст без ID в квадратных скобках
    self.text = item_text:gsub( "%[.*", "" ):gsub( "^%s*(.-)%s*$", "%1" )
end

function find_by_name:OnArrowsClicked()
	local list = self:GetListWnd( "list_window" )	
	if list:GetSize() == 0 then return end	
	
	local text = sortedTable[ new_index + 1  ]
	local search_text = text:gsub( "%[.*", "" )
	
	self.text = search_text
	self.search:SetText( search_text ) 
end

function capitalize_first_letter( text )
    return text:gsub( "^%l", string.upper )
end

function make_static( name, own, text, x, y, width, height )
    local static = CUIStatic()
    static:SetWindowName( name )
    static:SetAutoDelete( true )
    if text then
        static:SetTextComplexMode( true )
        static:SetText( text )
    end
    static:Init( x, y, width, height )
    own:AttachChild( static )
    return static
end

function make_static_picture( name, own, text, icon, x, y, width, height )
    local static = CUIStatic()
    static:SetWindowName( name )
    static:SetAutoDelete( true )
    if text then
        static:SetTextComplexMode( true )
        static:SetText( text )
    end
	if icon then 
		static:InitTexture( icon )		
	end
    static:Init( x, y, width, height )
    own:AttachChild( static )
    return static
end

function remove_map_spot( id )
	if level.map_has_object_spot( id, 'blue_location' ) > 0 then 
		level.map_remove_object_spot( id, 'blue_location' )
	end	
end

function string_lower( str )
	local low = "qwertyuiopasdfghjklzxcvbnmйцукенгшщзхъфывапролджэячсмитьбюё"
	local high = "QWERTYUIOPASDFGHJKLZXCVBNMЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮЁ"
	local low_str = ""
	for i = 1, #str do
		local letter = string.sub( str, i, i )
		for a = 1,#high do
			if letter == string.sub( high, a, a ) then letter = string.sub( low, a, a ) break end
		end
		low_str = low_str..letter
	end
	return low_str
end

function bar_docent_notebook()
	misc.release_by_name( "Sak_notebook_bar" )
	--------------
	local sobj = alife():create( "physic_object", sak.v3f( 116.300003051758, -4.40000009536743, 17.5599994659424 ), 34184, 1239 )
	if sobj then 
		local pk 		 = get_netpk( sobj, 1 )	
		local data 		 = pk:get()		
		data.physic_type = 3
		data.mass 		 = 10	
		data.visual_name = "equipments\\item_notebook"		
		data.custom_data = 
			"[collide]\n" ..
			"ignore_dynamic\nignore_ragdoll\nignore_static\n\n" .. 
			"[ph_heavy]\n" ..
			"[logic]\n" .. 
			"active = ph_idle@enable\n" ..
			"[ph_idle@enable]\n" ..			
			"tips = switch_on\n" ..
			"on_use = {+bar_docent_npc_search_available} %=ui_find_by_name.start_find()%"
		pk:set( data )	
        sobj.direction = sak.v3f( 0, -2.25999999046326, 0 )	
	end	
end

function calc_money( price, period, add )
	local day = timers.Get_Game_Days() or 1
	day = math.min( day, 120 )
	local dif = tonumber( level.get_game_difficulty() )
	if dif == 0 then
		day = math.min( day, 40 )
	end
	return math.floor( math.abs( price + math.floor( day / period ) * add ) )
end

function new_money_have( price, period, add )
    return have_money( calc_money( price, period, add ) )
end

function new_money_give( price, period, add )
	local actor = db.actor
    local amount = calc_money( price, period, add )
    actor:give_money( - amount )
    sak.show_relocated_money( "out", amount )
end

function have_money( amount )
    return db.actor:money() >= amount
end