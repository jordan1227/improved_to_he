function find_screen()
	sak.restore_weap()
	level.start_stop_menu( find_by_name( get_hud() ), true )
end

class "find_by_name" ( CUIScriptWnd )

function find_by_name:__init( owner ) super()
	if self.menu_index == nil then self.menu_index = 1 end
	
	local eng = [[qwertyuiop[]asdfghjkl;'zxcvbnm,./QWERTYUIOP{}ASDFGHJKL:"ZXCVBNM<>?!@#$%^&*()-_+=\| 0123456789]]
	local rus = [[йцукенгшщзхъфывапролджэячсмитьбюёЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮ,!"№;%:?*()-_+=\/ 0123456789]]
	
	self.translit = {}
	for i = 1, string.len(rus) do
		self.translit[string.sub(eng, i, i)] = string.sub(rus, i, i)
	end	
	_dialog = self	
	self.was_found = -1		
	self:InitControls()
	self:InitCallBacks()
	self:FillList()	
	used_items.set_use_gadget( false )
end

function find_by_name:__finalize()	end

function find_by_name:InitControls()
	self:SetWndRect( Frect():set( 0, 0, 1024, 1024 ) )
	local xml = CScriptXmlInit()
	xml:ParseFile	( "ui_find_by_name.xml" )
	
	self.dialog =  xml:InitStatic( "main_dialog:dialog", self )	

	self.list = xml:InitList( "list", self )	
	self.list:ShowSelectedItem( true )
	
	self:Register( self.list, "list_window" )
	------------------------
	self.text = ""	
	self.edit_box = xml:InitEditBox( "main_dialog:frame_search",	self )	
	
	self.search = CUIStatic()
	self.search:SetWindowName( "search" )
	self.search:SetAutoDelete( true )
	self.search:SetText( "Имя Фамилия или Прозвище" )
	self.search:SetTextColor( 255, 200, 255, 200 )
	--self.search:SetFont( GetFontDI() )
    self.search:Init( 255, 438, 200, 200 )
    self:AttachChild( self.search )
	self:AddCallback( "search", ui_events.WINDOW_LBUTTON_DB_CLICK, self.RemoveText, self )
	------------------------
	self.btn_find = CUIButton()
	self.btn_find:Init( "ui\\ui_hud", 450, 433, 45, 25 )
	self.btn_find:SetText( "Найти" )
	self.btn_find:SetTextAlign( CGameFont.alCenter )
	self.btn_find:SetTextY( 1 )
	self.btn_find:SetTextColor( 255, 240, 165, 25 )
	self.btn_find:SetOriginalRect( 65, 704, 37, 25 )
	self.btn_find:SetStretchTexture( true )
	self:Register( self.btn_find, "btn_find" )
	self:AttachChild( self.btn_find )
	self:AddCallback( "btn_find", ui_events.BUTTON_DOWN, self.AddSpotNPC, self )	
	------------------------
    self.message_box = CUIMessageBoxEx()
    self:Register( self.message_box, "message_box" )	
	------------------------
	self:AddCallback( "list_window",		ui_events.LIST_ITEM_CLICKED, 				self.OnListItemClicked,						self )		
	self:dozent_npc_search_init()		

    self.total_npces = make_static(
        "total_npces", self, string.format( "Общее количество пользователей: %s ", ( count_npc_total or 0 ) ), 270, 185, 260, 20
    )		
    self.total_npces:SetTextColor( 255, 135, 130, 130 )
    self.total_npces:SetFont( GetFontLetterica18Russian() )	
end

function find_by_name:InitCallBacks()
	-- self:AddCallback( "list_window",	  	ui_events.WINDOW_LBUTTON_DB_CLICK,			self.AddSpotNPC,           	self )
	self:AddCallback( "message_box", 		ui_events.MESSAGE_BOX_OK_CLICKED, 			self.OnQuit, 				self )	
end

