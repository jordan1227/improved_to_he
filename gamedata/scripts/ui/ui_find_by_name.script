_dialog = level.main_input_receiver()

function attach(sm)
	sm:subscribe({signal = "on_init_modules", fun = this.init_module})
end

function init_module()
	_dialog = nil
end

local sortedTable = {}
local saved_keys  = {}
local new_index	  = 0

local State ={CurString = ""}
local table_npc_name 	= {}
local count_npc_total 	= 0

function start_find()
	sak.actor_hide_weapon()	
  --  local snd_obj

 --   snd_obj = xr_sound.get_safe_sound_object( [[device\windows_up]] )
 --   snd_obj:play_no_feedback( db.actor, sound_object.s2d, 0, vector(), 1.0 )	
	-- schedule.add( "start_find", "ui_find_by_name.find_screen()", 2000 )
	dsh.timeout( 2000, function()
		ui_find_by_name.find_screen()
	end )
end

