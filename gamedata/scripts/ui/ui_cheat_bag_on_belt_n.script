class "bag_dialog" (CUIScriptDialog)

local inv_items_list  --информация для сумки (что положить), список записей секций и количества
local bag_content   --информация для сумки (что лежит)
local inv_items_ids   --информация по id (что положить), cписок записей секций и id

local save_bag_ids = {}  -- храню ID предметов, которые уже лежали в сумке 

function bag_dialog:__init(owner) super()
  self.owner = owner
  self:InitControls()
  self:InitCallBacks()
  self:CollectItems()
end

function bag_dialog:CollectItems()
  --собираю мелочь в рюкзаке
--  local t = test
  inv_items_list, inv_items_ids = bag_on_belt_use.inventory_items()

  --?сли надо, добавл¤ю в таблицы записи-пустышки
  if inv_items_list:size() < 4 then
     inv_items_list:set_size(4)
  end   
--  log2(" inv_items_list dump: ")
--  inv_items_list:dump() 
--  log2(" inv_items_ids dump: ")
--  inv_items_ids:dump()

	--определ¤ю содержимое сумки
  bag_content = bag_on_belt_use.load_bag_content()
    bag_content:set_size(6)
    
--    log2(" bag_content dump: ")
--    bag_content:dump()

  save_bag_ids = {}
  for i, rec in bag_content:ipairs() do
    if rec.id ~= 0 then
           save_bag_ids[rec.id] = true  -- только те, что сейчас в сумке
    end
  end 

  -- расставл¤ю иконки на кнопки
  self:set_bag_pocket()
  self:reset_windows()
end

function bag_dialog:InitControls()
  -- Положение и размеры окна
  --self:Init(196,0,420,334)
  self:Init(315,0,395,414)
  -- файл-описатель элементов
  local xml = CScriptXmlInit()
  xml:ParseFile("ui_cheat_bag_on_belt_n.xml")
  
  xml:InitStatic("background_0", self)     
  xml:InitStatic("background", self)       --Собственно рамка
  --xml:InitStatic("background_2", self)     --надпись СУМКА

  self:Register(xml:InitButton("btn_stop",    self),"btn_stop")    -- Кнопка Выкл
  self:Register(xml:InitButton("btn_empty",   self),"btn_empty")  -- Кнопка Выгрузить
  self:Register(xml:InitButton("btn_left_1",  self),"btn_left_1")  -- Кнопка прокрутки слотов влево
  self:Register(xml:InitButton("btn_right_1", self),"btn_right_1")  -- Кнопка прокрутки слотов вправо

-- кнопки для ввода
  for i = 1, 4 do
    local btn_name = "btn_" .. i
    self:Register(xml:InitButton(btn_name, self), btn_name)
  end

-- кнопки для вывода
  for i = 1, 6 do
    local btn_name = "btn_out_" .. i
    self:Register(xml:InitButton(btn_name, self), btn_name)
  end
end

function bag_dialog:InitCallBacks()
  self:AddCallback("btn_stop", ui_events.BUTTON_CLICKED, self.btn_stop, self)        -- Кнопка Выкл
  self:AddCallback("btn_empty", ui_events.BUTTON_CLICKED, self.btn_empty, self)      -- Кнопка Выгрузить
  self:AddCallback("btn_left_1", ui_events.BUTTON_CLICKED, self.btn_left_1, self)    -- Кнопка прокрутки слотов влево
  self:AddCallback("btn_right_1", ui_events.BUTTON_CLICKED, self.btn_right_1, self)  -- Кнопка прокрутки слотов влево

-- кнопки для ввода
  for i = 1, 4 do
      local btn_name = "btn_" .. i
      local method   = self["btn_" .. i]
      self:AddCallback(btn_name, ui_events.BUTTON_CLICKED, method, self)
  end

-- кнопки для вывода
  for i = 1, 6 do
      local btn_name = "btn_out_" .. i
      local method   = self["btn_out_" .. i]
      self:AddCallback(btn_name, ui_events.BUTTON_CLICKED, method, self)
  end
end

function bag_dialog:OnKeyboard(dik, keyboard_action)
  if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
    if dik == DIK_keys.DIK_A then
       self:btn_left_1()
       return true
    elseif dik == DIK_keys.DIK_D then
       self:btn_right_1()
       return true
    elseif dik == DIK_keys.DIK_ESCAPE then
       self:btn_stop()
       return true
    else
       local he_nz = bind_to_dik(key_bindings.kOPN_NZ)
       if he_nz and he_nz > 0 and dik == he_nz then
          bind_stalker.he_suppress_gadget_open = true
          self:btn_stop()
          return true
       end
    end
  end
  return CUIScriptDialog.OnKeyboard(self,dik,keyboard_action)
end

function bag_dialog:CloseDialog()
  bag_content = nil
  inv_items_list = nil
  inv_items_ids = nil
  self:del_windows_pocket()
  self:del_windows_1_4()
  
  used_items.set_get_flag_use_gadget(1,true)
  vergas_lib.s_play(vergas_lib.set_pr_from_config_str("bag_on_belt","snd_deselect"),1)
  razgruzka.inventory_on_off(false)
  bind_stalker.restore_weapon()
  level.enable_input()
  CUIScriptDialog.CloseDialog(self)
end

-------------------------------------------------------------------------
--расстановка иконок и количества на кнопках
-------------------------------------------------------------------------
function bag_dialog:set_btn_n(n)
   if n > 4 then return end

   local name = "wnd_"..tostring(n) 
   self:remove_static(name)
   local rec = inv_items_list:get(n)
   -- wprintf(" set_btn_n(%d) rec = %s", n, DumpVar(rec))
   
   if not rec or rec.count == 0 then return end   
   local m_rects = {}
   
   m_rects[1] = 
    {
        { 93,349,27,36 },    
        { 152,349,27,36 }, 
        { 210,349,27,36 }, 
        { 270,349,27,36 }
    }
   
   m_rects[2] = 
    {
        { 83,349,53,36  },
        { 140,349,53,36 }, 
        { 200,349,53,36 }, 
        { 260,349,53,36 }
    }
   
   m_rects[3] = m_rects[2]
   
   local ik_t = vergas_lib.set_pr_from_config("bag_"..rec.sect, "size_icon")
   local l_rects = m_rects[ik_t] or {}
   local rect = l_rects[n]
   if rect == nil then
      wprintf("~C0C #ERROR~C07: nil == m_rects[%d][%d] ", ik_t or -1, n or -1)
     return
   end
   
   self:add_static(name, rect, tostring(rec.count), nil, "", rec.sect)
end

-------------------------------------------------------------------------
--работа кнопок сумки
-------------------------------------------------------------------------
function bag_dialog:btn_stop()
--    bag_content = bag_on_belt_use.clean_holes_table(bag_content)
    for _, rec in bag_content:ipairs() do
        if rec.id > 0 and save_bag_ids[rec.id] then
            -- возвращаем предметы в сумку
            bag_on_belt_use.transfer_item_in_hran(rec.id)
        end
    end

    for _, rec in inv_items_ids:ipairs() do
        if rec.id and rec.id > 0 then
            -- возвращаем предметы в инвентарь
            bag_on_belt_use.transfer_item_from_hran(rec.id)
        end
    end
    -- сохраняем текущее состояние сумки (не работает)
--    bag_on_belt_use.save_bag_content(bag_content)
    schedule.add("bag_weight", "bag_on_belt_use.calculate_bag_weight()", 500)
    self:CloseDialog()
end

function bag_dialog:btn_empty()    --Кнопка Выгрузить из сумки
    
  --трансферю предметы, если они в хранилище
  for i, rec in bag_content:ipairs() do
    if save_bag_ids [rec.id] then
       if not bag_on_belt_use.transfer_item_from_hran(rec.id) then -- если есть проблемы, то зачем?
              -- return
           end
    end
  end

    -- возвращение на исходные позиции      
    inv_items_list, inv_items_ids = bag_on_belt_use.inventory_items()
    bag_content:set_default(1, 6)
  save_bag_ids = { }
  
  --обновляю иконки
  self:set_bag_pocket()
  self:reset_windows()

  vergas_lib.s_play(vergas_lib.set_pr_from_config_str("bag_on_belt","snd_scroll"),1)
end


-- кнопки перемещения предметов в сумку
for i = 1, 4 do
	bag_dialog["btn_"..i] = function(self)
		if inv_items_list(i).id ~= 0 then
			self:put_in_bag(i)
			self:set_btn_n(i)
		end
	end
end

-- кнопки перемещения предметов из сумки
for i = 1, 6 do
		bag_dialog["btn_out_"..i] = function(self)
        self:take_from_bag(i)
    end
end

-------------------------------------------------------------------------
--работа кнопок прокрутки
-------------------------------------------------------------------------

function bag_dialog:btn_left_1()                --Кнопка прокрутки слотов влево
  if inv_items_list:size() <= 4 then return end
  inv_items_list:rotate_left()
  vergas_lib.s_play(vergas_lib.set_pr_from_config_str("bag_on_belt","snd_scroll"),1)
  self:reset_windows()
end

function bag_dialog:btn_right_1()              --Кнопка прокрутки слотов вправо
  if inv_items_list:size() <= 4 then return end
  inv_items_list:rotate_right()
  vergas_lib.s_play(vergas_lib.set_pr_from_config_str("bag_on_belt","snd_scroll"),1)
  self:reset_windows()
end

-------------------------------------------------------------------------
--функции перемещения хабара 
-------------------------------------------------------------------------
function bag_dialog:put_in_bag(btn)

    local filling_pocket = 0

    -- считаем заполненность сумки
    for _, rec in bag_content:ipairs() do
        if rec.sect ~= "?" then
            filling_pocket = filling_pocket + vergas_lib.set_pr_from_config("bag_"..rec.sect, "size")
        end
    end

    local brec = inv_items_list(btn)
    if not brec or brec.sect == "?" then return end

    if (filling_pocket + vergas_lib.set_pr_from_config("bag_"..brec.sect,"size")) > 6 then
        return
    end

    local pocket = bag_content:find(1, "?")
    if pocket <= 0 then return end

    -- ищем реальный obj_id
    for i, rec in inv_items_ids:ipairs() do
        if rec.sect == brec.sect and not save_bag_ids[rec.id] then
            -- добавляем предмет в сумку
            bag_content:set(pocket, { sect = rec.sect, id = rec.id })
            save_bag_ids[rec.id] = true
            inv_items_ids:remove(i)
            -- уменьшаем счетчик на панели
            brec.count = brec.count - 1
            -- если счетчик обнулился, полностью убираем запись из панели
            if brec.count <= 0 then
                -- чистим пустышки: оставляем только те, где count > 0
                local tmp = bag_on_belt_use.list_sect_count()
                for _, r in inv_items_list:ipairs() do
                    if r.count > 0 then
                        tmp:add(r)
                    end
                end
                inv_items_list = tmp
            end

            break
        end
    end

    vergas_lib.s_play(vergas_lib.set_pr_from_config_str("bag_on_belt","snd_load"), 1)

    -- обновляем UI сумки
    self:set_bag_pocket()
    self:reset_windows()
end



function bag_dialog:take_from_bag(bag_idx)
    local rec = bag_content:get(bag_idx)
    if not rec or rec.sect == "?" then return end

    -- чистим слот
    bag_content:set(bag_idx, {sect = "?", id = 0})
    save_bag_ids[rec.id] = nil

    -- ищем предмет в панели
    local found = false
    for _, brec in inv_items_list:ipairs() do
        if brec.sect == rec.sect then
            brec.count = brec.count + 1
            found = true
            break
        end
    end

-- если на панели такого предмета ещё нет, создаём новый
    if not found then
        inv_items_list:insert(1, {sect = rec.sect, count = 1})  -- вставляем в начало
        inv_items_ids:add({sect = rec.sect, id = rec.id, obj = rec.obj, amount = 1})
    else
-- если уже есть на панели, просто добавляем новый id в inv_items_ids
        inv_items_ids:add({sect = rec.sect, id = rec.id, obj = rec.obj, amount = 1})
    end


    vergas_lib.s_play(vergas_lib.set_pr_from_config_str("bag_on_belt","snd_load"),1)

    -- сдвиг слотов сумки и обновление UI
    bag_content = bag_on_belt_use.clean_holes_table(bag_content)
    self:set_bag_pocket()

    -- обновляем панель 4 кнопок
    self:update_inventory_panel()
end

-- просто обновляем 4 кнопки с предметами панели, беря данные из inv_items_list
function bag_dialog:update_inventory_panel()

    for i = 1, 4 do
        self:set_btn_n(i)
    end
    self:reset_windows()
end


function bag_dialog:set_bag_pocket()
    self:del_windows_pocket()

    local start_x = 100
    local y       = 276
    local w       = 18
    local h       = 28
    local step_x  = 19

    local cursor = 0
    local ui_idx = 0

    for _, rec in bag_content:ipairs() do
        if rec.sect ~= "?" and rec.id ~= 0 then

            local x = start_x + cursor * step_x
            cursor = cursor + 1
            ui_idx = ui_idx + 1

            local rect = { x, y, w, h }
            self:add_static("wnd_pocket_"..ui_idx, rect, "", nil, "", rec.sect)

        end
    end
end


------------------------------------------------------------------------
-- Функции общего назначения
------------------------------------------------------------------------
function bag_dialog:reset_windows()
  self:del_windows_1_4()
  
  for i, rec in inv_items_list:ipairs() do
    if i < 5 and rec.sect ~= "?" then
      self:set_btn_n(i)
    end   
  end
end

function bag_dialog:del_windows_1_4()
  -- Убираем старые окна
  for i = 1, 6 do
    self:remove_static("wnd_"..tostring(i))
  end    
end

function bag_dialog:del_windows_pocket()
  -- Удаляем окна карманов
  for i = 1, 6 do
    self:remove_static("wnd_pocket_"..tostring(i))
  end    
end

