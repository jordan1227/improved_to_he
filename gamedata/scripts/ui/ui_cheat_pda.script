function cheat:btn_u_1()					--  нопка "Ввод"
	
		if self.mode == 1 then
			self.old_btn = nil
			self.klik = nil
			self:password_check()
	end
	vergas_lib.s_play(vergas_lib.set_pr_from_config_str("list_sounds_pda","snd_klik_pda"),1)
end

function cheat:btn_u_2()					--  нопка "<=="
	if self.navigation_locked then return end

	if self.mode == 1 then
		self.v_pass = string.sub (self.v_pass, 1 , string.len(self.v_pass)-1)
		self:set_wnd_ps(2)
		self.old_btn = nil
		self.klik = nil
    elseif self.mode == 2 and #self.tbl_msg > 1 then
        self:replace_record_msg( 2 )
    end

	vergas_lib.s_play(vergas_lib.set_pr_from_config_str("list_sounds_pda","snd_klik_pda"),1)	
end

function cheat:btn_u_3()					--  нопка "конверт"
	if self.mode == 1 then
		return
	end

end

function cheat:btn_u_4()					-- Кнопка "==>"
	if self.navigation_locked then return end
    if self.mode == 1 then
        return
    end
    if self.mode == 2 and #self.tbl_msg > 1 then
        self:replace_record_msg( 1 )
    end
    vergas_lib.s_play( vergas_lib.set_pr_from_config_str( "list_sounds_pda", "snd_klik_pda" ), 1 )
end

function cheat:set_btn_klik(n,m)
--n-номер нажатой кнопки
--m-количество максимальных нажатий
	if self.old_btn == n then
		if self.klik == m then
			self.klik = 1
		else
			self.klik = self.klik + 1
		end
	else
		self.btn = n
		self.klik = 1
	end
	vergas_lib.s_play(vergas_lib.set_pr_from_config_str("list_sounds_pda","snd_klik_pda"),1)
end

function cheat:symbol_choice(t)
	local i
	
	for i = 1, table.getn(t) do
		if self.klik == i then
			return t[i]
		end
	end
end

function cheat:password_formation( symbol )
	local time_n = time_global()
	
	if string.sub ( self.v_pass, 1 , 1 ) == "*" then
		self.v_pass = ""
	end
	if self.old_btn == self.btn then
		-- нажата та же клавиша
		if self.old_time ~= nil then
			if ( time_global() - self.old_time ) > 700 then
				if string.len( self.v_pass ) < string.len( self.tbl_info[ 2 ] ) then
					self.v_pass = self.v_pass .. symbol
				end
			else
				self.v_pass = string.sub( self.v_pass, 1 , string.len( self.v_pass ) - 1 ) .. symbol
			end
		else
			self.v_pass = self.v_pass .. symbol
		end
	else
		-- нажата другая клавиша
		if string.len( self.v_pass ) < string.len( self.tbl_info[ 2 ] ) then
			self.v_pass = self.v_pass .. symbol
		end
	end
	
	self:set_wnd_ps( 2 )
	self.old_btn = self.btn
	self.old_time = time_global()
end

-- +1 к этому для установки, онли удалит остальные сообщения
local pda_count_triggers = {
	[ 3 ]  = { action = "pda_actions.anomaly_info",		  only = false },
    [ 5 ]  = { action = "pda_actions.incoming_contracts", only = true  },
	[ 7 ]  = { action = "pda_actions.gar_lv_way",		  only = false }, 
   -- [10] = { action = "pda_actions.give_something",     only = false },
  --  [15] = { action = "pda_actions.agro_way",           only = false },
}

function cheat:password_check()
    if string.lower( self.v_pass ) == string.lower( self.tbl_info[ 2 ] ) then
        if self.wnd_lg ~= nil then self:DetachChild( self.wnd_lg ); self.wnd_lg = nil end
        if self.wnd_ps ~= nil then self:DetachChild( self.wnd_ps ); self.wnd_ps = nil end
        if self.wnd_nm ~= nil then self:DetachChild( self.wnd_nm ); self.wnd_nm = nil end
        self.was_read_on_open = string.sub( self.tbl_info[4], 14, 14 ) == "1"
        self:set_pda_flag( "3" )
        self.seen_messages = {}
        self.all_seen = false
        self:set_tbl_msg()

		local count  = get_value( "pda_read_count", 0 )
		local trigger = pda_count_triggers[ count ]
		if trigger and not self.was_read_on_open then
			local already_added = false
			for _, v in ipairs( self.tbl_msg ) do
				if vergas_lib.trim( v ) == trigger.action then
					already_added = true
					break
				end
			end

			if not already_added then
				local ok = vergas_pda.add_action_to_current_pda( trigger.action, trigger.only )
				if ok then
					if trigger.only then
						self.tbl_info[5] = trigger.action
						self.tbl_msg = { trigger.action }
					else
						self.tbl_info[5] = self.tbl_info[5] .. "," .. trigger.action
						table.insert( self.tbl_msg, trigger.action )
					end
				end
			end
		end

        self.start_msg = self.number_msg
        self.seen_messages[self.start_msg] = true
        self:set_msg()
        vergas_lib.s_play( vergas_lib.set_pr_from_config_str( "list_sounds_pda", "snd_pass_ok" ), 1 )
    else
        self.v_pass = string.rep( "*", string.len( self.tbl_info[ 2 ] ) )
        self:set_wnd_ps( 2 )
        vergas_lib.s_play( vergas_lib.set_pr_from_config_str( "list_sounds_pda", "snd_pass_no" ), 1 )
    end
end

function is_pda_read( serial )
    return string.sub( serial, 14, 14 ) == "1"
end
--===========================================О НА==================================================
function cheat:set_wnd_pda()
	if self.wnd_pda ~= nil then
		self:DetachChild(self.wnd_pda)
		self.wnd_pda = nil
	end

	self.wnd_pda = CUIStatic()
	self.wnd_pda:SetAutoDelete(true)
	self:AttachChild(self.wnd_pda)
	self.wnd_pda:SetStretchTexture(true)
	self.wnd_pda:SetWndRect(-200, -119, 1564, 1011)		--1600x900

	self.wnd_pda:InitTexture("ui\\ui_pda_ok")
end
function cheat:set_wnd_sn()		--служебный номер
	if self.wnd_sn ~= nil then
		self:DetachChild(self.wnd_sn)
		self.wnd_sn = nil
	end
	
	self.wnd_sn = CUIStatic()
	self.wnd_sn:SetAutoDelete(true)
	self:AttachChild(self.wnd_sn)
	self.wnd_sn:SetStretchTexture(true)
	self.wnd_sn:SetWndRect(-43, -50, 82, 36)			--1600x900
	self.wnd_sn:SetTextColor(255,28, 28, 28)		--225
	self.wnd_sn:SetFont(GetFontLetterica16Russian())
	self.wnd_sn:SetText("№ "..(self.tbl_info[4] or '?'))
end

function cheat:set_wnd_nm()		--имя непися
	if self.wnd_nm ~= nil then
		self:DetachChild(self.wnd_nm)
		self.wnd_nm = nil
	end
	
	self.wnd_nm = CUIStatic()
	self.wnd_nm:SetAutoDelete(true)
	self:AttachChild(self.wnd_nm)
	self.wnd_nm:SetStretchTexture(true)
	self.wnd_nm:SetWndRect(228, 78, 215, 40)
	self.wnd_nm:SetTextColor(225, 0, 0, 0)		
	self.wnd_nm:SetFont(GetFontGraffiti32Russian())
	self.wnd_nm:SetText(self.tbl_info[3])
end

