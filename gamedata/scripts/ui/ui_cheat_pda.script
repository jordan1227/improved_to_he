function cheat:btn_u_1()					--  нопка "Ввод"
	
		if mode == 1 then
			old_btn = nil
			klik = nil
			self:password_check()
	end
	vergas_lib.s_play(vergas_lib.set_pr_from_config_str("list_sounds_pda","snd_klik_pda"),1)
end

function cheat:btn_u_2()					--  нопка "<=="
	if navigation_locked then return end

	if mode == 1 then
		v_pass = string.sub (v_pass, 1 , string.len(v_pass)-1)
		self:set_wnd_ps(2)
		old_btn = nil
		klik = nil
    elseif mode == 2 and #tbl_msg > 1 then
        self:replace_record_msg( 2 )
    end

	vergas_lib.s_play(vergas_lib.set_pr_from_config_str("list_sounds_pda","snd_klik_pda"),1)	
end

function cheat:btn_u_3()					--  нопка "конверт"
	if mode == 1 then
		return
	end

end

function cheat:btn_u_4()					-- Кнопка "==>"
	if navigation_locked then return end
    if mode == 1 then
        return
    end
    if mode == 2 and #tbl_msg > 1 then
        self:replace_record_msg( 1 )
    end
    vergas_lib.s_play( vergas_lib.set_pr_from_config_str( "list_sounds_pda", "snd_klik_pda" ), 1 )
end

function cheat:set_btn_klik(n,m)
--n-номер нажатой кнопки
--m-количество максимальных нажатий
	if old_btn == n then
		if klik == m then
			klik = 1
		else
			klik = klik + 1
		end
	else
		btn = n
		klik = 1
	end
	vergas_lib.s_play(vergas_lib.set_pr_from_config_str("list_sounds_pda","snd_klik_pda"),1)
end

function cheat:symbol_choice(t)
	local i
	
	for i = 1, table.getn(t) do
		if klik == i then
			return t[i]
		end
	end
end

function cheat:password_formation( symbol )
	local time_n = time_global()
	
	if string.sub ( v_pass, 1 , 1 ) == "*" then
		v_pass = ""
	end
	if old_btn == btn then
		-- нажата та же клавиша
		if old_time ~= nil then
			if ( time_global() - old_time ) > 700 then
				if string.len( v_pass ) < string.len( tbl_info[ 2 ] ) then
					v_pass = v_pass .. symbol
				end
			else
				v_pass = string.sub( v_pass, 1 , string.len( v_pass ) - 1 ) .. symbol
			end
		else
			v_pass = v_pass .. symbol
		end
	else
		-- нажата другая клавиша
		if string.len( v_pass ) < string.len( tbl_info[ 2 ] ) then
			v_pass = v_pass .. symbol
		end
	end
	
	self:set_wnd_ps( 2 )
	old_btn = btn
	old_time = time_global()
end

-- +1 к этому для установки, онли удалит остальные сообщения
local pda_count_triggers = {
	[ 3 ]  = { action = "pda_actions.anomaly_info",		  only = false },
    [ 5 ]  = { action = "pda_actions.incoming_contracts", only = true  },
	[ 7 ]  = { action = "pda_actions.gar_lv_way",		  only = false }, 
   -- [10] = { action = "pda_actions.give_something",     only = false },
  --  [15] = { action = "pda_actions.agro_way",           only = false },
}

function cheat:password_check()
    if string.lower( v_pass ) == string.lower( tbl_info[ 2 ] ) then
        if wnd_lg ~= nil then self:DetachChild( wnd_lg ); wnd_lg = nil end
        if wnd_ps ~= nil then self:DetachChild( wnd_ps ); wnd_ps = nil end
        if wnd_nm ~= nil then self:DetachChild( wnd_nm ); wnd_nm = nil end
        was_read_on_open = string.sub( tbl_info[4], 14, 14 ) == "1"
        self:set_pda_flag( "3" )
        seen_messages = {}
        all_seen = false
        self:set_tbl_msg()

		local count  = get_value( "pda_read_count", 0 )
		local trigger = pda_count_triggers[ count ]
		if trigger and not was_read_on_open then
			local already_added = false
			for _, v in ipairs( tbl_msg ) do
				if vergas_lib.trim( v ) == trigger.action then
					already_added = true
					break
				end
			end

			if not already_added then
				local ok = vergas_pda.add_action_to_current_pda( trigger.action, trigger.only )
				if ok then
					if trigger.only then
						tbl_info[5] = trigger.action
						tbl_msg = { trigger.action }
					else
						tbl_info[5] = tbl_info[5] .. "," .. trigger.action
						table.insert( tbl_msg, trigger.action )
					end
				end
			end
		end

        start_msg = number_msg
        seen_messages[start_msg] = true
        self:set_msg()
        vergas_lib.s_play( vergas_lib.set_pr_from_config_str( "list_sounds_pda", "snd_pass_ok" ), 1 )
    else
        v_pass = string.rep( "*", string.len( tbl_info[ 2 ] ) )
        self:set_wnd_ps( 2 )
        vergas_lib.s_play( vergas_lib.set_pr_from_config_str( "list_sounds_pda", "snd_pass_no" ), 1 )
    end
end

function is_pda_read( serial )
    return string.sub( serial, 14, 14 ) == "1"
end
--===========================================О НА==================================================
function cheat:set_wnd_pda()
	if wnd_pda ~= nil then
		self:DetachChild(wnd_pda)
		wnd_pda = nil
	end

	wnd_pda = CUIStatic()
	wnd_pda:SetAutoDelete(true)
	self:AttachChild(wnd_pda)
	wnd_pda:SetStretchTexture(true)
	wnd_pda:SetWndRect(-33,-8,727,503)		--1600x900

	wnd_pda:InitTexture("ui\\ui_pda_ok")
end
function cheat:set_wnd_sn()		--служебный номер
	if wnd_sn ~= nil then
		self:DetachChild(wnd_sn)
		wnd_sn = nil
	end
	
	wnd_sn = CUIStatic()
	wnd_sn:SetAutoDelete(true)
	self:AttachChild(wnd_sn)
	wnd_sn:SetStretchTexture(true)
	wnd_sn:SetWndRect(40,26,38,18)			--1600x900
