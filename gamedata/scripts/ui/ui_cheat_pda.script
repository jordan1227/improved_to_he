end

--==================СООБЩЕНИя=============================================================
function cheat:set_msg()
    keyboard_allowed = false
    mode = 2

    flag_treasure = false
    local txt_msg = tbl_msg[ number_msg ]

    if string.sub( txt_msg, 1, 4 ) == "enc_" then
        local info_id = "info_" .. string.sub( txt_msg, 5, string.len( txt_msg ) - 5 )
        if not has_alife_info( info_id ) then
            db.actor:give_info_portion( info_id )
            kotovod.sms_recipt_found( info_id )
        end
        local desc_id = string.sub( txt_msg, 1, string.len( txt_msg ) - 5 ) .. "_desc"
        local recipe_text = game.translate_string( desc_id )
        self:set_wnd_sms_direct( recipe_text )
	--[[	
	elseif string.sub( txt_msg, 1, 5 ) == "info_" then
		if not has_alife_info( txt_msg ) then
			db.actor:give_info_portion( txt_msg )
		end
		local text_id = "text_" .. string.sub( txt_msg, 6 )
		local text = game.translate_string( text_id )
		self:set_wnd_sms_direct( text )	
	]]--
	
	-- Обработка функций, обязательно в файле kotovod.script. Аргументы не стал добавлять, пусть каждая отдельно будет
	-- flush !mike.add_device_pda_npc(1,"kotovod.give_something")
	elseif string.sub( txt_msg, 1, 12 ) == "pda_actions." then
		local func = string.sub( txt_msg, 13 )
		local text = pda_actions.run( func )
		if text then
			self:set_wnd_sms_direct( text )
		end
	
    elseif string.find( txt_msg, "+" ) ~= nil or
           ( string.find( txt_msg, "_" ) == nil
             and tonumber( txt_msg )
             and tonumber( txt_msg ) >= 1000 ) then
        flag_treasure = true
        -- показываем текст первого тайника в записи
        local first_id = string.match( txt_msg, "([^+]+)" )
		local r_trs_item = get_value( "r_treas_items", 1 )
        local msg_id = "treasure" .. "_" .. vergas_lib.trim( first_id ) .. "_" .. r_trs_item
        self:set_wnd_sms( "text_" .. msg_id )
    else
        local grup = ui_cheat_pda.cheat:get_community()
        local msg_id = grup .. "_" .. txt_msg
        txt_msg = "text_" .. msg_id
        self:set_wnd_sms( txt_msg )
    end

    self:set_wnd_counter()
    self:set_treasure()

    if message_given then return end
    if not was_read_on_open then return end

    local viewed_count = 0
    for _ in pairs( seen_messages ) do viewed_count = viewed_count + 1 end
    if viewed_count < math.min( lua_random( 3, 5 ), #tbl_msg ) then return end

    local random_messages = {
        "Вспомнился этот логин и пароль, а я ведь уже читал это",
        "Кажется я уже просматривал эти записи",
        "ПДА выглядит знакомым, уже просматривал его",
        "Елки-палки, это та самая ПДАшка, которую я читал ранее?",
        "Ну вот, опять этот знакомый текст, должно быть, я его уже просматривал",
        "Ага, точно помню, этот ПДА я уже держал в руках",
    }
    sak.send_tip_local(
        random_messages[ lua_random( 1, #random_messages ) ],
        "Мысли вслух", 0, 5, "g_g", "sak", "yellow"
    )
    message_given = true
end

--[[
0 С никогда не открывали
2 С открыли (включили ПДА), но пароль не подобрали
3 С пароль подобрали, но не все записи прочитали
1 С все записи прочитаны
]]--

function cheat:lock_navigation()
    navigation_locked = true
end

function cheat:remove_action_from_tbl_msg( action )
    local new_tbl = {}
    for _, v in ipairs( tbl_msg ) do
        if vergas_lib.trim( v ) ~= action then
            table.insert( new_tbl, v )
        end
    end
    tbl_msg = new_tbl
    -- подправляем number_msg если вышел за границу
    if number_msg > #tbl_msg then
        number_msg = #tbl_msg
    end
end

function cheat:remove_action_and_refresh( action )
    self:remove_action_from_tbl_msg( action )
    navigation_locked = false
    if #tbl_msg > 0 then
        number_msg = 1
		dsh.timeout( 1500, function()
            if cheat_instance then
                cheat_instance:set_msg()
            end		
		end )
    end
end

function cheat:set_pda_flag( flag_value )
    local serial = tbl_info[4]
    if not serial then return end
    
    local current_flag = string.sub( serial, 14, 14 )
    
    local priority = { ["0"] = 0, ["2"] = 1, ["3"] = 2, ["1"] = 3 }	
    if ( priority[current_flag] or 0 ) >= ( priority[flag_value] or 0 ) then 
		return 
	end
    local new_serial = string.sub( serial, 1, 13 ) .. flag_value
    tbl_info[4] = new_serial

    -- счётчик и триггеры
    if flag_value == "1" then
        local count = get_value( "pda_read_count", 0 )
        count = count + 1
        set_value( "pda_read_count", count )
        log2( "[pda_counter] Прочитано ПДА: %d", count )
    end

    for i, k in pairs( sak_inventory.eatable ) do
        if i == "device_pda_npc" then
            for j = 1, #k do
                local sobj = alife():object( k[j] )
                if sobj then
                    local pk = get_netpk( sobj, 1 )
                    local data = pk:get()
                    if strpos( data.custom_data, serial ) then
                        local old_data = data.custom_data
                        data.custom_data = string.gsub( data.custom_data, serial, new_serial )
                        pk:set( data )
						--log2("set_pda_flag: WROTE new_serial=%s cdata='%s'", new_serial, data.custom_data)		
                        vergas_pda.change_info_pda_record( old_data, data.custom_data )
                        break
                    end
                end
            end
        end
    end
end

function cheat:set_tbl_msg()													--формирование таблицы номеров сообщений
	tbl_msg = vergas_lib.str_explode(",",tbl_info[5],true)
	number_msg = 1
end

function cheat:replace_record_msg( mode_r )
    if mode_r == 1 then
        if number_msg == #tbl_msg then
            number_msg = 1
        else
            number_msg = number_msg + 1
        end
    else
        if number_msg == 1 then
            number_msg = #tbl_msg
        else
            number_msg = number_msg - 1
        end
    end

    seen_messages[number_msg] = true
    self:set_msg()

    if string.sub( tbl_info[4], 14, 14 ) == "1" then return end

    local count = 0
    for _ in pairs( seen_messages ) do count = count + 1 end
    if count >= #tbl_msg then
        all_seen = true
    end

    if all_seen and number_msg == start_msg then
        self:set_pda_flag( "1" )	-- Прочитали весь ПДА
        local random_messages = {
            "Кажется, я просмотрел все записи",
            "Всё, больше записей нет",
            "Прочитал всё что было в этой ПДАшке",
            "Записи закончились, всё изучено",
            "Ну вот, все записи просмотрены",
        }
        sak.send_tip_local(
            random_messages[ lua_random( 1, #random_messages ) ],
            "Мысли вслух", 0, 5, "g_g", "sak", "yellow"
        )
    end
end

function cheat:set_treasure()
    if tbl_info[7] == "1" then return end

    -- считаем количество тайников
    local shroni = {}
    for s in string.gmatch( tostring( tbl_info[6] ), "([^,]+)" ) do
        local s_trim = vergas_lib.trim( s )
        if s_trim ~= "0" then
            table.insert( shroni, s_trim )
        end
    end
    
    if #shroni == 0 then return end

    if #shroni == 1 then
        -- старая логика С выдаём при показе записи
        if not flag_treasure then return end
        treasure_manager.get_treasure_manager():give_treasure( shroni[1], nil, true )
        self:set_status_pda()
    else
        -- несколько тайников С выдаём только когда все записи прочитаны
        if not all_seen then return end
        for _, s in ipairs( shroni ) do
            treasure_manager.get_treasure_manager():give_treasure( s, nil, true )
        end
        self:set_status_pda()
    end
end

function cheat:set_info_pda()													--формирование таблицы данных выбранного ПДА
	local tbl = vergas_pda.get_pda_info()
	local n = vergas_pda.get_number_record()
	tbl_info = vergas_lib.str_explode("|",tbl[n],true)
	-- log2("set_info_pda: n = %d",n)
	-- for k,v in pairs(tbl_info) do
		-- log2("%s = %s",k,v)
	-- end
end

function cheat:get_community()
    local grup_n = string.sub( tbl_info[ 4 ], 7, 8 )
    local communities = {
        [ "01" ] = "stalker",
        [ "02" ] = "military",
        [ "03" ] = "bandit",
        [ "04" ] = "dolg",
        [ "05" ] = "freedom",
        [ "06" ] = "monolith",
        [ "07" ] = "killer",
        [ "08" ] = "ecolog",
        [ "09" ] = "green"
    }
    return communities[ grup_n ]
end

function cheat:set_status_pda()
	local i
	local j
	local k
	local record_old
	local record_new
	local t = vergas_pda.get_pda_info()
	local n = vergas_pda.get_number_record()
	
	for i, k in pairs( sak_inventory.eatable ) do
		if i == "device_pda_npc" then
			for j = 1, table.getn( k ) do
				local sobj = alife():object( k[ j ] )
				if sobj then
					local net_pak = get_netpk( sobj, 1 )
					local record =  net_pak:get()
					if t[n] == record.custom_data then
						record_old = t[ n ]
						record.custom_data = string.sub( t[ n ], 1, string.len( t[ n ] ) - 1 ) .. "1"
						record_new = record.custom_data
						net_pak:set( record )
					end
				end
			end
		end
	end
	flag_treasure = false
	tbl_info[ 7 ] = "1" -- защита от повторной установки тайника при повторном просмотре записи в одной сессии
	vergas_pda.change_info_pda_record( record_old, record_new ) -- защита от повторной установки тайника при повторном включении ПДА в одной сессии
end
	
function readFlashData()
	return anagramm_flash.read_data()
end

function writeFlashData( flashData )
	anagramm_flash.write_data( flashData )
end

function removeFlashData( flashIdToRemove )
	anagramm_flash.remove( flashIdToRemove )
end

function UpdateFlashData( flashIdToUpdate, Cond )
	anagramm_flash.update( flashIdToUpdate, Cond )
end

function cheat:SolveAnagramm()
	local flash = db.actor:object( "anagramm_flash" )
	if not flash then
		sak.send_tip( "Флешка не найдена", "Ошибка инициализации устройсва:", 0, 5, "flash", "no", "red" )
		return
	end

	local flashId = tostring( flash:id() )

	local stored = anagramm_flash.get( flashId )
	if stored and flash:condition() > stored + 0.001 then
		params.upd_condition( flash, stored )
	end

	if flash:condition() == 0 then
		sak.send_tip(
			"Внимание! Очистите устройство!",
			"Ошибка инициализации памяти девайса", 0, 5, "flash", "no", "red"
		)
		return
	else
		sak.send_tip(
			"Процедура подбора пароля запущена",
			"Девайс подключен:", 0, 5, "flash", "no", "yellow"
		)
	end

	local password = tbl_info[ 2 ]
	local current = string.rep( "*", #password )
	local delay = 50
	local alphabet = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789abcdefghijklmnopqrstuvwxyz"
	self.solving_anagramm = true

	local condition_loss_per_char = 0.0025 * ( #password / 3 )

	local function saveCondition()
		local final_condition = math.floor( flash:condition() * 100 ) / 100
		anagramm_flash.update( flashId, final_condition )
	end

	local function aborted()
		if cheat_instance ~= self or not self.solving_anagramm then
			self.solving_anagramm = false
			saveCondition()
			return true
		end
		return false
	end

	local function updatePassword()
		if cheat_instance ~= self then
			self.solving_anagramm = false
			saveCondition()
			return
		end
		if not self.solving_anagramm or current == password then
			sak.send_tip(
				"Процедура подбора пароля успешно завершена",
				"Девайс отключён:", 0, 5, "flash", "no", "green"
			)
			vergas_lib.s_play( vergas_lib.set_pr_from_config_str( "list_sounds_pda", "snd_pass_ok" ), 1 )
			self.solving_anagramm = false

			saveCondition()
			v_pass = password
			self:password_check()
			return
		end

		local index = math.random( 1, #password )
		while current:sub( index, index ) ~= "*" do
			index = math.random( 1, #password )
		end

		local targetLetter = password:sub( index, index )
		local currentIndex = 1
		local tries = 0
		vergas_lib.s_play( vergas_lib.set_pr_from_config_str( "list_sounds_pda", "snd_klik_pda" ), 1 )

		local function cycleLetter()
			if aborted() then return end
			if tries > #alphabet then
				self.solving_anagramm = false
				saveCondition()
				sak.send_tip(
					"Процедура подбора пароля прервана",
					"Внимание! Неизвестный символ в пароле:", 0, 5, "flash", "no", "red"
				)
				return
			end
			tries = tries + 1
			local currentLetter = alphabet:sub( currentIndex, currentIndex )
			current = current:sub( 1, index - 1 ) .. currentLetter .. current:sub( index + 1 )
			v_pass = current
			self:set_wnd_ps( 2 )
			if currentLetter ~= targetLetter then
				currentIndex = currentIndex % #alphabet + 1
				dsh.timeout( delay, cycleLetter )
			else
				local new_condition = params.add_condition( flash, -condition_loss_per_char )
				saveCondition()
				if new_condition <= 0 then
					self.solving_anagramm = false
					sak.send_tip(
						"Процедура подбора пароля прервана",
						"Внимание! Закончилось свободное место:", 0, 5, "flash", "no", "red"
					)
					return
				end
				dsh.timeout( delay * 2, updatePassword )
			end
		end

		cycleLetter()
	end

	updatePassword()
end

