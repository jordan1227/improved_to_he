function cheat:__init(owner) super()
	self.owner = owner
	self:InitControls()
	self:InitCallBacks()
	cheat_instance = self	
end

function cheat:InitControls()

	-- Положение и размеры окна
	self:Init(400,225-75,624,543)
	
	self:set_info_pda()
	mode = 1
    self:set_pda_flag( "2" )	-- Если открывали, установим марк в 2, чтобы можно было понять, подобрали пасс или нет		
	--подскажем ненавязчиво: скока буковок в пароле
	local i
	v_pass = ""
	if tbl_info and tbl_info[ 2 ] and tbl_info[ 2 ] ~= 0 then
		for i = 1, string.len( tbl_info[ 2 ] ) do
			v_pass = v_pass .. "*" 
		end
	else 
		v_pass = "****************"
	end
	dummy_asterisks = v_pass
	
	-- для дебага и установки пароля
	if generate_pass then
		v_pass = tbl_info[ 2 ]
		dsh.timeout( 300, function() self:password_check() end )
	end		
	
	--выбираю стекло
	texture_steklo = vergas_pda.set_get_steklo()
	
	self:set_wnd_pda()			--текстура ПДА
	self:set_wnd_nm()			--имя непися
	self:set_wnd_sn()			--служебный номер ПДА
	self:set_wnd_lg()			--логин
	self:set_wnd_ps(1)			--пароль
	self:set_wnd_signal()		--уровень сигнала
	self:set_wnd_batt()			--зарядка батареи
	self:set_wnd_calendar()		--текущая дата
	self:set_wnd_clocks()		--текущее время
	flag_show_signal_time = true			--запускаю демонстрацию
	schedule.add("show_pda_signal", "ui_cheat_pda.cheat:show_signal_time()", 3000)
	
	-- файл-описатель элементов
	local xml = CScriptXmlInit()
	local lang = get_console():get_token("g_language")
	if lang and lang == "rus" then
		xml:ParseFile("ui_cheat_pda_npc.xml")
	elseif lang and lang == "eng" then
		xml:ParseFile("ui_cheat_pda_npc_eng.xml")
	else
		log2("[ui_cheat_pda.script] #ERROR: can't get lang token")
		return
	end
	
	--1600x900
	-- self:Register(xml:Init3tButton("btn_a1_1", self),"btn_a_1")			--  нопка "АБВГ"
	-- self:Register(xml:Init3tButton("btn_a1_2", self),"btn_a_2")			--  нопка "ДЕЖЗ"
	-- self:Register(xml:Init3tButton("btn_a1_3", self),"btn_a_3")			--  нопка "ИЙ Л"
	-- self:Register(xml:Init3tButton("btn_a1_4", self),"btn_a_4")			--  нопка "МНОП"
	-- self:Register(xml:Init3tButton("btn_a1_5", self),"btn_a_5")			--  нопка "РСТУ"
	-- self:Register(xml:Init3tButton("btn_a1_6", self),"btn_a_6")			--  нопка "ФХЦЧ"
	-- self:Register(xml:Init3tButton("btn_a1_7", self),"btn_a_7")			--  нопка "ШЩЪЫ"
	-- self:Register(xml:Init3tButton("btn_a1_8", self),"btn_a_8")			--  нопка "ЬЁёя"
	
	for i=1,8 do
		local button_texture_name = (lang == "rus" and "btn_a1_" .. tostring(i)) or "btn_a1_" .. tostring(i) .. "_eng"
		self:Register(xml:Init3tButton(button_texture_name, self),"btn_a_" .. tostring(i))
	end
	
	for i=1,5 do
		if i ~= 3 then
			local button_texture_name = (lang == "rus" and "btn_u1m_" .. tostring(i)) or "btn_u1m_" .. tostring(i) .. "_eng"
			self:Register(xml:Init3tButton(button_texture_name, self),"btn_u_" .. tostring(i))
		end
	end

	-- self:Register(xml:Init3tButton("btn_u1m_1", self),"btn_u_1")			--  нопка "Ввод"
	-- self:Register(xml:Init3tButton("btn_u1m_2", self),"btn_u_2")			--  нопка "<=="
	-- self:Register(xml:Init3tButton("btn_u_3", self),"btn_u_3")			--  нопка "конверт"
	-- self:Register(xml:Init3tButton("btn_u1m_4", self),"btn_u_4")			--  нопка "==>"
	-- self:Register(xml:Init3tButton("btn_u1m_5", self),"btn_u_5")			--  нопка "Выход"

	self:wnd_steklo()			--стекло
	--self:lock_conflicting_keys()
end

function cheat:InitCallBacks()
	self:AddCallback("btn_a_1", ui_events.BUTTON_CLICKED, self.btn_a_1, self) 			--  нопка "АБВГ"
	self:AddCallback("btn_a_2", ui_events.BUTTON_CLICKED, self.btn_a_2, self) 			--  нопка "ДЕЖЗ"
	self:AddCallback("btn_a_3", ui_events.BUTTON_CLICKED, self.btn_a_3, self) 			--  нопка "ИЙ Л"
	self:AddCallback("btn_a_4", ui_events.BUTTON_CLICKED, self.btn_a_4, self) 			--  нопка "МНОП"
	self:AddCallback("btn_a_5", ui_events.BUTTON_CLICKED, self.btn_a_5, self) 			--  нопка "РСТУ"
	self:AddCallback("btn_a_6", ui_events.BUTTON_CLICKED, self.btn_a_6, self) 			--  нопка "ФХЦЧ"
	self:AddCallback("btn_a_7", ui_events.BUTTON_CLICKED, self.btn_a_7, self) 			--  нопка "ШЩЪЫ"
	self:AddCallback("btn_a_8", ui_events.BUTTON_CLICKED, self.btn_a_8, self) 			--  нопка "ЬЁёя"
	
	self:AddCallback("btn_u_1", ui_events.BUTTON_CLICKED, self.btn_u_1, self) 			--  нопка "Ввод"
	self:AddCallback("btn_u_2", ui_events.BUTTON_CLICKED, self.btn_u_2, self) 			--  нопка "<=="
	--self:AddCallback("btn_u_3", ui_events.BUTTON_CLICKED, self.btn_u_3, self) 			--  нопка "конверт"
	self:AddCallback("btn_u_4", ui_events.BUTTON_CLICKED, self.btn_u_4, self) 			--  нопка "==>"
	self:AddCallback("btn_u_5", ui_events.BUTTON_CLICKED, self.btn_stop, self) 			--  нопка "Выход"
end

function get_keyname_for_action(action_id)
    local dik = bind_to_dik(action_id)
    if not dik or dik == 0 then return nil end
    return dik_to_keyname(dik)
end

function cheat:lock_conflicting_keys()
    if binds_locked then return end

    local pause_key   = get_keyname_for_action(key_bindings.kPAUSE)
    local console_key = get_keyname_for_action(key_bindings.kCONSOLE)

    if pause_key then
        saved_binds['pause'] = pause_key
        cmd("unbind", "pause")
    end
    if console_key then
        saved_binds['console'] = console_key
        cmd("unbind", "console")
    end

    binds_locked = true
end

function cheat:unlock_conflicting_keys()
    if not binds_locked then return end

    for command_name, keyname in pairs(saved_binds) do
        cmd("bind", command_name .. " " .. keyname)
    end

    saved_binds = {}
    binds_locked = false
end

--=============================== НОП И============================================

function cheat:close_for_reflash()
    self:unlock_conflicting_keys()
    flag_show_signal_time = false
    self:del_windows()

    keyboard_allowed = true
    seen_messages = {}
    message_given = false
    was_read_on_open = false
    all_seen = false
    start_msg = nil
    cheat_instance = nil
    navigation_locked = false

    self:GetHolder():start_stop_menu( self, true )
    used_items.set_get_flag_use_gadget( 1, true )
    bind_stalker.restore_weapon()
    self:ClearCallbacks()
end

function cheat:btn_stop()								-- Кнопка Выкл
	self:unlock_conflicting_keys() 		--возвращаем кнопки
	flag_show_signal_time = false		--отключаю демонстрацию
	self:set_treasure()					--установка тайника
	self:del_windows()
	vergas_lib.s_play(vergas_lib.set_pr_from_config_str("list_sounds_pda","snd_finish_pda"),1)
	
    keyboard_allowed = true
    seen_messages = {}
    message_given = false
    was_read_on_open = false
    all_seen = false
    start_msg = nil
    cheat_instance = nil
	navigation_locked = false	
	
	self:GetHolder():start_stop_menu (self,true)
    if vergas_pda.get_tbl_sn_count() > 0 then
        vergas_pda.start_search_pda( 2 )
    else
        bind_stalker.restore_weapon()
        used_items.set_get_flag_use_gadget( 1, true )
    end
	self:ClearCallbacks()
end

function cheat:btn_a_1()					--  нопка "АБВГ"
	local tbl = {}
	
	if mode == 2 then
		return
	end
	
	self:set_btn_klik(1,4)
	
	local lang = get_console():get_token("g_language")
	if lang and lang == "rus" then
		table.insert(tbl, "а")
		table.insert(tbl, "б")
		table.insert(tbl, "в")
		table.insert(tbl, "г")
	elseif lang and lang == "eng" then
		table.insert(tbl, "a")
		table.insert(tbl, "b")
		table.insert(tbl, "c")
		table.insert(tbl, "d")
	end
	
	
	self:password_formation(self:symbol_choice(tbl))
end

