function  cheat:set_wnd_ps(mode_p)		--пароль
--mode_p = 1 - стекло не ставлю	
--mode_p = 2 - стекло ставлю	

	if self.wnd_ps ~= nil then
		self:DetachChild(self.wnd_ps)
		self.wnd_ps = nil
	end
	
	if mode_p == 2 then
		if self.wnd_steklo ~= nil then
			self:DetachChild(self.wnd_steklo)
			self.wnd_steklo = nil
		end
	end
	
	self.wnd_ps = CUIStatic()
	self.wnd_ps:SetAutoDelete(true)
	self:AttachChild(self.wnd_ps)
	self.wnd_ps:SetStretchTexture(true)
	self.wnd_ps:SetWndRect(323, 340, 215, 40)
	self.wnd_ps:SetTextColor(225, 0, 0, 0)		
	self.wnd_ps:SetFont(GetFontLetterica18Russian())
