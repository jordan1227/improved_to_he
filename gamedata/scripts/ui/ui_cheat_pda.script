function cheat:OnKeyboard( dik, keyboard_action )
	CUIScriptWnd.OnKeyboard( self, dik, keyboard_action )
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		-- Sn: хз, должно по идее разделение здесь работать
		local lang = get_console():get_token("g_language")
		local tbl = (lang == "rus" and keyboard) or keyboard_eng
		
        -- Остановка перебора при любом нажатии клавиши
        if self.solving_anagramm then
            self.solving_anagramm = false
			vergas_lib.s_play( vergas_lib.set_pr_from_config_str( "list_sounds_pda", "snd_pass_no" ), 1 )
			sak.send_tip( 
				"Процедура подбора пароля прервана пользователем", 
				"Девайс отключён:", 0, 5, "flash", "no", "red" 
			)						
            return true
        end			
		
        if not navigation_locked and ( dik == DIK_keys.DIK_RETURN or dik == DIK_keys.DIK_NUMPADENTER ) then 
            self:password_check()
		elseif keyboard_allowed and dik == DIK_keys.DIK_BACK then 
			self:BackSpace()
		elseif dik == DIK_keys.DIK_ESCAPE then 
			self:btn_stop()
		elseif dik == DIK_keys.DIK_PRIOR then
			if #tbl_msg > 1 then self:btn_u_2() end
		elseif dik == DIK_keys.DIK_NEXT then
			if #tbl_msg > 1 then self:btn_u_4() end  
		elseif keyboard_allowed and dik == DIK_keys.DIK_END then 
			self:SolveAnagramm()			
		elseif keyboard_allowed and tbl[ dik ] then
			if string.sub ( v_pass, 1 , 1 ) == "*" then v_pass = "" end		
			if string.len( v_pass ) < string.len( tbl_info[ 2 ] ) then
				v_pass = v_pass .. keyboard[ dik ]
				self:set_wnd_ps( 2 )
				vergas_lib.s_play( vergas_lib.set_pr_from_config_str( "list_sounds_pda", "snd_klik_pda" ), 1 )
			end
		end
	end
	return true
end

function cheat:BackSpace()
	if v_pass ~= "" and string.len( v_pass ) > 1 then
		v_pass = string.sub( v_pass, 1, string.len( v_pass ) - 1 )	
		self:set_wnd_ps( 2 )		
	else
		v_pass = dummy_asterisks
		self:set_wnd_ps( 2 )
	end
	vergas_lib.s_play( vergas_lib.set_pr_from_config_str( "list_sounds_pda", "snd_klik_pda" ), 1 )
end