-------------------------------------------------------------------------
--ВСПОМОГАТЕЛЬНЫЕ УНКЦИИ
-------------------------------------------------------------------------

function cheat:del_windows()

	if wnd_1 ~= nil then 
		self:DetachChild(wnd_1)
		wnd_1 = nil			--ячейка 1
	end
	if wnd_2 ~= nil then
		self:DetachChild(wnd_2)
		wnd_2 = nil			--ячейка 2
	end	
	if wnd_3 ~= nil then
		self:DetachChild(wnd_3)
		wnd_3 = nil			--ячейка 3
	end	
	if wnd_4 ~= nil then
		self:DetachChild(wnd_4)
		wnd_4 = nil			--ячейка 4
	end	
	if wnd_pic_1 ~= nil then 
		self:DetachChild(wnd_pic_1)
		wnd_pic_1 = nil			--ячейка 1
	end
	if wnd_pic_2 ~= nil then
		self:DetachChild(wnd_pic_2)
		wnd_pic_2 = nil			--ячейка 2
	end	
	if wnd_pic_3 ~= nil then
		self:DetachChild(wnd_pic_3)
		wnd_pic_3 = nil			--ячейка 3
	end	
	if wnd_pic_4 ~= nil then
		self:DetachChild(wnd_pic_4)
		wnd_pic_4 = nil			--ячейка 4
	end	
	if wnd_pocket ~= nil then 
		self:DetachChild(wnd_pocket)
		wnd_pocket = nil			--ячейка чехла
	end
	if wnd_pic_pocket ~= nil then 
		self:DetachChild(wnd_pic_pocket)
		wnd_pic_pocket = nil			--ячейка чехла
	end
	
end

function cheat:stop_btn()
	if btn_old == 1 then
		self:set_wnd_1(1)
	elseif btn_old == 2 then
		self:set_wnd_2(1)
	elseif btn_old == 3 then
		self:set_wnd_3(1)
	elseif btn_old == 4 then
		self:set_wnd_4(1)
	end
end

function cheat:reassign(btn)
	local n
	if btn == 1 then
		n = 1
	elseif btn == 2 then
		n = 3
	elseif btn == 3 then
		n = 5
	elseif btn == 4 then
		n = 7
	end
	
	return n
end

function cheat:take_in_cover(btn)
    local n = self:reassign(btn)
    
    if not info_rug[n] or info_rug[n] == "?" then return end

	-- Прячем флягу при помещении в слот
	kotovod.storage_hide_by_id(info_rug[n])
    
    info_chhl[1] = info_rug[n]
    info_chhl[2] = info_rug[n+1]
    info_rug[n] = "?"
    info_rug[n+1] = 0
end

function cheat:klik_btn(btn,record)
	if info_chhl[1] ~= "?" and btn_old ~= 0 then
		--в чехле уже есть фляга
		self:stop_btn()
		btn_old = 0
		return
	end
	
	if info_rug[record] == "?" then
		if btn_old ~= 0 then
			self:stop_btn()
			btn_old = 0
			return
		end
	end
	
	if btn_old == 0 then
		--активной кнопки нет, первое нажатие на кнопку
		btn_old = btn
		self:set_window(btn,2)
	else
		if btn_old ~= btn then
			--была нажата другая кнопка
			self:stop_btn()
			btn_old = 0
		else
			--второе нажатие на кнопку
			--btn_old = 0
			self:take_in_cover(btn)
			self:set_window(btn,1)
			self:set_wnd_pocket(2)
			self:stop_btn()
			btn_old = 0
		end
	end
	vergas_lib.s_play(vergas_lib.set_pr_from_config_str("bag_on_belt","snd_load","bag_on_belt_n"),1)
end

function cheat:set_window(btn,regime)
	if btn == 1 then
		self:set_wnd_1(regime)
	elseif btn == 2 then
		self:set_wnd_2(regime)
	elseif btn == 3 then
		self:set_wnd_3(regime)
	elseif btn == 4 then
		self:set_wnd_4(regime)
	end
end

function cheat:reset_windows()
	btn_old = 0
	self:set_wnd_1(1)
	self:set_wnd_2(1)
	self:set_wnd_3(1)
	self:set_wnd_4(1)
end

function cheat:flask_number(flask_id)
	local i
	local n = 0
	for i = 1,#flask_number,2 do
		if flask_id == flask_number[i] then
			n = flask_number[i+1]
			break
		end
	end 
	return n
end

function cheat:get_pictogram_index( water_amount )
    return math.max( 0, math.min( 4, water_amount - 1 ) )
end

function cheat:write_data()
    if info_chhl[1] ~= "?" then
        local obj = client_obj(info_chhl[1])
        if obj then
            set_flask_water(obj, info_chhl[2])
			set_value( "equipped_flask", info_chhl[1] )
        end
    else
        remove_value( "equipped_flask" )
    end
    for i = 1, #info_rug, 2 do
        if info_rug[i] ~= "?" then
            local obj = client_obj(info_rug[i])
            if obj then
                set_flask_water(obj, info_rug[i+1])
            end
        end
    end
end

function get_flask_water( obj )
    local eat = obj:get_eatable_item()
    return eat.eat_portions_num
end

function set_flask_water( obj, amount )
	if not obj then return end
	if not amount then amount = 1 end
    local eat = obj:get_eatable_item()
	if eat then 	
		eat.eat_portions_num = amount
	end	
	vergas_flask.replace_flask_weight( obj.id, amount )
end

function hide_flask_on_load()
	local flask = get_value( "equipped_flask", nil )
	if not flask then return end 
	kotovod.storage_hide_by_id( flask )	
end

function get_equipped_flask()
	local id = get_value( "equipped_flask", nil )
	return id and client_obj( id ) or nil
end

function data_collection(mode)
    local tbl_ch = {}    -- фляжка в чехле
    local tbl_r  = {}    -- фляжки в рюкзаке
    local tbl_n  = {}    -- номера фляжек
    
	local flask = get_value( "equipped_flask", nil )
	
	if db.actor then
		local equipped_flask_found = false
		for i = 0, db.actor:object_count() - 1 do
			local obj = db.actor:object( i )
			if razgruzka.check_obj( obj ) and obj:section() == "flask_army" then
				local obj_id = obj:id()
            
				-- Проверяем, является ли этот объект экипированной флягой
				if flask and flask == obj_id then
					tbl_ch[1] = obj_id
					tbl_ch[2] = get_flask_water( obj )
					equipped_flask_found = true
				else
					table.insert( tbl_r, obj_id )
					table.insert( tbl_r, get_flask_water( obj ) )
				end
			end
		end
    
		-- Если экипированная фляга не найдена, сбрасываем
		if not equipped_flask_found and flask then
			remove_value( "equipped_flask" )
		end
	end

	-- Удаляем экипированную флягу из tbl_r, если она там есть
	if #tbl_ch > 0 then
		for i = 1, #tbl_r, 2 do
			if tbl_r[i] == tbl_ch[1] then
				table.remove(tbl_r, i)
				table.remove(tbl_r, i)
				break
			end
		end
	end
    
    -- Если надо, добавляем в таблицы записи-пустышки
    if #tbl_r < 8 then
        tbl_r = razgruzka.set_record_nil(tbl_r, 8)
    end
    if #tbl_ch == 0 then
        table.insert(tbl_ch, "?")
        table.insert(tbl_ch, 0)
    end
    
    -- присваиваем фляжкам номера
    local n = 1
    for i = 1, #tbl_r, 2 do
        if tbl_r[i] ~= "?" then
            table.insert(tbl_n, tbl_r[i])
            table.insert(tbl_n, n)
            n = n + 1
        end
    end
    if tbl_ch[1] ~= "?" then
        table.insert(tbl_n, tbl_ch[1])
        table.insert(tbl_n, n)
    end  
    
    if mode == 1 then
        return tbl_r, tbl_ch, tbl_n
    elseif mode == 2 then
        return tbl_ch
    end
end