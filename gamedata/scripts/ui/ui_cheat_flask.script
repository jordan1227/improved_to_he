Vergas
© NLC-6.0
]]--

class "cheat" (CUIScriptWnd)

local wnd_1			--ячейка 1
local wnd_2			--ячейка 2
local wnd_3			--ячейка 3
local wnd_4			--ячейка 4
local win_pic_1		--пиктограмма ячейки 1
local win_pic_2		--пиктограмма ячейки 2
local win_pic_3		--пиктограмма ячейки 3
local win_pic_4		--пиктограмма ячейки 4
local win_pocket	--ячейка чехла
local win_pic_pocket	--пиктограмма ячейки чехла

local btn_old = 0			--номер предыдущей нажатой кнопки

local info_rug = {}  				--информация для чехла (что положить)
local info_chhl = {}  				--информация для чехла (что лежит)
local flask_number = {}

function cheat:__init(owner) 
	super()
	self.owner = owner
	self:InitControls()
	self:InitCallBacks()
end

function cheat:InitControls()

	-- Положение и размеры окна
	self:Init(314,0,395,512)
	-- файл-описатель элементов
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_cheat_flask.xml")
	
	xml:InitStatic("background_0", self)     	--Стекло
	xml:InitStatic("background", self)     		--Собственно рамка

	self:Register(xml:InitButton("btn_stop", self),"btn_stop")		-- Кнопка Выкл
	self:Register(xml:InitButton("btn_empty", self),"btn_empty")		-- Кнопка Выгрузить
	self:Register(xml:InitButton("btn_pour", self),"btn_pour")		-- Кнопка Перелить
	self:Register(xml:InitButton("btn_left", self),"btn_left")		-- Кнопка прокрутки слотов влево
	self:Register(xml:InitButton("btn_right", self),"btn_right")		-- Кнопка прокрутки слотов вправо
	self:Register(xml:InitButton("btn_wash", self),"btn_wash")		-- Кнопка помывки стекла
	self:Register(xml:InitButton("btn_drink", self),"btn_drink")
	self:Register(xml:InitButton("btn_1", self),"btn_1")				-- Кнопка 1 
	self:Register(xml:InitButton("btn_2", self),"btn_2")				-- Кнопка 2 
	self:Register(xml:InitButton("btn_3", self),"btn_3")				-- Кнопка 3 
	self:Register(xml:InitButton("btn_4", self),"btn_4")				-- Кнопка 4 

end

function cheat:InitCallBacks()

	self:AddCallback("btn_stop", ui_events.BUTTON_CLICKED, self.btn_stop, self) 		-- Кнопка Выкл
	self:AddCallback("btn_empty", ui_events.BUTTON_CLICKED, self.btn_empty, self) 		-- Кнопка Выгрузить
	--self:AddCallback("btn_pour", ui_events.BUTTON_CLICKED, self.btn_pour, self) 		-- Кнопка Перелить
	self:AddCallback("btn_left", ui_events.BUTTON_CLICKED, self.btn_left, self)			-- Кнопка прокрутки слотов влево
	self:AddCallback("btn_right", ui_events.BUTTON_CLICKED, self.btn_right, self)		-- Кнопка прокрутки слотов влево
	self:AddCallback("btn_wash", ui_events.BUTTON_CLICKED, self.btn_wash, self)		-- Кнопка помывки стекла
	self:AddCallback("btn_drink", ui_events.BUTTON_CLICKED, self.btn_drink, self)	    -- Љнопка пить воду		
	self:AddCallback("btn_1", ui_events.BUTTON_CLICKED, self.btn_1, self) 				-- Кнопка 1 
	self:AddCallback("btn_2", ui_events.BUTTON_CLICKED, self.btn_2, self) 				-- Кнопка 2 
	self:AddCallback("btn_3", ui_events.BUTTON_CLICKED, self.btn_3, self) 				-- Кнопка 3 
	self:AddCallback("btn_4", ui_events.BUTTON_CLICKED, self.btn_4, self) 				-- Кнопка 4 
	
	info_rug, info_chhl, flask_number = data_collection(1)
    
    --[[
    wprintf(" flask_number: ")
    misc.dump_table(flask_number)
    wprintf(" info_rug : ")
    misc.dump_table(info_rug)
    wprintf(" info_chhl: ")
    misc.dump_table(info_chhl)      
    --]]
    
	self:init_windows()
	self:set_wnd_1(1)
	self:set_wnd_2(1)
	self:set_wnd_3(1)
	self:set_wnd_4(1)
	if info_chhl[1] == "?" then
		self:set_wnd_pocket(1)
	else
		self:set_wnd_pocket(2)
	end
end

-- Вынесение таблицы за пределы метода
local decant_map = {
	[DIK_keys.DIK_1] = 1,
	[DIK_keys.DIK_2] = 2,
	[DIK_keys.DIK_3] = 3,
	[DIK_keys.DIK_4] = 4,
}

function cheat:handleDecantKey(dik)
    local decant_value = decant_map[dik]
    if not decant_value then return end
    
    self.decant = decant_value
    local water_amount = info_chhl[2]
    
    -- Проверка, пуста ли фляга или содержит слишком мало воды
    if not water_amount or water_amount <= 1 then
        local phrases = {
            "Чёрт возьми, фляга почти пуста! Ни капли не осталось...",
            "Да тут же пусто! И когда я успел всё выпить?",
            "Воды нет... Надо бы наполнить флягу при случае.",
            "Пусто как в кармане после визита к Сидоровичу...",
            "Хоть бы капля осталась... Но нет, всё высохло."
        }
        sak.send_tip(
            phrases[math.random(#phrases)],
            "Мысли вслух", 0, 5, "g_g", "no", "red"
        )
        return
    end
    
    -- Рассчитываем доступные порции и определяем, что показать
    local available_portions = water_amount - 1
    local requested_portions = decant_value
    local usable_portions = math.min(available_portions, requested_portions)
    
    local available_ml = math.floor(usable_portions * 187.5)
    
    if usable_portions < requested_portions then
        local phrases = {
            "Маловато будет... Только %d мл осталось",
            "Хм, всего %d мл воды. Придётся экономить",
            "Эх, всего %d мл. Ну, и это сгодится",
            "Негусто... %d мл - повезло, что вообще хоть что-то осталось",
            "Только %d мл? Ладно, хватит и этого"
        }
        local chosen_phrase = phrases[math.random(#phrases)]
        sak.send_tip(
            string.format(chosen_phrase, available_ml),
            "Мысли вслух", 0, 5, "g_g", "no", "yellow"
        )
    else
        local phrases = {
            "Так, отмерим %d мл воды...",
            "%d мл - вот что мне нужно.",
            "Использую %d мл. Должно хватить.",
            "%d мл воды будет в самый раз."
        }
        local chosen_phrase = phrases[math.random(#phrases)]
        sak.send_tip(
            string.format(chosen_phrase, available_ml),
            "Мысли вслух", 0, 5, "g_g", "no", "yellow"
        )
    end
    
    -- Обновляем значение decant на фактически используемое
    self.decant = usable_portions
end

function cheat:OnKeyboard( dik, keyboard_action )
	CUIScriptWnd.OnKeyboard( self, dik, keyboard_action )
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		--if dik == DIK_keys.DIK_ESCAPE or dik == bind_to_dik( key_bindings.kOPN_FLASK ) then
		local he_mask = bind_to_dik(key_bindings.kMASK_CONTROL)
		local he_flask = bind_to_dik(key_bindings.kOPN_FLASK)
		if dik == DIK_keys.DIK_ESCAPE
			or (he_mask and he_mask > 0 and dik == he_mask)
			or (he_flask and he_flask > 0 and dik == he_flask) then
			self:btn_stop()
		elseif dik == DIK_keys.DIK_A then
			self:btn_left()
		elseif dik == DIK_keys.DIK_D then
			self:btn_right()
		else
			self:handleDecantKey( dik )
		end
	end
	return true
end

function cheat:on_quit()
	btn_old = 0
	info_rug = {} 
	info_chhl = {}
	flask_number = {}
	self:del_windows()
	used_items.set_get_flag_use_gadget(1,true)
	self:GetHolder():start_stop_menu (self,true)
	vergas_lib.s_play(vergas_lib.set_pr_from_config_str("bag_on_belt","snd_deselect","bag_on_belt_n"),1)
	razgruzka.inventory_on_off(false)
	bind_stalker.restore_weapon()
	level.enable_input()
	self:ClearCallbacks()
end

function cheat:on_work_quit()
	btn_old = 0
	info_rug = {} 
	info_chhl = {}
	flask_number = {}
	self:del_windows()
	used_items.set_get_flag_use_gadget(1,true)
	self:GetHolder():start_stop_menu (self,true)
	vergas_lib.s_play(vergas_lib.set_pr_from_config_str("bag_on_belt","snd_deselect","bag_on_belt_n"),1)
	razgruzka.inventory_on_off_work(false)
	bind_stalker.restore_weapon()
	level.enable_input()
end

function cheat:btn_stop()
	self:write_data()
	self:on_quit()
end

function cheat:btn_left()
	info_rug = razgruzka.step_left(info_rug,8)
	vergas_lib.s_play(vergas_lib.set_pr_from_config_str("bag_on_belt","snd_scroll","bag_on_belt_n"),1)
	self:reset_windows()
end

function cheat:btn_right()
	info_rug = razgruzka.step_right(info_rug,8)
	vergas_lib.s_play(vergas_lib.set_pr_from_config_str("bag_on_belt","snd_scroll","bag_on_belt_n"),1)
	self:reset_windows()
end

function cheat:btn_pour()
    if btn_old == 0 then
        return
    end
    
    local source_flask = client_obj(info_rug[self:reassign(btn_old)])
    local target_flask = client_obj(info_chhl[1])
    
    if not source_flask or not target_flask then
        return
    end
    
    if get_flask_water(source_flask) == 1 or get_flask_water(target_flask) == 5 then
        self:stop_btn()
        btn_old = 0
        return
    end
    
    vergas_lib.s_play([[device\masks\flask_flask]], 1)
    
    local source_water = get_flask_water(source_flask)
    local target_water = get_flask_water(target_flask)
    local transfer = math.min(5 - target_water, source_water - 1)
    
    set_flask_water(source_flask, source_water - transfer)
    set_flask_water(target_flask, target_water + transfer)
    
    info_rug[self:reassign(btn_old) + 1] = get_flask_water(source_flask)
    info_chhl[2] = get_flask_water(target_flask)
    
    self:set_window(btn_old, 1)
    self:set_wnd_pocket(2)
    btn_old = 0
end

function cheat:btn_empty()
    if info_chhl[1] == "?" then
        return
    end

    local flask = client_obj(info_chhl[1])
    if not flask then
        return
    end
	
	-- Восстанавливаем флягу для отображения в рюкзаке
    kotovod.storage_show_by_id(info_chhl[1])	
    
    local i
    local n = 0
    local flag = true
    
    for i = 1, #info_rug, 2 do
        if info_rug[i] == "?" then
            info_rug[i] = info_chhl[1]
            info_rug[i+1] = get_flask_water(flask)
            n = i
            flag = false
            break
        end
    end
    
    if flag then
        table.insert(info_rug, info_chhl[1])
        table.insert(info_rug, get_flask_water(flask))
    end
    
    info_chhl[1] = "?"
    info_chhl[2] = 0
    self:set_wnd_pocket(1)
    
    if n == 1 then
        self:set_wnd_1(1)
    elseif n == 3 then
        self:set_wnd_2(1)
    elseif n == 5 then
        self:set_wnd_3(1)
    elseif n == 7 then
        self:set_wnd_4(1)
    end
    vergas_lib.s_play(vergas_lib.set_pr_from_config_str("bag_on_belt","snd_scroll"),1)
end

function cheat:process_flask_action( action_type )
    if info_chhl[1] == "?" then
        sak.send_tip(
            "Етижи-пассатижи, так фляга-то отсутствует...", 
            "Мысли вслух", 0, 5, "g_g", "no", "red" 
        )        
		vergas_lib.s_play( [[device\antirad_no]], 1 )	
        return
    end
    
    local new_water
    if action_type == "wash" then
        new_water = vergas_flask.wash_glass( info_chhl[ 1 ], self.decant or 1 )
    else
        new_water = vergas_flask.drink_water( info_chhl[ 1 ] )
    end
    
    if new_water then
        info_chhl[ 2 ] = new_water
    end
    
    -- Сохраняем и закрываем окно
    self:write_data()
    self:del_windows()
    btn_old = 0
    info_rug = {} 
    info_chhl = {}
    flask_number = {}
    used_items.set_get_flag_use_gadget( 1, true )
    self:GetHolder():start_stop_menu( self, true )
    vergas_lib.s_play( vergas_lib.set_pr_from_config_str( "bag_on_belt", "snd_deselect" ), 1 )
    razgruzka.inventory_on_off_work( false )
	bind_stalker.restore_weapon()
	level.enable_input()
end

function cheat:btn_wash()
    self:process_flask_action( "wash" )
end

function cheat:btn_drink()
    self:process_flask_action( "drink" )
end
function cheat:btn_1()					--Кнопка ячейки 1
	self:klik_btn(1,1)
end

function cheat:btn_2()					--Кнопка ячейки 2
	self:klik_btn(2,3)
end

function cheat:btn_3()					--Кнопка ячейки 3
	self:klik_btn(3,5)
end

function cheat:btn_4()					--Кнопка ячейки 4
	self:klik_btn(4,7)
end

-------------------------------------------------------------------------
--Функции окон
-------------------------------------------------------------------------
function cheat:set_wnd_1(mode)
    if info_rug[1] == "?" then
        wnd_1:Show(false)
        wnd_pic_1:Show(false)
        return
    end
    local n = self:flask_number(info_rug[1])
    wnd_1:SetText("№"..n)
    wnd_1:Show(true)
    local pictogram_index = self:get_pictogram_index(info_rug[2])
    if mode == 1 then
        wnd_pic_1:InitTexture("ui_water_pictogram_"..pictogram_index)
    else
        wnd_pic_1:InitTexture("ui_water_pictogram_yellow_"..pictogram_index)
    end
    wnd_pic_1:Show(true)
end

