function cheat:set_wnd_pocket(mode)
    if mode == 1 then
        wnd_pocket:SetWndRect(176,279,38,65)
        wnd_pocket:InitTexture("ui_cover_without_flask")
        wnd_pic_pocket:Show(false)
    else
        wnd_pocket:SetWndRect(177,276,33,68)
        wnd_pocket:InitTexture("ui_flask_army")
        local pictogram_index = self:get_pictogram_index(info_chhl[2])
        wnd_pic_pocket:InitTexture("ui_water_pictogram_"..pictogram_index)
        wnd_pic_pocket:Show(true)
    end
end

