-- sivol: new-game A-life selector with a hover description panel ( docs/ALIFE_DESC_UI_DESIGN.md ).
-- Opened by ui_main_menu.script main_menu:AskAlifePreset; a pick calls owner:OnAlifePresetPicked(preset).
-- Layout: ui_mm_alife_preset.xml (4:3) and ui_mm_alife_preset_16.xml (16:9, picked by the engine).

local modes = {
	btn_extended = { preset = "default", title = "ui_mm_alife_extended_head", text = "ui_mm_alife_extended_desc" },
	btn_classic  = { preset = "classic", title = "ui_mm_alife_classic",       text = "ui_mm_alife_classic_desc" },
}

-- Header slot from the title static as laid out in xml: centre x, top, max width, height.
function header_slot(title)
	local pos = title:GetWndPos()
	local w, h = title:GetWidth(), title:GetHeight()
	return { cx = pos.x + w / 2, y = pos.y, w = w, h = h }
end

-- Header text over a ui_brokenline label sized to it ( same two-control pattern as ui_inv_descr.script
-- update_name_line ). Also used by ui_mm_opt_main.script for the options hint.
function fit_header(line, title, slot, text)
	title:SetWndSize(slot.w, slot.h)
	title:SetText(text)
	local line_w = slot.w
	local ok = pcall(function()
		title:AdjustWidthToText()
		local measured_w = title:GetWidth()
		if measured_w > 0 and measured_w < slot.w then
			line_w = measured_w + 24
		end
	end)
	if not ok then line_w = slot.w end
	line_w = math.max(50, math.min(slot.w, line_w))
	local x = math.floor(slot.cx - line_w / 2)
	line:SetWndPos(x, slot.y)
	line:SetWidth(line_w)
	title:SetWndPos(x, slot.y)
	title:SetWndSize(line_w, slot.h)
	title:SetText(text)
end

class "alife_preset_dialog" (CUIScriptWnd)
function alife_preset_dialog:__init(owner) super()
	self.owner = owner
	self.desc_owner = nil
	self:InitControls()
	self:InitCallBacks()
end

function alife_preset_dialog:__finalize()
end

function alife_preset_dialog:InitControls()
	self:Init(0, 0, 1024, 768)
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_mm_alife_preset.xml")

	xml:InitStatic("dim", self)
	xml:InitStatic("choice_back", self)
	local choice_line = xml:InitLabel("choice_line", self)
	local choice_title = xml:InitStatic("choice_title", self)
	fit_header(choice_line, choice_title, header_slot(choice_title), game.translate_string("ui_mm_alife_title"))
	xml:InitStatic("intro", self)
	xml:InitStatic("rec_mark", self)

	self:Register(xml:Init3tButton("btn_extended", self), "btn_extended")
	self:Register(xml:Init3tButton("btn_classic", self), "btn_classic")
	self:Register(xml:Init3tButton("btn_back", self), "btn_back")

	self.desc_back = xml:InitStatic("desc_back", self)
	self.desc_line = xml:InitLabel("desc_line", self)
	self.desc_title = xml:InitStatic("desc_title", self)
	self.desc_slot = header_slot(self.desc_title)
	self.desc_text = xml:InitStatic("desc_text", self)
	self:HideDesc()
end

function alife_preset_dialog:InitCallBacks()
	for id, mode in pairs(modes) do
		local btn_id, preset = id, mode.preset
		self:AddCallback(btn_id, ui_events.BUTTON_CLICKED, function() self:Pick(preset) end)
		self:AddCallback(btn_id, ui_events.STATIC_FOCUS_RECEIVED, function() self:ShowDesc(btn_id) end)
		self:AddCallback(btn_id, ui_events.STATIC_FOCUS_LOST, function() self:HideDesc(btn_id) end)
	end
	self:AddCallback("btn_back", ui_events.BUTTON_CLICKED, self.Close, self)
end

-- The engine commits every focus loss before any focus gain in a frame, so moving between
-- the two buttons hides and shows in one frame; the owner check keeps a late loss harmless.
function alife_preset_dialog:ShowDesc(id)
	local mode = modes[id]
	fit_header(self.desc_line, self.desc_title, self.desc_slot, game.translate_string(mode.title))
	self.desc_text:SetText(game.translate_string(mode.text))
	self:ShowDescParts(true)
	self.desc_owner = id
end

function alife_preset_dialog:HideDesc(id)
	if id and id ~= self.desc_owner then return end
	self:ShowDescParts(false)
	self.desc_owner = nil
end

function alife_preset_dialog:ShowDescParts(on)
	self.desc_back:Show(on)
	self.desc_line:Show(on)
	self.desc_title:Show(on)
	self.desc_text:Show(on)
end

function alife_preset_dialog:Close()
	self:HideDesc()
	local holder = self:GetHolder()
	if holder then holder:start_stop_menu(self, true) end
end

function alife_preset_dialog:Pick(preset)
	self:Close()
	self.owner:OnAlifePresetPicked(preset)
end

function alife_preset_dialog:OnKeyboard(dik, keyboard_action)
	if CUIScriptWnd.OnKeyboard(self, dik, keyboard_action) then
		return true
	end
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik_to_bind(dik) == key_bindings.kQUIT then
			self:Close()
		end
		return true
	end
	return false
end
