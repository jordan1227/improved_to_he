--Меню базовых настроек графики. Используется скриптом ui_mm_opt_main.script

local function register_hint(handler, control, id, caption, description)
	handler:Register(control, id)
	handler:AddCallback(id, ui_events.STATIC_FOCUS_RECEIVED, function()
		handler.hint_name:SetText(game.translate_string(caption))
		handler.hint_caption:SetText(game.translate_string(description))
	end)
end

class "opt_video" (CUIWindow)
function opt_video:__init() super()
end

function opt_video:__finalize()
end

function opt_video:InitControls(x, y, xml, handler)
	self:Init(x, y, 738, 416)
	self:SetAutoDelete(true)

	xml:InitFrame("frame", self)
	local section_display = xml:InitLabel("tab_video:section_display", self)
	local section_performance = xml:InitLabel("tab_video:section_performance", self)
	register_hint(handler, section_display, "video_section_display", "ui_mm_section_video_display", "ui_mm_section_video_display_desc")
	register_hint(handler, section_performance, "video_section_performance", "ui_mm_section_video_performance", "ui_mm_section_video_performance_desc")

	local cap_brightness = xml:InitStatic("tab_video:cap_brightness", self)
	local track_brightness = xml:InitTrackBar("tab_video:track_brightness", self)
	local cap_contrast = xml:InitStatic("tab_video:cap_contrast", self)
	local track_contrast = xml:InitTrackBar("tab_video:track_contrast", self)
	local cap_gamma = xml:InitStatic("tab_video:cap_gamma", self)
	local track_gamma = xml:InitTrackBar("tab_video:track_gamma", self)
	local cap_always_active = xml:InitStatic("tab_video:cap_always_active", self)
	xml:InitCheck("tab_video:check_always_active", self)
	local cap_fps_lock = xml:InitStatic("tab_video:cap_fps_lock", self)
	xml:InitComboBox("tab_video:list_fps_lock", self)
	local cap_resolution = xml:InitStatic("tab_video:cap_resolution", self)
	xml:InitComboBox("tab_video:list_resolution", self)
	local cap_preset = xml:InitStatic("tab_video:cap_preset", self)
	local preset = xml:InitComboBox("tab_video:list_presets", self)
	handler:Register(preset, "combo_preset")
	local cap_language = xml:InitStatic("tab_video:cap_language", self)
	xml:InitComboBox("tab_video:list_language", self)

	register_hint(handler, cap_language, "video_cap_language", "ui_mm_language", "ui_mm_language_desc")
	register_hint(handler, cap_preset, "video_cap_preset", "ui_mm_quality_presets", "ui_mm_quality_presets_desc")
	register_hint(handler, cap_resolution, "video_cap_resolution", "ui_mm_resolution", "ui_mm_resolution_desc")
	register_hint(handler, cap_gamma, "video_cap_gamma", "ui_mm_gamma", "ui_mm_gamma_desc")
	register_hint(handler, cap_contrast, "video_cap_contrast", "ui_mm_contrast", "ui_mm_contrast_desc")
	register_hint(handler, cap_brightness, "video_cap_brightness", "ui_mm_brightness", "ui_mm_brightness_desc")
	register_hint(handler, cap_fps_lock, "video_cap_fps_lock", "ui_mm_fps_lock", "ui_mm_fps_lock_desc")
	register_hint(handler, xml:InitStatic("tab_video:cap_fullscreen", self), "video_cap_fullscreen", "ui_mm_fullscreen", "ui_mm_fullscreen_desc")
	register_hint(handler, cap_always_active, "video_cap_always_active", "ui_mm_always_active", "ui_mm_always_active_desc")

	local btn = xml:Init3tButton("tab_video:btn_advanced", self)
	handler:Register(btn, "btn_advanced_graphic")
end