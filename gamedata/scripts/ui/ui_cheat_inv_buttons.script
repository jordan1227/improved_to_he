local accel_inited
local function init_inv_exit_accel()
	if accel_inited then return end
	local wnd = level.get_inventory_wnd()
	local btn_exit = wnd:FindChild("exit_button")
	if btn_exit then
		local btn = btn_exit:GetButton()
		if btn then
			-- Кнопке выхода из инвентаря назначается акселератор
			btn:SetAccelerator(bind_to_dik(key_bindings.kNEW_INVENTORY))
			accel_inited = true
		end
	end
end

class "rummaged" (CUIScriptDialog)

local wnd_icon
local wnd_rykzack
local INVENTORY_DOF_BLEND_MS = 300
local INVENTORY_DOF_OPEN_LEAD_MS = 250
local FULL_BACKPACK_OPEN_WATCHDOG_EXTRA_MS = 1000
local inventory_dof_value = 0
local inventory_dof_signal
local inventory_dof_generation = 0
local full_backpack_owner = nil
local full_backpack_state = nil

local function smoothstep( t )
	return t * t * ( 3 - 2 * t )
end

local function blend_inventory_dof( target )
	inventory_dof_generation = inventory_dof_generation + 1
	local generation = inventory_dof_generation
	if inventory_dof_signal then
		ogse_signals.get_mgr():unsubscribe( inventory_dof_signal )
		inventory_dof_signal = nil
	end

	local start_value = inventory_dof_value
	if math.abs( target - start_value ) <= 0.001 then
		inventory_dof_value = target
		set_dof_params( target, target, target, target )
		return
	end

	local start_time = time_global()
	local signal
	signal = ogse_signals.get_mgr():subscribe({
		signal = "on_update",
		fun = function()
			if generation ~= inventory_dof_generation then return end
			ogse_signals.get_mgr():reschedule( 16 )

			local t = math.min( 1, ( time_global() - start_time ) / INVENTORY_DOF_BLEND_MS )
			inventory_dof_value = start_value + ( target - start_value ) * smoothstep( t )
			set_dof_params( inventory_dof_value, inventory_dof_value, inventory_dof_value, inventory_dof_value )

			if t >= 1 then
				ogse_signals.get_mgr():unsubscribe( signal )
				if inventory_dof_signal == signal then
					inventory_dof_signal = nil
				end
			end
		end
	})
	inventory_dof_signal = signal
end

local function unsubscribe_full_backpack_signal( signal )
	if signal then
		ogse_signals.get_mgr():unsubscribe( signal )
	end
end

local function detach_equipment_icons(dialog)
	if wnd_icon ~= nil then
		if dialog then dialog:DetachChild(wnd_icon) end
		wnd_icon = nil
	end
	if wnd_rykzack ~= nil then
		if dialog then dialog:DetachChild(wnd_rykzack) end
		wnd_rykzack = nil
	end
end

local function restore_controls_directly(state, owner)
	local current = hud_animation_owner and hud_animation_owner.current
		and hud_animation_owner.current()
	local other_owner = current and current ~= owner
		and hud_animation_owner.valid and hud_animation_owner.valid(current)
	if other_owner then return end
	if state.movement_held and level and level.only_allow_movekeys then
		level.only_allow_movekeys(false)
		if level.set_actor_allow_ladder then level.set_actor_allow_ladder(true) end
	end
	if state.input_held and level and level.enable_input then
		level.enable_input()
	end
end

local function cleanup_full_backpack( state, reason, notify_close )
	if not state or state.cleaned then return false end
	state.cleaned = true

	local owner = state.owner
	if full_backpack_state == state then full_backpack_state = nil end
	if full_backpack_owner == owner then full_backpack_owner = nil end

	unsubscribe_full_backpack_signal( state.sig_bp_slot )
	unsubscribe_full_backpack_signal( state.sig_bp_ruck )
	unsubscribe_full_backpack_signal( state.sig_inv_hide )
	state.sig_bp_slot = nil
	state.sig_bp_ruck = nil
	state.sig_inv_hide = nil

	if get_console then get_console():execute( "bpui 0" ) end
	if remove_value then remove_value( "inv_full" ) end
	blend_inventory_dof( 0 )
	if level and level.remove_cam_effector then level.remove_cam_effector( 9773 ) end
	if state.hud_motion_active and game and game.stop_hud_motion then
		game.stop_hud_motion()
		state.hud_motion_active = false
	end

	if owner and hud_animation_owner and hud_animation_owner.valid( owner ) then
		if state.movement_held then
			hud_animation_owner.release_resource( owner, "movement" )
			state.movement_held = false
		end
		if state.input_held then
			hud_animation_owner.release_resource( owner, "input" )
			state.input_held = false
		end
		hud_animation_owner.cancel( owner, reason or "full-backpack cleanup" )
		hud_animation_owner.release( owner, reason or "full-backpack cleanup" )
	else
		restore_controls_directly(state, owner)
		state.movement_held = false
		state.input_held = false
	end

	if state.inventory_requested and not state.opened and not state.closing
		and sak and sak.close_window then
		pcall(sak.close_window)
	end

	if slot_keeper and slot_keeper.restore then slot_keeper.restore() end
	if notify_close then
		ogse_signals.get_mgr():call( "on_full_backpack_close_complete" )
	end
	return true
end
function rummaged:__init(owner) 
	super()
	self.owner = owner
	self.open_time = time_global()
	init_inv_exit_accel()
	self:InitControls()
end


function rummaged:__finalize() end

function rummaged:InitControls()

	-- Положение и размеры окна
		self:Init(317,0,533,722)
	
	--определяю костюм и иконку 
	local armor = db.actor:item_in_slot(6)
	local gg_icon = ""
	if armor then
		--костюм на ГГ есть
		gg_icon = vergas_lib.set_pr_from_config_str(armor:section(),"full_figure")
	else
		--костюма нет
		gg_icon = "figure_without_outfit"
	end
	
	--ставлю иконку костюма
	wnd_icon = CUIStatic()
	--wnd_icon:SetWndRect(207,158,128,320)
	wnd_icon:SetWndRect(100,158,107,320)
	wnd_icon:SetStretchTexture(true)
	self:AttachChild(wnd_icon)
	wnd_icon:InitTexture(gg_icon)
	
	local ruck = vergas_rucksack.have()
	
	if ruck then
		--ставлю иконку сидорка
		local gg_rykzack = ""
		if armor then
			gg_rykzack = vergas_lib.set_pr_from_config_str(armor:section(),"backpack_type")
		else
			gg_rykzack = "ui_icon_rykzack_1_brown"
		end

		wnd_rykzack = CUIStatic()
		wnd_rykzack:SetWndRect(200,301,107,178)
		wnd_rykzack:SetStretchTexture(true)
		self:AttachChild(wnd_rykzack)
		wnd_rykzack:InitTexture(gg_rykzack)
	end
	
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_cheat_inv_buttons.xml")
	
	xml:InitStatic("background_glass", self)

	local r_mode
	if db.actor:object("razgruzka") then
		r_mode = 1
		xml:InitStatic("background", self)
	elseif
		db.actor:object("razgruzka_new") then
		r_mode = 2
		xml:InitStatic("background", self)
	else
		r_mode = 3
		xml:InitStatic("background", self)
	end
	
	xml:InitStatic("btn_exit_back", self)

	self:Register(xml:InitButton("btn_stop", self),"btn_stop")					-- Кнопка выхода
	self:AddCallback("btn_stop", ui_events.BUTTON_CLICKED, self.btn_stop, self)
	
	self:Register(xml:InitButton("btn_quests", self),"btn_quests")
	self:AddCallback("btn_quests", ui_events.BUTTON_CLICKED, self.btn_quests, self)
	
	-- Gray placeholders stay visible when an equipment item is absent.
	if r_mode == 3 then
		xml:InitStatic("background_raz", self)
	end
	xml:InitStatic("background_pod", self)
	xml:InitStatic("background_sum", self)
	xml:InitStatic("background_fl", self)
	xml:InitStatic("background_ruk", self)
	xml:InitStatic("background_sleep", self)
	xml:InitStatic("background_wpn", self)
	xml:InitStatic("background_belt", self)
	xml:InitStatic("background_eat", self)
	
	if r_mode == 1 then
		xml:InitStatic("background_raz", self)
		self:Register(xml:InitButton("btn_raz", self),"btn_raz")				-- Кнопка разгрузки 
		self:AddCallback("btn_raz", ui_events.BUTTON_CLICKED, self.btn_raz, self)
	end
	if r_mode == 2 then	
		xml:InitStatic("background_raz_new", self)
		self:Register(xml:InitButton("btn_raz_new", self),"btn_raz")			-- Кнопка новой разгрузки 
		self:AddCallback("btn_raz", ui_events.BUTTON_CLICKED, self.btn_raz_new, self)
	end
	
	if db.actor:object("podsumok") then
		self:Register(xml:InitButton("btn_pod", self),"btn_pod")				-- Кнопка подсумка 
		self:AddCallback("btn_pod", ui_events.BUTTON_CLICKED, self.btn_pod, self)
	end
	
	if db.actor:object("bag_on_belt") then
		self:Register(xml:InitButton("btn_sum", self),"btn_sum")				-- Кнопка сумки НЗ
		self:AddCallback("btn_sum", ui_events.BUTTON_CLICKED, self.btn_sum, self)
	end	
	 
	if db.actor:object("bag_on_belt_n") then 
		self:Register(xml:InitButton("btn_sum_n", self),"btn_sum")				-- Кнопка сумки НЗ_n 
		self:AddCallback("btn_sum", ui_events.BUTTON_CLICKED, self.btn_sum_n, self)
	end	

	if inv_buttons_use.search_flask_army_in_inventory() then
		self:Register(xml:InitButton("btn_fl", self),"btn_fl")				-- Кнопка фляжки
		self:AddCallback("btn_fl", ui_events.BUTTON_CLICKED, self.btn_fl, self)
	end	
	
	self:Register(xml:InitButton("btn_ruk", self),"btn_ruk")				-- Кнопка рюкзака (весь)
	self:AddCallback("btn_ruk", ui_events.BUTTON_CLICKED, self.btn_ruk, self)

	if db.actor:object("sleeping_bag") then
		self:Register(xml:InitButton("btn_sleep", self),"btn_sleep")			-- Кнопка спальника
		self:AddCallback("btn_sleep", ui_events.BUTTON_CLICKED, self.btn_sleep, self)
	end
	
	if inv_buttons_use.search_weapons_belt_in_inventory("wpn_") then
		self:Register(xml:InitButton("btn_wpn", self),"btn_wpn")				-- Кнопка рюкзака (ружья)
		self:AddCallback("btn_wpn", ui_events.BUTTON_CLICKED, self.btn_wpn, self)
	end

	if inv_buttons_use.search_weapons_belt_in_inventory("belt") then
		self:Register(xml:InitButton("btn_belt", self),"btn_belt")			-- Кнопка рюкзака (пояс)
		self:AddCallback("btn_belt", ui_events.BUTTON_CLICKED, self.btn_belt, self)
	end
	
	if inv_buttons_use.search_small_things_in_inventory() then
		self:Register(xml:InitButton("btn_eat", self),"btn_eat")				-- Кнопка рюкзака (еда/медицина)
		self:AddCallback("btn_eat", ui_events.BUTTON_CLICKED, self.btn_eat, self)
	end
	
end

function rummaged:OnKeyboard(dik, keyboard_action)
	CUIScriptWnd.OnKeyboard(self,dik,keyboard_action)
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_ESCAPE then
			self:btn_quit(0)
		elseif dik == bind_to_dik(key_bindings.kNEW_INVENTORY) then
			if time_global() - self.open_time > 150 then
				self:btn_quit(0)
			end
		end
	end
	return true
end

function rummaged:btn_quit(mode)
	--mode = 0 закрытие снаряжения
	--mode = 1 рюкзак (мелочевка)
	--mode = 2 рюкзак (оружие)
	--mode = 3 рюкзак (пояс)
	--mode = 4 рюкзак (все)
	--mode = 5 подсумок
	--mode = 6 разгрузка
	--mode = 7 сумка
	--mode = 8 сумка (быстрая)
	--mode = 9 чехол для фляжки
	--mode = 10 чехол для вляжки (быстрый)
	--mode = 11 новая разгрузка
	--mode = 12 квестовые предметы
	vergas_lib.flag_inventory=false
	schedule.add ("flag_inventory","vergas_lib.flag_inventory_on()",300)
	if mode ~= 4 then
		detach_equipment_icons(self)
	end
	if mode == 0 then
		--закрываю снаряжение
		inv_buttons_use.imitation_closing_inventory(mode)
		vergas_lib.s_play("razgruzka\\podsumok_deselect",1)
		used_items.set_use_gadget(true) -- разрешить использование снова
		
	elseif mode == 4 then
		--полное открытие рюкзака (долго ковыряется)
		local owner = hud_animation_owner.reserve("full-backpack")
		if not owner or not hud_animation_owner.activate(owner, "full-backpack") then
			if owner then hud_animation_owner.release(owner, "backpack admission") end
			return
		end
		local state = {
			owner = owner,
			hud_motion_active = true,
			input_held = false,
			movement_held = false,
			inventory_requested = false,
			opened = false,
		}
		full_backpack_owner = owner
		full_backpack_state = state
		if not hud_animation_owner.acquire_input(owner) then
			cleanup_full_backpack(state, "backpack input admission")
			return
		end
		state.input_held = true
		if not hud_animation_owner.register_lifecycle_cleanup(owner, function(reason)
			cleanup_full_backpack(state, reason, false)
		end) then
			cleanup_full_backpack(state, "backpack lifecycle admission")
			return
		end
		level.add_cam_effector( "camera_effects\\backpack_open.anm", 9773, false, "" )
		vergas_lib.s_play("interface\\item_usage\\backpack_open",1)
		local motion_ok, anim_duration = pcall(function()
			return game.play_hud_motion( 2, "item_ea_backpack_open_stalker_hud", "anm_ea_show", false, 0.65 )
		end)
		if not motion_ok or not hud_animation_session or not hud_animation_session.duration
			or not hud_animation_session.duration(anim_duration) then
			cleanup_full_backpack(state, "invalid backpack open duration", false)
			return
		end
		detach_equipment_icons(self)
		dsh.timeout( math.max( 0, anim_duration - INVENTORY_DOF_OPEN_LEAD_MS ), function()
			if not hud_animation_owner.valid(owner) or state.cleaned then return end
			blend_inventory_dof( 1 )
		end )

		dsh.timeout( anim_duration, function()
			if not hud_animation_owner.valid(owner) or state.cleaned then return end
			game.play_hud_motion( 2, "item_ea_backpack_open_stalker_hud", "anm_ea_idle", false, 1 )
			local open_ok = pcall(function()
				inv_buttons_use.open_inventory( 4 )
				get_console():execute("bpui 1")
			end)
			if not open_ok then
				cleanup_full_backpack(state, "backpack inventory open failed", false)
				return
			end
			state.opened = true
			-- DOF begins just before this point via blend_inventory_dof().
			if state.input_held then
				hud_animation_owner.release_resource( owner, "input" )
				state.input_held = false
			end
		end )
		state.inventory_requested = true
		set_value( "inv_full", true )
		dsh.timeout( math.max( 1000, anim_duration + FULL_BACKPACK_OPEN_WATCHDOG_EXTRA_MS ), function()
			if state.cleaned or state.opened then return end
			cleanup_full_backpack(state, "full-backpack open timeout", false)
		end )

		local open_ok, open_error = pcall(function()
			razgruzka.open_inventory()
		end)
		if not open_ok then
			log2("[BACKPACK] inventory open failed: %s", tostring(open_error))
			cleanup_full_backpack(state, "backpack inventory open failed", false)
			return
		end

		local function restore_bp_hud_idle()
			if state.cleaned or not hud_animation_owner.valid(owner) or not get_value( "inv_full" ) then return end
			dsh.timeout( 17, function()
				if state.cleaned or not hud_animation_owner.valid(owner) or not get_value( "inv_full" ) then return end
				game.play_hud_motion( 2, "item_ea_backpack_open_stalker_hud", "anm_ea_idle", false, 1 )
				get_console():execute("bpui 1")
			end )
		end
		local function on_outfit_changed( obj )
			if obj and obj:is_outfit() then
				restore_bp_hud_idle()
			end
		end
		state.sig_bp_slot = ogse_signals.get_mgr():subscribe({
			signal = "on_item_to_slot",
			fun = on_outfit_changed
		})
		state.sig_bp_ruck = ogse_signals.get_mgr():subscribe({
			signal = "on_item_to_ruck",
			fun = on_outfit_changed
		})

		-- Подписываемся на хайд инвентори и сразу же отписываемся, чтобы не проверять моды или еще что		
		state.sig_inv_hide = ogse_signals.get_mgr():subscribe({
			signal = "on_inventory_hide",
			fun = function()
				if state.cleaned or state.closing or not hud_animation_owner.valid(owner) then return end
				state.closing = true
				get_console():execute("bpui 0")
				unsubscribe_full_backpack_signal( state.sig_bp_slot )
				unsubscribe_full_backpack_signal( state.sig_bp_ruck )
				state.sig_bp_slot = nil
				state.sig_bp_ruck = nil
				blend_inventory_dof( 0 )
				if not hud_animation_owner.acquire_movement( owner ) then
					cleanup_full_backpack( state, "backpack movement admission", true )
					return
				end
				state.movement_held = true
				level.add_cam_effector( "camera_effects\\backpack_open.anm", 9773, false, "" )
				vergas_lib.s_play("interface\\item_usage\\backpack_close",1)
				local close_duration = game.play_hud_motion( 2, "item_ea_backpack_close_stalker_hud", "anm_ea_show", false, 0.75 )
				unsubscribe_full_backpack_signal( state.sig_inv_hide )
				state.sig_inv_hide = nil
				dsh.timeout( close_duration, function()
					if state.cleaned then return end
					if not hud_animation_owner.valid(owner) then
						cleanup_full_backpack( state, "stale backpack close" )
						return
					end
					state.hud_motion_active = false
					cleanup_full_backpack( state, "full-backpack close", true )
				end )
			end
		})
	elseif mode == 10 then
		--фляжка(быстрая)
		inv_buttons_use.imitation_closing_inventory(mode)
		schedule.add("show_flask_army", "used_items.used_flask_army(false)", 300)
	elseif mode == 9 then
		--фляжка
		used_items.used_flask_army(true)
	elseif mode == 8 then
		--сумка(быстрая)
		inv_buttons_use.imitation_closing_inventory(mode)
		schedule.add("show_bag_on_belt", "used_items.used_bag_on_belt(false,false)", 300)
		elseif mode == 14 then
		--сумка_новая(быстрая)
		inv_buttons_use.imitation_closing_inventory(mode)
		schedule.add("show_bag_on_belt", "used_items.used_bag_on_belt_n(false,false)", 300)
	elseif mode == 7 then
		--сумка
		used_items.used_bag_on_belt(true,false)
	elseif mode == 13 then
		--сумка_новая
		used_items.used_bag_on_belt_n(true,false)	
	elseif mode == 11 then
		-- новая разгрузка
		used_items.used_podsumok_razgruzka("razgruzka_new")
	elseif mode == 6 then
		--разгрузка
		used_items.used_podsumok_razgruzka("razgruzka")
	elseif mode == 5 then
		--подсумок
		used_items.used_podsumok_razgruzka("podsumok")
	elseif mode == 12 then 
		--квестовые предметы
        razgruzka.open_inventory() 
		inv_buttons_use.open_inventory(mode)		
	else
        razgruzka.open_inventory() -- подготовить инвентарь с скрытием избыточных предметов
		inv_buttons_use.open_inventory(mode)
	end
	
    CUIScriptDialog.CloseDialog(self)
	self:ClearCallbacks()
end

function rummaged:btn_raz()
	self:btn_quit(6)
end

function rummaged:btn_raz_new()
	self:btn_quit(11)
end

function rummaged:btn_pod()
	self:btn_quit(5)
end

function rummaged:btn_fl()
	if vergas_rucksack.have() then
		--рюкзак на ГГ
		self:btn_quit(9)
	else
		--рюкзака на ГГ нет
		self:btn_quit(10)
	end
end

function rummaged:btn_sum()
		self:btn_quit(7)
end

function rummaged:btn_sum_n()
		self:btn_quit(13)
end

function rummaged:btn_ruk()
	self:btn_quit(4)
end

function rummaged:btn_sleep()
	local obj = db.actor:object("sleeping_bag")
	if obj then
		db.actor:drop_item(obj)
	end
	self:btn_quit(0)
end

function rummaged:btn_wpn()
	self:btn_quit(2)
end

function rummaged:btn_belt()
	self:btn_quit(3)
end

function rummaged:btn_eat()
	self:btn_quit(1)
end

function rummaged:btn_quests()
	self:btn_quit(12)
end

function rummaged:btn_stop()
	self:btn_quit(0)
end

