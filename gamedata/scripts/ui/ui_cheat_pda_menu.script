-- HE-PORT-CROP
class "cheat"(CUIScriptWnd)

local sn				--служебный номер ПДА
local wnd_bg			--окно подложки
local wnd_sn			--окно служебного номера
local wnd_mask
local wnd_steklo		--окно стекла
local mode_r			--1-режим перебора  2-режим разряженного ПДА

function cheat:__init(owner) super()
	self.owner = owner
	self:InitControls()
	self:InitCallBacks()
    wprintf("~CF0 ui_cheat_pda_menu.script - __init complete, traceback:\n~C0A %s~C07", lua_traceback(' '))
    -- HE-PORT-CROP: сразу переводим меню в нужное состояние без промежуточного "выключенного" экрана
    schedule.add("cheat_pda_npc_autostart", function()
        self:btn_start()
    end, 1)
end

function cheat:InitControls()

	-- Положение и размеры окна
	self:Init(0,0,1024,768)		--1600x900
	
	--определяю служебный номер
	sn = vergas_pda.get_pda_sn()
	--определяюсь со стеклами	
	steklo_ok = vergas_pda.get_or_create_steklo(sn, "ok")
	steklo_bad = vergas_pda.get_or_create_steklo(sn, "bad")
	--вывожу ПДА
	mode_r = 1
	self:set_wnd_bg(1)
	
	-- файл-описатель элементов
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_cheat_pda_npc.xml")
	
	--xml:InitStatic("background", self)				--Подложка меню
	self:Register(xml:Init3tButton("btn_start_1", self),"btn_search")		-- Кнопка Вкл
	self:Register(xml:Init3tButton("btn_search_1", self),"btn_start")		-- Кнопка Перебор

	-- Без шедулера видно как накладывается грязь, не очень...
    schedule.add("menu_mask_overlay", function()
        self:set_wnd_mask()
    end, 1)	
end

function cheat:InitCallBacks()
	self:AddCallback("btn_start", ui_events.BUTTON_CLICKED, self.btn_start, self) 		-- Кнопка Вкл
	self:AddCallback("btn_search", ui_events.BUTTON_CLICKED, self.btn_search, self) 	-- Кнопка Перебор
end

function cheat:OnKeyboard( dik, keyboard_action )
	CUIScriptWnd.OnKeyboard( self, dik, keyboard_action )
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik >= DIK_keys.MOUSE_1 then log2("[pda3d] menu key dik=%s", tostring(dik)) end
		-- на выход повесим Esc
		if dik == DIK_keys.DIK_ESCAPE then
			if mode_r == 1 then
				self:btn_stop()
			else
				mode_r = 1
				self:set_wnd_bg( 1 )
			end
        elseif dik == DIK_keys.DIK_RETURN or dik == DIK_keys.DIK_NUMPADENTER then 
			self:btn_start()
        elseif dik == DIK_keys.DIK_PRIOR or dik == DIK_keys.DIK_NEXT or dik == DIK_keys.MOUSE_3 or dik == DIK_keys.DIK_SPACE then 
			self:btn_search()
		elseif dik == DIK_keys.DIK_G then
			--выбрасываю ПДА
			self:drop_pda()
		end
	end
	return true
end

function cheat:btn_stop()								-- Кнопка Выкл
	
	self:del_windows()
	vergas_pda.set_info_pda_nil()
	vergas_pda.set_tbl_sn_nil()
	used_items.set_get_flag_use_gadget(1,true)
	he_pda_3d.ui_close(self)
	bind_stalker.restore_weapon()		--восстанавливаю руки и оружие на худе
	self:ClearCallbacks()
end


function cheat:btn_start()
	if mode_r == 2 then
		return
	end

	if tonumber(string.sub (sn, 13 , 13)) == 2 then
		mode_r = 2
		self:set_wnd_bg(2)			--вывод разряженного ПДА
		vergas_lib.s_play(vergas_lib.set_pr_from_config_str("list_sounds_pda","snd_start_pda"),1)
	elseif tonumber(string.sub (sn, 13 , 13)) == 1 then
		local n = vergas_pda.get_number_pda()
		vergas_pda.set_number_record(n)
		vergas_lib.s_play(vergas_lib.set_pr_from_config_str("list_sounds_pda","snd_start_pda"),1)
		self:del_windows()
		he_pda_3d.ui_close(self)
		local spwn=ui_cheat_pda.cheat(get_hud())
		he_pda_3d.ui_open(spwn)
		self:set_wnd_mask()
	end
end

function cheat:btn_search()
	if vergas_pda.get_tbl_sn_count() <= 1 then return end
	self:del_windows()
	vergas_lib.s_play(vergas_lib.set_pr_from_config_str("list_sounds_pda","snd_select_pda_down"),1)
	schedule.add("stop_chow_pda", "vergas_pda.start_search_pda(1)", 500)
	he_pda_3d.ui_close(self)

end

function cheat:drop_pda()
	self:del_windows()
	he_pda_3d.ui_close(self)
	vergas_pda.start_search_pda_after_drop()
end

function cheat:set_wnd_bg(mode)
--mode=1-перебор  mode=2-разряженный ПДА
	local textur

	if wnd_bg ~= nil then
		self:DetachChild(wnd_bg)
		wnd_bg = nil
	end
	
	wnd_bg = CUIStatic()
	wnd_bg:SetAutoDelete(true)
	self:AttachChild(wnd_bg)
	wnd_bg:SetStretchTexture(true)
	wnd_bg:SetWndRect(-200, -119, 1564, 1011)		--1600x900
	--определяю состояние ПДА
	local n = tonumber(string.sub (sn, 13 , 13))
	
	if mode == 1 then
		if n == 1 or n == 2 then
			--целый ПДА накладываю только целое стекло
			textur = true
		else
			--битый ПДА. Накладываю битое стекло
			textur = false
		end
		wnd_bg:InitTexture("ui\\ui_pda_off")
	else
		--батарея разряжена. накладываю только целое стекло
		textur = true
		wnd_bg:InitTexture("ui\\ui_pda_bad_ok")	--сам ПДА
	end
	
	self:set_wnd_steklo(textur)
	self:set_wnd_sn(sn)
	--vergas_lib.s_play([[razgruzka\all_scroll]],1)
    self:set_wnd_mask()    -- маска поверх всего	
end

function cheat:set_wnd_mask()
    if not vergas_masks.get_flag_mask() then return end
    local mask, armor = vergas_masks.mask_definition()
    if mask == "?" then return end
    local base = string.match(mask, "^(.-)_%d+_%d+$") or mask

    if wnd_mask ~= nil then
        get_hud():RemoveDialogToRender(wnd_mask)
        wnd_mask = nil
    end

    wnd_mask = CUIStatic()
    wnd_mask:SetStretchTexture(true)
    wnd_mask:Init(0, 0, 1024, 1024)
    -- wnd_mask:InitTexture("verg\\masks\\"..base.."_1_1")
	wnd_mask:InitTexture("verg\\masks\\"..mask)
    get_hud():AddDialogToRender(wnd_mask)
end

function cheat:set_wnd_steklo(textur)
	local steklo
	local sn = vergas_pda.get_pda_sn()
	--log4("set_wnd_steklo sn=%s sub12=%s", tostring(sn), tostring(string.sub(sn, 1, 2)))
	local steklo_n = math.fmod(tonumber(string.sub(sn, 1, 2)), 9) + 1
	--log4("set_wnd_steklo steklo_n=%d textur=%s steklo_ok=%s steklo_bad=%s", steklo_n, tostring(textur), tostring(steklo_ok), tostring(steklo_bad))
	
	if wnd_steklo ~= nil then
		self:DetachChild(wnd_steklo)
		wnd_steklo = nil
	end
	
	--определяю текстуру стекла
	if textur then
		steklo = "ui_pda_steklo_ok_"..string.sub(steklo_ok,steklo_n,steklo_n)
	else
		steklo = "ui_pda_steklo_bad_"..string.sub(steklo_bad,steklo_n,steklo_n)
	end
	
	vergas_pda.set_get_steklo(steklo)
	
	wnd_steklo = CUIStatic()
	wnd_steklo:SetAutoDelete(true)
	self:AttachChild(wnd_steklo)
	wnd_steklo:SetStretchTexture(true)
	wnd_steklo:SetWndRect(0, 0, 1024, 768)		--1600x900
	
	wnd_steklo:InitTexture(steklo)
	
end

function cheat:set_wnd_sn(s_n)
	if wnd_sn ~= nil then
		self:DetachChild(wnd_sn)
		wnd_sn = nil
	end
	
	wnd_sn = CUIStatic()
	wnd_sn:SetAutoDelete(true)
	self:AttachChild(wnd_sn)
	wnd_sn:SetStretchTexture(true)
	wnd_sn:SetWndRect(-43, -50, 82, 36)			--1600x900
	wnd_sn:SetTextColor(255, 28, 28, 28)		--225
	wnd_sn:SetFont(GetFontLetterica16Russian())
	wnd_sn:SetText("№ "..s_n)

end

function cheat:del_windows()
	if wnd_bg ~= nil then
		self:DetachChild(wnd_bg)
		wnd_bg = nil
	end
	
	if wnd_sn ~= nil then
		self:DetachChild(wnd_sn)
		wnd_sn = nil
	end

	if wnd_mask ~= nil then
		-- self:DetachChild(wnd_mask) -- вылетает из-за этого
		get_hud():RemoveDialogToRender(wnd_mask) -- а так не открывается
		wnd_mask = nil
	end

	if wnd_steklo ~= nil then
		self:DetachChild(wnd_steklo)
		wnd_steklo = nil
	end
	
end

function cheat:open_and_start()
    local spwn = cheat( get_hud() )
    level.start_stop_menu( spwn, true )
end

-- flush !ui_cheat_pda_menu.cheat:open_and_start()