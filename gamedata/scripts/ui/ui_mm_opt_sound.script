--Меню настроек звука. Используется скриптом ui_mm_opt_main.script

local function register_hint(handler, control, id, caption, description, console_key)
	handler:Register(control, id)
	handler:AddCallback(id, ui_events.STATIC_FOCUS_RECEIVED, function()
		handler.hint_name:SetText(game.translate_string(caption))
		handler.hint_caption:SetText(handler:HintCaption(description, console_key))
	end)
end

class "opt_sound" (CUIWindow)
function opt_sound:__init() super()
end

function opt_sound:__finalize()
end

function opt_sound:InitControls(x, y, xml, handler)
	self:Init(x, y, 738, 416)
	self:SetAutoDelete(true)

	xml:InitFrame("frame", self)
	local section_volume = xml:InitLabel("tab_sound:section_volume", self)
	local section_output = xml:InitLabel("tab_sound:section_output", self)
	register_hint(handler, section_volume, "sound_section_volume", "ui_mm_section_sound_volume", "ui_mm_section_sound_volume_desc")
	register_hint(handler, section_output, "sound_section_output", "ui_mm_section_sound_output", "ui_mm_section_sound_output_desc")

	local cap_master = xml:InitStatic("tab_sound:cap_mastervolume", self)
	local cap_music = xml:InitStatic("tab_sound:cap_musicvolume", self)
	local cap_exo = xml:InitStatic("tab_sound:cap_exo_vol", self)
	local cap_device = xml:InitStatic("tab_sound:cap_snd_device", self)
	local cap_eax = xml:InitCheck("tab_sound:check_eax", self)

	xml:InitTrackBar("tab_sound:track_musicvolume", self)
	xml:InitTrackBar("tab_sound:track_mastervolume", self)
	xml:InitTrackBar("tab_sound:track_exovolume", self)

	register_hint(handler, cap_master, "sound_cap_master", "ui_mm_master_volume", "ui_mm_master_volume_desc", "tab_sound:track_mastervolume")
	register_hint(handler, cap_music, "sound_cap_music", "ui_mm_music_volume", "ui_mm_music_volume_desc", "tab_sound:track_musicvolume")
	register_hint(handler, cap_exo, "sound_cap_exo", "ui_mm_exo_volume", "ui_mm_exo_volume_desc", "tab_sound:track_exovolume")
	register_hint(handler, cap_device, "sound_cap_device", "ui_mm_snd_device", "ui_mm_snd_device_desc", "tab_sound:list_snd_device")
	register_hint(handler, cap_eax, "sound_cap_eax", "ui_mm_eax", "ui_mm_eax_desc", "tab_sound:check_eax")

	-- NLC audio (docs/AUDIO_DESIGN.md): occlusion, distance delay, HRTF, occlusion/reverb/echo levels
	local check_occ = xml:InitCheck("tab_sound:check_snd_occ", self)
	local check_delay = xml:InitCheck("tab_sound:check_snd_delay", self)
	local check_mask = xml:InitCheck("tab_sound:check_snd_mask", self)
	local cap_hrtf = xml:InitStatic("tab_sound:cap_snd_hrtf", self)
	local cap_occ_strength = xml:InitStatic("tab_sound:cap_snd_occ_strength", self)
	xml:InitTrackBar("tab_sound:track_snd_occ_strength", self)
	local cap_reverb_gain = xml:InitStatic("tab_sound:cap_snd_reverb_gain", self)
	xml:InitTrackBar("tab_sound:track_snd_reverb_gain", self)
	local cap_outdoor_echo = xml:InitStatic("tab_sound:cap_snd_outdoor_echo", self)
	xml:InitTrackBar("tab_sound:track_snd_outdoor_echo", self)

	-- Drop-down lists last: a window draws over the ones attached before it, so an open list stays in front of the rows
	-- below it (the device list opens over the HRTF row, so it comes after the HRTF list)
	local hrtf = xml:InitComboBox("tab_sound:list_snd_hrtf", self)
	handler:Register(hrtf, "tab_sound:list_snd_hrtf")
	local device = xml:InitComboBox("tab_sound:list_snd_device", self)
	handler:Register(device, "tab_sound:list_snd_device")

	register_hint(handler, check_occ, "sound_check_occ", "ui_mm_snd_occ", "ui_mm_snd_occ_desc", "tab_sound:check_snd_occ")
	register_hint(handler, check_delay, "sound_check_delay", "ui_mm_snd_delay", "ui_mm_snd_delay_desc", "tab_sound:check_snd_delay")
	register_hint(handler, check_mask, "sound_check_mask", "ui_mm_snd_mask", "ui_mm_snd_mask_desc", "tab_sound:check_snd_mask")
	register_hint(handler, cap_hrtf, "sound_cap_hrtf", "ui_mm_snd_hrtf", "ui_mm_snd_hrtf_desc", "tab_sound:list_snd_hrtf")
	register_hint(handler, cap_occ_strength, "sound_cap_occ_strength", "ui_mm_snd_occ_strength", "ui_mm_snd_occ_strength_desc", "tab_sound:track_snd_occ_strength")
	register_hint(handler, cap_reverb_gain, "sound_cap_reverb_gain", "ui_mm_snd_reverb_gain", "ui_mm_snd_reverb_gain_desc", "tab_sound:track_snd_reverb_gain")
	register_hint(handler, cap_outdoor_echo, "sound_cap_outdoor_echo", "ui_mm_snd_outdoor_echo", "ui_mm_snd_outdoor_echo_desc", "tab_sound:track_snd_outdoor_echo")

	local btn = xml:Init3tButton("tab_sound:btn_default_set", self)
	handler:Register(btn, "btn_default_sound")
end