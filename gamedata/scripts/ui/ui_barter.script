class "load_item" ( CUIListItemEx )

function load_item:__init() super()
    self:SetWndRect( 0, 0, 233, 22 )
    -- bullet mark
    self.fb = CUIStatic  ()
    self.fb:SetAutoDelete( true )
    self:AttachChild     ( self.fb )
    self.fb:SetWndRect   ( 0, 0, 8, 22 )
    self.fb:SetFont      ( GetFontLetterica18Russian() )
    self.fb:SetTextColor ( unpack( clr_orange ) )
    self.fb:SetText      ( "• " )
    -- name
    self.fn = CUIStatic  ()
    self.fn:SetAutoDelete( true )
    self:AttachChild     ( self.fn )
    self.fn:SetWndRect   ( 8, 0, 175, 22 )
    self.fn:SetFont      ( GetFontLetterica18Russian() )
    self.fn:SetTextColor ( unpack( clr_white ) )
    -- amount
    self.fa = CUIStatic()
    self.fa:SetAutoDelete ( true )
    self:AttachChild      ( self.fa )
    self.fa:SetWndRect    ( 183, 0, 42, 22 )
    self.fa:SetFont       ( GetFontLetterica18Russian() )
    self.fa:SetTextColor  ( unpack( clr_orange ) )
end

-------------------------------------------------------------------------------------------------

function give_icon_params( sect, name, earned_item )
    local t = {}
    t.icon_group  = utils.cfg_get_number( ini, sect, "icon_group", nil, false, 0 )

	t.description = game.translate_string( utils.cfg_get_string( ini, sect, "description", nil, false, "" ) )
	-------	
    if ini and ini:section_exist( sect ) then
        t.width       = ini:r_float( sect, "inv_grid_width"  ) * 50 or 176
        t.height      = ini:r_float( sect, "inv_grid_height" ) * 50 or 78
        t.x           = ini:r_float( sect, "inv_grid_x"      ) * 50 or 0
        t.y           = ini:r_float( sect, "inv_grid_y"      ) * 50 or 0
    else
        t.description = ""
        t.icon_group  = 0
        t.width       = 176
        t.height      = 78
        t.x           = 0
        t.y           = 0
    end
    return t
end

function make_list_by_trader( name )
    local tmptbl1, tmptbl2, tbl_, tbl__ = {}, {}, {}, {}
    local tbl_to_show = {}
    local ttt         = 1
    local ind         = 0
    local gdays       = timers.Get_Game_Days() or 1
    -----------------------------------------------------------------------------
    if name == "fuel_esc" or name == "fuel_bar" then
        tbl_to_show = generate_rnd_list(
            barter_tbl[ name ], tbl_npc_name_koeff[ name ][ 1 ], 24, 2, 4
        )		
	----------------------------------------------------------------------------	
    elseif name == "addons" then
		local tbl_petrenko = {
			{ "wpn_addon_sil_545_ar", 	 			1, "lvl1", 2 },		
			{ "wpn_addon_grenade_launcher", 		1, "lvl2", 2 },
			{ "wpn_addon_sil_762_sr1", 				1, "lvl2", 2 },
			{ "wpn_addon_sil_762_ar", 				1, "lvl2", 1 },		
			{ "wpn_addon_po",    					1, "lvl3", 1 },		
			{ "wpn_addon_cobra",					1, "lvl3", 2 },		
			{ "wpn_addon_1p78",  					1, "lvl4", 1 },			
			{ "wpn_addon_1pso",  					1, "lvl7", 1 }		
		}
		-------------------------
		local tbl_skriaga = {		
			{ "wpn_addon_sil_556_ar", 				1, "lvl1", 2 },			
			{ "wpn_addon_grenade_launcher_m203",  	1, "lvl2", 2 },
			{ "wpn_addon_sil_762_sr1", 				1, "lvl2", 2 },		
			{ "wpn_addon_acog", 					1, "lvl3", 2 },
			{ "wpn_addon_mt", 	 					1, "lvl4", 1 }						
		}		
		-------------------------
		local tbl_vahtang = {
			{ "wpn_addon_sil_9_p",      			1, "lvl1", 2 },		
			{ "wpn_addon_sil_762_sr2",      		1, "lvl2", 2 },	
			{ "wpn_addon_eotech",           		1, "lvl7", 1 }			
		}				

		if has_alife_info( "petrenko_dead" ) then 
			for k, v in pairs( tbl_petrenko ) do
				table.insert( tmptbl1, v )
			end
		end	
		
		if has_alife_info( "skryaga_dead" ) then 
			for k, v in pairs( tbl_skriaga ) do
				table.insert( tmptbl1, v )
			end
		end		
		
		if has_alife_info( "mil_mercs_fire" ) then
			for k, v in pairs( tbl_vahtang ) do
				table.insert( tmptbl1, v )
			end
		end			
		
        tbl_to_show = tmptbl1			
    else
        tbl_to_show = barter_tbl[ name ]
    end
    -----------------------------------------------------------------------------
    return tbl_to_show
end

function generate_rnd_list( table_in, npc_koeff, r_update, min, max )
    local t, table_out = {}, {}
    local day          = timers.Get_Game_Days() or 1
    local day_time     = 0
    if  actor:has_info( "time_morning" ) then day_time = 0
    elseif
        actor:has_info( "time_evening" ) then day_time = 2
    elseif
        actor:has_info( "time_night"   ) then day_time = 3
    elseif
        actor:has_info( "time_day"     ) then day_time = 1
    end
    if     r_update == 12 then day = day + math.floor( day_time / 2 )
    elseif r_update == 6  then day = day + day_time
    end
    for k, v in pairs( table_in ) do table.insert( t, v[ 1 ] ) end
    local t_out  = {}
    local t_used = 0
    local t_max
    if max == nil then
        t_max = min
    else
        t_max = dsh.get_fixed_random(
            "ui_barter.generate_rnd_list." .. npc_koeff, day, min, max
        )
    end
    for i = 1, t_max do
        t_used = ( t_used == t_max and 0 or t_used ) + 1
        local index = dsh.get_fixed_random(
            "ui_barter.generate_rnd_list." .. npc_koeff, day + i, t_used, #t
        )
        local value = t[ index ]
        t[ t_used ], t[ index ] = value, t[ t_used ]
        t_out[ i ] = t[ i ]
    end
    local ind = 0
    for i = 1, #t_out do
        for k, v in pairs ( table_in ) do
            if t_out[ i ] == v[ 1 ] then
                table.insert( table_out, table_in[ k ] )
                ind = ind + 1
            end
        end
    end
    return table_out
end

function need_sultan_weapon_art( sect )
    local min_art = tonumber( sect:sub( 4 ) )
    local tip     = get_value( "sultan_weapon", 0 )
    for k, v in pairs ( barter_tbl.sultan ) do
        local comp_art = tonumber( v[ 3 ]:sub( 4 ) )
        if k == tip and min_art >= comp_art then return true end
    end
    return false
end

function load_sultan_weapon_treasure()
    local tip           = get_value( "sultan_weapon", 0 )
    local rand_treasure = dsh.get_next_random(
        "ui_barter.load_sultan_weapon_treasure", 1, 3
    )
    local obj = g_sim:story_object( sultan_treasure[ rand_treasure * 2 - 1 ] )
    if tip ~= 0 and obj then
        local sect = barter_tbl.sultan[ tip ][ 1 ]
        misc.spawn_to( sect, obj )
        -- попробуем по имени секции заспавнить всех доступных патронов по пачке:
        local ammo_tbl = se_respawn.parse_names(
            utils.cfg_get_string( ini, sect, "ammo_class", false, false, false, "" )
        )
        if ammo_tbl ~= nil then
            for i = 1, #ammo_tbl do
                if
                    not strposx( ammo_tbl[ i ], "_merc" )
                    and ammo_tbl[ i ] ~= "ammo_ak"
                then 
                    misc.spawn_to( ammo_tbl[ i ], obj )
                end
            end
        end
		
		local diff = tonumber( level.get_game_difficulty() )
		if diff == 0 then 
			local ini = system_ini()
			local silencer = sak_dialog.read_string_if_exist( ini, sect, "silencer_name", false )
			if silencer then 
				misc.spawn_to( silencer, obj )
			end	
			
			local grenade_launcher = sak_dialog.read_string_if_exist( ini, sect, "grenade_launcher_name", false )
			if grenade_launcher then 
				misc.spawn_to( grenade_launcher, obj )
			end
			
			local tbl = se_respawn.parse_names( utils.cfg_get_string( ini, sect, "scope_name", false, false, false, "" ) )
			if tbl then 
				local scope = tbl[ dsh.get_next_random( "rnd_sultan_scope", #tbl ) ]
				misc.spawn_to( scope, obj )
			end
		end
        -----------------------------------------------------------------------
        db.actor:give_talk_message(
            "%c[255,216,186,140]" .. sultan_treasure[ rand_treasure * 2 ],
            "ui\\ui_iconsTotal", Frect():set( 0,0,0,0 ), "simple_answer_item"
        )
        db.actor:give_info_portion( "way_sultan_treasure_" .. rand_treasure )
		remove_value( "sultan_weapon" )
        db.actor:disable_info_portion( "sultan_weapon_starting" )
		kotovod.add_box_protection( obj:name() )
    end
end
	
function load_sultan_weapon_story()
    local tip = get_value( "sultan_weapon", 0 )
    if tip ~= 0 then
		local art_lvl = barter_tbl.sultan[ tip ][ 3 ]	
		local art_text = ""
		if art_lvl == "lvl7"  then art_text = "В качестве оплаты подойдет что-то из модификатов: Капля души, Слёзы Электры, Огненная пустышка, Бабкины бусы, Дикобраз, Стальной колобок, Шкура, Симбион." end
		if art_lvl == "lvl8"  then art_text = "В качестве оплаты подойдет что-то из мезомодификатов: Огненная душа, Слёзы огня, Бусы прабабки, Яркая пустышка, Электрический дикобраз, Титановый колобок, Чешуя." end
		if art_lvl == "lvl9"  then art_text = "В качестве оплаты подойдет что-то из гипермодификатов: Кристальная душа, Слёзы химеры, Бусы бабки бюрера, Лунная пустышка, Сопливый дикобраз, Алмазный колобок, Панцирь." end
		if art_lvl == "lvl10" then art_text = "В качестве оплаты подойдет что-то из абсолютов: Кристальная душа Бенгала, Слеза Гиганта, Пудинг, Бусы прабабки бюрера, Каменный дикобраз, Младший брат Гиганта, Скальп контролёра." end
        db.actor:give_talk_message(
            "%c[255,216,186,140]".. art_text .."",
            "ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0), "simple_answer_item"
        )	
    end
end

function make_static( name, own, text, x, y, width, height )
    local static = CUIStatic()
    static:SetWindowName( name )
    static:SetAutoDelete( true )
    if text then
        static:SetTextComplexMode( true )
        static:SetText( text )
    end
    static:Init( x, y, width, height )
    own:AttachChild( static )
    return static
end

function init_module()
    _dialog = nil
end

function gg_good_artefacts_have( table, need_amount, flag )
    local num = 0
	local condition = 0.85
    for a = 1, #table do
        for i, k in pairs( sak_inventory.rucksack ) do
            if 
						strpos( i, table[ a ], 1, true ) 
				and not strpos( i, "_dyn1d", 1, true )		
				and not strpos( i, "_dyn6d", 1, true )					
			then
				local count = #k		
                for m = 1, count do
                    local obj = client_obj( k[ m ] )
					local dif = tonumber( level.get_game_difficulty() )	
					if dif == 0 then condition = 0.01 end					
                    if obj:condition() >= condition then
						num = num + 1
                    end
                end
            end
        end
    end
    if flag == nil then
        if num >= need_amount then return true end
    else
        return num
    end
end
	 
function gg_good_artefacts_give( table, need_amount )
	local condition = 0.85
    for a = 1, #table do
        for i, k in pairs( sak_inventory.rucksack ) do
            if 
						strpos( i, table[ a ], 1, true ) 
				and not strpos( i, "_dyn1d", 1, true )		
				and not strpos( i, "_dyn6d", 1, true )					
			then
			    local count = #k
                for m = 1, count do
					local obj = client_obj( k[ m ] )
					local dif = tonumber( level.get_game_difficulty() )	
					if dif == 0 then condition = 0.01 end						
                    if obj:condition() >= condition then
						misc.release_obj( obj, true )
						sak.relocate_item( "out", table[ a ], 1 )		
                        need_amount = need_amount - 1
						if need_amount == 0 then return end
                    end
                end
            end
        end
    end
--	ui_barter.barter_screen_ui:UpdatePriceStatic()
end


local sultan_temp_storage = {}

function sultan_good_artefacts_have( item_to_get, need_amount )
	local level_num = tonumber( item_to_get:match( "%d+" ) )
	if not level_num then return false end

	local condition = 0.85
	local dif = tonumber( level.get_game_difficulty() )
	if dif == 0 then condition = 0.01 end

	local inventory_artefacts = {}
	local container_artefacts = {}
	local total = 0

	for lvl = level_num, 10 do
		local arts_tbl = tbl_translate_arts[ "lvl" .. lvl ]
		if arts_tbl then

			-- контейнеры (как в gg_inventory_artefacts)
			local actor_containers = kotovod.get_containers_id()
			for _, id in pairs( actor_containers ) do
				local box = level.object_by_id( id )
				if box then
					local pk = get_netpk( box )
					local box_data = pk:get()
					local sect  = box:section()
					local slots = get_u32( sect, "container_slots" ) or 8
					local arts  = arc_radiation.decode_custom_data( box_data.custom_data, sect, slots )
					for slot_idx, art in ipairs( arts ) do
						if art.section then
							for a = 1, #arts_tbl do
								if
									strpos( art.section, arts_tbl[ a ], 1, true )
									and not strpos( art.section, "_dyn1d", 1, true )
									and not strpos( art.section, "_dyn6d", 1, true )
									and art.condition >= condition
								then
									table.insert( container_artefacts, {
										id = id, slot = slot_idx, art = art.section,
										cond = art.condition, cust = art.custom_data, size = slots
									})
									total = total + 1
									if total >= need_amount then
										sultan_temp_storage[ item_to_get ] = {
											inventory_artefacts = inventory_artefacts,
											container_artefacts = container_artefacts
										}
										return true
									end
									break
								end
							end
						end
					end
				end
			end

			-- рюкзак
			for i, k in pairs( sak_inventory.rucksack ) do
				for a = 1, #arts_tbl do
					if
						strpos( i, arts_tbl[ a ], 1, true )
						and not strpos( i, "_dyn1d", 1, true )
						and not strpos( i, "_dyn6d", 1, true )
					then
						for m = 1, #k do
							local obj = client_obj( k[ m ] )
							if obj and obj:condition() >= condition then
								table.insert( inventory_artefacts, { id = obj:id(), art = obj:section(), cond = obj:condition() } )
								total = total + 1
								if total >= need_amount then
									sultan_temp_storage[ item_to_get ] = {
										inventory_artefacts = inventory_artefacts,
										container_artefacts = container_artefacts
									}
									return true
								end
							end
						end
					end
				end
			end

		end
	end

	sultan_temp_storage[ item_to_get ] = {
		inventory_artefacts = inventory_artefacts,
		container_artefacts = container_artefacts
	}
	return total >= need_amount
end

function sultan_good_artefacts_give( item_to_get, need_amount )
	local saved = sultan_temp_storage[ item_to_get ]
	if not saved then return end

	local given = 0

	-- изъятие из контейнеров — тот же вызов, что и в gg_inventory_artefacts:give
	for _, vv in ipairs( saved.container_artefacts ) do
		if given >= need_amount then break end
		if ui_arc_container_menu.put_out_art( vv.id, vv.slot, vv.art, vv.cond ) then
			given = given + 1

			sak.send_tip(
				get_inv_name( vv.art ),
				"Передали из контейнера [" .. vv.id .. "]:",
				0, 7, "con_" .. ( vv.size or 8 ) .. "_out", "no", "red"
			)
		end
	end

	-- изъятие из рюкзака
	if given < need_amount then
		for _, v in ipairs( saved.inventory_artefacts ) do
			if given >= need_amount then break end
			local obj = client_obj( v.id )
			if obj then
				misc.release_obj( obj )
				sak.relocate_item( "out", v.art, 1 )
				given = given + 1

				sak.relocate_item( "out", v.art, 1 )
			end
		end
	end

	sultan_temp_storage[ item_to_get ] = nil
end

function sultan_good_artefacts_details( item_to_get )
    local level_num = tonumber( item_to_get:match( "%d+" ) )
    local result = {
        container_count  = 0,
        container_items  = {},   -- [sect_name][container_id] = count
        inventory_items  = {},   -- [sect_name] = count
        inventory_total  = 0,
        total            = 0
    }
    if not level_num then return result end

    local condition = 0.85
    local dif = tonumber( level.get_game_difficulty() )
    if dif == 0 then condition = 0.01 end

    for lvl = level_num, 10 do
        local arts_tbl = tbl_translate_arts[ "lvl" .. lvl ]
        if arts_tbl then

            -- контейнеры
            local actor_containers = kotovod.get_containers_id()
            for _, id in pairs( actor_containers ) do
                local box = level.object_by_id( id )
                if box then
                    local pk = get_netpk( box )
                    local box_data = pk:get()
                    local sect  = box:section()
                    local slots = get_u32( sect, "container_slots" ) or 8
                    local arts  = arc_radiation.decode_custom_data( box_data.custom_data, sect, slots )
                    for slot_idx, art in ipairs( arts ) do
                        if art.section then
                            for a = 1, #arts_tbl do
                                if
                                    strpos( art.section, arts_tbl[ a ], 1, true )
                                    and not strpos( art.section, "_dyn1d", 1, true )
                                    and not strpos( art.section, "_dyn6d", 1, true )
                                    and art.condition >= condition
                                then
                                    result.container_count = result.container_count + 1
                                    result.container_items[ art.section ] = result.container_items[ art.section ] or {}
                                    result.container_items[ art.section ][ id ] =
                                        ( result.container_items[ art.section ][ id ] or 0 ) + 1
                                    break
                                end
                            end
                        end
                    end
                end
            end

            -- рюкзак
            for i, k in pairs( sak_inventory.rucksack ) do
                for a = 1, #arts_tbl do
                    if
                        strpos( i, arts_tbl[ a ], 1, true )
                        and not strpos( i, "_dyn1d", 1, true )
                        and not strpos( i, "_dyn6d", 1, true )
                    then
                        for m = 1, #k do
                            local obj = client_obj( k[ m ] )
                            if obj and obj:condition() >= condition then
                                local sect_name = obj:section()
                                result.inventory_items[ sect_name ] =
                                    ( result.inventory_items[ sect_name ] or 0 ) + 1
                                result.inventory_total = result.inventory_total + 1
                            end
                        end
                    end
                end
            end

        end
    end

    result.total = result.container_count + result.inventory_total
    return result
end

function traders_dead()
	return ( has_alife_info( "petrenko_dead" ) or has_alife_info( "skryaga_dead" ) or has_alife_info( "mil_mercs_fire" ) ) ~= false
end

function screen( name )
    local hud = barter_screen_ui( get_hud(), name )
    level.start_stop_menu( hud, true )
end

-- [HE-PORT]
function doctor_scammed_item( flag )
	local payment     = ReadIni( db.stor_ltx, "stor", "doctor_barter" )
	local doctor_stor = vergas_lib.str_explode( "|", payment, true )
	local need_sect   = tostring( doctor_stor[ 1 ] )
	local need_amount = tonumber( doctor_stor[ 2 ] )
	local reward_sect = tostring( doctor_stor[ 3 ] )

	if flag == "is_scammer" then
		if reward_sect ~= "nil" and get_value( "item_givenout" ) == nil then return true end
		return false
	end

	if flag == "not_scammer" then
		return not doctor_scammed_item( "is_scammer" )
	end

	if flag == "scammer_text" then
		db.actor:give_talk_message(
			"%c[255,216,186,140]Ты думал, я забуду? С тебя причитается: " .. get_inv_name( need_sect ) .. " в количестве: " .. tonumber( need_amount ) .. " шт.",
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item"
		)
	end

	if flag == "have" then
		return sak.have_items_count( need_sect, need_amount ) ~= false
	end

	if flag == "give" then
		sak_inventory.release_actor_items( need_sect, need_amount )
		sak.create_items( reward_sect, 1 )
		WriteIni( db.stor_ltx, "stor", "doctor_barter", "nil" .. "|" .. 0 .. "|" .. "nil" )
	end

	if flag == "stor" then
		WriteIni( db.stor_ltx, "stor", "doctor_barter", "nil" .. "|" .. 0 .. "|" .. "nil" )
	end
end
