class "barter_screen_ui"( CUIScriptWnd )

function barter_screen_ui:__init( owner, baryga ) super()
    self.b_name = baryga
    self.owner  = owner
    _dialog     = self
    self:InitControls()
    self:InitCallBacks()
    self:FillList()
end

function barter_screen_ui:__finalize() end

function barter_screen_ui:InitControls()
    self:Init( 0, 0, 1024, 768 )
    local xml = CScriptXmlInit()
    local ctrl
    xml:ParseFile( "ui_barter.xml" )
    self.xml     = xml
    self.dialog  = xml:InitStatic( "main_dialog:dialog", self )
    self.cap_wnd = make_static(
        "cap_wnd", self, tbl_npc_name_koeff[ self.b_name ][ 2 ], 251, 140, 260, 39
    )
    self.cap_wnd:SetTextColor( unpack( clr_orange ) )
    self.cap_wnd:SetFont( GetFontGraffiti19Russian() )
    self.cap_price = make_static( "cap_price", self, "Стоимость товара:", 251, 420, 200, 39 )
    self.cap_price:SetTextColor( unpack( clr_orange ) )
    self.cap_price:SetFont( GetFontGraffiti19Russian() )
    self:Register( xml:Init3tButton( "btn_ok",     self ), "btn_ok"     )
    self:Register( xml:Init3tButton( "btn_cancel", self ), "btn_cancel" )
	
    self:Register( xml:Init3tButton( "btn_art_up",     self ), "btn_art_up"     )
    self:Register( xml:Init3tButton( "btn_art_down",   self ), "btn_art_down" )	
	
	self:GetButton( "btn_art_up" ):Show( false )	
	self:GetButton( "btn_art_down" ):Show( false )	
	
    xml:InitFrame( "main_dialog:price_bg",   self.dialog )
    xml:InitFrame( "main_dialog:list_frame", self.dialog )
    ctrl = xml:InitList( "main_dialog:list", self.dialog )
    ctrl:ShowSelectedItem( true )
    self:Register( ctrl, "list_window" )
    self.message_box = CUIMessageBoxEx()
    self:Register( self.message_box,"message_box" )
	self.descr_scroll = xml:InitScrollView( "descr_scroll", self )
    self.price_detail_scroll = xml:InitScrollView( "price_detail_scroll", self )
end

function barter_screen_ui:InitCallBacks()
    self:AddCallback( "btn_ok",      	ui_events.BUTTON_CLICKED,          	self.OnBtnOk,              self )
    self:AddCallback( "btn_cancel",  	ui_events.BUTTON_CLICKED,          	self.OnBtnCancel,          self )
	
    self:AddCallback( "btn_art_up",     ui_events.BUTTON_CLICKED,      		self.OnBtnArtUp,       	   self )
    self:AddCallback( "btn_art_down",   ui_events.BUTTON_CLICKED,      		self.OnBtnArtDown,     	   self )	
	
    self:AddCallback( "list_window", 	ui_events.LIST_ITEM_CLICKED,       	self.OnListItemClicked,    self )
    self:AddCallback( "message_box", 	ui_events.MESSAGE_BOX_YES_CLICKED, 	self.OnMsgYes,             self )
end

function barter_screen_ui:FillList()
    local list = self:GetListWnd( "list_window" )
    if list:GetSize() > 0 then list:RemoveAll() end
    self.work_tbl = make_list_by_trader( self.b_name )
    for k, v in pairs( self.work_tbl ) do
        local item_name   = v[ 1 ]
        local item_amount = v[ 2 ]
		local item_to_get = v[ 3 ]
		local item_needed = v[ 4 ]		
        self:AddItemToList( item_name, item_amount, item_to_get, item_needed )
    end
end

function barter_screen_ui:on_quit()
    if self then
		self:GetHolder():start_stop_menu(self, true)
		self:ClearCallbacks()	  
    end
    _dialog = nil
end

function barter_screen_ui:OnMsgYes()
    local count = 0
    for _ in pairs( self.work_tbl ) do count = count + 1 end
    local list = self:GetListWnd( "list_window" )
    local itm_index = list:GetSelectedItem()
    if itm_index < 0 or count < itm_index + 1 then return end	
    if self.msgbox_id == 1 then
        local sect = self.work_tbl[ itm_index + 1 ][ 1 ]
        local tip  = 0
        for k, v in pairs ( barter_tbl.sultan ) do
            if sect == v[ 1 ] then tip = k end
        end
        set_value( "sultan_weapon", tip )
        actor:give_info_portion( "sultan_weapon_starting" )
    end
    self.msgbox_id = 0
    self:on_quit()
end

function barter_screen_ui:OnBtnOk()
    local count = 0
    local list  = self:GetListWnd( "list_window" )
    for _ in pairs( self.work_tbl ) do count = count + 1 end
    if list:GetSize() == 0 then return end
    local itm_index = list:GetSelectedItem()
    if 
		itm_index < 0 or count < itm_index + 1 
	then 
		return
    else
        if self.b_name == "sultan" then
            self.msgbox_id = 1
            self.message_box:Init( "msg_box_confirm_sultan" )
            self:GetHolder():start_stop_menu( self.message_box, true )
        end
    end
end

function barter_screen_ui:OnBtnCancel()
	new_price = false 
    self:on_quit()
end

function barter_screen_ui:OnListItemClicked()	
    local count = 0
    local list  = self:GetListWnd( "list_window" )
    if list:GetSize() == 0 then return end
    local itm_index = list:GetSelectedItem()
    for _ in pairs( self.work_tbl ) do count = count + 1 end
    if itm_index < 0 or count < itm_index + 1 then return end
    if self.pict    then self:DetachChild( self.pict    ) end
    if self.pict_bg then self:DetachChild( self.pict_bg ) end
	if self.new_tovar then self:DetachChild( self.new_tovar ) end
    if self.descr then
        self.descr_scroll:Clear()
        self.descr:DetachFromParent()
    end

    self.price_tbl   = self.work_tbl[ itm_index + 1 ][ 3 ]
	
    self.price_amnt  = self.work_tbl[ itm_index + 1 ][ 4 ]

        if not strposx( self.work_tbl[ itm_index + 1 ][ 1 ], "lvl" ) then
			local sizes = give_icon_params( self.work_tbl[ itm_index + 1 ][ 1 ] )				
            local px     = 440 + ( 182 - ( sizes.width  * 0.26 * 1.2 ) )                        -- 0.26 для 1:1 на 1920
            local py     = 118 + ( 128 - ( sizes.height * 0.32 * 1.2 ) )                        -- 0.32 для 1:1 на 1920
            self.pict_bg = make_static( "pict_bg", self, false, 507, 179, 229, 146 )
            self.pict_bg:InitTexture( "ui\\ui_unique_weapon" )
            self.pict_bg:SetOriginalRect( 350, 454, 348, 150 )
            self.pict_bg:SetStretchTexture( true )
            self.pict = make_static(
                "pict", self, false, px, py,
                ( sizes.width * 0.52 * 1.2 ), ( sizes.height * 0.64 * 1.2 )
            )
            if sizes.icon_group == 0 then
                self.pict:InitTexture( "ui\\ui_icon_equipment" )
            else
                self.pict:InitTexture( "ui\\ui_icon_equipment_" .. sizes.icon_group )
            end
            self.pict:SetOriginalRect( sizes.x, sizes.y, sizes.width, sizes.height )
            self.pict:SetStretchTexture( true )
            self.descr = self.xml:InitStatic( "descr_list", self.descr_scroll )
            self.descr:SetText( sizes.description )
            self.descr:SetTextComplexMode( true )
            self.descr:AdjustHeightToText()
        end
    self:UpdatePriceStatic()
end

function barter_screen_ui:UpdatePriceStatic()
    local have_amount = 0
    local price_color = clr_red
    if self.price then self:DetachChild( self.price ) end
    if self.price_have then self:DetachChild( self.price_have ) end
    local price_text = ""

        if strposx( self.price_tbl, "lvl" ) then
            price_text = tbl_translate_price[ self.price_tbl ]
        else
            price_text = game.translate_string( utils.cfg_get_string( ini, self.price_tbl, "inv_name", nil, false, "" ) )
        end	
		
		price_text = "%c[ 255, 216, 186, 140 ]" .. price_text .. ": ".. "%c[default]" .. tostring( self.price_amnt ) .. " шт."
		
        if strposx( self.price_tbl, "lvl" ) then
            if self.b_name == "sultan" then
                self.sultan_details = sultan_good_artefacts_details( self.price_tbl )
                have_amount = self.sultan_details.total
            else
                have_amount = gg_good_artefacts_have( tbl_translate_arts[ self.price_tbl ], self.price_amnt, true )
            end
        end

        if have_amount >= self.price_amnt then price_color = clr_green end
		
    if self.b_name == "sultan" then price_color = clr_white end
    self.price = make_static( "price", self, tostring( price_text ), 252, 456, 200, 100 )
    self.price:SetTextColor( unpack( price_color ) )
	self.price:SetFont( GetFontLetterica18Russian() )
    self.price_have = make_static( "price_have", self, game.translate_string( "%c[ 255, 216, 186, 140 ]В наличии у Меченного: %c[default]" .. tostring( have_amount ) .. " шт." ), 252, 470, 200, 100 )
    self.price_have:SetTextColor( unpack( price_color ) )
	self.price_have:SetFont( GetFontLetterica18Russian() )
	
    if self.price_detail then
        self.price_detail_scroll:Clear()
        self.price_detail:DetachFromParent()
        self.price_detail = nil
    end

    if self.b_name == "sultan" and self.sultan_details then
        local d = self.sultan_details
        local detail_text = "%c[ 255, 216, 186, 140 ]В контейнере:%c[default]"
        local any_c = false
        for sect_name, by_id in pairs( d.container_items ) do
            local nm = get_inv_name( sect_name )
            for id, cnt in pairs( by_id ) do
                any_c = true
                detail_text = detail_text .. " " .. nm .. " x" .. cnt .. " [" .. id .. "],"
            end
        end
        if not any_c then
            detail_text = detail_text .. " нет\\n"
        else
            detail_text = detail_text:sub( 1, -2 ) .. "\\n"
        end

        detail_text = detail_text .. "%c[ 255, 216, 186, 140 ]В инвентаре:%c[default]"
        local any_i = false
        for sect_name, cnt in pairs( d.inventory_items ) do
            any_i = true
            local nm = get_inv_name( sect_name )
            detail_text = detail_text .. " " .. nm .. " x" .. cnt .. ","
        end
        if not any_i then
            detail_text = detail_text .. " нет"
        else
            detail_text = detail_text:sub( 1, -2 )
        end

        self.price_detail = self.xml:InitStatic( "price_detail_text", self.price_detail_scroll )
        self.price_detail:SetTextComplexMode( true )
        self.price_detail:SetText( detail_text )
        self.price_detail:SetTextColor( unpack( clr_dgray ) )
        self.price_detail:SetFont( GetFontLetterica18Russian() )
        self.price_detail:AdjustHeightToText()
    end
end

function barter_screen_ui:AddItemToList( item_name, item_amount, item_to_get, item_needed )
    local _itm = load_item()
    local list = self:GetListWnd( "list_window" )
    local itm_name, amnt = "<<ERROR>>", ""

	if strposx( item_name, "lvl" ) then 
		itm_name = tbl_translate_price[ item_name ]
	else
		itm_name = game.translate_string(
			utils.cfg_get_string( ini, item_name, "inv_name", nil, false, "" )
		)
	end
	
	-- Покраска в серый при отсутствии — оставляем проверку только для sultan
	if self.b_name == "sultan" then
		if not sultan_good_artefacts_have( item_to_get, item_needed ) then
			_itm.fn:SetTextColor( unpack( clr_dgray ) )
		end
	elseif str_in_tab( self.b_name, { "addons" } ) and gg_good_artefacts_have( tbl_translate_arts[ item_to_get ], item_needed ) ~= true then
		_itm.fn:SetTextColor( unpack( clr_dgray ) )
	-- [HE-PORT]
	elseif self.b_name == "doctor" and sak.have_items_count( item_to_get, item_needed ) == false then
		_itm.fn:SetTextColor( unpack( clr_dgray ) )
	end
	
    _itm.fn:SetText( itm_name )
    _itm.fa:SetText( amnt )
		
    list:AddItem( _itm )
end

function barter_screen_ui:DoBarter( ind )
    local count = 0
    local list  = self:GetListWnd( "list_window" )
    if list:GetSize() == 0 then return end
    local itm_index = list:GetSelectedItem()
    for _ in pairs( self.work_tbl ) do count = count + 1 end
    if itm_index < 0 or count < itm_index + 1 then return end
    local tovar       = self.work_tbl[ ind ][ 1 ]
    local tovar_amnt  = self.work_tbl[ ind ][ 2 ]
    local need_sect   = self.work_tbl[ ind ][ 3 ]
    local need_amount = self.work_tbl[ ind ][ 4 ]	
	--------------------------------------------------------------------	
    if strposx( need_sect, "lvl" ) then
	    if self.b_name == "sultan" then
			if sultan_good_artefacts_have( need_sect, need_amount ) then
				sultan_good_artefacts_give( need_sect, need_amount )
				sak.create_items( tovar, tovar_amnt )
			end
		elseif str_in_tab( self.b_name, { "addons" } ) then
			if gg_good_artefacts_have( tbl_translate_arts[ need_sect ], need_amount ) then
				gg_good_artefacts_give( tbl_translate_arts[ need_sect ], need_amount )		
				sak.create_items( tovar, tovar_amnt )
			end		
		end	
    else
        if sak.have_items_count( need_sect, need_amount ) then
            sak_inventory.release_actor_items( need_sect, need_amount )
			-- [HE-PORT]
			if self.b_name == "doctor" and strposx( tovar, "lvl" ) then
				local art_sect, win_chance = "", 100
				if strposx( need_sect, "rucksack" ) then
					art_sect   = kotovod.rnd_rec_art_info( kotovod.tbl_arts, 2, lua_random( 1, 2 ) )
					win_chance = 98
				end
				if strposx( need_sect, "amk_ballon" ) then
					art_sect   = kotovod.rnd_rec_art_info( kotovod.tbl_arts, 2, lua_random( 1, 3 ) )
					win_chance = 95
				end
				if strposx( need_sect, "arc_art_box_basic" ) then
					art_sect   = kotovod.rnd_rec_art_info( kotovod.tbl_arts, 5, lua_random( 1, 3 ) )
					win_chance = 90
				end
				if strposx( need_sect, "arc_art_box_1basic" ) then
					art_sect   = kotovod.rnd_rec_art_info( kotovod.tbl_arts, 5, lua_random( 2, 5 ) )
					win_chance = 80
				end
				if lua_random( 100 ) > win_chance then
					art_sect = kotovod.rnd_rec_art_info( kotovod.tbl_arts, 11 )
				end
				sak.create_items( art_sect, tovar_amnt )
				WriteIni( db.stor_ltx, "stor", "doctor_barter", need_sect .. "|" .. need_amount .. "|" .. art_sect )
				set_value( "item_givenout", art_sect )
				sak_dialog.start_time( "ui_barter_doctor" )
				self:on_quit()
			else
				sak.create_items( tovar, tovar_amnt )
			end
        end
    end
end

