end

function finish(npc_name)
    if native_barter_active and native_barter_active.npc_name == npc_name then
        native_barter_active = nil
    end
end

local function native_actor_price(section)
    if not native_barter_active then return nil end
    local base = sak_inventory.dyn_art_base(section)
    return native_barter_active.accepted[base] or native_barter_active.accepted[section]
end

function item_visible_in_trade(obj, actor_side)
    if not native_barter_active then return nil end
    if not obj then return false end
    if actor_side then return native_actor_price(obj:section()) ~= nil end

    local section = obj:section()
    if not native_barter_active.rewards[section] then return false end
    local info = native_barter_active.recipe_infos[section]
    if info and has_alife_info(info) then return false end
    return trade_manager.is_temporary_trade_item(native_barter_active.npc_name, obj:id())
end

function trade_get_buy_price(trader, section)
    if not native_barter_active or trader:name() ~= native_barter_active.npc_name then return nil end
    return native_actor_price(section)
end

function trade_get_sell_price(trader, section)
    if not native_barter_active or trader:name() ~= native_barter_active.npc_name then return nil end
    return native_barter_active.rewards[section]
end

function on_trade(item, is_sold)
    if not native_barter_active or is_sold or not item then return end
    local info = native_barter_active.recipe_infos[item:section()]
    if not info then return end
    if not has_alife_info(info) then
        db.actor:give_info_portion(info)
        if info:match("^info_artmod_") then
            sak.info_artmod()
        elseif info:match("^info_amk_recipt_") then
            sak.info_amk_received()
        end
    end
    misc.release_obj(item)
end

function get_waiting_message( time_left )
    local colored_hours = string.format( "%%c[255,238,153,26]%d%%c[default]", time_left )
    local hour_form = kotovod.declension( time_left, "час", "часа", "часов" )
    local messages = {
        "Слушай, Меченный, надо подождать %s %s. Я тебе весточку пришлю, как будет готово.",
        "Тут такое дело... Примерно через %s %s всё будет. Я маякну, как добуду.",
        "Потерпи %s %s, лады? Сам знаешь, дело тонкое. Дам знать, как всё срастётся.",
        "%s %s надо, не раньше. Зона – она такая, спешку не любит. Я свистну, как всё будет.",
        "Давай так: жди примерно %s %s. Как только, так сразу сообщение пришлю."
    }
    return string.format( messages[ lua_random( #messages ) ], colored_hours, hour_form )
end
function greens_not_have_kolbasa() return not greens_have_kolbasa() end
function menyala_art_gift()
    local menyala_orders = xray_vars.load_table( nlc_vars, "menyala_orders", {} )
    local orders_to_remove = {}
	
    -- Выдаем все готовые артефакты
    for id, order in pairs( menyala_orders ) do
        if order.completed then
            for _, art in pairs( order.arts ) do
                kotovod.add_bad_item( art.section, art.condition )
            end
            table.insert( orders_to_remove, id )
        end
    end
    
    -- Удаляем обработанные заказы
    for _, id in ipairs( orders_to_remove ) do
        menyala_orders[ id ] = nil
    end
    
    -- Сохраняем обновленную таблицу
    nlc_vars.menyala_orders = menyala_orders
    
    db.actor:disable_info_portion( "art_exchanger_delivered" )
end
function menyala_time_info()   
    if not order_id then return end
    local menyala_timer = timers.get_timer_info( "menyala_timer_" .. order_id )
    if menyala_timer and menyala_timer.time_left > 0 then 
        local hours = math.round( menyala_timer.time_left / 60 )
        db.actor:give_talk_message(
            "%c[255,216,186,140]" .. get_waiting_message( hours ),
            "ui\\ui_iconsTotal", Frect():set(0, 0, 0, 0), "simple_answer_item"
        )       
    end    
end
function need_sultan_weapon_art( sect )
    local min_art = tonumber( sect:sub( 4 ) )
    local tip     = nlc_vars.sultan_weapon or 0
    for k, v in pairs ( barter_tbl.sultan ) do
        local comp_art = tonumber( v[ 3 ]:sub( 4 ) )
        if k == tip and min_art >= comp_art then return true end
    end
    return false
end
function traders_dead()
	return ( has_alife_info( "petrenko_dead" ) or has_alife_info( "skryaga_dead" ) or has_alife_info( "mil_mercs_fire" ) ) ~= false
end
