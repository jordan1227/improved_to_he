
-- [HE-PORT] perenos kvestovyh funkcij iz NLC HE (kotovod\ui_barter.script)

-- [HE-PORT] proxy: staroe hranilishche nlc_vars poverh dvizhkovogo xvars (get_value/set_value iz _g)
if nlc_vars == nil then
  nlc_vars = setmetatable( {}, {
    __index    = function( t, k ) return get_value( "nlc_vars." .. k ) end,
    __newindex = function( t, k, v ) set_value( "nlc_vars." .. k, v ) end,
  } )
end
local actor      = db.actor
function greens_have_kolbasa()
	return nlc_vars.greens_kolbasa > 0
end
function ignat_debt_create()
	if not greens_have_kolbasa() or nlc_vars.ignat_debt == nil then return end
	db.actor:give_talk_message(
		"Лёгок на помине, а мы как раз для тебя колбаску приготовили. Забирай должок.",
		"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item"
	)	
	local info = vergas_lib.str_explode( ",", nlc_vars.ignat_debt, true )
	for i = 1, info[ 1 ] do
		local kolbasa = misc.spawn_to( "green_kolbasa", actor )
		misc.process_spawn()	
		params.upd_condition( kolbasa.id, info[ 2 ] )	
	end		
	sak.relocate_item( "in", "green_kolbasa", info[ 1 ] )	
	nlc_vars.ignat_debt = nil	
end

