-- [HE-PORT] Выдача поршней

local MAX_SHOW = 30
local _wnd = nil

function open()
	if not db.actor then return end
	if _wnd then return end
	level.start_stop_menu( info_giver_wnd( get_hud() ), true )
end

function make_static( name, own, text, x, y, w, h )
	local s = CUIStatic()
	s:SetWindowName( name )
	s:SetAutoDelete( true )
	if text then s:SetTextComplexMode( true ) s:SetText( text ) end
	s:Init( x, y, w, h )
	own:AttachChild( s )
	return s
end

class "info_giver_wnd" ( CUIScriptWnd )

function info_giver_wnd:__init( owner ) super()
	_wnd = self
	self.text = ""
	self.mode_give = true
	self.shown = {}
	self:InitControls()
	self:Refresh()
end

function info_giver_wnd:__finalize()
	_wnd = nil
end

function info_giver_wnd:InitControls()
	self:Init( 0, 0, 1026, 861 )
	local xml = CScriptXmlInit()
	xml:ParseFile( "ui_he_infogiver.xml" )
	self.dialog   = xml:InitStatic( "main_dialog:dialog", self )
	self.edit_box = xml:InitEditBox( "main_dialog:frame_search", self.dialog )
	self.title  = make_static( "he_title",  self, "HE info-giver   [Enter] #1   [NumPad 1-9,0] #N   [Tab] mode   [Backspace] erase   [Esc] exit", 185, 120, 720, 30 )
	self.status = make_static( "he_status", self, "", 185, 150, 720, 30 )
	self.list   = make_static( "he_list",   self, "", 185, 210, 720, 620 )
	local set = { self.title, self.status, self.list }
	for i = 1, #set do
		set[i]:SetTextColor( 255, 255, 255, 255 )
		set[i]:SetFont( GetFontLetterica18Russian() )
	end
end

function info_giver_wnd:Refresh()
	local flt = string.upper( self.text )
	local ids = he_info_list.get()
	local a = db.actor
	local out = {}
	self.shown = {}
	local n = 0
	for i = 1, #ids do
		local id = ids[i]
		if flt == "" or string.find( string.upper( id ), flt, 1, true ) then
			n = n + 1
			if n <= MAX_SHOW then
				self.shown[n] = id
				local mark = ( a and a:has_info( id ) ) and "  [+]" or ""
				out[#out+1] = string.format( "%2d.  %s%s", n, id, mark )
			end
		end
	end
	self.status:SetText( string.format( "Mode: %s      filter: '%s'      matches: %d (showing %d)",
		self.mode_give and "GIVE (+)" or "REMOVE (-)", self.text, n, math.min( n, MAX_SHOW ) ) )
	if n == 0 then out[1] = "( no matches )" end
	self.list:SetText( table.concat( out, "\n" ) )
end

function info_giver_wnd:Apply( idx )
	local id = self.shown[idx]
	if not id then return end
	local a = db.actor
	if not a then return end
	if self.mode_give then a:give_info_portion( id ) else a:disable_info_portion( id ) end
	self:Refresh()
end

function info_giver_wnd:BackSpace()
	if self.text ~= "" then self.text = string.sub( self.text, 1, string.len( self.text ) - 1 ) end
	self.edit_box:SetText( "" )
	self:Refresh()
end

function info_giver_wnd:OnKeyboard( dik, action )
	CUIScriptWnd.OnKeyboard( self, dik, action )
	if action == ui_events.WINDOW_KEY_PRESSED then
		local D = DIK_keys
		if dik == D.DIK_ESCAPE then self:OnQuit()
		elseif dik == D.DIK_RETURN then self:Apply( 1 )
		elseif dik == D.DIK_TAB then self.mode_give = not self.mode_give self:Refresh()
		elseif dik == D.DIK_BACK or dik == D.DIK_DELETE then self:BackSpace()
		elseif dik == D.DIK_NUMPAD1 then self:Apply( 1 )
		elseif dik == D.DIK_NUMPAD2 then self:Apply( 2 )
		elseif dik == D.DIK_NUMPAD3 then self:Apply( 3 )
		elseif dik == D.DIK_NUMPAD4 then self:Apply( 4 )
		elseif dik == D.DIK_NUMPAD5 then self:Apply( 5 )
		elseif dik == D.DIK_NUMPAD6 then self:Apply( 6 )
		elseif dik == D.DIK_NUMPAD7 then self:Apply( 7 )
		elseif dik == D.DIK_NUMPAD8 then self:Apply( 8 )
		elseif dik == D.DIK_NUMPAD9 then self:Apply( 9 )
		elseif dik == D.DIK_NUMPAD0 then self:Apply( 10 )
		else
			local letter = string.sub( self.edit_box:GetText(), -1 )
			if letter and letter ~= "" then
				self.text = self.text .. letter
				self.edit_box:SetText( "" )
				self:Refresh()
			end
		end
	end
	return true
end

function info_giver_wnd:OnQuit()
	local holder = self:GetHolder()
	if holder then holder:start_stop_menu( self, true ) end
	self:ClearCallbacks()
	_wnd = nil
end
