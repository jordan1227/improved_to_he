-- [HE-PORT] Cordon: the six stray all.spawn soldiers (esc_specnaz1..6) are deleted on load, as Old HE did
-- (escape_raid.dbg_clean). Alive ones only: a body the player already made stays. See docs/ESC_SPECNAZ_DESIGN.md.

local NAMES = 6

function on_load()
	if not g_sim then return end
	for i = 1, NAMES do
		local sobj = g_sim:object("esc_specnaz" .. i)
		if sobj and sobj:alive() then
			log2("[he_esc_specnaz] released %s id=%d", sobj:name(), sobj.id)
			g_sim:release(sobj, true)
		end
	end
end

function attach(sm)
	sm:subscribe({ signal = "on_late_init_all", fun = this.on_load })
end
