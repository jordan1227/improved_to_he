-- Exact base item sections only. Addon/HUD permutations resolve to their base
-- section and deliberately use the fallback if the engine ever exposes one.
-- l/r affect the continuous left/right lean sway; c/u affect the held crouch
-- sway and look-up dip. None alter the global one-shot crouch kick constants
-- in sivol_weapon_inertia.script.
sivol_weapon_inertia = sivol_weapon_inertia or {}
sivol_weapon_inertia.wpn_all_configs = sivol_weapon_inertia.wpn_all_configs or {}

local configs = sivol_weapon_inertia.wpn_all_configs

local function register(sections, l, r, c, u)
    for _, section in ipairs(sections) do
        configs[section] = { l = l, r = r, c = c, u = u }
    end
end

register({ "wpn_ak74_m3", "wpn_aps", "wpn_beretta", "wpn_beretta93", "wpn_colt1911",
    "wpn_desert_eagle", "wpn_eagle_m1", "wpn_fort", "wpn_fort_m1", "wpn_glock",
    "wpn_glock_m1", "wpn_gungauss", "wpn_pb", "wpn_pm", "wpn_sig220", "wpn_usp",
    "wpn_walther" }, 1.00, 1.00, 0.70, 0.60)

register({ "wpn_aks47", "wpn_bizon", "wpn_glock_m2", "wpn_mp5", "wpn_mp5_m1",
    "wpn_mp5_m2", "wpn_pp19", "wpn_ump45" }, 1.00, 1.00, 0.85, 0.75)

register({ "wpn_abakan", "wpn_aek971", "wpn_ak104", "wpn_ak47", "wpn_ak74",
    "wpn_ak74_m1", "wpn_ak74_m2", "wpn_ak74m", "wpn_ak74u", "wpn_akm", "wpn_aks47_he", "wpn_fn2000",
    "wpn_g36", "wpn_groza", "wpn_groza_nimble", "wpn_m16a4", "wpn_saiga12c_m2",
    "wpn_sig550", "wpn_soc308", "wpn_soc308_m1", "wpn_val", "wpn_val_nimble" }, 1.00, 1.00, 1.00, 1.00)

register({ "wpn_bm16", "wpn_bm16_full", "wpn_hunters_toz_new", "wpn_mp153",
    "wpn_mp153_m1", "wpn_saiga12c", "wpn_saiga12c_m1", "wpn_spas12", "wpn_spas12_m1",
    "wpn_spas15", "wpn_spas15_m1", "wpn_toz34", "wpn_toz34_m1", "wpn_wincheaster1300",
    "wpn_winchester_m1", "wpn_mp133_full" }, 1.00, 1.00, 1.10, 0.90)

register({ "wpn_awm", "wpn_gauss", "wpn_gauss_auto", "wpn_m110", "wpn_mosin", "wpn_mr308",
    "wpn_sv98", "wpn_svd", "wpn_svu", "wpn_vintorez", "wpn_vintorez_m1" }, 1.00, 1.00, 1.20, 1.20)

register({ "wpn_ak108", "wpn_g36c", "wpn_pkm", "wpn_pkp", "wpn_rpk", "wpn_rpk74" }, 1.00, 1.00, 1.35, 1.20)

register({ "wpn_flame", "wpn_gm94", "wpn_rg6", "wpn_rpg7" }, 1.00, 1.00, 1.25, 1.00)

-- This is in the signals list directly after sivol_weapon_inertia. The no-op
-- attachment is required by ogse_signals and makes that load order explicit.
function attach(sm)
end

sivol_weapon_inertia_configs = sivol_weapon_inertia_configs or {}
sivol_weapon_inertia_configs.attach = attach