-- [sivol] Текст бартерных цен, собранный из конфигов торговцев (для статей PDA "Бартер").
-- Вызывается из строк через $$LUASTRING_sivol_barter_text.<функция>$$.
-- Цена = cost предмета (для патронов - за пачку) * коэффициент из секции продажи торговца.
-- Функции чистые: только читают конфиги, ничего не меняют.

local function price_lines( cfg, sect )
	local ini = ini_file( cfg )
	if not ini or not ini:section_exist( sect ) then return "" end
	local sys = system_ini()
	local out = {}
	for i = 0, ini:line_count( sect ) - 1 do
		local _, key, value = ini:r_line( sect, i, "", "" )
		-- регэкспы вида /.*/ - это запреты, пропускаем
		if key and key ~= "" and not string.find( key, "/", 1, true ) and sys:section_exist( key ) then
			local k = tonumber( string.match( value or "", "^%s*([%d%.]+)" ) )
			local cost = sys:line_exist( key, "cost" ) and sys:r_float( key, "cost" ) or 0
			if k and cost > 0 then
				table.insert( out, string.format( "\\n %s - %d", game.translate_string( amk.get_inv_name( key ) ), math.floor( cost * k ) ) )
			end
		end
	end
	return table.concat( out )
end

local function safe( cfg, sect )
	local ok, res = pcall( price_lines, cfg, sect )
	if ok then return res end
	return ""
end

function sidor()
	return "%c[255,160,160,160]" .. game.translate_string( "sivol_barter_text_header" ) .. "%c[default]"
		.. safe( "misc\\shop_sidor\\sidor_barter.ltx", "sidor_barter_sell" )
end
