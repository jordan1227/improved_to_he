-- sivol_emp_config.script
-- Single source of truth for electra/EMP-disturbance tuning, consumed by
-- pda_noise.script, sivol_pda.script, nvd_params.script, nlc_torch.script.
-- No logic here — pure numbers, so balance changes never require touching
-- the systems that read them.

ELECTRA_TIER = {
    weak    = { radius_mult = -1.0, max_limit = 0.7 },
    average = { radius_mult =  0.0, max_limit = 0.9 },
    strong  = { radius_mult =  1.5, max_limit = 1.0 },
}

-- sivol_emp_config.script
-- Electric poltergeist variants only — pyrogeists deliberately excluded, fire ≠ EMP.
-- `critical`: whether this variant is eligible to trigger blackout/critical-malfunction
-- regardless of its own max_limit — decoupled on purpose so even the weakest electric
-- poltergeist is "as dangerous up close" as a strong electra, per design intent.
POLTERGEIST_TIER = {
    m_poltergeist_normal       = { radius = 8.0, max_limit = 1.10, critical = true },
    m_poltergeist_normal_tele  = { radius = 8.0, max_limit = 1.10, critical = true },
    m_poltergeist_tele_outdoor = { radius = 9.0, max_limit = 1.20, critical = true },  -- ~33% bigger radius, matches its larger tele_find_radius
}
-- m_poltergeist_normal_flame / _strong_flame / _dark_flame intentionally absent —
-- fire aura still toggles normally in bind_monster.script, just no EMP registration.

ELECTRO_CHIMERA_TIER = { radius = 15.0, max_limit = 0.5, critical = false }
-- Defensive Electra-like pulse triggered when an electro-chimera is hit.
-- Separate from its passive ambient field and independently cooldown-gated.
ELECTRO_CHIMERA_BURST = {
    radius = 10.0,
    max_limit = 1.0,
    critical = false,
    duration = 1500,
    cooldown = 5000,
}

BLACKOUT_START = 0.85   -- electra_eff threshold where full-screen blackout begins
BLACKOUT_BAND  = 0.15   -- how far above START it takes to reach full blackout

NVD_AVER_GLITCH_BASE = 0.25
NVD_GLITCH_MAX       = 0.45
NVD_NOISE_MAX        = 0.6

-- Extra NVD instability layered over the existing smooth glitch/noise response.
NVD_EMP_VISUAL = {
    update_interval = 100,
    spike_interval_min = 650,
    spike_interval_max = 1800,
    spike_duration_min = 70,
    spike_duration_max = 220,
    gain_drop_max = 0.35,
    gain_wobble = 0.12,
    scintillation_drop_max = 0.45,
}

-- fill in with whatever nlc_torch.script's current aver flicker constant is
TORCH_AVER_FLICKER = 0.35

-- optional: runtime setters, same convention as sivol_anom_effects.script's
-- set_intensity_mult/set_distance_mult, if you want console/MCM tuning later
function set_electra_tier(name, radius_mult, max_limit)
    if ELECTRA_TIER[name] then
        ELECTRA_TIER[name].radius_mult = radius_mult
        ELECTRA_TIER[name].max_limit = max_limit
    end
end

-- ARTIFACT EMP effects
ARTIFACT_PDA_FX = {
    af_electra_sparkler  =  0.10, -- broadcaster
    af_electra_flash     =  0.16, -- broadcaster
    af_electra_moonlight =  0.22, -- broadcaster
    af_electra_sparkler_dyn1d  =  0.25, -- broadcaster; electrically vulnerable
    af_electra_flash_dyn1d     =  0.40, -- broadcaster; electrically vulnerable
    af_electra_moonlight_dyn1d =  0.55, -- broadcaster; electrically vulnerable
    af_glassbeads        = -0.65, -- shield, tier-scaled same as broadcasters
    af_dummy_battery            = -0.75, -- heavy shield
    af_red_dummy_battery = -0.55, -- strong shield, slightly below Battery
    af_cry_1             = -0.45,
    af_cry_2             = -0.50,
    af_cry_3             = -0.55,
    af_cry_4             = -0.60,
    af_electra_sparkler_dyn4d  = 0.0, -- no electrical vulnerability
    af_electra_sparkler_dyn5d  = 0.0, -- no electrical vulnerability
    af_electra_flash_dyn4d     = 0.0, -- no electrical vulnerability
    af_electra_flash_dyn5d     = 0.0, -- no electrical vulnerability
    af_electra_moonlight_dyn4d = 0.0, -- no electrical vulnerability
    af_electra_moonlight_dyn5d = 0.0, -- no electrical vulnerability
    af_electra_sparkler_dyn6d  = 0.0,
    af_electra_flash_dyn6d     = 0.0,
    af_electra_moonlight_dyn6d = 0.0,
    af_glassbeads_dyn6d        = 0.0,
}

ARTIFACT_PDA_CHECK_INTERVAL = 5000

-- TORCH_MALFUNCTION — shared lesser-EMP event emitted by sivol_pda.script.
-- NVD and flashlight consume the same event, so failures read as one pulse.
TORCH_MALFUNCTION = {
    threshold    = 0.75,     -- 0..1 — shared exposure must exceed this before events become eligible.
    reset_threshold = 0.65,  -- eligibility remains latched until exposure falls below this value
    min_interval = 5000,    -- ms — shortest possible gap between shared events while eligible.
    max_interval = 15000,   -- ms — longest possible gap between shared events while eligible.
    off_chance   = 0.55,    -- 0..1 — odds the shared event is a full shutdown rather than a lesser dropout/cone flip.
    dropout_min  = 4000,    -- ms — NVD-only: shortest auto-recovery time for the "lesser effect" mode dropout. Unused by torch (its lesser effect is an instant cone flip, not duration-based).
    dropout_max  = 12000,    -- ms — longest auto-recovery time for the NVD dropout.
}

-- Deterministic attenuation for the quest-upgraded/powerful flashlight.
-- This reduces flicker intensity and may keep it below shared malfunction eligibility.
POWERFUL_TORCH_EMP_RESISTANCE = 0.20

-- CRITICAL_MALFUNCTION — rare, severe "your electronics just died" event shared by
-- PDA and torch (see sivol_critical_malfunction.script). Triggers only very close to
-- a strong electra or electric poltergeist. Both devices are forced into a hard
-- blackout/off simultaneously, then recover on their own — no manual toggle needed.
CRITICAL_MALFUNCTION = {
    trigger_threshold = 0.85,    -- 0..1 — exposure (electra_eff) must exceed this before any roll happens. Keep >= BLACKOUT_START so the screen is already visibly blacking out before an outage can start — an outage shouldn't be the FIRST sign something's wrong.
    roll_interval_min = 15000,   -- ms — shortest gap between eligibility rolls while exposed.
    roll_interval_max = 17500,   -- ms — longest gap between eligibility rolls.
    chance            = 0.95,     -- 0..1 — odds an eligible roll actually triggers, BEFORE shielding. Final chance = chance * (1 - shield), so a fully-shielded player never triggers this regardless of this value.
    -- separate duration ranges per trigger source — a poltergeist can knock
    -- devices out longer than a garden-variety strong electra
    electra     = { duration_min = 15000,  duration_max = 25000 },
    poltergeist = { duration_min = 17500,  duration_max = 35000 },
	shock_hit = { duration_min = 12500, duration_max = 17500 },  -- scaled by severity, see trigger_from_hit
}

-- One outage remains a shared causal event, but devices receive it at slightly
-- different times and recover separately instead of switching in lockstep.
CRITICAL_DEVICE_STAGGER = {
    pda   = { onset_min = 0,   onset_max = 180, recovery_min = 0,   recovery_max = 700 },
    nvd   = { onset_min = 120, onset_max = 480, recovery_min = 350, recovery_max = 1400 },
    torch = { onset_min = 280, onset_max = 800, recovery_min = 750, recovery_max = 2200 },
}

SHOCK_HIT_MALFUNCTION = {
    min_power    = 0.1,   -- non-Electra hit.power below this never rolls; static Electra contact is deterministic
    max_power    = 0.8,    -- hit.power at/above this = max severity
    electra_hit_severity_floor = 0.35, -- direct static-Electra contact always blackouts; this is its minimum duration severity
    chance_min   = 0.95,   -- chance ANYTHING happens, at a hit that just clears min_power
    chance_max   = 1.0,    -- chance ANYTHING happens, at max_power or above
    min_cooldown = 1000,  -- ms between hit-triggered rolls

    -- of a triggered event, odds it escalates to a full blackout vs. staying
    -- a lesser continuous glitch — also scales with severity, so a glancing
    -- shock is more likely to just glitch, a brutal one more likely to kill
    -- the devices outright
    blackout_share_min = 0.15,
    blackout_share_max = 0.6,

    -- the lesser outcome: elevated glitch/noise for a few seconds, not a
    -- hard outage — magnitude and duration both scale with severity
    glitch_duration_min  = 2000,
    glitch_duration_max  = 8000,
    glitch_intensity_min = 0.45,
    glitch_intensity_max = 0.9,
}
