-- [HE-PORT] Attachment-aware ADS transition timing.
--
-- Only the live CWeapon zoom_rotate_time property is changed. Its authored
-- value is cached per item and restored on addon changes, item switches,
-- save/load boundaries, shutdown and any write failure.

sivol_weapon_aim_speed = sivol_weapon_aim_speed or {}

local M = sivol_weapon_aim_speed

local ENABLED = true
local DIAGNOSTICS = false 
local WRITE_EPSILON = 0.0001

-- Naked ADS time is owned by weapon role. Optics scale that physical baseline
-- instead of replacing it with an absolute value, so a PKM cannot become
-- quicker to shoulder than a pistol merely by fitting a red dot.
local CLASS_AIM_TIMES = {
    pistol = 0.18,
    smg = 0.22,
    rifle = 0.25,
    automatic_rifle = 0.25,
    shotgun = 0.28,
    sniper = 0.32,
    bolt_action = 0.32,
    lmg = 0.35,
    special = 0.40,
}
local SCOPE_TIME_MULTIPLIERS = {
    red_dot = 0.86,
    low_mag = 1.45,
    lpvo = 1.75,
    medium_mag = 2.10,
    high_mag = 2.5,
}
local BASELINE_AIM_TIME = 0.25
-- Per-section naked ADS time; replaces the class value for that weapon.
local SECTION_AIM_TIMES = {
    wpn_aks47_he = 0.235,
}
local LAUNCHER_AIM_PENALTY = 0.05
-- Handling shifts ADS time inside its class: h 1 -> x0.88, h 0.55 -> x0.99,
-- h 0 -> x1.12 (docs/GUNPLAY_FEEL_DESIGN.md 5). Optics and launchers keep their
-- own multipliers; their mass also lowers handling slightly.
local HANDLING_AIM_TIME_BASE = 1.12
local HANDLING_AIM_TIME_SLOPE = 0.24

-- These weapons present a built-in sight in their HUD model despite declaring
-- scope_status = 0. Section IDs are technical and may not name the actual gun.
local INTEGRATED_OPTIC_OVERRIDES = {
    wpn_beretta93 = { scope = "integrated_collimator", class = "red_dot", zoom = 75 },
}

-- Weapon handling (docs/GUNPLAY_FEEL_DESIGN.md 5): one 0..1 value per item from
-- live mass (addons included), role and a few layout exceptions. It drives the
-- engine HUD springs and inertia fields below (nlc-3.589.131+); fields an older
-- engine lacks are skipped. Authored values are cached and restored with
-- zoom_rotate_time.
local HANDLING_REFERENCE_KG = 4.2
local HANDLING_EXPONENT = 1.4
local HANDLING_CLASS_K = {
    pistol = 0.80, smg = 0.95, rifle = 1.00, automatic_rifle = 1.00,
    shotgun = 1.05, sniper = 1.15, bolt_action = 1.15, lmg = 1.15, special = 1.20,
}
-- Bullpups and short or folded weapons carry their mass closer to the body.
local HANDLING_SECTION_K = {
    wpn_fn2000 = 0.85, wpn_groza = 0.85, wpn_groza_nimble = 0.85,
    wpn_ak74u = 0.90, wpn_aks47 = 0.92, wpn_val = 0.92, wpn_val_nimble = 0.92,
    wpn_pkm = 1.10, wpn_pkp = 1.10,
}
-- field = function(h, ctx) where h = 1 is nimble and 0 is unwieldy; ctx has
-- weapon_class and muzzle_kg (suppressor + under-barrel launcher mass).
local HANDLING_FIELDS = {
    -- x0.85 after the 2026-10-22 test: returns 15% slower (landing peak unchanged).
    { "hud_motion_freq", function(h) return (6.0 + 10.0 * h) * 0.85 end },
    { "hud_landing_k", function(h) return 0.85 + 0.45 * (1 - h) end },
    -- muzzle attachments add lag beyond their share of the total mass
    { "hud_rot_inertia_k", function(h, ctx) return (0.010 + 0.016 * (1 - h)) * (1 + 0.30 * ctx.muzzle_kg) end },
    -- lag pivot: near the shoulder for long guns (stock stays planted), at the
    -- gun itself for pistols held at arm's length (metres ahead of the eye)
    { "hud_rot_inertia_pivot_z", function(h, ctx)
        return ctx.weapon_class == "pistol" and 0.35 or (0.16 + 0.06 * (1 - h)) end },
    { "hud_rot_inertia_shift", function(h) return 0.12 + 0.08 * (1 - h) end },
    { "hud_clip_speed_k", function(h) return 0.90 + 0.20 * h end },
    { "hud_ads_damping", function(h) return 0.80 - 0.10 * (1 - h) end },
    { "hud_rot_inertia_freq", function(h) return 8.0 + 7.0 * h end },
    { "hud_move_inertia_k", function(h) return 0.006 + 0.010 * (1 - h) end },
    { "hud_move_inertia_freq", function(h) return 7.0 + 5.0 * h end },
    -- crouch kick and look-up dip (engine, nlc-3.589.132+); same spread as the
    -- old per-class .anm powers (pistol 0.70/0.60 .. machine gun 1.35/1.20).
    { "hud_crouch_kick_k", function(h) return 0.70 + 0.70 * (1 - h) end },
    { "hud_lookup_k", function(h) return 0.60 + 0.65 * (1 - h) end },
    -- native translation inertia (engine halves both): hip lags more on heavy
    -- weapons, ADS follows back to centre faster than the old fixed 10.
    { "hud_inertion_tendto_speed", function(h) return 3.0 + 4.0 * h end },
    { "hud_inertion_origin_offset", function(h) return 0.030 + 0.025 * (1 - h) end },
    { "hud_inertion_tendto_speed_aim", function(h) return 8.0 + 16.0 * h end },
    { "hud_inertion_origin_offset_aim", function(h) return 0.020 * (0.8 + 0.4 * (1 - h)) end },
}

local state = {
    item = nil,
    item_id = nil,
    weapon = nil,
    section = nil,
    signature = nil,
    original = nil,
    applied = false,
    disabled = false,
    handling_original = nil,
}

M.enabled = ENABLED
M.active_scope = nil
M.active_class = "naked"
M.original_time = nil
M.applied_time = nil
M.last_error = nil

local function aim_log(fmt, ...)
    if DIAGNOSTICS then log2(fmt, ...) end
end

local function valid_number(value)
    local n = tonumber(value)
    return n ~= nil and n == n and n > 0.01 and n < 10
end

local function object_id(object)
    if not object then return nil end
    local ok, id = pcall(object.id, object)
    return ok and id or nil
end

local function read_zoom_time(weapon)
    local ok, value = pcall(function() return weapon.zoom_rotate_time end)
    if not ok or not valid_number(value) then return nil end
    return tonumber(value)
end

local function write_zoom_time(weapon, value)
    local ok = pcall(function() weapon.zoom_rotate_time = value end)
    if not ok then return false end
    local actual = read_zoom_time(weapon)
    return actual and math.abs(actual - value) <= WRITE_EPSILON or false
end

local function clear_public_state()
    M.active_scope = nil
    M.active_class = "naked"
    M.original_time = nil
    M.applied_time = nil
end

local function restore_handling()
    if not state.handling_original or not state.weapon then
        state.handling_original = nil
        return
    end
    for field, value in pairs(state.handling_original) do
        pcall(function() state.weapon[field] = value end)
    end
    state.handling_original = nil
end

local function restore_current(reason)
    restore_handling()
    if not state.applied then return true end
    local ok = state.weapon and state.original
        and write_zoom_time(state.weapon, state.original)
    if not ok then
        M.last_error = "restoration failed: " .. tostring(reason or "unknown")
        aim_log("[sivol_aim_speed][restore_failure] section=%s item_id=%s original=%.4f reason=%s",
            tostring(state.section), tostring(state.item_id), tonumber(state.original) or -1,
            tostring(reason or "unknown"))
        return false
    end
    aim_log("[sivol_aim_speed][restore] section=%s item_id=%s value=%.4f reason=%s",
        tostring(state.section), tostring(state.item_id), state.original,
        tostring(reason or "unknown"))
    state.applied = false
    return true
end

local function reset_current(reason)
    local ok = restore_current(reason)
    state.item = nil
    state.item_id = nil
    state.weapon = nil
    state.section = nil
    state.signature = nil
    state.original = nil
    clear_public_state()
    return ok
end

local function read_addon_flags(item)
    local ok, flags = pcall(item.get_addon_flags, item)
    return ok and tonumber(flags) or 0
end

local function section_string(section, field)
    if not sys_ini or not section then return nil end
    local ok_exists, exists = pcall(sys_ini.line_exist, sys_ini, section, field)
    if not ok_exists or not exists then return nil end
    local ok_value, value = pcall(sys_ini.r_string, sys_ini, section, field)
    return ok_value and value or nil
end

local function read_weapon_string(weapon, field)
    if not weapon then return nil end
    local ok, value = pcall(function() return weapon[field] end)
    if not ok or type(value) ~= "string" or value == "" then return nil end
    return value
end

local function resolve_scope(item, weapon, section, flags)
    -- Respawn variants have the sight baked into their section and may carry
    -- zero live addon flags.
    local respawn = section_string(section, "scope_respawn")
    local scope = section_string(section, "scope_name")
    if respawn and scope then return scope, "baked" end

    local status = 0
    if ogse_wpn_utils and type(ogse_wpn_utils.get_scope_status) == "function" then
        local ok, value = pcall(ogse_wpn_utils.get_scope_status, item)
        if ok then status = tonumber(value) or 0 end
    end
    if status == 1 then
        local runtime_scope = read_weapon_string(weapon, "scope_name")
        -- Some integral sights (for example the scoped TOZ-34) have no
        -- separate scope_name at all. The weapon section still owns the FOV.
        return runtime_scope or scope or section, "integral"
    end
    if status == 2 and bit_and(flags, 1) ~= 0 then
        local runtime_scope = read_weapon_string(weapon, "scope_name")
        return runtime_scope or scope, "attached"
    end
    return nil, "naked"
end

local function read_scope_zoom(scope)
    if not sys_ini or not scope then return nil end
    local ok_exists, exists = pcall(sys_ini.line_exist, sys_ini, scope, "scope_zoom_factor")
    if not ok_exists or not exists then return nil end
    local ok_value, value = pcall(sys_ini.r_float, sys_ini, scope, "scope_zoom_factor")
    return ok_value and tonumber(value) or nil
end

local function classify_scope(scope, mode, weapon_section)
    -- Match sivol_weapon_zoom.get_controller_magnification(): integral sights
    -- own their authored FOV on the weapon section. Their runtime scope_name
    -- can be only a render preset (SV-98 and AWM both report "specter").
    local zoom_section = mode == "integral" and weapon_section or scope
    local zoom = read_scope_zoom(zoom_section)
    if not zoom then return nil, nil end
    if mode ~= "integral" and scope == "specter" then return "lpvo", zoom end
    if zoom >= 60 then return "red_dot", zoom end
    if zoom >= 30 then return "low_mag", zoom end
    if zoom >= 15 then return "medium_mag", zoom end
    return "high_mag", zoom
end

-- Standalone scope tooltips use the same classification and targets as the
-- runtime controller. Positive speed_percent means faster than naked baseline.
function sivol_weapon_aim_speed.get_scope_aim_profile(scope_section)
    local sight_class, zoom = classify_scope(scope_section, "attached", nil)
    local multiplier = sight_class and SCOPE_TIME_MULTIPLIERS[sight_class]
    local target = multiplier and BASELINE_AIM_TIME * multiplier
    if not target or target <= 0 then return nil end
    return {
        class = sight_class,
        zoom = zoom,
        target = target,
        baseline = BASELINE_AIM_TIME,
        speed_percent = (BASELINE_AIM_TIME / target - 1.0) * 100,
    }
end

local function has_launcher(item, section, flags)
    if section_string(section, "grenade_launcher_respawn") then return true end
    if bit_and(flags, 2) ~= 0 then return true end
    if ogse_wpn_utils and type(ogse_wpn_utils.get_grenade_launcher_status) == "function" then
        local ok, status = pcall(ogse_wpn_utils.get_grenade_launcher_status, item)
        return ok and tonumber(status) == 1 or false
    end
    return false
end

local function get_weapon_class(section)
    if sivol_weapon and type(sivol_weapon.get_weapon_class) == "function" then
        local ok, class_name = pcall(sivol_weapon.get_weapon_class, section)
        if ok and CLASS_AIM_TIMES[class_name] then return class_name end
    end
    if sivol_fuzz_recoil_profiles
        and type(sivol_fuzz_recoil_profiles.get_class) == "function" then
        local ok, class_name = pcall(
            sivol_fuzz_recoil_profiles.get_class, section)
        if ok and CLASS_AIM_TIMES[class_name] then return class_name end
    end
    return "automatic_rifle"
end

local function build_weapon_aim_profile(item, weapon, section, flags)
    local weapon_class = get_weapon_class(section)
    local base_target = SECTION_AIM_TIMES[section] or CLASS_AIM_TIMES[weapon_class]
        or CLASS_AIM_TIMES.automatic_rifle
    local optic_override = INTEGRATED_OPTIC_OVERRIDES[section]
    local scope, mode
    if optic_override then
        scope, mode = optic_override.scope, "integrated_override"
    else
        scope, mode = resolve_scope(item, weapon, section, flags)
    end

    local sight_class, zoom
    if scope then
        if optic_override then
            sight_class, zoom = optic_override.class, optic_override.zoom
        else
            sight_class, zoom = classify_scope(scope, mode, section)
        end
    end
    local scope_multiplier = sight_class
        and SCOPE_TIME_MULTIPLIERS[sight_class] or 1.0
    local launcher = has_launcher(item, section, flags)
    local handling_k = 1.0
    local handling = M.get_handling_profile and M.get_handling_profile(item, section)
    if handling then
        handling_k = HANDLING_AIM_TIME_BASE - HANDLING_AIM_TIME_SLOPE * handling.handling
    end
    local target = base_target * handling_k * scope_multiplier
        + (launcher and LAUNCHER_AIM_PENALTY or 0)
    return {
        weapon_class = weapon_class,
        scope = scope,
        mode = mode,
        class = sight_class or "naked",
        zoom = zoom,
        magnification = zoom and 90 / zoom or nil,
        base_target = base_target,
        scope_multiplier = scope_multiplier,
        launcher = launcher,
        handling_k = handling_k,
        target = target,
        baseline = BASELINE_AIM_TIME,
        speed_percent = (BASELINE_AIM_TIME / target - 1.0) * 100,
    }
end

-- Shared runtime/UI effective ADS timing, including naked weapons and UBGLs.
function M.get_weapon_aim_profile(item, weapon, section)
    if not item or not weapon or not section then return nil end
    return build_weapon_aim_profile(
        item, weapon, section, read_addon_flags(item))
end

-- Inventory UI uses the exact same scope resolution and timing classes as the
-- runtime controller. This reports the effective optic without mutating it.
function M.get_weapon_scope_profile(item, weapon, section)
    local profile = M.get_weapon_aim_profile(item, weapon, section)
    if not profile or not profile.scope or not profile.zoom then return nil end
    return profile
end

local function resolve_handling_base(section)
    if HANDLING_SECTION_K[section] then return section end
    for _, key in ipairs({ "scope_respawn", "silencer_respawn", "grenade_launcher_respawn" }) do
        local base = section_string(section, key)
        if base and HANDLING_SECTION_K[base] then return base end
    end
    return section
end

-- Shared by the runtime writer and the inventory "Handling" index.
-- without_addons = true describes the bare weapon (the UI base value).
function M.get_handling_profile(item, section, without_addons)
    if not item then return nil end
    section = section or item:section()
    local mass = 3.0
    if sivol_weapon and type(sivol_weapon.get_weapon_mass_stats) == "function" then
        local ok, stats = pcall(sivol_weapon.get_weapon_mass_stats, item, section)
        if ok and type(stats) == "table" and tonumber(stats.mass) and tonumber(stats.mass) > 0 then
            mass = tonumber(stats.mass)
            if without_addons then
                mass = math.max(0.1, mass - (tonumber(stats.addon_mass) or 0))
            end
        end
    end
    local weapon_class = get_weapon_class(section)
    local effective = mass * (HANDLING_CLASS_K[weapon_class] or 1.0)
        * (HANDLING_SECTION_K[resolve_handling_base(section)] or 1.0)
    local h = 1.0 / (1.0 + math.pow(math.max(effective, 0.1) / HANDLING_REFERENCE_KG, HANDLING_EXPONENT))
    return {
        handling = h,
        score = math.max(1, math.min(99, math.floor(h * 100 + 0.5))),
        mass = mass,
        effective_mass = effective,
        weapon_class = weapon_class,
    }
end

-- Mass of fitted suppressor and grenade-launcher addons (kg).
local function muzzle_addon_mass(item, section)
    if not sivol_weapon or type(sivol_weapon.get_weapon_mass_stats) ~= "function" then return 0 end
    local ok, stats = pcall(sivol_weapon.get_weapon_mass_stats, item, section)
    if not ok or type(stats) ~= "table" or type(stats.addon_sections) ~= "string" then return 0 end
    local kg = 0
    for addon in string.gmatch(stats.addon_sections, "[^,]+") do
        local class_name = section_string(addon, "class") or ""
        if string.find(class_name, "SILENC", 1, true) or string.find(class_name, "GLAUNC", 1, true) then
            local ok_w, w = pcall(sys_ini.r_float, sys_ini, addon, "inv_weight")
            kg = kg + (ok_w and tonumber(w) or 0)
        end
    end
    return kg
end

local function apply_handling(item, weapon, section)
    local profile = M.get_handling_profile(item, section)
    if not profile then return end
    local ctx = { weapon_class = profile.weapon_class, muzzle_kg = muzzle_addon_mass(item, section) }
    local original = {}
    for _, entry in ipairs(HANDLING_FIELDS) do
        local field, value_of = entry[1], entry[2]
        local ok_read, current = pcall(function() return weapon[field] end)
        if ok_read and type(current) == "number" then
            local value = value_of(profile.handling, ctx)
            if pcall(function() weapon[field] = value end) then
                original[field] = current
            end
        end
    end
    state.handling_original = original
    M.handling = profile.handling
    aim_log("[sivol_aim_speed][handling] section=%s mass=%.2f effective=%.2f handling=%.3f muzzle_kg=%.2f",
        tostring(section), profile.mass, profile.effective_mass, profile.handling, ctx.muzzle_kg)
end

local function make_signature(item, section, flags, scope, mode)
    return table.concat({ tostring(object_id(item)), tostring(section), tostring(flags),
        tostring(scope), tostring(mode) }, ":")
end

local function prepare(item, item_id)
    local ok_weapon, weapon = pcall(item.get_weapon, item)
    if not ok_weapon or not weapon then
        return not state.item_id or reset_current("non-firearm item")
    end
    local ok_section, section = pcall(item.section, item)
    if not ok_section then
        return not state.item_id or reset_current("section unavailable")
    end
    local flags = read_addon_flags(item)
    local optic_override = INTEGRATED_OPTIC_OVERRIDES[section]
    local scope, mode
    if optic_override then
        scope, mode = optic_override.scope, "integrated_override"
    else
        scope, mode = resolve_scope(item, weapon, section, flags)
    end
    local signature = make_signature(item, section, flags, scope, mode)
    if state.item_id == item_id and state.signature == signature then return true end

    if not reset_current("state change") then return false end
    state.item = item
    state.item_id = item_id
    state.weapon = weapon
    state.section = section
    state.signature = signature

    apply_handling(item, weapon, section)

    local aim_profile = build_weapon_aim_profile(
        item, weapon, section, flags)
    local target = aim_profile.target

    local original = read_zoom_time(weapon)
    if not original then
        M.last_error = "zoom_rotate_time unavailable"
        aim_log("[sivol_aim_speed][skip] section=%s scope=%s mode=%s reason=property_unavailable",
            tostring(section), tostring(scope), tostring(mode))
        return true
    end
    -- Probe writability with a no-op before applying a gameplay change.
    if not write_zoom_time(weapon, original) then
        M.last_error = "zoom_rotate_time is not writable"
        aim_log("[sivol_aim_speed][skip] section=%s scope=%s mode=%s reason=property_not_writable",
            tostring(section), tostring(scope), tostring(mode))
        return true
    end

    state.original = original
    if not write_zoom_time(weapon, target) then
        write_zoom_time(weapon, original)
        M.last_error = "aim-speed application failed"
        return false
    end
    state.applied = true
    M.active_scope = scope
    M.active_class = aim_profile.class
    M.original_time = original
    M.applied_time = target
    aim_log("[sivol_aim_speed][apply] section=%s item_id=%s weapon_class=%s scope=%s mode=%s class=%s zoom=%s launcher=%s original=%.4f base=%.4f target=%.4f",
        tostring(section), tostring(item_id), tostring(aim_profile.weapon_class),
        tostring(scope), tostring(mode), tostring(aim_profile.class), tostring(aim_profile.zoom),
        tostring(aim_profile.launcher), original, aim_profile.base_target, target)
    return true
end

local function on_update()
    if state.disabled or not ENABLED then return end
    if not db or not db.actor then
        if state.item_id and not reset_current("actor unavailable") then state.disabled = true end
        return
    end
    local ok_item, item = pcall(db.actor.active_item, db.actor)
    if not ok_item then
        if state.item_id then reset_current("active item query failed") end
        state.disabled = true
        return
    end
    local item_id = object_id(item)
    if not item or not item_id then
        if state.item_id and not reset_current("no active item") then state.disabled = true end
        return
    end
    local ok, result = pcall(prepare, item, item_id)
    if not ok or not result then
        M.last_error = "update failed: " .. tostring(result)
        reset_current("update failure")
        state.disabled = true
    end
end

local function on_first_update()
    state.disabled = not reset_current("load/reset")
    if not state.disabled then M.last_error = nil end
end

local function on_before_save_game()
    if not reset_current("save") then state.disabled = true end
end

local function on_stop_modules()
    reset_current("shutdown")
    state.disabled = true
end

function attach(sm)
    sm:subscribe({ signal = "on_first_update", fun = on_first_update })
    sm:subscribe({ signal = "on_update", fun = on_update })
    sm:subscribe({ signal = "on_before_save_game", fun = on_before_save_game })
    sm:subscribe({ signal = "on_stop_modules", fun = on_stop_modules })
end

M.attach = attach
