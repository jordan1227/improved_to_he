local AMBIENT_PSY_THRESHOLD = 0.50
local AMBIENT_CHECK_MS = 15000
local AMBIENT_INITIAL_DELAY_MS = 60000
local AMBIENT_MAX_CHANCE = 0.30
local AMBIENT_COOLDOWN_MIN_MS = 60000
local AMBIENT_COOLDOWN_SPAN_MS = 90000
local AMBIENT_COOLDOWN_JITTER_MS = 30000
local MIN_SPAWN_DISTANCE = 12
local MAX_SPAWN_DISTANCE = 18
local MAX_ACTIVE = 4
local MAX_PER_SOURCE = 1
local OUTSIDE_FOV_DOT = 0.20
local AWARENESS_REFRESH_MS = 500
local INVENTORY_AUDIT_FAST_MS = 250
local INVENTORY_AUDIT_SLOW_MS = 1000
local INVENTORY_AUDIT_FAST_WINDOW_MS = 5000
local DISAPPEAR_PARTICLE = "monsters\\phantom_death"
local HAND_GRENADES = {
	grenade_f1 = true,
	grenade_rgd5 = true,
}

local enabled = true
local active = {}
local pending_release = {}
local pending_psy_hits = {}
local forcing_awareness_id = nil
local ambient_enabled = true
local ambient_diagnostics = false
local ambient_initialized = false
local ambient_next_check = 0
local ambient_next_spawn_time = 0
local ambient_last_skip_reason = nil
local ambient_force_next_spawn = false

local function log(fmt, ...)
	log2("[sivol_psy_phantoms] " .. fmt, ...)
end

local function get_mask_psy_k()
	if not (sivol and sivol.get_mask_psy_k) then return 1.0 end
	local ok, value = pcall(sivol.get_mask_psy_k)
	if not ok then return 1.0 end
	return math.max(0, math.min(1.5, tonumber(value) or 1.0))
end

local function entry_count(source_id)
	local total = 0
	local source_total = 0
	for _, entry in pairs(active) do
		total = total + 1
		if source_id and entry.source_id == source_id then
			source_total = source_total + 1
		end
	end
	return total, source_total
end

local function is_server_object_alive(obj)
	if not obj then return false end
	local ok, result = pcall(function() return obj:alive() end)
	return ok and result == true
end

local function is_outside_fov(pos)
	local dev = device()
	if not dev or not dev.cam_pos or not dev.cam_dir then return false end
	local to_pos = vector():sub(pos, dev.cam_pos)
	if to_pos:magnitude() < 0.01 then return false end
	to_pos:normalize()
	local cam_dir = vector():set(dev.cam_dir):normalize()
	return cam_dir:dotproduct(to_pos) <= OUTSIDE_FOV_DOT
end

local function find_offscreen_spawn(actor)
	if not actor then return nil end
	local dev = device()
	if not dev or not dev.cam_dir then return nil end

	local forward = vector():set(dev.cam_dir.x, 0, dev.cam_dir.z)
	if forward:magnitude() < 0.01 then
		forward = vector():set(actor:direction())
		forward.y = 0
	end
	forward:normalize()

	for _ = 1, 12 do
		-- Select only the rear 140-degree arc. The final dot-product check uses
		-- the rendered camera direction, so wide/zoomed FOV changes stay safe.
		local angle = math.rad(lua_random(110, 250))
		local c = math.cos(angle)
		local s = math.sin(angle)
		local dir = vector():set(
			forward.x * c + forward.z * s,
			0.0001,
			-forward.x * s + forward.z * c
		)
		local radius = lua_random(MIN_SPAWN_DISTANCE, MAX_SPAWN_DISTANCE)
		local lvid = level.vertex_in_direction(actor:level_vertex_id(), dir, radius)
		if lvid and lvid < NONE_SID then
			local pos = level.vertex_position(lvid)
			local distance = pos:distance_to(actor:position())
			if distance >= MIN_SPAWN_DISTANCE - 1 and is_outside_fov(pos) then
				return pos, lvid, actor:game_vertex_id()
			end
		end
	end
	return nil
end

local function play_disappear(pos)
	if pos then particles_object(DISAPPEAR_PARTICLE):play_at_pos(pos) end
end

local function release_id(id, reason)
	local entry = active[id]
	if not entry then return end
	local obj = level.object_by_id(id)
	local sobj = alife():object(id)
	local pos = obj and obj:position() or (sobj and sobj.position)
	local fx_pos = pos and vector():set(pos.x, pos.y + (entry.kind == "npc" and 0.5 or 0), pos.z)

	active[id] = nil
	pending_release[id] = nil
	pending_psy_hits[id] = nil
	for _, child_id in ipairs(entry.child_ids or {}) do
		local child = alife():object(child_id)
		if child then alife():release(child, true) end
	end
	if sobj then alife():release(sobj, true) end
	if reason == "hit" or reason == "hit_fallback" or reason == "timeout" or reason == "source_gone" then
		-- Human models can cover a particle started at their origin during the
		-- hit frame. Remove the phantom first and play the copied position above
		-- its pelvis so shot and timeout disappearances use the same visible path.
		play_disappear(fx_pos)
	end
	log("released id=%s reason=%s tracked_children=%d grenades_removed=%d collateral_blocked=%d",
		tostring(id), tostring(reason), #(entry.child_ids or {}), entry.grenades_removed or 0,
		entry.collateral_hits_blocked or 0)
end

local function queue_release(id, reason)
	if active[id] and not pending_release[id] then
		pending_release[id] = reason or "hit"
	end
end

local function track_child(entry, child_id)
	if not entry or not child_id then return false end
	entry.child_id_set = entry.child_id_set or {}
	if entry.child_id_set[child_id] then return false end
	entry.child_id_set[child_id] = true
	table.insert(entry.child_ids, child_id)
	return true
end

local function audit_stalker_inventory(obj, entry, now, initial)
	if not obj or not entry or entry.kind ~= "npc" then return end
	local newly_tracked = 0
	local grenade_ids = {}
	local seen_grenades = {}
	local active_section = "nil"
	local profile_item_ids = {}
	local profile_item_set = {}
	local found_profile_weapon = false

	local function inspect_item(item)
		if not item then return end
		if track_child(entry, item:id()) then newly_tracked = newly_tracked + 1 end
		local section = item:section()
		if entry.loadout and not entry.loadout_applied then
			local replace = false
			pcall(function()
				if item:is_ammo() then replace = true end
				if item:is_weapon() and not item:is_knife() and not item:is_binoculars() then
					replace = true
					found_profile_weapon = true
				end
			end)
			if replace and not profile_item_set[item:id()] then
				profile_item_set[item:id()] = true
				table.insert(profile_item_ids, item:id())
			end
		end
		if HAND_GRENADES[section] and not seen_grenades[item:id()] then
			seen_grenades[item:id()] = true
			table.insert(grenade_ids, item:id())
		end
	end

	pcall(function()
		obj:iterate_inventory(function(_, item) inspect_item(item) end)
	end)
	pcall(function()
		local item = obj:active_item()
		if item then
			active_section = item:section()
			inspect_item(item)
		end
	end)

	if entry.loadout and not entry.loadout_applied and found_profile_weapon then
		local parent = alife():object(obj:id())
		local created = 0
		if parent then
			local sections = { entry.loadout.weapon }
			for _ = 1, entry.loadout.ammo_boxes or 0 do
				table.insert(sections, entry.loadout.ammo)
			end
			for _, section in ipairs(sections) do
				local child = alife():create(section, parent.position,
					parent.m_level_vertex_id, parent.m_game_vertex_id, parent.id)
				if child then
					if track_child(entry, child.id) then newly_tracked = newly_tracked + 1 end
					created = created + 1
				end
			end
		end
		if created > 0 then
			for _, item_id in ipairs(profile_item_ids) do
				local item = alife():object(item_id)
				if item then alife():release(item, true) end
			end
			entry.loadout_applied = true
			entry.profile_items_removed = #profile_item_ids
		end
		log("loadout apply id=%s success=%s visual=%s weapon=%s ammo=%s boxes=%d removed_profile_items=%d created=%d",
			tostring(obj:id()), tostring(created > 0), tostring(obj:get_visual_name()), entry.loadout.weapon,
			entry.loadout.ammo, entry.loadout.ammo_boxes or 0,
			created > 0 and #profile_item_ids or 0, created)
	end

	local removed = 0
	for _, grenade_id in ipairs(grenade_ids) do
		local grenade = alife():object(grenade_id)
		if grenade then
			alife():release(grenade, true)
			removed = removed + 1
		end
	end
	entry.grenades_removed = (entry.grenades_removed or 0) + removed
	entry.inventory_audit_count = (entry.inventory_audit_count or 0) + 1
	local elapsed = now - entry.spawn_time
	entry.next_inventory_audit = now + (elapsed < INVENTORY_AUDIT_FAST_WINDOW_MS
		and INVENTORY_AUDIT_FAST_MS or INVENTORY_AUDIT_SLOW_MS)

	if initial or newly_tracked > 0 or removed > 0 then
		log("inventory audit id=%s pass=%d elapsed_ms=%d newly_tracked=%d total_tracked=%d grenades_removed=%d active_item=%s",
			tostring(obj:id()), entry.inventory_audit_count, elapsed, newly_tracked,
			#entry.child_ids, removed, active_section)
	end
end

local function configure_client(obj, entry)
	if not obj or not entry or entry.configured then return end
	pcall(function() obj:get_custom_monster().visible_for_zones = false end)
	if entry.kind == "npc" and entry.variant then
		pcall(function() obj:set_character_community(entry.variant.community, 0, 0) end)
		pcall(function() obj:set_character_rank(entry.variant.rank) end)
		audit_stalker_inventory(obj, entry, time_global(), true)
		log("configured npc id=%s visual=%s community=%s rank=%s tracked_children=%d profile_pool=%s",
			tostring(obj:id()), tostring(obj:get_visual_name()), tostring(obj:character_community()),
			tostring(obj:character_rank()), #entry.child_ids, tostring(entry.variant.profile_pool))
	end
	entry.configured = true
end

local function force_actor_awareness(obj, entry, now)
	local actor = db.actor
	if not obj or not entry or not actor or not actor:alive() then return end
	if (entry.next_awareness_time or 0) > now then return end
	entry.next_awareness_time = now + AWARENESS_REFRESH_MS

	obj:set_relation(game_object.enemy, actor)
	obj:set_custom_panic_threshold(0)
	obj:enable_memory_object(actor, true)
	if entry.kind == "npc" then
		local enemy = obj:best_enemy()
		if not enemy or enemy:id() ~= actor:id() then
			-- Direct the human sight manager at the known hostile until the engine
			-- promotes the actor to best_enemy. Stop forcing sight afterwards so
			-- ordinary combat aiming remains engine-owned.
			pcall(function() obj:set_sight(actor, true, true) end)
		elseif not entry.awareness_acquired then
			entry.awareness_acquired = true
			log("npc awareness acquired id=%s delay_ms=%d", tostring(obj:id()), now - entry.spawn_time)
		end
	end

	if entry.kind == "monster" then
		local enemy = obj:best_enemy()
		if enemy and enemy:id() == actor:id() then
			if not entry.awareness_acquired then
				entry.awareness_acquired = true
				log("mutant awareness acquired id=%s delay_ms=%d", tostring(obj:id()), now - entry.spawn_time)
			end
			return
		end
		-- Mutants need the same zero-power alert trigger used by
		-- dsh_monster_attack. Stalkers must not receive it: human AI treats even
		-- a zero-power hit as a stagger animation and becomes permanently locked.
		local h = hit()
		h.draftsman = actor
		h.direction = vector():sub(obj:position(), actor:position()):normalize()
		h.type = hit.fire_wound
		h.impulse = 0
		h.power = 0
		forcing_awareness_id = obj:id()
		obj:hit(h)
		forcing_awareness_id = nil
	end

end

local function release_all(reason)
	local ids = {}
	for id in pairs(active) do table.insert(ids, id) end
	for _, id in ipairs(ids) do release_id(id, reason) end
end

local function spawn_phantom(section, kind, source_id, reason, lifetime_ms, variant, source_limit)
	if not enabled or not db.actor or not db.actor:alive() then return nil end
	local total, source_total = entry_count(source_id)
	local effective_source_limit = source_limit or MAX_PER_SOURCE
	if total >= MAX_ACTIVE
		or (source_id and source_total >= effective_source_limit) then return nil end

	local pos, lvid, gvid = find_offscreen_spawn(db.actor)
	if not pos then
		log("spawn rejected: no off-screen navigation vertex")
		return nil
	end
	local sobj = alife():create(section, pos, lvid, gvid)
	if not sobj then return nil end
	pcall(function() sobj:can_switch_offline(false) end)

	active[sobj.id] = {
		section = section,
		kind = kind,
		variant = variant,
		source_id = source_id,
		spawn_time = time_global(),
		lifetime_ms = lifetime_ms,
		configured = false,
		next_awareness_time = 0,
		child_ids = {},
		child_id_set = {},
		inventory_audit_count = 0,
		next_inventory_audit = 0,
		grenades_removed = 0,
		collateral_hits_blocked = 0,
		loadout = nil,
		loadout_applied = false,
		profile_items_removed = 0,
	}
	log("spawned id=%s reason=%s source=%s distance=%.1f outside_fov=true",
		tostring(sobj.id), tostring(reason), tostring(source_id), pos:distance_to(db.actor:position()))
	return sobj.id
end

local function spawn_single_mutant(source_id, reason, key, source_limit)
	local variant = MUTANT_VARIANTS[key]
	local id = spawn_phantom(variant.section, "monster", source_id, reason,
		variant.lifetime_ms, variant, source_limit)
	if id then
		log("spawned mutant id=%s variant=%s section=%s lifetime_ms=%d psy_power=%.3f",
			tostring(id), key, variant.section, variant.lifetime_ms, variant.psy_hit_power)
	end
	return id
end

local function spawn_mutant(source_id, reason, variant_key, source_limit)
	local key = variant_key and MUTANT_VARIANTS[variant_key] and variant_key
		or MUTANT_VARIANT_KEYS[lua_random(1, #MUTANT_VARIANT_KEYS)]
	if key ~= "tushkano" then return spawn_single_mutant(source_id, reason, key, source_limit) end

	local requested = lua_random(2, 4)
	local ids = {}
	for index = 1, requested do
		local id = spawn_single_mutant(source_id, reason .. "_group_" .. index, key, requested)
		if not id then break end
		table.insert(ids, id)
	end
	log("spawned mutant group variant=tushkano requested=%d spawned=%d ids=%s",
		requested, #ids, table.concat(ids, ","))
	return ids[1]
end

local function spawn_stalker(source_id, reason, variant_key, source_limit)
	local key = variant_key and STALKER_VARIANTS[variant_key] and variant_key
		or STALKER_VARIANT_KEYS[lua_random(1, #STALKER_VARIANT_KEYS)]
	local variant = STALKER_VARIANTS[key]
	local id = spawn_phantom(variant.section, "npc", source_id, reason,
		variant.lifetime_ms, variant, source_limit)
	if id then
		local entry = active[id]
		entry.loadout = variant.loadouts[lua_random(1, #variant.loadouts)]
		log("spawned stalker id=%s variant=%s section=%s profile_pool=%s loadout=%s lifetime_ms=%d",
			tostring(id), key, variant.section, tostring(variant.profile_pool),
			entry.loadout.weapon, variant.lifetime_ms)
	end
	return id
end

local function spawn_controller_choice(controller, strong)
	local source_id = controller and controller:id() or nil
	local roster = strong and CONTROLLER_VARIANTS_STRONG or CONTROLLER_VARIANTS_NORMAL
	local source_limit = strong and 2 or 1
	local roll = lua_random(1, 100)
	local cumulative = 0
	for _, choice in ipairs(roster) do
		cumulative = cumulative + choice.weight
		if roll <= cumulative then
			local id
			if choice.kind == "npc" then
				id = spawn_stalker(source_id, "controller", choice.key, source_limit)
			else
				id = spawn_mutant(source_id, "controller", choice.key, source_limit)
			end
			log("controller roster tier=%s roll=%d kind=%s variant=%s spawned=%s source=%s source_limit=%d",
				strong and "strong" or "normal", roll, choice.kind, choice.key,
				tostring(id ~= nil), tostring(source_id), source_limit)
			return id, choice.kind .. "_" .. choice.key
		end
	end
	return nil, "invalid_roll"
end

function spawn_controller_phantom(controller, strong)
	return spawn_controller_choice(controller, strong == true)
end

