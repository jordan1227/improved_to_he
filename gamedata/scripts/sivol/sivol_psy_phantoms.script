local function choose_weighted_variant(roster)
	local roll = lua_random(1, 100)
	local cumulative = 0
	for _, choice in ipairs(roster) do
		cumulative = cumulative + choice.weight
		if roll <= cumulative then return choice, roll end
	end
	return roster[#roster], roll
end

local function ambient_safe_reason(actor)
	if not ambient_enabled then return "disabled" end
	if not actor or not actor:alive() then return "actor_unavailable" end
	if actor.psy_health >= AMBIENT_PSY_THRESHOLD then return "psy_above_threshold" end
	if entry_count(nil) > 0 then return "real_phantom_active" end
	if phantom_manager and phantom_manager.phantom_count
		and phantom_manager.phantom_count() > 0 then return "classic_phantom_active" end
	if actor:is_talking() then return "dialogue" end
	if level.main_input_receiver() then return "menu_or_ui" end
	if sleep_manager and sleep_manager.sleeping then return "sleeping" end

	local ok_enemy, enemy = pcall(function() return actor:best_enemy() end)
	if ok_enemy and enemy then return "combat" end

	if ogse_campfire and ogse_campfire.check_near_en_flame then
		local ok_fire, near_fire = pcall(ogse_campfire.check_near_en_flame)
		if ok_fire and near_fire then return "campfire" end
	end
	return nil
end

local function ambient_roster(psy_health)
	if psy_health >= 0.35 then return AMBIENT_VARIANTS_MILD, "mild" end
	if psy_health >= 0.20 then return AMBIENT_VARIANTS_MID, "mid" end
	return AMBIENT_VARIANTS_SEVERE, "severe"
end

local function ambient_update(now)
	if not ambient_initialized then
		ambient_initialized = true
		ambient_next_check = now + AMBIENT_INITIAL_DELAY_MS
		ambient_next_spawn_time = ambient_next_check
		log("ambient initialized delay_ms=%d threshold=%.2f", AMBIENT_INITIAL_DELAY_MS,
			AMBIENT_PSY_THRESHOLD)
		return
	end
	if now < ambient_next_check then return end
	ambient_next_check = now + AMBIENT_CHECK_MS
	if now < ambient_next_spawn_time then return end

	local actor = db.actor
	local reason = ambient_safe_reason(actor)
	if reason then
		if ambient_diagnostics and reason ~= ambient_last_skip_reason then
			log("ambient skipped reason=%s", reason)
		end
		ambient_last_skip_reason = reason
		return
	end
	ambient_last_skip_reason = nil

	local psy_health = math.max(0, math.min(1, tonumber(actor.psy_health) or 1))
	local severity = math.max(0, math.min(1,
		(AMBIENT_PSY_THRESHOLD - psy_health) / AMBIENT_PSY_THRESHOLD))
	local mask_k = get_mask_psy_k()
	-- Halve the mask's protection for spawn frequency: psy_k 0.7 becomes 0.85,
	-- exactly 15% fewer attempts rather than 30% fewer.
	local frequency_mult = math.max(0.5, math.min(1.25, 0.5 + 0.5 * mask_k))
	local chance = AMBIENT_MAX_CHANCE * severity * frequency_mult
	local forced = ambient_force_next_spawn
	ambient_force_next_spawn = false
	local chance_roll = lua_random()
	if not forced and chance_roll >= chance then
		if ambient_diagnostics then
			log("ambient attempt result=miss psy=%.3f severity=%.3f mask_k=%.3f frequency_mult=%.3f chance=%.3f roll=%.3f",
				psy_health, severity, mask_k, frequency_mult, chance, chance_roll)
		end
		return
	end

	local roster, tier = ambient_roster(psy_health)
	local choice, roster_roll = choose_weighted_variant(roster)
	local id
	if choice.kind == "npc" then
		id = spawn_stalker(nil, "ambient_low_psy", choice.key)
	else
		id = spawn_mutant(nil, "ambient_low_psy", choice.key)
	end
	if id then
		local cooldown = math.floor(AMBIENT_COOLDOWN_MIN_MS
			+ AMBIENT_COOLDOWN_SPAN_MS * (1 - severity)
			+ lua_random(0, AMBIENT_COOLDOWN_JITTER_MS))
		ambient_next_spawn_time = now + cooldown
		log("ambient spawned id=%s tier=%s kind=%s variant=%s forced=%s psy=%.3f severity=%.3f mask_k=%.3f frequency_mult=%.3f chance=%.3f chance_roll=%.3f roster_roll=%d cooldown_ms=%d",
			tostring(id), tier, choice.kind, choice.key, tostring(forced), psy_health, severity, mask_k,
			frequency_mult, chance, chance_roll, roster_roll, cooldown)
	else
		ambient_next_spawn_time = now + 30000
		log("ambient spawn failed tier=%s kind=%s variant=%s psy=%.3f retry_ms=30000",
			tier, choice.kind, choice.key, psy_health)
	end
end

function set_ambient_enabled(value)
	ambient_enabled = value == true
	log("ambient enabled=%s", tostring(ambient_enabled))
end

function set_ambient_diagnostics(value)
	ambient_diagnostics = value == true
	log("ambient diagnostics=%s", tostring(ambient_diagnostics))
end

function trigger_ambient_check()
	ambient_initialized = true
	ambient_next_check = 0
	ambient_next_spawn_time = 0
	log("ambient check forced")
end

function trigger_ambient_spawn()
	ambient_initialized = true
	ambient_force_next_spawn = true
	ambient_next_check = 0
	ambient_next_spawn_time = 0
	log("ambient spawn forced; waiting for safe eligible update")
end

function ambient_status()
	local actor = db.actor
	local psy_health = actor and actor.psy_health or 1
	local mask_k = get_mask_psy_k()
	local frequency_mult = math.max(0.5, math.min(1.25, 0.5 + 0.5 * mask_k))
	log("ambient status enabled=%s diagnostics=%s psy=%.3f mask_k=%.3f frequency_mult=%.3f active=%d next_check_ms=%d next_spawn_ms=%d",
		tostring(ambient_enabled), tostring(ambient_diagnostics), psy_health, mask_k,
		frequency_mult, entry_count(nil), math.max(0, ambient_next_check - time_global()),
		math.max(0, ambient_next_spawn_time - time_global()))
end

local function reset_ambient()
	ambient_initialized = false
	ambient_next_check = 0
	ambient_next_spawn_time = 0
	ambient_last_skip_reason = nil
	ambient_force_next_spawn = false
end

function is_phantom(obj_or_id)
	local id = type(obj_or_id) == "number" and obj_or_id
		or (obj_or_id and obj_or_id:id())
	return id ~= nil and active[id] ~= nil
end

function set_enabled(value)
	enabled = value == true
	if not enabled then release_all("disabled") end
	log("enabled=%s", tostring(enabled))
end

function active_count()
	local total = entry_count(nil)
	return total
end

local function on_update()
	local now = time_global()
	local releases = {}
	ambient_update(now)
	for id, power in pairs(pending_psy_hits) do
		pending_psy_hits[id] = nil
		local actor = db.actor
		local source = active[id] and level.object_by_id(id)
		if actor and actor:alive() and source then
			local h = hit()
			h.type = hit.telepatic
			h.power = power
			h.impulse = 0
			h:bone("bip01_spine")
			h.draftsman = source
			h.direction = source:direction()
			actor:hit(h)
		end
	end
	for id, reason in pairs(pending_release) do
		table.insert(releases, { id = id, reason = reason })
	end
	for id, entry in pairs(active) do
		if not pending_release[id] then
			local sobj = alife():object(id)
			if not sobj then
				active[id] = nil
			else
				local obj = level.object_by_id(id)
				configure_client(obj, entry)
				if obj and entry.kind == "npc" and entry.configured
					and now >= (entry.next_inventory_audit or 0) then
					audit_stalker_inventory(obj, entry, now, false)
				end
				force_actor_awareness(obj, entry, now)
			end
			if sobj and now - entry.spawn_time >= (entry.lifetime_ms or 20000) then
				table.insert(releases, { id = id, reason = "timeout" })
			elseif sobj and entry.source_id then
				local source = alife():object(entry.source_id)
				if not is_server_object_alive(source) then
					table.insert(releases, { id = id, reason = "source_gone" })
				end
			end
		end
	end
	for _, item in ipairs(releases) do release_id(item.id, item.reason) end
end

local function on_actor_before_hit(actor, hit_data)
	local entry = hit_data and active[hit_data.who_id]
	if not entry or hit_data.ignore_hit or hit_data.hit_type == hit.telepatic then return end

	-- Replace every phantom physical attack with one controlled telepathic hit.
	-- Apply it on the next update rather than re-entering actor:hit from inside
	-- the engine's before-hit callback.
	hit_data.ignore_hit = true
	local now = time_global()
	if (entry.next_psy_hit_time or 0) <= now then
		local psy_power = entry.variant.psy_hit_power
		entry.next_psy_hit_time = now + (entry.variant.psy_hit_cooldown_ms or 0)
		pending_psy_hits[hit_data.who_id] = psy_power
		if entry.kind == "npc" then
			log("converted npc attack id=%s physical_ignored=true psy_power=%.3f protection=engine_telepatic",
				tostring(hit_data.who_id), psy_power)
		else
			log("converted mutant attack id=%s section=%s physical_ignored=true psy_power=%.3f protection=engine_telepatic",
				tostring(hit_data.who_id), tostring(entry.section), psy_power)
		end
	end
end

local function on_monster_before_hit(obj, hit_data)
	if not obj or not hit_data then return end
	local source_entry = active[hit_data.who_id]
	if source_entry and not active[obj:id()] then
		hit_data.ignore_hit = true
		source_entry.collateral_hits_blocked = (source_entry.collateral_hits_blocked or 0) + 1
		log("blocked collateral hit source=%s victim=%s victim_kind=monster power=%.4f total=%d",
			tostring(hit_data.who_id), tostring(obj:id()), tonumber(hit_data.power) or 0,
			source_entry.collateral_hits_blocked)
		return
	end
	if not active[obj:id()] then return end
	if forcing_awareness_id == obj:id() then return end
	local power = tonumber(hit_data.power) or 0
	local full_power = tonumber(hit_data.full_power) or 0
	if math.max(power, full_power) <= 0 then return end
	hit_data.ignore_hit = true
	queue_release(obj:id(), "hit")
end

local function on_npc_before_hit(obj, hit_data)
	if not obj or not hit_data then return end
	local source_entry = active[hit_data.who_id]
	if source_entry and not active[obj:id()] then
		hit_data.ignore_hit = true
		source_entry.collateral_hits_blocked = (source_entry.collateral_hits_blocked or 0) + 1
		log("blocked collateral hit source=%s victim=%s victim_kind=npc power=%.4f total=%d",
			tostring(hit_data.who_id), tostring(obj:id()), tonumber(hit_data.power) or 0,
			source_entry.collateral_hits_blocked)
		return
	end
	if not active[obj:id()] then return end
	local power = tonumber(hit_data.power) or 0
	local full_power = tonumber(hit_data.full_power) or 0
	if math.max(power, full_power) <= 0 then return end
	hit_data.ignore_hit = true
	queue_release(obj:id(), "hit")
end

local function on_monster_hit(obj, amount)
	-- Fallback for engine hit paths that do not invoke entity_alive_before_hit.
	if obj and active[obj:id()] and (tonumber(amount) or 0) > 0 then
		queue_release(obj:id(), "hit_fallback")
	end
end

local function on_npc_hit(obj, amount)
	if obj and active[obj:id()] and (tonumber(amount) or 0) > 0 then
		queue_release(obj:id(), "hit_fallback")
	end
end

local function on_monster_spawn(obj)
	if not obj or not active[obj:id()] then return end
	configure_client(obj, active[obj:id()])
end

local function on_npc_spawn(obj)
	if not obj or not active[obj:id()] then return end
	configure_client(obj, active[obj:id()])
end

local function enemy_callback(obj, enemy, result)
	if not obj or not enemy then return end
	local obj_is_phantom = active[obj:id()] ~= nil
	local enemy_is_phantom = active[enemy:id()] ~= nil
	if enemy_is_phantom then
		table.insert(result, false)
		return true
	end
	if obj_is_phantom and (not db.actor or enemy:id() ~= db.actor:id()) then
		table.insert(result, false)
		return true
	end
end

local function on_monster_net_destroy(obj)
	if not obj then return end
	local id = obj:id()
	active[id] = nil
	pending_release[id] = nil
	pending_psy_hits[id] = nil
end

local function on_npc_net_destroy(obj)
	on_monster_net_destroy(obj)
end

function attach(sm)
	sm:subscribe({ signal = "on_update", fun = on_update })
	sm:subscribe({ signal = "on_actor_before_hit", fun = on_actor_before_hit })
	sm:subscribe({ signal = "on_monster_before_hit", fun = on_monster_before_hit })
	sm:subscribe({ signal = "on_npc_before_hit", fun = on_npc_before_hit })
	sm:subscribe({ signal = "on_monster_hit", fun = on_monster_hit })
	sm:subscribe({ signal = "on_npc_hit", fun = on_npc_hit })
	sm:subscribe({ signal = "on_monster_spawn", fun = on_monster_spawn })
	sm:subscribe({ signal = "on_npc_spawn", fun = on_npc_spawn })
	sm:subscribe({ signal = "on_monster_enemy_callback", fun = enemy_callback })
	sm:subscribe({ signal = "on_npc_enemy_callback", fun = enemy_callback })
	sm:subscribe({ signal = "on_monster_net_destroy", fun = on_monster_net_destroy })
	sm:subscribe({ signal = "on_npc_net_destroy", fun = on_npc_net_destroy })
	sm:subscribe({ signal = "on_before_save_game", fun = function() release_all("before_save") end })
	sm:subscribe({ signal = "on_stop_modules", fun = function() release_all("stop_modules") reset_ambient() end })
	sm:subscribe({ signal = "level_changer_action", fun = function() release_all("level_change") reset_ambient() end })
end
