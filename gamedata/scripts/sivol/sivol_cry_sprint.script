sivol_cry_sprint = sivol_cry_sprint or {}
local M = sivol_cry_sprint

local STAGE_BONUSES = {
    af_cry_1 = { fresh = 0.20, sustained = 0.05 },
    af_cry_2 = { fresh = 0.30, sustained = 0.07 },
    af_cry_3 = { fresh = 0.40, sustained = 0.09 },
    af_cry_4 = { fresh = 0.50, sustained = 0.10 },
}

local RESERVE_KEY = "sivol_cry_sprint.reserve"
local SPRINT_DRAIN_PER_SECOND = 0.15
local MOVING_RECOVERY_PER_SECOND = 0.15
local STANDING_RECOVERY_PER_SECOND = 0.25
local MOVEMENT_SPEED_TOLERANCE = 0.30
local MAX_SAMPLE_DISTANCE = 5.0
local MAX_SAMPLE_DISTANCE_SQ = MAX_SAMPLE_DISTANCE * MAX_SAMPLE_DISTANCE
local SCAN_INTERVAL = 200
local UPDATE_INTERVAL = 50
local DIAGNOSTIC_INTERVAL = 250
local APPLY_ERROR_LOG_INTERVAL = 1000
local MAX_DELTA = 1000
local DIAGNOSTICS_ENABLED = false

local reserve = 1.0
local reserve_initialized = false
local last_update = nil
local last_scan = 0
local scan_dirty = true
local candidates = {}
local current_selection = nil
local current_bonus = 0.0
local last_applied_bonus = nil
local last_diagnostic = 0
local last_position_x = nil
local last_position_z = nil
local last_apply_status = "not_attempted"
local last_apply_error = nil
local last_apply_error_log = nil

local function clamp(value, low, high)
    return math.max(low, math.min(high, value))
end

local function calculate_bonus(section, condition, current_reserve)
    local stage = STAGE_BONUSES[section]
    if not stage then return 0, 0, 0 end

    local live_condition = clamp(tonumber(condition) or 0, 0, 1)
    if live_condition <= 0 then return 0, 0, 0 end

    local r = clamp(tonumber(current_reserve) or 0, 0, 1)
    local fresh = live_condition * stage.fresh
    local sustained = live_condition * stage.sustained
    local current = sustained + (fresh - sustained) * r
    return fresh, sustained, current
end

function M.get_preview(section, condition)
    return calculate_bonus(section, condition, reserve)
end

function M.get_current_bonus()
    return current_bonus
end

function M.set_diagnostics(enabled)
    DIAGNOSTICS_ENABLED = enabled == true
end

local function belt_is_powered()
    if not (sak and sak_inventory and sak.arts_operate
        and sak.get_accum and sak_inventory.belt_items) then
        return false
    end

    local ok, powered = pcall(function() return sak.get_accum() end)
    return ok and powered and true or false
end

local function invalidate_candidates()
    scan_dirty = true
    last_scan = 0
end

local function scan_candidates(now)
    if not scan_dirty and now - last_scan < SCAN_INTERVAL then return end

    candidates = {}
    last_scan = now
    scan_dirty = false
    if not (sak_inventory and sak_inventory.belt_items) then return end

    for section, ids in pairs(sak_inventory.belt_items) do
        if STAGE_BONUSES[section] and type(ids) == "table" then
            for _, artifact_id in ipairs(ids) do
                table.insert(candidates, {
                    section = section,
                    id = artifact_id,
                })
            end
        end
    end
end

local function select_current(powered, now)
    if not powered then return nil, 0 end

    scan_candidates(now)
    local selected = nil
    local strongest = 0.0
    for _, candidate in ipairs(candidates) do
        local ok_object, artifact = pcall(client_obj, candidate.id)
        if ok_object and artifact then
            local ok_section, live_section = pcall(artifact.section, artifact)
            if ok_section and live_section == candidate.section then
                local ok_condition, live_condition = pcall(artifact.condition, artifact)
                if ok_condition then
                    local condition = clamp(tonumber(live_condition) or 0, 0, 1)
                    local fresh, sustained, contribution = calculate_bonus(
                        candidate.section, condition, reserve)
                    if contribution > strongest then
                        strongest = contribution
                        selected = {
                            section = candidate.section,
                            id = candidate.id,
                            condition = condition,
                            fresh = fresh,
                            sustained = sustained,
                            bonus = contribution,
                        }
                    end
                end
            end
        end
    end
    return selected, strongest
end

local function clear_position_sample()
    last_position_x = nil
    last_position_z = nil
end

local function sample_horizontal_speed(actor, elapsed)
    if not actor or type(actor.position) ~= "function" then
        clear_position_sample()
        return 0
    end

    local ok_position, position = pcall(actor.position, actor)
    if not ok_position or not position
        or type(position.x) ~= "number" or type(position.z) ~= "number" then
        clear_position_sample()
        return 0
    end

    local speed = 0
    if last_position_x and elapsed and elapsed > 0 and elapsed <= 1 then
        local dx = position.x - last_position_x
        local dz = position.z - last_position_z
        local distance_sq = dx * dx + dz * dz
        if distance_sq <= MAX_SAMPLE_DISTANCE_SQ then
            speed = math.sqrt(distance_sq) / elapsed
        end
    end
    last_position_x = position.x
    last_position_z = position.z
    return speed
end

local function actor_predicate(actor_obj, name)
    if not actor_obj then return false end
    local ok, value = pcall(function()
        local predicate = actor_obj[name]
        if type(predicate) ~= "function" then return false end
        return predicate(actor_obj)
    end)
    return ok and value == true
end

local function read_actor_body_state()
    if type(actor_body_state) ~= "function" then return "unknown" end
    local ok, state = pcall(actor_body_state)
    return ok and tostring(state or "unknown") or "unknown"
end

local MOVING_BODY_STATES = {
    fwd = true,
    back = true,
    l_strafe = true,
    r_strafe = true,
    accel = true,
    sprint = true,
    jump = true,
    fall = true,
    landing = true,
    landing2 = true,
    climb = true,
}

local function actor_state(elapsed)
    if not (db and db.actor) then return "inactive" end

    if level and type(level.main_input_receiver) == "function" then
        local ok_receiver, receiver = pcall(level.main_input_receiver)
        if ok_receiver and receiver then
            clear_position_sample()
            return "blocked", { body = "blocked", speed = 0 }
        end
    end
    if type(device) == "function" then
        local ok_paused, paused = pcall(function() return device():is_paused() end)
        if ok_paused and paused then
            clear_position_sample()
            return "blocked", { body = "paused", speed = 0 }
        end
    end

    local actor = db.actor
    local actor_obj = nil
    if type(get_actor_obj) == "function" then
        local ok_actor_obj, value = pcall(get_actor_obj)
        if ok_actor_obj then actor_obj = value end
    end

    local body = read_actor_body_state()
    local moving_predicate = actor_predicate(actor_obj, "is_actor_moving")
    local sprinting_predicate = actor_predicate(actor_obj, "is_actor_sprinting")
    local speed = sample_horizontal_speed(actor, elapsed)
    local body_moving = MOVING_BODY_STATES[body] == true
    local movement_signal = moving_predicate or body_moving or speed > 0
    local moving = movement_signal and speed > MOVEMENT_SPEED_TOLERANCE
    local sprinting = (sprinting_predicate or body == "sprint") and moving

    local signals = {
        body = body,
        moving_predicate = moving_predicate,
        sprinting_predicate = sprinting_predicate,
        body_moving = body_moving,
        movement_signal = movement_signal,
        speed = speed,
        moving = moving,
        sprinting = sprinting,
    }

    if sprinting then return "sprint", signals end
    if moving then return "moving", signals end
    return "standing", signals
end

local function read_expected_sprint_koef()
    if not (params and type(params.get_sprint_base_koef) == "function") then
        return nil
    end
    local ok, base = pcall(params.get_sprint_base_koef)
    if not ok then return nil end
    base = tonumber(base)
    return base and base * (1 + current_bonus) or nil
end

local function read_actual_sprint_koef()
    local actor_obj = nil
    if type(get_actor_obj) == "function" then
        local ok, value = pcall(get_actor_obj)
        if ok then actor_obj = value end
    end
    if actor_obj then
        local ok, value = pcall(function() return actor_obj.sprint_koef end)
        if ok and tonumber(value) then return tonumber(value) end
    end
    if db and db.actor then
        local ok, value = pcall(function() return db.actor.sprint_koef end)
        if ok and tonumber(value) then return tonumber(value) end
    end
    return nil
end

local function load_reserve()
    local stored = get_value(RESERVE_KEY, nil)
    if stored == nil then
        reserve = 1.0
    else
        reserve = clamp(tonumber(stored) or 1.0, 0, 1)
    end
    reserve_initialized = true
end

local function save_reserve()
    if not reserve_initialized then return end
    set_value(RESERVE_KEY, clamp(reserve, 0, 1))
end

local function reset_runtime_clock()
    last_update = nil
    last_applied_bonus = nil
    last_diagnostic = 0
    current_selection = nil
    current_bonus = 0.0
    clear_position_sample()
    last_apply_status = "not_attempted"
    last_apply_error = nil
    last_apply_error_log = nil
    invalidate_candidates()
end

local function apply_current_bonus(selection, bonus, now)
    current_selection = selection
    current_bonus = bonus or 0.0
    if vergas_art and vergas_art.params_flag == true then
        last_apply_status = "deferred"
        last_apply_error = nil
        return
    end

    local changed = last_applied_bonus == nil
        or math.abs(current_bonus - last_applied_bonus) > 0.00001
    if changed and params and type(params.refresh_sprint_koef) == "function"
        and db and db.actor then
        local ok, error_text = pcall(params.refresh_sprint_koef)
        if ok then
            last_apply_status = "ok"
            last_apply_error = nil
            last_applied_bonus = current_bonus
        else
            last_apply_status = "failed"
            last_apply_error = tostring(error_text)
            last_applied_bonus = nil
            if not last_apply_error_log or now - last_apply_error_log >= APPLY_ERROR_LOG_INTERVAL then
                log2("[sivol_cry_sprint] sprint coefficient apply failed: %s", last_apply_error)
                last_apply_error_log = now
            end
        end
    elseif changed then
        last_apply_status = "failed"
        last_apply_error = "params.refresh_sprint_koef unavailable"
        last_applied_bonus = nil
        if not last_apply_error_log or now - last_apply_error_log >= APPLY_ERROR_LOG_INTERVAL then
            log2("[sivol_cry_sprint] sprint coefficient apply failed: %s", last_apply_error)
            last_apply_error_log = now
        end
    else
        last_apply_status = "unchanged"
    end
end

local function diagnostic(now, state, signals, selection, expected_coefficient, actual_coefficient)
    if not DIAGNOSTICS_ENABLED or now - last_diagnostic < DIAGNOSTIC_INTERVAL then return end
    last_diagnostic = now

    signals = signals or {}
    local selected_section = selection and selection.section or "none"
    local selected_id = selection and selection.id or -1
    local selected_condition = selection and selection.condition or 0
    log2(
        "[sivol_cry_sprint] state=%s body=%s moving_pred=%s sprint_pred=%s body_moving=%s movement_signal=%s speed=%.3f moving=%s sprinting=%s reserve=%.3f selected=%s artifact_id=%s condition=%.3f bonus=%.4f expected_sprint_koef=%s actual_sprint_koef=%s apply=%s error=%s",
        state, signals.body or "unknown", tostring(signals.moving_predicate == true),
        tostring(signals.sprinting_predicate == true), tostring(signals.body_moving == true),
        tostring(signals.movement_signal == true), signals.speed or 0,
        tostring(signals.moving == true), tostring(signals.sprinting == true), reserve,
        selected_section, selected_id, selected_condition, current_bonus,
        expected_coefficient and string.format("%.4f", expected_coefficient) or "n/a",
        actual_coefficient and string.format("%.4f", actual_coefficient) or "n/a",
        last_apply_status or "unknown", last_apply_error or "none"
    )
end

function M.on_update()
    if ogse_signals and ogse_signals.get_mgr then
        ogse_signals.get_mgr():reschedule(UPDATE_INTERVAL)
    end

    local now = time_global()
    if not reserve_initialized then load_reserve() end
    if not (db and db.actor) then
        reset_runtime_clock()
        return
    end

    local powered = belt_is_powered()
    local selection, bonus = select_current(powered, now)
    local elapsed = 0
    if last_update and now >= last_update and now - last_update <= MAX_DELTA then
        elapsed = (now - last_update) / 1000.0
    end
    last_update = now
    local state, signals = actor_state(elapsed)

    if powered and selection and state ~= "blocked" and state ~= "inactive" and elapsed > 0 then
        if state == "sprint" then
            reserve = clamp(reserve - SPRINT_DRAIN_PER_SECOND * elapsed, 0, 1)
        elseif state == "moving" then
            reserve = clamp(reserve + MOVING_RECOVERY_PER_SECOND * elapsed, 0, 1)
        else
            reserve = clamp(reserve + STANDING_RECOVERY_PER_SECOND * elapsed, 0, 1)
        end
        selection, bonus = select_current(powered, now)
    end

    apply_current_bonus(selection, bonus, now)

    diagnostic(now, state, signals, selection,
        read_expected_sprint_koef(), read_actual_sprint_koef())
end

function M.on_first_update()
    load_reserve()
    reset_runtime_clock()
end

function M.on_game_loaded()
    load_reserve()
    reset_runtime_clock()
end

function M.on_spawn()
    reset_runtime_clock()
end

function M.on_before_save_game()
    save_reserve()
end

function M.on_level_changer_action()
    save_reserve()
    reset_runtime_clock()
end

function M.on_stop_modules()
    save_reserve()
end

function attach(sm)
    sm:subscribe({ signal = "on_first_update", fun = M.on_first_update })
    sm:subscribe({ signal = "on_update", fun = M.on_update })
    sm:subscribe({ signal = "on_before_save_game", fun = M.on_before_save_game })
    sm:subscribe({ signal = "on_game_loaded", fun = M.on_game_loaded })
    sm:subscribe({ signal = "level_changer_action", fun = M.on_level_changer_action })
    sm:subscribe({ signal = "on_spawn", fun = M.on_spawn })
    sm:subscribe({ signal = "on_item_to_belt", fun = invalidate_candidates })
    sm:subscribe({ signal = "on_item_to_ruck", fun = invalidate_candidates })
    sm:subscribe({ signal = "on_item_to_slot", fun = invalidate_candidates })
    sm:subscribe({ signal = "on_drop_after_all", fun = invalidate_candidates })
    sm:subscribe({ signal = "on_stop_modules", fun = M.on_stop_modules })
end

M.attach = attach