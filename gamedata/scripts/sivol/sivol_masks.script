-- Ôóíêöèÿ äëÿ bind_monster.script (âîçâðàùàåò ìíîæèòåëü ïñè-óðîíà ñ ó÷åòîì èçíîñà)
function sivol.get_mask_psy_k()
    if not vergas_masks.get_flag_mask() then return 1.0 end
    
    local actor = db.actor
    local armor = actor and actor:item_in_slot(6)
    if not armor then return 1.0 end

    local mask_type, armor_sect = vergas_masks.mask_definition()
    if not mask_type or mask_type == "?" then
        local base = sivol.get_base_section(armor_sect)
        mask_type = vergas_lib.set_pr_from_config_str("list_masks", base)
    end
    if not mask_type or mask_type == "?" then return 1.0 end
    
    local base_sect = sivol.get_base_section(armor_sect)
    local mask_root = string.match(mask_type, "(hud_%a+)")
    local mod = sivol.mask_modifiers[base_sect] or sivol.mask_modifiers[mask_root] or sivol.mask_modifiers[mask_type]
    
    -- Áàçîâûé ìíîæèòåëü (åñëè ìàñêà åñòü â ñïèñêå, èíà÷å äåôîëò 0.6)
    local base_psy_k = mod and mod.psy_k or 0.6
    
    -- Ñ÷èòàåì èçíîñ
    local cond = armor:condition()
    local scale = sivol.get_condition_rad_scale(cond)
    
    -- Ëîãèêà: çàùèòà — ýòî (1.0 - ìíîæèòåëü). Ýòó ðàçíèöó ìû è ìàñøòàáèðóåì.
    -- Ïðèìåð: åñëè psy_k = 0.6 (40% çàùèòû), òî ïðè scale 0.5 çàùèòà ñòàíåò 20% (ìíîæèòåëü 0.8)
    local protection = 1.0 - base_psy_k
    local final_psy_k = 1.0 - (protection * scale)
    
    return final_psy_k
end

-------------------------------------------------------------------------
-- 2. ÊÂÅÑÒÎÂÛÅ ÔÓÍÊÖÈÈ
-------------------------------------------------------------------------

-- Ðåñàåì äðîáü Äåíó êîãäà Àðòåì Êóëèíàð íàñ ïîñûëàåò ïî êâåñòó Áîðîâà.
function give_mutant_parts_and_update_dan() 
    sak.create_items({ mutant_boar_leg = 6, mutant_dog_tail = 8 })
    local dan_story_id = story_ids.green_dan
    local dan_obj = alife():story_object(dan_story_id)
    if not dan_obj then return false end
    local data = {}
    if dan_obj.s_storage and dan_obj.s_storage ~= "" and dan_obj.s_storage ~= "_" then
        data = amk.parse_custom_data(dan_obj.s_storage)
    end
    data.trade_manager = { ["resuply_time"] = pack_time_to_string(game.get_game_time()) }
    dan_obj.s_storage = amk.gen_custom_data(data)
    local dan_lvl = level.object_by_id(dan_obj.id)
    if dan_lvl and trade_manager[dan_obj.id] then
        local tt = trade_manager[dan_obj.id]
        tt.resuply_time = game.get_game_time()
        tt.update_time = nil
        tt.skip_updates = 0
        trade_manager.update(dan_lvl)
    end
    timers.start_timer("dan_tip_delay", 60, "sivol.show_dan_tip()")
    return true
end

function sivol.show_dan_tip()
    sak.send_tip("Êóëèíàð ïåðåäàë ÷åðåç ìåíÿ - ãîâîðèò, òû çà äåëîì ïðèä¸øü. Ëàäíî, ðàç Àðò¸ì ïîðó÷èëñÿ, âûäåëèë òåáå îòäåëüíóþ ïàðòèþ äðîáè. Ïðèõîäè, îáìåíÿåì êàê îáû÷íî.", "Äýí Îõîòíèê", 0, 10, "ui_npc_u_hunter_dan", "sak", "green")
end

-- Îãíåì¸ò Ïðàïîðó ìîæíî ïðèíåñòè è íå ïîëíîñòüþ çàðÿæåííûé ïî êâåñòó Ñèäîðîâè÷à, íî íàãðàäà ìåíüøå.
function prapor_good_flame_have_give( flag )
    for i, k in pairs( sak_inventory.rucksack ) do
        if strpos( i, "wpn_flame", 1, true ) then
            local obj  = client_obj( k[ 1 ] )
            local ammo = obj:get_ammo_in_magazine()
            local max_ammo = system_ini():r_float( obj:section(), "ammo_mag_size" )
            if obj:condition() >= 0.95 and ammo >= max_ammo then
                if flag == true then
                    local sobj = g_sim:object( "gar_dolg_prapor" )
                    if sobj and client_obj( sobj.id ) then
                        db.actor:transfer_item( obj, client_obj( sobj.id ) )
                        sak.relocate_item( "out", "wpn_flame", 1 )
                    end
                else return true end
            end
        end
    end
    return false
end

function prapor_good_flame_have_not()
    return not prapor_good_flame_have_give( false )
end

function prapor_partial_flame_remove( first_speaker, second_speaker )
    for i, k in pairs( sak_inventory.rucksack ) do
        if strpos( i, "wpn_flame", 1, true ) then
            local obj = client_obj( k[ 1 ] )
            local npc = second_speaker
            if db.actor:id() == npc:id() then npc = first_speaker end
            db.actor:transfer_item( obj, npc )
            sak.relocate_item( "out", "wpn_flame", 1 )
            return
        end
    end
end

-------------------------------------------------------------------------
-- 3. ÈÍÈÖÈÀËÈÇÀÖÈß
-------------------------------------------------------------------------

local module_initialized = false

function sivol_masks.init_module()
    if module_initialized then return end
    module_initialized = true

    log1("~~~ [SIVOL DEBUG]: init_module() loaded")

    local sm = ogse_signals.get_mgr()

    sm:subscribe({
        signal = "on_item_to_slot",
        fun = function(obj, sobj)
            if not obj or not obj.slot then return end
            if obj:slot() == 6 then
                log1("~~~ [SIVOL DEBUG]: Signal caught -> on_item_to_slot")
                effects_applied = false
                if vergas_masks.get_flag_mask() then
                    sivol.apply_mask_effects()
                end
            end
        end
    })

    sm:subscribe({
        signal = "on_item_to_ruck",
        fun = function(obj, sobj)
            if effects_applied then
                local armor = db.actor and db.actor:item_in_slot(6)
                if not armor or armor:id() == obj:id() then
                    log1("~~~ [SIVOL DEBUG]: Signal caught -> on_item_to_ruck")
                    sivol.remove_mask_effects()
                end
            end
        end
    })
end

function sivol_masks.on_game_load()
    if vergas_masks.get_flag_mask() then
        sivol.apply_mask_effects()
        schedule.add("sivol_load_check", "sivol.apply_mask_effects()", 2000)
    end
end

