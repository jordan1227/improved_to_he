-- Ejected bullet-casing impact sounds. Ported from Anomaly's "Bullet Shell Sounds"
-- addon and adapted for NLC HE's ogse_signals dispatch and fl_step_material() hook.
-- NLC: NPC casings (engine hook CWeaponMagazined::OnShot -> on_npc_shot, docs/AUDIO_DESIGN.md 13.2),
-- tunable timing below; the actor's casings land 20% sooner than before (about 0.8 s instead of 1.0 s).

-- Tunables (edit here; a game restart reloads the script)
local cfg = {
	enabled = true,
	volume = 0.8,               -- actor casings (2D)
	land_time_ms = 800,         -- shot to first casing impact (was 1000)
	land_jitter_ms = 80,        -- random extra delay per casing (was 100)
	double_barrel_delay_ms = 140, -- extra delay of break-action casings after the reload starts (was 175)
	gap_scale = 0.8,            -- scales SHELL_SOUND_GAP_TIME (time between casings of one reload)

	npc_enabled = true,
	npc_volume = 0.7,
	npc_land_time_ms = 650,     -- NPC casings start lower (hip height) and land sooner
	npc_min_dist = 1.0,         -- full volume within this distance
	npc_max_dist = 20.0,        -- inaudible past this distance (the engine hook also stops at 30 m)
	npc_max_active = 24,        -- cap on NPC casing sounds in flight (big fights)
}

local SHELL_TYPE_PISTOL = "pistol"
local SHELL_TYPE_RIFLE = "rifle"
local SHELL_TYPE_SHOTGUN = "shotgun"

local SHELL_SOUND_TYPE_GENERIC = "generic"
local SHELL_SOUND_TYPE_LEAVES = "leaves"
local SHELL_SOUND_TYPE_WATER = "water"
local SHELL_SOUND_TYPE_METAL = "metal"
local SHELL_SOUND_TYPE_WOOD = "wood"

-- Valid NLC firearm sections. The signal also fires for knife attacks, so this
-- table is deliberately a whitelist rather than a generic wpn_* test.
local WEAPON_CLASS = {
	-- Pistols and SMGs.
	wpn_ak74_m3 = SHELL_TYPE_PISTOL, wpn_aps = SHELL_TYPE_PISTOL,
	wpn_beretta = SHELL_TYPE_PISTOL, wpn_beretta93 = SHELL_TYPE_PISTOL,
	wpn_colt1911 = SHELL_TYPE_PISTOL, wpn_desert_eagle = SHELL_TYPE_PISTOL,
	wpn_eagle_m1 = SHELL_TYPE_PISTOL, wpn_fort = SHELL_TYPE_PISTOL,
	wpn_fort_m1 = SHELL_TYPE_PISTOL, wpn_glock = SHELL_TYPE_PISTOL,
	wpn_glock_m1 = SHELL_TYPE_PISTOL, wpn_glock_m2 = SHELL_TYPE_PISTOL,
	wpn_pb = SHELL_TYPE_PISTOL, wpn_pm = SHELL_TYPE_PISTOL,
	wpn_sig220 = SHELL_TYPE_PISTOL, wpn_usp = SHELL_TYPE_PISTOL,
	wpn_walther = SHELL_TYPE_PISTOL,
	wpn_bizon = SHELL_TYPE_PISTOL, wpn_mp5 = SHELL_TYPE_PISTOL,
	wpn_mp5_m1 = SHELL_TYPE_PISTOL, wpn_mp5_m2 = SHELL_TYPE_PISTOL,
	wpn_pp19 = SHELL_TYPE_PISTOL, wpn_ump45 = SHELL_TYPE_PISTOL,

	-- Rifles, marksman rifles, and machine guns.
	wpn_abakan = SHELL_TYPE_RIFLE, wpn_ak104 = SHELL_TYPE_RIFLE,
	wpn_ak47 = SHELL_TYPE_RIFLE, wpn_ak74 = SHELL_TYPE_RIFLE,
	wpn_ak74_m1 = SHELL_TYPE_RIFLE, wpn_ak74_m2 = SHELL_TYPE_RIFLE,
	wpn_ak74u = SHELL_TYPE_RIFLE, wpn_akm = SHELL_TYPE_RIFLE, wpn_aks47_he = SHELL_TYPE_RIFLE,
	wpn_ak108 = SHELL_TYPE_RIFLE, wpn_aks47 = SHELL_TYPE_RIFLE,
	wpn_fn2000 = SHELL_TYPE_RIFLE, wpn_g36 = SHELL_TYPE_RIFLE,
	wpn_g36c = SHELL_TYPE_RIFLE, wpn_groza = SHELL_TYPE_RIFLE,
	wpn_lr300 = SHELL_TYPE_RIFLE, wpn_m16a4 = SHELL_TYPE_RIFLE,
	wpn_m110 = SHELL_TYPE_RIFLE, wpn_mosin = SHELL_TYPE_RIFLE,
	wpn_mr308 = SHELL_TYPE_RIFLE, wpn_pkm = SHELL_TYPE_RIFLE,
	wpn_pkp = SHELL_TYPE_RIFLE, wpn_rpk = SHELL_TYPE_RIFLE,
	wpn_rpk74 = SHELL_TYPE_RIFLE, wpn_sig550 = SHELL_TYPE_RIFLE,
	wpn_soc308 = SHELL_TYPE_RIFLE, wpn_svd = SHELL_TYPE_RIFLE,
	wpn_sv98 = SHELL_TYPE_RIFLE, wpn_svu = SHELL_TYPE_RIFLE,
	wpn_val = SHELL_TYPE_RIFLE, wpn_vintorez = SHELL_TYPE_RIFLE,
	wpn_vintorez_m1 = SHELL_TYPE_RIFLE, wpn_saiga12c_m2 = SHELL_TYPE_RIFLE,

	-- Shotguns.
	wpn_bm16 = SHELL_TYPE_SHOTGUN, wpn_bm16_full = SHELL_TYPE_SHOTGUN,
	wpn_hunters_toz_new = SHELL_TYPE_SHOTGUN, wpn_mp153 = SHELL_TYPE_SHOTGUN,
	wpn_mp153_m1 = SHELL_TYPE_SHOTGUN, wpn_saiga12c = SHELL_TYPE_SHOTGUN,
	wpn_saiga12c_m1 = SHELL_TYPE_SHOTGUN, wpn_spas12 = SHELL_TYPE_SHOTGUN,
	wpn_spas12_m1 = SHELL_TYPE_SHOTGUN, wpn_spas15 = SHELL_TYPE_SHOTGUN,
	wpn_spas15_m1 = SHELL_TYPE_SHOTGUN, wpn_toz34 = SHELL_TYPE_SHOTGUN,
	wpn_toz34_m1 = SHELL_TYPE_SHOTGUN, wpn_wincheaster1300 = SHELL_TYPE_SHOTGUN, wpn_mp133_full = SHELL_TYPE_SHOTGUN,
	wpn_winchester_m1 = SHELL_TYPE_SHOTGUN,
}

local WEAPON_DOUBLE_BARREL = {
	wpn_bm16 = true,
	wpn_bm16_full = true,
	wpn_hunters_toz_new = true,
	wpn_toz34 = true,
	wpn_toz34_m1 = true,
}

-- Time between the casings of one reload, ms (before cfg.gap_scale).
local SHELL_SOUND_GAP_TIME = {
	wpn_bm16 = 200,
	wpn_bm16_full = 200,
	wpn_toz34 = 600,
	wpn_toz34_m1 = 600,
}

local WEAPON_SECTION_POSTFIXES = {
	"_1p78", "_ekp", "_okp", "_pso", "_rakurs", "_ac10632",
	"_eot", "_microt1", "_specter", "_g28_scope",
}

-- Original addon's material mapping, keyed by its normalized material name.
local SHELL_SOUND_TYPE = {
	water = SHELL_SOUND_TYPE_WATER,
	bush = SHELL_SOUND_TYPE_LEAVES,
	bush_sux = SHELL_SOUND_TYPE_LEAVES,
	grass = SHELL_SOUND_TYPE_GENERIC,
	metal = SHELL_SOUND_TYPE_METAL,
	metal_plate = SHELL_SOUND_TYPE_METAL,
	metal_pipe = SHELL_SOUND_TYPE_METAL,
	setka_rabica = SHELL_SOUND_TYPE_METAL,
	tin = SHELL_SOUND_TYPE_METAL,
	wood = SHELL_SOUND_TYPE_WOOD,
	wooden_board = SHELL_SOUND_TYPE_WOOD,
	asphalt = SHELL_SOUND_TYPE_GENERIC,
	shifer = SHELL_SOUND_TYPE_GENERIC,
	tile = SHELL_SOUND_TYPE_GENERIC,
	flooring_tile = SHELL_SOUND_TYPE_GENERIC,
	concrete = SHELL_SOUND_TYPE_GENERIC,
	earth = SHELL_SOUND_TYPE_GENERIC,
	dirt = SHELL_SOUND_TYPE_GENERIC,
	gravel = SHELL_SOUND_TYPE_GENERIC,
	sand = SHELL_SOUND_TYPE_GENERIC,
	fake = SHELL_SOUND_TYPE_GENERIC,
	fake_ladders = SHELL_SOUND_TYPE_GENERIC,
	actor = SHELL_SOUND_TYPE_GENERIC,
}

-- Actor casings waiting for their landing time: { name, time, object }
local shell_sound_list = {}
-- NPC casings in flight (kept referenced so the sound is not collected before it plays)
local npc_sounds = {}

local function normalize_material_name(material)
	if type(material) ~= "string" then return nil end
	local name = string.lower(material:gsub("/", "\\"))
	name = name:gsub("^materials\\", "")
	return name ~= "" and name or nil
end

local function surface_of(material)
	return SHELL_SOUND_TYPE[normalize_material_name(material)] or SHELL_SOUND_TYPE_GENERIC
end

local function get_surface_sound_type()
	if type(fl_step_material) ~= "function" then return SHELL_SOUND_TYPE_GENERIC end
	return surface_of(fl_step_material())
end

local function get_weapon_class(section)
	local shell_type = WEAPON_CLASS[section]
	if shell_type then return shell_type end
	-- Active NLC weapons can carry an optic suffix while retaining their base class.
	for i = 1, #WEAPON_SECTION_POSTFIXES do
		local postfix = WEAPON_SECTION_POSTFIXES[i]
		if string.sub(section, -#postfix) == postfix then
			return WEAPON_CLASS[string.sub(section, 1, #section - #postfix)]
		end
	end
end

local function base_section(section)
	if WEAPON_CLASS[section] then return section end
	for i = 1, #WEAPON_SECTION_POSTFIXES do
		local postfix = WEAPON_SECTION_POSTFIXES[i]
		if string.sub(section, -#postfix) == postfix then
			return string.sub(section, 1, #section - #postfix)
		end
	end
	return section
end

local function get_sound_name(shell_type, surface_type)
	if surface_type == SHELL_SOUND_TYPE_WATER or surface_type == SHELL_SOUND_TYPE_LEAVES then
		return "bullet_shells\\generic_" .. surface_type .. "_" .. math.random(1, 8)
	end
	return "bullet_shells\\" .. shell_type .. "_" .. surface_type .. "_" .. math.random(1, 8)
end

-- landing time of casing number index (1-based) of one shot or reload
local function get_sound_time(weapon_name, index)
	local gap = (SHELL_SOUND_GAP_TIME[weapon_name] or 100) * cfg.gap_scale
	return time_global() + cfg.land_time_ms + gap * (index - 1) + math.random(0, cfg.land_jitter_ms)
end

local function queue_shell_sound(weapon_name, shell_type, ammo_in_magazine, is_reload)
	local double = WEAPON_DOUBLE_BARREL[weapon_name]
	if is_reload and not double then return end
	if not is_reload and double then return end

	local count = double and (2 - ammo_in_magazine) or 1
	if count < 1 then return end
	local surface_type = get_surface_sound_type()
	for i = 1, count do
		shell_sound_list[#shell_sound_list + 1] = {
			object = nil,
			name = get_sound_name(shell_type, surface_type),
			time = get_sound_time(weapon_name, i) + (double and cfg.double_barrel_delay_ms or 0),
		}
	end
end

local function on_actor_weapon_fire(wpn)
	if not cfg.enabled or not wpn then return end
	local section = wpn:section()
	local shell_type = get_weapon_class(section)
	if not shell_type then return end
	queue_shell_sound(base_section(section), shell_type, wpn:get_ammo_in_magazine(), false)
end

local function on_actor_weapon_reload(wpn)
	if not cfg.enabled or not wpn then return end
	local section = wpn:section()
	local shell_type = get_weapon_class(section)
	if not shell_type then return end
	queue_shell_sound(base_section(section), shell_type, wpn:get_ammo_in_magazine(), true)
end

-- Engine hook (CWeaponMagazined::OnShot, NPCs within 30 m of the camera): ground point under the ejection port and its
-- material. Break-action shotguns drop their casings on reload, which NPCs do not report, so they stay silent.
function on_npc_shot(npc, wpn, pos, material)
	if not (cfg.enabled and cfg.npc_enabled and npc and wpn and pos) then return end
	if #npc_sounds >= cfg.npc_max_active then return end
	local section = wpn:section()
	local shell_type = get_weapon_class(section)
	if not shell_type or WEAPON_DOUBLE_BARREL[base_section(section)] then return end
	local snd = sound_object(get_sound_name(shell_type, surface_of(material)))
	local delay = (cfg.npc_land_time_ms + math.random(0, cfg.land_jitter_ms)) / 1000
	snd:play_at_pos(npc, pos, delay, sound_object.s3d)
	snd.volume = cfg.npc_volume
	snd.min_distance = cfg.npc_min_dist
	snd.max_distance = cfg.npc_max_dist
	npc_sounds[#npc_sounds + 1] = { object = snd, until_time = time_global() + delay * 1000 + 100 }
end

local function on_update()
	local now = time_global()
	-- compact in place: removed entries leave no holes (#list on a table with holes is unreliable)
	local n = 0
	for i = 1, #shell_sound_list do
		local s = shell_sound_list[i]
		shell_sound_list[i] = nil
		local keep = true
		if now > s.time then
			if not s.object then
				s.object = sound_object(s.name)
				s.object:play(db.actor, 0, sound_object.s2d)
				s.object.volume = cfg.volume
			elseif not s.object:playing() then
				keep = false
			end
		end
		if keep then
			n = n + 1
			shell_sound_list[n] = s
		end
	end

	n = 0
	for i = 1, #npc_sounds do
		local s = npc_sounds[i]
		npc_sounds[i] = nil
		if now < s.until_time or s.object:playing() then
			n = n + 1
			npc_sounds[n] = s
		end
	end
end

function attach(sm)
	sm:subscribe({ signal = "on_actor_weapon_fire", fun = on_actor_weapon_fire })
	sm:subscribe({ signal = "on_actor_weapon_reload", fun = on_actor_weapon_reload })
	sm:subscribe({ signal = "on_update", fun = on_update })
end
