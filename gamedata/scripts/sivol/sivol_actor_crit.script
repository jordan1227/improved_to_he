-- sivol_actor_crit.script: critical hits on the player, mutant hit zones and mask head cover.
-- docs/damage_model/DESIGN_actor_damage_model.md sections 6, 13.4, 14.2, 15.3, 18.
--
-- Replaces the bone/power part of ogse_critical_hit.script and the mutant bone remap and head
-- effects of vergas_masks.actor_hit_target. Everything reads the engine's last-hit record
-- (db.actor:nlc_last_hit_*), so effects follow the damage after armour, not the raw power.
--
-- Switches (no options-menu entries; the crit effects still follow game_options.AdditionalMobHits):
local ENABLED      = true -- critical effects and the bullet-hit camera
local MUTANT_ZONES = true -- mutant hits land on zones by bone name, old DPS kept (14.2)
local HEAD_COVER   = true -- the worn mask sets the engine head cover (H1, 15.3)
local THINKING     = false -- "Thinking out loud" messages of the injury option: injury, worsening, cure, adrenaline rush,
                             -- belt wear (off: the watch, the inventory tint, sounds and camera tell it; the PDA article tip comes once)
local DEBUG        = false

function active() return ENABLED end
function thinking() return THINKING end -- shared by sivol_adrenaline and sivol_belt
function mutant_zones() return MUTANT_ZONES end

-------------------------------------------------------------------------------
-- zones by bone name
-------------------------------------------------------------------------------
local ZONE = {
	bip01_head = "head", bip01_neck = "head", eye_left = "head", eye_right = "head",
	eyelid_1 = "head", jaw_1 = "head",
	bip01_spine2 = "chest", bip01_spine1 = "chest", bip01_l_clavicle = "chest", bip01_r_clavicle = "chest",
	bip01_spine = "belly", bip01_pelvis = "belly",
	bip01_l_upperarm = "arm", bip01_l_forearm = "arm", bip01_l_hand = "arm",
	bip01_r_upperarm = "arm", bip01_r_forearm = "arm", bip01_r_hand = "arm",
	bip01_l_thigh = "leg", bip01_l_calf = "leg", bip01_l_foot = "leg", bip01_l_toe0 = "leg",
	bip01_r_thigh = "leg", bip01_r_calf = "leg", bip01_r_foot = "leg", bip01_r_toe0 = "leg",
}
local unknown_logged = {}

local function zone_of(bone_id)
	if not bone_id or bone_id < 0 or bone_id >= 65535 then return "chest" end
	local ok, name = pcall(db.actor.get_bone_name, db.actor, bone_id)
	if not ok or type(name) ~= "string" then return "chest" end
	local z = ZONE[name]
	if z then return z end
	if string.find(name, "finger", 1, true) then return "arm" end
	if not unknown_logged[name] then
		unknown_logged[name] = true
		log2("[sivol_actor_crit] bone %s has no zone, counted as chest", name)
	end
	return "chest"
end

function zone_name(bone_id) return zone_of(bone_id) end

-------------------------------------------------------------------------------
-- mutant injury zones by anatomy (M2, design 18.5 and 18.8). The damage itself keeps the old
-- vergas_masks bone remap (same bones, same power, same body-part split), so mutant lethality
-- is exactly as before with body health on or off. Only the injury zone is picked here, by
-- anatomy, and its size is computed as for a hit-scale-1.0 limb hit (old class factor k).
-- Weights head / torso / arm / leg. Melee only (wound / strike).
-------------------------------------------------------------------------------
-- head, torso, arm, leg, k[, injury factor: small fast biters charge injuries less, damage unchanged (design 26)]
local function mutant_profile(obj)
	local clid = obj:clsid()
	local name = obj:name()
	if clid == CLID_TUSHKANO or string.find(name, "buzz", 1, true) then
		return 0, 0, 0, 100, 1.0, 0.4
	elseif clid == CLID_BLOODSUCKER then
		return 25, 40, 35, 0, 0.73
	elseif clid == CLID_SNORK then
		return 20, 30, 30, 20, 0.84
	elseif clid == CLID_CHIMERA then
		return 20, 40, 30, 10, 0.84
	elseif clid == CLID_CAT then
		return 5, 35, 20, 40, 0.84, 0.6
	elseif clid == CLID_PSEUDODOG or clid == CLID_PSY_DOG or clid == CLID_PSY_DOG_PHANTOM then
		return 10, 30, 0, 60, 0.84
	elseif clid == CLID_DOG then
		return 10, 30, 0, 60, 1.0, 0.5
	elseif clid == CLID_CONTROLLER then
		return 10, 50, 40, 0, 1.0
	elseif clid == CLID_BOAR or clid == CLID_FLESH then
		return 0, 30, 0, 70, 1.0
	end
	return nil
end

local pending_mutant = nil -- { id, zone, k, time, heavy } of the melee hit being processed

-- strongest hit_power of a monster section's attack_params (anim = time, hit_power, ...), cached.
-- A mutant hit is heavy at HEAVY_SHARE of it (a boar's charge, not its bites): only heavy hits and
-- bullets / explosions can make an injury severe by charge (DESIGN_recovery_and_body_status.md 32)
local HEAVY_SHARE = 0.75
local strongest_cache = {}
local function strongest_attack(sect)
	local v = strongest_cache[sect]
	if v then return v end
	v = 0
	local ini = system_ini()
	local ap = ini:section_exist(sect) and ini:line_exist(sect, "attack_params") and ini:r_string(sect, "attack_params")
	if ap and ini:section_exist(ap) then
		for i = 0, ini:line_count(ap) - 1 do
			local _, _, val = ini:r_line(ap, i, "", "")
			local p = val and tonumber(string.match(val, "^%s*[^,]+,%s*([%d%.]+)"))
			if p and p > v then v = p end
		end
	end
	strongest_cache[sect] = v
	return v
end

-- called from vergas_masks.actor_hit_target before its old bone remap (which still runs)
function note_mutant_hit(hd, obj)
	pending_mutant = nil
	if not MUTANT_ZONES or not obj or not db.actor then return end
	if hd.hit_type ~= hit.wound and hd.hit_type ~= hit.strike then return end
	local head, torso, arm, leg, k, inj = mutant_profile(obj)
	if not head then return end
	local r = math.random() * (head + torso + arm + leg)
	local zone
	if r < head then zone = "head"
	elseif r < head + torso then zone = "chest"
	elseif r < head + torso + arm then zone = "arm"
	else zone = "leg" end
	-- hd.power is the hit before belt artifacts (entity_alive_before_hit), as in attack_params
	local top = strongest_attack(obj:section())
	local heavy = top <= 0 or (tonumber(hd.power) or 0) >= HEAVY_SHARE * top
	pending_mutant = { id = obj:id(), zone = zone, k = k, inj = inj or 1.0, time = time_global(), heavy = heavy }
end

-- what a hit of this raw power does to a hit-scale-1.0 limb: outfit protection once in the
-- outfit stage and once through params.actor_immunities_add (base 0.6 + 0.4 * difficulty)
local function clamp(v, a, b) if v < a then return a elseif v > b then return b end return v end

local function mutant_limb_damage(raw, htype)
	local base = 0.6 + 0.4 * (tonumber(level.get_game_difficulty()) or 3)
	-- rupture factor of params.actor_immunities_add (master x0.91), so damage and injury charge stay in step
	if htype == hit.wound and params and params.wound_k then base = base * params.wound_k() end
	local armor = db.actor:get_current_outfit()
	local outfit = armor and armor:get_outfit()
	if not outfit then
		return raw * base * 5
	end
	local prot = htype == hit.strike and outfit.strike_protection or outfit.wound_protection
	local p = clamp((tonumber(prot) or 0) * armor:condition(), -1, 1)
	return raw * (1 - p) * base * (1 - p)
end

-------------------------------------------------------------------------------
-- mask head cover (H1): coverage and armour of the worn mask, scaled by its condition
-------------------------------------------------------------------------------
local MASK_COVER = {
	hud_gas = { 0.25, 0.03 },
	hud_mer = { 0.35, 0.05 },
	hud_sci = { 0.55, 0.08 },
	hud_mil = { 0.70, 0.10 },
	hud_exo = { 0.90, 0.10 },
}
local MASK_COND_FULL = 0.75
local next_cover_t = 0
local last_cov, last_arm = -1, -1

local function update_head_cover(force)
	if not HEAD_COVER or not db.actor then return end
	local now = time_global()
	if not force and now < next_cover_t then return end
	next_cover_t = now + 500
	local cov, arm = 0, 0
	local outfit = db.actor:get_current_outfit()
	if outfit and vergas_masks and vergas_masks.get_flag_mask() then
		local t = MASK_COVER[vergas_masks.get_mask_config(outfit:section())]
		if t then
			local cond = (tonumber(vergas_masks.get_mask_condition(outfit:id())) or 100) / 100
			local cf = math.min(1, math.max(0, cond) / MASK_COND_FULL)
			cov, arm = t[1] * cf, t[2] * cf
		end
	end
	if math.abs(cov - last_cov) > 0.001 or math.abs(arm - last_arm) > 0.001 then
		last_cov, last_arm = cov, arm
		db.actor:nlc_set_head_cover(cov, arm)
		if DEBUG then log2("[sivol_actor_crit] head cover %.2f armour %.2f", cov, arm) end
	end
end

-------------------------------------------------------------------------------
-- injuries (C2, design 18.2-18.4): per-zone charge from the damage after armour, no roll.
-- A hit adds its dealt damage to the zone charge when dealt >= MIN_HIT; the charge decays.
-- Light injury at T_LIGHT, severe at T_SEVERE. Cure ladder (DESIGN_recovery_and_body_status.md 3):
-- by time (limb health >= CURE_LIMB and CURE_MIN_MIN game minutes since the last change: light
-- clears), medkits (plain clears light, army splints severe / clears light, scientific all), splint /
-- survival kit treat one zone; a severe injury becomes "splinted" (design 32) and heals by time. Levels and times are saved.
-- With body health on a severe arm/leg is also an engine fracture (F1, 3.2): the engine no longer
-- rolls fractures (actor.ltx fracture_threshold 0.999); the fracture comes and goes with the level.
-------------------------------------------------------------------------------
local MIN_HIT, T_LIGHT, T_SEVERE = 0.06, 0.15, 0.40 -- retune 2026-10-20 (was 0.30 / 0.70)
local ONE_HIT_SEVERE = 0.35 -- a single counted hit this strong is severe at once
local T_SEVERE_BULLET = 0.60 -- bullets: severe charge (design 35: two AK FMJ limb hits in a medium suit were a fracture)
local DECAY_PER_S = 0.003        -- design 26 (was 0.01), and only DECAY_GRACE_MS after the zone's last counted hit
local DECAY_GRACE_MS = 30000
local MIN_PART = 0.02            -- hits from MIN_PART to MIN_HIT count at half weight (was all or nothing)
local CURE_LIMB   = 0.75 -- limb health (both limbs of the zone; total health with body health off) needed to heal by time
local LEG_SPEED      = { 0.88, 0.70 } -- body health off
local LEG_SPEED_BODY = { 0.95, 0.85 } -- body health on: the skeleton already slows by leg health (LegsSpeedK)
local ARM_RELOAD  = { 0.85, 0.75 } -- reload speed (engine factor "injury"), light / severe
local ARM_DRAW    = { 0.85, 0.70 } -- draw / holster speed
local ARM_RECOIL  = { 1.15, 1.35 } -- recoil multiplier (sivol_fuzz_recoil.script)
-- belt wear (sivol_belt.script, design 19): x the damage that got through the armour
local BELT_WEAR, BELT_WEAR_MUTANT, BELT_WEAR_BLAST = 0.5, 0.25, 0.15
local BLAST_LIMB = 0.25 -- an explosion also charges arm and leg injuries with this share of its damage
local CURE_MIN_MIN = { 30 }        -- game minutes since the last level change: a light injury clears (limb >= CURE_LIMB)
-- splinted state (DESIGN_recovery_and_body_status.md 32): a splint, survival kit or army medkit sets a severe
-- injury; it heals after SPLINT_MIN game minutes (sleep counts double). Untreated, a severe injury sets by itself
-- after SEVERE_MIN. Sleep no longer eases a severe injury.
local SEVERE_MIN = 2880
local SPLINT_MIN = 1440
local LEG_SPEED_SPLINT = 0.92
local SPLINT_SPRINT = 0.75          -- sprint factor with a splinted leg (params.refresh_sprint_koef)
local SPLINT_RELOAD, SPLINT_DRAW, SPLINT_RECOIL = 0.92, 0.92, 1.10
local MEDKIT_CURE = { medkit_army = 1, medkit_scientic = 2 } -- light ones cleared + this many splints (prefix; _razgr included; design 33)
local PLAIN_MEDKIT = "medkit"      -- exact section: clears light injuries only
local FIELD_CURE = { improvised_splint = true, survival_kit = true } -- one zone: light clears, severe is splinted (per portion)
local FRACTURE_SET = 0.25 / 1.5    -- fracture power of a severe limb (x actor.ltx fracture_coef 1.5 = 0.25: limb max health 0.80)
local FRACTURE_SPLINT = 0.10       -- stored fracture of a splinted limb (limb max health 0.92, less pain)
-- body_part enum of the engine (nlc_body_health.h): 3/4 arms, 5/6 legs
local PART_ZONE = { [3] = "arm", [4] = "arm", [5] = "leg", [6] = "leg" }
local HEAD_MIN_DEALT, PING_ABSORBED, PING_RAW = 0.10, 0.5, 0.4
local CAM_ID, CAM_SAME_MS, CAM_ANY_MS = 100, 1500, 400
local SAVE = { arm = "nlc_vars.injury_arm", leg = "nlc_vars.injury_leg" }
local SAVE_T = { arm = "nlc_vars.injury_arm_t", leg = "nlc_vars.injury_leg_t" } -- game minute of the last worsening
local SAVE_S = { arm = "nlc_vars.injury_arm_s", leg = "nlc_vars.injury_leg_s" } -- game minute a splinted injury heals
local PARTS = { arm = { "left_arm", "right_arm" }, leg = { "left_leg", "right_leg" } }

local charge = { arm = 0, leg = 0 }
local level_of = { arm = 0, leg = 0 }
local since_of = { arm = 0, leg = 0 } -- game minute of the last worsening
local splint_end = { arm = 0, leg = 0 } -- game minute the splinted injury heals; 0 = not splinted
local heavy_of = { arm = false, leg = false } -- the zone's charge holds a heavy hit (bullet, explosion, heavy mutant blow)

local function splinted(zone) return level_of[zone] == 2 and splint_end[zone] > 0 end
-- order of states for the think lines: 0 none, 1 light, 1.5 splinted, 2 severe
local function stage(zone) return splinted(zone) and 1.5 or level_of[zone] end
local last_decay_t = 0
local last_count_t = { arm = 0, leg = 0 } -- time_global of the zone's last counted hit
local last_cam_name, next_cam_same_t, next_cam_any_t = nil, 0, 0
local cam_slot = 0 -- the hit cameras alternate between CAM_ID and CAM_ID + 1
local concussion_end, concussion_vol = 0, nil
local next_cure_t = 0
local snd = nil
local SOUNDS = { "arts_hit_1", "arts_hit_2", "arts_hit_3", "pain_1", "pain_2", "pain_3", "pain_4", "pain_5", "pain_6", "pain_7", "pain_8" }


local function play_pain()
	if snd and snd:playing() then return end
	snd = xr_sound.get_safe_sound_object("actor\\" .. SOUNDS[math.random(table.getn(SOUNDS))])
	snd:play_at_pos(db.actor, vector(), 0, sound_object.s2d)
end

local function camera(info)
	local now = time_global()
	if now < next_cam_any_t then return end -- one kick per burst
	local cam
	-- armour-class camera from the hit-fx remake; nil (non-bullet, no suit, bare head) keeps the anm below
	if sivol_hit_fx and sivol_hit_fx.active and sivol_hit_fx.active() then
		cam = sivol_hit_fx.camera_for(info)
	end
	if not cam then
		if info.zone == "head" then
			cam = "camera_effects\\head_shot.anm"
		elseif info.zone == "arm" or info.zone == "leg" then
			cam = math.random() < 0.5 and "camera_effects\\hit_front_left.anm" or "camera_effects\\hit_front_right.anm"
		else
			cam = "camera_effects\\hit_front.anm"
		end
	end
	if cam == last_cam_name and now < next_cam_same_t then return end
	-- a new effector with the id of a running one replaces it and the view snaps back (user test 2026-10-20);
	-- two ids let the previous kick finish while the next one starts
	cam_slot = 1 - cam_slot
	level.add_cam_effector(cam, CAM_ID + cam_slot, false, "")
	last_cam_name, next_cam_same_t, next_cam_any_t = cam, now + CAM_SAME_MS, now + CAM_ANY_MS
end

local function body_on()
	return body_health ~= nil and body_health.enabled()
end

-- inventory body window (engine nlc-3.589.112+, DESIGN_recovery_and_body_status.md 14.2 E3/E4):
-- whether the injury system runs, and the levels (head: 1 while a concussion runs). Not saved by
-- the engine, so it is pushed on every change, every second and after a load.
local function push_injuries()
	if not (body_health and body_health.set_injury) then return end
	body_health.set_injury_system(ENABLED and game_options.AdditionalMobHits ~= false)
	body_health.set_injury("arm", splinted("arm") and 3 or level_of.arm) -- 3 = splinted (engine nlc-3.589.117+)
	body_health.set_injury("leg", splinted("leg") and 3 or level_of.leg)
	body_health.set_injury("head", concussion_end > time_global() and 1 or 0)
end

-- apply the effects of the current levels (also after a load and when the body health option changes)
-- a charged exo with live servos braces injured limbs (sivol_exo.limb_assist, DESIGN_exo_rebalance.md):
-- the injury penalties lose BRACE_K of their effect, a severe leg can sprint and a splint does not slow it
local BRACE_K = 0.5
function braced() return sivol_exo ~= nil and sivol_exo.limb_assist() end
function brace(k) return 1 + (k - 1) * (1 - BRACE_K) end

local applied_body = nil
local function apply_levels()
	if not db.actor then return end
	applied_body = body_on()
	local leg = level_of.leg
	local leg_s = splinted("leg")
	local exo = braced()
	sivol.remove_move_penalty("crit_legs")
	if leg_s then
		sivol.add_move_penalty("crit_legs", exo and brace(LEG_SPEED_SPLINT) or LEG_SPEED_SPLINT)
	elseif leg > 0 then
		local k = (applied_body and LEG_SPEED_BODY or LEG_SPEED)[leg]
		sivol.add_move_penalty("crit_legs", exo and brace(k) or k)
	end
	-- crippled: no sprint (named block of the mod's sprint API; db.actor.cant_sprint is not an engine property)
	-- adrenaline (sivol_adrenaline.script) lifts the block during its rush; the limp stays. A splinted leg
	-- sprints, slower (sprint_k through params.refresh_sprint_koef). An exo brace lifts the block too.
	if leg >= 2 and not leg_s and not exo and db.actor:alive() and not (sivol_adrenaline and sivol_adrenaline.lifts_sprint_block()) then
		sivol.add_sprint_block("crit_legs")
	else
		sivol.remove_sprint_block("crit_legs")
	end
	if params and params.refresh_sprint_koef then params.refresh_sprint_koef() end
	local arm = level_of.arm
	local arm_s = splinted("arm")
	if arm > 0 then
		set_value("nlc_vars.add_wobble", arm_s and 3 or arm) -- consumer: params/wpn_params.script (1 = x1.25, 2 = x1.5, 3 = splinted x1.1)
	else
		remove_value("nlc_vars.add_wobble")
	end
	local reload = arm_s and SPLINT_RELOAD or ARM_RELOAD[arm] or 1.0
	local draw = arm_s and SPLINT_DRAW or ARM_DRAW[arm] or 1.0
	-- named reload / draw factors (engine nlc-3.589.106+ / .107+), multiplied with other factors such as an artifact bonus
	if level.nlc_set_reload_speed_factor then
		level.nlc_set_reload_speed_factor("injury", reload)
		if level.nlc_set_draw_speed_factor then
			level.nlc_set_draw_speed_factor("injury", draw)
		end
	elseif level.nlc_set_reload_speed_k then -- engine nlc-3.589.102-.105
		level.nlc_set_reload_speed_k(reload)
	end
	push_injuries()
end

-- "Thinking out loud" lines (config/text/*/script_strings.xml, nlc_injury_*), a few variants each
local THINK_COUNT = { light = 3, severe = 3, eased = 1, healed = 3, ping = 2, hit = 2, splinted = 1 }
local THINK_COLOUR = { light = "red", severe = "red", eased = "yellow", healed = "green", ping = "yellow", hit = "red", splinted = "yellow" }

local function think(zone, event)
	if not THINKING or not db.actor or not db.actor:alive() then return end
	local id = string.format("nlc_injury_%s_%s_%d", zone, event, math.random(THINK_COUNT[event] or 1))
	sak.send_tip_local(game.translate_string(id), game.translate_string("thinking_out_loud"), 0, 8, "g_g", "sak", THINK_COLOUR[event] or "yellow")
end

-- level-change lines wait THINK_DELAY_MS (not during the medkit animation); a newer change replaces
-- the waiting line, and nothing is said when the state is back where it was when the wait began
local THINK_DELAY_MS = 5000
local pending_think = {} -- zone -> { event, t, from } (from: stage() when the wait began)

local function queue_think(zone, event, old)
	local p = pending_think[zone]
	pending_think[zone] = { event = event, t = time_global() + THINK_DELAY_MS, from = p and p.from or old }
end

local function flush_think(now)
	for z, p in pairs(pending_think) do
		if now >= p.t then
			pending_think[z] = nil
			if stage(z) ~= p.from then think(z, p.event) end
		end
	end
end

local function game_min()
	return game.get_game_time():diffSec(misc.base_time()) / 60
end

-- F1 (design 3.2): a severe arm/leg is a fracture on one limb of the zone (the hit one, else the
-- weaker one); easing or curing the level clears the zone's fractures (also old engine-rolled ones)
local function set_fracture(zone, on, part)
	if not body_on() then return end
	local p = PARTS[zone]
	if on == "splint" then
		for _, n in ipairs(p) do
			local f = body_health.fracture(n)
			if f > FRACTURE_SPLINT then body_health.change_fracture(n, f - FRACTURE_SPLINT) end
		end
	elseif on then
		part = part or (body_health.part_health(p[1]) <= body_health.part_health(p[2]) and p[1] or p[2])
		if body_health.fracture(part) <= 0 then
			body_health.change_fracture(part, -FRACTURE_SET) -- a negative value adds a fracture
		end
	else
		for _, n in ipairs(p) do
			local f = body_health.fracture(n)
			if f > 0 then body_health.change_fracture(n, f) end
		end
	end
end

-- part: the hit limb ("left_leg"...) when known, for the fracture of a severe level
local function clear_splint(zone)
	splint_end[zone] = 0
	remove_value(SAVE_S[zone])
end

local function set_level(zone, lv, part)
	lv = clamp(lv, 0, 2)
	if lv == level_of[zone] then return end
	local old = level_of[zone]
	local old_stage = stage(zone)
	local worse = lv > old
	clear_splint(zone)
	level_of[zone] = lv
	-- the time cure counts from the last change, so an eased injury (severe -> light) needs its own time
	if lv > 0 then
		since_of[zone] = game_min()
		set_value(SAVE_T[zone], since_of[zone])
	else
		remove_value(SAVE_T[zone])
	end
	if lv == 2 then
		set_fracture(zone, true, part)
	elseif old == 2 then
		set_fracture(zone, false)
	end
	if old > 0 and lv == 0 then set_value("nlc_vars.injury_cured_once", true) end -- sivol_body_text: explainer off
	if worse then
		sivol_body_text.unlock_article("injury")
		queue_think(zone, lv == 2 and "severe" or "light", old_stage)
	elseif lv == 0 then
		queue_think(zone, "healed", old_stage)
	else
		queue_think(zone, "eased", old_stage)
	end
	if lv > 0 then set_value(SAVE[zone], lv) else remove_value(SAVE[zone]) end
	if lv == 0 then charge[zone], heavy_of[zone] = 0, false end
	apply_levels()
	if worse then play_pain() end
	if DEBUG then log2("[sivol_actor_crit] %s injury level %d", zone, lv) end
end

-- severe -> splinted (splint, survival kit, army medkit, or untreated for SEVERE_MIN); self: no splint was used
local function set_splint(zone, self)
	if level_of[zone] ~= 2 or splint_end[zone] > 0 then return end
	local old_stage = stage(zone)
	splint_end[zone] = game_min() + SPLINT_MIN
	set_value(SAVE_S[zone], splint_end[zone])
	set_fracture(zone, "splint")
	queue_think(zone, self and "eased" or "splinted", old_stage)
	apply_levels()
	if DEBUG then log2("[sivol_actor_crit] %s injury splinted until game minute %d", zone, splint_end[zone]) end
end

-- a severe hit on a splinted limb breaks it again
local function rebreak(zone, part)
	local old_stage = stage(zone)
	clear_splint(zone)
	since_of[zone] = game_min()
	set_value(SAVE_T[zone], since_of[zone])
	set_fracture(zone, false)
	set_fracture(zone, true, part)
	queue_think(zone, "severe", old_stage)
	apply_levels()
	play_pain()
end

-- a hit that makes the arm severe may knock the weapon out of the hand (design 36, instead of a chat line)
local ARM_DROP_CHANCE = 0.30
local function arm_shock()
	level.add_cam_effector(math.random() < 0.5 and "camera_effects\\hit_front_left.anm" or "camera_effects\\hit_front_right.anm", CAM_ID + 2, false, "")
	if math.random() >= ARM_DROP_CHANCE then return end
	local item = db.actor:active_item()
	if item and item:section() ~= "bolt" and item:section() ~= "wpn_knife" and item:get_slot() ~= 7 then
		db.actor:drop_item(item)
	end
end

-- heavy: a bullet / explosion, or a heavy mutant blow; without one in the charge, bites stop at light
local function add_charge(zone, dealt, part, heavy, t_severe)
	local ts = t_severe or T_SEVERE
	if dealt < MIN_HIT then
		if dealt < MIN_PART then return end
		dealt = dealt * 0.5
	end
	last_count_t[zone] = time_global()
	if heavy ~= false then heavy_of[zone] = true end
	charge[zone] = charge[zone] + dealt
	if not heavy_of[zone] then charge[zone] = math.min(charge[zone], ts) end -- the next heavy hit breaks
	local severe = dealt >= ONE_HIT_SEVERE or (charge[zone] >= ts and heavy_of[zone])
	local lv = severe and 2 or (charge[zone] >= T_LIGHT and 1 or 0)
	local broke = lv == 2 and (splinted(zone) or level_of[zone] < 2)
	if lv == 2 and splinted(zone) then
		rebreak(zone, part)
	elseif lv > level_of[zone] then
		set_level(zone, lv, part)
	end
	if broke and zone == "arm" then arm_shock() end
end

-- the limb of a bullet hit ("left_arm"...), nil when the bone has no side
local function limb_of(zone, bone_id)
	if zone ~= "arm" and zone ~= "leg" then return nil end
	local ok, name = pcall(db.actor.get_bone_name, db.actor, bone_id)
	if not ok or type(name) ~= "string" then return nil end
	if string.find(name, "_l_", 1, true) then return "left_" .. zone end
	if string.find(name, "_r_", 1, true) then return "right_" .. zone end
	return nil
end

local function end_concussion()
	if concussion_vol then level.set_snd_volume(concussion_vol) end
	concussion_vol, concussion_end = nil, 0
	push_injuries()
end

local next_head_think_t = 0
local function concussion(dealt, absorbed, mutant)
	if time_global() >= next_head_think_t then
		next_head_think_t = time_global() + 20000
		think("head", (absorbed >= 0.5 and db.actor:nlc_head_cover() > 0) and "ping" or "hit")
	end
	local secs = (3 + 5 * clamp(dealt / 0.6, 0, 1)) * (1 - 0.5 * db.actor:nlc_head_cover())
	if not concussion_vol then
		concussion_vol = level.get_snd_volume()
		level.set_snd_volume(concussion_vol * 0.25)
	end
	concussion_end = math.max(concussion_end, time_global() + secs * 1000)
	push_injuries()
	level.add_pp_effector("amk_shoot.ppe", 2011, false)
	if absorbed < 0.5 then
		level.add_pp_effector("black.ppe", 99, false)
	end
	-- the helmet took the round: night vision may drop out
	if absorbed >= 0.5 and db.actor:nlc_head_cover() > 0 and math.random() < 0.3 and nvd_params then
		nvd_params.disable_NVD()
	end
	-- a mutant blow to the head can knock the weapon out of the hands (old vergas behaviour)
	if mutant and math.random() < 0.10 then
		local item = db.actor:active_item()
		if item and item:section() ~= "bolt" and item:section() ~= "wpn_knife" and item:get_slot() ~= 7 then
			db.actor:drop_item(item)
		end
	end
	play_pain()
end

local function torso_impact(info)
	-- blunt trauma on chest/belly: armour stops the round, not its energy (bullets only)
	if info.type ~= hit.fire_wound or info.absorbed < 0.3 then return end
	if info.zone ~= "chest" and info.zone ~= "belly" then return end
	local loss = math.min(0.2, info.raw * info.absorbed * 0.15)
	if loss > 0.005 then
		db.actor.power = -loss -- the power setter is a delta (ChangePower)
	end
end

-- health of the zone: both arms / both legs with body health on, else the total health
local function limb_health(zone)
	if body_on() then
		local p = PARTS[zone]
		return (body_health.part_health(p[1]) + body_health.part_health(p[2])) * 0.5
	end
	return db.actor.health
end

-- time cure of a light injury: it has lasted long enough and the limb is healed enough
local function healed(zone)
	if game_min() - since_of[zone] < (CURE_MIN_MIN[level_of[zone]] or 0) then return false end
	return limb_health(zone) >= CURE_LIMB
end

local function update_injuries()
	if not db.actor:alive() then
		sivol.remove_sprint_block("crit_legs")
		return
	end
	local now = time_global()
	local dt = (now - last_decay_t) / 1000
	last_decay_t = now
	if dt > 0 and dt < 5 then
		for z, c in pairs(charge) do
			if c > 0 and now - last_count_t[z] > DECAY_GRACE_MS then
				charge[z] = math.max(0, c - DECAY_PER_S * dt)
				if charge[z] <= 0 then heavy_of[z] = false end
			end
		end
	end
	if concussion_end > 0 and now >= concussion_end then end_concussion() end
	flush_think(now)
	if now < next_cure_t then return end
	next_cure_t = now + 1000
	if applied_body ~= body_on() then apply_levels() end -- body health option switched
	push_injuries()
	local m = game_min()
	for z, lv in pairs(level_of) do
		if splinted(z) then
			if m >= splint_end[z] then set_level(z, 0) end
		elseif lv == 2 then
			if m - since_of[z] >= SEVERE_MIN then set_splint(z, true) end
		elseif lv == 1 and healed(z) then
			set_level(z, 0)
		end
	end
end

-- an army medkit splints every severe injury and clears light ones, a scientific one (also _razgr) cures them
local function medkit_cure(section)
	for prefix, n in pairs(MEDKIT_CURE) do
		if string.find(section, prefix, 1, true) == 1 then return n end
	end
	return 0
end

-- what an item does to injuries, for its description (sivol_body_text.item_rows):
-- "field" (one zone: light clears, severe splinted), "army" / 2 (light ones cleared + 1 / 2 splints), "light" (clears light ones), nil
function item_cure(section)
	if FIELD_CURE[section] then return "field" end
	local n = medkit_cure(section)
	if n == 1 then return "army" end
	if n > 0 then return n end
	if section == PLAIN_MEDKIT then return "light" end
	return nil
end

-- zone of a splint / survival kit: the arm or leg it was used on, else (or when that zone has nothing
-- to treat) the worse injury, legs first; a splinted zone needs nothing more
local function field_zone()
	local function open(z) return level_of[z] > 0 and not splinted(z) end
	local z = PART_ZONE[tonumber(body_health and body_health.use_part() or 0) or 0]
	if z and open(z) then return z end
	for _, lv in ipairs({ 2, 1 }) do
		for _, zz in ipairs({ "leg", "arm" }) do
			if open(zz) and level_of[zz] == lv then return zz end
		end
	end
	return nil
end

local function field_cure(zone)
	if level_of[zone] == 1 then
		set_level(zone, 0)
	elseif level_of[zone] == 2 then
		set_splint(zone)
	end
end

-- "on_use" (engine eUseObject) runs only for a use that went through: a use refused in
-- on_actor_before_use (disable_use) cures nothing. The chosen part is still readable here.
local function on_use(item)
	if not item then return end
	local sect = item:section()
	if FIELD_CURE[sect] then
		local z = field_zone()
		if z then field_cure(z) end
		return
	end
	local n = medkit_cure(sect)
	if n > 0 then
		-- splints first (the chosen limb, else the worst), then the light injuries left
		for _ = 1, n do
			local z = field_zone()
			if z and level_of[z] == 2 then set_splint(z) end
		end
		for z, lv in pairs(level_of) do
			if lv == 1 then set_level(z, 0) end
		end
	elseif sect == PLAIN_MEDKIT then
		for z, lv in pairs(level_of) do
			if lv == 1 then set_level(z, 0) end
		end
	end
end

-- a real sleep turns all green health white (design 14.3) and counts double for a splinted injury
-- (design 32); light ones then heal by time (sleep restores health). Severe ones need a splint.
local function on_sleep_finished(hours, was_magic)
	if was_magic or not db.actor or not db.actor:alive() then return end
	if body_on() and body_health.convert_green then body_health.convert_green("all", 1) end
	local h = tonumber(hours) or 0
	for z in pairs(level_of) do
		if splinted(z) and h > 0 then
			splint_end[z] = splint_end[z] - h * 60
			set_value(SAVE_S[z], splint_end[z])
		end
	end
end

-------------------------------------------------------------------------------
-- signals
-------------------------------------------------------------------------------
local IGNORED = {}

local function on_actor_hit(obj, amount, local_dir, who, bone_index)
	if not db.actor or not db.actor:alive() then return end
	local htype = db.actor:nlc_last_hit_type()
	if htype < 0 or IGNORED[htype] then return end
	if who and sivol_psy_phantoms and sivol_psy_phantoms.is_phantom and sivol_psy_phantoms.is_phantom(who:id()) then return end

	local raw, post, dealt = db.actor:nlc_last_hit_raw(), db.actor:nlc_last_hit_post(), db.actor:nlc_last_hit_dealt()
	local absorbed = raw > 0 and clamp(1 - post / raw, 0, 1) or 0
	local info = {
		type = htype, bone = db.actor:nlc_last_hit_bone(), zone = zone_of(db.actor:nlc_last_hit_bone()),
		raw = raw, post = post, dealt = dealt, absorbed = absorbed,
		guarded = db.actor:nlc_last_hit_guarded(), who = who,
		mutant = who and who:is_monster() or false,
	}
	-- mutant melee: injury zone by anatomy, size as a limb hit (the damage bone is the old remap)
	local pm = pending_mutant
	pending_mutant = nil
	local limb = nil -- the hit limb for a severe level's fracture; mutant zones are anatomical, no side
	local inj_k = 1.0 -- per-class injury factor of a mutant (mutant_profile), charge only
	local heavy = true -- bullets, explosions, NPC melee: the charge alone can make an injury severe
	if pm and who and pm.id == who:id() and time_global() - pm.time < 100 then
		info.zone = pm.zone
		info.dealt = mutant_limb_damage(raw, htype) * pm.k
		dealt = info.dealt
		inj_k = pm.inj
		heavy = pm.heavy
	else
		limb = limb_of(info.zone, info.bone)
	end

	-- hook for the hit-fx remake (sounds); the camera stays here
	ogse_signals.get_mgr():call("on_actor_hit_resolved", info)

	if not ENABLED or game_options.AdditionalMobHits == false then return end
	if raw < 0.03 then return end

	-- explosions (grenades, explosive anomalies) have no bone: a gentle share to the belt and the limbs
	if htype == hit.explosion then
		if sivol_belt then sivol_belt.wear(dealt * BELT_WEAR_BLAST) end
		add_charge("arm", dealt * BLAST_LIMB)
		add_charge("leg", dealt * BLAST_LIMB)
	end

	if not (info.mutant or (who and (who:is_stalker() or who:is_actor()))) and htype ~= hit.fire_wound then return end

	camera(info)
	torso_impact(info)

	local z = info.zone
	if DEBUG then
		log2("[sivol_actor_crit] %s type=%d raw=%.3f post=%.3f dealt=%.3f abs=%.2f charge arm %.2f leg %.2f",
			z, htype, raw, post, dealt, absorbed, charge.arm, charge.leg)
	end
	-- belt wear: belly hits (bullets, knives); mutant torso hits count half (the belly share of the torso)
	if sivol_belt and htype ~= hit.explosion then
		if z == "belly" and not info.mutant then
			sivol_belt.wear(dealt * BELT_WEAR)
		elseif info.mutant and (z == "chest" or z == "belly") then
			sivol_belt.wear(dealt * BELT_WEAR_MUTANT)
		end
	end
	if z == "arm" or z == "leg" then
		add_charge(z, dealt * inj_k, limb, heavy, htype == hit.fire_wound and T_SEVERE_BULLET or nil)
	elseif z == "head" then
		if dealt >= HEAD_MIN_DEALT or (absorbed >= PING_ABSORBED and raw >= PING_RAW) then
			concussion(dealt, absorbed, info.mutant)
		end
	end
end

-- console test: g_loadstring sivol_actor_crit.debug_injury("leg", 2)
-- "arm" / "leg": set level 0..2 through the normal path (messages, effects, save);
-- "head": level > 0 starts a concussion, 0 ends it
function debug_injury(zone, lv)
	lv = tonumber(lv) or 0
	if not db.actor then return end
	if zone == "arm" or zone == "leg" then
		-- 3 = severe, then splinted
		set_level(zone, math.min(lv, 2))
		if lv > 0 then charge[zone] = lv >= 2 and T_SEVERE or T_LIGHT end
		if lv >= 3 then set_splint(zone) end
	elseif zone == "head" then
		if lv > 0 then concussion(0.3, 0, false) else end_concussion() end
	else
		log2("[sivol_actor_crit] debug_injury: unknown zone %s (arm, leg, head)", tostring(zone))
		return
	end
	log2("[sivol_actor_crit] debug_injury %s %d -> arm %d leg %d head %d", zone, lv, injury_level("arm"), injury_level("leg"), injury_level("head"))
end

-- state API (watch icon): "arm" / "leg" 0..2 (splinted counts as 1), "head" 1 while a concussion runs
function injury_level(zone)
	if zone == "head" then return concussion_end > time_global() and 1 or 0 end
	if (zone == "arm" or zone == "leg") and splinted(zone) then return 1 end
	return level_of[zone] or 0
end
-- "none" / "light" / "severe" / "splinted" (arm, leg; head: "light" while a concussion runs)
function injury_state(zone)
	if zone == "head" then return concussion_end > time_global() and "light" or "none" end
	if not level_of[zone] then return "none" end
	if splinted(zone) then return "splinted" end
	return ({ [0] = "none", [1] = "light", [2] = "severe" })[level_of[zone]]
end
-- game hours until a splinted injury heals (0 when not splinted)
function splint_hours_left(zone)
	if not splinted(zone) then return 0 end
	return math.max(0, (splint_end[zone] - game_min()) / 60)
end
-- sprint factor of a splinted leg (params.refresh_sprint_koef)
function sprint_k()
	return splinted("leg") and not braced() and SPLINT_SPRINT or 1
end
function injury_charge(zone) return charge[zone] or 0 end
-- recoil multiplier of the arm injury (sivol_fuzz_recoil.script); an exo brace halves it
function recoil_k()
	local k = splinted("arm") and SPLINT_RECOIL or ARM_RECOIL[level_of.arm] or 1.0
	return braced() and brace(k) or k
end
-- re-apply the level effects (sivol_adrenaline.script at the start and end of a rush)
function refresh() apply_levels() end

local function on_update()
	update_injuries()
	update_head_cover(false)
end

local function on_spawn()
	end_concussion()
	pending_think = {}
	charge.arm, charge.leg = 0, 0
	-- injuries survive save/load: restore the saved levels and their effects
	level_of.arm = tonumber(get_value(SAVE.arm, 0)) or 0
	level_of.leg = tonumber(get_value(SAVE.leg, 0)) or 0
	-- saves from before the cure timer have no time: count the injury as old
	since_of.arm = tonumber(get_value(SAVE_T.arm, 0)) or 0
	since_of.leg = tonumber(get_value(SAVE_T.leg, 0)) or 0
	splint_end.arm = level_of.arm == 2 and tonumber(get_value(SAVE_S.arm, 0)) or 0
	splint_end.leg = level_of.leg == 2 and tonumber(get_value(SAVE_S.leg, 0)) or 0
	heavy_of.arm, heavy_of.leg = false, false
	last_decay_t = time_global()
	apply_levels()
	last_cov, last_arm = -1, -1
	update_head_cover(true)
end

function attach(sm)
	IGNORED[hit.radiation] = true
	IGNORED[hit.telepatic] = true
	IGNORED[hit.chemical_burn] = true
	sm:subscribe({ signal = "on_actor_hit", fun = on_actor_hit })
	sm:subscribe({ signal = "on_update",    fun = on_update })
	sm:subscribe({ signal = "on_spawn",     fun = on_spawn })
	sm:subscribe({ signal = "on_use",       fun = on_use })
	sm:subscribe({ signal = "on_sleep_finished", fun = on_sleep_finished })
end
