-- sivol_emp_sources.script
-- Moving EMP records are allocated once and mutated in place. Keeping numeric
-- coordinates avoids retaining a fresh engine vector from every monster update.
local sources = {}

function register(obj_id, pos, active, tier, source_type)
    if not (obj_id and pos and tier) then return end
    local src = sources[obj_id]
    if not src then
        src = {}
        sources[obj_id] = src
    end
    src.x, src.y, src.z = pos.x, pos.y, pos.z
    src.active = active and true or false
    src.tier = tier
    src.source_type = source_type or src.source_type or "poltergeist"
end

function trigger_burst(obj_id, pos, tier, source_type)
    if not (obj_id and pos and tier) then return false end
    local now = time_global()
    local src = sources[obj_id]
    if src and now < (src.burst_cooldown_until or 0) then return false end
    if not src then
        src = {}
        sources[obj_id] = src
    end
    src.x, src.y, src.z = pos.x, pos.y, pos.z
    src.active = src.active or false
    src.source_type = source_type or src.source_type or "chimera"
    src.burst_tier = tier
    src.burst_until = now + (tier.duration or 0)
    src.burst_cooldown_until = now + (tier.cooldown or 0)
    return true
end

function unregister(obj_id)
    sources[obj_id] = nil
end

function get_sources()
    return sources
end

local function on_monster_removed(obj)
    if obj then unregister(obj:id()) end
end

function attach(sm)
    sm:subscribe({signal = "on_monster_death", fun = on_monster_removed})
    sm:subscribe({signal = "on_monster_net_destroy", fun = on_monster_removed})
end
