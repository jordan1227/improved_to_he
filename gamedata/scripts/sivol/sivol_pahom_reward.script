-- sivol_pahom_reward.script
-- Pahom's reward for 2 full "Jelly" jars (pahom_full_banka_dialog). Repeatable.
-- The actor picks "Medicina" (phrase 41 -> 51, give_medicine) or "Pripasy"
-- (phrase 42 -> 52, give_supplies). Each reward is one core bundle (always)
-- plus weighted fillers, rolled from a reload-stable stream keyed by the
-- hand-in counter. Design record: docs/LOOT_RNG_DESIGN.md 6.1 and 12.
--
-- Console tests (fl):
--   sivol_pahom_reward.debug_preview("med", n)  -- log hand-in n's reward without giving it
--   sivol_pahom_reward.debug_preview("sup", n)

local COUNTER_KEY = "pahom_reward_n"

local POOLS = {
	med = {
		-- 1/3 each (decided 2026-10-27)
		core = {
			{ { "medkit_scientic", 1 } },
			{ { "medkit_army", 1 }, { "medkit", 1 } },
			{ { "medkit", 3 } },
		},
		core_weight = { 1, 1, 1 },
		filler_min = 3, filler_max = 5,
		filler = { -- section, weight
			{ "bandage",       3 },
			{ "energy_drink",  3 },
			{ "antirad",       3 },
			{ "medkit",        2 },
			{ "sleeping_pill", 1 },
		},
	},
	sup = {
		core = {
			{ { "suhpay", 2 } },
			{ { "conserva", 3 } },
			{ { "conserva", 2 }, { "vodka", 1 } },
		},
		core_weight = { 40, 35, 25 },
		filler_min = 4, filler_max = 6,
		filler = {
			{ "bread",        3 },
			{ "kolbasa",      3 },
			{ "energy_drink", 2 },
			{ "vodka",        2 },
			{ "conserva",     2 },
		},
	},
}

local function weighted(s, weights)
	local total = 0
	for _, w in ipairs(weights) do total = total + w end
	local r = s:int(1, total)
	for i, w in ipairs(weights) do
		r = r - w
		if r <= 0 then return i end
	end
	return #weights
end

-- Returns { [section] = count } for hand-in n of pool kind.
local function roll(kind, n)
	local p = POOLS[kind]
	local s = sivol_seeded_rng.new("pahom|" .. kind .. "|" .. tostring(n))
	local out = {}
	for _, it in ipairs(p.core[weighted(s, p.core_weight)]) do
		out[it[1]] = (out[it[1]] or 0) + it[2]
	end
	local fw = {}
	for i, f in ipairs(p.filler) do fw[i] = f[2] end
	for i = 1, s:int(p.filler_min, p.filler_max) do
		local sect = p.filler[weighted(s, fw)][1]
		out[sect] = (out[sect] or 0) + 1
	end
	return out
end

local function give_kind(kind)
	local n = get_value(COUNTER_KEY, 0) + 1
	set_value(COUNTER_KEY, n)
	for sect, count in pairs(roll(kind, n)) do
		sak.create_items(sect, count)
	end
end

function give_medicine() give_kind("med") end
function give_supplies() give_kind("sup") end

-- Old entry point (sak_dialog.add_nagrad_pahom); the dialog now calls the two above.
function give() give_kind("med") end

function debug_preview(kind, n)
	kind = POOLS[kind] and kind or "med"
	n = n or (get_value(COUNTER_KEY, 0) + 1)
	local parts = {}
	for sect, count in pairs(roll(kind, n)) do
		table.insert(parts, sect .. " x" .. count)
	end
	table.sort(parts)
	log2("[sivol_pahom_reward] %s hand-in %s: %s", kind, tostring(n), table.concat(parts, ", "))
end
