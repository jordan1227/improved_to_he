-- sivol_adaptive_zoom.script
--
-- Makes ADS zoom (scope_zoom_factor) track the player's FOV slider instead of being a fixed
-- absolute value.
--
-- Engine reference (confirmed from OGSR-Engine-main source, ogse_wpn_zoom_system=false path):
--   CActor::currentFOV() -> pWeapon->GetZoomFactor() * 0.75f
--   GetZoomFactor() returns m_fZoomFactor, which snaps to m_fScopeZoomFactor when ADS starts.
-- So: zoomed_camera_fov = scope_zoom_factor * 0.75, independent of g_fov (the slider) in the
-- unscoped case -- that disconnect is the bug this script fixes.
--
-- Formulas:
--   Unscoped (iron sights, no scope attached): flat FOV offset from the current slider value.
--       new_scope_zoom_factor = (current_fov - class_offset) / 0.75
--   Scoped (integrated or attached detachable scope): preserve the scope's authored
--   magnification at any slider value -- linear scale against the engine's hardcoded
--   reference FOV (67.5).
--       new_scope_zoom_factor = base_scope_zoom_factor * (current_fov / 67.5)
--
-- IMPORTANT (compounding-drift avoidance): base_scope_zoom_factor must ALWAYS come from an
-- immutable ini source, never from wpn.scope_zoom_factor itself once this script has started
-- writing to it -- that field is the runtime/native value we overwrite every ADS-enter, and
-- reading it back as a "base" would compound the adaptive formula on top of its own last
-- output. The two authoritative sources are:
--   - unscoped: the weapon's own section, e.g. [wpn_ak74]  (weapons.ltx)
--   - scoped:   the attached scope's addon section, looked up via wpn.scope_name
--               (e.g. wpn.scope_name == "wpn_addon_1pso" -> [wpn_addon_1pso] in add_scopes.ltx)
--               NOT the weapon's own section -- a scope's magnification is authored on the
--               addon, and can differ completely from the weapon's unscoped value.

sivol_weapon_zoom = sivol_weapon_zoom or {}

local function weapon_zoom_log(fmt, ...)
	if sivol_weapon and sivol_weapon.weapon_breath_diagnostics then
		log2(fmt, ...)
	end
end

local REFERENCE_FOV = 67.5 -- engine's hardcoded default g_fov (Actor.cpp)

-- First-pass classification, seeded from a filename/real-world-knowledge guess (NOT sourced
-- from an in-game class field) -- audit and correct before relying on this for balance.
local ZOOM_OFFSET_BY_CLASS = {
	pistol  = -10,
	rifle   = -5,
	smg     = -8,
	shotgun = -4,
	sniper  = -5,
	lmg     = -3,
	default = -4,
}

-- Additional temporary ADS zoom while the manual hold-breath state is active.
-- Values are absolute FOV reductions; pistols get the strongest benefit.
local HOLD_BREATH_FOV_REDUCTION = {
	pistol = 9,
	smg = 7,
	rifle = 6,
	shotgun = 5,
	sniper = 4,
	lmg = 4,
	default = 5,
}
local HOLD_ZOOM_RATE = 10.0
local HOLD_ZOOM_WRITE_EPSILON = 0.01
local HOLD_ZOOM_MIN_FOV = 2.0
-- HUD FOV is a separate, global viewmodel scale. A small narrowing makes the
-- hands/weapon follow the hold-zoom visually without taking over the user's
-- HUD-FOV setting. It uses the same ADS/optic exclusions as temporary zoom.
local HOLD_HUD_FOV_MULTIPLIER = 0.90
local HOLD_HUD_FOV_WRITE_EPSILON = 0.002
-- Do not touch the live factor while the native ADS transition is still
-- travelling towards it.  Once it has settled, CActor::currentFOV() consumes
-- CWeapon.zoom_factor every frame, so it is the correct local overlay point.
local HOLD_ZOOM_ADS_SETTLE_DELAY = 0.35

-- Audited base-section classification. These are the actual item:section() IDs from
-- gamedata/config/weapons; addon/HUD permutations are intentionally excluded.
local SECTION_TO_CLASS = {
	-- pistols
	wpn_ak74_m3 = "pistol", wpn_aps = "pistol", wpn_beretta = "pistol", wpn_beretta93 = "pistol",
	wpn_colt1911 = "pistol", wpn_desert_eagle = "pistol", wpn_eagle_m1 = "pistol", wpn_fort = "pistol",
	wpn_fort_m1 = "pistol", wpn_glock = "pistol", wpn_glock_m1 = "pistol", wpn_gungauss = "pistol",
	wpn_pb = "pistol", wpn_pm = "pistol", wpn_sig220 = "pistol", wpn_usp = "pistol",
	wpn_walther = "pistol",
	-- smgs
	wpn_aks47 = "smg", wpn_bizon = "smg", wpn_glock_m2 = "smg", wpn_mp5 = "smg",
	wpn_mp5_m1 = "smg", wpn_mp5_m2 = "smg", wpn_pp19 = "smg", wpn_ump45 = "smg",
	-- rifles / carbines
	wpn_abakan = "rifle", wpn_aek971 = "rifle", wpn_ak104 = "rifle", wpn_ak47 = "rifle",
	wpn_ak74 = "rifle", wpn_ak74_m1 = "rifle", wpn_ak74_m2 = "rifle", wpn_ak74m = "rifle",
	wpn_ak74u = "rifle", wpn_akm = "rifle", wpn_aks47_he = "rifle", wpn_fn2000 = "rifle", wpn_g36 = "rifle",
	wpn_groza = "rifle", wpn_groza_nimble = "rifle", wpn_m16a4 = "rifle", wpn_saiga12c_m2 = "rifle",
	wpn_sig550 = "rifle", wpn_soc308 = "rifle", wpn_soc308_m1 = "rifle", wpn_val = "rifle",
	wpn_val_nimble = "rifle",
	-- shotguns
	wpn_bm16 = "shotgun", wpn_bm16_full = "shotgun", wpn_hunters_toz_new = "shotgun",
	wpn_mp153 = "shotgun", wpn_mp153_m1 = "shotgun", wpn_saiga12c = "shotgun", wpn_saiga12c_m1 = "shotgun",
	wpn_spas12 = "shotgun", wpn_spas12_m1 = "shotgun", wpn_spas15 = "shotgun", wpn_spas15_m1 = "shotgun",
	wpn_toz34 = "shotgun", wpn_toz34_m1 = "shotgun", wpn_wincheaster1300 = "shotgun", wpn_mp133_full = "shotgun", wpn_winchester_m1 = "shotgun",
	-- sniper / marksman
	wpn_awm = "sniper", wpn_gauss = "sniper", wpn_gauss_auto = "sniper", wpn_m110 = "sniper",
	wpn_mosin = "sniper", wpn_mr308 = "sniper", wpn_sv98 = "sniper", wpn_svd = "sniper",
	wpn_svu = "sniper", wpn_vintorez = "sniper", wpn_vintorez_m1 = "sniper",
	-- lmgs
	wpn_ak108 = "lmg", wpn_g36c = "lmg", wpn_pkm = "lmg", wpn_pkp = "lmg", wpn_rpk = "lmg",
	wpn_rpk74 = "lmg",
	-- melee / launchers: included in the base inventory, but use the generic offset
	wpn_flame = "default", wpn_gm94 = "default", wpn_knife = "default", wpn_knife_m1 = "default",
	wpn_rg6 = "default", wpn_rpg7 = "default",
}

-- These scopes own adaptive magnification. Hold breath still stabilizes and
-- drains stamina there, but must not write an additional temporary FOV layer.
local HOLD_BREATH_ZOOM_EXCLUDED_SECTIONS = {
    wpn_binoc = true,
    wpn_sv98 = true,
    wpn_awm = true,
    wpn_toz34_m1 = true,
    wpn_gauss_auto = true,
    wpn_gauss = true,
}
local HOLD_BREATH_ZOOM_EXCLUDED_SCOPES = {
    g28_scope = true, specter = true, wpn_addon_1p78 = true,
    wpn_addon_1pso = true, wpn_addon_pe = true,
}

local function is_hold_breath_zoom_excluded(item)
    if not item or HOLD_BREATH_ZOOM_EXCLUDED_SECTIONS[item:section()] then return true end
    local section = item:section()
    local baked_scope = section and sys_ini and sys_ini:section_exist(section)
        and sys_ini:line_exist(section, "scope_respawn")
    local attached_scope = baked_scope
        or (rx_utils and rx_utils.addon_attached and rx_utils.addon_attached(item, "sc"))
    if not attached_scope then return false end

    -- `scope_name` is the actual fitted scope in this engine (and is already
    -- the source used by the adaptive scope-zoom code below). Resolve the
    -- variant INI field only when the runtime binding is unavailable.
    local weapon = item:get_weapon()
    local scope_section = weapon and weapon.scope_name
    if (not scope_section or scope_section == "") and section and sys_ini
        and sys_ini:section_exist(section) and sys_ini:line_exist(section, "scope_name") then
        scope_section = sys_ini:r_string(section, "scope_name")
    end
    return HOLD_BREATH_ZOOM_EXCLUDED_SCOPES[scope_section] == true
end

local function get_weapon_class(section)
	return SECTION_TO_CLASS[section] or "default"
end

local function get_current_fov()
	return get_console():get_float("fov") or REFERENCE_FOV
end

local function exp_step(current, target, rate, dt)
	return current + (target - current) * (1 - math.exp(-rate * dt))
end

local function clamp(value, low, high)
	return math.max(low, math.min(high, value))
end

local function is_scoped(item)
	local status = ogse_wpn_utils.get_scope_status(item)
	if status == 1 then
		return true -- integrated/fixed scope, always "on"
	elseif status == 2 then
		local flag = ogse_wpn_utils.get_scope_flag(item)
		return flag -- detachable -- only true if currently attached
	end
	return false
end

-- Uses get_float(section, param, default), the existing helper already proven working in this
-- codebase for this exact field (see sak_minigame.script / rx_ai.script) -- NOT a hand-rolled
-- ini_file()/section_exist()/line_exist() call, which silently returned nil for every weapon
-- and made recompute_scope_zoom() bail out before ever writing anything.
local function get_base_scope_zoom(item, wpn, scoped)
	if scoped then
		-- Confirmed via dsh_switch_addons.script precedent (`local scope_name = weapon.scope_name`,
		-- read off the get_weapon()-result variable, not the raw item) -- scope_name lives on wpn.
		local scope_section = wpn.scope_name
		if not scope_section or scope_section == "" then return nil end
		local v = get_float(scope_section, "scope_zoom_factor", 0)
		if v == 0 then return nil end
		return v
	else
		local section = item:section()
		local v = get_float(section, "scope_zoom_factor", 0)
		if v == 0 then return nil end
		return v
	end
end

-- Stable scope classification for systems which need magnification as a
-- gameplay input. get_camera_fov() remains at the base FOV for several scoped
-- render paths, so consumers must not infer scope power from it.
function sivol_weapon_zoom.get_controller_magnification(item)
	if not item then return 1 end
	local section = item:section()
	local scope_status = ogse_wpn_utils.get_scope_status(item)
	local baked_scope = section and sys_ini and sys_ini:section_exist(section)
		and sys_ini:line_exist(section, "scope_respawn")
	local scoped = scope_status == 1 or baked_scope
		or (scope_status == 2 and ogse_wpn_utils.get_scope_flag(item))
	if not scoped then return 1 end
	local wpn = item:get_weapon()
	if not wpn then return 1 end
	local authored_zoom
	if scope_status == 1 then
		-- Integral optics own their factor on the weapon itself. A runtime
		-- scope_name may name a render preset instead (SV-98 -> specter).
		authored_zoom = get_float(section, "scope_zoom_factor", 0)
	else
		local scope_section = wpn.scope_name
		if scope_section and scope_section ~= "" then
			authored_zoom = get_float(scope_section, "scope_zoom_factor", 0)
		end
	end
	if not authored_zoom or authored_zoom <= 0 then
		authored_zoom = get_float(section, "scope_zoom_factor", 0)
	end
	if not authored_zoom or authored_zoom <= 0 then return 1 end
	-- This is a balance magnification index derived from the authored ADS FOV:
	-- SV-98 8.5 -> 7.94x, PSO 20 -> 3.38x, 1P78 33 -> 2.05x.
	return clamp(REFERENCE_FOV / authored_zoom, 1, 10)
end

local function recompute_scope_zoom(item)
	if not item then
		return
	end
	local wpn = item:get_weapon() -- CWeapon-bound object -- only needed for the final field write
	if not wpn then
		return
	end

	local scoped = is_scoped(item)
	local base_szf = get_base_scope_zoom(item, wpn, scoped)
	if not base_szf then
		return
	end -- no ADS zoom authored for this state, nothing to do

	local fov = get_current_fov()
	local new_szf

	if scoped then
		new_szf = base_szf * (fov / REFERENCE_FOV)
	else
		local offset = ZOOM_OFFSET_BY_CLASS[get_weapon_class(item:section())] or ZOOM_OFFSET_BY_CLASS.default
		-- offset is a signed delta (e.g. pistol = -5) to ADD to fov, not a positive magnitude to
		-- subtract -- subtracting a negative offset here previously zoomed OUT instead of in
		-- (fov=95, offset=-5 gave desired_zoomed_fov=100 instead of the intended 90).
		new_szf = (fov + offset) / 0.75
	end

	-- IMPORTANT: for unscoped weapons, the actual ADS-press snap reads m_fIronSightZoomFactor,
	-- NOT m_fScopeZoomFactor (confirmed via InitAddons() source: "for weapon without any scope -
	-- scope_zoom_factor will overrider ironsight_zoom_factor" -- it overrides it ONCE at weapon
	-- load time, not on every snap). Writing scope_zoom_factor here was silently ignored by the
	-- unscoped snap. Writing zoom_factor directly (an earlier attempt) DID change the FOV but
	-- caused visible jank -- it's the live, already-snapped, in-flight value, and overwriting it
	-- after ADS has already started fights whatever camera effector already captured the old
	-- target and is mid-transition toward it. Writing iron_sight_zoom_factor instead updates the
	-- SOURCE the *next* snap reads from, never touching an in-progress transition -- costs one
	-- stale press right after weapon load (before this script has had a chance to run for that
	-- weapon), but every press after that should be clean.
	if scoped then
		wpn.scope_zoom_factor = new_szf
	else
		wpn.iron_sight_zoom_factor = new_szf
	end
end

-- Equip-time trigger: recompute the moment a weapon becomes the active item, well before any
-- possible ADS press, so even the FIRST press per weapon reads a corrected iron_sight_zoom_factor
-- instead of the raw ini default. Confirmed real signal (bind_stalker.script actor_binder:item_to_slot
-- calls self.am:call("on_item_to_slot", obj, sobj)).
local function on_item_to_slot(obj, sobj)
	if sivol_weapon and sivol_weapon.release_manual_hold_breath then
		sivol_weapon.release_manual_hold_breath("weapon changed")
	end
	recompute_scope_zoom(obj)
end

-- Edge-triggered on the aim-state transition (not-aiming -> aiming) as a secondary safety net --
-- catches FOV-slider changes made while a weapon is already equipped (on_item_to_slot alone
-- wouldn't see those). Cheap: one comparison per frame, real work only fires once per ADS-enter.
local was_aiming = false
local hold_zoom_active = false
local hold_zoom_section
local hold_zoom_weapon
local hold_zoom_base_factor
local hold_zoom_current_factor
local hold_zoom_last_written_factor
local hold_zoom_ads_started_at
local hold_zoom_exit_reason
local hold_hud_fov_active = false
local hold_hud_fov_base
local hold_hud_fov_current
local hold_hud_fov_last_written

-- Unlike set_camera_fov(), writing this active weapon factor does not change
-- the player's global FOV cvar.  The value is restored before the overlay is
-- discarded, including on an ADS exit or a weapon switch.
local function get_current_hud_fov()
	return get_console():get_float("hud_fov")
end

local function write_hold_hud_fov(value, force)
	if not force and hold_hud_fov_last_written
		and math.abs(hold_hud_fov_last_written - value) <= HOLD_HUD_FOV_WRITE_EPSILON
	then
		return
	end
	get_console():execute(string.format("hud_fov %.4f", value))
	hold_hud_fov_last_written = value
end

local function clear_hold_hud_fov(reason)
	if hold_hud_fov_active and hold_hud_fov_base then
		write_hold_hud_fov(hold_hud_fov_base, true)
		weapon_zoom_log("[weapon_hud_fov] hold HUD FOV ended (%s)", reason)
	end
	hold_hud_fov_active = false
	hold_hud_fov_base = nil
	hold_hud_fov_current = nil
	hold_hud_fov_last_written = nil
end

-- Returns true once the smooth restore has reached the captured player value.
local function update_hold_hud_fov(hold_active, strength, dt)
	if hold_active and strength > 0.001 then
		if not hold_hud_fov_active then
			local base = tonumber(get_current_hud_fov())
			if not base then return true end
			hold_hud_fov_active = true
			hold_hud_fov_base = base
			hold_hud_fov_current = base
			hold_hud_fov_last_written = nil
			weapon_zoom_log("[weapon_hud_fov] hold HUD FOV start: base=%.3f target=%.3f",
				base, base * HOLD_HUD_FOV_MULTIPLIER)
		end
		local target = clamp(hold_hud_fov_base
			* (1 - (1 - HOLD_HUD_FOV_MULTIPLIER) * strength), 0.05, 0.99)
		hold_hud_fov_current = exp_step(hold_hud_fov_current, target, HOLD_ZOOM_RATE, dt)
		write_hold_hud_fov(hold_hud_fov_current)
		return false
	end

	if not hold_hud_fov_active then return true end
	hold_hud_fov_current = exp_step(hold_hud_fov_current, hold_hud_fov_base, HOLD_ZOOM_RATE, dt)
	write_hold_hud_fov(hold_hud_fov_current)
	return math.abs(hold_hud_fov_current - hold_hud_fov_base) <= HOLD_HUD_FOV_WRITE_EPSILON
end

local function write_hold_zoom(wpn, factor)
	if hold_zoom_last_written_factor
		and math.abs(hold_zoom_last_written_factor - factor) <= HOLD_ZOOM_WRITE_EPSILON
	then
		return
	end
	wpn.zoom_factor = factor
	hold_zoom_last_written_factor = factor
end

local function clear_hold_zoom(reason)
	clear_hold_hud_fov(reason)
	if hold_zoom_active then
		if db.actor and hold_zoom_weapon and hold_zoom_base_factor then
			hold_zoom_weapon.zoom_factor = hold_zoom_base_factor
		end
		weapon_zoom_log("[weapon_zoom] hold zoom ended (%s)", reason)
	end
	hold_zoom_active = false
	hold_zoom_section = nil
	hold_zoom_weapon = nil
	hold_zoom_base_factor = nil
	hold_zoom_current_factor = nil
	hold_zoom_last_written_factor = nil
	hold_zoom_exit_reason = nil
end

-- sivol_weapon owns the state transition and calls this for every normal exit.
-- A key release keeps the authored smooth return; ADS/lifecycle exits restore
-- immediately because the native zoom effector is ending at the same time.
function sivol_weapon_zoom.on_manual_hold_breath_exit(reason, immediate)
	hold_zoom_exit_reason = reason or "hold released"
	if immediate then
		clear_hold_zoom(hold_zoom_exit_reason)
	end
end

local function update_hold_breath_zoom(actor, aiming, dt, now)
	if not actor or not aiming then
		if sivol_weapon and sivol_weapon.release_manual_hold_breath then
			sivol_weapon.release_manual_hold_breath("ADS ended", not actor, true)
		end
		-- Restore before leaving the native ADS lifecycle. This restores both
		-- temporary overlays; the player's global HUD-FOV preference is preserved.
		clear_hold_zoom("ADS ended")
		hold_zoom_ads_started_at = nil
		return
	end
	if not hold_zoom_ads_started_at then hold_zoom_ads_started_at = now end

	local item = actor:active_item()
	local wpn = item and item:get_weapon()
	local strength = sivol_weapon and sivol_weapon.get_manual_hold_breath_strength
		and sivol_weapon.get_manual_hold_breath_strength() or 0
	local hold_active = sivol_weapon and sivol_weapon.is_manual_hold_breath_active
		and sivol_weapon.is_manual_hold_breath_active() or false
	if not item or not wpn then
		clear_hold_zoom("no active weapon")
		return
	end
	-- This covers binoculars, integral optics and the explicitly excluded
	-- detachable scopes for both weapon FOV and global HUD FOV.
	if is_hold_breath_zoom_excluded(item) then
		clear_hold_zoom("scope/binocular exclusion")
		return
	end

	if hold_active and strength > 0.001 then
		if now - hold_zoom_ads_started_at < HOLD_ZOOM_ADS_SETTLE_DELAY then
			return
		end
		local normal_factor = tonumber(wpn.zoom_factor) or 0
		if normal_factor <= 0 then
			clear_hold_zoom("no native zoom FOV")
			return
		end

		local section = item:section()
		if hold_zoom_active and hold_zoom_section ~= section then
			clear_hold_zoom("weapon changed")
		end
		if not hold_zoom_active or hold_zoom_section ~= section then
			hold_zoom_active = true
			hold_zoom_section = section
			hold_zoom_weapon = wpn
			hold_zoom_base_factor = normal_factor
			hold_zoom_current_factor = normal_factor
			hold_zoom_last_written_factor = nil
			weapon_zoom_log("[weapon_zoom] hold zoom start: section=%s base=%.2f extra=%d",
				section, normal_factor * 0.75,
				HOLD_BREATH_FOV_REDUCTION[get_weapon_class(section)] or HOLD_BREATH_FOV_REDUCTION.default)
		end

		local extra = (HOLD_BREATH_FOV_REDUCTION[get_weapon_class(section)]
			or HOLD_BREATH_FOV_REDUCTION.default) * strength
		-- Never consume more than 40% of a very narrow authored scope FOV.
		local base_fov = hold_zoom_base_factor * 0.75
		local target_fov = base_fov - math.min(extra, base_fov * 0.40)
		target_fov = clamp(target_fov, HOLD_ZOOM_MIN_FOV, base_fov)
		local target_factor = target_fov / 0.75
		hold_zoom_current_factor = exp_step(hold_zoom_current_factor, target_factor, HOLD_ZOOM_RATE, dt)
		write_hold_zoom(hold_zoom_weapon, hold_zoom_current_factor)
		update_hold_hud_fov(true, strength, dt)
		return
	end

	local hud_restored = update_hold_hud_fov(false, 0, dt)
	if hold_zoom_active then
		hold_zoom_current_factor = exp_step(hold_zoom_current_factor, hold_zoom_base_factor, HOLD_ZOOM_RATE, dt)
		write_hold_zoom(hold_zoom_weapon, hold_zoom_current_factor)
		if math.abs(hold_zoom_current_factor - hold_zoom_base_factor) <= HOLD_ZOOM_WRITE_EPSILON
			and hud_restored then
			write_hold_zoom(hold_zoom_weapon, hold_zoom_base_factor)
			clear_hold_zoom(hold_zoom_exit_reason or "hold released")
		end
	elseif hud_restored then
		clear_hold_hud_fov(hold_zoom_exit_reason or "hold released")
	end
end
local function reset_hold_zoom(reason)
	clear_hold_zoom(reason)
	hold_zoom_ads_started_at = nil
	was_aiming = false
end

local function on_update(delta)
    local aiming = wpn_params.get_zie_obj() ~= nil
	local dt = tonumber(delta) or device().f_time_delta or 0.016
	if dt > 1 then dt = dt / 1000 end
	if dt <= 0 or dt > 0.20 then dt = 0.016 end
	update_hold_breath_zoom(db.actor, aiming, dt, time_global() / 1000)

    if aiming and not was_aiming then
        local slot = db.actor:active_slot()
        local item = db.actor:item_in_slot(slot)
        recompute_scope_zoom(item)
    end

    was_aiming = aiming
end

function attach(sm)
	sm:subscribe({signal = "on_update", fun = on_update})
	sm:subscribe({signal = "on_item_to_slot", fun = on_item_to_slot})
	sm:subscribe({signal = "on_first_update", fun = function() reset_hold_zoom("load/reset") end})
	sm:subscribe({signal = "on_before_save_game", fun = function() reset_hold_zoom("save") end})
	sm:subscribe({signal = "on_stop_modules", fun = function() reset_hold_zoom("net_destroy") end})
end