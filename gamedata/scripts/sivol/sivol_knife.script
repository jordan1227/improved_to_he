-- M1 knife presentation sounds. The native dinput8 hook calls this only after
-- a successful M1 show/hide HUD motion. Attack audio remains engine-owned.

local SHOW_SOUND = "weapons\\liz_knife_show"
local HIDE_SOUND = "weapons\\liz_knife_hide"
local last_event = 0
local last_time = 0
local logged = 0

local function on_knife_motion(event)
    local actor = db.actor
    if not actor or not actor:alive() then return end
    if event ~= 1 and event ~= 2 then return end

    local now = time_global()
    if event == last_event and now - last_time < 100 then return end
    last_event = event
    last_time = now

    local path = event == 1 and SHOW_SOUND or HIDE_SOUND
    local snd = xr_sound.get_safe_sound_object(path)
    if snd then
        snd:play_no_feedback(actor, sound_object.s2d, 0, vector(), 1.0)
        if logged < 4 then
            printf("[sivol_knife] played %s", path)
            logged = logged + 1
        end
    end
end

local function bind()
    last_event = 0
    last_time = 0
    logged = 0
    _G.fl_on_knife_motion = on_knife_motion
end

local function unbind()
    if _G.fl_on_knife_motion == on_knife_motion then
        _G.fl_on_knife_motion = nil
    end
end

function attach(sm)
    sm:subscribe({signal = "on_first_update", fun = bind})
    sm:subscribe({signal = "on_stop_modules", fun = unbind})
end
