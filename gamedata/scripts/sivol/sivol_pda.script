-- ============================================================================
-- MODULE: sivol_pda.script (OGSR Engine Port)
-- ============================================================================
-- OVERVIEW:
--   Manages 3D PDA visual screen noise, glitch shader effects, and ambient 
--   interference audio based on level location baselines and proximity to
--   Electra anomalies.
--
-- KEY RESPONSIBILITIES:
--   1. Calculates location-based noise baselines (static/glitch intensity).
--   2. Detects Electra proximity and overrides location noise with heavy glitch.
--   3. Smooths intensity, style mix, and blackout factors over time using 
--      exponential smoothing (SMOOTH_IN / SMOOTH_OUT).
--   4. Drives 3D PDA shader parameters via set_pda_params(vector) and controls 
--      spatial noise audio volume.
--
-- SHADER VECTOR CONTRACT (set_pda_params(x, y, z)):
--   • Vector.X = Blowout / Lamp Flicker (0.0 in this script; driven elsewhere).
--   • Vector.Y = Overall Noise Intensity (smooth: 0.0 = clean, 1.0 = maximum).
--   • Vector.Z = Alpha Mode / Shader Style Range (alpha_mode):
--                - 0.25        = 100% Glitch effect
--                - 1.20        = 100% Heavy Static effect (normal capped max)
--                - >= 1.50     = Forced PDA Screen Blackout threshold
--
-- MIX PARAMETER CONTRACT (mix / smoothed_mix):
--   • mix = 0.0 > Pure Glitch dominant
--   • mix = 0.5 > Equal Glitch / Static blend
--   • mix = 1.0 > Pure Static dominant
--   * Note: Electra proximity dynamically pulls mix towards 0.0 (Glitch).
--
-- SPECIAL FEATURES:
--   • Point-Blank Blackout: Standing near strong Electras (intensity > 0.85) 
--     smoothly pushes alpha_mode past 1.5 to temporarily cut the screen to black.
--
-- RELATED FILES & DEPENDENCIES:
--   • pda_noise.script      - Provides get_electra_intensity(), plays/stops 
--                             noise sounds, controls volume.
--   • bind_stalker.script   - Queries owns_pda_params() to allocate shader 
--                             control during stalker binder updates.
--   • const.script          - Read for const.ground_levels table to identify 
--                             underground maps automatically.
--   • amk_anoms.script      - Lower-level anomaly scanner called by pda_noise.
--   • Engine / 3D PDA Shader- Receives set_pda_params() vector values when 
--                             g_3d_pda is 'on' and device_pda is equipped.
-- ============================================================================
-- STATE VARIABLES & TIMING CONSTANTS
-- ============================================================================

-- Current exponentially smoothed total noise intensity (0.0 = clean screen, 1.0 = maximum distortion).
-- Tracks towards `target`: the strongest effective interference source
-- among Electra, artifact broadcasting, and location baseline.
-- Passed as the Y parameter in set_pda_params() and controls audio noise volume.
local smooth = 0
local smooth_non_rain = 0 -- sound-gating value only — rain must never drive audio

-- Current exponentially smoothed style blend factor (0.0 = 100% glitch, 1.0 = 100% static).
-- Electra or artifact broadcasting pulls this towards 0.0,
-- while location baselines provide the static component.
-- Maps directly into the standard shader range (0.25 to 1.20).
local smoothed_mix = 0

-- module level variable 
local cached_glitch_source = 0

-- Current exponentially smoothed blackout factor (0.0 = normal display, 1.0 = full blackout).
-- Ramps up only when standing point-blank (< 0.15 radius) near strong Electra variants.
-- Pushes the final shader alpha_mode value past 1.50 to force the screen to black.
local smoothed_blackout = 0

-- Attack speed multiplier for ramping effects UP (when intensity/glitch is increasing).
-- Higher value = faster reaction when walking into an Electra zone or noisy location.
local SMOOTH_IN = 5.0

-- Decay speed multiplier for ramping effects DOWN (when intensity/glitch is fading).
-- Lower value than SMOOTH_IN = effects linger slightly and fade out smoothly as you walk away.
local SMOOTH_OUT = 2.5

-- Stores the time_global() timestamp (in ms) from the previous update frame.
-- Used to compute frame delta time (dt) for framerate-independent smoothing calculations.
local last_time = 0

local electra_noise_muted = false -- disable glitch noise from electras specifically
local NOISE_VOLUME_SCALE = 0.62 -- volume of interference 

local cached_artifact_pda_glitch = 0   -- 0..1, strongest broadcaster present
local cached_artifact_pda_shield = 0   -- 0..1, combined shielding strength
local last_artifact_pda_check = 0
local artifact_pda_dirty = true

local function invalidate_artifact_pda_fx()
    artifact_pda_dirty = true
end

local function update_artifact_pda_fx()
    local now = time_global()
    if not artifact_pda_dirty
        and now - last_artifact_pda_check < sivol_emp_config.ARTIFACT_PDA_CHECK_INTERVAL then return end
    last_artifact_pda_check = now
    artifact_pda_dirty = false

    if not (sak and sak.arts_operate) then
        cached_artifact_pda_glitch = 0
        cached_artifact_pda_shield = 0
        return
    end

    local best_glitch = 0.0
    local total_shield = 0.0

    if sak_inventory and sak_inventory.belt_items then
        for sec, items in pairs(sak_inventory.belt_items) do
            local mod = sivol_emp_config.ARTIFACT_PDA_FX[sec]
            if not mod then
                local base_sec = string.match(sec, "^(af_[%w_]+)_dyn%dd") or sec
                mod = sivol_emp_config.ARTIFACT_PDA_FX[base_sec]
                if mod then
                    local tier_str = string.match(sec, "_dyn(%d)d")
                    if tier_str then
                        local tier = tonumber(tier_str) or 3
                        local tier_scale = (tier == 6) and 1.0 or (tier - 1) / 4
                        mod = mod * tier_scale
                    end
                end
            end
            local num_items = items and table.getn(items) or 0
            if mod and num_items > 0 then
                for m = 1, num_items do
                    local af_obj = client_obj and client_obj(items[m])
                    local cond = af_obj and af_obj:condition() or 0.0
                    local conditioned_mod = mod * cond
                    if conditioned_mod > 0 then
                        best_glitch = math.max(best_glitch, conditioned_mod)
                    elseif conditioned_mod < 0 then
                        total_shield = total_shield + (-conditioned_mod)
                    end
                end
            end
        end
    end

    cached_artifact_pda_glitch = math.min(1, best_glitch)
    cached_artifact_pda_shield = math.min(0.75, total_shield)
end

-- ======================= LOCATION PDA GLITCH SETTINGS =======================
-- Location-based baseline noise definitions 
-- mix range: 0.0 (glitch-dominant) to 1.0 (static-dominant)
local LOCATION_FX = {
    aver = { base = 0.85, mix = 0.5 },                    -- mostly static, touch of glitch
    l03u_agr_underground = { base = 0.15, mix = 0.95 },     -- mostly static. Íóæíî øòóêè ÷èòàòü 
}
local UNDERGROUND_FX = { base = 0.275, mix = 0.85 } -- Åñëè øòóêè íàäî ÷èòàòü â ëàáàõ â ÏÄÀ - íàäî óìåíüøèòü
local cached_location_base = 0
local cached_location_mix = 0
local location_cache_ready = false

function set_electra_noise_muted(v)
    electra_noise_muted = v
end

function toggle_electra_noise_muted()
    electra_noise_muted = not electra_noise_muted
    return electra_noise_muted
end

-- Returns location baseline (intensity base 0..1, mix float 0..1)
local function get_location_baseline()
    if location_cache_ready then
        return cached_location_base, cached_location_mix
    end
    local lvl_name = string.lower(level.name())
    if LOCATION_FX[lvl_name] then
        cached_location_base = LOCATION_FX[lvl_name].base
        cached_location_mix = LOCATION_FX[lvl_name].mix
    elseif const.ground_levels and const.ground_levels[lvl_name] == false then
        cached_location_base = UNDERGROUND_FX.base
        cached_location_mix = UNDERGROUND_FX.mix
    end
    location_cache_ready = true
    return cached_location_base, cached_location_mix
end

-- Expose current effective intensity for 2D UI / external queries
function get_smooth()
    return smooth
end

function get_glitch_intensity()
    return cached_glitch_source
end

function get_artifact_shield()
    return cached_artifact_pda_shield or 0
end

function electra_active()
    return smooth > 0.01
end

local function is_emission_active()
    if db and db.blowout_active == true then return true end
    local value = get_value( "blowout", 0 )
    if type( value ) == "boolean" then return value end
    return ( tonumber( value ) or 0 ) ~= 0
end

-- Tier state is authoritative during the asynchronous model conversion too.
function emission_resistant()
    return he_pda_access.has_upgrade() and he_pda_model.get_pda() ~= nil
end

-- Both shader writers must choose the same mode; alpha >= 0.25 keeps the live screen.
function emission_shader_params()
    if emission_resistant() then
        return 0.0, sivol_emp_config.UPGRADED_PDA_EMISSION_INTERFERENCE, 0.25
    end
    return 0.4, 0.5, 0.0
end

function reception_blocked()
    if is_emission_active() and not emission_resistant() then return true, "emission" end
    if sivol_critical_malfunction and sivol_critical_malfunction.is_device_active
        and sivol_critical_malfunction.is_device_active( "pda" ) then
        return true, "critical_pda"
    end

    return false, nil
end

function screen_locked()
    return db and db.actor and (db.actor:has_info("pda_is_broken")
        or sivol_critical_malfunction.is_device_active("pda")) or false
end

-- Helper: Check if 3D PDA is in player's hands and active (not holstering)
local function is_pda_in_hands()
    local active_item = db.actor:active_item()
    if not active_item then return false end

    local section = active_item:section()
    if not (section == "device_pda" or string.find(section, "device_pda") ~= nil) then
        return false
    end

    -- OGSR CHudItem State Check:
    -- 0 = eIdle, 1 = eShowing, 2 = eHiding, 3 = eHidden
    -- If the PDA is in the middle of playing its holster animation (state 2 or 3), treat as holstered immediately.
    if active_item.get_state then
        local state = active_item:get_state()
        if state == 2 or state == 3 then
            return false
        end
    end

    return true
end

-- Expose ownership check for bind_stalker / binder_update_7
function owns_pda_params()
    if not db.actor then return false end
    local pda = he_pda_model.get_pda()
    local is_3d_pda = get_console():get_string("g_3d_pda") == 'on'
    local broken = has_alife_info("pda_is_broken")
    
    if not (pda and (pda:condition() > 0 or broken) and is_pda_in_hands() and is_3d_pda) then
        return false
    end

    update_artifact_pda_fx()
    return true
end

-- ======================= RAIN AMBIENT STATIC (conservative, flavor only) =======================
local RAIN_MAX_INTENSITY = 0.075   -- deliberately low — should never compete with Aver's 0.85 baseline
local RAIN_MIX = 0.99             -- near-pure static: physical/moisture origin, not data corruption like electra
local RAIN_CHECK_INTERVAL = 1000
local last_rain_check = 0
local cached_rain_intensity = 0
local pda_shader_params = vector()
local emp_signal_mgr
local lesser_emp_eligible = false
local next_lesser_emp_event = 0

local function update_rain_baseline()
    local now = time_global()
    if now - last_rain_check < RAIN_CHECK_INTERVAL then return end
    last_rain_check = now

    if not (sivol_rain and sivol_rain.get_intensity) then
        cached_rain_intensity = 0
        return
    end
    cached_rain_intensity = (sivol_rain.get_intensity() or 0) * RAIN_MAX_INTENSITY
end
--  =======================

local function update_lesser_emp_event(intensity, source_type)
    local cfg = sivol_emp_config.TORCH_MALFUNCTION
    local now = time_global()

    if lesser_emp_eligible then
        if intensity < cfg.reset_threshold then
            lesser_emp_eligible = false
            next_lesser_emp_event = 0
            return
        end
    elseif intensity >= cfg.threshold then
        lesser_emp_eligible = true
        next_lesser_emp_event = now + math.random(cfg.min_interval, cfg.max_interval)
    else
        return
    end

    if sivol_critical_malfunction and sivol_critical_malfunction.is_active() then return end
    if now < next_lesser_emp_event then return end

    next_lesser_emp_event = now + math.random(cfg.min_interval, cfg.max_interval)
    local kind = (math.random() < cfg.off_chance) and "shutdown" or "dropout"
    if emp_signal_mgr then
        emp_signal_mgr:call("on_emp_malfunction", kind, intensity, source_type)
    end
end

local function check_electra_proximity()
    if not db.actor then return end

    local now = time_global()
    local dt = (now - last_time) / 1000
    last_time = now
    if dt > 1 or dt < 0 then dt = 0 end

    -- 1. Get targets (Electra/artifact glitch vs. Location/rain ambient baseline)
	local electra_target, is_strong, source_type = 0, false, nil
	if pda_noise and pda_noise.get_electra_intensity then
		electra_target, is_strong, source_type = pda_noise.get_electra_intensity()
	end

    local loc_base, loc_mix = get_location_baseline()

    update_artifact_pda_fx()
    update_rain_baseline()

    local shield = cached_artifact_pda_shield or 0
    local artifact_glitch = cached_artifact_pda_glitch or 0
    local hit_glitch = (sivol_critical_malfunction and sivol_critical_malfunction.get_hit_glitch_intensity()) or 0

    local electra_eff = electra_target * (1 - shield)

	if sivol_critical_malfunction then
		sivol_critical_malfunction.try_roll(is_strong, electra_eff, shield, source_type)
	end

    local ambient_base = math.max(loc_base, cached_rain_intensity)
    local ambient_mix  = (cached_rain_intensity > loc_base) and RAIN_MIX or loc_mix
    local loc_base_eff = ambient_base * (1 - shield)

    local glitch_source = math.max(electra_eff, artifact_glitch, hit_glitch)
    cached_glitch_source = glitch_source
    update_lesser_emp_event(glitch_source, source_type)
    -- Keep shared torch/NVD exposure above unchanged; attenuate only the PDA response.
    local pda_resistance = he_pda_access.upgraded_emp_resistance()
    glitch_source = glitch_source * (1 - pda_resistance)
    electra_eff = electra_eff * (1 - pda_resistance)
    local target = math.max(glitch_source, loc_base_eff)

    -- Sound-gating target excludes rain — location baseline and glitch sources only
    local loc_base_eff_no_rain = loc_base * (1 - shield)
    local target_no_rain = math.max(glitch_source, loc_base_eff_no_rain)

    -- 2. Determine target mix value
    local target_mix
    if target <= 0.001 then
        target_mix = ambient_mix
    elseif glitch_source >= loc_base_eff then
        local glitch_share = math.min(
            1,
            glitch_source / math.max(target, 0.0001)
        )
        target_mix = ambient_mix * (1 - glitch_share)
    else
        target_mix = ambient_mix
    end

    -- 3. Blackout target for point-blank Strong Electras (> 0.85 intensity)
    local blackout_target = 0
	-- sivol_pda.script blackout block
	if is_strong and electra_eff > sivol_emp_config.BLACKOUT_START then
		blackout_target = math.min(1, (electra_eff - sivol_emp_config.BLACKOUT_START) / sivol_emp_config.BLACKOUT_BAND)
	end

    -- 4. Exponential smoothing for intensity, mix, and blackout
    local rate = (target > smooth) and SMOOTH_IN or SMOOTH_OUT
    local k = math.min(1, dt * rate)

    local rate_nr = (target_no_rain > smooth_non_rain) and SMOOTH_IN or SMOOTH_OUT
    local k_nr = math.min(1, dt * rate_nr)
    smooth_non_rain = smooth_non_rain + (target_no_rain - smooth_non_rain) * k_nr
    if smooth_non_rain < 0.001 then smooth_non_rain = 0 end
    if smooth_non_rain > 1 then smooth_non_rain = 1 end

    smooth = smooth + (target - smooth) * k
    smoothed_mix = smoothed_mix + (target_mix - smoothed_mix) * k
    smoothed_blackout = smoothed_blackout + (blackout_target - smoothed_blackout) * k

    if smooth < 0.001 then smooth = 0 end
    if smooth > 1 then smooth = 1 end

    if smoothed_mix < 0 then smoothed_mix = 0 end
    if smoothed_mix > 1 then smoothed_mix = 1 end

    if smoothed_blackout < 0 then smoothed_blackout = 0 end
    if smoothed_blackout > 1 then smoothed_blackout = 1 end

    -- 5. Map values to shader alpha_mode parameter
    local base_alpha = 0.25 + smoothed_mix * (1.2 - 0.25)
    local alpha_mode = base_alpha + smoothed_blackout * (1.55 - base_alpha)

	-- 6. Validation for driving audio and shader
    local pda = he_pda_model.get_pda()
    local is_3d_pda = get_console():get_string("g_3d_pda") == 'on'
    local pda_in_hands = is_pda_in_hands()
    local broken = has_alife_info("pda_is_broken")

    local can_drive = pda and pda_in_hands and is_3d_pda and (pda:condition() > 0 or broken)
    local emission = is_emission_active()

    if can_drive then
        if screen_locked() then
            pda_noise.stop_noise_sound()  -- dead silence reads more "broken" than more static
            set_pda_params(pda_shader_params:set(0.0, 1.0, 1.55))  -- same ceiling as the existing electra blackout
        elseif emission then
            set_pda_params(pda_shader_params:set(emission_shader_params()))
            if has_alife_info("ui_pda") then
                pda_noise.play_noise_sound()
                if emission_resistant() then
                    pda_noise.set_noise_volume((0.1 + 0.4 * sivol_emp_config.UPGRADED_PDA_EMISSION_INTERFERENCE) * NOISE_VOLUME_SCALE)
                end
            else
                pda_noise.stop_noise_sound()
            end
        else
            if smooth_non_rain > 0.01 and not electra_noise_muted then
                pda_noise.play_noise_sound()
                pda_noise.set_noise_volume((0.1 + 0.4 * smooth_non_rain) * NOISE_VOLUME_SCALE)
            else
                pda_noise.stop_noise_sound()
            end
            set_pda_params(pda_shader_params:set(0.0, smooth, alpha_mode))
        end
    else
        pda_noise.stop_noise_sound()
    end
end

function attach(sm)
    emp_signal_mgr = sm
    sm:subscribe({
        signal = "on_update",
        fun = check_electra_proximity
    })
    sm:subscribe({signal = "on_spawn", fun = function()
        artifact_pda_dirty = true
        location_cache_ready = false
        cached_location_base, cached_location_mix = 0, 0
        lesser_emp_eligible = false
        next_lesser_emp_event = 0
    end})
    sm:subscribe({signal = "on_item_to_belt", fun = invalidate_artifact_pda_fx})
    sm:subscribe({signal = "on_item_to_ruck", fun = invalidate_artifact_pda_fx})
    sm:subscribe({signal = "on_item_to_slot", fun = invalidate_artifact_pda_fx})
    sm:subscribe({signal = "on_drop_after_all", fun = invalidate_artifact_pda_fx})
end
