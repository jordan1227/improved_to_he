-- =============================================================================
-- BLOOD POOLS CONFIGURATION
-- =============================================================================

local settings = {
    -- How long (in seconds) the fully grown pool stays on the ground before disappearing.
    -- (Note: The engine's wallmark TTL handles the actual fading, this just dictates logic).
    pool_lifetime  = 200,
    
    -- How many times the pool updates/grows from start to finish.
    -- 80 updates makes the growth very smooth and gradual.
    num_of_updates = 90,
    
    -- Time in seconds between each growth update.
    -- 0.06 seconds means a pool fully grows in ~4.8 seconds (80 * 0.06).
    update_freq    = 0.07,
    
    -- The maximum radius/size of a blood pool at its final stage of growth.
    -- Increase this to make pools generally larger for everyone.
    max_pool_size  = 1.2,
}

-- The number of available blood pool textures in the engine (wm_blood_pool_1 to 24)
local pool_textures = 24

-- How long (in seconds) to wait after an NPC dies before starting the blood pool.
-- This allows time for the ragdoll to settle on the ground.
local pool_starts_in = 5

-- How far downward (in meters) to scan from the body's bone to find the floor.
-- If pools are appearing floating in the air, increase this. 
local pool_trace_dist = 3.0

-- =============================================================================

local function vecSimilar(v1, v2, eps)
	eps = eps or 0.4
	local abs = math.abs
	return abs(v1.x - v2.x) < eps and abs(v1.y - v2.y) < eps and abs(v1.z - v2.z) < eps
end

local enable_debug = false
local function printf(...)
	if enable_debug then
		_G.printf(...)
	end
end

local pool_size_mult = {
    [clsid.actor]            = 0.6,  
    [clsid.script_stalker]   = 0.6,  
	[clsid.dog_s]             = 0.35,
	[clsid.pseudodog_s]       = 0.45,
	[clsid.psy_dog_s]         = 0.45,
	[clsid.boar_s]            = 0.7,
	[clsid.flesh_s]           = 0.85,
	[clsid.bloodsucker_s]     = 0.65,
	[clsid.snork_s]           = 0.5,
	[clsid.tushkano_s]        = 0.1,
	[clsid.zombie_s]          = 0.15,
	[clsid.gigant_s]          = 1.1,
	[clsid.chimera_s]         = 0.95,
	[clsid.burer_s]           = 0.5,
	[clsid.controller_s]      = 0.6,
	[clsid.cat_s]             = 0.3,
	-- not in your creatures_clslist/monster_classes, so unconfirmed -- kept as a guess since
	-- rat is a stock SoC critter type; drop this line if it's wrong or you don't want it
	-- poltergeist has no entry here on purpose: it wasn't in the original Anomaly table at all
	-- (no prior multiplier to carry over), and it's non-corporeal -- worth deciding whether it
	-- should leave a blood pool at all before giving it one. Unlisted monsters just fall back
	-- to the default multiplier of 1 below, so it's not broken, just unconsidered.
}

local boneList = {
	"bip01_spine",
	"bip01_spine1",
	"spine",
	"spine1",
}

local function getBloodPoolPos(obj)
	for _, v in ipairs(boneList) do
		if obj:get_bone_id(v) ~= 65535 then
			return obj:bone_position(v)
		end
	end
	return obj:position():add(vector():set(0, 0.5, 0))
end

local saved_pool = {}

local function start_blood_pool(id)
	local obj = level.object_by_id(id)
	if not obj then return end

	local pos = getBloodPoolPos(obj)
	saved_pool[id] = {}
	saved_pool[id].pos = pos
	saved_pool[id].moved = false
	saved_pool[id].size_mult = 1
	saved_pool[id].tex = math.random(1, pool_textures)

	if IsMonster(obj) then
		saved_pool[id].size_mult = pool_size_mult[obj:clsid()] or 1
	end

	local function draw_pool(size, npc_id, i, size_i)
		local npc = level.object_by_id(npc_id)

		if not npc or i >= settings.num_of_updates then
			saved_pool[npc_id] = nil
			return true
		end

		if not saved_pool[npc_id] then
			return true
		end

		local function genNextEvent()
			size_i = size_i + 1
			i = i + 1
			dsh.timeout(settings.update_freq * 1000, function() draw_pool(size, id, i, size_i) end)
		end

		local pos = getBloodPoolPos(npc)
		if saved_pool[npc_id].moved then
			if vecSimilar(saved_pool[npc_id].pos, pos, 0.01) then
				printf("body %s settled", npc_id)
				saved_pool[npc_id].moved = false
				saved_pool[npc_id].pos = pos
				size_i = 1
			else
				printf("body %s still moving", npc_id)
				size_i = settings.num_of_updates * 0.08
				saved_pool[npc_id].pos = pos
			end
		else
			if not vecSimilar(saved_pool[npc_id].pos, pos) then
				printf("body %s is moved", npc_id)
				saved_pool[npc_id].moved = true
				saved_pool[npc_id].pos = pos
				genNextEvent()
				return true
			end
		end

		local vec_pos = vector():set(
			saved_pool[npc_id].pos.x,
			saved_pool[npc_id].pos.y + 1,
			saved_pool[npc_id].pos.z
		)
		local t = size_i / settings.num_of_updates
		if t > 1 then t = 1 end
		size = t * saved_pool[npc_id].size_mult * settings.max_pool_size
		get_console():execute(string.format("bpm %f %f %f %f %f %d",
			vec_pos.x, vec_pos.y, vec_pos.z, pool_trace_dist, size, saved_pool[npc_id].tex))

		genNextEvent()
		return true
	end

	local i = 1
	local size_i = 1
	local size = (size_i / settings.num_of_updates) * settings.max_pool_size
	dsh.timeout(pool_starts_in * 1000, function() draw_pool(size, id, i, size_i) end)
	return true
end

local function on_death_callback(npc)
	local npc_id = npc:id()
	dsh.timeout(3000, function() start_blood_pool(npc_id) end)
end

local actor_was_alive = true

local function on_update()
	if not db.actor then return end
	local alive = db.actor:alive()
	if actor_was_alive and not alive then
		printf("actor died, spawn pool")
		on_death_callback(db.actor)
	end
	actor_was_alive = alive
end

function attach(sm)
	sm:subscribe({signal = "on_npc_death", fun = on_death_callback})
	sm:subscribe({signal = "on_monster_death", fun = on_death_callback})
	sm:subscribe({signal = "on_update", fun = on_update})
end
