local body_server_id
local body_section
local body_level_name
local body_present = false
local desired_body_section
local policy_dirty = true
local module_ready = false
local spawn_retry_at = 0
local active_body_binder
local last_body_enabled

local function visible_body_enabled()
	return not game_options or game_options.VisibleBody ~= false
end

local function diagnostic_log(format, ...)
	if DIAGNOSTICS then
		log2("[VISIBLE_BODY_DIAG] " .. format, ...)
	end
end

local function diagnostic_name(obj)
	if obj and type(obj.name) == "function" then
		return obj:name()
	end
	return "<none>"
end

local function diagnostic_relation(from, to)
	if from and to and type(from.relation) == "function" then
		return from:relation(to)
	end
	return -1
end

local function diagnostic_relation_name(relation)
	if relation == game_object.enemy then
		return "enemy"
	elseif relation == game_object.friend then
		return "friend"
	elseif relation == game_object.neutral then
		return "neutral"
	end
	return tostring(relation)
end

local function diagnostic_memory_contains(npc, method_name, target_id)
	local method = npc and npc[method_name]
	if type(method) ~= "function" then
		return false
	end
	for record in method(npc) do
		local remembered = record:object()
		if remembered and remembered:id() == target_id then
			return true
		end
	end
	return false
end

local function legs_table()
	if se_legs then
		return se_legs.LegsTbl
	end
	return nil
end

local function current_level_name()
	if level and level.name then
		return level.name()
	end
	return nil
end

local function read_actor_body_state(actor)
	if not actor or type(actor.get_body_state) ~= "function" then
		return nil
	end

	local ok, state = pcall(actor.get_body_state, actor)
	if ok and type(state) == "number" then
		return state
	end
	return nil
end

local function actor_body_state(actor)
	-- This is the original addon's packed movement-state source. It is not
	-- declared in every lua_help build, so keep it capability-gated.
	if level and type(level.actor_moving_state) == "function" then
		local ok, state = pcall(level.actor_moving_state)
		if ok and type(state) == "number" then
			return state
		end
	end

	-- db.actor is a generic CGameObject wrapper in this build. The native
	-- CActor wrapper returned by get_actor_obj() may expose the same method.
	local state = read_actor_body_state(actor)
	if state ~= nil then
		return state
	end
	if type(get_actor_obj) == "function" then
		local ok, actor_obj = pcall(get_actor_obj)
		if ok then
			state = read_actor_body_state(actor_obj)
			if state ~= nil then
				return state
			end
		end
	end

	-- Last-resort fallback for wrappers that expose only actor predicates.
	-- Directional bits are unavailable here, so a moving actor is treated as
	-- moving forward; the native packed-state paths above preserve strafing,
	-- backward movement, jumping, climbing, and lookout flags.
	state = 0
	local function predicate(name)
		if type(actor[name]) ~= "function" then
			return false
		end
		local ok, value = pcall(actor[name], actor)
		return ok and value == true
	end

	if predicate("is_actor_crouch") or predicate("is_actor_crouching") then
		state = state + 16
	end
	if predicate("is_actor_creep") or predicate("is_actor_creeping") then
		state = state + 32
	end
	if predicate("is_actor_climb") or predicate("is_actor_climbing") then
		return state + 2048
	end
	if predicate("is_actor_sprinting") then
		return state + 1 + 4096
	end
	if predicate("is_actor_running") or predicate("is_actor_walking") or predicate("is_actor_moving") then
		return state + 1
	end
	return state
end

local function refresh_policy()
	local actor = db and db.actor
	if not visible_body_enabled() then
		desired_body_section = nil
		policy_dirty = false
		return
	end
	if not actor then
		desired_body_section = nil
		policy_dirty = false
		return
	end

	local outfit = actor:item_in_slot(6)
	if not outfit then
		desired_body_section = BODY_NO_OUTFIT
	else
		local section = outfit:section()
		if section == "without_outfit" then
			desired_body_section = BODY_NO_OUTFIT
		else
			desired_body_section = outfit_to_body[section]
		end
	end

	policy_dirty = false
end

local function can_show_body()
	local actor = db and db.actor
	if not actor or not actor:alive() then
		return false
	end

	local level_vertex = actor:level_vertex_id()
	local game_vertex = actor:game_vertex_id()
	if level_vertex == nil or game_vertex == nil or level_vertex < 0 or game_vertex < 0 then
		return false
	end

	local dev = device()
	if not dev or not dev.cam_pos or not dev.cam_dir then
		return false
	end

	local actor_pos = actor:position()
	local cam_pos = dev.cam_pos
	local dx = cam_pos.x - actor_pos.x
	local dy = cam_pos.y - actor_pos.y
	local dz = cam_pos.z - actor_pos.z
	if dx * dx + dy * dy + dz * dz > HIDE_DISTANCE_SQ then
		return false
	end

	local camera = actor_camera(0)
	if not camera or not camera.position or not camera.direction then
		return false
	end

	local standard_pos = camera.position
	local standard_dir = camera.direction
	local cdx = standard_pos.x - cam_pos.x
	local cdy = standard_pos.y - cam_pos.y
	local cdz = standard_pos.z - cam_pos.z
	if cdx * cdx + cdy * cdy + cdz * cdz > CAMERA_DISTANCE_SQ then
		return false
	end

	local dot = standard_dir.x * dev.cam_dir.x
		+ standard_dir.y * dev.cam_dir.y
		+ standard_dir.z * dev.cam_dir.z
	return dot >= CAMERA_DIRECTION_DOT
end

-- Engine: the actor model's shadow is suppressed while the puppet is shown
-- (the puppet casts its own, correctly animated one). Older exes lack this.
local shadow_flag, shadow_id = nil, nil
local function report_body_active(active, id)
	id = active and id or 65535
	if shadow_flag == active and shadow_id == id then
		return
	end
	shadow_flag, shadow_id = active, id
	if level and level.nlc_visible_body_active then
		level.nlc_visible_body_active(active, id)
	end
end

local function clear_body_state()
	body_server_id = nil
	body_section = nil
	body_level_name = nil
	body_present = false
end

local function release_body()
	local id = body_server_id
	local map = legs_table()
	if not id and map and body_level_name then
		id = map[body_level_name]
	end

	if id then
		diagnostic_log("release id=%s section=%s", tostring(id), tostring(body_section))
		local sim = alife()
		if sim then
			local server_body = sim:object(id)
			if server_body then
				sim:release(server_body, true)
			end
		end

		if map and body_level_name and map[body_level_name] == id then
			map[body_level_name] = nil
		end
	end

	clear_body_state()
end

local function adopt_existing_body()
	local map = legs_table()
	local level_name = current_level_name()
	if not map or not level_name then
		return false
	end

	local id = map[level_name]
	if not id then
		return false
	end

	local sim = alife()
	local server_body = sim and sim:object(id)
	if not server_body then
		if map[level_name] == id then
			map[level_name] = nil
		end
		return false
	end

	body_server_id = id
	body_section = server_body:section_name()
	body_level_name = level_name
	body_present = true
	return true
end

local function spawn_body()
	if not desired_body_section then
		return false
	end

	local actor = db and db.actor
	local sim = alife()
	local level_name = current_level_name()
	if not actor or not actor:alive() or not sim or not level_name then
		spawn_retry_at = time_global() + 1000
		return false
	end

	local level_vertex = actor:level_vertex_id()
	local game_vertex = actor:game_vertex_id()
	if level_vertex == nil or game_vertex == nil or level_vertex < 0 or game_vertex < 0 then
		spawn_retry_at = time_global() + 1000
		return false
	end

	local created = sim:create(desired_body_section, actor:position(), level_vertex, game_vertex)
	if not created or not created.id then
		spawn_retry_at = time_global() + 1000
		return false
	end

	body_server_id = created.id
	body_section = desired_body_section
	body_level_name = level_name
	body_present = true
	spawn_retry_at = 0
	diagnostic_log("spawn id=%d section=%s level=%s", body_server_id, body_section, body_level_name)
	return true
end

local function reconcile_body()
	local enabled = visible_body_enabled()
	if enabled ~= last_body_enabled then
		last_body_enabled = enabled
		policy_dirty = true
	end

	if policy_dirty then
		refresh_policy()
	end

	local visible = can_show_body()
	if not visible or not desired_body_section then
		if body_present then
			release_body()
		end
		return
	end

	if body_present and body_section ~= desired_body_section then
		release_body()
	end

	if not body_present then
		local now = time_global()
		if spawn_retry_at == 0 or now >= spawn_retry_at then
			spawn_body()
		end
	end
end

local function on_init_modules()
	clear_body_state()
	desired_body_section = nil
	policy_dirty = true
	module_ready = false
	spawn_retry_at = 0
end

local function on_first_update()
	module_ready = true
	policy_dirty = true
	refresh_policy()

	local visible = can_show_body()
	if adopt_existing_body() then
		if not visible or not desired_body_section or body_section ~= desired_body_section then
			release_body()
		end
	end

	if visible and desired_body_section and not body_present then
		spawn_body()
	end
end

local function on_item_change()
	policy_dirty = true
	spawn_retry_at = 0
end

local function on_before_save_game()
	release_body()
	spawn_retry_at = 0
end

local function on_stop_modules()
	release_body()
	clear_body_state()
	module_ready = false
	spawn_retry_at = 0
end

local function on_update()
	if module_ready then
		reconcile_body()
	end
	local puppet = active_body_binder and active_body_binder.object
	report_body_active(body_present and puppet ~= nil, puppet and puppet:id() or 65535)
	if DIAGNOSTICS and body_present and active_body_binder then
		active_body_binder:diagnostic_scan(time_global())
	end
end

class "visible_body_binder" (object_binder)

-- turn: "left"/"right" while the legs step around a standing actor, else nil.
-- force_slow: moving bits say run but the measured speed is walk-like.
-- force_still: moving bits are held but the actor is not actually moving.
local function animation_for_state(state, turn, force_slow, force_still)
	if bit_and(state, 64) ~= 0 then
		state = state - 64
	end
	if bit_and(state, 8192) ~= 0 then
		state = state - 8192
	end
	if bit_and(state, 16384) ~= 0 then
		state = state - 16384
	end

	if bit_and(state, 2048) ~= 0 then
		if bit_and(state, 1) ~= 0 or bit_and(state, 2) ~= 0 then
			return "leg_ladder_up"
		end
		return "leg_ladder_idle"
	end

	local crouch = bit_and(state, 16) ~= 0
	local slow = bit_and(state, 32) ~= 0 or force_slow == true
	local jump_start = bit_and(state, 128) ~= 0
	local jump_idle = bit_and(state, 256) ~= 0
	local jump_end = bit_and(state, 512) ~= 0 or bit_and(state, 1024) ~= 0
	if jump_start or jump_idle or jump_end then
		if jump_start then
			if crouch and slow then
				return "lancew_legs_jump_start_sc"
			end
			return "lancew_legs_jump_start"
		end
		if jump_idle then
			if crouch and slow then
				return "lancew_legs_jump_idle_sc"
			end
			if crouch or slow then
				return "lancew_legs_jump_idle_c"
			end
			return "lancew_legs_jump_idle"
		end
		return "lancew_legs_jump_end"
	end

	local forward = bit_and(state, 1) ~= 0
	local back = bit_and(state, 2) ~= 0
	local left = bit_and(state, 4) ~= 0
	local right = bit_and(state, 8) ~= 0
	if force_still then
		forward, back, left, right = false, false, false, false
	end

	if forward and bit_and(state, 4096) ~= 0 then
		if left then
			return "lancew_legs_sprint_left"
		elseif right then
			return "lancew_legs_sprint_right"
		end
		return "lancew_legs_sprint"
	end

	if forward then
		if slow and crouch then
			return "lancew_legs_walk_sc"
		elseif slow then
			return "lancew_legs_walk"
		elseif crouch then
			return "lancew_legs_moving_c"
		elseif left then
			return "lancew_legs_moving_fl"
		elseif right then
			return "lancew_legs_moving_fr"
		end
		return "lancew_legs_moving"
	end

	if back then
		if slow and crouch then
			return "lancew_legs_walk_b_sc"
		elseif slow then
			return "lancew_legs_walk_b"
		elseif crouch then
			return "lancew_legs_moving_b_c"
		elseif left then
			return "lancew_legs_moving_bl"
		elseif right then
			return "lancew_legs_moving_br"
		end
		return "lancew_legs_moving_b"
	end

	if left then
		if slow and crouch then
			return "lancew_legs_walk_l_sc"
		elseif slow then
			return "lancew_legs_walk_l"
		elseif crouch then
			return "lancew_legs_moving_l_c"
		end
		return "lancew_legs_moving_l"
	end

	if right then
		if slow and crouch then
			return "lancew_legs_walk_r_sc"
		elseif slow then
			return "lancew_legs_walk_r"
		elseif crouch then
			return "lancew_legs_moving_r_c"
		end
		return "lancew_legs_moving_r"
	end

	if turn and not crouch then
		local left_clip = turn == "left"
		if TURN_CLIP_SWAP then
			left_clip = not left_clip
		end
		if TURN_USE_WALK_CLIPS then
			return left_clip and "lancew_legs_walk_l" or "lancew_legs_walk_r"
		end
		return left_clip and "lancew_legs_turn_left" or "lancew_legs_turn_right"
	end
	if slow and crouch then
		return "lancew_legs_idle_sc"
	elseif crouch then
		return "lancew_legs_idle_c"
	end
	return "lancew_legs_idle"
end

-- Rotates the unit XZ vector a toward b by at most max_step radians. Returns
-- the new unit vector and the signed remaining angle (> 0: b is to the right
-- of a, X-Ray's left-handed X right / Z forward).
local function rotate_toward(ax, az, bx, bz, max_step)
	local dot = ax * bx + az * bz
	local cross = az * bx - ax * bz
	local angle = math.atan2(cross, dot)
	if math.abs(angle) <= max_step then
		return bx, bz, 0
	end
	local step = angle > 0 and max_step or -max_step
	local c, s = math.cos(step), math.sin(step)
	local nx = ax * c + az * s
	local nz = az * c - ax * s
	local length = math.sqrt(nx * nx + nz * nz)
	return nx / length, nz / length, angle - step
end

local function signed_angle(ax, az, bx, bz)
	return math.atan2(az * bx - ax * bz, ax * bx + az * bz)
end

function visible_body_binder:__init(obj)
	super(obj)
	active_body_binder = self
	if db and db.storage then
		db.storage[obj:id()] = db.storage[obj:id()] or {}
	end
	-- This monster-class object is only a rendered body puppet. Do not let it
	-- build visual memory or distribute enemy contacts while it is online.
	self.object:enable_vision(false)
	self.object:skip_transfer_enemy(true)
	self.position = vector()
	self.facing = vector()
	self.last_animation = nil
	-- Engine bindings of nlc-3.589.69; older exes keep the look-action path.
	local obj = self.object
	local ok_t, f_t = pcall(function() return obj.nlc_set_npc_transform end)
	local ok_s, f_s = pcall(function() return obj.nlc_set_cycle_speed end)
	self.has_transform = ok_t and f_t ~= nil
	self.has_cycle_speed = ok_s and f_s ~= nil
	self.diagnostic_next_scan = 0
	self.diagnostic_npc_states = {}
	self.diagnostic_body_enemy_id = -1
	if DIAGNOSTICS then
		self.object:set_callback(callback.hit, self.hit_callback, self)
		diagnostic_log("binder id=%d section=%s team=%s", self.object:id(), self.object:section(), tostring(self.object:team()))
	end
	self.object:set_fastcall(self.fastcall, self)
end

function visible_body_binder:hit_callback(obj, amount, local_direction, who, bone_index)
	diagnostic_log(
		"body_hit amount=%.4f bone=%s health=%s attacker_id=%s attacker=%s body_to_attacker=%s attacker_to_body=%s",
		amount,
		tostring(bone_index),
		tostring(obj.health),
		who and tostring(who:id()) or "<none>",
		diagnostic_name(who),
		diagnostic_relation_name(diagnostic_relation(obj, who)),
		diagnostic_relation_name(diagnostic_relation(who, obj))
	)
end

function visible_body_binder:diagnostic_scan(now)
	if not DIAGNOSTICS or now < self.diagnostic_next_scan then
		return
	end
	self.diagnostic_next_scan = now + DIAGNOSTIC_SCAN_INTERVAL

	local body = self.object
	local body_id = body:id()
	local actor = db and db.actor
	local body_enemy = body:best_enemy()
	local body_enemy_id = body_enemy and body_enemy:id() or -1
	if body_enemy_id ~= self.diagnostic_body_enemy_id then
		diagnostic_log("body_best_enemy id=%s name=%s", tostring(body_enemy_id), diagnostic_name(body_enemy))
		self.diagnostic_body_enemy_id = body_enemy_id
	end

	local present = {}
	level.iterate_level_objects(function(npc)
		if npc
			and npc:id() ~= body_id
			and (not actor or npc:id() ~= actor:id())
			and npc:clsid() == CLID_STALKER
			and npc:alive()
		then
			local distance_sq = npc:position():distance_to_sqr(body:position())
			if distance_sq <= DIAGNOSTIC_RADIUS_SQ then
				local npc_id = npc:id()
				local npc_enemy = npc:best_enemy()
				local npc_best_body = npc_enemy and npc_enemy:id() == body_id or false
				local npc_best_actor = npc_enemy and actor and npc_enemy:id() == actor:id() or false
				local sees = npc:see(body)
				local sees_actor = actor and npc:see(actor) or false
				local memory_visible = diagnostic_memory_contains(npc, "memory_visible_objects", body_id)
				local memory_sound = diagnostic_memory_contains(npc, "memory_sound_objects", body_id)
				local memory_hit = diagnostic_memory_contains(npc, "memory_hit_objects", body_id)
				local npc_to_body = diagnostic_relation_name(diagnostic_relation(npc, body))
				local body_to_npc = diagnostic_relation_name(diagnostic_relation(body, npc))
				local state = sprintf("%s|%s|%s|%s|%s|%s|%s|%s|%s",
					tostring(npc_to_body), tostring(body_to_npc), tostring(sees),
					tostring(sees_actor),
					tostring(memory_visible), tostring(memory_sound), tostring(memory_hit),
					tostring(npc_best_body), tostring(npc_best_actor))

				present[npc_id] = true
				if self.diagnostic_npc_states[npc_id] ~= state then
					diagnostic_log(
						"npc id=%d name=%s dist=%.1f npc_to_body=%s body_to_npc=%s see_body=%s see_actor=%s mem_visible=%s mem_sound=%s mem_hit=%s npc_best_body=%s npc_best_actor=%s",
						npc_id, diagnostic_name(npc), math.sqrt(distance_sq),
						tostring(npc_to_body), tostring(body_to_npc), tostring(sees), tostring(sees_actor),
						tostring(memory_visible), tostring(memory_sound), tostring(memory_hit),
						tostring(npc_best_body), tostring(npc_best_actor))
					self.diagnostic_npc_states[npc_id] = state
				end
			end
		end
	end)

	for npc_id in pairs(self.diagnostic_npc_states) do
		if not present[npc_id] then
			self.diagnostic_npc_states[npc_id] = nil
		end
	end
end

function visible_body_binder:fastcall()
	local actor = db and db.actor
	if not actor or not actor:alive() or not self.object then
		return true
	end

	local now = time_global()
	local dt = 0
	if self.last_tick then
		dt = math.min((now - self.last_tick) / 1000, 0.25)
	end
	self.last_tick = now

	-- Keep the creature out of native monster navigation/logic. Its position
	-- and animation are driven entirely by this binder.
	if now >= (self.next_capture or 0) then
		if xr_logic and type(xr_logic.mob_capture) == "function" then
			xr_logic.mob_capture(self.object, true)
		end
		self.next_capture = now + CAPTURE_REASSERT_MS
	end

	local dev = device()
	if not dev or not dev.cam_pos or not dev.cam_dir then
		return true
	end

	local state = actor_body_state(actor)
	local ladder = bit_and(state, 2048) ~= 0
	local moving = bit_and(state, 15) ~= 0

	local actor_pos = actor:position()

	-- View heading from the standard first-eye camera: device().cam_dir carries
	-- camera effectors (kick.anm) that flip the heading near vertical.
	local aim = dev.cam_dir
	local standard_camera = actor_camera(0)
	if standard_camera and standard_camera.direction then
		aim = standard_camera.direction
	end
	local view_length = math.sqrt(aim.x * aim.x + aim.z * aim.z)
	if view_length > MIN_HEADING_LENGTH then
		self.view_x = aim.x / view_length
		self.view_z = aim.z / view_length
	elseif not self.view_x then
		local actor_direction = actor:direction()
		local length = math.sqrt(actor_direction.x * actor_direction.x + actor_direction.z * actor_direction.z)
		if length > 0.0001 then
			self.view_x = actor_direction.x / length
			self.view_z = actor_direction.z / length
		else
			self.view_x, self.view_z = 0, 1
		end
	end

	-- Placement offsets blended by how far the view is tilted down.
	local down_t = (-aim.y - PITCH_BLEND_START) / (PITCH_BLEND_END - PITCH_BLEND_START)
	if down_t < 0 then
		down_t = 0
	elseif down_t > 1 then
		down_t = 1
	end
	local forward_offset = placement.fwd_level + (placement.fwd_down - placement.fwd_level) * down_t
	local body_y = actor_pos.y + placement.height_level + (placement.height_down - placement.height_level) * down_t
	if ladder then
		body_y = body_y + LADDER_HEIGHT
	end

	-- Measured horizontal speed (smoothed): refines the packed movement bits.
	if self.prev_x and dt > 0 then
		local moved = math.sqrt((actor_pos.x - self.prev_x) ^ 2 + (actor_pos.z - self.prev_z) ^ 2)
		if moved < 2.5 then
			local k = math.min(1, dt / SPEED_SMOOTH)
			self.speed = (self.speed or 0) + (moved / dt - (self.speed or 0)) * k
		else
			self.speed = 0
		end
	end
	self.prev_x, self.prev_z = actor_pos.x, actor_pos.z
	local speed = self.speed or 0

	-- Planted legs: yaw state machine (see the TURN_* constants).
	if not self.legs_x then
		self.legs_x, self.legs_z = self.view_x, self.view_z
	end
	local turn = nil
	if moving or ladder then
		self.legs_x, self.legs_z = rotate_toward(self.legs_x, self.legs_z, self.view_x, self.view_z, MOVE_ALIGN_RATE * dt)
		self.turning = false
		self.turn_anim_until = 0
	else
		local error_angle = signed_angle(self.legs_x, self.legs_z, self.view_x, self.view_z)
		local ready = now >= (self.turn_ready_at or 0) or math.abs(error_angle) > 1.6 -- a view > ~90 degrees off never waits
		if not self.turning and ready and math.abs(error_angle) > TURN_THRESHOLD then
			self.turning = true
			self.turn_anim_until = now + TURN_ANIM_MS
			self.turn_ready_at = self.turn_anim_until + TURN_COOLDOWN_MS
		end
		if self.turning then
			local rate = math.min(math.max(TURN_RATE, TURN_GAIN * math.abs(error_angle)), TURN_RATE_MAX)
			self.legs_x, self.legs_z, error_angle = rotate_toward(self.legs_x, self.legs_z, self.view_x, self.view_z, rate * dt)
			self.turn_side = error_angle > 0 and "right" or "left"
			if math.abs(error_angle) < TURN_DONE then
				self.turning = false
			end
		end
		if self.turning or now < (self.turn_anim_until or 0) then
			turn = self.turn_side
		end
	end

	-- Body position: anchored on the view heading (blended with the planted legs heading).
	local anchor_x = self.legs_x + (self.view_x - self.legs_x) * ANCHOR_VIEW_FOLLOW
	local anchor_z = self.legs_z + (self.view_z - self.legs_z) * ANCHOR_VIEW_FOLLOW
	local anchor_length = math.sqrt(anchor_x * anchor_x + anchor_z * anchor_z)
	if anchor_length > 0.0001 then
		anchor_x, anchor_z = anchor_x / anchor_length, anchor_z / anchor_length
	else
		anchor_x, anchor_z = self.legs_x, self.legs_z
	end

	local right_x = anchor_z
	local right_z = -anchor_x
	self.position:set(
		dev.cam_pos.x + anchor_x * forward_offset + right_x * SIDE_OFFSET,
		body_y,
		dev.cam_pos.z + anchor_z * forward_offset + right_z * SIDE_OFFSET)
	if self.has_transform then
		-- Position and heading in one call: no AI turn lag.
		self.facing:set(self.legs_x, 0, self.legs_z)
		self.object:nlc_set_npc_transform(self.position, self.facing)
	else
		self.object:set_npc_position(self.position, true)
	end

	if moving then
		self.moving_since = self.moving_since or now
	else
		self.moving_since = nil
	end

	-- Animation choice (pure function of the state, recomputed each frame).
	local animation = nil
	local force_still_flag = false
	if now >= (self.kick_until or 0) then
		local running = moving and bit_and(state, 4096 + 32 + 16) == 0 and bit_and(state, 128 + 256 + 512 + 1024) == 0 and not ladder
		if running and speed > RUN_LEARN_MIN then
			if not run_speed_ref or speed > run_speed_ref then
				run_speed_ref = speed
			else
				run_speed_ref = run_speed_ref + (speed - run_speed_ref) * math.min(1, dt / RUN_REF_DECAY)
			end
		end

		local force_still = false
		if moving and speed < STILL_SPEED then
			self.still_since = self.still_since or now
			force_still = now - self.still_since >= STILL_HOLD_MS
		else
			self.still_since = nil
		end

		local force_slow = false
		local settled = self.moving_since ~= nil and now - self.moving_since >= RUN_SETTLE_MS
		if running and run_speed_ref and (settled or self.speed_slow) then
			local ratio = speed / run_speed_ref
			if self.speed_slow then
				self.speed_slow = ratio < WALK_EXIT_RATIO
			else
				self.speed_slow = ratio < WALK_ENTER_RATIO
			end
			force_slow = self.speed_slow
		else
			self.speed_slow = false
		end

		animation = animation_for_state(state, turn, force_slow, force_still)
		force_still_flag = force_still
	end
	local animation_changed = animation ~= nil and animation ~= self.last_animation

	-- The body is a scripted visual puppet, so its facing must be driven by a
	-- look action. Keep it before play_cycle (the animation command can reset
	-- the puppet's facing) and only re-issue it when needed.
	local face_x, face_z = self.legs_x, self.legs_z
	if not self.has_transform and (animation_changed
		or math.abs(face_x - (self.look_x or 9)) + math.abs(face_z - (self.look_z or 9)) > LOOK_REISSUE_EPS
		or now - (self.look_at or 0) > LOOK_REISSUE_MS) then
		local look_direction = look()
		look_direction:type(2)
		look_direction:direct(vector():set(face_x, 0, face_z))
		action(self.object, look_direction, cond(cond.look_end))
		self.look_x, self.look_z, self.look_at = face_x, face_z, now
	end

	if animation_changed then
		self.object:play_cycle(animation, true)
		self.last_animation = animation
		self.cycle_scale = nil
	end

	-- Playback speed from the measured speed, per locomotion class.
	if self.has_cycle_speed and animation then
		local class = nil
		if moving and not force_still_flag then
			if bit_and(state, 4096) ~= 0 then
				class = "sprint"
			elseif bit_and(state, 16) ~= 0 then
				class = (bit_and(state, 32) ~= 0 or self.speed_slow) and "crouch_walk" or "crouch_run"
			elseif bit_and(state, 32) ~= 0 or self.speed_slow then
				class = "walk"
			else
				class = "run"
			end
		end
		local scale = 1.0
		if class and speed > STILL_SPEED and not ladder and self.moving_since and now - self.moving_since >= RUN_SETTLE_MS then
			local ref = class_speed_ref[class]
			if not ref or speed > ref then
				ref = speed
			else
				ref = ref + (speed - ref) * math.min(1, dt / CLASS_REF_DECAY)
			end
			class_speed_ref[class] = ref
			scale = speed / ref
			if scale < CYCLE_SCALE_MIN then
				scale = CYCLE_SCALE_MIN
			elseif scale > CYCLE_SCALE_MAX then
				scale = CYCLE_SCALE_MAX
			end
		end
		if self.cycle_scale == nil or math.abs(scale - self.cycle_scale) > CYCLE_SCALE_STEP then
			self.object:nlc_set_cycle_speed(scale)
			self.cycle_scale = scale
		end
	end
end

function visible_body_binder:net_destroy()
	if active_body_binder == self then
		active_body_binder = nil
	end
	if self.object then
		if DIAGNOSTICS then
			self.object:set_callback(callback.hit, nil)
			diagnostic_log("binder_destroy id=%d section=%s", self.object:id(), self.object:section())
		end
		if db and db.storage then
			db.storage[self.object:id()] = nil
		end
	end
	object_binder.net_destroy(self)
end

-- True while the actor's movement state forbids a kick (crouch, jump,
-- ladder, sprint). Independent of whether the body puppet exists.
function kick_blocked()
	local actor = db and db.actor
	if not actor then
		return true
	end
	local state = actor_body_state(actor)
	for _, bit in ipairs(KICK_BLOCK_BITS) do
		if bit_and(state, bit) ~= 0 then
			return true
		end
	end
	return false
end

-- Plays the one-shot kick clip on the body puppet. Returns the clip duration
-- in milliseconds, or nil plus a reason: "no_body" (no puppet; the kick itself
-- may still happen), "blocked" (movement state), "busy" (a kick is playing),
-- "dead".
function try_kick()
	local actor = db and db.actor
	if not actor or not actor:alive() then
		return nil, "dead"
	end
	if kick_blocked() then
		return nil, "blocked"
	end
	local binder = active_body_binder
	if not body_present or not binder or not binder.object then
		return nil, "no_body"
	end
	local now = time_global()
	if now < (binder.kick_until or 0) then
		return nil, "busy"
	end

	local dev = device()
	local anim = KICK_ANIM
	if dev and dev.cam_dir and dev.cam_dir.y <= KICK_LOOK_DOWN_Y then
		anim = KICK_ANIM_DOWN
	end

	-- play_cycle returns the blend's total time; a truncated 0..49 value is
	-- seconds, anything larger is already milliseconds.
	local total = binder.object:play_cycle(anim, true)
	local duration = KICK_FALLBACK_MS
	if type(total) == "number" and total > 0 then
		duration = total < 50 and total * 1000 or total
	end
	diagnostic_log("kick anim=%s total=%s duration=%d", anim, tostring(total), duration)

	binder.kick_until = now + duration
	-- Force the movement animation to be re-selected when the kick ends.
	binder.last_animation = nil
	return duration
end

function bind(obj)
	obj:bind_object(visible_body_binder(obj))
end

-- Live placement tuner (no numpad needed): HOME/END fwd_level +/-,
-- PAGE UP/PAGE DOWN fwd_down +/-, INSERT/DELETE height_down +/-,
-- hold LEFT SHIFT with INSERT/DELETE for height_level. Step 0.05 / 0.02.
local function tuner_show()
	local text = string.format("fwd_level=%.2f fwd_down=%.2f height_level=%.2f height_down=%.2f",
		placement.fwd_level, placement.fwd_down, placement.height_level, placement.height_down)
	if PLACEMENT_TUNER_LOG then
		log2("[VB_TUNE] " .. text)
	end
	local actor = db and db.actor
	if actor and actor.give_game_news then
		actor:give_game_news("%c[255,160,160,160]VISIBLE BODY" .. string.char(92) .. "n%c[default]" .. text, "ui" .. string.char(92) .. "ui_iconsTotal", Frect():set(0, 706, 83, 47), 0, 2500)
	end
end

local function on_key_tune(key)
	if not PLACEMENT_TUNER then
		return
	end
	local D = DIK_keys
	local f, h = 0.05, 0.02
	local shift = false
	if key_state then
		local ok, v = pcall(key_state, D.DIK_LSHIFT)
		shift = ok and (v == true or (type(v) == "number" and v ~= 0))
	end
	if key == D.DIK_HOME then
		placement.fwd_level = placement.fwd_level + f
	elseif key == D.DIK_END then
		placement.fwd_level = placement.fwd_level - f
	elseif key == D.DIK_PRIOR then
		placement.fwd_down = placement.fwd_down + f
	elseif key == D.DIK_NEXT then
		placement.fwd_down = placement.fwd_down - f
	elseif key == D.DIK_INSERT then
		if shift then
			placement.height_level = placement.height_level + h
		else
			placement.height_down = placement.height_down + h
		end
	elseif key == D.DIK_DELETE then
		if shift then
			placement.height_level = placement.height_level - h
		else
			placement.height_down = placement.height_down - h
		end
	else
		return
	end
	tuner_show()
end

function attach(sm)
	sm:subscribe({ signal = "on_key", fun = on_key_tune })
	sm:subscribe({ signal = "on_init_modules", fun = on_init_modules })
	sm:subscribe({ signal = "on_first_update", fun = on_first_update })
	sm:subscribe({ signal = "on_update", fun = on_update })
	sm:subscribe({ signal = "on_item_to_slot", fun = on_item_change })
	sm:subscribe({ signal = "on_item_to_ruck", fun = on_item_change })
	sm:subscribe({ signal = "on_drop_after_all", fun = on_item_change })
	sm:subscribe({ signal = "on_before_save_game", fun = on_before_save_game })
	sm:subscribe({ signal = "on_stop_modules", fun = on_stop_modules })
end
