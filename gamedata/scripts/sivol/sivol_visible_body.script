local BODY_NO_OUTFIT = "actor_legs"
local BODY_EXO = "actor_legs_exo"

local function body_section(mesh)
	return "actor_legs_" .. mesh
end

local HIDE_DISTANCE_SQ = 4.0
local CAMERA_DISTANCE_SQ = 2.25
local CAMERA_DIRECTION_DOT = 0.85
local LADDER_HEIGHT = -0.1

-- Kick one-shot (clips live in lancew_legs_krovosos.omf, triggered through
-- try_kick() by sivol_kick). Movement state bits that forbid a kick: crouch,
-- jump start/idle/end, ladder, sprint.
local KICK_ANIM = "actor_kick"
local KICK_ANIM_DOWN = "actor_kick_down"
local KICK_LOOK_DOWN_Y = -0.8
local KICK_FALLBACK_MS = 1000
local KICK_BLOCK_BITS = { 16, 128, 256, 512, 1024, 2048, 4096 }

local SIDE_OFFSET = 0.0

-- Body placement relative to the camera, blended by view pitch (aim.y goes
-- from PITCH_BLEND_START to PITCH_BLEND_END as the view tilts down). "level"
-- is looking ahead, "down" is looking at the feet. Defaults are the values
-- tuned in game 2026-10-12 (the original port used a constant -0.65 / 0.0); tune live with the numpad keys while PLACEMENT_TUNER
-- is on (values are logged as [VB_TUNE] and shown as a news tip). Keys:
-- see on_key_tune.
local placement = {
	fwd_level = -0.12, -- was -0.05; a little lower keeps a sharp turn from showing the inside of the body
	fwd_down = -0.55,
	height_level = 0.0,
	height_down = -0.02,
}
local PITCH_BLEND_START = 0.3
local PITCH_BLEND_END = 0.95
local PLACEMENT_TUNER = true
local PLACEMENT_TUNER_LOG = false -- true: also write each tuner step to the log as [VB_TUNE]

-- Legs yaw model (replaces rigid camera-yaw following). The legs stay planted
-- while the view turns; past TURN_THRESHOLD they step around to the view at
-- TURN_RATE and the turn-in-place clips play. While moving (or on a ladder)
-- they align to the view quickly. Mirrors the engine's own 45 degree model
-- realignment (Actor_Movement.cpp) without its strafe yaw delta.
local TURN_THRESHOLD = 0.6109 -- rad, 35 degrees (the engine's own model realignment uses 45)
local TURN_RATE = 8.0 -- rad/s minimum while stepping around
local TURN_GAIN = 14.0 -- 1/s: the rate also grows with the remaining angle, so a sharp 180 turn finishes fast
local TURN_RATE_MAX = 60.0 -- rad/s
local TURN_DONE = 0.05 -- rad, turn finished below this error
local MOVE_ALIGN_RATE = 40.0 -- rad/s while moving (effectively a snap, like the engine)
local MIN_HEADING_LENGTH = 0.002 -- below this the view is too vertical for a heading
local TURN_CLIP_SWAP = false -- true if the turn_left/turn_right clips turn out mirrored
local TURN_USE_WALK_CLIPS = false -- true: play the strafe-walk clips (walk_l/walk_r) as the step instead
local TURN_ANIM_MS = 650 -- a step clip plays at least this long, even if the yaw is already aligned
local TURN_COOLDOWN_MS = 200 -- pause before the next step may start
-- 0..1: how much the body position is anchored on the view heading instead of the (planted) legs heading.
-- 1 keeps the body trailing right behind the camera, so a sharp turn never swings it through the view.
local ANCHOR_VIEW_FOLLOW = 1.0

-- Measured-speed refinements of the packed movement state.
local SPEED_SMOOTH = 0.25 -- s, speed low-pass
local STILL_SPEED = 0.15 -- m/s, "pushing against a wall" threshold
local STILL_HOLD_MS = 150
local RUN_LEARN_MIN = 1.0 -- m/s, below this a run speed is not learned
local RUN_REF_DECAY = 5.0 -- s, how fast the learned run speed follows slower running
local WALK_ENTER_RATIO = 0.62 -- running bits but slower than this share of the run speed: walk clips
local WALK_EXIT_RATIO = 0.72
local RUN_SETTLE_MS = 700 -- running bits held this long before speed may re-class the clip or scale playback

-- Re-issue rates for the per-frame commands.
local LOOK_REISSUE_EPS = 0.01
local LOOK_REISSUE_MS = 400
local CAPTURE_REASSERT_MS = 500

-- Learned across puppet respawns: the actor's unburdened run speed.
local run_speed_ref = nil

-- Playback speed follows the measured speed (engine nlc_set_cycle_speed): per
-- locomotion class the highest smoothed speed seen is the clip's nominal speed.
local CLASS_REF_DECAY = 8.0 -- s, how fast a class reference follows lower speeds
local CYCLE_SCALE_MIN = 0.6
local CYCLE_SCALE_MAX = 1.25
local CYCLE_SCALE_STEP = 0.03
local class_speed_ref = {}

-- Test-build master switch. Set false to disable every diagnostic callback,
-- level-object scan, and VISIBLE_BODY_DIAG log line.
local DIAGNOSTICS = false
local DIAGNOSTIC_SCAN_INTERVAL = 1000
local DIAGNOSTIC_RADIUS_SQ = 25.0 * 25.0

