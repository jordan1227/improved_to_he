--[[
    sivol_weapon_inertia.script

    Ported subset of "Weapon Inertia Expanded" (Anomaly addon) for NLC OGSR HE.

    Implements only:
      - stamina-scaled breathing sway (hip-fire/idle hud hand additive anim)
      - hit-flinch additive anim

    Moved to the engine on 2026-10-22 (nlc-3.589.132/.133, docs/GUNPLAY_FEEL_DESIGN.md):
    the crouch kick clips are played by the engine on stance changes (set up
    here, so they stack); held crouch pose, look-up dip and lean sway are
    CHudItem springs, scaled by weapon handling in sivol_weapon_aim_speed.
    This script also feeds the live HUD motion modifiers and plays the hit
    flinch through the engine clip player (directional, damage-scaled). The per-weapon c/u/l/r
    table in sivol_weapon_inertia_configs.script is no longer read.

    Deliberately NOT ported: MCM (none in this engine -- see constants below
    instead), noise, jump/land (engine springs), device/detector lean, crawl.

    Hook mechanisms used (confirmed working in-game):
      - Periodic logic: ogse_signals "on_update" subscription (unthrottled).
      - Hit flinch: "on_actor_before_hit" subscription.
      - Aim state: polls wpn_params.get_zie_obj() (same check scope_wobble
        already relies on) to prevent ADS desyncs.

    Breathing and hit-flinch stay active regardless of held item, so the PDA
    keeps the same feedback.

    Setup: add "sivol_weapon_inertia" to ogse_signals_addons_list.addons.
]]

sivol_weapon_inertia = sivol_weapon_inertia or {}

-- ============================================================
-- Tuning constants (no MCM in this engine -- edit these directly)
-- ============================================================

local BREATH_SPEED_MIN   = 0.5
local BREATH_SPEED_MAX   = 1.4
local BREATH_POWER_MIN   = 0.15
local BREATH_POWER_MAX   = 0.55

local HIT_ANM_ENABLED    = true

-- Engine-played crouch clips (nlc-3.589.133+, nlc_gunplay.set_crouch_clips). The
-- engine detects every stance change and plays these additively, so crouch spam
-- stacks; handling scales power and speed per weapon. Tune here, no rebuild.
local CROUCH_CLIP_DOWN   = "liz\\liz_hands_crouch_start_additive.anm"
local CROUCH_CLIP_UP     = "liz\\liz_hands_crouch_end_additive.anm"
local CROUCH_CLIP_POWER  = 2.35  -- the old script kick power
local CROUCH_CLIP_SPEED  = 1.05
local CROUCH_CLIP_AIM_K  = 0.90  -- share kept while aiming

-- Directional hit flinch: hits from the side push the gun away from the hit,
-- stronger hits flinch more. Flip HIT_MIRROR_SIGN if the push reads the wrong way.
local HIT_MIRROR_SIGN    = 1
local HIT_POWER_MIN      = 0.6
local HIT_POWER_MAX      = 1.6
local HIT_POWER_PER_HIT  = 1.5
local HIT_AIM_K          = 0.6

-- Engine gunplay tunables (nlc_gunplay.set_param, nlc-3.589.134+). Values are
-- the engine defaults; change them here, no rebuild needed.
local GUNPLAY_PARAMS = {
    ads_omega_k    = 2.6,   -- ADS pose spring: omega = k / ADS time (4 felt too fast)
    pda_share      = 0.6,   -- PDA share of the motion layers (crouch clips included)
    pda_turn_share = 0.35,  -- PDA share of the turn lag
    pda_use_share  = 0.2,   -- multiplier while the 3D PDA is zoomed for the cursor
    missile_share  = 0.7,   -- grenades and bolts
    fx_omega       = 16.0,  -- shared impulse spring (nlc_gunplay.hud_impulse)
    fx_zeta        = 0.5,
    fx_aim_k       = 0.5,   -- impulse share while aiming
}

-- Live HUD motion modifiers (nlc_gunplay.set_motion_mod): tired arms lag more,
-- servos stiffen, arm injuries loosen, adrenaline makes the gun twitchier.
local MOD_INTERVAL_MS    = 100
local MOD_TIRED_FREQ     = 0.18  -- spring speed lost at zero stamina
local MOD_TIRED_AMP      = 0.35  -- inertia gained at zero stamina

-- Lerp convergence rates (1/seconds) -- how fast each sway/blend chases its
-- target, independent of framerate. Higher = snappier. These replace the
-- old hardcoded new_lerp() power args and the is_aiming 0.9, which were only
-- "correct" by accident when dt came from game-time (see changelog note).
local BREATHING_SPEED_LERP_RATE = 8.0
local BREATHING_POWER_LERP_RATE = 8.0
local AIM_LERP_RATE             = 18.0   -- replaces the old hardcoded 0.9

-- ============================================================
-- Lerp helpers (simple exponential blend, ported from the addon)
-- ============================================================

local lerps = {}

local function lerp(from, to, power)
    return (from * (1 - power)) + (to * power)
end

local function new_lerp(name, from, to, power)
    lerps[name] = { from = from, to = to, power = power }
end

local function set_lerp(name, to, power)
    local lp = lerps[name]
    if lp then
        lp.to = to
        if power then lp.power = power end
    end
end

-- ============================================================
-- State
-- ============================================================

local is_initialized  = false
local last_mod_time   = 0
local is_aiming        = false
local last_update_time = 0

local hit_anims = {
    "liz\\liz_hands_hit1_additive.anm",
    "liz\\liz_hands_hit2_additive.anm",
    "liz\\liz_hands_hit3_additive.anm",
}

-- Standard SHOC/CoP hit-type enum -- same set the source addon filters on.
-- Built defensively: "wound2" is an Anomaly-only addition and may not exist
-- in this engine's hit enum, so we skip whatever isn't present.
local valid_hit_types = {}
local function register_hit_type(name)
    if hit[name] then valid_hit_types[hit[name]] = true end
end
register_hit_type("wound")
register_hit_type("fire_wound")
register_hit_type("strike")
register_hit_type("explosion")
register_hit_type("wound2")

local function engine_gunplay(name)
    return nlc_gunplay and type(nlc_gunplay[name]) == "function"
end

local function initialize()
    new_lerp("breathing_speed", 0, 0, BREATHING_SPEED_LERP_RATE)
    new_lerp("breathing_power", 0, 0, BREATHING_POWER_LERP_RATE)
    if engine_gunplay("set_param") then
        for name, value in pairs(GUNPLAY_PARAMS) do
            nlc_gunplay.set_param(name, value)
        end
    end
    if engine_gunplay("set_crouch_clips") then
        nlc_gunplay.set_crouch_clips(CROUCH_CLIP_DOWN, CROUCH_CLIP_UP,
            CROUCH_CLIP_POWER, CROUCH_CLIP_SPEED, CROUCH_CLIP_AIM_K)
    end
    is_initialized = true
end

local function update_motion_mod(actor)
    if not engine_gunplay("set_motion_mod") then return end
    local now = time_global()
    if now - last_mod_time < MOD_INTERVAL_MS then return end
    last_mod_time = now

    local tired = 1 - math.max(0, math.min(1, actor.power or 1))
    local freq_k = 1 - MOD_TIRED_FREQ * tired
    local amp_k = 1 + MOD_TIRED_AMP * tired

    local outfit = actor:item_in_slot(6)
    if outfit and string.find(outfit:section(), "exo", 1, true)
        and sivol_exo and type(sivol_exo.sway_k) == "function" then
        local sway = sivol_exo.sway_k() -- below 1 while the servos assist
        amp_k = amp_k * sway
        freq_k = freq_k * (1 + (1 - sway) * 0.5)
    end

    local injury = get_value and get_value("nlc_vars.add_wobble")
    if injury == true or injury == 1 then
        amp_k, freq_k = amp_k * 1.15, freq_k * 0.92
    elseif injury == 2 then
        amp_k, freq_k = amp_k * 1.30, freq_k * 0.85
    elseif injury == 3 then
        amp_k = amp_k * 1.05
    end

    if sivol_adrenaline and type(sivol_adrenaline.wobble_k) == "function" then
        freq_k = freq_k * math.sqrt(math.max(0.5, sivol_adrenaline.wobble_k()))
    end
    nlc_gunplay.set_motion_mod(freq_k, amp_k)
end

-- ============================================================
-- Per-tick state updates
-- ============================================================

local function update_stamina_info(actor)
    if not actor then return end
    local fatigue = 1 - actor.power -- 0 = fresh, 1 = exhausted
    set_lerp("breathing_speed", BREATH_SPEED_MIN + (BREATH_SPEED_MAX - BREATH_SPEED_MIN) * fatigue)
    set_lerp("breathing_power", BREATH_POWER_MIN + (BREATH_POWER_MAX - BREATH_POWER_MIN) * fatigue)
end

-- Bulletproof aim-state check: polls the scope effector directly, same
-- mechanism scope_wobble already relies on for ADS detection.
local function update_aiming()
    is_aiming = false
    if wpn_params and type(wpn_params.get_zie_obj) == "function" then
        is_aiming = (wpn_params.get_zie_obj() ~= nil)
    end
end

-- ============================================================
-- Main tick (subscribed to ogse_signals "on_update")
-- ============================================================

local function on_actor_update()
    if not is_initialized then initialize() end

    local actor = db.actor
    if not actor then return end

    local now = time_global() / 1000
    local dt = (last_update_time == 0) and 0.016 or (now - last_update_time)
    last_update_time = now

    update_stamina_info(actor)
    update_aiming()
    update_motion_mod(actor)

	for _, lp in pairs(lerps) do
		local rate = is_aiming and AIM_LERP_RATE or lp.power
		local k = 1 - math.exp(-rate * dt)
		lp.from = lerp(lp.from, is_aiming and 0 or lp.to, k)
	end

    game.play_hud_anm("liz\\liz_hands_breathing_additive.anm", 2, lerps["breathing_speed"].from, lerps["breathing_power"].from, true, true)
end

-- ============================================================
-- Hit flinch
-- ============================================================

local function on_actor_before_hit(obj, hd)
    if not HIT_ANM_ENABLED then return end
    if not hd or hd.ignore_hit then return end
    if sivol_psy_phantoms and sivol_psy_phantoms.is_phantom and sivol_psy_phantoms.is_phantom(hd.who_id) then return end
    if not valid_hit_types[hd.hit_type] then return end
    local anm = hit_anims[math.random(1, #hit_anims)]
    if not engine_gunplay("hud_clip") then
        if is_aiming then return end
        game.play_hud_anm(anm, 2, 1, 1, false, true)
        return
    end
    -- Side of the hit relative to the view: positive = travelling to the right.
    local side = 0
    local ok, dot = pcall(function() return hd.direction:dotproduct(device().cam_right) end)
    if ok and type(dot) == "number" then side = dot end
    local mirror = (side >= 0 and 1 or -1) * HIT_MIRROR_SIGN
    local power = math.max(HIT_POWER_MIN, math.min(HIT_POWER_MAX,
        HIT_POWER_MIN + (tonumber(hd.power) or 0) * HIT_POWER_PER_HIT))
    nlc_gunplay.hud_clip(anm, power, 1, mirror, HIT_AIM_K)
end

-- ============================================================
-- ogse_signals attach
-- ============================================================

function attach(sm)
    sm:subscribe({ signal = "on_update", fun = on_actor_update })
    sm:subscribe({ signal = "on_actor_before_hit", fun = on_actor_before_hit })
end

sivol_weapon_inertia.attach = attach
