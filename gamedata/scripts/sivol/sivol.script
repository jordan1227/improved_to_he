-- Console: g_loadstring !sivol.spawn_anomaly_near("zone_witches_galantine_strong")
-- Optional arguments are distance and sphere radius in metres (defaults: five and two).
function spawn_anomaly_near(section, distance, radius)
	if type(section) ~= "string" or section == "" then
		log2("[sivol.spawn_anomaly_near] invalid anomaly section: %s", tostring(section))
		return nil
	end

	if not (level.present() and db.actor and db.actor:alive() and alife()) then
		log2("[sivol.spawn_anomaly_near] cannot spawn [%s]: actor or ALife is unavailable", section)
		return nil
	end

	local ini = system_ini()
	if not (ini and ini:section_exist(section)) then
		log2("[sivol.spawn_anomaly_near] cannot spawn [%s]: section does not exist", section)
		return nil
	end

	distance = tonumber(distance) or 5.0
	local actor_pos = db.actor:position()
	local actor_dir = db.actor:direction()
	local pos = vector():set(
		actor_pos.x + actor_dir.x * distance,
		actor_pos.y + 0.1,
		actor_pos.z + actor_dir.z * distance
	)
	if not (amk_anoms and amk_anoms.spawn_anomaly) then
		log2("[sivol.spawn_anomaly_near] cannot spawn [%s]: amk_anoms is unavailable", section)
		return nil
	end

	radius = tonumber(radius) or 2.0
	local shape = { shtype = 0, radius = radius, center = { 0, 0.5, 0 } }
	local spawned = amk_anoms.spawn_anomaly(
		section,
		pos,
		db.actor:game_vertex_id(),
		db.actor:level_vertex_id(),
		shape,
		"on"
	)

	if spawned then
		log2("[sivol.spawn_anomaly_near] spawned [%s] id=%s at %.2f, %.2f, %.2f", section, tostring(spawned.id), pos.x, pos.y, pos.z)
	else
		log2("[sivol.spawn_anomaly_near] spawn failed for [%s]", section)
	end

	return spawned
end

-- Console: fl sivol.spawn_upgraded_outfit("stalker_outfit", 1.0, 120)
-- Spawns an outfit into the actor's inventory, then marks it upgraded after client spawn.
-- condition is 0..1; duration is game minutes. Equip the returned outfit manually for the test.
function spawn_upgraded_outfit(section, condition, duration)
    section = section or "stalker_outfit"
    condition = math.max(0, math.min(1, tonumber(condition) or 1.0))
    duration = math.max(1, math.floor(tonumber(duration) or 120))

    if type(section) ~= "string" or section == "" then
        log2("[sivol.spawn_upgraded_outfit] invalid outfit section: %s", tostring(section))
        return nil
    end

    if not (level.present() and db.actor and db.actor:alive() and alife()) then
        log2("[sivol.spawn_upgraded_outfit] actor or ALife is unavailable")
        return nil
    end

    local ini = system_ini()
    if not (ini and ini:section_exist(section)) then
        log2("[sivol.spawn_upgraded_outfit] outfit section does not exist: %s", section)
        return nil
    end

    if not (misc and misc.spawn_to and level.client_spawn_manager
        and bind_upg_outfit and bind_upg_outfit.set_end_time
        and bind_upg_outfit.update_outfit) then
        log2("[sivol.spawn_upgraded_outfit] required spawn or upgrade helpers are unavailable")
        return nil
    end

    local spawned = misc.spawn_to(section, db.actor)
    if not spawned then
        log2("[sivol.spawn_upgraded_outfit] spawn failed for %s", section)
        return nil
    end

    -- misc.spawn_to returns the server object; persist the timer without a server_obj lookup.
    bind_upg_outfit.set_end_time(spawned, timers.Get_Game_Minutes() + duration)

    level.client_spawn_manager():add(
        spawned.id, -1,
        function(_, outfit)
            if not outfit then
                log2("[sivol.spawn_upgraded_outfit] client spawn failed for id=%s", tostring(spawned.id))
                return
            end

            params.upd_condition(outfit.id, condition)
            bind_upg_outfit.update_outfit(outfit, true)
            log2("[sivol.spawn_upgraded_outfit] upgraded %s id=%s condition=%.2f duration=%d",
                section, tostring(outfit.id), condition, duration)
        end
    )

    log2("[sivol.spawn_upgraded_outfit] spawned %s id=%s; waiting for client spawn",
        section, tostring(spawned.id))
    return spawned
end
