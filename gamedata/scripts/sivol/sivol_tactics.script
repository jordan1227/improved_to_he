-- sivol_tactics.script
-- AlifeTactics passes 1 and 2 (docs/ALIFE_TACTICS_DESIGN.md): the faction character table, the target
-- choice weights, the finish-the-downed gate, the morale score the rout reads, the heal fallback, and the
-- test harness (fight / who / set / get / break_npc / wound / clear).
-- The combat code stays in xrs/xrs_battle_ai.script; it calls the small functions below.
-- Live switches (fl / g_loadstring):
--   g_loadstring sivol_tactics.enabled = false       faction table off (press, patience, weights, M1, finish gate)
--   g_loadstring sivol_tactics.tgt_enabled = false   target choice back to the stock weights
--   g_loadstring xrs_battle_ai.nlc_rank_follows_actor = true   the old "NPC skill follows the player" rank
-- Table: config/misc/he_faction_character.ltx

enabled = true
tgt_enabled = true
ignore_actor = false   -- harness: hostile stalkers do not see the player as an enemy (invisible(true))
log_events = true      -- [sivol_tactics] lines
log_tgt = true         -- [xrs_tgt] every primary target change

-- ---------------------------------------------------------------------------
-- target choice (section 7); a lower weight wins
-- ---------------------------------------------------------------------------
actor_k = 1.3                 -- weight factor on the player, only while the NPC has another enemy in view
actor_rank_share = { novice = 0.3, experienced = 0.6, veteran = 1.0, master = 1.0 }
hit_k = 0.4                   -- weight factor on the last shooter
hit_ms = 4000                 -- how long the last shooter keeps it
stick_k = 0.8                 -- weight factor on the current primary target (no flipping)
engine_mult = 0.5             -- stock 0.1: the engine's pick no longer wins by default

-- ---------------------------------------------------------------------------
-- morale (section 6); the rout (sivol_rout.script) breaks when morale() >= 1
-- ---------------------------------------------------------------------------
morale_k = {
    health_k = 0.6,           -- x (1 - health)
    loss_k = 0.3,             -- per friend lost within loss_ms
    loss_ms = 30000,
    crowd_k = 0.1,            -- per enemy on me above the friends near me
    ammo_k = 0.5,             -- out of ammo
    broken_k = 0.15,          -- a friend within broken_dist has broken (broken_ms ago at most)
    broken_dist = 15,
    broken_ms = 40000,
}
rank_k = { novice = 1.2, experienced = 1.0, veteran = 0.85, master = 0.7 }
temper_k = { lazy = 1.2, curious = 1.0, careful = 1.0, tactical = 0.8 }

local PRESS_RECHECK_MS = 4000
local RANK_READ = { novice = 0.2, experienced = 0.45, veteran = 0.75, master = 1.0 }
local PRESS_RANK = { novice = 0.7, experienced = 1.0, veteran = 1.2, master = 1.3 }   -- veterans press harder

local ini = ini_file("misc\\he_faction_character.ltx")
local rows = {}
local warned = {}
local decision = {}      -- [npc id] = { t = until, alg = algorithm or false }  (situation 9)
local recent = {}        -- [npc id] = { id = shooter id, t = until }
local lost = {}          -- [npc id] = { time of each friend lost seen }
local broke = {}         -- [npc id] = { time, x, z }
local gated = {}         -- [npc id .. ":" .. enemy id] = { n, e }  downed enemies hidden by the finish gate
local made = {}          -- ids created by fight()
test_ids = {}            -- [npc id] = true: harness NPCs count as OLR-tracked for the rout home change
local next_poll = 0
local hold_wait = nil     -- harness: { id, t0 }, sneak_duel waits for the victim to come online, then holds him
local mh_t = {}          -- [npc id] = next time a melee-hit line may be written
local retreat_cache = {}
local sidearm_seen = {}    -- [npc id] = true: judged already (by his first get_best_weapon call in a fight)
local sidearm_pending = {} -- [npc id] = { sid, sect, cond, mag, t0 }: created, to be prepared when it is online
local logged = {}        -- [npc id] = last primary target id written to the [xrs_tgt] log

local function tlog(fmt, ...)
    if log_events then log2("[sivol_tactics] " .. fmt, ...) end
end

-- ---------------------------------------------------------------------------
-- faction table
-- ---------------------------------------------------------------------------
local function num(sect, key, def)
    if ini:line_exist(sect, key) then return ini:r_float(sect, key) end
    return def
end

local function str(sect, key, def)
    if ini:line_exist(sect, key) then return ini:r_string(sect, key) end
    return def
end

local function weights(sect, key)
    if not ini:line_exist(sect, key) then return nil end
    local list, name = {}, nil
    local total = 0
    for token in string.gmatch(ini:r_string(sect, key), "[^,]+") do
        if not name then
            name = token
        else
            local w = tonumber(token) or 0
            if w > 0 then
                table.insert(list, { name, w })
                total = total + w
            end
            name = nil
        end
    end
    if #list == 0 then return nil end
    list.total = total
    return list
end

local function load_row(comm)
    local r = {}
    if num(comm, "exempt", 0) > 0 then
        r.exempt = true
        return r
    end
    r.press = num(comm, "press", 0.25)
    r.patience = num(comm, "patience", 1)
    r.hold_k = num(comm, "hold_k", 1)
    r.rout_k = num(comm, "rout_k", 1)
    r.finish_downed = num(comm, "finish_downed", 1)
    r.heal_fallback = num(comm, "heal_fallback", 1)
    r.mut_rout = num(comm, "mut_rout", 0)
    r.melee_k = num(comm, "melee_k", 1)
    r.suppress = num(comm, "suppress", 1)
    r.theft_react = num(comm, "theft_react", 0)               -- read by sivol_part_claim
    r.sidearm = str(comm, "sidearm", "wpn_fort")              -- given once at his first combat when slot 1 is empty; "none" = never
    r.sidearm_novice = str(comm, "sidearm_novice", "wpn_pm")  -- the same for a novice
    r.sidearm_ammo = str(comm, "sidearm_ammo", "ammo_9x18_fmj")
    local lo, hi = string.match(str(comm, "sidearm_cond", "0.6,0.7"), "([%d%.]+),([%d%.]+)")
    r.sidearm_cond_lo, r.sidearm_cond_hi = tonumber(lo) or 0.6, tonumber(hi) or 0.7
    r.s14 = weights(comm, "s14")
    r.s15 = weights(comm, "s15")
    return r
end

-- the row of a community (exempt rows included), the stalker row for an unknown one
local function row_raw(comm)
    local r = rows[comm]
    if r then return r end
    if ini:section_exist(comm) then
        r = load_row(comm)
    else
        if not warned[comm] then
            warned[comm] = true
            tlog("unknown community '%s', using the stalker row", tostring(comm))
        end
        r = row_raw("stalker")
    end
    rows[comm] = r
    return r
end

-- nil for an exempt community (zombied, trader, arena_enemy): nothing in the table applies
function row(npc)
    local r = row_raw(npc:character_community())
    if r.exempt then return nil end
    return r
end

function set(comm, key, value)
    local r = row_raw(comm)
    if r[key] == nil then
        log2("[sivol_tactics] set: no key '%s' in row '%s'", tostring(key), tostring(comm))
        return
    end
    r[key] = value
    log2("[sivol_tactics] %s.%s = %s", tostring(comm), tostring(key), tostring(value))
end

function get(comm, key)
    local r = row_raw(comm)
    log2("[sivol_tactics] %s.%s = %s", tostring(comm), tostring(key), tostring(r[key]))
    return r[key]
end

function patience(npc)
    if not enabled then return 1 end
    local r = row(npc)
    return r and r.patience or 1
end

function hold_k(npc)
    if not enabled then return 1 end
    local r = row(npc)
    return r and r.hold_k or 1
end

-- a weighted algorithm name from the row's list (key "s14" or "s15"); nil = the caller keeps its random_choice
function pick(npc, key)
    if not enabled then return nil end
    local r = row(npc)
    local list = r and r[key]
    if not list then return nil end
    local x = math.random() * list.total
    for i = 1, #list do
        x = x - list[i][2]
        if x < 0 then return list[i][1] end
    end
    return list[#list][1]
end

-- ---------------------------------------------------------------------------
-- situation 9 (the enemy sees us and we can fire): press, and the push on an enemy reload (M1)
-- ---------------------------------------------------------------------------
local function enemy_reloading(be)
    if not be then return false end
    local w = be:active_item()
    if not (w and w:is_weapon() and weapon_states) then return false end
    return w:get_hud_item_state() == weapon_states.reload
end

-- returns the algorithm to use instead of find_cover_2 (or nil), and a hold time in ms for the choice.
-- hide_ok: the caller says the NPC may leave its cover (not in a hideout, or past the cover's ttl)
function s9(npc, be, camper, hide_ok)
    if not enabled or camper then return nil end
    local r = row(npc)
    if not r then return nil end
    local id = npc:id()
    local now = time_global()
    local d = decision[id]
    if d and d.t > now then
        local h = d.hold
        d.hold = nil
        return d.alg or nil, h
    end
    local alg, hold = nil, nil
    if npc.health > 0.5 then
        local rank = ranks.get_obj_rank_name(npc)
        if enemy_reloading(be) then
            if math.random() < r.press * (RANK_READ[rank] or 0.45) then
                alg, hold = "find_cover_8", 3000
                if log_events then
                    tlog("%s M1 pushes %s (reloading) rank=%s", npc:name(), be:name(), rank)
                end
            end
        elseif hide_ok and math.random() < r.press * (PRESS_RANK[rank] or 1) then
            alg = (math.random(2) == 1) and "find_cover_3" or "find_cover_4"
        end
    end
    decision[id] = { t = now + PRESS_RECHECK_MS, alg = alg or false, hold = hold }
    return alg, hold
end

-- ---------------------------------------------------------------------------
-- healing fallback in a fight (rx_bandage.heal_in_combat, section 15.1)
-- ---------------------------------------------------------------------------
local function has_heal_item(npc)
    local sets = rx_bandage.bandage_sets
    for _, v in ipairs(sets.medkits) do
        if npc:object(v) then return true end
    end
    for _, v in ipairs(sets.bandages) do
        if npc:object(v) then return true end
    end
    return false
end

function heal_alg(npc)
    if not enabled or not rx_bandage.heal_in_combat then return nil end
    if npc.health >= 0.5 then return nil end
    local r = row(npc)
    if not r or r.heal_fallback <= 0 then return nil end
    if not has_heal_item(npc) then return nil end
    if rx_utils.npc_in_cover(npc) then return nil end
    return (math.random(2) == 1) and "find_cover_2" or "find_cover_9"
end

-- ---------------------------------------------------------------------------
-- a worn sidearm (docs/ALIFE_TACTICS_DESIGN.md 16.10): no kit carries a rifle and a pistol, so a fighter whose rifle
-- slot is filled and pistol slot empty gets one the first time he fights, and keeps it (it may end up in the loot).
-- The row says which: sidearm, sidearm_novice for a novice ("none" = never), sidearm_ammo, sidearm_cond = lo,hi.
-- ---------------------------------------------------------------------------
sidearm_give = true

local function give_sidearm(npc)
    local id = npc:id()
    sidearm_seen[id] = true
    if not sidearm_give then return end
    local r = row(npc)
    if not r then return end
    local rank = ranks.get_obj_rank_name(npc)
    local sect = (rank == "novice") and r.sidearm_novice or r.sidearm
    if not sect or sect == "none" then return end
    local rifle = npc:item_in_slot(2)
    if npc:item_in_slot(1) or not (rifle and rifle:is_weapon_magazined()) then return end
    local pos, lv, gv = npc:position(), npc:level_vertex_id(), npc:game_vertex_id()
    local ok, err = pcall(function()
        local se = alife():create(sect, pos, lv, gv, id)
        local box = system_ini():r_u32(r.sidearm_ammo, "box_size")
        alife():create_ammo(r.sidearm_ammo, pos, lv, gv, id, math.min(16, box))
        sidearm_pending[id] = { sid = se.id, sect = sect, t0 = time_global(),
            cond = r.sidearm_cond_lo + math.random() * (r.sidearm_cond_hi - r.sidearm_cond_lo),
            mag = system_ini():r_u32(sect, "ammo_mag_size") }
    end)
    if ok then
        tlog("%s (%s) is given a %s", npc:name(), rank, sect)
    else
        tlog("sidearm for %s failed: %s", npc:name(), tostring(err))
    end
end

-- the created pistol comes online a moment later: worn, loaded, in slot 1
local function poll_sidearm(now)
    for id, p in pairs(sidearm_pending) do
        local npc = level.object_by_id(id)
        local w = level.object_by_id(p.sid)
        if not npc or not npc:alive() then
            sidearm_pending[id] = nil
        elseif w then
            sidearm_pending[id] = nil
            w:set_condition(p.cond)
            w:set_ammo_elapsed(p.mag)
            local slotted = npc:item_in_slot(1) ~= nil
            if not slotted then
                pcall(function() npc:move_to_slot(w, true) end)
                slotted = npc:item_in_slot(1) ~= nil
            end
            tlog("%s: %s ready, condition %.2f, %d rounds, slot 1 %s", npc:name(), p.sect, p.cond, p.mag, slotted and "yes" or "NO")
        elseif now - p.t0 > 8000 then
            sidearm_pending[id] = nil
            tlog("%s: the %s never came online", npc:name(), p.sect)
        end
    end
end

-- the rifle is empty and an enemy is close: the pistol (cached for 0.4 s; get_best_weapon asks very often)
sidearm_enabled = true
local SIDEARM_DIST = 12
local side_c = {}
function sidearm(npc)
    if not (enabled and sidearm_enabled) then return nil end
    local id = npc:id()
    if not sidearm_seen[id] then give_sidearm(npc) end
    local now = time_global()
    local c = side_c[id]
    if c and c.t > now then return c.item end
    local item = nil
    local rifle, pistol = npc:item_in_slot(2), npc:item_in_slot(1)
    if rifle and pistol and rifle:is_weapon_magazined() and rifle:get_ammo_in_magazine() == 0 and pistol:get_ammo_in_magazine() > 0 then
        local e = xrs_battle_ai.get_target(npc)
        if e and npc:position():distance_to(e:position()) < SIDEARM_DIST then item = pistol end
    end
    if item and not (c and c.item) then
        tlog("%s draws the pistol (rifle empty)", npc:name())
    end
    side_c[id] = { t = now + 400, item = item }
    return item
end

-- pinned down: incoming fire (a ricochet, an attack sound) from a shooter he cannot see; seconds held in cover by rank
suppress_enabled = true
local SUPP_TYPES = {
    [danger_object.bullet_ricochet] = true, [danger_object.attack_sound] = true, [danger_object.attacked] = true,
}
local SUPP_HOLD = { novice = 3500, experienced = 2500, veteran = 1500, master = 900 }
local supp_logged = 0
function suppress(npc, be)
    if not (enabled and suppress_enabled) then return nil end
    local r = row(npc)
    if not r or r.suppress <= 0 then return nil end
    if be and npc:see(be) then return nil end
    local bd = npc:best_danger()
    if not bd or not SUPP_TYPES[bd:type()] then return nil end
    local now = time_global()
    local age = now - bd:time()
    if age < 0 or age > 1500 then return nil end
    if supp_logged < 6 then
        supp_logged = supp_logged + 1
        tlog("%s pinned down (danger type %s, %d ms old)", npc:name(), tostring(bd:type()), age)
    end
    return "find_cover_2", SUPP_HOLD[ranks.get_obj_rank_name(npc)] or 2500
end

-- a badly hurt fighter with a friend close by backs into cover (every 2 s at most), healthy friends hold the line
function retreat_alg(npc)
    if not enabled or npc.health >= 0.35 then return nil end
    local r = row(npc)
    if not r or r.heal_fallback <= 0 then return nil end
    local id = npc:id()
    local now = time_global()
    local c = retreat_cache[id]
    if c and c.t > now then return c.alg end
    local alg = nil
    for o in npc:memory_visible_objects() do
        local obj = o:object()
        if obj and obj:id() ~= id and obj:is_stalker() and obj:alive() and obj.health > 0.5
            and xrs_battle_ai.friend_is_near(npc, obj) and npc:position():distance_to(obj:position()) < 20 then
            alg = "find_cover_9"
            break
        end
    end
    retreat_cache[id] = { t = now + 2000, alg = alg }
    return alg
end

-- ---------------------------------------------------------------------------
-- target choice
-- ---------------------------------------------------------------------------
function engine_k()
    if tgt_enabled then return engine_mult end
    return nil
end

function note_hit(npc, who, amount)
    if not tgt_enabled or not who then return end
    if amount < 0.02 then return end
    recent[npc:id()] = { id = who:id(), t = time_global() + hit_ms }
end

-- weights are set; lower wins. list = targets_list[npc id], primary = its current primary target id
function adjust_weights(npc, list, primary)
    if not tgt_enabled then return end
    local id = npc:id()
    local now = time_global()
    local rh = recent[id]
    if rh and rh.t <= now then
        recent[id] = nil
        rh = nil
    end
    local other = false
    for k, v in pairs(list) do
        if not v.actor and (v.visible or v.vis) and v.weight < 1000 then
            other = true
            break
        end
    end
    local akk = nil
    if other then
        local share = actor_rank_share[ranks.get_obj_rank_name(npc)] or 0.6
        akk = 1 + (actor_k - 1) * share
    end
    for k, v in pairs(list) do
        -- the stock code leaves some weights as they were: start from the base we saw, never from our own result
        local base = v.weight
        if v.tw_last and base == v.tw_last then base = v.tw_base end
        if base < 1000 then
            local w = base
            if v.actor and akk then w = w * akk end
            if rh and rh.id == k then w = w * hit_k end
            if k == primary then w = w * stick_k end
            v.tw_base, v.tw_last, v.weight = base, w, w
        end
    end
end

-- diagnostic: a mutant hits this NPC from close range; what was the combat code telling him to do
function melee_hit_log(npc, who, amount)
    if not log_events or not who or amount < 0.02 or not who:is_monster() then return end
    if npc:position():distance_to(who:position()) > 3 then return end
    local id = npc:id()
    local now = time_global()
    if mh_t[id] and now < mh_t[id] then return end
    mh_t[id] = now + 1500
    log2("[sivol_tactics] melee hit on %s by %s: %.2f hp=%.2f %s", npc:name(), who:name(), amount, npc.health, xrs_battle_ai.nlc_state(npc))
end

function on_primary(npc, old_id, new_id)
    if not log_tgt then return end
    local function nm(i)
        if not i then return "none" end
        local o = level.object_by_id(i)
        return o and o:name() or tostring(i)
    end
    if not new_id or logged[npc:id()] == new_id then return end
    logged[npc:id()] = new_id
    local rh = recent[npc:id()]
    local why = (rh and new_id and rh.id == new_id and rh.t > time_global()) and "hit_k" or "weights"
    log2("[xrs_tgt] %s %s -> %s (%s)", npc:name(), nm(old_id), nm(new_id), why)
end

-- ---------------------------------------------------------------------------
-- morale
-- ---------------------------------------------------------------------------
function friend_lost(npc, friend)
    local id = npc:id()
    local t = lost[id]
    if not t then
        t = {}
        lost[id] = t
    end
    table.insert(t, time_global())
    if #t > 12 then table.remove(t, 1) end
end

-- called by sivol_rout when an NPC breaks
function mark_broken(npc)
    local p = npc:position()
    broke[npc:id()] = { t = time_global(), x = p.x, z = p.z }
end

local function out_of_ammo(npc)
    local bw = xrs_battle_ai.get_best_weapon(npc)
    if not bw then return true end
    return bw:is_weapon_magazined() and bw:get_ammo_total() == 0
end

-- enemies on this NPC above the friends near it
local function crowd(npc, mut_ok)
    local id = npc:id()
    local enemies, friends = 0, 0
    local seen = {}
    for o in npc:memory_visible_objects() do
        local obj = o:object()
        if obj and not seen[obj:id()] and obj:id() ~= id then
            seen[obj:id()] = true
            if obj:is_actor() then
                if npc:is_relation_enemy(obj) and obj:see(npc) and npc:position():distance_to(obj:position()) < 50 then
                    enemies = enemies + 1
                end
            elseif obj:is_stalker() then
                if obj:alive() then
                    if npc:is_relation_enemy(obj) then
                        if xrs_battle_ai.primary_target[obj:id()] == id and not xr_wounded.is_wounded(obj) then
                            enemies = enemies + 1
                        end
                    elseif xrs_battle_ai.friend_is_near(npc, obj) then
                        friends = friends + 1
                    end
                end
            elseif mut_ok and obj:is_monster() and obj:alive() then
                local be = obj:best_enemy()
                if be and be:id() == id then enemies = enemies + 1 end
            end
        end
    end
    return math.max(0, enemies - friends)
end

last_score = {}   -- [npc id] = { score, why }  for who()

-- the break score of an NPC (>= 1 breaks). Returns score, main cause
function morale(npc, r)
    local id = npc:id()
    local now = time_global()
    local target = xrs_battle_ai.get_target(npc)
    local mut_ok = r.mut_rout > 0
    if target and target:is_monster() and not mut_ok then
        last_score[id] = { 0, "mutant" }
        return 0, "mutant"
    end
    local m = morale_k
    local t_wounded = (1 - npc.health) * m.health_k
    local n = 0
    local list = lost[id]
    if list then
        for i = #list, 1, -1 do
            if now - list[i] > m.loss_ms then
                table.remove(list, i)
            else
                n = n + 1
            end
        end
    end
    local t_fear = n * m.loss_k + crowd(npc, mut_ok) * m.crowd_k
    local pos = npc:position()
    for bid, b in pairs(broke) do
        if now - b.t > m.broken_ms then
            broke[bid] = nil
        elseif bid ~= id then
            local dx, dz = b.x - pos.x, b.z - pos.z
            if dx * dx + dz * dz <= m.broken_dist * m.broken_dist then
                t_fear = t_fear + m.broken_k
                break
            end
        end
    end
    local t_ammo = out_of_ammo(npc) and m.ammo_k or 0
    local rank = ranks.get_obj_rank_name(npc)
    local temper = sivol_stealth_suspicion.temper_of(npc)
    local k = r.rout_k * (rank_k[rank] or 1) * (temper_k[temper] or 1)
    local score = (t_wounded + t_fear + t_ammo) * k
    local why = "fear"
    if t_wounded >= t_fear and t_wounded >= t_ammo then
        why = "wounded"
    elseif t_ammo > t_fear then
        why = "ammo"
    end
    last_score[id] = { score, why }
    return score, why
end

-- ---------------------------------------------------------------------------
-- finish the downed gate (section 5): a community with finish_downed = 0 ignores a wounded stalker
-- ---------------------------------------------------------------------------
function enemy_callback(npc, enemy, result)
    if ignore_actor and enemy:is_actor() then
        table.insert(result, false)
        return
    end
    if not enabled then return end
    if not (enemy:is_stalker() and enemy:alive()) then return end
    local r = row(npc)
    if not r or r.finish_downed > 0 then return end
    if not xr_wounded.is_wounded(enemy) then return end
    local key = npc:id() .. ":" .. enemy:id()
    if not gated[key] then
        gated[key] = { n = npc:id(), e = enemy:id() }
        tlog("%s leaves the downed %s alone", npc:name(), enemy:name())
    end
    table.insert(result, false)
end

-- the callback turned memory of a downed enemy off; give it back once he is on his feet again
local function poll_gated()
    for key, g in pairs(gated) do
        local e = level.object_by_id(g.e)
        local n = level.object_by_id(g.n)
        if not e or not n or not e:alive() or not n:alive() then
            gated[key] = nil
        elseif not xr_wounded.is_wounded(e) then
            n:enable_memory_object(e, true)
            gated[key] = nil
            tlog("%s sees %s as an enemy again", n:name(), e:name())
        end
    end
end

-- harness: a freshly spawned NPC is not online yet, so watch/hold cannot reach him at once
local function poll_hold(now)
    local h = hold_wait
    if not h then return end
    if level.object_by_id(h.id) then
        hold_wait = nil
        local ok, err = pcall(function()
            sivol_stealth_test.watch(h.id)
            sivol_stealth_test.hold("free")
        end)
        log2("[sivol_tactics] sneak_duel: victim %d held, %s", h.id, ok and "ok" or ("failed: " .. tostring(err)))
    elseif now - h.t0 > 20000 then
        hold_wait = nil
        log2("[sivol_tactics] sneak_duel: victim %d never came online, not held", h.id)
    end
end

-- wounded stalkers' limp (engine nlc-3.589.170, docs/ALIFE_TACTICS_DESIGN.md 16.10): the level.nlc_limp_mode mask,
-- 1 legs, 2 torso calm (weapon down), 4 torso alert (weapon up, not firing), 8 torso in the panic run. nil = the engine's
-- defaults ([nlc_limp] in system.ltx, all on). Live: fl sivol_tactics.set_limp(3)  (legs and calm torso only), set_limp(15)  (all)
limp_mask = nil
-- the pace of a limping stalker as a share of the normal one (movement speed and legs cycle speed): { run, walk }, nil = the
-- engine's defaults ([nlc_limp] speed_run 0.7, speed_walk 0.85). Live: fl sivol_tactics.set_limp_speed(0.7, 0.85)
limp_speed = nil
-- the health below which the limp starts and at or above which it ends: { enter, exit }, nil = the engine's defaults
-- ([nlc_limp] health 0.4, exit 0.55). Live: fl sivol_tactics.set_limp_health(0.4, 0.55)
limp_health = nil
local limp_applied = false

function set_limp_health(enter, exit)
    local ok = pcall(function() level.nlc_limp_health(enter, exit) end)
    log2("[sivol_tactics] limp health enter %s exit %s%s", tostring(enter), tostring(exit), ok and "" or " (this exe has no nlc_limp_health)")
end

function set_limp_speed(run, walk)
    local ok = pcall(function() level.nlc_limp_speed(run, walk or run) end)
    log2("[sivol_tactics] limp speed run %s walk %s%s", tostring(run), tostring(walk or run), ok and "" or " (this exe has no nlc_limp_speed)")
end

function set_limp(mask)
    local ok = pcall(function() level.nlc_limp_mode(mask) end)
    log2("[sivol_tactics] limp mask %s%s", tostring(mask), ok and "" or " (this exe has no nlc_limp_mode)")
end

function on_update()
    local now = time_global()
    if now < next_poll then return end
    next_poll = now + 500
    if not limp_applied then
        limp_applied = true
        if limp_mask then set_limp(limp_mask) end
        if limp_speed then set_limp_speed(limp_speed[1], limp_speed[2]) end
        if limp_health then set_limp_health(limp_health[1], limp_health[2]) end
    end
    poll_hold(now)
    poll_sidearm(now)
    sivol_melee.poll(now)
    poll_gated()
end

function forget(npc)
    local id = npc:id()
    decision[id] = nil
    recent[id] = nil
    lost[id] = nil
    broke[id] = nil
    last_score[id] = nil
    logged[id] = nil
    retreat_cache[id] = nil
    mh_t[id] = nil
    side_c[id] = nil
    sidearm_seen[id] = nil
    sidearm_pending[id] = nil
    test_ids[id] = nil
end

function on_npc_destroy(npc)
    forget(npc)
    for key, g in pairs(gated) do
        if g.n == npc:id() or g.e == npc:id() then gated[key] = nil end
    end
end

function attach(sm)
    sm:subscribe({ signal = "on_npc_enemy_callback", fun = this.enemy_callback })
    sm:subscribe({ signal = "on_npc_net_destroy", fun = this.on_npc_destroy })
    sm:subscribe({ signal = "on_update", fun = this.on_update })
end

-- ---------------------------------------------------------------------------
-- harness
-- ---------------------------------------------------------------------------
local function flat_dir()
    local d = db.actor:direction()
    local len = math.sqrt(d.x * d.x + d.z * d.z)
    if len < 0.01 then return vector():set(0, 0, 1) end
    return vector():set(d.x / len, 0, d.z / len)
end

-- harness: make the player invisible to stalkers as an enemy (they fight each other and monsters only);
-- invisible(false) gives the memory of the player back to the stalkers close to him
function invisible(on)
    ignore_actor = on and true or false
    if not on and db.actor then
        local n = 0
        for id, _ in pairs(db.storage) do
            local obj = level.object_by_id(id)
            if obj and id ~= db.actor:id() and IsStalker(obj) and obj:alive() then
                obj:enable_memory_object(db.actor, true)
                n = n + 1
            end
        end
        log2("[sivol_tactics] invisible: off, memory restored on %d stalkers", n)
        return
    end
    log2("[sivol_tactics] invisible: %s", tostring(ignore_actor))
end

local function spawn_group(section, n, lvid, gvid)
    if not section or not n or n <= 0 then return 0 end
    local count = 0
    for i = 1, n do
        local ok, err = pcall(function()
            local a = math.random() * 2 * math.pi
            local v = level.vertex_in_direction(lvid, vector():set(math.cos(a), 0, math.sin(a)), math.random(1, 3))
            local pos = level.vertex_position(v)
            local obj = alife():create(section, pos, v, gvid)
            if obj then
                -- same as the spawner dialog (kotovod/spawner.script SpawnStalker): no smart, so the engine
                -- cannot pick one on another level and keep him offline
                if IsStalker(obj) then
                    obj.smart_terrain_conditions = { none = xr_logic.parse_condlist(obj, "smart_terrains", "none", "true") }
                    smart_terrain.unregister_npc(obj)
                    obj:brain():can_choose_alife_tasks(false)
                    log2("[sivol_tactics] %s id=%d smart=%d can_online=%s", section, obj.id, obj:smart_terrain_id(),
                        tostring(obj:can_switch_online()))
                end
                table.insert(made, obj.id)
                test_ids[obj.id] = true
                count = count + 1
            end
        end)
        if not ok then log2("[sivol_tactics] fight: spawn of %s failed: %s", tostring(section), tostring(err)) end
    end
    return count
end

-- two groups across from each other, dist m ahead of the player (sections from creatures/olr_spawn_sections.ltx)
function fight(sect_a, n, sect_b, m, dist)
    if not db.actor then return end
    dist = dist or 40
    local dir = flat_dir()
    local side = vector():set(-dir.z, 0, dir.x)
    local lv = db.actor:level_vertex_id()
    local gv = db.actor:game_vertex_id()
    local mid = level.vertex_in_direction(lv, dir, dist)
    local ca, cb
    if sect_b and m and m > 0 then
        ca = level.vertex_in_direction(mid, side, dist / 2)
        local back = vector():set(-side.x, 0, -side.z)
        cb = level.vertex_in_direction(mid, back, dist / 2)
    else
        ca = mid
    end
    local a = spawn_group(sect_a, n, ca, gv)
    local b = cb and spawn_group(sect_b, m, cb, gv) or 0
    log2("[sivol_tactics] fight: %d x %s, %d x %s, %.0f m ahead", a, tostring(sect_a), b, tostring(sect_b), dist)
end

function clear()
    local n = 0
    for _, id in ipairs(made) do
        local se = alife():object(id)
        if se then
            alife():release(se, true)
            n = n + 1
        end
        test_ids[id] = nil
    end
    made = {}
    hold_wait = nil
    log2("[sivol_tactics] clear: released %d", n)
end

-- one log line per stalker within radius: ranks, temper, target, situation, morale
function who(radius)
    radius = radius or 60
    local pos = db.actor:position()
    local nrows = 0
    for id, _ in pairs(db.storage) do
        local obj = level.object_by_id(id)
        if obj and id ~= db.actor:id() and IsStalker(obj) and obj:alive() and obj:position():distance_to(pos) <= radius then
            local real = ranks.get_obj_rank_name(obj)
            local eff = xrs_battle_ai.get_obj_rank_name(obj)
            local tgt = xrs_battle_ai.get_target(obj)
            local sit, alg, tw = xrs_battle_ai.nlc_who(id)
            local ms = last_score[id]
            log2("[sivol_tactics] who %d %s comm=%s rank=%s eff=%s temper=%s hp=%.2f tgt=%s w=%s sit=%s alg=%s morale=%s%s %s",
                id, obj:name(), obj:character_community(), real, eff, sivol_stealth_suspicion.temper_of(obj), obj.health,
                tgt and tgt:name() or "none", tw and string.format("%.1f", tw) or "-", tostring(sit), tostring(alg),
                ms and string.format("%.2f/%s", ms[1], ms[2]) or "-", xr_wounded.is_wounded(obj) and " WOUNDED" or "",
                sivol_rout.status(id) .. sivol_melee.status(id))
            nrows = nrows + 1
        end
    end
    log2("[sivol_tactics] who: %d stalkers within %.0f m", nrows, radius)
end

function break_npc(id)
    return sivol_rout.force(id)
end

function wound(id)
    local obj = id and level.object_by_id(id)
    if not obj then
        log2("[sivol_tactics] wound: no object %s", tostring(id))
        return
    end
    obj.health = 0.05 - obj.health
    -- the wound manager only re-reads health after a hit or its timer; wake it so the plea state shows
    local ws = db.storage[id] and db.storage[id].wounded
    if ws and ws.wound_manager then ws.wound_manager.recheck_t = 1 end
    log2("[sivol_tactics] wound: %s health set to 0.05", obj:name())
end

-- puts a medkit and a bandage in the NPC's inventory (rows H1 to H4)
function heal_kit(id)
    local obj = id and level.object_by_id(id)
    if not obj then
        log2("[sivol_tactics] heal_kit: no object %s", tostring(id))
        return
    end
    alife():create("medkit", obj:position(), obj:level_vertex_id(), obj:game_vertex_id(), id)
    alife():create("bandage", obj:position(), obj:level_vertex_id(), obj:game_vertex_id(), id)
    log2("[sivol_tactics] heal_kit: medkit + bandage given to %s", obj:name())
end

-- hurts an NPC (fraction of full health taken away) so the treatment rules apply
function hurt(id, amount)
    local obj = id and level.object_by_id(id)
    if not obj then
        log2("[sivol_tactics] hurt: no object %s", tostring(id))
        return
    end
    local h = obj.health
    obj.health = math.max(0.11, h - (amount or 0.4)) - h
    log2("[sivol_tactics] hurt: %s health=%.2f", obj:name(), obj.health)
end

-- harness: a bandit master and a loner, the player invisible to them, sivol_melee.test_instant on, the loner held
-- in place with free vision (sivol_stealth_test.watch / hold). The loner stands dist m ahead, the bandit 18 m
-- beyond him, so the bandit is close enough to start sneaking before it would open fire. Watch [sivol_melee]
-- sneaks on / backstab on. Afterwards: clear(), invisible(false), sivol_melee.test_instant = false,
-- sivol_stealth_test.release().
function sneak_duel(dist)
    if not db.actor then return end
    invisible(true)
    sivol_melee.test_instant = true
    dist = dist or 25
    local dir = flat_dir()
    local lv = db.actor:level_vertex_id()
    local gv = db.actor:game_vertex_id()
    local vlv = level.vertex_in_direction(lv, dir, dist)
    local alv = level.vertex_in_direction(vlv, dir, 18)
    spawn_group("olr_stalker_general", 1, vlv, gv)
    local victim = made[#made]
    spawn_group("olr_bandit_master", 1, alv, gv)
    local assassin = made[#made]
    if not (victim and assassin) then
        log2("[sivol_tactics] sneak_duel: spawn failed")
        return
    end
    -- the victim is held (watch + hold "free") as soon as he is online; poll_hold logs it
    hold_wait = { id = victim, t0 = time_global() }
    log2("[sivol_tactics] sneak_duel: victim id=%s, assassin id=%s", tostring(victim), tostring(assassin))
end

-- harness: the NPC's rifle goes empty (the sidearm rule then fires within 12 m of an enemy)
function empty(id)
    local obj = id and level.object_by_id(id)
    local rifle = obj and obj:item_in_slot(2)
    if not rifle then
        log2("[sivol_tactics] empty: no rifle on %s", tostring(id))
        return
    end
    rifle:set_ammo_elapsed(0)
    log2("[sivol_tactics] empty: %s %s has 0 rounds", obj:name(), rifle:section())
end

-- harness: give the sidearm to an NPC now, even if he was judged before
function give(id)
    local obj = id and level.object_by_id(id)
    if not obj then
        log2("[sivol_tactics] give: no object %s", tostring(id))
        return
    end
    sidearm_pending[obj:id()] = nil
    give_sidearm(obj)
end

-- harness: a bandage into the NPC's inventory (a "kit" bandage: used below bandage_health, not the free one)
function give_bandage(id)
    local obj = id and level.object_by_id(id)
    if not obj then
        log2("[sivol_tactics] give_bandage: no object %s", tostring(id))
        return
    end
    alife():create("bandage", obj:position(), obj:level_vertex_id(), obj:game_vertex_id(), obj:id())
    log2("[sivol_tactics] give_bandage: a bandage given to %s", obj:name())
end
