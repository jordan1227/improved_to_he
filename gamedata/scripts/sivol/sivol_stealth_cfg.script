-- sivol: stealth tuning layer (docs/STEALTH_DESIGN.md, section 10).
--
-- Holds the nlc_stealth engine parameters and pushes them to the engine when the
-- module loads, so a hot reload (`rl scripts sivol_stealth_cfg`) applies edited
-- file values. After a save load the Lua state is new but the engine keeps its
-- values: values changed live in this session (engine value differs from the file)
-- are kept and logged; reset_defaults() returns to the file. Shipped values are
-- tuned values (docs/STEALTH_DESIGN.md 11 to 13); logs off. Vision section values
-- (luminocity_factor, time_quant, transparency_factor) live in m_stalker.ltx.
--
-- Live use from the console:
--   g_loadstring sivol_stealth_cfg.set("danger_rate_mult", 0.4)
--   g_loadstring sivol_stealth_cfg.dump()
--   g_loadstring sivol_stealth_cfg.reset_defaults()
-- Copy accepted values back into `params` below.
-- Measurement helpers live in sivol_stealth_test.script.

params = {
    log_vision = 0,                    -- per-update vision lines for watched observers
    log_sound = 0,                     -- actor-sound perception lines for watched observers
    log_events = 0,                    -- sight / enemy / monster acquisition events for every observer
    log_interval_ms = 0,               -- min gap between per-update lines per observer (0 = every update)
    log_cap_per_min = 300,             -- global line cap per minute
    free_rate_mult = 1,                -- stalker free-profile detection speed multiplier
    danger_rate_mult = 1,              -- stalker danger-profile detection speed multiplier
    monster_rate_mult = 1,             -- monster detection speed multiplier
    lum_factor_override = -1,          -- stalker luminocity_factor (-1 = vision section value)
    transparency_factor_override = -1, -- stalker transparency_factor (-1 = vision section value)
    force_profile = -1,                -- debug, watched observers only: 0 free, 1 danger vision (-1 = own state)
    sky_k = 8,                         -- AI sky light weight for stalker observers (0 = engine luminosity only)
    sky_scale = 0.08,                  -- renderer hemi scale the sky visibility is divided by (keep 0.08)
    sky_pow = 1.5,                     -- sky brightness exponent: > 1 favours bright (day) skies over dim (night) ones
    vel_physics = 1,                   -- 1: actor speed from physics movement instead of the noisy position history
    crouch_k = 0.85,                   -- detection rate factor while crouched
    creep_k = 0.7,                     -- detection rate factor in low crouch (crouch + accelerate)
    torch_k = 0.5,                     -- light from an observer's own flashlight on the actor (cone centre, zero distance)
    torch_cone = 40,                   -- flashlight cone, full angle in degrees
    flash_k = 1,                       -- muzzle flash light after an unsuppressed shot, scaled by darkness
    flash_ms = 300,                    -- muzzle flash fade time
    near_k = 0.3,                      -- near-range contrast: light added at zero distance, fading as (1 - d / near_range)^2
    near_range = 25,
    rank_k_novice = 1,                 -- detection rate factor per observer rank
    rank_k_experienced = 1.15,
    rank_k_veteran = 1.3,
    rank_k_master = 1.5,
    mem_hold_ms = 1500,                -- stalker keeps its "almost noticed" sum this long after losing sight of the actor (0 = instant reset)
    mem_decay_s = 8,                   -- then drains it from the full threshold to zero in this many seconds (0 = drop at once)
    ray_resample = 1,                  -- 1: stalkers trace a new point of the actor's body every update, so partial cover counts (pairs with the decay)
    fakehit_min_pow = 0,               -- a heard actor shot counts as "being shot at" (hit memory) only at this weighted power or more (0 = always)
    outfit_vis = 1,                    -- 1: hidden outfit key stealth_visibility_k (all_outfits_nlc.ltx) scales detection
    rain_k = 0.25,                     -- detection rate x (1 - rain_k x rain density)
    nvd_floor = 0.04,                  -- night-vision wearers (sivol_stealth_nvd) see the actor at no less than this light level
    npc_light_k = 0,                   -- 0..1: light model for NPCs seeing NPCs (0 = vanilla, always lit); test before raising
    npc_sky_vis = 0.35,                -- npc_light_k: assumed sky visibility of an NPC target
    npc_sun_k = 0.5,                   -- npc_light_k: share of sunlight an NPC target gets on average
    glow_offset = 0.08,                -- night-vision eye glow: metres in front of the eyes (horizontal)
    glow_up = 0.02,                    -- night-vision eye glow: metres up from the eyes
    -- mutants (docs/STEALTH_DESIGN.md 16); species keys live in config/creatures/m_*.ltx
    monster_ray_resample = 1,          -- 1: monsters trace a new point of the actor's body every update (partial cover)
    monster_mem_hold_ms = 1500,        -- monsters keep their "almost noticed" sum this long after losing sight
    monster_mem_decay_s = 8,           -- then drain it in this many seconds
    monster_notice_v = 0.4,            -- a monster past this share of detection goes to sniff around (0 = off)
    monster_notice_ms = 3000,          -- min gap between such impulses per monster
    sense_mult = 1,                    -- psy / smell aura speed multiplier (0 = auras off)
    pack_gate = 1,                     -- 1: pack mates share the actor only within pack_share_range and after a delay
    -- shots, near misses, corpses (docs/STEALTH_DESIGN.md 17); suppressed ranges in config/ogg_comments_overrides.ltx are outer radii
    shot_alert_pow = 0.56,             -- stalkers: a heard actor shot weaker than this (outer ring) is suspicion, not danger (0 = off)
    monster_shot_alert_pow = 0.28,     -- monsters: same on raw power; species key shot_alert_pow overrides (0 = off)
    near_miss_range = 3,               -- an actor bullet passing this close to a creature makes it look / take cover (0 = off)
    near_miss_value = 0.6,             -- stalkers: suspicion value of a near miss (notice band)
    heard_ms = 1500,                   -- how long a heard concern counts as suspicion
    corpse_check = 1,                  -- 1: pack mates check a killed member's corpse (species corpse_check_count / radius)
    -- docs/STEALTH_DESIGN.md 18
    concern_escalate = 1,              -- 1: repeated near misses / faint shots: hurry, then attack (bold species) or flee (timid)
    concern_window_ms = 20000,         -- concern events count together within this time
    firsthand_ms = 5000,               -- pack mates pass the actor on only if they sensed him themselves this recently (no relay chains)
    step_alert_pow = 0.5,              -- stalkers: actor footsteps weaker than this are suspicion, not danger (walk and crouch-walk always)
    outfit_noise = 1,                  -- 1: hidden outfit key stealth_noise_k scales footstep noise
    surface_noise = 1,                 -- 1: [nlc_step_surface] (m_stalker.ltx) scales footstep noise by ground material
    rain_mask = 0.3,                   -- quiet actor sounds x (1 - rain_mask x rain density)
    lamp_k = 1,                        -- dynamic lamps light the actor for AI (0 = off)
    lamp_period_ms = 250,              -- lamp light recomputed this often
}

-- Per-NPC vision sections (engine nlc_stealth_set_vision), applied on every NPC spawn,
-- including save loads. Key: NPC name or character profile id; value: { free, danger }.
-- Live toggle: g_loadstring sivol_stealth_cfg.set_vision_profiles(false)
use_vision_profiles = true
vision_profiles = {
    -- Agroprom tower snipers (camper idle in danger mental, so the danger slot matters most):
    -- the three towers and agr_sak_nii_soldier_03 share this character profile
    agr_soldier_sniper = { "stalker_vision_tower_sniper", "stalker_vision_tower_sniper" },
    agr_tower1_soldier = { "stalker_vision_tower_sniper", "stalker_vision_tower_sniper" },
    agr_tower2_soldier = { "stalker_vision_tower_sniper", "stalker_vision_tower_sniper" },
    agr_tower3_soldier = { "stalker_vision_tower_sniper", "stalker_vision_tower_sniper" },
}

local defaults = {}
for name, value in pairs(params) do
    defaults[name] = value
end

-- the engine's built-in values (nlc_stealth.cpp); an engine value equal to these was
-- not changed live, so the file value applies
local ENGINE_DEFAULTS = {
    log_vision = 0, log_sound = 0, log_events = 0, log_interval_ms = 0, log_cap_per_min = 300,
    free_rate_mult = 1, danger_rate_mult = 1, monster_rate_mult = 1,
    lum_factor_override = -1, transparency_factor_override = -1, force_profile = -1,
    sky_k = 0, sky_scale = 0.08, sky_pow = 1, vel_physics = 0, crouch_k = 1, creep_k = 1,
    torch_k = 0, torch_cone = 40, flash_k = 0, flash_ms = 300,
    near_k = 0, near_range = 25,
    rank_k_novice = 1, rank_k_experienced = 1, rank_k_veteran = 1, rank_k_master = 1,
    mem_hold_ms = 0, mem_decay_s = 0, fakehit_min_pow = 0,
    ray_resample = 0, outfit_vis = 0, rain_k = 0, nvd_floor = 0, npc_light_k = 0,
    npc_sky_vis = 0.35, npc_sun_k = 0.5, glow_offset = 0.04, glow_up = 0,
    monster_ray_resample = 0, monster_mem_hold_ms = 0, monster_mem_decay_s = 0, monster_notice_v = 0,
    monster_notice_ms = 3000, sense_mult = 1, pack_gate = 0,
    shot_alert_pow = 0, monster_shot_alert_pow = 0, near_miss_range = 0, near_miss_value = 0.6, heard_ms = 1500,
    corpse_check = 0, concern_escalate = 0, concern_window_ms = 20000, firsthand_ms = 0, step_alert_pow = 0,
    outfit_noise = 0, surface_noise = 0, rain_mask = 0, lamp_k = 0, lamp_period_ms = 250,
}

local function engine_ready()
    return type(nlc_stealth_set) == "function"
end

-- keep_live: leave a parameter whose engine value already differs from the file
-- (changed live earlier in this session) and log it
function apply(keep_live)
    if not engine_ready() then
        log2("! [stealth] nlc_stealth_* functions missing: engine older than nlc-3.589.4")
        return false
    end
    local ok = true
    for name, value in pairs(params) do
        local current = nlc_stealth_get(name)
        local builtin = ENGINE_DEFAULTS[name]
        if keep_live and current and math.abs(current - value) > 1e-6 and not (builtin and math.abs(current - builtin) < 1e-6) then
            params[name] = current
            log2("~ [stealth] kept live %s=%s (file %s)", name, tostring(current), tostring(value))
        elseif not nlc_stealth_set(name, value) then
            ok = false
        end
    end
    return ok
end

function set(name, value)
    if params[name] == nil then
        log2("! [stealth] unknown parameter [%s]", tostring(name))
        return false
    end
    value = tonumber(value)
    if not value or not engine_ready() or not nlc_stealth_set(name, value) then
        return false
    end
    params[name] = value
    log2("~ [stealth] %s=%s", name, tostring(value))
    return true
end

function get(name)
    return params[name]
end

function reset_defaults()
    for name, value in pairs(defaults) do
        params[name] = value
    end
    return apply()
end

function dump()
    for name, value in pairs(params) do
        log2("~ [stealth] script %s=%s", name, tostring(value))
    end
    if engine_ready() then
        nlc_stealth_dump()
    end
end

local function vision_profile(obj)
    local p = vision_profiles[obj:name()]
    if p then
        return p
    end
    local profile = obj:profile_name()
    return profile and vision_profiles[profile]
end

-- on: the profile from vision_profiles; off: the sections of the NPC's own config section
local function apply_vision(obj, on)
    if type(nlc_stealth_set_vision) ~= "function" or not obj:alive() then
        return
    end
    local p = vision_profile(obj)
    if not p then
        return
    end
    if on then
        nlc_stealth_set_vision(obj:id(), p[1], p[2])
    else
        local ini, section = system_ini(), obj:section()
        nlc_stealth_set_vision(obj:id(), ini:r_string(section, "vision_free_section"), ini:r_string(section, "vision_danger_section"))
    end
end

-- the engine reloads the NPC's own vision sections before the binder's net_spawn
local function on_npc_spawn(obj)
    if use_vision_profiles then
        apply_vision(obj, true)
    end
end

function set_vision_profiles(on)
    use_vision_profiles = on and true or false
    for id in pairs(db.storage) do
        local obj = level.object_by_id(id)
        if obj and obj:is_stalker() then
            apply_vision(obj, use_vision_profiles)
        end
    end
    log2("~ [stealth] use_vision_profiles=%s", tostring(use_vision_profiles))
end

local function on_first_update()
    -- object ids from the previous session must not stay watched
    if engine_ready() then
        nlc_stealth_unwatch_all()
    end
    apply(true)
end

function attach(sm)
    sm:subscribe({ signal = "on_first_update", fun = on_first_update })
    sm:subscribe({ signal = "on_npc_spawn", fun = on_npc_spawn })
end

-- module load: a hot reload in game (actor present) applies the file; a load during
-- game start or save load keeps values changed live earlier in this session
if engine_ready() then
    apply(not (db and db.actor))
end
