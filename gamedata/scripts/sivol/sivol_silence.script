-- sivol_silence.script
-- Silence ("Tishina") anomaly, the player's side (docs/ANOMALY_DESIGN.md 16).
-- The engine (nlc-3.589.191, CCustomZone key nlc_silence, config/misc/zone_silence.ltx) keeps the AI from hearing
-- sounds made inside the zone or heard from inside it. This script fades the world out for the actor: the listener
-- filter (gain + high frequencies) by depth, starting a little outside the edge, so walking in is readable. The
-- listener filter is owned by sivol_mask_audio.script (gas mask): this script adds a named contribution there.
--
-- Zones are tracked from on_anomaly_spawn and from amk_anoms' own on / off status (a zone spawned in the pending
-- "off" set is switched on after an emission without a spawn signal).
--
-- Console:
--   fl sivol_silence.spawn()                  average tier, 8 m ahead, radius 6
--   fl sivol_silence.spawn("strong", 10, 6)   tier, distance, radius
--   fl sivol_silence.status()                 zones known, the actor's silence level, the engine counters
--   fl sivol_silence.set_log(true)

local SMOOTH_PER_S = 2.5   -- how fast the actor's silence level follows the depth
-- entry effect: a blink as the actor crosses the edge of a zone (not again within the cooldown)
local ENTRY_PPE         = "blink.ppe"
local ENTRY_PPE_ID      = 98331
local ENTRY_COOLDOWN_MS = 6000
local was_inside = false
local entry_next = 0
local CONTRIB = "silence"  -- name of the contribution in sivol_mask_audio

local zones = {}           -- [id] = { r, edge, gain, hf, approach, ramp_k, section, name }
local level_s = 0          -- current silence level of the actor, 0..1
local sent_s = -1
local last_time = 0
local log_on = false

local function log(fmt, ...)
	if log_on then log2("[sivol_silence] " .. fmt, ...) end
end

function set_log(v)
	log_on = v and true or false
end

local function is_silence(sec)
	return sec ~= nil and string.find(sec, "silence", 1, true) ~= nil and get_bool(sec, "nlc_silence", false)
end

local function register(obj, why)
	if not obj then return end
	local sec = obj:section()
	if not is_silence(sec) then return end
	local id = obj:id()
	local ok, r = pcall(obj.get_shape_radius, obj)
	r = ok and tonumber(r) or 0
	if r <= 0 then r = 6 end
	zones[id] = {
		r = r,
		edge = get_float(sec, "silence_actor_edge", 0.55),
		gain = get_float(sec, "silence_actor_gain", 0.12),
		hf = get_float(sec, "silence_actor_hf", 0.08),
		approach = get_float(sec, "silence_approach", 2.5),
		ramp_k = get_float(sec, "silence_ramp_k", 0.5),
		section = sec,
		name = obj:name(),
	}
	log("registered %s id=%d r=%.1f (%s)", sec, id, r, why)
end

-- the actor's silence level for one zone: 0 outside the approach band, edge at the surface, 1 past ramp_k of the radius
local function level_for(z, d)
	if d >= z.r + z.approach then return 0 end
	if d >= z.r then
		return z.edge * (1 - (d - z.r) / math.max(0.1, z.approach))
	end
	local k = math.max(0, math.min(1, (z.r - d) / math.max(0.1, z.r * z.ramp_k)))
	return z.edge + (1 - z.edge) * k
end

local function send(s, z)
	s = math.floor(s * 50 + 0.5) / 50
	if s == sent_s then return end
	sent_s = s
	if not (sivol_mask_audio and sivol_mask_audio.set_contribution) then return end
	if s <= 0 or not z then
		sivol_mask_audio.set_contribution(CONTRIB, nil)
	else
		sivol_mask_audio.set_contribution(CONTRIB, 1 + (z.gain - 1) * s, 1 + (z.hf - 1) * s)
	end
end

local last_zone
local function update()
	local actor = db.actor
	local now = time_global()
	local dt = (now - last_time) / 1000
	last_time = now
	if dt > 1 or dt < 0 then dt = 0 end

	local target, deep = 0, nil
	local inside = false
	if actor and actor:alive() then
		local pos = actor:position()
		for id, z in pairs(zones) do
			local obj = level.object_by_id(id)
			if not obj then
				zones[id] = nil
			else
				local d = pos:distance_to(obj:position())
				local s = level_for(z, d)
				if s > target then target, deep = s, z end
				if d < z.r then inside = true end
			end
		end
	end
	if inside and not was_inside and now >= entry_next then
		entry_next = now + ENTRY_COOLDOWN_MS
		level.add_pp_effector(ENTRY_PPE, ENTRY_PPE_ID, false)
	end
	was_inside = inside
	level_s = level_s + (target - level_s) * math.min(1, dt * SMOOTH_PER_S)
	if math.abs(level_s - target) < 0.01 then level_s = target end
	last_zone = deep or last_zone
	if level_s <= 0 then last_zone = nil end
	send(level_s, last_zone)
end

local function on_anomaly_spawn(obj, binder, tag)
	if tag == "tide" then return end
	register(obj, "spawn")
end

local function on_anomaly_net_destroy(obj, binder, tag)
	if tag == "tide" or not obj then return end
	zones[obj:id()] = nil
end

-- amk_anoms.set_online_anomaly_status: "on" enables the zone, "off" / "del" disable it (the engine side follows the
-- zone's own enabled state)
function on_amk_status(id, status)
	if status == "on" then
		register(level.object_by_id(id), "amk on")
	elseif zones[id] then
		log("%s released: amk status %s", zones[id].name, tostring(status))
		zones[id] = nil
	end
end

local function reset()
	level_s, sent_s, last_zone = 0, -1, nil
	was_inside, entry_next = false, 0
	send(0)
end

function spawn(tier, distance, radius)
	tier = tier or "average"
	local sec = "zone_silence_" .. tier
	if not sivol.spawn_anomaly_near then return end
	return sivol.spawn_anomaly_near(sec, distance or 8, radius or 6)
end

function status()
	local n = 0
	for _ in pairs(zones) do n = n + 1 end
	local ez = level.nlc_silence_zones and level.nlc_silence_zones() or -1
	local em = level.nlc_silence_muted and level.nlc_silence_muted() or -1
	log2("[sivol_silence] zones=%d actor_level=%.2f engine: zones=%d weakened_sound_deliveries=%d", n, level_s, ez, em)
	if db.actor then
		local pos = db.actor:position()
		for id, z in pairs(zones) do
			local obj = level.object_by_id(id)
			if obj then
				local d = pos:distance_to(obj:position())
				if d < 60 then
					log2("[sivol_silence]   id=%d %s %.1f m from the centre, r=%.1f, level here %.2f", id, z.name, d, z.r, level_for(z, d))
				end
			end
		end
	end
end

function attach(sm)
	sm:subscribe({ signal = "on_update", fun = update })
	sm:subscribe({ signal = "on_anomaly_spawn", fun = on_anomaly_spawn })
	sm:subscribe({ signal = "on_anomaly_net_destroy", fun = on_anomaly_net_destroy })
	sm:subscribe({ signal = "on_spawn", fun = reset })
end
