
-- [HE-PORT] proxy: staroe hranilishche nlc_vars poverh dvizhkovogo xvars (get_value/set_value iz _g)
if nlc_vars == nil then
  nlc_vars = setmetatable( {}, {
    __index    = function( t, k ) return get_value( "nlc_vars." .. k ) end,
    __newindex = function( t, k, v ) set_value( "nlc_vars." .. k, v ) end,
  } )
end

-- [HE-PORT] adapter starogo xray_vars (NLC HE) poverh get_value/set_value (OGSR _g).
-- Staryj variant hranil tablicy v xvars.nlc[name]; zdes' -- ploskij klyuch "nlc_vars.<name>",
-- kak v alpet/list_tools.script.

function load_table( from, name, default )
  return get_value( "nlc_vars." .. name, default )
end

function save_table( name, tbl )
  set_value( "nlc_vars." .. name, tbl )
end
