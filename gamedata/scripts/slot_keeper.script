-- [HE-PORT]

local saved_slot = nil
local anim_defer_since = nil
local restore_held = false
local restore_session = nil
local hold_owner = nil

local function cancel_restore(reason)
    if restore_session then hud_animation_session.cancel(restore_session, reason); restore_session = nil end
end

function ui_is_open()
	if level.main_input_receiver() then return true end
	if level.get_inventory_wnd():IsShown() then return true end
	if level.get_car_body_wnd():IsShown() then return true end
	return false
end

function anim_locked()
	return level.only_movekeys_allowed() or not game.hud_motion_allowed()
		or (hud_animation_owner and hud_animation_owner.busy and hud_animation_owner.busy())
end

function restore_deferred()
	if restore_held then
		anim_defer_since = nil
		return true
	end
	if ui_is_open() then
		anim_defer_since = nil
		return true
	end
	if anim_locked() then
		if not anim_defer_since then
			anim_defer_since = time_global()
		end
		return time_global() - anim_defer_since < 10000
	end
	anim_defer_since = nil
	return false
end

function remember(owner)
	if owner and hud_animation_owner and not hud_animation_owner.valid(owner) then return false end
	if not owner and hud_animation_owner and hud_animation_owner.busy and hud_animation_owner.busy() then return false end
	if saved_slot and (restore_held or ui_is_open() or anim_locked()) then return end
	local slot = db.actor and db.actor:active_slot()
	if slot and slot ~= NO_ACTIVE_SLOT then
		saved_slot = slot
		log2( "saved slot is %s", saved_slot )
	end
	return true
end

function hold(owner)
    if owner and hud_animation_owner and not hud_animation_owner.valid(owner) then
        return false
    end
    if restore_session and hud_animation_session.valid(restore_session) then
        saved_slot = saved_slot or restore_session.slot
    end
    cancel_restore("superseded")
	restore_held = true
	hold_owner = owner or hold_owner
	return true
end

local function weapon_blocked()
	return bind_stalker.self_weapon_hide == true
end

local function activate_saved(st, slot, tries)
    if not hud_animation_session.valid(st) or restore_session ~= st then return end
    if restore_held or ui_is_open() or anim_locked() or weapon_blocked() then
        saved_slot = saved_slot or slot
        cancel_restore("blocked")
        return
    end
    if db.actor:active_slot() == slot then cancel_restore("complete"); return end
    db.actor:activate_slot(slot)
    if tries <= 0 then cancel_restore("complete"); return end
    hud_animation_session.after(st, 300, function()
        if db.actor:active_slot() == slot or db.actor:active_item() then cancel_restore("complete"); return end
        activate_saved(st, slot, tries - 1)
    end)
end

function restore()
    if restore_held or not saved_slot then return end
    local slot = saved_slot
    saved_slot = nil
    cancel_restore("superseded")
    local st
    st = hud_animation_session.new("slot restore", function(reason)
        if hud_animation_session.valid(st) then saved_slot = saved_slot or slot end
        cancel_restore(reason)
    end)
    st.slot = slot
    restore_session = st
    hud_animation_session.wait(st, function()
        return not (restore_held or ui_is_open() or anim_locked() or weapon_blocked())
    end, function() activate_saved(st, slot, 6) end, 11000)
end

function release(owner)
	if owner and hold_owner and hold_owner ~= owner then return false end
	if not owner and hud_animation_owner and hud_animation_owner.busy and hud_animation_owner.busy() then return false end
	restore_held = false
	hold_owner = nil
	restore()
	return true
end

function take()
    local pending_slot = restore_session and hud_animation_session.valid(restore_session) and restore_session.slot or nil
	local slot = saved_slot or pending_slot
    cancel_restore("superseded")
	saved_slot = nil
	return slot
end

function restore_slot(slot)
	if not slot then return end
	saved_slot = slot
	restore()
end

function reset()
    cancel_restore("reset")
	saved_slot = nil
	anim_defer_since = nil
	restore_held = false
	hold_owner = nil
end
