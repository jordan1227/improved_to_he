-- by alpet 13.02.2011 ...
-- inv_object as CInventoryItem* = wpn_object-D8
-- wpn_object as CWeapon*

function get_zie_obj()
	if find_effector_zi then
		return find_effector_zi()
	end
end

wpn_params.get_zie_obj = get_zie_obj

function find_zie_obj()
	local eff_obj = wpn_params.get_zie_obj(nc)
	if eff_obj then
		wprintf("[~T]. #DBG: zie at %s", eff_obj:format())
	else
		wprintf("[~T]. #WARN: not found zie")
	end
	return eff_obj
end

wpn_params.find_zie_obj = find_zie_obj

function cut_suffix(k, suffix)
	local slen = suffix:len()
	local real = k:sub(-slen)
	if real == suffix then
		local kl = k:len()
		if kl > slen then
			-- wprintf(" cut %s from %s, %d - %d ", real, k, kl, slen)
			k = k:sub(1, kl - slen)
		end
	end
	return k
end

function zupd(k, v, test, eff_obj)
	if eff_obj == nil then
		eff_obj = wpn_params.get_zie_obj()
	end

	if (eff_obj == nil) then
		return
	end

	local ck = cut_suffix(k, "_int")
	if eff_obj[ck] ~= nil then
		eff_obj[ck] = v
	else
		wprintf("~C0C#WARN(zupd):~C07 zie not supported propery %s [%s] ", ck, k)
	end
end

wpn_params.zupd = zupd

wpn_params.disp_add = {17, -17, 5}

wpn_params.zoom_time = 1

local base_radius = 0
local disp_angles = {0, 0, 0}
local disp_radius = {0.01, 0.001, 0.005}

function inc_angle(idx)
	local a = wpn_params.disp_add[idx]
	wpn_params.disp_add[idx] = a

	local v = disp_angles[idx] + a

	if v < 0 then
		v = v + 360
	elseif v >= 360 then
		v = v - 360
	end
	disp_angles[idx] = v
end

-- Weapon-specific sway registration is maintained by sivol_weapon.AUDITED_SECTION_TO_CLASS.
-- Keep this module focused on applying the effector wobble and its smoothing.

local wobble_x    = 0
local wobble_y    = 0
local base_wobble = 2
local base_radius = 0
local last_cond   = 1
local wpn_id      = 1
local flag_wpn    = true
local wobble_last_time = 0
local smoothed_wobble_radius = 0
local mass_signature = nil
-- CEffectorZoomInertion is an additive rendered-direction overlay. Track its
-- last direction so ADS exit can retain the exact visible aim position.
local wobble_overlay_active = false
local wobble_exit_rebased = false
local wobble_last_render_dir = nil
local WOBBLE_SHOT_HOLD_MS = 100
local WOBBLE_SHOT_RESUME_RATE = 8.0
local WOBBLE_DIRECTION_EPSILON = 0.0000001
local wobble_output_y = 0
local wobble_previous_output_y = 0
local wobble_vertical_velocity = 0
local wobble_vertical_direction = "still"
local wobble_shot_hold_y = 0
local wobble_shot_hold_until = 0
local wobble_shot_resume_active = false
local wobble_damper_state = "idle"
wpn_params.current_weight_sens = 0.5
wpn_params.current_speed_k     = 1.0
local DEG_TO_RAD  = math.pi / 180
zoom_weapon       = false
gg_tired          = 1


local ready = false
function wpn_params.mark_ready() ready = true end

local function wobble_dt()
    local now = time_global() / 1000
    local dt = (wobble_last_time == 0) and 0.016 or (now - wobble_last_time)
    wobble_last_time = now
    if dt <= 0 or dt > 0.25 then return 0.016 end
    return dt
end

local function exp_lerp(current, target, rate, dt)
    return current + (target - current) * (1 - math.exp(-rate * dt))
end

local function get_rendered_pitch()
    local ok, pitch = pcall(function()
        return device().cam_dir:getP()
    end)
    if ok and type(pitch) == "number" then return pitch end
    return 0
end

-- Shared, shot-only state for the recoil controller's cross-system probe.
-- wobble_y is the final local vertical offset sent to CEffectorZoomInertion;
-- velocity/direction describe that offset rather than the actor camera.
function wpn_params.get_wobble_debug_state()
    return {
        rendered_pitch = get_rendered_pitch(),
        wobble_y = wobble_output_y,
        wobble_vertical_velocity = wobble_vertical_velocity,
        wobble_vertical_direction = wobble_vertical_direction,
        effective_radius = smoothed_wobble_radius,
        damper_state = wobble_damper_state,
        overlay_active = wobble_overlay_active,
    }
end

-- Hold the present vertical wobble position briefly after a real firearm shot,
-- then converge back to the continuously advancing raw phase. Horizontal sway
-- and the underlying phase keep moving, so release cannot create a phase reset.
function wpn_params.on_recoil_shot()
    local snapshot = wpn_params.get_wobble_debug_state()
    if wobble_overlay_active then
        wobble_shot_hold_y = wobble_output_y
        wobble_shot_hold_until = time_global() + WOBBLE_SHOT_HOLD_MS
        wobble_shot_resume_active = true
        wobble_vertical_velocity = 0
        wobble_vertical_direction = "still"
        wobble_damper_state = "hold"
    end
    return snapshot
end

-- Bake the final displayed wobble direction into the actor camera once. The
-- zoom effector itself has no API for rebasing its overlay onto the camera.
local function rebase_wobble_exit_camera(direction)
    if not direction or not coord_params or not coord_params.camera_angles then return end
    local final_dir = vector():set(direction)
    coord_params.camera_angles(-final_dir:getH(), -final_dir:getP())
end

function scope_wobble()
    ogse_signals.get_mgr():reschedule(70)
    local dt = wobble_dt()

    if not ready then return end
    local actor = db.actor
    local sleepiness = sleep_manager.get_sleepiness()
    local eff_obj = wpn_params.get_zie_obj()
    if eff_obj == nil then
        -- Fallback for lifecycle paths that do not emit zoom-out: retain the
        -- last rendered direction rather than letting the overlay vanish back
        -- to the ADS-entry direction.
        if wobble_overlay_active and not wobble_exit_rebased and wobble_last_render_dir then
            rebase_wobble_exit_camera(wobble_last_render_dir)
            if sivol_weapon and sivol_weapon.weapon_breath_diagnostics then
                log2("[weapon_wobble] rebased final ADS direction via exit fallback")
            end
        end
        wobble_overlay_active = false
        wobble_exit_rebased = false
        wobble_last_render_dir = nil
        wobble_output_y = 0
        wobble_previous_output_y = 0
        wobble_vertical_velocity = 0
        wobble_vertical_direction = "still"
        wobble_shot_hold_until = 0
        wobble_shot_resume_active = false
        wobble_damper_state = "idle"
        wpn_params.zoom_time = 1
        return
    end
    local slot  = actor:active_slot()
    zoom_weapon = actor:item_in_slot( slot )
    wpn_params.zoom_weapon = zoom_weapon
    local wpn = nil
    if zoom_weapon then wpn = zoom_weapon:get_weapon() end
    local current_signature = zoom_weapon and sivol_weapon and sivol_weapon.get_weapon_mass_signature
        and sivol_weapon.get_weapon_mass_signature(zoom_weapon, zoom_weapon:section()) or nil
    if current_signature ~= mass_signature then flag_wpn = true end
    -- OGSR: get actor obj once, used for all stance checks below
    local aobj = get_actor_obj()

    if wpn_params.zoom_time <= 1 then
        if wpn ~= nil then
            wpn.const_deviation.pitch = 0
            wpn.const_deviation.yaw   = 0
        end
        local sign1 = (math.random(0, 1) == 0) and 1 or -1
        local sign3 = (math.random(0, 1) == 0) and 1 or -1
        wpn_params.disp_add[ 1 ] = sign1 * 12
        wpn_params.disp_add[ 2 ] = 12
        wpn_params.disp_add[ 3 ] = sign3 * 12
        base_radius  = 0
        smoothed_wobble_radius = 0
        wobble_output_y = 0
        wobble_previous_output_y = 0
        wobble_vertical_velocity = 0
        wobble_vertical_direction = "still"
        wobble_shot_hold_until = 0
        wobble_shot_resume_active = false
        wobble_damper_state = "idle"
        last_cond    = 1
        flag_wpn     = true
        wpn_params.last_stance = nil
    end
    wobble_x = 0
    wobble_y = 0
    if flag_wpn then
        local wpn = actor:active_item()
        local sec = wpn and wpn:section()
        if sec then
            -- Knives are deliberately outside the weapon-breath/wobble system:
            -- no mass calculation, no stamina sensitivity, and no added sway.
            if sivol_weapon.is_wobble_exempt and sivol_weapon.is_wobble_exempt(sec) then
                base_wobble = 0
                wpn_params.current_weight_sens = 0
                wpn_params.mastery_k = 1
                wpn_params.current_speed_k = 1
            else
                -- Use the live CWeapon.inv_weight-backed mass statistics. This
                -- keeps handling tied to the actual held item, not a filename.
                local stats = sivol_weapon.get_weapon_mass_stats(wpn, sec)
                base_wobble = stats.wobble
                wpn_params.current_weight_sens = stats.weight_sens
                wpn_params.mastery_k = sivol_weapon.get_mastery_k(sec)
                wpn_params.current_speed_k = math.max(0.3, math.min(1.5, 0.375 * base_wobble + 0.175))
            end

            local arm6 = actor:item_in_slot( 6 )
            if arm6 ~= nil and string.find( arm6:section(), "exo" ) then
                base_wobble = base_wobble * 0.75
            end
			local dif = tonumber(level.get_game_difficulty())
			if dif == 0 then
				base_wobble = base_wobble * 0.95
			end

            if get_value( "nlc_vars.add_wobble" ) == true then base_wobble = base_wobble * 1.25 end -- [HE-PORT]
            if black_tip and black_tip.have_black_tip() then base_wobble = base_wobble * 1.3 end

            wpn_id   = wpn:id()
            mass_signature = current_signature
            flag_wpn = false
        end
    end

    local cond = params.obj_condition( wpn_id )
    if cond < last_cond then
        last_cond = cond
        if wpn_params.zoom_time > 1 then
            local h, p = coord_params.camera_angles()
            local hofs = 0.001 * math.random() - 0.0005
            local pofs = 0.03 * math.random() - 0.015
            coord_params.camera_angles( h + hofs, p + pofs )
            base_radius = 0
            wpn_params.zoom_time = 1
        end
    end

    local div_limit = 10

    -- OGSR: derive stance from native is_actor_crouch()/is_actor_creep()
    -- instead of HE's get_crouch_factor(). Same 0/1/2 semantics preserved.
    local current_stance = 0
    if aobj and aobj:is_actor_creep() then current_stance = 2
    elseif aobj and aobj:is_actor_crouch() then current_stance = 1 end

    -- === Stance Change Detection & Bump ===
    if wpn_params.last_stance == nil then
        wpn_params.last_stance = current_stance
    end

    if wpn_params.last_stance ~= current_stance then
        if wpn_params.zoom_time > 1.05 then
            wpn_params.zoom_time = 1.01
        end
        wpn_params.last_stance = current_stance
    end
    -- ======================================

    -- NOTE: div_limit 20/40 carried over from HE as a starting point.
    -- OGSR's native crouch/creep booleans should map onto these the same
    -- way HE's crouch==1/2 did, but worth a quick in-game feel-check
    -- since it's still a balance value, not just an API swap.
    if current_stance == 1 and sleepiness < 170 then
        wpn_params.zoom_time = wpn_params.zoom_time + 0.07
        div_limit            = 20
    elseif current_stance == 2 and sleepiness < 170 then
        wpn_params.zoom_time = wpn_params.zoom_time + 0.25
        div_limit            = 40
    else
        wpn_params.zoom_time = wpn_params.zoom_time + 0.01
    end

    wpn_params.zoom_time = math.min(wpn_params.zoom_time, div_limit)

    local power = 0.2 + ( actor.power * 0.8 )
    local health_k = 1.0
    if actor.health < 0.5 then
        local t = (0.5 - actor.health) / 0.5
        health_k = 1.0 + t * t * 0.5
    end
    local breath_speed_k = 1.0 + (1.0 - power) * 0.6
    local fatigue_factor = (1.0 - power) / 0.8
    -- The same mass-derived sensitivity drives low-stamina wobble growth as
    -- ADS drain: heavy weapons begin steadier, then deteriorate faster.
    local stamina_k = 1.0 + ((wpn_params.current_weight_sens or 0.5) * fatigue_factor)
    -- OGSR: stance_k now driven by current_stance instead of get_crouch_factor()
    local stance_k = (current_stance == 2) and 0.8 or ((current_stance == 1) and 0.9 or 1.0)

    -- Use the same delta-time exponential approach as the inertia/FOV modules:
    -- ADS entry, stance changes, weapon swaps and held breath now converge
    -- smoothly instead of stepping once per rescheduled wobble tick.
    base_radius = exp_lerp(base_radius, 1, 8.0, dt)
    local manual_hold_k = 1.0
    if sivol_weapon and sivol_weapon.get_manual_hold_breath_strength then
        manual_hold_k = 1.0 - 0.55 * sivol_weapon.get_manual_hold_breath_strength()
    end
    local target_radius = base_radius * base_wobble * gg_tired * stance_k * stamina_k
        * wpn_params.mastery_k * health_k
        * (sivol_weapon and sivol_weapon.get_artifact_wobble_k() or 1.0)
        * manual_hold_k
        * (sivol_weapon and sivol_weapon.get_manual_hold_breath_timeout_wobble_k
            and sivol_weapon.get_manual_hold_breath_timeout_wobble_k() or 1.0)
    local radius_rate = target_radius > smoothed_wobble_radius and 8.0 or 12.0
    smoothed_wobble_radius = exp_lerp(smoothed_wobble_radius, target_radius, radius_rate, dt)
    local effective_radius = smoothed_wobble_radius

    local dir = vector():set( device().cam_dir )
    for i, deg in ipairs( disp_angles ) do
        local drift = (math.random() * 0.2) - 0.1
        local base_speed = wpn_params.disp_add[i]

        wpn_params.disp_add[i] = math.max(-25, math.min(25, base_speed + drift))

        local saved_base_speed = wpn_params.disp_add[i]
        wpn_params.disp_add[i] = saved_base_speed * breath_speed_k * (wpn_params.current_speed_k or 1.0)

        inc_angle( i )

        wpn_params.disp_add[i] = saved_base_speed

        local rdiv = math.min( div_limit, wpn_params.zoom_time )
        local a    = deg * DEG_TO_RAD
        local r    = effective_radius * disp_radius[ i ] / rdiv

        local x_weight = (i == 1) and 0.5 or 1.0
        local y_weight = (i == 1) and 1.5 or 1.0

        wobble_x = wobble_x + math.cos( a ) * r * x_weight
        wobble_y = wobble_y + math.sin( a ) * r * y_weight
    end

    local raw_wobble_y = wobble_y
    local now_ms = time_global()
    if wobble_shot_hold_until > now_ms then
        wobble_output_y = wobble_shot_hold_y
        wobble_damper_state = "hold"
    elseif wobble_shot_resume_active then
        wobble_output_y = exp_lerp(
            wobble_output_y, raw_wobble_y, WOBBLE_SHOT_RESUME_RATE, dt)
        wobble_damper_state = "resume"
        if math.abs(wobble_output_y - raw_wobble_y) < WOBBLE_DIRECTION_EPSILON then
            wobble_output_y = raw_wobble_y
            wobble_shot_resume_active = false
            wobble_damper_state = "idle"
        end
    else
        wobble_output_y = raw_wobble_y
        wobble_damper_state = "idle"
    end

    local wobble_delta_y = wobble_output_y - wobble_previous_output_y
    wobble_vertical_velocity = wobble_delta_y / math.max(dt, 0.001)
    if wobble_delta_y > WOBBLE_DIRECTION_EPSILON then
        wobble_vertical_direction = "up"
    elseif wobble_delta_y < -WOBBLE_DIRECTION_EPSILON then
        wobble_vertical_direction = "down"
    else
        wobble_vertical_direction = "still"
    end
    wobble_previous_output_y = wobble_output_y
    wobble_y = wobble_output_y

    local m_rot = matrix()
    m_rot:setHPB( dir:getH(), dir:getP(), 0 )

    local v = vector():set( wobble_x, wobble_y, 0 )

    v = transform_tiny( m_rot, v )
    switch_zoom_osc( true )
    zupd( 'target_point',    v,     false, eff_obj )
    zupd( 'time_passed_int', 0.000, false, eff_obj )
    zupd( 'speed_min',       0.001, false, eff_obj )

    if not wobble_overlay_active then wobble_exit_rebased = false end
    wobble_overlay_active = true
    -- device().cam_dir is the rendered direction from the prior frame and
    -- therefore includes the current effector overlay.
    wobble_last_render_dir = vector():set(device().cam_dir)
end

wpn_params.scope_wobble = scope_wobble

-- CEffectorZoomInertion only adds its wobble to the rendered camera direction;
-- when it is destroyed, the base actor camera would otherwise remain at ADS
-- entry. Rebase once while the final rendered direction is still available.
local function on_actor_weapon_zoom_out()
    if not wobble_overlay_active then return end

    local final_dir = vector():set(device().cam_dir)
    rebase_wobble_exit_camera(final_dir)
    wobble_last_render_dir = final_dir
    wobble_exit_rebased = true
    wpn_params.zoom_time = 1

    if sivol_weapon and sivol_weapon.weapon_breath_diagnostics then
        log2("[weapon_wobble] rebased final ADS direction on zoom exit")
    end
end

function transform_tiny(m, v)
	local res = vector()
	res.x = m.i.x * v.x + m.k.x * v.z + m.j.x * v.y + m.c.x
	res.y = m.k.y * v.z + m.j.y * v.y + m.i.y * v.x + m.c.y
	res.z = m.k.z * v.z + m.j.z * v.y + m.i.z * v.x + m.c.z
	return res
end

function wpn_params.start_fire(id)
	local wpn = client_obj(id)
	if wpn and wpn:is_weapon_magazined() then
		wpn:get_weapon():start_fire()
	end
end

function wpn_params.end_fire(id)
	local wpn = client_obj(id)
	if wpn and wpn:is_weapon_magazined() then
		wpn:get_weapon():stop_fire()
	end
end

function attach(sm)
	sm:subscribe({signal = "on_update", fun = this.scope_wobble})
	sm:subscribe({signal = "on_actor_weapon_zoom_out", fun = on_actor_weapon_zoom_out})
end
