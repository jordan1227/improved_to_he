-- nvd_params.script
-- FUTURE: when NVD becomes standalone equipment, keep any EMP resistance on
-- that equipped item here instead of inheriting it from outfit/device state.
local update_nvd_glitch  -- forward declaration, so attach() below can see it
local on_emp_malfunction

function attach(sm)
    sm:subscribe({signal = "on_item_to_slot", fun = this.on_slot})
    sm:subscribe({signal = "on_item_to_ruck", fun = this.on_drop})
    sm:subscribe({signal = "on_drop_before_all", fun = this.on_drop})
    sm:subscribe({signal = "on_before_switch_nv", fun = this.on_before_switch_nv})
    sm:subscribe({signal = "on_spawn", fun = this.on_spawn})
    sm:subscribe({signal = "on_first_update", fun = this.on_first_update})
    sm:subscribe({signal = "on_save", fun = this.on_save})
    sm:subscribe({signal = "on_update", fun = update_nvd_glitch})
    sm:subscribe({signal = "on_emp_malfunction", fun = on_emp_malfunction})
end

local snd_on = sound_object("weapons\\nv_start")
local snd_off = sound_object("weapons\\nv_off")

-- https://github.com/OGSR/OGSR_GA_Resources/blob/main/gamedata/scripts/ogse_night_vision.script
local r_pnv_gain_current_base = 0
local r_pnv_gain_current_mod  = 0

local beef_nv = {
    r_pnv_mode = 0,             -- 1, 2, 3
    r_pnv_num_tubes = 2,        -- число трубок 1, 1.1, 1.2, 2, 4
    r_pnv_gain_offset = 2.0,    -- усиление (сила) ПНВ (основа(
    r_pnv_gain_current = 1,     -- усиление (сила) ПНВ
    r_pnv_radius = 0.5,         -- размер (радиус) ПНВ
    r_pnv_glitch = 0.006,       -- тряска
    r_pnv_noise = 0.3,          -- шум
    r_pnv_scanlines = 1,        -- эффект crt
    r_pnv_scintillation = 0.99, -- МЕРЦАНИЯ
    r_pnv_alfa_vignete = 0,     -- режим рамки 0 - blur, 1 - black, 2 - image overlay
    r_pnv_size_vignet = 0.04,   -- размер виньетки
    r_pnv_washout_thresh  = 0.7, -- засвет источников света
}

local beef_nv_v4 = {
    heat_fade_distance = vector4():set(13.000000, 20.000000, 0.000000, 0.000000), -- FADE_DISTANCE_START 13.00, FADE_DISTANCE_END 20.00
    heat_vision_blurring = vector4():set(1.000000, 1.500000, 1.100000, 0.000000), -- int samples = lerp(heat_vision_blurring.x, heat_vision_blurring.y, smoothstep(0.0, heat_vision_blurring.z, depth));
    heat_vision_steps = vector4():set(0.300000, 0.200000, 0.500000, 0.000000),    -- хз что это такое
}

local eff, obj_id, flag

local NVD_SMOOTH_IN  = 5.0
local NVD_SMOOTH_OUT = 2.5
local nvd_smooth = 0
local nvd_last_time = 0
local nvd_dropout_until = 0
local nvd_critical_forced_off = false
local current_level_is_aver = false
local last_nvd_visual_update = 0
local next_nvd_visual_spike = 0
local nvd_visual_spike_until = 0

-- max-intensity targets to lerp toward; base values come from the currently
-- equipped device's own ltx section (already read once in apply_pnv/on_slot)
local base_pnv_glitch, base_pnv_noise, base_pnv_scintillation

local last_glitch_val, last_noise_val, last_gain_val, last_scintillation_val
local NVD_CMD_EPSILON = 0.005

local function snapshot_nvd_base(nv_sect)
    base_pnv_glitch = get_float(nv_sect, "r_pnv_glitch", beef_nv.r_pnv_glitch)
    base_pnv_noise  = get_float(nv_sect, "r_pnv_noise",  beef_nv.r_pnv_noise)
    base_pnv_scintillation = get_float(nv_sect, "r_pnv_scintillation", beef_nv.r_pnv_scintillation)
end

on_emp_malfunction = function(kind)
    if not (flag and eff) then return end
    if kind == "shutdown" then
        off_pnv(true)  -- full shutdown, mirrors torch's set_off_mode — manual switch-on required
    else
        local cfg = sivol_emp_config.TORCH_MALFUNCTION
        nvd_dropout_until = time_global() + math.random(cfg.dropout_min, cfg.dropout_max)
        cmd("r_pnv_mode 0")
    end
end

update_nvd_glitch = function()
    if not (flag and eff) then return end

    local now = time_global()

    -- Critical malfunction: force the actual NVD mode off without clearing
    -- `flag`; this is an outage that auto-recovers, unlike a lesser shutdown.
    if sivol_critical_malfunction and sivol_critical_malfunction.is_device_active("nvd") then
        if not nvd_critical_forced_off then
            cmd("r_pnv_mode 0")
            nvd_critical_forced_off = true
        end
        if last_glitch_val ~= 0 then
            cmd("r_pnv_glitch", 0)
            last_glitch_val = 0
        end
        if last_noise_val ~= 0 then
            cmd("r_pnv_noise", 0)
            last_noise_val = 0
        end
        return
    elseif nvd_critical_forced_off then
        nvd_critical_forced_off = false
        if check_accum() then
            cmd("r_pnv_mode 1")
        else
            off_pnv(false)
            return
        end
    end

    -- NVD dropout recovery/gate
    -- Skip the normal glitch/noise update while forced off,
    -- then restore NVD mode immediately when the dropout expires.
    if nvd_dropout_until > 0 then
        if now >= nvd_dropout_until then
            nvd_dropout_until = 0
            cmd("r_pnv_mode 1")
        else
            return
        end
    end

    local dt = (now - nvd_last_time) / 1000
    nvd_last_time = now
    if dt > 1 or dt < 0 then dt = 0 end

    local electra_glitch = (sivol_pda and sivol_pda.get_glitch_intensity
        and sivol_pda.get_glitch_intensity()) or 0
    local shield = (sivol_pda and sivol_pda.get_artifact_shield
        and sivol_pda.get_artifact_shield()) or 0

    local aver_glitch = 0
    if current_level_is_aver then
        aver_glitch = sivol_emp_config.NVD_AVER_GLITCH_BASE * (1 - shield)
    end

    local target = math.max(electra_glitch, aver_glitch)

    local rate = (target > nvd_smooth) and NVD_SMOOTH_IN or NVD_SMOOTH_OUT
    local k = math.min(1, dt * rate)
    nvd_smooth = nvd_smooth + (target - nvd_smooth) * k
    if nvd_smooth < 0.001 then nvd_smooth = 0 end
    if nvd_smooth > 1 then nvd_smooth = 1 end

    if not base_pnv_glitch then return end

    local visual_cfg = sivol_emp_config.NVD_EMP_VISUAL
    if nvd_smooth > 0.15 then
        if now >= next_nvd_visual_spike then
            nvd_visual_spike_until = now + math.random(
                visual_cfg.spike_duration_min, visual_cfg.spike_duration_max
            )
            next_nvd_visual_spike = now + math.random(
                visual_cfg.spike_interval_min, visual_cfg.spike_interval_max
            )
        end
    else
        next_nvd_visual_spike = 0
        nvd_visual_spike_until = 0
    end

    if now - last_nvd_visual_update < visual_cfg.update_interval then return end
    last_nvd_visual_update = now

    local spike = now < nvd_visual_spike_until and 1 or 0
    local phase = 0.5 + 0.5 * math.sin(now * 0.018)
    local instability = nvd_smooth * nvd_smooth

    local glitch_val = base_pnv_glitch
        + (sivol_emp_config.NVD_GLITCH_MAX - base_pnv_glitch) * nvd_smooth
        + spike * 0.12 * nvd_smooth
    local noise_val = base_pnv_noise
        + (sivol_emp_config.NVD_NOISE_MAX - base_pnv_noise) * nvd_smooth
        + spike * 0.18 * nvd_smooth
    glitch_val = math.min(1, glitch_val)
    noise_val = math.min(1, noise_val)

    local gain_drop = instability * (
        visual_cfg.gain_drop_max * (0.55 + 0.45 * phase)
        + spike * visual_cfg.gain_wobble
    )
    local gain_val = math.clamp(
        r_pnv_gain_current_base + r_pnv_gain_current_mod - gain_drop, 0.1, 3.0
    )
    local scintillation_val = math.clamp(
        base_pnv_scintillation
            - instability * visual_cfg.scintillation_drop_max * (0.6 + 0.4 * phase)
            - spike * 0.12 * nvd_smooth,
        0, 1
    )

    if not last_glitch_val or math.abs(glitch_val - last_glitch_val) > NVD_CMD_EPSILON then
        cmd("r_pnv_glitch", glitch_val)
        last_glitch_val = glitch_val
    end
    if not last_noise_val or math.abs(noise_val - last_noise_val) > NVD_CMD_EPSILON then
        cmd("r_pnv_noise", noise_val)
        last_noise_val = noise_val
    end
    if not last_gain_val or math.abs(gain_val - last_gain_val) > NVD_CMD_EPSILON then
        cmd("r_pnv_gain_current", gain_val)
        last_gain_val = gain_val
    end
    if not last_scintillation_val
        or math.abs(scintillation_val - last_scintillation_val) > NVD_CMD_EPSILON then
        cmd("r_pnv_scintillation", scintillation_val)
        last_scintillation_val = scintillation_val
    end
end

local function apply_pnv_mode()
    -- 0.10000, 3.00000
    local gain = math.clamp(r_pnv_gain_current_base + r_pnv_gain_current_mod, 0.1, 3.0)
    cmd("r_pnv_gain_current", gain)
    last_gain_val = gain
end

local function apply_pnv(nv_sect)
    local color = get_vector(nv_sect, "pnv_color")
    cmd("pnv_color " .. string.format("%f,%f,%f", color.x, color.y, color.z))

    for k, v in pairs(beef_nv) do
        local v1 = get_float(nv_sect, k, v)
        cmd(k, v1)
    end

    for k, v in pairs(beef_nv_v4) do
        local v = get_vector4(nv_sect, k, v)
        local v1 = string.format("%f,%f,%f,%f", v.x, v.y, v.z, v.w)
        cmd(k, v1)
    end

    r_pnv_gain_current_base = get_float(nv_sect, "r_pnv_gain_current", beef_nv.r_pnv_gain_current)
    apply_pnv_mode()
end

local NVD_SLOT = 11 -- [HE-PORT]

local function slot_device() -- [HE-PORT]
    local obj = db.actor and db.actor:item_in_slot(NVD_SLOT)
    if not obj then return end
    return get_string(obj:section(), "night_vision_device"), obj
end

function refresh() -- [HE-PORT]
    local eff_sect, obj = slot_device()
    if eff_sect then
        if eff_sect ~= eff then
            apply_pnv(eff_sect)
            snapshot_nvd_base(eff_sect)
        end
        eff, obj_id = eff_sect, obj:id()
    elseif eff then
        eff, obj_id = nil, nil
        off_pnv(flag)
    end
end

function on_slot() -- [HE-PORT]
    refresh()
end

function on_drop(obj)
    local sect = obj and obj:section()
    if sect == "af_full_akkum" or sect == "af_full_akkum_big" then
        -- Inventory callbacks can arrive while the slot transition is still
        -- being finalized. Verify on the next task slice before shutting down.
        dsh.timeout(1, function()
            if flag and not check_accum() then off_pnv(false) end
        end)
    end
    if obj:id() == obj_id then
        eff, obj_id = nil, nil
        off_pnv(flag)
    end
end

function play_pnv_anim()
    level.only_allow_movekeys(true)
    level.set_actor_allow_ladder(false)

    local torch_anm_sec = "switch_torch"
    local anim = "anm_show"
    local detector = db.actor:item_in_slot(8)
    if detector and get_actor_obj():IsDetectorActive() then
        torch_anm_sec = get_string(detector:section(), "hud")
        anim = "anm_headlamp_on"
    end

    local duration = game.play_hud_motion(db.actor:active_item() and 1 or 2, torch_anm_sec, anim, false, 1)
    level.add_cam_effector("camera_effects\\headlamp_cam.anm", 7539, false, "", 0, false)

    dsh.timeout(duration + 10, function()
        level.only_allow_movekeys(false)
        level.set_actor_allow_ladder(true)
    end)

    return duration
end

function on_before_switch_nv()
    if not eff or not (check_accum() and vergas_masks.get_flag_mask() == true) then return end
    if not used_items.can_use_gadget() or db.actor:is_talking() or level.main_input_receiver() then return end

    local duration = play_pnv_anim()

    dsh.timeout(duration * 0.5, function()
        if flag then
            off_pnv(true)
        else
            on_pnv(true)
        end
    end)
end

function on_pnv(snd)
    if not eff then return end
    flag = true
    last_nvd_visual_update = 0
    cmd("r_pnv_mode 1")
    level.set_min_lumscale_amb(0.02)
    if snd then
        snd_on:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
    end
end

function off_pnv(snd)
    flag = false
    nvd_smooth = 0
    nvd_dropout_until = 0
    nvd_critical_forced_off = false
    next_nvd_visual_spike = 0
    nvd_visual_spike_until = 0
    last_nvd_visual_update = 0
    last_glitch_val, last_noise_val = nil, nil
    last_gain_val, last_scintillation_val = nil, nil
    cmd("r_pnv_mode 0")
    level.set_min_lumscale_amb(0.001)
    if snd then
        snd_off:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
    end
end

function on_spawn()
    local aobj = get_actor_obj()
    if aobj then aobj.can_switch_nv = false end
    flag = get_value("nightvision_en", false)
    current_level_is_aver = level.name() == 'aver'
    -- if flag and level.name() ~= 'aver' then on_pnv() end
end

function on_first_update()
    refresh() -- [HE-PORT]
    if not flag then return end
    if eff then
        if not current_level_is_aver then on_pnv() end
    else
        off_pnv(false)
    end
end

function on_save()
    set_value("nightvision_en", flag)
end

function check_accum()
    local obj = sak.get_accum()
    return obj and obj:condition() > 0.071 and obj
end

function disable_NVD()
    if flag then
        off_pnv()
    end
end

function get_NVD_powered()
    return flag
end
