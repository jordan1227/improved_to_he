_dialog        = level.main_input_receiver()

local ini        = system_ini()
local clr_green  = { 255, 1,   255, 1   }
local clr_red    = { 255, 180,  35, 50  }
local clr_orange = { 255, 238, 153, 26  }
local clr_gray   = { 255, 160, 160, 160 }

local snd
local restore_on_quit = false

class "CUISharp"( CUIScriptWnd )

function CUISharp:__init( sharper, knife ) super()
    _dialog     = self
    self:InitControls()
    self:InitCallBacks()
end

function CUISharp:__finalize() end

function CUISharp:InitControls()
    self:Init( 0, 0, 1024, 768 )
    local xml = CScriptXmlInit()
    xml:ParseFile( "ui_sharper.xml" )
    self.xml     = xml
    self.dialog  = xml:InitStatic( "main_dialog:dialog", self )
    self.cap_wnd = make_static(
        "cap_wnd", self, "Руководство по использованию:", 251, 140, 260, 39
    )
    self.cap_wnd:SetTextColor( unpack( clr_orange ) )
    self.cap_wnd:SetFont( GetFontGraffiti19Russian() )
    self.cap_price = make_static( "cap_price", self, "Взаимодействие:", 251, 420, 200, 39 )
    self.cap_price:SetTextColor( unpack( clr_orange ) )
    self.cap_price:SetFont( GetFontGraffiti19Russian() )
    self:Register( xml:Init3tButton( "btn_ok_vodka", self ), "btn_ok_vodka" )
    self:Register( xml:Init3tButton( "btn_ok_energ", self ), "btn_ok_energ" )
    self:Register( xml:Init3tButton( "btn_ok_water", self ), "btn_ok_water" )	
    self:Register( xml:Init3tButton( "btn_repair", 	 self ), "btn_repair" 	)
	self:Register( xml:Init3tButton( "btn_cancel", 	 self ), "btn_cancel" 	)	

    self.message_box = CUIMessageBoxEx()
    self:Register( self.message_box, "message_box" )
	
    self.scroll_view = xml:InitScrollView("scroll_view", self)
    self.text_guide = xml:InitStatic("scroll_view:text_guide", self.scroll_view)
    local text = game.translate_string("ui_sharper_guide_descr")
    self.text_guide:SetText(text)
    self.text_guide:SetFont(GetFontLetterica18Russian())
	-- self.text_guide:SetWidth(280) 	-- ширина
	-- self.text_guide:SetHeight(300)  	-- высота
    self.text_guide:SetTextComplexMode(true)
	---------------------------------------------------------------------------
    local item_one  = give_icon_params( "vodka" )
	local px     	= 275 + ( item_one.width  * 0.26 * 1.2 ) 		   
	local py    	= 425 + ( item_one.height * 0.32 * 1.2 )    		   
    self.pict = make_static(
		"pict", self, false, px, py,
		( item_one.width * 0.52 * 1.2 ), ( item_one.height * 0.64 * 1.2 )
    )
    self.pict:InitTexture( "ui\\ui_icon_equipment" )
    self.pict:SetOriginalRect( item_one.x, item_one.y, item_one.width, item_one.height )
    self.pict:SetStretchTexture( true )
	self:ShowAmount( vodka, "vodka", 295, 545, 111, 29 )	
	---------------------------------------------------------------------------
    local item_two  = give_icon_params( "energy_drink" )
	local px     	= 400 + ( item_two.width  * 0.26 * 1.2 ) 		   
	local py    	= 475 + ( item_two.height * 0.32 * 1.2 )    		   
    self.pict = make_static(
		"pict", self, false, px, py,
		( item_two.width * 0.52 * 1.2 ), ( item_two.height * 0.64 * 1.2 )
    )
    self.pict:InitTexture( "ui\\ui_icon_equipment" )
    self.pict:SetOriginalRect( item_two.x, item_two.y, item_two.width, item_two.height )
    self.pict:SetStretchTexture( true )
	self:ShowAmount( energy, "energy_drink", 425, 545, 111, 29 )		
	---------------------------------------------------------------------------
    local item_three  = give_icon_params( "flask_army" )
	local px     	= 530 + ( item_three.width  * 0.26 * 1.2 ) 		   
	local py    	= 435 + ( item_three.height * 0.32 * 1.2 )    		   
    self.pict = make_static(
		"pict", self, false, px, py,
		( item_three.width * 0.52 * 1.2 ), ( item_three.height * 0.64 * 1.2 )
    )
    self.pict:InitTexture( "ui\\ui_icon_equipment_1" )
    self.pict:SetOriginalRect( item_three.x, item_three.y, item_three.width, item_three.height )
    self.pict:SetStretchTexture( true )
	self:ShowAmount( flask_army, "flask_army", 555, 545, 111, 29 )	
	---------------------------------------------------------------------------
	local knife 		= db.actor:item_in_slot( 0 )
	if knife == nil then return end
	local knife_sect 	= db.actor:item_in_slot( 0 ):section()	
	local knife_cond 	= db.actor:item_in_slot( 0 ):condition()	
	local knife_slot  	= give_icon_params( knife_sect )
	local px     = 640 + ( knife_slot.width  * 0.26 * 1.2 ) 		   
	local py     = 440 + ( knife_slot.height * 0.32 * 1.2 )    		   
	self.pict = make_static( "pict", self, false, px, py, ( knife_slot.width * 0.52 * 1.2 ), ( knife_slot.height * 0.64 * 1.2 ) )
	if knife_slot.icon_group == 0 then
		self.pict:InitTexture( "ui\\ui_icon_equipment" )
	else
		self.pict:InitTexture( "ui\\ui_icon_equipment_" .. knife_slot.icon_group )
	end	
	self.pict:SetOriginalRect( knife_slot.x, knife_slot.y, knife_slot.width, knife_slot.height )
	self.pict:SetStretchTexture( true )		
	self:ShowCondition( "knife", knife_cond, 650, 550, 100, 10 )
	---------------------------------------------------------------------------
    local sharp  = give_icon_params("sharper")
    local sharp_obj = db.actor:object("sharper")
    if sharp_obj then
        local sharp_cond = sharp_obj:condition()
        local px     = 565 + (sharp.width  * 0.26 * 1.2)         
        local py     = 210 + (sharp.height * 0.32 * 1.2)           
        self.pict = make_static(
            "pict", self, false, px, py,
            (sharp.width * 0.52 * 1.2), (sharp.height * 0.64 * 1.2)
        )
        self.pict:InitTexture("ui\\ui_icon_equipment_3")    
        self.pict:SetOriginalRect(sharp.x, sharp.y, sharp.width, sharp.height)
        self.pict:SetStretchTexture(true)    
        self:ShowCondition("sharp", sharp_cond, 575, 300, 100, 10)    
    end
end
---------------------------------------------------------------------
function CUISharp:ShowAmount(name, item, x1, y1, x2, y2)
    local have_amount = 0
    local price_color = clr_red
    local price_text = ""
    local _, info_chhl, _ = ui_cheat_flask.data_collection(1)
    
    if item == "flask_army" then
        if info_chhl[2] and info_chhl[2] > 1 then
            have_amount = math.floor(187.5 * (info_chhl[2] - 1))
            price_text = tostring(have_amount) .. " мл."
        else
            price_text = "0 мл."
        end
    elseif item == "energy_drink" then
        have_amount = kotovod.count_actor_ammo(item)
        price_text = tostring(have_amount) .. " шт."
    else
        have_amount = sak.calc_items_count(item, nil)
        price_text = tostring(have_amount) .. " шт."
    end
    
    if (item == "flask_army" and have_amount > 0) or (item ~= "flask_army" and have_amount >= 1) then
        price_color = clr_green
    end
    
    self.price = make_static(name, self, price_text, x1, y1, x2, y2)
    self.price:SetTextColor(unpack(price_color))    
end

function CUISharp:ShowCondition(name, knife_cond, x1, y1, x2, y2)
    self.cond = make_static(name, self, false, x1, y1, x2, y2)    
    self.cond:InitTexture("ui\\ui_small_scale_gr_new")
    local pos_x = 512 - math.floor(512 * knife_cond)    
    self.cond:SetOriginalRect(pos_x, 0, 512, 64) -- позиция в текстурке    
    self.cond:SetStretchTexture(true)
    self.cond:SetColor(0x90FFFFFF)
    self.cond:Show(true)    
	
	if strposx( name, "knife" ) then return end
	
    -- Добавляем текст с информацией о текущей и максимальной кондиции
    local sharp_obj = db.actor:object("sharper")
    if sharp_obj then
        local sharp_id = sharp_obj:id()
        local current_condition = sharp_obj:condition()
        local max_condition = get_sharper_max_condition(sharp_id)
        local condition_text = string.format("Состояние: %.0f%% из %.0f%%", current_condition * 100, max_condition * 100)
        
        self.cond_text = make_static(name.."_cond", self, condition_text, x1, y1 + y2 + 5, x2 + 10, 20)
        self.cond_text:SetTextColor(unpack(clr_gray))
        self.cond_text:SetFont(GetFontLetterica16Russian())
    end
end
---------------------------------------------------------------------
function CUISharp:InitCallBacks()
    self:AddCallback( "btn_ok_vodka",      	ui_events.BUTTON_CLICKED,          self.OnBtnVodka,      self )
    self:AddCallback( "btn_ok_energ",      	ui_events.BUTTON_CLICKED,          self.OnBtnEnerg,      self )	
    self:AddCallback( "btn_ok_water",      	ui_events.BUTTON_CLICKED,          self.OnBtnWater,      self )		
	self:AddCallback( "btn_repair",  		ui_events.BUTTON_CLICKED,          self.OnBtnRepair,     self )	
	self:AddCallback( "btn_cancel",  		ui_events.BUTTON_CLICKED,          self.OnBtnCancel,     self )	
end
---------------------------------------------------------------------	
function update_sharper_max_condition(sharp_id, item_type)
    local sharper_data = get_value( "sharper_max_condition", {} )
    local current_max = sharper_data[sharp_id] or 1.0
    
    local condition_decrease = {
        water = 0.15,
        energy_drink = 0.10,
        vodka = 0.05
    }
    
    local new_max = current_max - (condition_decrease[item_type] or 0)
    sharper_data[sharp_id] = math.max(0, new_max)
    set_value( "sharper_max_condition", sharper_data )
    
    return new_max
end

-- Функция для получения максимальной кондиции точильного камня
function get_sharper_max_condition(sharp_id)
    local sharper_data = get_value( "sharper_max_condition", {} )
    return sharper_data[sharp_id] or 1.0
end

function CUISharp:OnBtnSect(sect, rand1, rand2, count)
    local _, info_chhl, _ = ui_cheat_flask.data_collection(1)
    
    if sect == "energy_drink" and not vergas_lib.search_items("energy_drink", 1, 1) or
       sect == "vodka" and not sak.have_items_count("vodka", 1) or
       sect == "flask_army" and (not info_chhl[1] or info_chhl[1] == "?" or not info_chhl[2] or info_chhl[2] <= 1) then
        self.message_box:Init("msg_box_not_enought_item")
        self:GetHolder():start_stop_menu(self.message_box, true)        
        return 
    end    
    
    local sharp_obj = db.actor:object("sharper")
    if not sharp_obj then
        self.message_box:Init("msg_box_no_sharper")
        self:GetHolder():start_stop_menu(self.message_box, true)
        return
    end
    local sharp_cond = sharp_obj:condition()
    local sharp_id = sharp_obj:id()    
    if sharp_cond >= 1 then 
        self.message_box:Init("msg_box_not_needed_to_sharp")
        self:GetHolder():start_stop_menu(self.message_box, true)            
        return
    end        
	
    -- Получаем максимально доступную кондицию
    local max_condition = get_sharper_max_condition(sharp_id)
    
    -- Проверяем, достигла ли точилка максимальной кондиции
    if max_condition ~= 1 and sharp_cond == max_condition then 
        self.message_box:Init("msg_box_max_condition_reached")
        self:GetHolder():start_stop_menu(self.message_box, true)            
        return
    end        
    	
    local water_used = 0
    local item_type = ""
    if sect == "flask_army" then
        local equipped_flask = get_value( "equipped_flask" )
        if equipped_flask then
            local flask_obj = level.object_by_id(equipped_flask)
            if flask_obj then
                local current_water = ui_cheat_flask.get_flask_water(flask_obj)
                if current_water > 1 then
                    water_used = current_water - 1
                    ui_cheat_flask.set_flask_water(flask_obj, 1)  -- Set flask as empty
                    item_type = "water"
                else
                    self.message_box:Init("msg_box_flask_empty")
                    self:GetHolder():start_stop_menu(self.message_box, true)
                    return
                end
            else
                self.message_box:Init("msg_box_flask_not_found")
                self:GetHolder():start_stop_menu(self.message_box, true)
                return
            end
        else
            self.message_box:Init("msg_box_no_equipped_flask")
            self:GetHolder():start_stop_menu(self.message_box, true)
            return
        end
    else
        this.release_items(sect, count)
        water_used = 1  -- For other items, count as one use
        item_type = sect == "energy_drink" and "energy" or "vodka"
    end
    
    local base_improvement = dsh.get_next_random("ui_sharper.generic_rnd", rand1, rand2) / 100
    local total_improvement = base_improvement * water_used
    
    local max_condition = update_sharper_max_condition(sharp_id, item_type)
    local new_condition = math.min(max_condition, sharp_cond + total_improvement)
    
    params.upd_condition(sharp_id, new_condition)    
    
    self:on_quit()            
    bind_stalker.hide_weapon()            
    local local_snd = xr_sound.get_safe_sound_object("device\\masks\\water_flask")
	local sound_length = local_snd:length()
    local_snd:play_at_pos(db.actor, vector(), 0, sound_object.s2d)
    level.add_cam_effector("camera_effects\\item_use.anm", 9773, false, "")    
    dsh.timeout( sound_length + 300, function()
        sharper_screen()
    end )
end


function CUISharp:OnBtnVodka()
	self:OnBtnSect( "vodka", 30, 40, 1 )
end

function CUISharp:OnBtnEnerg()
	self:OnBtnSect( "energy_drink", 15, 25, 1 )
end

function CUISharp:OnBtnWater()
	self:OnBtnSect( "flask_army", 5, 10, 1 )
end

function CUISharp:OnBtnRepair( drag_obj, drop_obj )
	local knife, sharper
	if drag_obj and drop_obj then
        knife = drag_obj
        sharper = drop_obj	
    else
        knife = db.actor:item_in_slot( 0 )
        sharper = db.actor:object( "sharper" )
    end
	
    if not knife then 
        self.message_box:Init( "ui_st_not_knife" )
        self:GetHolder():start_stop_menu( self.message_box, true )			
        return 
    end	
	
    local knife_cond = knife:condition()
    local knife_sect = knife:section()	
	
    if not strpos( knife_sect, "knife" ) then 
        nlc_container.try_to_slot( knife )
        return
    end
	
    if knife_cond >= 1 then 
        self.message_box:Init( "msg_box_condition_enough" )
        self:GetHolder():start_stop_menu( self.message_box, true )		
        return 
    end	

    if not sharper then
        sharper = db.actor:object( "sharper" )
    end

    local sharp_cond = sharper:condition()
    local sharp_id = sharper:id()	
    local knife_num = 1.5
    local knife_exp = 0.2	
	
	if 
		knife_sect == "wpn_knife_m1" 
	then 
		knife_num = 2 
		knife_exp = 0.3
	end	
	
	local new_sharp_cond = ( knife_num / knife_cond ) / 8 	-- Было 10
	if new_sharp_cond >= 1 then new_sharp_cond = 0.75 end	
	params.upd_condition( sharp_id, sharp_cond - new_sharp_cond )
	local will_break = sharp_cond - new_sharp_cond <= 0
	------------------------------------------			
	local sharp_exp = get_value( "sharping", 0 )
	if sharp_exp <= 0.4 then 
		sharp_exp = sharp_exp + ( ( knife_exp / knife_cond ) / 100 )
		set_value( "sharping", sharp_exp )
	end	
	
	set_value( "rem_knife_cond", knife_cond )
	
	local new_knife_cond = knife_cond + ( ( sharp_cond + sharp_exp ) / ( knife_num * 2 ) )
	if new_knife_cond >= 1 then new_knife_cond = 1 end
	
	params.upd_condition( knife, new_knife_cond )	
    xr_statistic.add_pts( "otherstats", game.translate_string( "st_pda_otherstats_knife_repairs" ), 1, 1 )

	bind_stalker.hide_weapon()

	local local_snd = sound_object( "scripts\\sharp_" .. lua_random( 1, 3 ) )
	local_snd:play_at_pos( db.actor, vector(), 0, sound_object.s2d + sound_object.looped )	
	misc.last_sound = local_snd	
	
	local max_time = 25000  -- 25 секунд для 0%
	local min_time = 5000   -- 5 секунд для 100%
	local time = max_time * ( 1 - knife_cond ) + min_time * knife_cond	

	set_dof_params( 1, 1, 1, 1 )
	level.add_cam_effector( "camera_effects\\item_use.anm", 9773, true, "" )		
	self:on_quit()

	dsh.timeout( time, function()
		if local_snd and local_snd:playing() then local_snd:stop() end
		level.remove_cam_effector( 9773 )
		set_dof_params( 0, 0, 0, 0 )

		if will_break then 
			misc.release_obj( sharp_id, true ) 
			sak.send_tip_local( 
				"Чёрт! Сломался точильный камень, теперь только новый покупать...", 
				"Мысли вслух", 0, 10, "g_g", "no", "red" 
			) 	
			vergas_lib.s_play( [[device\antirad_no]], 1 )
			return
		end 

		misc.easy_sound( "device\\sleeping_bag\\sleep_cancel" )
		sak.restore_weap()
	end )		
end

function CUISharp:OnKeyboard(dik, keyboard_action)
	CUIScriptWnd.OnKeyboard(self,dik,keyboard_action)
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_ESCAPE then
			self:OnBtnCancel()
		end
	end
	return true
end

function CUISharp:OnBtnCancel()
	restore_on_quit = true
    self:on_quit()
end

function CUISharp:on_quit()
    if self then
	    self:GetHolder():start_stop_menu(self, true)
		self:ClearCallbacks()
    end
    _dialog = nil
	if restore_on_quit then 
		sak.restore_weap()
		restore_on_quit = false
	end	
end

function make_static( name, own, text, x, y, width, height )
    local static = CUIStatic()
    static:SetWindowName( name )
    static:SetAutoDelete( true )
    if text then
        static:SetTextComplexMode( true )
        static:SetText( text )
    end
    static:Init( x, y, width, height )
    own:AttachChild( static )
    return static
end

function give_icon_params( sect )
    local t = {}
    t.icon_group  = utils.cfg_get_number( ini, sect, "icon_group", nil, false, 0 )
    if ini and ini:section_exist( sect ) then
        t.width       = ini:r_float( sect, "inv_grid_width"  ) * 50 or 176
        t.height      = ini:r_float( sect, "inv_grid_height" ) * 50 or 78
        t.x           = ini:r_float( sect, "inv_grid_x"      ) * 50 or 0
        t.y           = ini:r_float( sect, "inv_grid_y"      ) * 50 or 0
    else
        t.icon_group  = 0
        t.width       = 176
        t.height      = 78
        t.x           = 0
        t.y           = 0
    end
    return t
end

function release_items( sect, count )
	local items = get_shadow_inv():get_content( true )
	local real  = 0	

	for i, rec in items:ipairs() do
		local item = sak_inventory.dyn_art_base( rec.sect )	
		if strposx( item, sect ) then	
			local amount =  nlc_container.amount_in_batch( rec.obj )
			local need_release = count - real	
			if need_release < amount then            
				nlc_container.amount_in_batch( rec.obj, amount - need_release )
				amount = need_release                          
			else 
				misc.release_obj( rec.id, "sak_inventory.release_actor_items" )
			end   		
			real = real + amount  
			if real >= count then break end	
		end
	end
end	

function opening_sharper()
	dsh_drag_drop.hide_weapon_then( function()
		sharper_screen()
		level.enable_input()
	end )
end

function sharper_screen()
	remove_value( "rem_knife_cond" )
    if snd and snd:playing() then snd:stop() end	
	level.remove_cam_effector( 9773 )
	
	local obj = db.actor:object( "sharper" )
	if obj == nil then return end		
	local sharp_cond, sharp_id = obj:condition(), obj:id()
	if sharp_cond <= 0.1 then 
		misc.release_obj( sharp_id, true ) 
    	sak.send_tip_local( 
			"Чёрт! Сломался точильный камень, теперь только новый покупать...", 
			"Мысли вслух", 0, 10, "g_g", "no", "red" 
		)	
		vergas_lib.s_play( [[device\antirad_no]], 1 )
		sak.restore_weap()		
		return
	end 

	if has_alife_info( "ui_inventory" ) then
		level.start_stop_menu( level.main_input_receiver(), true )	
	end			
    level.start_stop_menu( CUISharp(), true )
	bind_stalker.hide_weapon()
end