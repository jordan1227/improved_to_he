-- Телепорт по локациям

function spawn_items_dialog:Teleport()
	if level.present() and db.actor and db.actor:alive() then
		local obj =  alife():story_object( 987987 )				-- Удаляем прошлый чейнджер, если есть
		if obj then
			alife():release( obj, true )
		end
		self.teleportator_dialog = this.teleportator_menu()
		self.teleportator_dialog.owner = self
		self:GetHolder():start_stop_menu( self.teleportator_dialog, true )
		self:Show( true )
	end
end			

