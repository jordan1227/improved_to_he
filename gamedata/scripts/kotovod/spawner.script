class "spawn_items_dialog" ( CUIScriptWnd )

function spawn_items_dialog:__init() super()
	if self.menu_index == nil then self.menu_index = 1 end
	self.table_name = nil
	self.selected_index = nil
	self.tab_index = nil
	self.spawn_type = nil
	self.current_dyn = 3
	local eng = [[qwertyuiop[]asdfghjkl;'zxcvbnm,./QWERTYUIOP{}ASDFGHJKL:"ZXCVBNM<>?!@#$%^&*()-_+=\| 0123456789]]
	local rus = [[йцукенгшщзхъфывапролджэячсмитьбюёЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮ,!"№;%:?*()-_+=\/ 0123456789]]
	self.translit = {}
	for i = 1, string.len(rus) do
		self.translit[string.sub(eng, i, i)] = string.sub(rus, i, i)
	end	
	self.need_lang = false
	self.was_found = -1		
	self:InitControls()
	self:InitCallBacks()
end

function spawn_items_dialog:__finalize()	end

function spawn_items_dialog:InitControls()
	self:SetWndRect( Frect():set( 0, 0, 1024, 1024 ) )
	local xml = CScriptXmlInit()
	xml:ParseFile	( "ui_spawner.xml" )
	xml:InitStatic	( "background", self )	
	self.list = xml:InitList( "list", self )	
	self.list:ShowSelectedItem( true )
	
	self:Register( self.list, "list_window" )
	
	self:Update_DynArtefact()
	
	self:Register( xml:Init3tButton( "btn_item", 			self ),		"btn_item"			)
	self:Register( xml:Init3tButton( "btn_wpn", 			self ),		"btn_wpn"			)
	self:Register( xml:Init3tButton( "btn_addon", 			self ),		"btn_addon"			)
	self:Register( xml:Init3tButton( "btn_outf", 			self ),		"btn_outf"			)	
	self:Register( xml:Init3tButton( "btn_mp", 				self ),		"btn_mp"			)	
	self:Register( xml:Init3tButton( "btn_ammo", 			self ),		"btn_ammo"			)	
	self:Register( xml:Init3tButton( "btn_help", 			self ),		"btn_help"			)
	self:Register( xml:Init3tButton( "btn_quest", 			self ),		"btn_quest"			)
	self:Register( xml:Init3tButton( "btn_chess", 			self ),		"btn_chess"			)
	---------------------------------------------------------
	self:Register( xml:Init3tButton( "btn_dyn_arts", 		self ),		"btn_dyn_arts"		)
	self:Register( xml:Init3tButton( "btn_modificats",    	self ),		"btn_modificats"	)		
	self:Register( xml:Init3tButton( "btn_unique_art", 		self ),		"btn_unique_art"	)
	self:Register( xml:Init3tButton( "btn_infoportions", 	self ),		"btn_infoportions"	)	
	---------------------------------------------------------	
	self:Register( xml:Init3tButton( "btn_kill",      		self ),		"btn_kill"			)	
	self:Register( xml:Init3tButton( "btn_gg_com",    		self ),		"btn_gg_com"		)	
	self:Register( xml:Init3tButton( "btn_st", 				self ),		"btn_st"			)
	self:Register( xml:Init3tButton( "btn_mob", 			self ),		"btn_mob"			)
	self:Register( xml:Init3tButton( "btn_money", 			self ),		"btn_money"			)
	self:Register( xml:Init3tButton( "btn_tp", self ), "btn_tp" )
	
	self:Register( xml:Init3tButton( "btn_save", 			self ),		"btn_save"			)	
	-- self:Register( xml:Init3tButton( "btn_close", 		self ),		"btn_close"			)	

	------------------------
	self.lang = "RUS"
	self.btn_lang = CUIButton()
	self.btn_lang:Init( "ui\\ui_hud", 670, 635, 37, 25 )
	self.btn_lang:SetText( self.lang )
	self.btn_lang:SetTextAlign( CGameFont.alCenter )
	self.btn_lang:SetTextY( 1 )
	self.btn_lang:SetTextColor( 255,240,165,25 )
	self.btn_lang:SetOriginalRect( 65,704,37,25 )
	self:Register( self.btn_lang, "btn_lang" )
	self:AttachChild( self.btn_lang )	
	------------------------
	self.text = ""	
	self.edit_box = xml:InitEditBox( "frame_search",	self )	
	
	self.search = CUIStatic()
	self.search:SetWindowName("search")
	self.search:SetAutoDelete(true)
	self.search:SetText("Поиск")
	self.search:SetTextColor(255,200,255,200)
	self.search:SetFont(GetFontLetterica18Russian())
    self.search:Init(672,585,200,200)
    self:AttachChild(self.search)
	self:AddCallback("search", ui_events.WINDOW_LBUTTON_DB_CLICK, self.RemoveText, self)
	------------------------
	self.btn_find = CUIButton()
	self.btn_find:Init("ui\\ui_hud",720,635,45,25)
	self.btn_find:SetText("Найти")
	self.btn_find:SetTextAlign(CGameFont.alCenter)
	self.btn_find:SetTextY(1)
	self.btn_find:SetTextColor(255,240,165,25)
	self.btn_find:SetOriginalRect(65,704,37,25)
	self.btn_find:SetStretchTexture(true)
	self:Register(self.btn_find, "btn_find")
	self:AttachChild(self.btn_find)
	self:AddCallback("btn_find", ui_events.BUTTON_DOWN, self.SearchItem, self)
	---------------------------
	self.btn_spot = CUIButton()
	self.btn_spot:Init( "ui\\ui_hud", 770, 635, 45, 25 )
	self.btn_spot:SetText( "Метка" )
	self.btn_spot:SetTextAlign( CGameFont.alCenter )
	self.btn_spot:SetTextY( 1 )
	self.btn_spot:SetTextColor( 255, 240, 165, 25 )
	self.btn_spot:SetOriginalRect( 65, 704, 37, 25 )
	self.btn_spot:SetStretchTexture(true)
	self:Register( self.btn_spot, "btn_spot" )
	self:AttachChild( self.btn_spot )
	self:AddCallback( "btn_spot", ui_events.BUTTON_DOWN, self.MakeSpot, self )
	---------------------------
	xml:InitFrame( "frame_descr", self )
	self.cap_descr = CUIStatic()
	self.cap_descr:SetAutoDelete( true )
	self.cap_descr:SetFont( GetFontGraffiti19Russian() )
	self.cap_descr:Init( 25,58,70,25 )
    self:AttachChild( self.cap_descr )
	self.descr = xml:InitStatic( "descr_list", self )	
end


function spawn_items_dialog:InitCallBacks()
	self:AddCallback( "btn_item",	  		ui_events.BUTTON_CLICKED,					self.FillList_Items, 						self )
	self:AddCallback( "btn_wpn",	      	ui_events.BUTTON_CLICKED,					self.FillList_Wpns, 		    			self )
	self:AddCallback( "btn_addon",	  		ui_events.BUTTON_CLICKED,					self.FillList_Addns, 						self )
	self:AddCallback( "btn_outf",	  		ui_events.BUTTON_CLICKED,					self.FillList_Outfits, 						self )
	self:AddCallback( "btn_mp",	      		ui_events.BUTTON_CLICKED,					self.FillList_MutantParts, 		    		self )	
	self:AddCallback( "btn_ammo",	  		ui_events.BUTTON_CLICKED,					self.FillList_Ammo, 						self )
	self:AddCallback( "btn_help",	  		ui_events.BUTTON_CLICKED,					self.FillList_Medic, 						self )	
	self:AddCallback( "btn_quest",	  		ui_events.BUTTON_CLICKED,					self.FillList_Quest, 						self )
	self:AddCallback( "btn_chess",	  		ui_events.BUTTON_CLICKED,					self.FillList_Devices, 						self )
	---------------------------------------------------------
	self:AddCallback( "btn_dyn_arts",  		ui_events.BUTTON_CLICKED,					self.FillList_DynArtefacts, 				self )
	self:AddCallback( "btn_modificats",	  	ui_events.BUTTON_CLICKED,	   				self.FillList_Modificats,             		self )		
	self:AddCallback( "btn_unique_art",	    ui_events.BUTTON_CLICKED,					self.FillList_Unique, 		    			self )	
	self:AddCallback( "btn_infoportions",	ui_events.BUTTON_CLICKED,	   				self.FillList_Infoportions,         		self )		
	---------------------------------------------------------
	self:AddCallback( "btn_kill",	  		ui_events.BUTTON_CLICKED,	   				self.FillList_KillNPCs,             		self )		
	self:AddCallback( "btn_gg_com",	  		ui_events.BUTTON_CLICKED,	   				self.FillList_Community,             		self )
	self:AddCallback( "btn_st",	      		ui_events.BUTTON_CLICKED,					self.FillList_Stalkers, 		    		self )
	self:AddCallback( "btn_mob",	      	ui_events.BUTTON_CLICKED,					self.FillList_Monsters, 		    		self )	 
	self:AddCallback( "btn_money",	  		ui_events.BUTTON_CLICKED,					self.OnButton_rich_actor, 					self )	
	self:AddCallback( "btn_tp", ui_events.BUTTON_CLICKED, self.Teleport, self )
	---------------------------------------------------------	
	self:AddCallback( "btn_save",	  		ui_events.BUTTON_CLICKED,					self.OnButton_save_clicked,   				self )
	--self:AddCallback( "btn_close",	  	ui_events.BUTTON_CLICKED,		       		self.OnButton_close_clicked,    			self )
	self:AddCallback( "list_window",	  	ui_events.WINDOW_LBUTTON_DB_CLICK,			self.OnButton_create_clicked,           	self )	
	self:AddCallback( "list_window",		ui_events.LIST_ITEM_CLICKED, 				self.OnListItemClicked,						self )	
	self:AddCallback( "btn_lang", 			ui_events.BUTTON_DOWN, 						self.ClickBtnLang, 							self )	
		
end

---------------------------------------------------------
class "load_item" (CUIListItemEx)

function load_item:__init() super()
	self:SetWndRect		( 0, 0, 430, 22 )
	
	local ca = 255
	local cr = 255 -- 255
	local cg = 255 -- 234
	local cb = 255 -- 104
	
	self.fn					= CUIStatic()
	self.fn:SetAutoDelete	( true)
	self:AttachChild		( self.fn )
	self.fn:SetWndRect		( 0, 0, 230, 22 )
	self.fn:SetText			( "item" )
	self.fn:SetFont			( GetFontLetterica18Russian() )
	self.fn:SetTextColor	( ca, cr, cg, cb )
end

function spawn_items_dialog:OnTableNameFillList(table_name, spawn_category, preserve_search, tab_index)
    self.table_name = table_name or {}
    self.tbl = self.table_name
    self.spawn_type = tostring(spawn_category or "")
    if tab_index then self.tab_index = tab_index end
    local list = self:GetListWnd("list_window")
    self.selected_index = nil
    self.was_found = -1
    if not preserve_search then
        self.text = ""
        if self.search then self.search:SetText("_") end
    end
    if self.pict then self.pict:Show(false) end
    if self.descr then self.descr:SetText( "" ) end
    if list:GetSize() > 0 then
        list:SetFocusedItem(-1)
        list:RemoveAll()
    end
    for i = 1, #self.tbl do self:AddItemToList(self.tbl[i]) end
end

function spawn_items_dialog:AddItemToList( sect )
	local list = self:GetListWnd( "list_window" )
	local ini = system_ini()
	local itm_name
	if self.spawn_type == "teleport" then
		itm_name = game.translate_string( sect ) or sect
	elseif ini and ini:section_exist( sect ) and sect ~= "stalker" then
		if self.lang == "RUS" then 
			if strpos( sect, "_capsule" ) then
				itm_name = "Капсула артефакта " .. tostring( game.translate_string( string.gsub( sect, "_capsule", "_name" ) )	)
			else	
				-- itm_name = game.translate_string( read_if_exist( ini, sect, "inv_name", nil ) ) or sect
				itm_name = game.translate_string( read_if_exist_new( "s", ini, sect, "inv_name", nil ) ) or sect
			end	
		else
			itm_name = sect
		end	
	elseif string.find( sect, "^>" ) then 
		itm_name = sect			
	elseif self.spawn_type == "kill" or self.spawn_type == "community" then
		itm_name = table_translate[ sect ]
	elseif self.spawn_type == "stalker" then
		itm_name = sect
	else
		itm_name = "Секция \"".. sect .."\" отсутствует в игре!"
	end
	
	-- if string.len( itm_name ) > 50 then itm_name = string.sub(itm_name,1,48).."..." end 	-- Укоротим длинные названия
	
	if strpos( sect, "info_" ) then
		for k, v in pairs( sak_artmods.artmod_resiepts ) do
			for i = 1, #v do
				if v[ i ] == sect then
					itm_name = game.translate_string( sak_artmods.artmod_resiepts[ k ][ 7 ] )
				end
			end
		end
		for k, v in pairs( sak_artmods.amk_resiepts ) do
			for i = 1, #v do
				if v[ i ] == sect then
					itm_name = game.translate_string( sak_artmods.amk_resiepts[ k ][ 3 ] )		
				end
			end
		end
		for k, v in pairs( sak_artmods.unique_resiepts ) do
			for i = 1, #v do
				if v[ i ] == sect then   			
					itm_name = game.translate_string( sak_artmods.unique_resiepts[ k ][ 2 ] )			
				end
			end
		end						
    end	
	
	local _itm				= load_item()
	_itm.fn:SetText			( itm_name )
	list:AddItem		( _itm )
	
	if string.find( sect, "^>" ) then 
		_itm.fn:SetTextColor( 255, 40, 210, 43 )	
	end	
end

