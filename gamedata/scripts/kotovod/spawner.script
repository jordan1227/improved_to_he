class "destination" (CUIListItemEx)

function destination:__init() super()
	self:SetWndRect(0,0,530,22)
	
	self.fn	= CUIStatic()
	self.fn:SetAutoDelete(true)
	self:AttachChild(self.fn)
	self.fn:SetWndRect(0,0,250,22)
	self.fn:SetFont(GetFontLetterica18Russian())
	self.fn:SetTextColor(255,216,186,140)

	self.pm	= CUIStatic()
	self.pm:SetAutoDelete(true)
	self:AttachChild(self.pm)
	self.pm:SetWndRect(250,0,130,22)
	self.pm:SetFont(GetFontLetterica18Russian())
	self.pm:SetTextColor(255,216,186,140)
end

class "teleportator_menu" (CUIScriptWnd)

function teleportator_menu:__init(owner,objid) super()
	self.targt = objid
	self.owner = owner

	self.point_id = {}

	self:InitControls()
	self:InitCallBacks()
	self:FillList()
end

function teleportator_menu:__finalize()
end

function teleportator_menu:FillList()
	local list_box = self:GetListWnd("list_window")
	local _itm, place
	for i = 1, #points do 			-- Сколько всего точек!
		place = points[ i ]
		_itm = destination()
		_itm.fn:SetText( game.translate_string( place.level ) )
		_itm.pm:SetText( tostring( place.name ) )
		list_box:AddItem(_itm )
		table.insert( self.point_id, i )
	end
end

function teleportator_menu:InitControls()
	self:Init(0,0,1024,768)
	
	-- файл-описатель наших элементов
	local ctrl
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_mm_teleportator.xml")

	self.dialog	= xml:InitStatic("main_dialog:dialog", self)
	xml:InitStatic("main_dialog:capt", self.dialog)
	xml:InitStatic("main_dialog:msg1", self.dialog)
	xml:InitStatic("main_dialog:msg2", self.dialog)
	
	-- кнопки
	self:Register(xml:Init3tButton("main_dialog:btn_ok", self.dialog),"btn_ok")
	self:Register(xml:Init3tButton("main_dialog:btn_quit", self.dialog),"btn_quit")
	xml:InitFrame("main_dialog:list_frame", self.dialog)
	ctrl = xml:InitList("main_dialog:list", self.dialog)
	ctrl:ShowSelectedItem(true)
	self:Register(ctrl, "list_window")
end

function teleportator_menu:InitCallBacks()
	self:AddCallback("btn_ok", ui_events.BUTTON_CLICKED, self.on_ok, self)
	self:AddCallback("btn_quit", ui_events.BUTTON_CLICKED, self.on_quit, self)
	self:AddCallback("list_window", ui_events.WINDOW_LBUTTON_DB_CLICK, self.OnListItemDbClicked, self)
end

function teleportator_menu:OnKeyboard( dik, keyboard_action )
	CUIScriptWnd.OnKeyboard( self, dik, keyboard_action )
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_ESCAPE then
			self:on_quit()
		end
		if dik == DIK_keys.DIK_RETURN then
			self:on_ok()
		end
	end
	return true
end

function teleportator_menu:OnListItemDbClicked()
	self:on_ok()
end

function teleportator_menu:on_ok()
	local list = self:GetListWnd("list_window")	
	if list:GetSize()==0 then return end
	local index = list:GetSelectedItem()
	if index == -1 then return end
	local n = self.point_id[index+1]

	self:on_quit()
	this.create_level_changers(points[n].lv, points[n].gv, vector():set(points[n].x, points[n].y, points[n].z))
end

function teleportator_menu:on_quit()
	self:GetHolder():start_stop_menu(self, false)
	self.owner:Show (true)
	get_console():execute("main_menu off")
end

function remove_created_changer()
	local ch = get_value( "spawned_lc" )
	if not ch then return end
	local changer = g_sim:object( ch )
	if changer then 
		misc.release_obj( changer )
		remove_value( "spawned_lc" )
		sak.send_tip( 
			"Level Changer уже существует, поэтому был удален. Пересоздайте телепорт!", 
			nil, 0, 25, "stalker", "sak", "red"
		)
	end	
end

--// Спавн временного левел-чейнджера
function create_level_changers(
	p_dest_lv,										-- level_vertex_id   - идентифицируют уровень, на который level_changer будет перебрасывать игрока 
	p_dest_gv,										-- game_vertex_id
	p_dest_pos										-- координаты точки, в которой на новом уровне окажется игрок
	)
	-- следующие параметры убраны из аргументов, т.к. не меняются
	local p_story_id = 987987						-- STORY_ID нового level_changer (понадобится нам позже)
	local p_position = db.actor:position()			-- вектор, координаты точки, в которой будет располагаться центр нового level_changer
	local p_lvertex_id = db.actor:level_vertex_id()	-- level_vertext_id - идентифицируют уровень, на котором будет создан level_changer
	local p_gvertex_id = db.actor:game_vertex_id()	-- game_vertext_id   	
	local p_dest_dir = vector():set(0,0,0)			-- направрение взгляда игрока
	local p_dest_level = level.name()				-- название уровня, например "L11_Pripyat" (уровень НА КОТОРОМ создаётся ЛЧ, не назначения!)
	local p_silent = 1								-- следует задать 1, чтобы подавить вопрос о смене уровня (автоматический переход)

	this.remove_created_changer()

	local sim = alife()
	local obj = sim:create("level_changer", p_position, p_lvertex_id, p_gvertex_id)
	set_value( "spawned_lc", obj.id )
 
--	level.map_add_object_spot(obj.id, "level_changer", "")
 
	local packet = net_packet()
	obj:STATE_Write(packet)
 
	-- свойства cse_alife_object
	local game_vertex_id 				= packet:r_u16()
	local cse_alife_object__unk1_f32 	= packet:r_float()
	local cse_alife_object__unk2_u32 	= packet:r_u32()
	local level_vertex_id 				= packet:r_u32()
	local object_flags 					= packet:r_u32()
	local custom_data 					= packet:r_stringZ()
	local story_id 						= packet:r_u32()
	local spawn_story_id				= packet:r_u32()
 
	-- свойства cse_shape
	local shape_count 			= packet:r_u8()
	for i=1,shape_count do
		local shape_type 		= packet:r_u8()
		if shape_type == 0 then
			-- sphere
			local center 		= packet:r_vec3()
			local radius 		= packet:r_float()
		else
			-- box
			local axis_x_x = packet:r_float()
			local axis_x_y = packet:r_float()
			local axis_x_z = packet:r_float()
			local axis_y_x = packet:r_float()
			local axis_y_y = packet:r_float()
			local axis_y_z = packet:r_float()
			local axis_z_x = packet:r_float()
			local axis_z_y = packet:r_float()
			local axis_z_z = packet:r_float()
			local offset_x = packet:r_float()
			local offset_y = packet:r_float()
			local offset_z = packet:r_float()
		end
	end
 
	-- свойства cse_alife_space_restrictor
	local restrictor_type 			= packet:r_u8()
 
	-- свойства cse_level_changer
	local dest_game_vertex_id		= packet:r_u16()  
	local dest_level_vertex_id 		= packet:r_u32()  
	local dest_position 			= packet:r_vec3()
	local dest_direction 			= packet:r_vec3()
	local dest_level_name 			= packet:r_stringZ()
	local dest_graph_point 			= packet:r_stringZ()
	local silent_mode 				= packet:r_u8()
 
 
	packet:w_begin(game_vertex_id)			-- game_vertex_id
	packet:w_float(cse_alife_object__unk1_f32)
	packet:w_u32(cse_alife_object__unk2_u32) 
	packet:w_u32(level_vertex_id)			-- level_vertex_id
	packet:w_u32( bit_not(193) )			-- object_flags = -193 = 0xFFFFFF3E
	packet:w_stringZ(custom_data)
	packet:w_u32(p_story_id)				-- story_id
	packet:w_u32(spawn_story_id)
 
	packet:w_u8(1)			-- количество фигур
	packet:w_u8(1)			-- тип фигуры: box
	packet:w_float(50)	   	-- axis_x_x
	packet:w_float(0)	   	-- axis_x_y
	packet:w_float(0)	  	-- axis_x_z
	packet:w_float(0)	  	-- axis_y_x
	packet:w_float(50)	   	-- axis_y_y
	packet:w_float(0)	   	-- axis_y_z
	packet:w_float(0)	  	-- axis_z_x
	packet:w_float(0)	   	-- axis_z_y
	packet:w_float(50)	   	-- axis_z_z
	packet:w_float(0)	   	-- offset_x
	packet:w_float(0)	   	-- offset_y
	packet:w_float(0)      	-- offset_z
 
	packet:w_u8(3)	 	   	-- restrictor_type
 
	packet:w_u16(p_dest_gv)				-- destination game_vertex_id
	packet:w_s32(p_dest_lv)				-- destination level_vertex_id
	packet:w_vec3(p_dest_pos)			-- destination position
	packet:w_vec3(p_dest_dir)			-- destination direction (направление взгляда)
	packet:w_stringZ(p_dest_level)		-- destination level name
	packet:w_stringZ("start_actor_02")	-- some string, always const
	packet:w_u8(p_silent)				-- 1 for silent level changing
 
	packet:r_seek(0)
	obj:STATE_Read(packet, packet:w_tell())
	-- level.add_pp_effector ("teleport.ppe", 2006, false)			-- эффектор, если нужен
	timers.start_timer( "del_spawned_lc", 0, 0, 1, "spawner.del_lc()" )	
end

function del_lc()
	local ch = get_value( "spawned_lc" )
	if not ch then return end
	local changer = g_sim:object( ch )
	if changer then 
		sak.send_tip( changer:name(), "Удалён LC:", 0, 10, "g_g", "sak", "red" )		
		misc.release_obj( changer )		
		remove_value( "spawned_lc" )
	end	
end

--\\----------------- Сортировка секций

local index2type = {
	[1] = "weapons",
	[2] = "ammo",
	[3] = "addons",
	[4] = "outfits",
	[5] = "artefacts",
	[6] = "food_and_drugs",
	[7] = "items",
	[8] = "quest_items",
	[9] = "npc",
	[10] = "mobs",
	[11] = "anomalies",
	[12] = "junk"
}

function init_cheat_table()
	local cheat_list = {}
	local tmp = collect_sections.main()
	local name
	for i, v in ipairs(index2type) do
		local tbl = tmp[v]
		if tbl then
			local t = {}
			cheat_list[v] = t
			for j, sec in ipairs( tbl ) do
				if v == "npc" or v == "mobs" then
					name = sec
					if v == "npc" then
						local rank = sys_ini:line_exist( sec, "spec_rank" ) and sys_ini:r_string( sec, "spec_rank" )
						local community = sys_ini:line_exist( sec, "community" ) and sys_ini:r_string( sec, "community" )
						if community and rank then
							if community == "stalker" or community == "stranger" then
								community = "neutral"
							end
							name = community.."_"..rank
						end
					end
					name = game.translate_string( name )
					if sys_ini:line_exist( sec, "custom_data" )
						and sys_ini:r_string( sec, "custom_data" ) ~= "stalker_custom_data.ltx"
					then
						name = "! "..name
					end
					table.insert( t, { sec, name } )
				elseif v ==  "anomalies" then
					name = sec
					table.insert( t, { sec, name } )
				else
					table.insert( t, { sec, get_inv_name(sec,sec) } )
				end
			end
		end
	end
	this.sort_sections( cheat_list, 0 )
	return cheat_list
end

function sort_sections( list, mode )
	if mode then
		for k, t in pairs( list ) do
			table.sort( t, function( t1, t2 )
				if t1[2] == t2[2] or mode == 1 then
					return t1[1] < t2[1]
				else
					return t1[2] < t2[2]
				end
			end)
		end
	end
end

			
