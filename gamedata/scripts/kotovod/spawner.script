function spawn_items_dialog:FillList_Infoportions()
	if self.owner.info_menu == nil then
		self.owner.info_menu = ui_info_menu.CUIInfoMenu()
		self.owner.info_menu.owner = self.owner
	end
	self:GetHolder():start_stop_menu( self.owner.info_menu, true )
	self:GetHolder():start_stop_menu( self, true )
	self.owner:Show( true )	
	-- this.init_cheat_table()	-- Включить сортировку секций при нажатии на поршень
end


function spawn_items_dialog:ClickBtnLang()
	self.lang = ( self.lang == "RUS" and "ENG" ) or "RUS"
	self.btn_lang:SetText( self.lang )
	self:OnTableNameFillList( self.table_name, self.spawn_type, true )
end

function make_static( name, own, text, x, y, width, height )
    local static = CUIStatic()
    static:SetWindowName( name )
    static:SetAutoDelete( true )
    if text then
        static:SetTextComplexMode( true )
        static:SetText( text )
    end
    static:Init( x, y, width, height )
    own:AttachChild( static )
    return static
end

function spawn_items_dialog:Update_DynArtefact()
	if self.dyn then self:DetachChild( self.dyn ) end
	self.dyn = make_static( "dyn", self, "".. self.current_dyn .."", 160, 638, 60, 60 )
	self.dyn:SetTextColor( 255, 20,  230,  40 )
	self.dyn:SetFont( GetFontGraffiti22Russian() )	
end

function spawn_items_dialog:OnListItemClicked()
    if self.list:GetSize() == 0 then return end
    local index = self.list:GetSelectedItem()
    if not index or index < 0 then return end
    if not self.tbl or index + 1 > #self.tbl then return end
    self.list:SetFocusedItem(index)
    self.selected_index = index
    self:GetDescription(index)
end

function spawn_items_dialog:OnButton_rich_actor()
	sak_dialog.relocate_money( 10000, "in" )
	local snd = xr_sound.get_safe_sound_object([[device\decoder]])
	snd:play( db.actor, 0, sound_object.s2d )
end

function spawn_items_dialog:OnButton_create_clicked()
	local list = self:GetListWnd( "list_window" )
	if list:GetSize() == 0 or not self.tbl then return end
	local item_index = list:GetFocusedItem()
	if item_index == nil or item_index < 0 then item_index = list:GetSelectedItem() end
	if item_index == nil or item_index < 0 then item_index = self.selected_index end
	if item_index == nil or item_index < 0 then return end
	local item = self.tbl[item_index + 1]
	if not item then return end
	self.selected_index = item_index

	if self.spawn_type == "teleport" then
		if not teleport_level_lookup[item] then return end
		local console = get_console()
		if not console then return end
		self:OnButton_close_clicked()
		console:execute( "jump_to_level " .. item )
		return
	end
	if self:CreateSelectedItem( item ) then
		local snd = xr_sound.get_safe_sound_object([[device\decoder]])
		snd:play( db.actor, 0, sound_object.s2d )
	end
end

function spawn_items_dialog:CreateSelectedItem( item )
	local actor = db and db.actor
	if not actor or not actor:alive() then return false end
	local ini = system_ini()
	if self.spawn_type == "actor" then
		return self:SpawnActorItem( item, ini, actor )
	elseif self.spawn_type == "dynamic" then
		return self:SpawnDynamicItem( item, ini )
	elseif self.spawn_type == "stalker" then
		return self:SpawnStalker( item, ini, actor )
	elseif self.spawn_type == "info" then
		actor:give_info_portion( item )
		kotovod.sms_recipt_found( item )
		return true
	elseif self.spawn_type == "kill" then
		return self:KillSelected( item, actor )
	elseif self.spawn_type == "community" then
		if not str_in_tab( item, table_community ) then return false end
		relation_registry.set_community_goodwill( item, actor:id(), 5000 )
		return true
	end
	return false
end

function spawn_items_dialog:SpawnActorItem( item, ini, actor )
	if item == "af_capsule" then
		nlc_capsules.give( nlc_capsules.random_regular( true ) )
		return true
	elseif item == "m_capsule" then
		nlc_capsules.give( nlc_capsules.random_mayatnik() )
		return true
	end
	if not ini or not ini:section_exist( item ) then return false end
	if item == "flask_army" then
		vergas_flask.create_water_flask( self.current_dyn or 5 )
	elseif item == "device_pda_npc" then
		mike.add_pda_npc_amount( 1, math.min( math.max( self.current_dyn or 1, 1 ), 3 ) )
	else
		sak.create_items( item, 1 )
	end
	return true
end

function spawn_items_dialog:SpawnDynamicItem( item, ini )
	if not item or string.find( item, "^>" ) then return false end
	if self.current_dyn < 1 or self.current_dyn > 6 then
		self.current_dyn = 3
		self:Update_DynArtefact()
	end
	local section = item .. "_dyn" .. self.current_dyn .. "d"
	if not ini or not ini:section_exist( section ) then return false end
	sak.create_items( section, 1 )
	return true
end

function spawn_items_dialog:SpawnStalker( item, ini, actor )
	if not ini or not ini:section_exist( item ) then return false end
	local sim = alife()
	if not sim then return false end
	local pos = actor:position():add( actor:direction():mul( 3 ) )
	local spawned = sim:create( item, pos, actor:level_vertex_id(), actor:game_vertex_id() )
	if not spawned then return false end
	if self.current_dyn == 5 and IsMonster( spawned ) then
		local part = utils.cfg_get_string( ini, item, "Spawn_Inventory_Item_Section", false, false, false, "" )
		if part and part ~= "" and ini:section_exist( part ) then misc.spawn_to( part, spawned ) end
	end
	return true
end

function spawn_items_dialog:KillSelected( item, actor )
	local creatures = db.creatures or {}
	local sim = g_sim or alife()
	if str_in_tab( item, { "poltergeist", "zombi", "gigant", "zombied" } ) then
		for id, obj in pairs( creatures ) do
			if sim and sim:object( id ) and obj and obj:alive() then
				if
					(item == "poltergeist" and strpos( obj:section(), "m_poltergeist_", 1, true ))
					or (item == "zombi" and strpos( obj:section(), "zombie_", 1, true ))
					or (item == "gigant" and strpos( obj:section(), "gigant_", 1, true ) and obj:section() ~= "marsh_gigant")
					or (item == "zombied" and strposx( obj:name(), "zombied" ))
				then
					log2( "item is %s", item )
					obj:kill( actor )
				end
			end
		end
	elseif item == "tehnic" then
		for id = 1, MAX_OBJ_ID do
			local obj = sim and sim:object( id )
			if obj then
				local posobj = obj.position
				if posobj:distance_to( actor:position() ) < 100 and (obj:clsid() == 94 or obj:clsid() == 47) then misc.release_obj( obj ) end
			end
		end
	elseif str_in_tab( item, table_community ) then
		for id, obj in pairs( creatures ) do
			if sim and sim:object( id ) and obj and obj:alive() and obj:is_stalker() then
				local community = obj:character_community()
				if community and strpos( community, item, 1, true ) then
					log2( "kill: %s -> %s (%s)", item, obj:name(), obj:section() )
					obj:kill( actor )
				end
			end
		end
	else
		local to_kill = {}
		for _, obj in pairs( creatures ) do
			if obj and obj:alive() and obj:is_monster() then table.insert( to_kill, obj ) end
		end
		for _, obj in ipairs( to_kill ) do obj:kill( actor ) end
	end
	return true
end

function spawn_items_dialog:OnButton_close_clicked()
	self:GetHolder():start_stop_menu( self, true )
	self.owner:Show( true )
	if level.present() and db.actor and db.actor:alive() then
		get_console():execute( "main_menu off" )
		ogse_signals.get_mgr():call("on_mm_return_game")	-- torch восстановление, мб потом еще что
	end
end

function spawn_items_dialog:OnButton_save_clicked()
	if get_value("blowout", 0) == 0 and _G.flag_can_save then
		local bl_save = string.format( "День %s %s. %s [СПАВНЕР]", timers.Get_Game_Days(), level.get_time_hours(), level.get_time_minutes())
		cmd("save", dsh.safe_file_name(bl_save))
	end

	--savemgmt.on_wakeup()	
	--schedule.add( "rename_cheat", "spawner.rename_cheat_save()", 200 )		
	-- local snd = xr_sound.get_safe_sound_object([[characters_voice\human_01\bandit\fight\cover_fire\cover_fire_6]])
	local snd = xr_sound.get_safe_sound_object([[device\decoder]])	
	snd:play( db.actor, 0, sound_object.s2d )	
end

function rename_cheat_save()
	local last_save = alife().save_name
	local fs = getFS()
	if fs:exist( "$game_saves$", last_save ) then    
		local file = string.sub( last_save, 1, string.len( last_save ) - 4 )
		local sg = CSavedGameWrapper( file )
		local lname = sg:level_name()            
		local y, m, d, h, min, sec, ms = 0, 0, 0, 0, 0, 0, 0
		y, m, d, h, min, sec, ms = sg:game_time():get( y, m, d, h, min, sec, ms )
		local start_month = 5
		local days = ui_load_dialog.GetDaysByMonth( m ) - ui_load_dialog.GetDaysByMonth( start_month ) + d    
       
		--local safe_lname = game.translate_string(lname):gsub('"', "'"):gsub('[<>:"/\\|?*]', ''):gsub('«', '"'):gsub('»', '"')
        local safe_lname = game.translate_string( lname )
            :gsub('«', '"')           	-- Заменяем открывающую ёлочку на обычную кавычку
            :gsub('»', '"')           	-- Заменяем закрывающую ёлочку на обычную кавычку
            :gsub('[<>:/\\|?*]', '')  	-- Удаляем недопустимые символы
            :gsub('%s+', ' ')         	-- Заменяем множественные пробелы на один
            :gsub('^%s*(.-)%s*$', '%1') -- Убираем пробелы в начале и конце
            :gsub('"', "'")           	-- Заменяем обычные кавычки на одинарные

        local new_save = string.format( "%s сутки %s - %s [Спавнер]", 
            days, 
            string.format( "%02u.%02u", h, min ), 
            safe_lname
        )
       
		WriteIni( db.stor_ltx, "stor", "last_save_name", new_save )
       
		local f1 = fs:update_path( "$game_saves$", last_save )
		local f2 = fs:update_path( "$game_saves$", new_save ..".sav" )
		fs:file_copy( f1, f2 )
		fs:file_delete( f1 )
		rename_saves.rename_dds_file( file, new_save )        
	end        
end

--\\ Поиск предметов --------------

function spawn_items_dialog:RemoveText()
	self.text = ""
	self.search:SetText( "_" )
	self.was_found = -1
end

function spawn_items_dialog:SearchText( letter )
	local lett = letter and ( self.lang == "RUS" and self.translit[ letter ] or letter ) or ""
	if string.len( self.text ) >= 40 then return end
	if string.len( self.text ) > 1 then self.text = string.sub( self.text, 1, -2 ) .. lett .. "_"
	else self.text = lett .. "_" end
	self.was_found = -1
	self.search:SetText( self.text )
end

function spawn_items_dialog:SearchItem()
	if not self.text or self.text == "" then return end
	local search_text = string.sub( self.text, 1, -2 )
	if search_text == "" then return end
	search_text = string_lower( search_text )
	search_text = string.gsub( search_text, "-", " " )
	for i = 0, self.list:GetSize() - 1 do
		local item = self.list:GetItem( i )
		local item_text = string_lower( item.fn:GetText() )
		item_text = string.gsub( item_text, "-", " " )
		item_text = string.gsub( item_text, "ё", "е" )
		if string.find( item_text, search_text, 1, true ) and self.was_found < i then
			self.was_found = i
			self.selected_index = i
			self.list:ScrollToPos( i )
			self.list:SetFocusedItem( i )
			self:GetDescription( i )
			break
		end
	end
end

function spawn_items_dialog:BackSpace()
	if self.text ~= "" and string.len( self.text ) > 2 then
		self.text = string.sub( self.text, 1, -3 ) .. "_"
		self.search:SetText( self.text )
	else
		self.text = "_"
	end
	self.was_found = -1
	self.search:SetText( self.text )
end

function spawn_items_dialog:NavigateList( where )
	if not where or not self.spawn_type then return end
	local size = self.list:GetSize()
	if size == 0 then return end
	local index = self.list:GetFocusedItem()
	if index == nil or index < 0 then index = self.selected_index or -1 end
	local next_index
	if where == "down" then
		next_index = (index < 0 or index >= size - 1) and 0 or index + 1
	elseif where == "up" then
		next_index = (index <= 0 or index > size - 1) and size - 1 or index - 1
	else
		return
	end
	self.selected_index = next_index
	self.list:SetFocusedItem( next_index )
	self.list:ScrollToPos( next_index )
	self:GetDescription( next_index )
end

function spawn_items_dialog:ChangeButton( where )
	local buttons = {
		table_items, table_wpn, table_wpn_addons, table_outfits,
		table_mutant_parts, table_ammo, table_medkits, table_quest_items,
		table_devices, table_modificats, table_unique_arts, table_arts_dynamic,
		table_kill_npc, table_community, table_spawn_monsters, table_spawn_npc
	}
	self.tab_index = self.tab_index or 1
	if where == "back" and buttons[self.tab_index - 1] then
		self.tab_index = self.tab_index - 1
	elseif where == "next" and buttons[self.tab_index + 1] then
		self.tab_index = self.tab_index + 1
	else
		return
	end
	local what = "actor"
	if self.tab_index == 12 then what = "dynamic"
	elseif self.tab_index == 13 then what = "kill"
	elseif self.tab_index == 14 then what = "community"
	elseif self.tab_index == 15 or self.tab_index == 16 then what = "stalker"
	end
	self:OnTableNameFillList( buttons[self.tab_index], what, false, self.tab_index )
end

function spawn_items_dialog:MakeSpot()
    if self.text == "" then return end
    if self.lang == "RUS" then return end  -- Убрали сброс текста

    if not db.actor or not db.actor:alive() then return end

    local search_text = string_lower(string.sub(self.text, 1, -2))
    search_text = string.gsub(search_text, "-", " ")

    for a = 1, MAX_OBJ_ID do
        local obj = g_sim:object(a)
        if obj and obj.parent_id ~= 0 and strpos(obj:name(), search_text) then 
            local lname = "???"
            local gvid = obj.m_game_vertex_id
            if gvid ~= nil then 
                lname = game.translate_string(this.lname(gvid)) 
            end
            
            local ini = system_ini()
            -- Убедитесь, что sect определен
            local sect = obj:name()  -- или используйте подходящее значение для sect
            local rus = game.translate_string(read_if_exist_new("s", ini, sect, "inv_name", nil)) or obj:name()

            level.map_add_object_spot_ser(obj.id, "red_location", "".. rus .."")	
            timers.start_timer("del_diff_spots", 0, 0, 20, "spawner.remove_different_spots(".. obj.id ..")")	
            sak.send_tip(
                "Установлена метка на объект: ".. rus .." \\nУровень: ".. lname .." \\nавтоудаление через 20 минут", 
                nil, 1, 7, "g_g", "no", "green" 
            )					
        end	
    end	
end

function remove_different_spots( obj_id )
	local obj = g_sim:object( obj_id )
	if obj then 
		amk.remove_spot_from_map( obj.id, "red_location" )	
	end
end

function spawn_items_dialog:GetDescription( index )
	if not self.tbl or not self.tbl[index + 1] then return end
	local section = self.tbl[ index + 1 ]
	if self.spawn_type == "teleport" then return end
	if string.find(section, "^>") then
		if self.pict then self.pict:Show( false ) end
		if self.descr then self.descr:SetText( "" ) end
		return
	end
	if self.pict then self.pict:Show( true ) end
	local sizes = give_icon_params( section )
	
	local px = 625 + ( 182 - ( sizes.width  * 0.26 * 1.2 ) )                       -- 0.26 для 1:1 на 1920
	local py = 58 + ( 128 - ( sizes.height * 0.32 * 1.2 ) )                        -- 0.32 для 1:1 на 1920
	local pw =  sizes.width * 0.52 * 1.2
	local ph = sizes.height * 0.64 * 1.2 
	
	if self.pict == nil then
		self.pict = CUIStatic()
		self.pict:SetWindowName("pict")
		self.pict:SetAutoDelete(true)
		self:AttachChild(self.pict)
	end
	
	local file
	if sizes.icon_group == 0 then
        file = "ui\\ui_icon_equipment"
	else
		file = "ui\\ui_icon_equipment_" .. sizes.icon_group
	end
			
	self.pict:InitTexture(file)
	self.pict:SetOriginalRect(sizes.x,sizes.y,sizes.width,sizes.height)
	self.pict:Init(px,py,pw,ph)
	self.pict:SetStretchTexture(true)
	
	local ini = system_ini()
    local description = "%c[255,255,0,0]"
    if ini:section_exist(section) then

        description = "Характеристики:"
        if ini:line_exist( section, "hit_power" ) then
            description = description .. "\\n %c[255,160,160,160]• убойность: "..math.round(ini:r_float(section, "hit_power")*100,1)
        end
        if ini:line_exist( section, "silencer_hit_power" ) then
            description = description .. "\\n %c[255,160,160,160]• убойность с глушителем: "..math.round(ini:r_float(section, "silencer_hit_power")*100,1)
        end
        if ini:line_exist( section, "fire_distance" ) then
            description = description .. "\\n %c[255,160,160,160]• дальность: "..ini:r_u32(section, "fire_distance")
        end
        if ini:line_exist( section, "silencer_fire_distance" ) then
            description = description .. "\\n %c[255,160,160,160]• дальность с глушителем: "..ini:r_u32( section, "silencer_fire_distance" )
        end
        if ini:line_exist( section, "rpm" ) then 
            description = description .. "\\n %c[255,160,160,160]• скорострельность: "..ini:r_u32( section, "rpm" )
        end
		if ini:line_exist( section, "cost" ) then
            description = description .. "\\n %c[255,160,160,160]• цена: "..ini:r_u32( section, "cost" )		
		end
		if ini:line_exist( section, "inv_weight" ) then
            description = description .. "\\n %c[255,160,160,160]• вес: "..ini:r_u32( section, "inv_weight" )		
		end		
    
		local infos = {
			{"burn", "           "},
			{"shock", "      "},
			{"strike", "           "},
			{"wound", "         "},
			{"radiation", "        "},
			{"telepatic", "       "},
			{"chemical_burn", "       "},
			{"explosion", "          "},
			{"fire_wound", "    "},
		}
		for _, item in ipairs( infos ) do
			if ini:line_exist( section, item[ 1 ] .. "_protection" ) then
				value = math.round( ini:r_float( section, item[ 1 ] .. "_protection" ) * 100 )
				if value > 0 then
					description = description.."\\n%c[255,255,255,255]"..game.translate_string("ui_inv_outfit_"..item[1].."_protection").."\t\t%c[255,1,255,1] "..value.."%"
				end
			end
		end
	
		if sizes.description ~= nil then 
			description = description .. "\\n" .. sizes.description
		else
			description = description.."\\n%c[255,255,255,255]Описание отсутствует"
		end		
	end
	
	if string.len( description ) >= 700 then description = string.sub( description, 1, 697 ) .. "..." end
	
	self.descr:SetText( description )
end

local sect_by_icon = {		-- иконки для сталкеров
	["esc_stalker_respawn_1"]="ui_npc_u_green_stalker_2",
