-- [HE-PORT]
local ICON_REG = "ui\\ui_npc_u_actor_nlc"
local ICON_DIR = "ui\\actor_icons\\ui_npc_u_actor_"
local POLL_MS = 1000
local next_poll = 0
local applied = nil
local cache = {}

local function icon_for(sect)
	local key = sect or ""
	local file = cache[key]
	if file then return file end
	local vis = "without"
	local ini = system_ini()
	if sect and ini:section_exist(sect) and ini:line_exist(sect, "actor_visual") then
		vis = ini:r_string(sect, "actor_visual")
	end
	vis = string.lower(vis):gsub("^.*\\", ""):gsub("%.ogf$", "")
	file = ICON_DIR .. vis
	if not getFS():exist("$game_textures$", file .. ".dds") then
		file = ICON_REG
	end
	cache[key] = file
	return file
end

local function current_outfit()
	local a = db.actor
	if not a then return nil end
	local o = a:item_in_slot(6)
	if o then return o:section() end
	return nil
end

local function apply()
	if not fl_tex_swap then return end
	local file = ICON_REG
	if game_options.ActorIconOutfit ~= false then
		file = icon_for(current_outfit())
	end
	if applied == file then return end
	if fl_tex_swap(ICON_REG, file) then applied = file end
end

function refresh()
	applied = nil
	apply()
end

function on_game_loaded()
	applied = nil
	next_poll = 0
	apply()
end

function on_item_to_slot()
	apply()
end

function on_item_to_ruck()
	apply()
end

function on_update()
	local t = time_global()
	if t < next_poll then return end
	next_poll = t + POLL_MS
	apply()
end

function attach(sm)
	sm:subscribe({ signal = "on_update", fun = this.on_update })
	sm:subscribe({ signal = "on_game_loaded", fun = this.on_game_loaded })
	sm:subscribe({ signal = "on_item_to_slot", fun = this.on_item_to_slot })
	sm:subscribe({ signal = "on_item_to_ruck", fun = this.on_item_to_ruck })
end
