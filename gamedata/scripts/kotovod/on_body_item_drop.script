function attach( sm )
    sm:subscribe({ signal = "npc_use", fun = this.on_body_open })
end

function on_body_open( npc )
    if not npc then return end
    if not (IsStalker( npc ) and not npc:alive()) then return end

    dsh.wait_condition( function() return has_alife_info( "ui_car_body" ) end, function()
        local body = npc
        local sig_drop, sig_hide

        local function cleanup()
            if sig_drop then
                ogse_signals.get_mgr():unsubscribe( sig_drop )
                sig_drop = nil
            end
            if sig_hide then
                ogse_signals.get_mgr():unsubscribe( sig_hide )
                sig_hide = nil
            end
            body = nil
        end

        local function on_drop( obj )
            if not body then return end
            body:drop_item( obj )
            safe_close_window()
            vergas_lib.s_play( [[device\antirad_no]], 1 )
        end

        local function on_body_hide()
            cleanup()
        end

        sig_drop = { signal = "on_drop", fun = on_drop }
        sig_hide = { signal = "on_body_hide", fun = on_body_hide }

        ogse_signals.get_mgr():subscribe( sig_drop )
        ogse_signals.get_mgr():subscribe( sig_hide )
    end )
end

function safe_close_window()
    local self = level.main_input_receiver()
    if self and self.GetHolder and self:GetHolder() then
        self:GetHolder():start_stop_menu( self, true )
    end
end