-- РџСЂРё РґРѕР±Р°РІР»РµРЅРёРё РЅРѕРІРѕР№ РѕРїС†РёРё РѕР±СЏР·Р°С‚РµР»СЊРЅРѕ РІС‹СЃС‚Р°РІРёС‚СЊ РґРµС„РѕР»С‚РЅРѕРµ Р·РЅР°С‡РµРЅРёРµ!
-- РўРёРїС‹ СЃРѕС…СЂР°РЅСЏРµРјС‹С… Р·РЅР°С‡РµРЅРёР№: string, number Рё boolean

--// ***** Р”РѕРїРѕР»РЅРёС‚РµР»СЊРЅС‹Рµ РѕРїС†РёРё *****

AdditionalMobHits			= true
IconsDialogue 				= false
MaxSavesCount = 50
-- [HE-PORT] false = авторский баланс (метки тайников на карту не ставятся),
-- true = упрощённый (gd_novice). Синхронизируется sync_balance_value().
BalanceValue				= false


-- g_loadstring game_options.load_game_options()

-- Р’С‹Р·С‹РІР°РµС‚СЃСЏ РѕРґРёРЅ СЂР°Р· РїСЂРё Р·Р°РіСЂСѓР·РєРµ СЃРєСЂРёРїС‚РѕРІ
function load_game_options()
	log3( "loading GAME OPTS" )
	local fs = getFS()
	if fs:exist( "$app_data_root$", "game.options" ) == nil then
		local f1 = fs:update_path( "$fs_root$", "fsgame.ltx" )
		local f2 = fs:update_path( "$app_data_root$", "game.options" )
		fs:file_copy( f1, f2 )
		save_game_options()
	else
		local file = io.open( fs:update_path( "$app_data_root$", "game.options" ), "r" )
		local opt, val, n = "", "", 0
		local m = _G[script_name()]
		for line in file:lines() do
			opt, val = string.match(line, "([%w_]+)%s*=%s*(.+)")
			log3("load options: "..tostring(opt).." = "..tostring(val))
			if opt and m[ opt ] ~= nil then
				n = tonumber( val )
				if n then m[ opt ] = n
				elseif val == 'true' then m[ opt ] = true
				elseif val == 'false' then m[ opt ] = false
				elseif val ~= "" then m[ opt ] = val end
			end
		end
		file:close( file )
	end
end

-- [HE-PORT] В 3.0 опция переключалась в меню; в live её роль играет выбор
-- сложности: gd_novice = упрощённый баланс, gd_master = авторский.
function sync_balance_value()
	local d = get_value( "g_diff" )
	if d == nil and level and level.get_game_difficulty then
		d = tonumber( level.get_game_difficulty() )
	end
	BalanceValue = ( tonumber( d ) == 0 )
	return BalanceValue
end

function save_game_options()
    local t = _G[script_name()]
    local tmp = {}

    for k, v in pairs(t) do
        -- СЃРѕС…СЂР°РЅСЏРµРј С‚РѕР»СЊРєРѕ вЂњРёРіСЂРѕРІС‹Рµ РѕРїС†РёРёвЂќ:
        if type(v) ~= "function" and not k:match("^_") then
            table.insert(tmp, {k, v})
        end
    end

    table.sort(tmp, function(a, b) return a[1] < b[1] end)

    local file = io.open(getFS():update_path("$app_data_root$", "game.options"), "w")
    for i, v in ipairs(tmp) do
        file:write(v[1], " = ", tostring(v[2]), "\n")
    end
    file:close()
end


local defaults = {
	IconsDialogue = false,
	BalanceValue = false,
	MaxSavesCount = 50,
}

-- РЎР±СЂРѕСЃРёС‚СЊ РІСЃРµ РёРіСЂРѕРІС‹Рµ РѕРїС†РёРё Рє РґРµС„РѕР»С‚РЅС‹Рј Р·РЅР°С‡РµРЅРёСЏРј
function reset_to_default()
	local m = _G[script_name()]
	for k, v in pairs(defaults) do
		m[k] = v
	end
	save_game_options()
end