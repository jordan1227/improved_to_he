    -- ============================================================
    -- c["wpn_svd"] = { c = 1.2, u = 1.15 }
    -- c["wpn_g3"]  = { c = 1.2, u = 1.15 }

    -- ============================================================
    -- Shotguns -- heavy but short: lots of felt mass, less barrel to dip
    -- ============================================================
