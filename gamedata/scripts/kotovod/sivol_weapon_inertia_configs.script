--[[
    sivol_weapon_inertia_configs.script

    Per-weapon override table for sivol_weapon_inertia.
      c = crouch sway/kick power multiplier
      u = look-up-lowers-gun power multiplier

    Both are multipliers on top of the global CROUCH_HOLD_POWER/LOOKUP_POWER
    constants in sivol_weapon_inertia.script -- 1 = use the global default
    as-is. Ported structure from liz_inertia_expanded_custom_weapon_configs.script;
    l/r (lean) fields dropped since lean isn't in scope for this port.

    Starting tiers below are a first pass -- test a handful of weapons per
    tier in-game and nudge individual sections from there. Fill in your
    actual NLC weapon section names (from weapons.ltx) in place of the
    vanilla/common examples.
]]

if sivol_weapon_inertia then
    sivol_weapon_inertia.wpn_all_configs = sivol_weapon_inertia.wpn_all_configs or {}

    local c = sivol_weapon_inertia.wpn_all_configs

    -- ============================================================
    -- Pistols / sidearms -- light, short, minimal inertia
    -- ============================================================
    -- c["wpn_pm"]     = { c = 0.5, u = 0.35 }
    -- c["wpn_usp"]    = { c = 0.5, u = 0.35 }
    -- c["wpn_fort"]   = { c = 0.5, u = 0.35 }
    -- c["wpn_deagle"] = { c = 0.6, u = 0.4 }  -- heavier pistol, slight bump

    -- ============================================================
    -- SMGs / PDWs -- light but longer than a pistol
    -- ============================================================
    -- c["wpn_bizon"]    = { c = 0.7, u = 0.6 }
    -- c["wpn_vintorez"] = { c = 0.8, u = 0.7 } -- suppressed/longer SMG-class

    -- ============================================================
    -- Assault rifles -- baseline (1.0 = reference point the globals are tuned around)
