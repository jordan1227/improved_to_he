local default = { "000", "css", "001" }
local applied = nil

local function apply(sect)
	if not fl_tex_swap then return end
	local s = sleeve[sect] or default
	local key = s[1] .. "|" .. s[2] .. "|" .. s[3]
	if key == applied then return end
	local ok = false
	for _, t in ipairs(glove_tex) do
		if fl_tex_swap(t, "act\\act_arm_perchatka" .. s[1]) then ok = true end
	end
	for _, t in ipairs(arm_tex) do
		if fl_tex_swap(t, "act\\act_arm_" .. s[2]) then ok = true end
	end
	for _, t in ipairs(watch_tex) do
		if fl_tex_swap(t, "ui\\ui_chss" .. s[3]) then
			ok = true
		end
	end
	if ok then applied = key end
end

local function current_outfit()
	local a = db.actor
	if not a then return nil end
	local o = a:item_in_slot(6)
	if o then return o:section() end
	return nil
end

function refresh()
	applied = nil
	apply(current_outfit())
end

function on_game_loaded()
	applied = nil
	apply(current_outfit())
end

function on_item_to_slot()
	apply(current_outfit())
end

function on_item_to_ruck()
	apply(current_outfit())
end

function attach(sm)
	sm:subscribe({ signal = "on_game_loaded", fun = this.on_game_loaded })
	sm:subscribe({ signal = "on_item_to_slot", fun = this.on_item_to_slot })
	sm:subscribe({ signal = "on_item_to_ruck", fun = this.on_item_to_ruck })
end
