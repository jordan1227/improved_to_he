-- Публичная функция для UI и основного скрипта ui_inv_descr.script
function sivol.get_condition_rad_scale(condition)
    if     condition > 0.94 then return 1.00
    elseif condition > 0.89 then return 0.85
    elseif condition > 0.81 then return 0.65
    elseif condition > 0.73 then return 0.45
    elseif condition > 0.66 then return 0.25
    else                         return 0.10
    end
end

-- Вспомогательная функция очистки секции (убираем _q_, состояние и таймеры в конце). Паттерн -  exo_q_bandit_q_outfit37178/militaryspec_q_outfit31493 
function sivol.get_base_section(sect)
    if not sect then return "" end
    
    -- 1. Убираем таймеры/ID в конце (например, militaryspec_q_outfit31493 -> militaryspec_q_outfit)
    -- Используем %d%d%d+ чтобы отрезать только длинные числа (ID/таймеры), 
    -- но не сломать суффиксы вроде _m1 или _m2
    local base = string.gsub(sect, "%d%d%d+$", "")
    
    -- 2. Убираем суффиксы улучшений (_q_123) и состояния (_1_1)
    base = string.gsub(base, "_q_%d+$", "")
    base = string.gsub(base, "_%d+_%d+$", "")

    -- 3. ВСЕГДА убираем _q_ из названия (militaryspec_q_outfit -> militaryspec_outfit)
    -- Это нужно, чтобы движок и другие скрипты (vergas_masks) могли распознать броню
    base = string.gsub(base, "_q_", "_")
    
    return base
end

function sivol.round(num)
    return math.floor(num + 0.5)
end

-------------------------------------------------------------------------
-- 1. СИСТЕМА ВЛИЯНИЯ МАСОК НА ВЫНКУ + РАД ЗАЩИТУ. + ДРУГИЕ СТАТЫ 
-------------------------------------------------------------------------

local active_armor_id = nil
local active_armor_sect = nil
local active_mods = {} 
local active_base_vals = {} -- Новый кэш: запоминаем значения ДО изменения маской

-- Карта для перевода твоих ключей в реальные параметры движка
local stat_name_map = {
    weight_add = "additional_inventory_weight",
    weight2_add = "additional_inventory_weight2"
}

function sivol.apply_mask_effects()
    if effects_applied then return end
    
    local actor = db.actor
    local armor = actor and actor:item_in_slot(6)
    if not armor then return end

    local mask_type, armor_sect = vergas_masks.mask_definition()
    if not mask_type or mask_type == "?" then
        local base = sivol.get_base_section(armor_sect)
        mask_type = vergas_lib.set_pr_from_config_str("list_masks", base)
    end
    if not mask_type or mask_type == "?" then return end
    
    local base_sect = sivol.get_base_section(armor_sect)
    local mask_root = string.match(mask_type, "(hud_%a+)")
    
    local mod = sivol.mask_modifiers[base_sect] or sivol.mask_modifiers[mask_root] or sivol.mask_modifiers[mask_type]
    
    if mod then
        local outfit = armor:get_outfit()
        if not outfit then return end

        local cond = armor:condition()
        local rad_scale = sivol.get_condition_rad_scale(cond)
        
        active_mods = {}
        active_base_vals = {}
        
        for key, value in pairs(mod) do
            if key == "psy_k" then
                -- handled separately in sivol.get_mask_psy_k()
            elseif key == "pwr_mult" then
                local current_val = outfit["power_loss"]
                if current_val then
                    active_base_vals["power_loss"] = current_val
                    outfit["power_loss"] = current_val * value
                    active_mods["power_loss"] = true
                end
            elseif key == "rad_add" then
                local current_val = outfit["radiation_protection"]
                if current_val then
                    active_base_vals["radiation_protection"] = current_val
                    outfit["radiation_protection"] = current_val + (value * rad_scale)
                    active_mods["radiation_protection"] = true
                end
            elseif string.find(key, "_add$") then
                local stat_name = stat_name_map[key] or (string.gsub(key, "_add$", "_protection"))
                local current_val = outfit[stat_name]
                if current_val then
                    active_base_vals[stat_name] = current_val
                    local final_val = current_val + (value * (stat_name == "additional_inventory_weight" and 1 or rad_scale))
                    outfit[stat_name] = final_val
                    active_mods[stat_name] = true
                end
            end
        end
        
        active_armor_id = armor:id()
        active_armor_sect = armor_sect
        effects_applied = true
    end
end

function sivol.remove_mask_effects()
    if not effects_applied then return end
    
    if active_armor_id and active_armor_sect then
        local actor = db.actor
        local armor = actor and actor:item_in_slot(6)
        -- fall back to searching ruck if it's not currently equipped
        if not armor or armor:id() ~= active_armor_id then
            armor = alife():object(active_armor_id) and level.object_by_id(active_armor_id)
        end
        
        if armor then
            local outfit = armor:get_outfit()
            if outfit then
                for stat_name, _ in pairs(active_mods) do
                    local original_val = active_base_vals[stat_name]
                    if original_val then
                        outfit[stat_name] = original_val
                    end
                end
            end
        end
    end
    
    active_armor_id = nil
    active_armor_sect = nil
    active_mods = {}
    active_base_vals = {}
    effects_applied = false
end

-- Хуки в vergas_masks - init_mask, set_mask_on_off_flag, mask_update
--[[
function sivol.validate_mask_effects()
    local mask_on = vergas_masks.get_flag_mask()
    local armor = db.actor and db.actor:item_in_slot(6)
    
    if mask_on and armor then
        -- Если эффекты не применены, ИЛИ применены к другому костюму (например, сменился ID из-за окончания временного усиления)
        if not effects_applied or (active_armor_id and active_armor_id ~= armor:id()) then
            log1("~~~ [SIVOL DEBUG]: Validator caught missing/changed armor! Re-applying...")
            sivol.remove_mask_effects() -- Сбрасываем старые привязки
            sivol.apply_mask_effects()  -- Применяем к текущей броне
        end
    elseif (not mask_on or not armor) and effects_applied then
        log1("~~~ [SIVOL DEBUG]: Validator caught lingering effect! Removing...")
        sivol.remove_mask_effects()
    end
    schedule.add("sivol_validate", "sivol.validate_mask_effects()", 60000)
end
]]--

-- Функция для bind_monster.script (возвращает множитель пси-урона с учетом износа)
function sivol.get_mask_psy_k()
    if not vergas_masks.get_flag_mask() then return 1.0 end
    
    local actor = db.actor
    local armor = actor and actor:item_in_slot(6)
    if not armor then return 1.0 end

    local mask_type, armor_sect = vergas_masks.mask_definition()
    if not mask_type or mask_type == "?" then
        local base = sivol.get_base_section(armor_sect)
        mask_type = vergas_lib.set_pr_from_config_str("list_masks", base)
    end
    if not mask_type or mask_type == "?" then return 1.0 end
    
    local base_sect = sivol.get_base_section(armor_sect)
    local mask_root = string.match(mask_type, "(hud_%a+)")
    local mod = sivol.mask_modifiers[base_sect] or sivol.mask_modifiers[mask_root] or sivol.mask_modifiers[mask_type]
    
    -- Базовый множитель (если маска есть в списке, иначе дефолт 0.6)
    local base_psy_k = mod and mod.psy_k or 0.6
    
    -- Считаем износ
    local cond = armor:condition()
    local scale = sivol.get_condition_rad_scale(cond)
    
    -- Логика: защита — это (1.0 - множитель). Эту разницу мы и масштабируем.
    -- Пример: если psy_k = 0.6 (40% защиты), то при scale 0.5 защита станет 20% (множитель 0.8)
    local protection = 1.0 - base_psy_k
    local final_psy_k = 1.0 - (protection * scale)
    
    return final_psy_k
end

-------------------------------------------------------------------------
-- 2. КВЕСТОВЫЕ ФУНКЦИИ
-------------------------------------------------------------------------

-- Ресаем дробь Дену когда Артем Кулинар нас посылает по квесту Борова.
function give_mutant_parts_and_update_dan() 
    sak.create_items({ mutant_boar_leg = 6, mutant_dog_tail = 8 })
    local dan_story_id = story_ids.green_dan
    local dan_obj = alife():story_object(dan_story_id)
    if not dan_obj then return false end
    local data = {}
    if dan_obj.s_storage and dan_obj.s_storage ~= "" and dan_obj.s_storage ~= "_" then
        data = amk.parse_custom_data(dan_obj.s_storage)
    end
    data.trade_manager = { ["resuply_time"] = pack_time_to_string(game.get_game_time()) }
    dan_obj.s_storage = amk.gen_custom_data(data)
    local dan_lvl = level.object_by_id(dan_obj.id)
    if dan_lvl and trade_manager[dan_obj.id] then
        local tt = trade_manager[dan_obj.id]
        tt.resuply_time = game.get_game_time()
        tt.update_time = nil
        tt.skip_updates = 0
        trade_manager.update(dan_lvl)
    end
    timers.start_timer("dan_tip_delay", 60, "sivol.show_dan_tip()")
    return true
end

function show_dan_tip()
    sak.send_tip("Кулинар передал через меня - говорит, ты за делом придёшь. Ладно, раз Артём поручился, выделил тебе отдельную партию дроби. Приходи, обменяем как обычно.", "Дэн Охотник", 0, 10, "ui_npc_u_hunter_dan", "sak", "green")
end

-- Огнемёт Прапору можно принести и не полностью заряженный по квесту Сидоровича, но награда меньше.
function prapor_good_flame_have_give( flag )
    for i, k in pairs( sak_inventory.rucksack ) do
        if strpos( i, "wpn_flame", 1, true ) then
            local obj  = client_obj( k[ 1 ] )
            local ammo = obj:get_ammo_in_magazine()
            local max_ammo = system_ini():r_float( obj:section(), "ammo_mag_size" )
            if obj:condition() >= 0.95 and ammo >= max_ammo then
                if flag == true then
                    local sobj = g_sim:object( "gar_dolg_prapor" )
                    if sobj and client_obj( sobj.id ) then
                        db.actor:transfer_item( obj, client_obj( sobj.id ) )
                        sak.relocate_item( "out", "wpn_flame", 1 )
                    end
                else return true end
            end
        end
    end
    return false
end

function prapor_good_flame_have_not()
    return not prapor_good_flame_have_give( false )
end

function prapor_partial_flame_remove( first_speaker, second_speaker )
    for i, k in pairs( sak_inventory.rucksack ) do
        if strpos( i, "wpn_flame", 1, true ) then
            local obj = client_obj( k[ 1 ] )
            local npc = second_speaker
            if db.actor:id() == npc:id() then npc = first_speaker end
            db.actor:transfer_item( obj, npc )
            sak.relocate_item( "out", "wpn_flame", 1 )
            return
        end
    end
end

-------------------------------------------------------------------------
-- 3. ИНИЦИАЛИЗАЦИЯ
-------------------------------------------------------------------------

function sivol_masks.init_module()
    log1("~~~ [SIVOL DEBUG]: init_module() loaded")
    local sm = ogse_signals.get_mgr()
    
    sm:subscribe({
        signal = "on_item_to_slot",
        fun = function(obj, sobj)
			if not obj or not obj.slot then return end  -- guard added
            if obj:slot() == 6 then
                log1("~~~ [SIVOL DEBUG]: Signal caught -> on_item_to_slot")
                effects_applied = false
                if vergas_masks.get_flag_mask() then sivol.apply_mask_effects() end
            end
        end
    })
    
    sm:subscribe({
        signal = "on_item_to_ruck",
        fun = function(obj, sobj)
            if effects_applied then
                local armor = db.actor and db.actor:item_in_slot(6)
                if not armor or armor:id() == obj:id() then 
                    log1("~~~ [SIVOL DEBUG]: Signal caught -> on_item_to_ruck")
                    sivol.remove_mask_effects() 
                end
            end
        end
    })
    
    --sivol.validate_mask_effects()
end

function sivol_masks.on_game_load()
    if vergas_masks.get_flag_mask() then
        sivol.apply_mask_effects()
        schedule.add("sivol_load_check", "sivol.apply_mask_effects()", 2000)
    end
end

