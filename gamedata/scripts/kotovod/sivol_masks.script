sivol = sivol or {}
local effects_applied = false

-- Список доступных тегов, которые можно юзать:
-- burn_add — защита от огня
-- shock_add — защита от электричества
-- strike_add — защита от удара
-- wound_add — защита от разрыва
-- telepatic_add — пси-защита (влияет на полоску, в дополнение к psy_k)
-- chemical_burn_add — химзащита
-- explosion_add — защита от взрыва
-- fire_wound_add — пулестойкость
-- wound_2_protection_add — защита от разрыва 2
-- physic_strike_protection_add — физический удар
-- weight_add — доп. вес (уникален, не режется от износа маски)

