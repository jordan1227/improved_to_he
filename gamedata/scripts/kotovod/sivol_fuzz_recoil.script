-- [HE-PORT] Capability-gated Fuzz-style recoil prototype.
--
-- Scope of this first pass:
--   * replaces native camera recoil only after a live capability probe;
--   * derives the impulse from live CWeapon fields and reviewed profiles;
--   * keeps camera and HUD contributions separately reversible;
--   * restores native fields on item changes, saves, errors and shutdown.
--
-- Deliberately deferred: bloom, FOV changes, camera effectors, menu tuning,
-- runtime inertia changes, external balance patches and upgrade iteration.

sivol_fuzz_recoil = sivol_fuzz_recoil or {}

local M = sivol_fuzz_recoil

local ENABLED = true
local CAMERA_RECOIL_ENABLED = true
local HUD_RECOIL_ENABLED = true
-- Set true only while validating this port in game. Logging is intentionally
-- bounded to capability/prepare events, the first three shots per weapon, and
-- restoration failures.
local RECOIL_DIAGNOSTICS = false
local STAMINA_RECOIL_PENALTY = 0.35

local function recoil_log(fmt, ...)
    if RECOIL_DIAGNOSTICS then log2(fmt, ...) end
end

local DEG_TO_RAD = math.pi / 180.0
local PITCH_SIGN = -1.0
local PROBE_CAMERA_DELTA = 0.002 * DEG_TO_RAD
local CAMERA_EPSILON = 0.001 * DEG_TO_RAD
local WRITE_EPSILON = 0.000001

local DEFAULT_DT = 0.016
local MAX_DT = 0.25
local BURST_DECAY_RATE = 6.0
local HANDLING_RECOVERY_RATE = 1.65
local MOUSE_TRACK_MAX_DELTA = 0.35
local HUD_POSITION_PER_RAD = 0.008

-- These are the native recoil inputs that are temporarily neutralized. The
-- exact values are cached by item ID before the first write and restored as a
-- group on every exit path.
local NATIVE_RECOIL_FIELDS = {
    "cam_dispersion",
    "cam_dispersion_inc",
    "cam_dispertion_frac",
    "cam_max_angle",
    "cam_max_angle_horz",
    "cam_relax_speed",
    "cam_relax_speed_ai",
    "cam_step_angle_horz",
}

local native_cache = {}
local restore_failure_logged = {}

local state = {
    actor_id = nil,
    item_id = nil,
    item = nil,
    weapon = nil,
    profile = nil,
    probe_done = false,
    session_disabled = false,
    camera_enabled = false,
    hud_enabled = false,
    capability_state = "pending",
    save_transition = false,
    inventory_dirty = false,
    aim_dirty = false,
    applied_pitch = 0,
    applied_yaw = 0,
    recoil_pitch = 0,
    recoil_yaw = 0,
    burst = 0,
    fatigue = 0,
    handling = 0,
    last_shot_ms = nil,
    last_update_ms = nil,
    last_ammo = nil,
    shot_count = 0,
    last_base_pitch = nil,
    last_base_yaw = nil,
    measured_mouse_pitch = 0,
    measured_mouse_yaw = 0,
    hud_item = nil,
}

M.enabled = ENABLED
M.capability_state = state.capability_state
M.camera_enabled = false
M.hud_enabled = false
M.active_section = nil
M.active_class = nil
M.shot_callback_expected = nil
M.gl_probe_ok = nil
M.hud_capability = "pending"
M.last_error = nil
M.recoil_pitch = 0
M.recoil_yaw = 0
M.external_pitch = 0
M.external_yaw = 0

local function valid_number(value)
    local ok, number = pcall(function() return tonumber(value) end)
    return ok and number ~= nil and number == number and math.abs(number) < 100000
end

local function clamp(value, low, high)
    return math.max(low, math.min(high, value))
end

local function exp_step(current, target, rate, dt)
    if rate <= 0 or dt <= 0 then return current end
    local factor = 1.0 - math.exp(-rate * dt)
    return current + (target - current) * factor
end

local function object_id(object)
    if not object then return nil end
    local ok, id = pcall(object.id, object)
    if not ok then return nil end
    return id
end

local function current_actor()
    if not db then return nil end
    return db.actor
end

local function now_ms()
    if not time_global then return 0 end
    local ok, value = pcall(time_global)
    if not ok or not valid_number(value) then return 0 end
    return tonumber(value)
end

local function get_camera()
    if not actor_camera then return nil end
    local ok, camera = pcall(actor_camera, 0)
    if not ok then return nil end
    return camera
end

local function get_dt(delta)
    local dt = tonumber(delta)
    if not valid_number(dt) or dt <= 0 then
        local now = now_ms()
        if state.last_update_ms and now > state.last_update_ms then
            dt = (now - state.last_update_ms) / 1000.0
        else
            dt = DEFAULT_DT
        end
    elseif dt > 1.0 then
        dt = dt / 1000.0
    end
    if dt <= 0 or dt > MAX_DT then dt = DEFAULT_DT end
    return dt
end

local function publish_state()
    M.enabled = ENABLED and not state.session_disabled
    M.capability_state = state.capability_state
    M.camera_enabled = state.camera_enabled and not state.session_disabled
    M.hud_enabled = HUD_RECOIL_ENABLED and state.hud_enabled and not state.session_disabled
    M.active_section = state.profile and state.profile.section or nil
    M.active_class = state.profile and state.profile.class_name or nil
    M.recoil_pitch = state.recoil_pitch
    M.recoil_yaw = state.recoil_yaw
    M.external_pitch = state.measured_mouse_pitch
    M.external_yaw = state.measured_mouse_yaw
end

local function reset_dynamics(keep_applied)
    if not keep_applied then
        state.applied_pitch = 0
        state.applied_yaw = 0
    end
    state.recoil_pitch = 0
    state.recoil_yaw = 0
    state.burst = 0
    state.fatigue = 0
    state.handling = 0
    state.last_shot_ms = nil
    state.last_ammo = nil
    state.last_base_pitch = nil
    state.last_base_yaw = nil
    state.measured_mouse_pitch = 0
    state.measured_mouse_yaw = 0
    state.shot_count = 0
end

local function remove_camera_contribution()
    if state.applied_pitch == 0 and state.applied_yaw == 0 then return true end
    local camera = get_camera()
    if not camera then
        return false
    end

    local pitch = state.applied_pitch
    local yaw = state.applied_yaw
    local ok = pcall(function()
        camera.pitch = camera.pitch - pitch
        camera.yaw = camera.yaw - yaw
    end)
    state.applied_pitch = 0
    state.applied_yaw = 0
    return ok
end

local function read_native_value(weapon, field)
    local ok, value = pcall(function() return weapon[field] end)
    if not ok or not valid_number(value) then return nil end
    return tonumber(value)
end

local function same_number(left, right)
    return valid_number(left) and valid_number(right)
        and math.abs(tonumber(left) - tonumber(right)) <= WRITE_EPSILON
end

local function capture_native(item, weapon)
    local id = object_id(item)
    if not id then return nil, "weapon item ID unavailable" end

    local values = {}
    for _, field in ipairs(NATIVE_RECOIL_FIELDS) do
        local value = read_native_value(weapon, field)
        if value == nil then
            return nil, "native recoil field unavailable: " .. field
        end
        values[field] = value
    end
    return {
        id = id,
        item = item,
        weapon = weapon,
        values = values,
        zeroed = false,
    }
end

local function note_restore_failure(entry)
    if not RECOIL_DIAGNOSTICS or not entry then return end
    local key = tostring(entry.id)
    if restore_failure_logged[key] then return end
    restore_failure_logged[key] = true
    recoil_log("[sivol_fuzz_recoil][restore_failure] item_id=%s", key)
end

local function restore_entry(entry)
    if not entry or not entry.weapon then return false end
    local restored = true

    for _, field in ipairs(NATIVE_RECOIL_FIELDS) do
        local value = entry.values[field]
        local ok = pcall(function() entry.weapon[field] = value end)
        if not ok then restored = false end
    end

    for _, field in ipairs(NATIVE_RECOIL_FIELDS) do
        local value = read_native_value(entry.weapon, field)
        if not same_number(value, entry.values[field]) then restored = false end
    end
    if restored then
        entry.zeroed = false
        restore_failure_logged[tostring(entry.id)] = nil
    else
        note_restore_failure(entry)
    end
    return restored
end

local function probe_native_writes(entry)
    local writable = true
    for _, field in ipairs(NATIVE_RECOIL_FIELDS) do
        local value = entry.values[field]
        local ok_write = pcall(function() entry.weapon[field] = value end)
        if not ok_write then writable = false end
        local readback = read_native_value(entry.weapon, field)
        if not same_number(readback, value) then writable = false end
    end

    local restored = restore_entry(entry)
    if not writable then return false, "native recoil field write probe failed" end
    if not restored then return false, "native recoil restoration probe failed" end
    return true
end

local function zero_native(entry)
    local zeroed = true
    for _, field in ipairs(NATIVE_RECOIL_FIELDS) do
        local ok = pcall(function() entry.weapon[field] = 0 end)
        if not ok then zeroed = false end
        local readback = read_native_value(entry.weapon, field)
        if not same_number(readback, 0) then zeroed = false end
    end
    if not zeroed then
        restore_entry(entry)
        return false
    end
    entry.zeroed = true
    return true
end

local function restore_all_native()
    local restored = true
    for id, entry in pairs(native_cache) do
        if restore_entry(entry) then
            native_cache[id] = nil
        else
            restored = false
        end
    end
    return restored
end

local function hud_api_type()
    return type(fl_hud_recoil_set), type(fl_hud_recoil_clear)
end

local function write_hud_neutral(item)
    local set_type, clear_type = hud_api_type()
    if clear_type ~= "function" or set_type ~= "function" then
        local reason = "fl_hud_recoil_* is not registered by the engine hook"
        return false, set_type, clear_type, reason, reason
    end
    local ok, err = pcall(fl_hud_recoil_clear)
    local reason = ok and "none" or tostring(err)
    return ok, set_type, clear_type, reason, reason
end

local function restore_hud()
    if not state.hud_item then return true end
    local ok = write_hud_neutral(state.hud_item)
    state.hud_item = nil
    return ok
end

local function probe_hud(item)
    local ok, offset_type, rotate_type, offset_error, rotate_error = write_hud_neutral(item)
    local ok_hud_item, is_hud_item = pcall(function()
        if type(item.is_hud_item) ~= "function" then return "unavailable" end
        return item:is_hud_item()
    end)
    recoil_log(
        "[sivol_fuzz_recoil][hud_probe] section=%s is_hud_item=%s offset_type=%s rotate_type=%s offset_ok=%s rotate_ok=%s offset_error=%s rotate_error=%s",
        tostring(state.profile and state.profile.section or "unknown"),
        tostring(ok_hud_item and is_hud_item or "query_error"),
        tostring(offset_type), tostring(rotate_type),
        tostring(offset_error == "none"), tostring(rotate_error == "none"),
        tostring(offset_error), tostring(rotate_error)
    )
    if not ok then
        -- A setter failure blocks only the HUD layer. Camera recoil remains
        -- independently eligible, but every future HUD write is disabled.
        state.hud_enabled = false
        M.hud_capability = "blocked"
        return false
    end
    state.hud_enabled = true
    M.hud_capability = "ready"
    return true
end

local function write_hud_recoil(item, pitch, yaw)
    local class = state.profile and state.profile.class
    local pitch_scale = class and class.hud_pitch_scale or 0.45
    local yaw_scale = class and class.hud_yaw_scale or 0.34
    local position_y = pitch * HUD_POSITION_PER_RAD * (pitch_scale / 0.50)
    local rotate_x = pitch * pitch_scale
    local rotate_y = yaw * yaw_scale
    if type(fl_hud_recoil_set) ~= "function" then
        return false
    end
    local ok, applied = pcall(fl_hud_recoil_set, position_y, rotate_x, rotate_y)
    if not ok then
        write_hud_neutral(item)
        return false
    end
    state.hud_item = applied and item or nil
    return true
end

local function read_gl_mode(item)
    local ok_has_gl, has_gl = pcall(item.is_weapon_gl, item)
    if not ok_has_gl then return nil, "grenade-launcher capability probe failed" end
    if not has_gl then
        M.gl_probe_ok = true
        return false
    end
    if not ogse_wpn_utils or type(ogse_wpn_utils.get_gl_mode) ~= "function" then
        return nil, "grenade-launcher mode helper unavailable"
    end
    local ok_mode, mode = pcall(ogse_wpn_utils.get_gl_mode, item)
    if not ok_mode then return nil, "grenade-launcher mode probe failed" end
    M.gl_probe_ok = true
    return mode and true or false
end

local function probe_camera_writes()
    local camera = get_camera()
    if not camera then return false, "actor camera unavailable" end

    local ok_read, original_pitch, original_yaw = pcall(function()
        return camera.pitch, camera.yaw
    end)
    if not ok_read or not valid_number(original_pitch) or not valid_number(original_yaw) then
        return false, "actor camera angles unavailable"
    end

    local ok_write = pcall(function()
        camera.pitch = original_pitch + PROBE_CAMERA_DELTA
        camera.yaw = original_yaw + PROBE_CAMERA_DELTA
    end)
    local ok_restore = pcall(function()
        camera.pitch = original_pitch
        camera.yaw = original_yaw
    end)
    local ok_verify, restored_pitch, restored_yaw = pcall(function()
        return camera.pitch, camera.yaw
    end)

    if not ok_write or not ok_restore or not ok_verify then
        return false, "actor camera write probe failed"
    end
    if math.abs(restored_pitch - original_pitch) > CAMERA_EPSILON
        or math.abs(restored_yaw - original_yaw) > CAMERA_EPSILON then
        return false, "actor camera restoration probe failed"
    end
    return true
end

local function disable_session(reason)
    state.session_disabled = true
    state.capability_state = "disabled"
    M.last_error = tostring(reason or "unspecified recoil failure")
    state.camera_enabled = false
    state.hud_enabled = false
    local camera_removed = remove_camera_contribution()
    restore_hud()
    if not restore_all_native() then
        M.last_error = M.last_error .. "; native restoration still pending"
    end
    state.item_id = nil
    state.item = nil
    state.weapon = nil
    state.profile = nil
    -- Keep the contribution bookkeeping alive until a later cleanup can
    -- reach the camera again; clearing it here could leave a stuck offset.
    reset_dynamics(not camera_removed)
    publish_state()
end

local function probe_capabilities(item, weapon)
    local entry, capture_reason = capture_native(item, weapon)
    if not entry then return false, capture_reason end
    native_cache[entry.id] = entry

    local native_ok, native_reason = probe_native_writes(entry)
    if not native_ok then return false, native_reason end

    local camera_ok, camera_reason = probe_camera_writes()
    if not camera_ok then return false, camera_reason end

    local gl_mode, gl_reason = read_gl_mode(item)
    if gl_mode == nil then return false, gl_reason end

    state.camera_enabled = CAMERA_RECOIL_ENABLED
    state.hud_enabled = HUD_RECOIL_ENABLED and probe_hud(item)
    state.probe_done = true
    state.capability_state = state.hud_enabled and "ready" or "camera_only"
    M.probe_item_id = entry.id
    M.gl_mode_at_probe = gl_mode
    publish_state()
    return true
end

local function get_profile_adapter()
    return sivol_fuzz_recoil_profiles
end

local function resolve_suppressor_profile(item, profile)
    if not sivol_weapon or type(sivol_weapon.get_suppressor_recoil_k) ~= "function" then
        return nil, "suppressor recoil resolver unavailable"
    end

    local ok, recoil_k, mode, resolved_section = pcall(
        sivol_weapon.get_suppressor_recoil_k, item, profile.section)
    if not ok then
        return nil, "suppressor recoil resolution failed: " .. tostring(recoil_k)
    end
    if not valid_number(recoil_k) then
        return nil, "suppressor recoil coefficient unavailable: " .. tostring(mode)
    end

    return clamp(tonumber(recoil_k), 0, 2), mode or "base", resolved_section
end

local function prepare_active_item(item)
    if not item then return true end
    local profile_adapter = get_profile_adapter()
    if not profile_adapter or type(profile_adapter.resolve) ~= "function" then
        return false, "recoil profile adapter unavailable"
    end

    local ok_weapon, weapon = pcall(item.get_weapon, item)
    if not ok_weapon or not weapon then
        -- Non-firearm active items remain entirely vanilla.
        return true
    end

    local profile, profile_reason, profile_fatal = profile_adapter.resolve(item, weapon)
    if not profile then
        if profile_fatal then return false, profile_reason end
        -- Explicitly excluded or unreviewed items remain entirely vanilla.
        return true
    end

    state.weapon = weapon
    state.profile = profile

    if not state.probe_done then
        local probe_ok, probe_reason = probe_capabilities(item, weapon)
        recoil_log(
            "[sivol_fuzz_recoil][capability] section=%s state=%s camera=%s hud=%s reason=%s",
            tostring(profile.section), tostring(state.capability_state),
            tostring(state.camera_enabled), tostring(state.hud_enabled),
            tostring(probe_ok and "none" or probe_reason))
        if not probe_ok then return false, probe_reason end
    end

    local suppressor_k, suppressor_mode, suppressor_section =
        resolve_suppressor_profile(item, profile)
    if not suppressor_k then
        recoil_log(
            "[sivol_fuzz_recoil][prepare] section=%s class=%s state=failed reason=%s",
            tostring(profile.section), tostring(profile.class_name), tostring(suppressor_mode))
        return false, suppressor_mode
    end
    profile.suppressor_recoil_k = suppressor_k
    profile.suppressor_mode = suppressor_mode
    profile.suppressor_section = suppressor_section

    local raw = profile.live_raw
    local live = profile.live
    recoil_log(
        "[sivol_fuzz_recoil][prepare] section=%s class=%s cam_dispersion_rad=%.6f cam_dispersion_deg=%.4f cam_dispersion_inc_rad=%.6f cam_dispersion_inc_deg=%.4f cam_relax_rad=%.6f cam_relax_deg=%.4f cam_step_rad=%.6f cam_step_deg=%.4f recovery=%.4f fire_interval=%.6f suppressor_k=%.4f suppressor_mode=%s suppressor_section=%s",
        tostring(profile.section), tostring(profile.class_name),
        raw.cam_dispersion, live.cam_dispersion,
        raw.cam_dispersion_inc, live.cam_dispersion_inc,
        raw.cam_relax_speed, live.cam_relax_speed,
        raw.cam_step_angle_horz, live.cam_step_angle_horz,
        profile.recovery_rate, live.time_to_fire, suppressor_k,
        tostring(suppressor_mode), tostring(suppressor_section or "none"))

    local id = object_id(item)
    if not id then return false, "active firearm ID unavailable" end
    local entry = native_cache[id]
    if not entry then
        local capture_reason
        entry, capture_reason = capture_native(item, weapon)
        if not entry then return false, capture_reason end
        native_cache[id] = entry
    end

    if CAMERA_RECOIL_ENABLED then
        if not zero_native(entry) then
            return false, "native recoil neutralization failed"
        end
    end
    return true
end

local function clear_active_item(keep_applied)
    state.item_id = nil
    state.item = nil
    state.weapon = nil
    state.profile = nil
    state.inventory_dirty = false
    state.aim_dirty = false
    reset_dynamics(keep_applied)
    publish_state()
end

local function switch_active_item(item, item_id)
    if not restore_hud() then return false, "HUD restoration failed on item change" end
    if not restore_all_native() then return false, "native restoration failed on item change" end

    clear_active_item()
    state.item_id = item_id
    state.item = item
    if not item then
        publish_state()
        return true
    end

    local ok, reason = prepare_active_item(item)
    if not ok then return false, reason end
    publish_state()
    return true
end

local function get_aiming()
    if not wpn_params or type(wpn_params.get_zie_obj) ~= "function" then
        return false
    end
    local ok, effector = pcall(wpn_params.get_zie_obj)
    return ok and effector ~= nil
end

local function get_actor_power(actor)
    if not actor then return 1.0 end
    local ok, power = pcall(function() return actor.power end)
    if not ok or not valid_number(power) then return 1.0 end
    return clamp(tonumber(power), 0, 1)
end

local function get_ammo(item)
    if not item or type(item.get_ammo_in_magazine) ~= "function" then return nil end
    local ok, ammo = pcall(item.get_ammo_in_magazine, item)
    if not ok or not valid_number(ammo) then return nil end
    return tonumber(ammo)
end

local function sample_base_camera(camera)
    local ok, pitch, yaw = pcall(function()
        return camera.pitch, camera.yaw
    end)
    if not ok or not valid_number(pitch) or not valid_number(yaw) then
        return nil, nil
    end
    pitch = tonumber(pitch)
    yaw = tonumber(yaw)

    if state.last_base_pitch ~= nil and state.last_base_yaw ~= nil then
        local delta_pitch = pitch - state.last_base_pitch
        local delta_yaw = yaw - state.last_base_yaw
        if math.abs(delta_pitch) <= MOUSE_TRACK_MAX_DELTA then
            state.measured_mouse_pitch = delta_pitch
        else
            state.measured_mouse_pitch = 0
        end
        if math.abs(delta_yaw) <= MOUSE_TRACK_MAX_DELTA then
            state.measured_mouse_yaw = delta_yaw
        else
            state.measured_mouse_yaw = 0
        end
    else
        state.measured_mouse_pitch = 0
        state.measured_mouse_yaw = 0
    end

    state.last_base_pitch = pitch
    state.last_base_yaw = yaw
    return pitch, yaw
end

local function recover_recoil(dt)
    local profile = state.profile
    if not profile then return end
    local class = profile.class
    state.recoil_pitch = exp_step(state.recoil_pitch, 0, profile.recovery_rate, dt)
    state.recoil_yaw = exp_step(state.recoil_yaw, 0, profile.recovery_rate * 1.18, dt)
    state.burst = exp_step(state.burst, 0, BURST_DECAY_RATE, dt)
    state.handling = exp_step(state.handling, 0, HANDLING_RECOVERY_RATE, dt)
    state.fatigue = exp_step(state.fatigue, 0, class.fatigue_recovery, dt)

    if math.abs(state.recoil_pitch) < WRITE_EPSILON then state.recoil_pitch = 0 end
    if math.abs(state.recoil_yaw) < WRITE_EPSILON then state.recoil_yaw = 0 end
    if state.burst < WRITE_EPSILON then state.burst = 0 end
end

local function apply_camera_contribution(camera)
    local pitch = state.recoil_pitch
    local yaw = state.recoil_yaw
    if pitch == 0 and yaw == 0 then
        state.applied_pitch = 0
        state.applied_yaw = 0
        return true
    end

    local ok = pcall(function()
        camera.pitch = camera.pitch + pitch
        camera.yaw = camera.yaw + yaw
    end)
    if not ok then return false end
    state.applied_pitch = pitch
    state.applied_yaw = yaw
    return true
end

local function on_update_impl(delta)
    -- Always remove only our last contribution first. Any mouse movement or
    -- another camera writer that happened since the previous frame remains.
    if not remove_camera_contribution() then
        return false, "camera contribution removal failed"
    end

    local actor = current_actor()
    if not actor then
        if state.item_id or next(native_cache) ~= nil then
            restore_hud()
            if not restore_all_native() then return false, "native restoration failed without actor" end
            clear_active_item()
        end
        return true
    end

    local actor_id = object_id(actor)
    if not actor_id then return false, "actor ID unavailable" end
    if state.actor_id ~= actor_id then
        if state.item_id or next(native_cache) ~= nil then
            restore_hud()
            if not restore_all_native() then return false, "native restoration failed after actor change" end
            clear_active_item()
        end
        state.actor_id = actor_id
    end

    if state.session_disabled or not ENABLED then
        if next(native_cache) ~= nil then restore_all_native() end
        publish_state()
        return true
    end

    local ok_active, active_item = pcall(actor.active_item, actor)
    if not ok_active then return false, "active item query failed" end
    local active_id = object_id(active_item)

    if state.inventory_dirty or state.item_id ~= active_id then
        local switch_ok, switch_reason = switch_active_item(active_item, active_id)
        if not switch_ok then return false, switch_reason end
    end

    if not state.item or not state.profile then
        restore_hud()
        reset_dynamics()
        publish_state()
        return true
    end

    local gl_mode, gl_reason = read_gl_mode(state.item)
    if gl_mode == nil then return false, gl_reason end
    if gl_mode then
        restore_hud()
        reset_dynamics()
        publish_state()
        return true
    end

    local camera = get_camera()
    if not camera then return false, "actor camera disappeared" end
    local base_pitch, base_yaw = sample_base_camera(camera)
    if base_pitch == nil or base_yaw == nil then
        return false, "camera angle read failed" end

    local dt = get_dt(delta)
    recover_recoil(dt)

    local ammo = get_ammo(state.item)
    if ammo ~= nil then state.last_ammo = ammo end

    if CAMERA_RECOIL_ENABLED and not apply_camera_contribution(camera) then
        return false, "camera contribution write failed"
    end

    if HUD_RECOIL_ENABLED and state.hud_enabled then
        if not write_hud_recoil(state.item, state.recoil_pitch, state.recoil_yaw) then
            state.hud_enabled = false
            M.hud_capability = "blocked"
            state.capability_state = "camera_only"
        end
    end

    state.last_update_ms = now_ms()
    publish_state()
    return true
end

local function on_update(delta)
    local ok, result, reason = pcall(on_update_impl, delta)
    if not ok then
        disable_session("recoil update exception: " .. tostring(result))
    elseif not result then
        disable_session(reason)
    end
end

local function add_shot_impulse()
    local profile = state.profile
    if not profile then return end

    local class = profile.class
    local live = profile.live
    local now = now_ms()
    local gap = nil
    if state.last_shot_ms and now >= state.last_shot_ms then
        gap = (now - state.last_shot_ms) / 1000.0
    end
    if gap == nil or gap > 0.55 then state.burst = 0 end
    state.burst = clamp(state.burst * math.exp(-(gap or 0.0) * BURST_DECAY_RATE) + 1.0, 1.0, class.max_burst)
    state.last_shot_ms = now
    state.shot_count = state.shot_count + 1

    local burst_index = clamp(state.burst - 1.0, 0, math.max(0, class.max_burst - 1.0))
    local vertical_deg = math.max(0, live.cam_dispersion) * class.dispersion_scale
        + math.max(0, live.cam_dispersion_inc) * class.dispersion_increment_scale * burst_index
    vertical_deg = vertical_deg * profile.magazine_factor
    vertical_deg = vertical_deg * (1.0 + class.burst_scale * burst_index * profile.fire_rate_factor)

    local horizontal_deg = math.max(
        math.max(0, live.cam_step_angle_horz) * class.horizontal_step_scale,
        math.max(0, live.cam_dispersion) * class.horizontal_dispersion_scale
    )
    horizontal_deg = horizontal_deg * (1.0 + class.burst_scale * burst_index * 0.35)

    local aiming = get_aiming()
    local aim_multiplier = aiming and class.ads_multiplier or class.hip_multiplier
    local actor_power = get_actor_power(current_actor())
    -- Exhaustion worsens control; full stamina remains neutral at 1.0.
    local actor_multiplier = 1.0 + (1.0 - actor_power) * STAMINA_RECOIL_PENALTY
    local handling_multiplier = 1.0 - class.handling_strength * state.handling
    handling_multiplier = clamp(handling_multiplier, 0.52, 1.0)
    local fatigue_multiplier = 1.0 + state.fatigue * 0.42
    local total_multiplier = aim_multiplier * actor_multiplier
        * handling_multiplier * fatigue_multiplier

    vertical_deg = math.min(vertical_deg * total_multiplier, class.max_pitch_deg)
    horizontal_deg = math.min(horizontal_deg * total_multiplier, class.max_yaw_deg)

    local pattern = ((state.shot_count * 37) % 19) / 100.0
    local horizontal_sign = (state.shot_count % 2 == 0) and 1.0 or -1.0
    local suppressor_recoil_k = profile.suppressor_recoil_k or 1.0
    local pitch_deg = PITCH_SIGN * vertical_deg * suppressor_recoil_k
    local yaw_deg = horizontal_sign * horizontal_deg * (0.88 + pattern) * suppressor_recoil_k
    local pitch_impulse = pitch_deg * DEG_TO_RAD
    local yaw_impulse = yaw_deg * DEG_TO_RAD

    if state.shot_count <= 3 then
        recoil_log(
            "[sivol_fuzz_recoil][shot] section=%s shot=%d impulse_pitch_rad=%.6f impulse_yaw_rad=%.6f pitch_deg=%.4f yaw_deg=%.4f ads=%s burst=%.2f stamina=%.3f suppressor_k=%.4f",
            tostring(profile.section), state.shot_count, pitch_impulse, yaw_impulse,
            pitch_deg, yaw_deg, tostring(aiming), state.burst, actor_power,
            suppressor_recoil_k)
    end

    state.recoil_pitch = clamp(
        state.recoil_pitch + pitch_impulse,
        -class.max_pitch_deg * DEG_TO_RAD,
        class.max_pitch_deg * DEG_TO_RAD
    )
    state.recoil_yaw = clamp(
        state.recoil_yaw + yaw_impulse,
        -class.max_yaw_deg * DEG_TO_RAD,
        class.max_yaw_deg * DEG_TO_RAD
    )

    state.handling = clamp(
        state.handling + class.handling_rise * (1.0 - state.handling),
        0,
        1
    )
    state.fatigue = clamp(
        state.fatigue + class.fatigue_per_shot * (0.82 + state.burst * 0.06)
            * (1.0 + (1.0 - actor_power) * 0.45),
        0,
        1
    )
    M.aiming = aiming
end

local function on_actor_weapon_fire_impl(callback_item)
    if state.session_disabled or not state.profile or not state.item then return true end
    local callback_id = object_id(callback_item)
    if not callback_id or callback_id ~= state.item_id then return true end

    local ok_weapon, callback_weapon = pcall(callback_item.get_weapon, callback_item)
    local expected = ok_weapon and callback_weapon ~= nil
    M.shot_callback_expected = expected
    if not expected then return false, "weapon-fire callback object probe failed" end

    local gl_mode, gl_reason = read_gl_mode(state.item)
    if gl_mode == nil then return false, gl_reason end
    if gl_mode then
        reset_dynamics()
        return true
    end

    local ok_misfire, misfire = pcall(callback_weapon.misfire_status, callback_weapon)
    if not ok_misfire then return false, "misfire status probe failed" end
    if misfire then return true end

    local ammo = get_ammo(state.item)
    if ammo ~= nil and ammo <= 0 and (state.last_ammo == nil or state.last_ammo <= 0) then
        return true
    end

    add_shot_impulse()
    return true
end

local function on_actor_weapon_fire(callback_item)
    local ok, result, reason = pcall(on_actor_weapon_fire_impl, callback_item)
    if not ok then
        disable_session("weapon-fire callback exception: " .. tostring(result))
    elseif not result then
        disable_session(reason)
    end
end

local function on_item_to_slot()
    state.inventory_dirty = true
end

local function on_item_to_ruck()
    state.inventory_dirty = true
end

local function on_zoom_in()
    state.aim_dirty = true
end

local function on_zoom_out()
    state.aim_dirty = true
end

local function cleanup_boundary()
    local camera_removed = remove_camera_contribution()
    local ok = camera_removed
    if not restore_hud() then ok = false end
    if not restore_all_native() then ok = false end
    clear_active_item(not camera_removed)
    return ok
end

local function on_first_update_impl()
    local clean = cleanup_boundary()
    state.actor_id = nil
    state.probe_done = false
    state.session_disabled = not clean
    state.camera_enabled = false
    state.hud_enabled = false
    state.capability_state = clean and "pending" or "disabled"
    state.save_transition = false
    M.last_error = clean and nil or "initial restoration failed"
    M.shot_callback_expected = nil
    M.gl_probe_ok = nil
    M.hud_capability = "pending"
    publish_state()
end

local function on_first_update()
    local ok, reason = pcall(on_first_update_impl)
    if not ok then disable_session("first-update exception: " .. tostring(reason)) end
end

local function on_before_save_game()
    local ok, clean, reason = pcall(cleanup_boundary)
    if not ok then
        disable_session("save-boundary exception: " .. tostring(clean))
        return
    end
    if not clean then
        disable_session("save-boundary restoration failed")
        return
    end
    state.save_transition = true
    publish_state()
end

local function on_stop_modules()
    local ok, clean, reason = pcall(cleanup_boundary)
    if not ok then
        clean = false
        M.last_error = "shutdown exception: " .. tostring(reason)
    end
    state.session_disabled = true
    state.capability_state = clean and "stopped" or "disabled"
    if not clean then M.last_error = "shutdown restoration failed" end
    publish_state()
end

function attach(sm)
    sm:subscribe({signal = "on_first_update", fun = on_first_update})
    sm:subscribe({signal = "on_update", fun = on_update})
    sm:subscribe({signal = "on_actor_weapon_fire", fun = on_actor_weapon_fire})
    sm:subscribe({signal = "on_item_to_slot", fun = on_item_to_slot})
    sm:subscribe({signal = "on_item_to_ruck", fun = on_item_to_ruck})
    sm:subscribe({signal = "on_actor_weapon_zoom_in", fun = on_zoom_in})
    sm:subscribe({signal = "on_actor_weapon_zoom_out", fun = on_zoom_out})
    sm:subscribe({signal = "on_before_save_game", fun = on_before_save_game})
    sm:subscribe({signal = "on_stop_modules", fun = on_stop_modules})
end

M.attach = attach
