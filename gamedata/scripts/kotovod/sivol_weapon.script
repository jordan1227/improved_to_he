local function get_weapon_class(sec)
    local c = weapon_class_table[sec]
    if c then return c end
    -- Pattern fallback for unlisted variants
    if string.find(sec, "wpn_rpk") or string.find(sec, "wpn_pkm") then return "lmg"     end
    if string.find(sec, "wpn_svd") or string.find(sec, "wpn_awm") or
       string.find(sec, "wpn_svu") or string.find(sec, "wpn_sv98") then return "sniper"  end
    if string.find(sec, "wpn_pm")  or string.find(sec, "wpn_pb")  then return "pistol"  end
    if string.find(sec, "wpn_mp5") or string.find(sec, "wpn_bizon") or
       string.find(sec, "wpn_pp19") then return "smg" end
    if string.find(sec, "wpn_saiga") or string.find(sec, "wpn_mp153") or 
       string.find(sec, "wpn_toz") then return "shotgun" end
	   
    return "rifle"
end

function sivol_weapon.get_mastery_k(sec)
    local days = timers.Get_Game_Days()
    local m    = mastery_classes[ get_weapon_class(sec) ]
    if days < 7 then
        -- Debuff phase: linear from debuff peak down to 1.0 by day 7
        local t = days / 7
		local t_curved = math.sqrt(t) --  Калеченому жоска первые два дня. 
        return m.debuff + (1.0 - m.debuff) * t_curved
    elseif days < m.plateau_day then
        -- Improvement phase: linear from 1.0 down to cap
        local t = (days - 7) / (m.plateau_day - 7)
        return 1.0 + (m.cap - 1.0) * t
    else
        return m.cap
    end
end


--  Абилке псевдычей гладкую камеру. Эта камера теперь также используется у некоторых других мутиков, типа контриков - смотреть в bind_monster.script. 
local psy_divert = {
    active     = false,
    delta_h    = 0, delta_p = 0,     -- h = yaw (left/right), p = pitch (up/down)
    applied_h  = 0, applied_p = 0,
    duration   = 120,
    start_time = 0,
}

function sivol_weapon.start_psy_divert(dh, dp, dur)
    psy_divert.active     = true
    psy_divert.delta_h    = dh
    psy_divert.delta_p    = dp
    psy_divert.applied_h  = 0
    psy_divert.applied_p  = 0
    psy_divert.duration   = dur or 120
    psy_divert.start_time = time_global()
end

function run_psy_divert()
    ogse_signals.get_mgr():reschedule(16)
    if not psy_divert.active then return end
	
    local elapsed = time_global() - psy_divert.start_time
    local t       = math.min(1.0, elapsed / psy_divert.duration)
    
    -- Easing function: "Out Quad". Starts violent, then slows down.
    local ease_t  = t * (2 - t) 

    local target_h = psy_divert.delta_h * ease_t
    local target_p = psy_divert.delta_p * ease_t

    local step_h = target_h - psy_divert.applied_h
    local step_p = target_p - psy_divert.applied_p

    psy_divert.applied_h = target_h
    psy_divert.applied_p = target_p

    -- Apply directly to the base actor rotation, bypassing effector feedback completely!
    if coord_params and coord_params.camera_angles then
        local h, p = coord_params.camera_angles()
        coord_params.camera_angles(h + step_h, p + step_p)
    end

    if t >= 1.0 then 
        psy_divert.active = false 
    end
end

--  Плавная камера для пояса аккумулятора: вниз-пауза-назад. Мб куда-нить еще использовать?
local belt_divert = {
    active       = false,
    phase        = "out",
    delta_h      = 0, delta_p = 0,
    applied_h    = 0, applied_p = 0,
    out_time     = 220,
    hold_time    = 0,
    back_time    = 220,
    start_time   = 0,   -- phase-local
    total_start  = 0,   -- whole-sequence, for wobble continuity
    on_complete  = nil,

    wobble_amp_h   = 0,
    wobble_amp_p   = 0,
	wobble_freq_h  = 0.53,
	wobble_freq_p  = 0.71,
    wobble_phase_h = 0,
    wobble_phase_p = 0,
}

local function ease_in_out( t )
    -- smoothstep: zero velocity at t=0 AND t=1, so out->hold->back
    -- handoffs never snap
    return t * t * ( 3 - 2 * t )
end

function sivol_weapon.start_belt_divert( dh, dp, out_time, hold_time, back_time, wobble_h, wobble_p, on_complete )
    belt_divert.active         = true
    belt_divert.phase          = "out"
    belt_divert.delta_h        = dh
    belt_divert.delta_p        = dp
    belt_divert.applied_h      = 0
    belt_divert.applied_p      = 0
    belt_divert.out_time       = out_time  or 220
    belt_divert.hold_time      = hold_time or 0
    belt_divert.back_time      = back_time or 220
    belt_divert.start_time     = time_global()
    belt_divert.total_start    = time_global()
    belt_divert.on_complete    = on_complete
    belt_divert.wobble_amp_h   = wobble_h or 0
    belt_divert.wobble_amp_p   = wobble_p or 0
    belt_divert.wobble_phase_h = math.random() * 6.28
    belt_divert.wobble_phase_p = math.random() * 6.28
end

function run_belt_divert()
    ogse_signals.get_mgr():reschedule(16)
    if not belt_divert.active then return end
    local elapsed = time_global() - belt_divert.start_time
    local envelope, target_h, target_p

    if belt_divert.phase == "out" then
        local t = math.min( 1.0, elapsed / belt_divert.out_time )
        envelope = ease_in_out( t )
        target_h = belt_divert.delta_h * envelope
        target_p = belt_divert.delta_p * envelope
        if t >= 1.0 then
            belt_divert.phase      = "hold"
            belt_divert.start_time = time_global()
        end

    elseif belt_divert.phase == "hold" then
        envelope = 1.0
        target_h = belt_divert.delta_h
        target_p = belt_divert.delta_p
        if elapsed >= belt_divert.hold_time then
            belt_divert.phase      = "back"
            belt_divert.start_time = time_global()
        end

    elseif belt_divert.phase == "back" then
        local t = math.min( 1.0, elapsed / belt_divert.back_time )
        envelope = ease_in_out( 1 - t )
        target_h = belt_divert.delta_h * envelope
        target_p = belt_divert.delta_p * envelope
        if t >= 1.0 then
            belt_divert.active = false
        end
    end

    -- layered bobbing, scaled by the same envelope as the main motion
    if belt_divert.wobble_amp_h ~= 0 or belt_divert.wobble_amp_p ~= 0 then
        local te = ( time_global() - belt_divert.total_start ) / 1000
        target_h = target_h + belt_divert.wobble_amp_h * envelope
            * math.sin( te * belt_divert.wobble_freq_h * 6.28 + belt_divert.wobble_phase_h )
        target_p = target_p + belt_divert.wobble_amp_p * envelope
            * math.sin( te * belt_divert.wobble_freq_p * 6.28 + belt_divert.wobble_phase_p )
    end

    local step_h = target_h - belt_divert.applied_h
    local step_p = target_p - belt_divert.applied_p
    belt_divert.applied_h = target_h
    belt_divert.applied_p = target_p

    if coord_params and coord_params.camera_angles then
        local h, p = coord_params.camera_angles()
        coord_params.camera_angles( h + step_h, p + step_p )
    end

    if not belt_divert.active and belt_divert.on_complete then
        local cb = belt_divert.on_complete
        belt_divert.on_complete = nil
        cb()
    end
end

--[[
-- in sivol_weapon.script:
function sivol_weapon.on_actor_weapon_fire( obj )
    wprintf( "[~T]. #DBG sivol_weapon: on_actor_weapon_fire obj=%s", tostring(obj) )
    if obj and obj.section then
        wprintf( "[~T]. #DBG sivol_weapon: section=%s id=%s cond=%.4f",
            tostring(obj:section()), tostring(obj:id()), obj:condition() or -1 )
    end
end
--]]

-- Оружие с глушителем тратит больше прочности на выстрел. В 
local cached_wpn_id      = nil
local cached_addon_flags = nil
local cached_wear_extra  = 0

local function refresh_weapon_wear_cache( obj )
    local wpn_id = obj:id()
    local sobj = alife():object( wpn_id )
    if not sobj then
        cached_wpn_id = nil
        cached_wear_extra = 0
        return
    end

    local pk = get_netpk( sobj )
    if not pk then
        cached_wpn_id = nil
        cached_wear_extra = 0
        return
    end

    local addon_flags = pk:get().addon_flags or 0

    -- cache still valid: same weapon, same addon state, nothing to recompute
    if wpn_id == cached_wpn_id and addon_flags == cached_addon_flags then
        return
    end

    cached_wpn_id      = wpn_id
    cached_addon_flags = addon_flags

    local sil_on = math.floor( addon_flags / 4 ) % 2 == 1
    if sil_on then
        local sect      = obj:section()
        local sil_name  = get_string( sect, "silencer_name", nil )
        local wear_k    = sil_name and get_float( sil_name, "condition_shot_dec_k", 1 ) or 1
        local base_dec  = sys_ini:r_float( sect, "condition_shot_dec" ) or 0
        cached_wear_extra = base_dec * ( wear_k - 1 )
    else
        cached_wear_extra = 0
    end
end

function sivol_weapon.on_actor_weapon_fire( obj )
    if not ( obj and obj.section ) then return end

    refresh_weapon_wear_cache( obj )

    if cached_wear_extra and cached_wear_extra > 0 then
        local cur = obj:condition()
        obj:set_condition( math.max( 0, cur - cached_wear_extra ) )
    end
end

function sivol_weapon.late_init()
    if wpn_params and wpn_params.late_init then
        wpn_params.late_init()
    end
    wpn_params.mastery_k = 1.0
    
    -- CLAUDE'S OPTIMIZATION: Initialize outside the frame loop to prevent redundant table writes
    wpn_params.last_stance    = nil
    wpn_params.stance_bump_y  = 0
end
