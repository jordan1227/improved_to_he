-- Влияние артефактов на раскачку при прицеливании.
-- Отрицательные значения = стабилизация. Положительные = дестабилизация. Грузовым артам ухудшить? Семье медузы улучшить? 
local artifact_wobble_table = {
    -- === Tierless Artifacts ===
    -- Works perfectly: matches exactly, skips tier math entirely.
    af_eye                  = 1.6, 

    -- === Generic Tiered Fallback ===
    -- All tiers (1d-5d) will scale automatically off this base value.
    -- Tier 5 gives -0.12, Tier 3 gives 0.0, Tier 1 gives +0.12
    af_gravi                    = -0.1, 

    -- === Specific Tier Override ===
    -- If you want Tier 4 Gravi to have an unconventional, manually tuned value:
    -- Stage 1 finds this exact string first, skipping the generic math entirely.
    af_gravi_dyn4d              = -0.3, 
}

local cached_artifact_k = 1.0
local last_artifact_check = 0
local ARTIFACT_CHECK_INTERVAL = 2000  -- check every 2sec 

local function update_artifact_wobble_k()
    local now = time_global()
    if now - last_artifact_check < ARTIFACT_CHECK_INTERVAL then return end
    last_artifact_check = now

    -- NEW: NLC 7 Battery System check. 
    -- If the electronic belt is dead, uncharged, or off, artifacts provide zero properties.
    if not (sak and sak.arts_operate) then
        cached_artifact_k = 1.0
        return
    end

    local total_mod = 0.0

    if sak_inventory and sak_inventory.belt_items then
        for sec, items in pairs( sak_inventory.belt_items ) do
            
            -- STAGE 1: Exact Match Check
            local mod = artifact_wobble_table[sec]
            
            -- STAGE 2: Generic Suffix Stripping & NLC Dynamic Scaling
            if not mod then
                local base_sec = string.match(sec, "^(af_[%w_]+)_dyn%dd") or sec
                mod = artifact_wobble_table[base_sec]
                
                if mod then
                    local tier_str = string.match(sec, "_dyn(%d)d")
                    if tier_str then
                        local tier = tonumber(tier_str) or 3
                        local tier_scale = 0
                        
                        if tier == 6 then
                            tier_scale = 0.0  
                        else
                            -- Tier 5 = 1.0 | Tier 3 = 0.0 | Tier 1 = -1.0
                            tier_scale = (tier - 3) / 2
                        end
                        mod = mod * tier_scale
                    end
                end
            end
            
            -- STAGE 3: Condition and Quantity Weighting
            local num_items = items and table.getn(items) or 0
            if mod and num_items > 0 then
                for m = 1, num_items do
                    local af_id  = items[m]
                    local af_obj = client_obj and client_obj(af_id)
                    local cond   = af_obj and af_obj:condition() or 1.0
                    
                    total_mod = total_mod + (mod * cond)
                end
            end
        end
    end

    -- FIXED: Widened constraints for extreme testing thresholds
    -- -0.75 means a high-tier stabilizing setup can cut weapon sway by up to 75%
    -- 2.50 means a chaotic setup can increase sway penalties by up to 250%
    total_mod = math.max(-0.75, math.min(1.60, total_mod))
    cached_artifact_k = 1.0 + total_mod
end

function sivol_weapon.get_artifact_wobble_k()
    return cached_artifact_k
end

-- Returns the baseline sway multiplier for the weapon
function sivol_weapon.get_base_wobble(sec)
    local base_val = wobble_wpn[sec] or 2.0
    
    -- === GLOBAL WEAPON SWAY MULTIPLIER ===
    -- Change this single number to affect EVERY weapon in the game at once:
    -- 1.25 = 25% MORE sway everywhere (harder aiming)
    -- 0.80 = 20% LESS sway everywhere (easier aiming)
    local global_factor = 0.75
    
    return base_val * global_factor
end

-- Returns how severely low stamina affects the weapon's sway
-- Ordered from most specific (variants) to least specific (base models)
function sivol_weapon.get_weight_sens(sec)
    local v = weight_sens_table[sec]
    if v then return v end
    -- Fallback pattern matching for anything not explicitly listed
    if string.find(sec, "wpn_rpk")  then return 1.2  end
    if string.find(sec, "wpn_svd")  then return 0.85 end
    if string.find(sec, "wpn_awm")  then return 0.88 end
    if string.find(sec, "wpn_pm")   then return 0.2  end
    return 0.5  -- standard rifle baseline
end


-- С присядом  прицеливание меньше вынки потребляет
function update_ads_fatigue()
    ogse_signals.get_mgr():reschedule(100)
    local actor = db.actor
    if not actor then return end

    update_breath_debt()
    update_artifact_wobble_k()


    if wpn_params and (wpn_params.zoom_time or 1) > 1.05 then
        local wpn = actor:active_item()
        local sec = wpn and wpn:section()
        if not (sec and sivol_weapon.is_stamina_exempt(sec)) then
            local weight_sens = wpn_params.current_weight_sens or 0.5

            -- OGSR: is_actor_crouch()/is_actor_creep() instead of get_crouch_factor()
            local aobj = get_actor_obj()
            local stance_drain_k = 1.0
            if aobj and aobj:is_actor_creep() then
                stance_drain_k = 0.75
            elseif aobj and aobj:is_actor_crouch() then
                stance_drain_k = 0.87
            end

            local drain_amount = 0.00675 * weight_sens * stance_drain_k
            actor.power = -drain_amount
        end
    end
end

