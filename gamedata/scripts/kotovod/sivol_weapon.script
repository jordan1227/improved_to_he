-- sivol_weapon.script
-- Handles weapon-related stamina drain, breath memory, and fatigue loops.
-- Покачивание оружия и оптики при прицеливании стало более плавным и естественным. Убрана повторяющаяся «шаблонность» движения прицела. Усилена вертикальная составляющая, эффект дыхания стал заметнее.
-- Переработан базовый баланс покачивания и выносливости при прицеливании:
-- Лёгкое оружие имеет более выраженное базовое покачивание, но меньше зависит от усталости и медленнее расходует выносливость
-- Тяжёлое и длинноствольное оружие стабильнее в начале, но быстрее утомляет и сильнее теряет точность при падении выносливости
-- В положении сидя покачивание и расход выносливости снижен
-- Добавлена система привыкания к оружию (мастерство), оружие со временем становится стабильнее:
-- пистолеты и лёгкое оружие осваиваются быстрее. Тяжёлое и специализированное — медленнее. 
-- первую пару дней Калеченного кошмарит. На 3-ий день лучше. Через неделю еще лучше. Полный эффект достигается через несколько недель и дальше не растёт
-- Задержка дыхания теперь сильнее зависит от выносливости персонажа.
-- Добавлена накопительная усталость при прицеливании:
-- быстрое повторное вскидывание оружия больше не сбрасывает эффект полностью — часть усталости переносится между попытками.
-- Устранены ошибки и неточности в настройках покачивания. 
-- Влияние артефактов на раскачку

function attach(sm)
    sm:subscribe({signal = "on_update", fun = update_ads_fatigue})
    sm:subscribe({signal = "on_update", fun = run_psy_divert})
    sm:subscribe({signal = "on_update", fun = run_belt_divert})
end

sivol_weapon.attach = attach

sivol_weapon = sivol_weapon or {}
wprintf("[~T]. #DBG sivol_weapon: SCRIPT FILE LOADED. РАСКАЧКА ЗАГРУЖЕНА")  
local update_interval = 100 -- Run every 100ms
local last_update = 0
-- local min_stamina_floor = 0.70 -- 70% stamina floor so aiming doesn't cripple movement. -- I walk back on that idea. 

local breath_debt      = 0
local ads_drop_time    = 0
local was_aiming       = false
local DEBT_DECAY_RATE  = 0.5  -- debt recovers at half the rate it accrues
local session_start_time = 0

local function update_breath_debt()
    if not wpn_params then return end
    local is_aiming = wpn_params.zoom_time > 1.05

    local actor = db.actor
    local wpn = actor and actor:active_item()
    local sec = wpn and wpn:section()
    if sec and sivol_weapon.is_stamina_exempt(sec) then
        return -- binoculars etc: skip debt accrual/decay entirely
    end

    if was_aiming and not is_aiming then
        local session_used = timers.Get_Game_Seconds() - session_start_time
        breath_debt = breath_debt + math.max(0, session_used)
        ads_drop_time = timers.Get_Game_Seconds()
        was_aiming = false
    elseif not was_aiming and is_aiming then
        local time_resting = timers.Get_Game_Seconds() - ads_drop_time
        breath_debt = math.max(0, breath_debt - time_resting * DEBT_DECAY_RATE)
        session_start_time = timers.Get_Game_Seconds()
        was_aiming = true
    end
end

function sivol_weapon.get_breath_debt()
    if breath_debt <= 0 then return 0 end
    if ads_drop_time <= 0 then return breath_debt end
    local now = timers.Get_Game_Seconds()  -- FIX: was time_global(), unit mismatch
    local time_resting = now - ads_drop_time
    return math.max(0, breath_debt - time_resting * DEBT_DECAY_RATE)
end

function sivol_weapon.clear_breath_debt()
    breath_debt        = 0
    ads_drop_time      = 0
    session_start_time = 0
end

-- Мастерство оружия. Меченный становится крепче, раскачка с днями меньше. Первые 2-3 дня плохо. 
-- Each class defines:
-- debuff: wobble multiplier on day 0 (>1.0 = worse)
-- cap:    wobble multiplier at full mastery (<1.0 = improvement ceiling)
-- plateau_day: day full mastery is reached
local mastery_classes = {
    pistol  = { debuff = 1.15, cap = 0.75, plateau_day = 28 },  -- Reduced from 1.25 to prevent Day 0 whiplash
    shotgun = { debuff = 1.25, cap = 0.85, plateau_day = 28 },  -- NEW: Fast plateau, modest cap
    smg     = { debuff = 1.30, cap = 0.80, plateau_day = 35 },
    rifle   = { debuff = 1.40, cap = 0.85, plateau_day = 42 },
    sniper  = { debuff = 1.40, cap = 0.92, plateau_day = 56 },  -- Reduced debuff slightly, raised cap from 0.88
    lmg     = { debuff = 1.45, cap = 0.94, plateau_day = 56 },  -- Reduced debuff slightly, raised cap from 0.90
    special = { debuff = 1.40, cap = 0.92, plateau_day = 49 },
}

-- Оружие, полностью исключённое из выносливости/дыхания при прицеливании. Убираем чтобы Калеченный не пыжился когда смотрел в бинокль.
-- Раскачка (wobble_wpn) при этом всё равно работает как обычно.
local no_stamina_no_breath = {
    [ "wpn_binoc" ] = true,
}

function sivol_weapon.is_stamina_exempt(sec)
    return no_stamina_no_breath[sec] == true
end

