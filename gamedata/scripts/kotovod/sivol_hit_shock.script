-- sivol_hit_shock.script (new file)
local last_hit_roll_time = 0

local function on_actor_before_hit(obj, hit_data, binder)
    if not hit_data or hit_data.hit_type ~= hit.shock then return end
    if not sivol_critical_malfunction then return end
    if sivol_critical_malfunction.is_active() then return end  -- already in a full blackout, don't pile on

    local cfg = sivol_emp_config.SHOCK_HIT_MALFUNCTION
    local now = time_global()
    if now - last_hit_roll_time < cfg.min_cooldown then return end

    local power = hit_data.power or 0
    if power < cfg.min_power then return end
    last_hit_roll_time = now

    local severity = math.min(1, (power - cfg.min_power) / (cfg.max_power - cfg.min_power))
    local chance = cfg.chance_min + (cfg.chance_max - cfg.chance_min) * severity

    local shield = (sivol_pda and sivol_pda.get_artifact_shield and sivol_pda.get_artifact_shield()) or 0
    chance = chance * (1 - shield)

    if chance <= 0 or math.random() >= chance then return end  -- nothing happens

    local blackout_share = cfg.blackout_share_min + (cfg.blackout_share_max - cfg.blackout_share_min) * severity
    if math.random() < blackout_share then
        sivol_critical_malfunction.trigger_from_hit(severity)
    else
        sivol_critical_malfunction.trigger_glitch_from_hit(severity)
    end
end

function attach(sm)
    sm:subscribe({signal = "on_actor_before_hit", fun = on_actor_before_hit})
end