    wpn_soc308_m1 = "automatic_rifle",
    wpn_spas12 = "shotgun",
    wpn_spas12_m1 = "shotgun",
    wpn_spas15 = "shotgun",
    wpn_spas15_m1 = "shotgun",
    wpn_sv98 = "bolt_action",
    wpn_svd = "automatic_rifle",
    wpn_svu = "automatic_rifle",
    wpn_toz34 = "shotgun",
    wpn_toz34_m1 = "shotgun",
    wpn_ump45 = "automatic_rifle",
    wpn_usp = "pistol",
    wpn_val = "automatic_rifle",
    wpn_val_nimble = "automatic_rifle",
    wpn_vintorez = "automatic_rifle",
    wpn_vintorez_m1 = "automatic_rifle",
    wpn_walther = "pistol",
    wpn_wincheaster1300 = "shotgun",
    wpn_winchester_m1 = "shotgun",
}

local EXCLUDED_SECTIONS = {
    wpn_binoc = "base device; no firearm recoil probe",
    wpn_flame = "flamethrower; unusual scripted weapon",
    wpn_gauss = "energy weapon; unusual scripted weapon",
    wpn_gauss_auto = "energy weapon; unusual scripted weapon",
    wpn_gm94 = "launcher; separate projectile behavior",
    wpn_gungauss = "energy weapon; unusual scripted weapon",
    wpn_knife = "melee weapon; fire callback also covers knife swings",
    wpn_knife_m1 = "melee weapon; fire callback also covers knife swings",
    wpn_rg6 = "launcher; separate projectile behavior",
    wpn_rpg7 = "launcher; separate projectile behavior",
}

local SECTION_BASE_OVERRIDES = {
    wpn_lr300 = "wpn_m16a4",
    wpn_lr300_m1 = "wpn_m16a4",
    -- NLC aliases do not expose an audited respawn source to this adapter.
    wpn_ak47_old = "wpn_ak47",
    wpn_ak74_old = "wpn_ak74",
    wpn_ak74pbn = "wpn_ak74m",
    wpn_ak74u_old = "wpn_ak74u",
}

local RESPAWN_KEYS = {
    "scope_respawn",
    "silencer_respawn",
    "grenade_launcher_respawn",
}

local function valid_number(value)
    local n = tonumber(value)
    return n ~= nil and n == n and math.abs(n) < 100000
end

local function read_live_number(weapon, field)
    local ok, value = pcall(function() return weapon[field] end)
    if not ok or not valid_number(value) then return nil end
    return tonumber(value)
end

local function radians_to_degrees(radians)
    return radians and math.deg(radians) or nil
end

local function resolve_base_section(section)
    if not section then return nil end
    if SECTION_CLASS[section] or EXCLUDED_SECTIONS[section] then return section end
    if SECTION_BASE_OVERRIDES[section] then return SECTION_BASE_OVERRIDES[section] end
    if not sys_ini then return nil end

    local ok_exists, exists = pcall(sys_ini.section_exist, sys_ini, section)
    if not ok_exists or not exists then return nil end

    for _, key in ipairs(RESPAWN_KEYS) do
        local ok_line, line_exists = pcall(sys_ini.line_exist, sys_ini, section, key)
        if ok_line and line_exists then
            local ok_base, base = pcall(sys_ini.r_string, sys_ini, section, key)
            if ok_base and (SECTION_CLASS[base] or EXCLUDED_SECTIONS[base]) then
                return base
            end
        end
    end
    return nil
end

local function clamp(value, low, high)
    return math.max(low, math.min(high, value))
end

function sivol_fuzz_recoil_profiles.get_attachment_mass_effects(addon_mass)
    local mass = math.max(0, tonumber(addon_mass) or 0)
    return {
        stability_k = clamp(
            1.0 - mass * (GLOBAL_RECOIL.attachment_stability_per_kg or 0),
            GLOBAL_RECOIL.attachment_stability_min or 0.88,
            1.0),
        recovery_k = clamp(
            1.0 - mass * (GLOBAL_RECOIL.attachment_recovery_per_kg or 0),
            GLOBAL_RECOIL.attachment_recovery_min or 0.90,
            1.0),
    }
end

function sivol_fuzz_recoil_profiles.resolve(item, weapon)
    if not item or not weapon then return nil, "weapon object unavailable" end

    local ok_section, section = pcall(item.section, item)
    if not ok_section or not section then return nil, "item section unavailable" end

    local base_section = resolve_base_section(section)
    if not base_section then return nil, "unreviewed weapon section" end
    if EXCLUDED_SECTIONS[base_section] then
        return nil, EXCLUDED_SECTIONS[base_section]
    end

    local class_name = SECTION_CLASS[base_section]
    local class_profile = class_name and CLASS_PROFILES[class_name]
    if not class_profile then return nil, "unreviewed weapon class" end

    -- OGSR stores these angular CWeapon fields in radians after loading the
    -- LTX degree values. Keep both forms: degrees feed the profile math, raw
    -- radians are retained for bounded diagnostics.
    local live_raw = {
        cam_dispersion = read_live_number(weapon, "cam_dispersion"),
        cam_dispersion_inc = read_live_number(weapon, "cam_dispersion_inc"),
        cam_relax_speed = read_live_number(weapon, "cam_relax_speed"),
        cam_step_angle_horz = read_live_number(weapon, "cam_step_angle_horz"),
        ammo_mag_size = read_live_number(weapon, "ammo_mag_size"),
        time_to_fire = read_live_number(weapon, "time_to_fire"),
    }
    local live = {
        cam_dispersion = radians_to_degrees(live_raw.cam_dispersion),
        cam_dispersion_inc = radians_to_degrees(live_raw.cam_dispersion_inc),
        cam_relax_speed = radians_to_degrees(live_raw.cam_relax_speed),
        cam_step_angle_horz = radians_to_degrees(live_raw.cam_step_angle_horz),
        ammo_mag_size = live_raw.ammo_mag_size,
        time_to_fire = live_raw.time_to_fire,
    }
    for key, value in pairs(live) do
        if value == nil then
            return nil, "live CWeapon field unavailable: " .. key, true
        end
    end
    if live.ammo_mag_size <= 0 or live.time_to_fire <= 0 then
        return nil, "live magazine or fire interval is invalid", true
    end

    local magazine_factor = clamp(1.0 + (30.0 - live.ammo_mag_size) / 30.0 * 0.10, 0.88, 1.12)
    local fire_rate_factor = clamp(0.10 / live.time_to_fire, 0.78, 1.24)
    local personality = WEAPON_PERSONALITY[base_section] or DEFAULT_PERSONALITY
    local recovery_rate = clamp(
        live.cam_relax_speed * class_profile.recovery_scale
            * (personality.recovery or 1.0) * GLOBAL_RECOIL.recovery,
        0.55,
        16.0)

    return {
        section = section,
        base_section = base_section,
        class_name = class_name,
        class = class_profile,
        live = live,
        live_raw = live_raw,
        magazine_factor = magazine_factor,
        fire_rate_factor = fire_rate_factor,
        recovery_rate = recovery_rate,
        personality = personality,
        global_recoil = GLOBAL_RECOIL,
    }
end

-- A neutral, attachment-free ADS comparison for the inventory tooltip. This
-- deliberately mirrors the gameplay impulse terms rather than averaging raw
-- personality multipliers, whose units and directions differ. Temporary actor
-- state, mastery and attachments belong to their own systems and are excluded.
function sivol_fuzz_recoil_profiles.get_handling_score(
    item, weapon, recoil_k, recovery_k)
    local profile, reason = sivol_fuzz_recoil_profiles.resolve(item, weapon)
    if not profile then
        return nil, reason
    end

    local class = profile.class
    local live = profile.live
    local personality = profile.personality or {}
    local global_recoil = profile.global_recoil or {}
    local heat = 0
    local vertical_total = 0
    local horizontal_total = 0
    local first_vertical = 0
    recoil_k = clamp(tonumber(recoil_k) or 1.0, 0.50, 1.50)
    recovery_k = clamp(tonumber(recovery_k) or 1.0, 0.50, 1.50)

    for shot = 1, 6 do
        local burst_index = clamp(
            (shot - 1.0) * 0.18,
            0,
            math.min(1.80, math.max(0, class.max_burst - 1.0)))
        local stage = personality.sustained or 1.0
        if shot == 1 then
            stage = personality.first or 1.0
        elseif shot == 2 then
            stage = personality.second or 1.0
        end
        local heat_gain = personality.heat_rate or 0.055
        if shot <= (personality.heat_grace or 6) then
            heat_gain = heat_gain * 0.20
        end
        heat = clamp(heat + heat_gain, 0, 1)
        local heat_k = 1.0 + heat * ((personality.heat_max or 1.55) - 1.0)

        local vertical = math.max(0, live.cam_dispersion) * class.dispersion_scale
            + math.max(0, live.cam_dispersion_inc)
                * class.dispersion_increment_scale * burst_index
        vertical = vertical * profile.magazine_factor
        vertical = vertical
            * (1.0 + class.burst_scale * burst_index * profile.fire_rate_factor)
        vertical = vertical * (personality.pitch or 1.0) * stage
            * (1.0 + (heat_k - 1.0) * 0.65)
        if shot == 1 then
            vertical = math.max(vertical, personality.first_pitch_floor or 0)
        end
        vertical = math.min(
            vertical * class.ads_multiplier * (global_recoil.overall or 1.0)
                * (global_recoil.camera_pitch or 1.0),
            class.max_pitch_deg) * recoil_k

        local horizontal = math.max(
            math.max(0, live.cam_step_angle_horz) * class.horizontal_step_scale,
            math.max(0, live.cam_dispersion) * class.horizontal_dispersion_scale)
        horizontal = horizontal * (1.0 + class.burst_scale * burst_index * 0.35)
        horizontal = horizontal * (personality.yaw or 1.0)
            * (1.0 + (heat_k - 1.0)
                * (1.35 + 0.45 * (personality.wander or 1.0)))
        horizontal = math.min(
            horizontal * class.ads_multiplier * (global_recoil.overall or 1.0)
                * (global_recoil.camera_yaw or 1.0),
            class.max_yaw_deg) * recoil_k

        if shot == 1 then
            first_vertical = vertical
        end
        if shot >= 3 then
            vertical_total = vertical_total + vertical
        end
        horizontal_total = horizontal_total + horizontal
    end

    local sustained_vertical = vertical_total / 4.0
    local horizontal_mean = horizontal_total / 6.0
    local first_score = 100 * (1.0 - clamp((first_vertical - 0.25) / 2.75, 0, 1))
    local sustained_score = 100
        * (1.0 - clamp((sustained_vertical - 0.20) / 2.10, 0, 1))
    local horizontal_score = 100
        * (1.0 - clamp((horizontal_mean - 0.10) / 0.80, 0, 1))
    local recovery_score = 100
        * clamp((profile.recovery_rate * recovery_k - 2.0) / 10.0, 0, 1)

    local fire_modes = ""
    if sys_ini and sys_ini:section_exist(profile.section)
        and sys_ini:line_exist(profile.section, "fire_modes") then
        fire_modes = sys_ini:r_string(profile.section, "fire_modes") or ""
    end
    local automatic_fire = string.find(fire_modes, "%-1") ~= nil
    local score
    if automatic_fire then
        score = first_score * 0.30 + sustained_score * 0.30
            + horizontal_score * 0.20 + recovery_score * 0.20
    else
        score = first_score * 0.45 + sustained_score * 0.15
            + horizontal_score * 0.15 + recovery_score * 0.25
    end

    -- Five-point steps communicate comparison without implying laboratory
    -- precision. Leave room at both ends for future balance changes.
    return clamp(math.floor(score / 5.0 + 0.5) * 5, 10, 95)
end

function sivol_fuzz_recoil_profiles.get_class(section)
    local base_section = resolve_base_section(section)
    return base_section and SECTION_CLASS[base_section] or nil
end

function sivol_fuzz_recoil_profiles.get_coverage()
    return SECTION_CLASS, EXCLUDED_SECTIONS, SECTION_BASE_OVERRIDES
end

function sivol_fuzz_recoil_profiles.get_tuning()
    return GLOBAL_RECOIL, WEAPON_PERSONALITY, DEFAULT_PERSONALITY
end

function attach(sm)
    -- The profile adapter has no per-frame work. It is registered so the
    -- signal manager loads it before the consumer module.
end

sivol_fuzz_recoil_profiles.attach = attach
