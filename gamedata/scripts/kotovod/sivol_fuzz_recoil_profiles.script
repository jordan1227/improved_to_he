-- [HE-PORT] Live-data adapter for the first Fuzz-style recoil prototype.
--
-- This table is deliberately based on the reviewed NLC weapon roster. It is
-- not an Anomaly classification layer and it does not add LTX metadata. The
-- numbers that describe a particular weapon are read from its live CWeapon
-- object after equip.

sivol_fuzz_recoil_profiles = sivol_fuzz_recoil_profiles or {}

-- Global balance controls. Per-weapon personalities below are multiplied by
-- these values, so overall strength can be adjusted without flattening the
-- differences between weapons.
local GLOBAL_RECOIL = {
    overall = 1.00,
    camera_pitch = 2.90,
    camera_yaw = 0.72,
    hud_rotation = 1.12,
    hud_translation = 1.08,
    -- Route a restrained share of viewmodel rotation through the critically
    -- damped spring in sivol_fuzz_recoil. Set both shares to 0 to compare the
    -- former immediate-only HUD response without changing camera recoil.
    hud_spring_pitch_share = 0.22,
    hud_spring_yaw_share = 0.15,
    hud_spring_frequency = 18.0,
    recovery = 1.00,
    attachment_stability_per_kg = 0.07,
    attachment_recovery_per_kg = 0.04,
    attachment_stability_min = 0.88,
    attachment_recovery_min = 0.90,
}

local DEFAULT_PERSONALITY = {
    pitch = 1.00,
    yaw = 1.00,
    first = 1.00,
    second = 1.00,
    sustained = 1.00,
    first_pitch_floor = 0.0,
    recovery = 1.00,
    heat_grace = 6,
    heat_rate = 0.055,
    heat_max = 1.55,
    yaw_persistence = 0.62,
    wander = 1.00,
    shove = 1.00,
    roll = 1.00,
    hip_multiplier = nil,
    first_immediate_share = nil,
}

local WEAPON_PERSONALITY = {}

local function register_personality(ids, values)
    for _, id in ipairs(ids) do WEAPON_PERSONALITY[id] = values end
end

-- Pistols: light service weapons snap sharply and settle quickly; large-bore
-- pistols trade a heavier first impulse for a slower follow-up cadence.
register_personality({ "wpn_pm", "wpn_pb", "wpn_fort" },
    { pitch = 1.20, yaw = 0.85, first = 1.18, second = 0.94, sustained = 0.90,
      first_pitch_floor = 0.36, recovery = 1.18, heat_grace = 2, heat_rate = 0.08,
      yaw_persistence = 0.48, wander = 0.85, shove = 0.82, roll = 0.85 })
-- The P99's inherited LTX cam_dispersion is an extreme 1.25 degrees. Give it
-- an explicit low-kick service-pistol identity and a quicker return instead of
-- inheriting the PM/Fort multiplier on top of that outlier input.
register_personality({ "wpn_walther" },
    { pitch = 0.38, yaw = 0.72, first = 0.88, second = 0.92, sustained = 0.90,
      first_pitch_floor = 0.28, recovery = 1.55, heat_grace = 3, heat_rate = 0.06,
      yaw_persistence = 0.46, wander = 0.72, shove = 0.62, roll = 0.75 })
-- The Glock 17 remains a sharp, light 9x19 pistol, but its 0.8-degree native
-- dispersion no longer makes it approach magnum-pistol camera movement.
register_personality({ "wpn_glock" },
    { pitch = 0.72, yaw = 0.82, first = 1.05, second = 0.98, sustained = 0.94,
      first_pitch_floor = 0.36, recovery = 1.25, heat_grace = 2, heat_rate = 0.07,
