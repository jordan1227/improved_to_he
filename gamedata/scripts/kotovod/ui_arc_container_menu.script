function add_bad_item( sect, cond )
    local obj = misc.spawn_to( sect, db.actor )
    if obj then
		local obj_id = level.object_by_id( obj.id )
		if obj_id and obj_id:is_weapon() then 
			schedule.add( "unload_weapon", "sak_dialog.weapon_unload( ".. obj.id .." )", 250 )	
		end	
        params.upd_condition( obj.id, cond )
        sak.relocate_item( "in", sect, 1 )
    end
end

function get_inv_name(sect)
    local name = get_string(
        sect, "inv_name", get_string(sect, "inv_name_short")
    )
    if not name then return name end
    return dsh.strip_quotes(game.translate_string(name))
end

function set_inv_item_weight(obj, weight)
    obj:get_inventory_item().inv_weight = weight
end

function change_inv_item_weight(id, weight, abs_weight)
    local obj = level.object_by_id(id)
    if obj then
        if abs_weight then
            set_inv_item_weight(obj, weight)
        else
            local cur_weight = get_inv_item_weight(obj)
            set_inv_item_weight(obj, cur_weight + weight)
        end
    end
end


-- сделать предмет безусловно негруппируемым в окнах инвентаря
function set_item_ungroupable(item)
    local f = item:get_inventory_item_flags()
    f:set(global_flags.FIAlwaysUngroupable, true)
    item:set_inventory_item_flags(f)
end

-- включить движковую группировку для предмета
function set_item_default_grouping(item)
    local f = item:get_inventory_item_flags()
    f:set(global_flags.FIAlwaysUngroupable, false)
    item:set_inventory_item_flags(f)
end

-- сделать предмет безусловно непродаваемым в окнах инвентаря
function set_item_untradable(item)
    local f = item:get_inventory_item_flags()
    f:set(global_flags.FIAlwaysUntradable, true)
    item:set_inventory_item_flags(f)
end

-- включить движковую продажу для предмета
function set_item_default_trading(item)
    local f = item:get_inventory_item_flags()
    f:set(global_flags.FIAlwaysUntradable, false)
    item:set_inventory_item_flags(f)
end

-- сделать предмет невидимым в инвентаре
function set_item_inv_hidden(item)
    local f = item:get_inventory_item_flags()
    f:set(global_flags.FIHiddenForInventory, true)
    item:set_inventory_item_flags(f)
end

-----------------------------------------

function arc_8container_menu:show_art_info(wnd, section, condition, data)
    local text = ""

    local inv_name = this.get_inv_name(section)
	
	local dyn_num = tonumber( string.sub( section, -2, -2 ) )
	if strpos( section, "_dyn", 1, true ) and not strpos( section, "_capsule" ) then
		inv_name = inv_name .. " [" .. dyn_num .. "]"
	end	
	
    if is_debug_mode then
        text = inv_name .. " (" .. section .. ")\\n \\n"

        -- debug-инфо по капсулам nlc_capsules
        if nlc_capsules.is_capsule_section(section) then
            local payload = nlc_capsules.read(data)
            if payload then
                local content_sect = nlc_capsules.content_section(payload)
                local content_name = content_sect and get_string(content_sect, "inv_name", content_sect) or "?"
                text = text .. string.format(
                    "%%c[255,255,220,50]CAPSULE: sect=%s \\n dyn=%s tag=%s\\n-> %%c[white]%s\\n \\n",
                    tostring(content_sect), tostring(payload.dyn), tostring(payload.tag), translate(content_name)
                )
            else
                text = text .. "%c[255,255,50,50]CAPSULE: payload NOT FOUND in custom_data!\\n \\n"
            end
        end
    else
        text = inv_name .. "\\n \\n"
    end
	
	if condition then 
		text = text .. string.format( "• Состояние: %d%%\\n \\n", condition * 100 )
	end

    local af_text = get_art_info_text(section, condition, data)
    if af_text then
        text = text .. af_text .. "\\n \\n%c[default]"
    end
	
	if strpos( section, "af_compass", 1, true ) then 
		text = text .. "\\n" .. ui_inv_descr.get_compass_way( data )
	end	

    local cost = get_float(section, "cost", 0)
    if cost ~= 0 then
        text = text .. "\\n" .. "Базовая стоимость: " .. cost .. " руб."
    end
    local inv_weight = get_float(section, "inv_weight", 0)
    if inv_weight ~= 0 then
        text = text .. "\\nВес:" .. string.format("%s%.2f кг", game.translate_string("ui_inv_weight"), inv_weight)
    end
	
    wnd:SetText(text)
end

function arc_8container_menu:draw_artefacts()
    for i, t in ipairs(self.artefacts) do
        if t.section then
            local s    = self:make_art_button(t, "take")
            local x, y = self:get_target_xy("take", i)
            s:SetWndPos(x, y)
            self:Register(s.button, "art_button_take_" .. i)
            t.button = s
        end
    end
    for i = 1, self.slots do
        self:AddCallback(
            "art_button_take_" .. i, ui_events.BUTTON_CLICKED,
            function(wnd) wnd:take_artefact(i) end, self
        )
        self:AddCallback(
            "art_button_take_" .. i, ui_events.STATIC_FOCUS_RECEIVED,
            function()
                --log1("STATIC_FOCUS_RECEIVED="..t.section)
                local info = self.info_wnd
                local src = self.artefacts[i]
                self:show_art_info(info, src.section, src.condition, src.custom_data)
            end
        )
    end
end

function arc_8container_menu:take_artefact(n)
    local src = self.artefacts[n]
    if src and src.section and sivol_unknown_arts
        and sivol_unknown_arts.is_unknown_section(src.section)
        and not sivol_unknown_arts.read_custom(src.custom_data or "")
    then
        local payload = sivol_unknown_arts.migrate_container_entry(
            src.section, src.condition, self.object:id(), n, src.custom_data
        )
        if payload then src.custom_data = sivol_unknown_arts.encode(payload, src.custom_data) end
    end
    local s   = src.button
    if s.flying then return end

    self.artefacts[n] = {}
    self:save_artefacts()

    local wpos = s:GetWndPos()
    self:detach_button(s)

    -- Если достали, то не нужно его дополнительно переспавнивать
    if src.section == "af_dummy_black_tip" then
        if sig_inv_hide and not sig_inv_hide.unsubscribed then
            ogse_signals.get_mgr():unsubscribe(sig_inv_hide)
        end
        sig_inv_hide = nil
        if sig_inv_drop and not sig_inv_drop.unsubscribed then
            ogse_signals.get_mgr():unsubscribe(sig_inv_drop)
        end
        sig_inv_drop = nil
    end

    local sobj = misc.spawn_to( src.section, db.actor )
    if sobj and src.custom_data and sivol_unknown_arts then
        sivol_unknown_arts.restore_server(alife():object(sobj.id), src.custom_data)
    end
	level.client_spawn_manager():add(
		sobj.id, -1,
		function( id, sobj )
			sobj:set_condition( src.condition )	
			local alife_obj = sobj:get_alife_object()
			if src.custom_data then
				log3( "src on take %s", src.custom_data )
				alife_obj.custom_data = src.custom_data
			end		

			-- восстанавливаем радейку свалки из custom_data
			if src.custom_data then
				local props = ui_arc_container_menu.xp_read_from_cust( src.custom_data )
				if props and props.rad then
					local live_obj = level.object_by_id( id )
					local af_obj = live_obj and live_obj:get_artefact()
					if af_obj then
						update_prop( af_obj, "radiation_restore_speed", props.rad )
						local new_tbl = get_value( "garbage_arts", {} )
						new_tbl[ tostring( id ) ] = true
						set_value( "garbage_arts", new_tbl )
					end
				end
			end			

			self.fly_it[id] = vector():set(wpos.x, wpos.y, 0)
			vergas_lib.s_play( "scripts\\art_move", 1 )
			dsh.timeout( 15, function() self.info_wnd:SetText("") end )
		end
	)
end

function arc_8container_menu:draw_inventory()
    local scrolled_h = self.min_scrolled_height

    for i, t in ipairs(self.inventory) do
        local s    = self:make_art_button(t, "put")
        local x, y = self:get_target_xy("put", i)
        s:SetWndPos(x, y)
        
        local btn_name = "art_button_put_" .. i
        s.button:SetWindowName(btn_name)
        self:Register(s.button, btn_name)
        
        self:AddCallback(
            btn_name, ui_events.BUTTON_CLICKED,
            function(wnd) 
                -- Получаем индекс из имени кнопки
                local idx = tonumber(string.match(btn_name, "%d+"))
                wnd:put_artefact(idx) 
            end, self
        )

        self:AddCallback(
            btn_name, ui_events.STATIC_FOCUS_RECEIVED,
            function()
                -- Получаем индекс из имени кнопки
                local idx = tonumber(string.match(btn_name, "%d+"))
                if self.inventory[idx] and self.inventory[idx].section then
                    self:show_art_info(self.info_wnd, self.inventory[idx].section, self.inventory[idx].condition, self.inventory[idx].custom_data)
                end
            end
        )

        t.button = s

        local max_h = s:GetPosTop() + s:GetHeight()
        if max_h > scrolled_h then scrolled_h = max_h end
    end

    if scrolled_h > self.min_scrolled_height then
        self.scrolled:SetHeight(scrolled_h)
    end

    self.added_callbacks = table.getn(self.inventory)
end

function remove_item_from_inventory(remove_item, npc)
    if not npc then npc = db.actor end
    if remove_item then
        -- npc:mark_item_dropped(remove_item)
        return amk.remove_item(remove_item)
    end
    return false
end

function arc_8container_menu:put_artefact(n)
    local src = self.inventory[n]
    if src.button.flying then return end

    local dst, pos
    for i, t in ipairs(self.artefacts) do
        if not t.section then
            dst = t
            pos = i
            break
        end
    end
    if not dst then
        if table.getn(self.artefacts) == self.slots then return end
        dst = {}
        table.insert(self.artefacts, dst)
        pos = table.getn(self.artefacts)
    end

    local source_server = g_sim:object(src.id)
    if source_server and type(sivol_unknown_arts) == "table"
        and type(sivol_unknown_arts.initialize_new) == "function"
        and sivol_unknown_arts.is_unknown_section(src.section)
    then
        sivol_unknown_arts.initialize_new(source_server)
        local _, stored_data = sivol_unknown_arts.read_server(source_server)
        src.custom_data = stored_data
    end
    for _, k in ipairs({ "section", "condition", "custom_data" }) do
        dst[k] = src[k]
    end
	
	-- Что-то надо с ней сделать, мб на закрытии возвращать в инвентарь или вообще запретить помещать в конт, тогда удалить все лишнее
    if src.section == "af_dummy_black_tip" then
        this.subscribe_black_tip(self.object:id(), src.condition)
    end
	
	-- для радейки
		if src.section and src.condition > 0 then
			local base_rrs = nominal_art_property(src.section, "radiation_restore_speed", src.custom_data)
			local rrs = base_rrs * get_effective_strength_raw(src.condition, src.section, base_rrs < 0, "radiation_restore_speed")
			if rrs > self.protection then
			   sak.send_tip( "Защита недостаточна.", "Контейнер", 0, 10, "death", "sak", "red" )
			end
		end

    if dst.custom_data then
		log3( "dst custom_data %s", dst.custom_data )
        --dst.custom_data = base64.enc(dst.custom_data)
        dst.custom_data = dst.custom_data
    end
    self:save_artefacts()

    local wpos = src.button:GetWndPos()
    src.button:Show(false)
    local s    = self:make_art_button(dst, "take")
    local x, y = self:get_target_xy("take", pos)
    s.flying   = {
        progress   = 0.1,
        start_pos  = vector():set(wpos.x, wpos.y, 0),
        start_time = time_global(),
        target_pos = vector():set(x, y, 0),
    }
    table.insert(self.flying, s)
    s:SetWndPos(wpos.x, wpos.y)
    self:Register(s.button, "art_button_take_" .. pos)
    dst.button = s

	-- Очищать инфу в окне описания, если закинули последний имеющийся
	if n == #self.inventory then
		dsh.timeout( 15, function()
			self.info_wnd:SetText( "" )
		end )
	end

    remove_item_from_inventory(src.object)
	vergas_lib.s_play( "scripts\\art_move", 1 )
end

function subscribe_black_tip(container_id, condition)
    if sig_inv_hide or sig_inv_drop then return end

	local handled_bt = false

    local function cleanup()
        local hide_sub = sig_inv_hide
        local drop_sub = sig_inv_drop
        sig_inv_hide = nil
        sig_inv_drop = nil
        if hide_sub and not hide_sub.unsubscribed then
            ogse_signals.get_mgr():unsubscribe(hide_sub)
        end
        if drop_sub and not drop_sub.unsubscribed then
            ogse_signals.get_mgr():unsubscribe(drop_sub)
        end
    end

    sig_inv_hide = ogse_signals.get_mgr():subscribe_once({
        signal = "on_inventory_hide",
        fun = function()
			if handled_bt then return end
			handled_bt = true
            cleanup()
            this.put_out_art(container_id, nil, "af_dummy_black_tip")
            kotovod.add_bad_item("af_dummy_black_tip", condition)
            sak.send_tip_local(
                "Етижи-пассатижи, вернулась зараза! \\nПохоже, нет никакого смысла помещать её в контейнер...",
                "Мысли вслух", 2, 10, "g_g", "sak", "red"
            )
        end
    })

    sig_inv_drop = ogse_signals.get_mgr():subscribe_once({
        signal = "on_drop_before_all",
        fun = function(obj)
            if obj:id() ~= container_id then return end
			if handled_bt then return end
			handled_bt = true			
            cleanup()
			dsh.timeout( 10, function()
				this.put_out_art(container_id, nil, "af_dummy_black_tip")
				sak.send_tip_local(
					"Етижи-пассатижи, вернулась зараза! \\nПохоже, нет никакого смысла помещать её в контейнер...",
					"Мысли вслух", 2, 10, "g_g", "sak", "red"
				)
			end	)
        end
    })
end

function arc_8container_menu:subscribe_signals()
    self.signals = {
        { signal = "on_drop_before_all", fun = self.on_drop, self = self },
        { signal = "on_take",            fun = self.on_take, self = self },
    }
    local sm = ogse_signals.get_mgr()
    for _, s in ipairs(self.signals) do
        sm:subscribe(s)
    end
end

function arc_8container_menu:unsubscribe_signals()
    local sm = ogse_signals.get_mgr()
    for _, s in ipairs(self.signals) do
        sm:unsubscribe(s)
    end
    self.signals = nil
end

function arc_8container_menu:on_drop(obj)
    self.changed = true
end

function arc_8container_menu:on_take(obj)
    self.changed = true
end

function arc_8container_menu:reload_inventory()
    local changed = self:load_inventory()
    if not changed then 
        return 
    end

    local scrolled_h = self.min_scrolled_height

    for i, t in ipairs(self.inventory) do
        local btn_name = "art_button_put_" .. i
        local s = t.button
        local need_recreate = false

        if s then
            -- Проверяем, изменился ли индекс кнопки
            local old_btn_name = s.button:WindowName()
            if old_btn_name ~= btn_name then
                -- Индекс изменился - пересоздаем кнопку
                self.scrolled:DetachChild(s)
                need_recreate = true
            else
                self:Register(s.button, btn_name)
            end
        else
            need_recreate = true
        end

        if need_recreate then
            s = self:make_art_button(t, "put")
            s.button:SetWindowName(btn_name)
            self:Register(s.button, btn_name)
            
            self:AddCallback(
                btn_name, ui_events.BUTTON_CLICKED,
                function(wnd) 
                    local idx = tonumber(string.match(btn_name, "%d+"))
                    wnd:put_artefact(idx) 
                end, self
            )

            self:AddCallback(
                btn_name, ui_events.STATIC_FOCUS_RECEIVED,
                function()
                    local idx = tonumber(string.match(btn_name, "%d+"))
                    if self.inventory[idx] and self.inventory[idx].section then
                        self:show_art_info(self.info_wnd, self.inventory[idx].section, self.inventory[idx].condition, self.inventory[idx].custom_data)
                    end
                end
            )
            
            t.button = s
        end

        s.progress:SetProgressPos(t.condition * 100)

        local x, y    = self:get_target_xy("put", i)
        local fly_pos = self.fly_it[t.id]

        if fly_pos then
            s.flying = {
                progress   = 0.1,
                start_pos  = fly_pos,
                start_time = time_global(),
                target_pos = vector():set(x, y, 0),
            }
            s:SetWndPos(fly_pos.x, fly_pos.y)
            self.fly_it[t.id] = nil
            table.insert(self.flying, s)
        elseif s.flying then
            s.flying.target_pos = vector():set(x, y, 0)
        else
            s:SetWndPos(x, y)
        end

        local max_h = y + s:GetHeight()
        if max_h > scrolled_h then scrolled_h = max_h end
    end

    if scrolled_h > self.min_scrolled_height then
        self.scrolled:SetHeight(scrolled_h)
    end
end

function arc_8container_menu:Update()
    CUIScriptWnd.Update(self)
    if self.changed then
        self:reload_inventory()
        self.changed = false
    end
    if table.getn(self.flying) then
        self:update_flying()
    end
end

function arc_8container_menu:update_flying()
    for _, s in ipairs(self.flying) do
        local t    = s.flying
        local dt   = (time_global() - t.start_time) / 1000
        t.progress = t.progress + dt * fly_speed
        if t.progress > 1 then t.progress = 1 end
        local p = vector():sub(t.target_pos, t.start_pos)
        p:mul(t.progress)
        p:add(t.start_pos)
        s:SetWndPos(math.floor(p.x), math.floor(p.y))
    end
    for i = table.getn(self.flying), 1, -1 do
        local s = self.flying[i]
        if s.flying.progress == 1 then
            table.remove(self.flying, i)
            s.flying = nil
        end
    end
end

function arc_8container_menu:stop_flying()
    for _, s in ipairs(self.flying) do
        local t = s.flying
        s:SetWndPos(t.target_pos.x, t.target_pos.y)
    end
    self.flying = {}
end

function arc_8container_menu:on_quit()
    self:unsubscribe_signals()
    self:GetHolder():start_stop_menu(self, true)
    self:ClearCallbacks()
    active_menu = false
	vergas_lib.s_play( "scripts\\inv_art_container_close", 1 )
end

function arc_8container_menu:OnKeyboard(dik, keyboard_action)
    CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
        if dik == DIK_keys.DIK_ESCAPE then
            self:on_quit()
        end
    end
    return true
end

function arc_8container_menu:reload_artefacts()
    self:stop_flying()
    for _, t in ipairs(self.artefacts) do
        if t.button then
            self:detach_button(t.button)
        end
    end
    self:load_artefacts()
    self:draw_weight()
	vergas_lib.s_play( "scripts\\inv_art_container_change", 1 )
    for i, t in ipairs(self.artefacts) do
        if t.section then
            local s = self:make_art_button(t, "take")
            s:SetWndPos(self:get_target_xy("take", i))
            self:Register(s.button, "art_button_take_" .. i)
            t.button = s
        end
    end
end

function arc_8container_menu:next_container()
    self.object = self.containers[self.next_n]
    self.prev_n = self.next_n - 1
    if self.next_n == table.getn(self.containers) then
        self.next_n = false
    else
        self.next_n = self.next_n + 1
    end
    self.btn_prev:Show(true)
    self.btn_next:Show(self.next_n and true or false)
    self:reload_artefacts()
end

function arc_8container_menu:prev_container()
    self.object = self.containers[self.prev_n]
    self.next_n = self.prev_n + 1
    if self.prev_n == 1 then
        self.prev_n = false
    else
        self.prev_n = self.prev_n - 1
    end
    self.btn_prev:Show(self.prev_n and true or false)
    self.btn_next:Show(true)
    self:reload_artefacts()
end



-- Вынес из левого скрипта


local af_actor_cond = {
    ["bleeding_restore_speed"] = get_float("actor_condition", "wound_incarnation_v", 0),
    ["health_restore_speed"] = get_float("actor_condition", "satiety_health_v", 0),
    ["power_restore_speed"] = get_float("actor_condition", "satiety_power_v", 0) * 100,
    ["satiety_restore_speed"] = get_float("actor_condition", "satiety_v", 0),
    ["thirst_restore_speed"] = get_float("actor_condition", "thirst_v", 0),
    ["radiation_restore_speed"] = get_float("actor_condition", "radiation_v", 0) * 100,
    ["psy_health_restore_speed"] = get_float("actor_condition", "psy_health_v", 0),
}

local af_absorbs = {
    "burn_immunity",
    "strike_immunity",
    "shock_immunity",
    "wound_immunity",
    "radiation_immunity",
    "telepatic_immunity",
    "chemical_burn_immunity",
    "explosion_immunity",
    "fire_wound_immunity",
}

local af_ui_name = {
    ["health_restore_speed"] = "ui_inv_health",
    ["radiation_restore_speed"] = "ui_inv_radiation",
    ["satiety_restore_speed"] = "ui_inv_satiety",
    ["thirst_restore_speed"] = "ui_inv_thirst",
    ["power_restore_speed"] = "ui_inv_power",
    ["bleeding_restore_speed"] = "ui_inv_bleeding",
    ["psy_health_restore_speed"] = "ui_inv_psy_health",
    ["burn_immunity"] = "ui_inv_outfit_burn_protection",
    ["strike_immunity"] = "ui_inv_outfit_strike_protection",
    ["shock_immunity"] = "ui_inv_outfit_shock_protection",
    ["wound_immunity"] = "ui_inv_outfit_wound_protection",
    ["radiation_immunity"] = "ui_inv_outfit_radiation_protection",
    ["telepatic_immunity"] = "ui_inv_outfit_telepatic_protection",
    ["chemical_burn_immunity"] = "ui_inv_outfit_chemical_burn_protection",
    ["explosion_immunity"] = "ui_inv_outfit_explosion_protection",
    ["fire_wound_immunity"] = "ui_inv_outfit_fire_wound_protection",
    ["additional_inventory_weight"] = "ui_inv_additional_weight",
    ["additional_inventory_weight2"] = "Переносимый вес:",
}

function get_art_info_text(sect, condition, data)
    condition = condition or 1
    local texts = {}

    local garbage_rad = nil
    if data then
        local props = ui_arc_container_menu.xp_read_from_cust( data )
        if props and props.rad then
            garbage_rad = props.rad
        end
    end

    for k, v in pairs(af_actor_cond) do
        local base_val = nominal_art_property(sect, k, data)
        local af_val

        if k == "radiation_restore_speed" and garbage_rad then
            local is_buff = (garbage_rad < 0)
            af_val = garbage_rad * get_effective_strength_raw(condition, sect, is_buff, k) / v * 100
        elseif base_val ~= 0 then
            local is_buff = true
            if k == "radiation_restore_speed" then
                is_buff = (base_val < 0)
            else
                is_buff = (base_val > 0)
            end
            af_val = base_val / v * 100 * get_effective_strength_raw(condition, sect, is_buff, k)
        end

        if af_val and math.abs( af_val ) > 0.000001 then
            local sn = "%"
            if k == "radiation_restore_speed" then sn = "" end
            local color = af_val > 0 and "%c[green]" or "%c[red]"
            if k == "bleeding_restore_speed" then
                af_val = af_val * -1
            end
            if k == "bleeding_restore_speed" or k == "radiation_restore_speed" then
                color = af_val > 0 and "%c[red]" or "%c[green]"
            end
			local format_str = "%+.0f"
			if k == "radiation_restore_speed" then
				format_str = "%+.1f"
			end

			table.insert(
				texts,
				string.format(
					"%%c[default]• %s %s" .. format_str .. "%s",
					game.translate_string(af_ui_name[k]), color, af_val, sn
				)
			)
        end
    end

    for _, k in ipairs({
        "additional_inventory_weight", "additional_inventory_weight2"
    }) do
        local af_val = nominal_art_property(sect, k, data)
        if k == "additional_inventory_weight" then
            local af_val2 = nominal_art_property(sect, "additional_inventory_weight2", data)
            if af_val == af_val2 then af_val = 0 end
        end
        if af_val ~= 0 then
            af_val = af_val * get_effective_strength_raw(condition, sect, af_val > 0, k)
            local sn = " кг"
            local color = af_val > 0 and "%c[green]" or "%c[red]"
			table.insert(
				texts,
				string.format(
					"%%c[default]• %s %s%+.1f%s",
					game.translate_string(af_ui_name[k]), color, af_val, sn
				)
			)
        end
    end

    local absorb_sect = get_string(sect, "hit_absorbation_sect")
    if sys_ini:section_exist(absorb_sect) then
        for _, k in ipairs(af_absorbs) do
            local af_val = nominal_art_property(sect, k, data)
            if af_val == 0 then
                af_val = get_float(absorb_sect, k, 0)
            end
            if af_val ~= 1 then
                local is_buff = (af_val <= 1)
                af_val = (1 - af_val) * 100 * get_effective_strength_raw(condition, sect, is_buff, k)
                local color = af_val > 0 and "%c[green]" or "%c[red]"
                table.insert(
                    texts,
                    string.format(
                        "%%c[default]• %s %s%+.0f%s",
                        game.translate_string(af_ui_name[k]), color, af_val, "%"
                    )
                )
            end
        end
    end

    for _, wear in ipairs({
        { property = "outfit_wear_burn", label = "ui_inv_outfit_wear_fire" },
        { property = "outfit_wear_shock", label = "ui_inv_outfit_wear_shock" },
        { property = "outfit_wear_chemical", label = "ui_inv_outfit_wear_chemical" },
    }) do
        local wear_value = nominal_art_property(sect, wear.property, data)
        if wear_value and wear_value > 0 then
            wear_value = wear_value * get_effective_strength_raw(condition, sect, true, wear.property)
            table.insert(
                texts,
                string.format(
                    "%%c[default]? %s %%c[green]-%0.f%%",
                    game.translate_string(wear.label), wear_value * 100
                )
            )
        end
    end
    if table.getn(texts) > 0 then
        return table.concat(texts, "\\n")
    end
end


-- Универсальная для контейнеров
--[[
local tbl_arts = {
    { sect = kotovod.rnd_rec_art_info( kotovod.tbl_arts, 2 ), cond = 0.73 },
    { sect = kotovod.rnd_rec_art_info( kotovod.tbl_arts, 5 ), cond = 0.88 },
    { sect = "af_dummy_spring",                                cond = 0.65 },
}
ui_arc_container_menu.fill_container( sobj_cont, tbl_arts )

ui_arc_container_menu.fill_container( sobj_cont, {
    { sect = "af_compass", cond = 1.0, cust = "yan_tele_esc" }
})
]]--


function fill_container( sobj_cont, tbl_arts )
    if not sobj_cont then return end
    local cont_sect = sobj_cont:section_name()
    local slots     = get_u32( cont_sect, "container_slots" ) or 8
    local arts      = {}
    for i = 1, slots do table.insert( arts, {} ) end
    for i, v in ipairs( tbl_arts ) do
        if i > slots then 
			--log4( "[fill_container] warning: too many arts for %s, slots=%d arts=%d", cont_sect, slots, #tbl_arts )
			break 
		end
        arts[ i ] = {
            section     = v.sect,
            condition   = v.cond,
            custom_data = v.cust or nil
        }
    end
    local pk = get_netpk( sobj_cont, 1 )
    if pk then
        local data = pk:get()
        data.custom_data = arc_radiation.encode_custom_data( arts, cont_sect, slots )
        pk:set( data )
    end
end

-- ============================================================
-- Универсальная система свойств в custom_data
-- Формат: xp={key1=val1,key2=val2}
-- ============================================================


function xp_read_raw( cust )
    if not cust then return nil end
    local body = cust:match( "xp={(.-)}" )
    if not body or body == "" then return nil end
    local props = {}
    for pair in body:gmatch( "[^;]+" ) do
        local k, v = pair:match( "^([%w_]+)=(.*)$" )
        if k then
            local num = tonumber( v )
            props[ k ] = num ~= nil and num or v
        end
    end
    return props
end

function xp_read( id )
    local sobj = g_sim:object( id )
    if not sobj then return nil end
    local pk = get_netpk( sobj, 1 )
    if not pk then return nil end
    return xp_read_raw( pk:get().custom_data )
end

function xp_read_from_cust( cust )
    return xp_read_raw( cust )
end

function xp_write( id, props )
    local sobj = g_sim:object( id )
    if not sobj then return end
    local pk = get_netpk( sobj, 1 )
    if not pk then return end
    local data = pk:get()
    local cust = data.custom_data or ""
    local existing = xp_read_raw( cust ) or {}
    for k, v in pairs( props ) do
        existing[ k ] = v
    end
    local parts = {}
    for k, v in pairs( existing ) do
        table.insert( parts, k .. "=" .. tostring( v ) )
    end
    cust = cust:gsub( "|?xp={[^}]*}", "" )
    cust = cust:gsub( "^|", "" )
	log2( "cust is %s", tostring( cust ) )
    -- используем ; вместо , чтобы не ломать parse_names контейнера
    local xp = "xp={" .. table.concat( parts, ";" ) .. "}"
    data.custom_data = cust ~= "" and ( cust .. "|" .. xp ) or xp
    pk:set( data )
end

function xp_delete( id, key )
    local props = xp_read( id )
    if not props then return end
    props[ key ] = nil
    xp_write( id, props )
end