local fly_speed = 1
local sig_inv_hide, sig_inv_drop = nil, nil

function attach(sm)
    sm:subscribe({ signal = "on_use", fun = this.on_use })
end


function on_use(obj, sobj)
    local sect = obj:section()
    --if get_bool(sect, "arc_usable") then
	if strpos( sect, "arc_art_box_", 1, true ) then
        show_menu(obj)
        return true
    end
end

local active_menu = false

function show_menu(obj)
    local spwn  = arc_8container_menu(obj)
    active_menu = spwn
    level.start_stop_menu(spwn, true)
	vergas_lib.s_play( "scripts\\inv_art_container_open", 1 )
end

function possible_inv_change()
    if active_menu then
        active_menu.changed = true
    end
end

class "arc_8container_menu" (CUIScriptWnd)
function arc_8container_menu:__init(obj)
    super()
    self.object = obj
    self:read_params()
    self:load_artefacts()
    self:load_inventory()
    self:load_containers()

    self.xml = CScriptXmlInit()
    self.xml:ParseFile(self.xml_name)
    self:DrawBackground()
    self:draw_weight()
    self:draw_artefacts()
    self:draw_inventory()
    self:subscribe_signals()

    self.flying = {}
    self.fly_it = {}
end

function arc_8container_menu:__finalize()
end

local radiation_v = get_float("actor_condition", "radiation_v")

local function nominal_art_property(target, property, custom_data)
    local section = type(target) == "string" and target or target:section()
    local value = get_float(section, property, 0)
    if type(sivol_unknown_arts) == "table"
        and type(sivol_unknown_arts.get_nominal_property) == "function"
    then
        local resolved = sivol_unknown_arts.get_nominal_property(target, property, custom_data)
        if resolved ~= nil then value = resolved end
    end
    return value
end

function arc_8container_menu:read_params()
    local prefix  = "arc_ui_8container_menu."
    local sect    = self.object:section()
    self.xml_name = get_string(sect, prefix .. "xml")
    self.menu_cfg = {}
    for _, k1 in ipairs({ "put", "take" }) do
        local prefix2 = prefix .. k1 .. "."
        local t = {}
        self.menu_cfg[k1] = t
        for _, k2 in ipairs({ "row_size", "space", "x_start", "y_start" }) do
            t[k2] = get_u32(sect, prefix2 .. k2);
        end
        t.space_x = get_u32(sect, prefix2 .. "space_x", t.space);
        t.space_y = get_u32(sect, prefix2 .. "space_y", t.space);
    end
    self.protection = get_u32(sect, "container_protection", 0)
    if self.protection > 0 then
        self.protection = (self.protection + 0.1) * radiation_v
    end
    self.slots  = get_u32(sect, "container_slots")
    self.weight = get_float(sect, "inv_weight")
end

function arc_8container_menu:load_artefacts()
    local sobj = g_sim:object(self.object:id())
    self.artefacts = arc_radiation.decode_custom_data(
        sobj.custom_data, sobj:section_name(), self.slots
    )
end

function arc_8container_menu:update_radiation()
    local rad = 0
    if self.protection > 0 then
        for i, t in ipairs(self.artefacts) do
			if t.section and t.condition > 0 then
				local base_rrs = nominal_art_property(t.section, "radiation_restore_speed", t.custom_data)
				local rrs = base_rrs * get_effective_strength_raw(t.condition, t.section, base_rrs < 0, "radiation_restore_speed")
				if rrs > self.protection then rad = rad + (rrs - self.protection) end
			end
        end
        local iitem = self.object:get_inventory_item()
        ASSERT(
            iitem, "[%s]: %s not an inventory_item", script_name(), self.object:name()
        )
        iitem.radiation_restore_speed = rad
        arc_radiation.register_item(self.object:id(), rad)		
    end
    return rad
end

function arc_8container_menu:update_grouping()
    for i, t in ipairs(self.artefacts) do
        if t.section then
            set_item_ungroupable(self.object)
            return
        end
    end
    set_item_default_grouping(self.object)
end

function arc_8container_menu:save_artefacts()
    local sobj = g_sim:object(self.object:id())
    sobj.custom_data = arc_radiation.encode_custom_data(
        self.artefacts, sobj:section_name(), self.slots
    )
    this.set_inv_item_weight(self.object, self.weight + self:draw_weight())
    self:update_radiation()
	self:update_grouping()
end

function arc_8container_menu:detach_button(s)
    s.button   = nil
    s.progress = nil
    if s.flying then
        for i, t in ipairs(self.flying) do
            if s == t then
                table.remove(self.flying, i)
                s.flying = nil
                break
            end
        end
        ASSERT(
            s.flying == nil,
            "[%s]: %s not found in self.flying", script_name(), s:WindowName()
        )
    end
    self.scrolled:DetachChild(s)
end

function arc_8container_menu:load_inventory()
    local idx = {}
    if self.inventory then
        for _, t in ipairs(self.inventory) do
            idx[t.id] = t
        end
    end

    -- Include all actor inventory items, but keep equipped belt artifacts out.
    local belt_ids = {}
    for _, ids in pairs(sak_inventory.belt_items or {}) do
        for _, id in ipairs(ids) do
            belt_ids[id] = true
        end
    end

    self.inventory = {}
    local changed = false
    db.actor:iterate_inventory(
        function(npc, obj)
            if g_sim:object(obj:id())
                and not belt_ids[obj:id()]
				and (not db.actor:marked_dropped(obj))
                and obj:is_artefact()
				and obj:section() ~= "af_full_akkum"
				and obj:section() ~= "af_full_akkum_big"
				and (
					obj:section() ~= "af_dummy_black_tip"
					or not get_value( "tried_to_drop_bt", false )
				)
            --    and dsh.can_include_into_actor_items(obj) -- не нужно вроде, мб потом проверить
            --  and get_float(obj:section(), "radiation_restore_speed", 0) > 0 -- только радиактивные арты в контейнер
            then
                local t     = {}
                t.object    = obj
                t.id        = obj:id()
                t.section   = obj:section()
                t.condition = obj:condition()
                local sobj  = g_sim:object(obj:id())
                if sobj.custom_data and sobj.custom_data ~= "" then
                    t.custom_data = sobj.custom_data
                end
                table.insert(self.inventory, t)
                if idx[obj:id()] then
                    if t.condition < idx[obj:id()].condition then
                        changed = true
                    end
                    t.button = idx[obj:id()].button
                    idx[obj:id()] = nil
                else
                    changed = true
                end
            end
        end,
        db.actor
    )

    for id, t in pairs(idx) do
        local s = t.button
        self:detach_button(s)
        changed = true
    end

    table.sort(
        self.inventory,
        function(a, b)
            if a.section == b.section then
                return a.condition > b.condition
            else
                return a.section < b.section
            end
        end
    )

    return changed
end

function arc_8container_menu:load_containers()
    self.containers = {}
    db.actor:iterate_ruck(
        function(npc, obj)
            if obj:section() == self.object:section()
                and g_sim:object(obj:id())
                and (not db.actor:marked_dropped(obj))
            then
                table.insert(self.containers, obj)
            end
        end,
        db.actor
    )
    for i, obj in ipairs(self.containers) do
        if obj:id() == self.object:id() then
            if i == table.getn(self.containers) then
                self.next_n = false
            else
                self.next_n = i + 1
            end
            if i == 1 then
                self.prev_n = false
            else
                self.prev_n = i - 1
            end
            break
        end
    end
end

function arc_8container_menu:DrawBackground()
    self.xml:InitWindow("main", 0, self)
    self.xml:InitStatic("background", self)
    self.info_wnd            = self.xml:InitStatic("info_wnd", self)

    self.arts_weight         = self.xml:InitStatic("arts_weight", self)
	self.arts_weight:SetTextColor(255,238,155,23)
	self.arts_weight:SetTextAlign( CGameFont.alCenter )
	self.arts_weight:SetFont( GetFontLetterica18Russian() )

    local scroll             = self.xml:InitScrollView("scroll", self)
    self.scrolled            = self.xml:InitStatic("scrolled", scroll)
    self.min_scrolled_height = self.scrolled:GetHeight()
    --self.min_scrolled_height = 250
    local art_box            = self.xml:InitStatic("art_box", self.scrolled)

    self.btn_quit            = self.xml:InitButton("btn_quit", art_box)
	self.btn_quit:SetText( string.format( "Закрыть [%d]", self.object:id() ) )
    self:Register(self.btn_quit, self.btn_quit:WindowName())
    self:AddCallback(
        self.btn_quit:WindowName(), ui_events.BUTTON_CLICKED,
        self.on_quit, self
    )

    self.btn_prev = self.xml:InitButton("btn_prev", art_box)
    self:Register(self.btn_prev, self.btn_prev:WindowName())
    self:AddCallback(
        self.btn_prev:WindowName(), ui_events.BUTTON_CLICKED,
        self.prev_container, self
    )
    self.btn_prev:Show(self.prev_n and true or false)

    self.btn_next = self.xml:InitButton("btn_next", art_box)
    self:Register(self.btn_next, self.btn_next:WindowName())
    self:AddCallback(
        self.btn_next:WindowName(), ui_events.BUTTON_CLICKED,
        self.next_container, self
    )
    self.btn_next:Show(self.next_n and true or false)
end

function arc_8container_menu:draw_weight()
    local sum_weight_arts = 0
    for i, t in ipairs(self.artefacts) do
        if t.section then
            sum_weight_arts = sum_weight_arts + get_float(t.section, "inv_weight", 0)
        end
    end
    local container_weight = get_float(self.object:section(), "inv_weight", 0)
    local total_weight = container_weight + sum_weight_arts
	local text = string.format( "Артефакты: %.2f кг\n | Всего: %.2f кг", sum_weight_arts, total_weight )
    self.arts_weight:SetText(text)
    return sum_weight_arts, container_weight, total_weight
end

local goodness_data = {
    [ "dyn1d"    ] = { symbol = "•",    color = { 200, 255,   0,   0 } },
    [ "dyn2d"    ] = { symbol = "••",   color = { 200, 255, 100,   0 } },
    [ "dyn3d"    ] = { symbol = "•••",  color = { 200, 255, 255,   0 } },
    [ "dyn4d"    ] = { symbol = "••••", color = { 200, 160, 255,   0 } },
    [ "dyn5d"    ] = { symbol = "•••••",color = { 200,   0, 255,   0 } },
    [ "dyn6d"    ] = { symbol = "°",    color = { 200,   0, 255, 255 } }
}

function arc_8container_menu:get_goodness_symbol(section)
    if strpos(section, "capsule", 1, true) then
        return "", {255, 255, 255, 255}
    end

    for key, data in pairs(goodness_data) do
        if strpos(section, key, 1, true) then
            return data.symbol, data.color
        end
    end
end

function arc_8container_menu:make_art_button(t, act)
    local s = self.xml:InitStatic("art_" .. act, self.scrolled)
    local b = self.xml:InitButton("art_button_" .. act, s)
    s.button = b
    CIconParams(t.section):set_shader(b)

    local rad_text = ""
    if t.condition > 0 then
		local base_rrs = nominal_art_property(t.section, "radiation_restore_speed", t.custom_data)
		local rad = base_rrs * get_effective_strength_raw(t.condition, t.section, base_rrs < 0, "radiation_restore_speed")
        if rad > 0 then
            rad_text = string.format("+%.0f", rad / radiation_v)
            b:SetText(rad_text)
            b:SetTextAlign(0)   -- слева
            b:SetVTextAlign(0)  -- сверху
        end
    end

    local p = self.xml:InitProgressBar("condition_progess_bar_" .. act, s)
    s.progress = p
    p:SetProgressPos(t.condition * 100)

    local symbol, color = self:get_goodness_symbol(t.section)
    if symbol ~= "" and symbol ~= nil then
        if rad_text ~= "" then
            b:SetText(rad_text .. " " .. symbol)
        else
            b:SetText(symbol)
        end
        b:SetTextY(-4)
        b:SetTextColor(unpack(color))
    end

    return s
end

function arc_8container_menu:get_target_xy(k, pos)
    local m = self.menu_cfg[k]
    local x = m.x_start + (m.space_x * math.fmod(pos - 1, m.row_size))
    local y = m.y_start + (m.space_y * math.floor((pos - 1) / m.row_size))
    return x, y
end

--\\-- Функции ДИША !!!

function put_in_art(id, art_section, condition, cust)
   -- local sobj = level.object_by_id(id)
	local box = level.object_by_id(id)
    if not box then 
        log3("! контейнер " .. id .. " не найден")
        return false 
    end

    local pk = get_netpk(box)
    local box_data = pk:get()
    local sect = box:section()
    local slots = get_u32(sect, "container_slots") or 8

    local arts = arc_radiation.decode_custom_data(
        box_data.custom_data, sect, slots
    )
	
    -- ищем свободный слот
    local free_slot = nil
    for i = 1, slots do
        if not arts[i] or not arts[i].section then
            free_slot = i
            break
        end
    end

    if not free_slot then
        log3("! нет свободных слотов в " .. id .. " (" .. slots .. " слотов)")
        return false
    end

    -- добавляем
    arts[free_slot] = {
        section   = art_section,
        condition = condition,
		custom_data = cust ~= nil and cust or nil
    }

    -- сохраняем обратно
    box_data.custom_data = arc_radiation.encode_custom_data(
        arts, sect, slots
    )
    pk:set(box_data)

    log3("+ добавлен %s (%.3f) в слот %d контейнера %d", 
         art_section, condition, free_slot, id)

	arc_recalc_container(id)
    
    return true
end

