function put_out_art(id, slot, art_section, condition)
    local box = level.object_by_id(id)
    if not box then return false end

    local pk = get_netpk(box)
    local box_data = pk:get()
    local sect = box:section()
    local slots = get_u32(sect, "container_slots") or 8

    local arts = arc_radiation.decode_custom_data(box_data.custom_data, sect, slots)
    local removed = false

    if slot then
        -- Удаляем строго по слоту, без проверки секции или условия
        if slot < 1 or slot > slots then
            log3("Неверный слот: %d", slot)
            return false
        end

        if not arts[slot] or next(arts[slot]) == nil then
            log3("Слот %d уже пустой", slot)
            return false
        end

        local name = arts[slot].section or "неизвестный"
        arts[slot] = {}
        removed = true
        log3("- удалён %s из слота %d", name, slot)

    else
        -- Итерируем по слотам, ищем по секции и условию
        for i = 1, slots do
            if arts[i] and arts[i].section == art_section then
                if not condition or (arts[i].value and arts[i].value >= condition) then
                    local name = arts[i].section
                    arts[i] = {}
                    removed = true
                    log3("- удалён %s из слота %d", name, i)
                    break
                end
            end
        end

        if not removed then
            log3("артефакт " .. art_section .. " не найден")
            return false
        end
    end

    box_data.custom_data = arc_radiation.encode_custom_data(arts, sect, slots)
    pk:set(box_data)

    arc_recalc_container(id)
    return true
end

function arc_recalc_container(id)
    local obj = level.object_by_id(id)
    if not obj then return end

    local sobj = g_sim:object(id)
    if not sobj then return end
    local sect  = sobj:section_name()
    local slots = get_u32(sect, "container_slots") or 8

    local arts = arc_radiation.decode_custom_data(
        sobj.custom_data, sect, slots
    )
    local rad, sum_weight, count = arc_radiation.calc_container(sect, arts)

    local iitem = obj:get_inventory_item()
    if iitem then
        iitem.inv_weight = get_float(sect, "inv_weight", 0) + sum_weight
        iitem.radiation_restore_speed = rad
    end

    arc_radiation.register_item(id, rad)

    if count > 0 then
        set_item_ungroupable(obj)
    else
        set_item_default_grouping(obj)
    end
end

function arc_count_slots(decode)
    local used = 0
    for _, t in ipairs(decode) do
        if t.section then
            used = used + 1
        end
    end
    return used
end

