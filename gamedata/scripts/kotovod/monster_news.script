-- [HE-PORT] Ported from Old HE: tells the encounter channel when a monster dies.
-- The order logic lives in news/news_encounters.script.
function attach(sm)
	sm:subscribe({ signal = "on_monster_death", fun = this.on_monster_death })
end

function on_monster_death(victim, who)
	if victim and olr_cfg.on("enc_channel") then
		news_encounters.on_target_death(victim, who)
	end
end
