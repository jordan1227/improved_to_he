-- ===== ”ниверсальное замедление √√ (маски, еда, бинты и т.п.; можно подвз¤ать на что угодно по идее - какие-то абилки мутантов в bind_monster, например) =====
local move_penalties = {} -- [name] = coef (0..1)
local MOVE_PENALTY_FLOOR = 0.2 -- нижний предел суммарного коэффициента, чтобы несколько штрафов разом не занулили скорость

function add_move_penalty(name, coef)
	local old_coef = get_move_penalty_coef()
	move_penalties[name] = coef
	local new_coef = get_move_penalty_coef()
	-- масштабируем “≈ ”ў»… speed_multiplier напр¤мую Ч не форсируем check_artefact(),
	-- он может попасть на переходное состо¤ние (напр. во врем¤ смены предмета/маски)
	-- и временно занулить артефактный бонус до следующего планового пересчЄта
	db.actor.speed_multiplier = db.actor.speed_multiplier / old_coef * new_coef
end

function remove_move_penalty(name)
	if move_penalties[name] then
		local old_coef = get_move_penalty_coef()
		move_penalties[name] = nil
		local new_coef = get_move_penalty_coef()
		db.actor.speed_multiplier = db.actor.speed_multiplier / old_coef * new_coef
	end
end

function get_move_penalty_coef()
	local total = 1
	for _, coef in pairs(move_penalties) do
		total = total * coef
	end
	if total < MOVE_PENALTY_FLOOR then total = MOVE_PENALTY_FLOOR end
	return total
end
--=====================
--Для апдейта веса цифры в инвентаре когда цепим арты на пояс
--=====================
function attach(sm)
    sm:subscribe({ signal = "on_item_to_ruck",   fun = sivol_on_belt_leave })
    sm:subscribe({ signal = "on_drop_before_all", fun = sivol_on_belt_leave })
    sm:subscribe({ signal = "on_spawn",          fun = sivol_on_actor_spawn })
end

function sivol_on_actor_spawn()
    dsh.exec_on_update(
        function()
            local sm = ogse_signals.get_mgr()
            sm:subscribe({ signal = "on_item_to_belt", fun = sivol_on_belt_enter })
        end
    )
end

function sivol_on_belt_enter(obj)
    if obj and obj:clsid() == CLID_ART then
        scale_artefact_stats(obj, false)   -- apply condition+bonus scaling immediately
        update_inventory_window()
    end
end

function sivol_on_belt_leave(obj)
    if obj and obj:clsid() == CLID_ART then
        scale_artefact_stats(obj, true)    -- reset to base, matches off-belt behavior in check_artefact()
        update_inventory_window()
    end
end

-- ===== ¬–≈ћ≈ЌЌџ… “≈—“ cant_sprint / cant_walk Ч удалить после проверки =====

function test_cant_status()
	wprintf("~C0E #TEST: cant_sprint =~C0D %s ~C0E, cant_walk =~C0D %s ~C07",
		tostring(db.actor.cant_sprint), tostring(db.actor.cant_walk))
end

function test_cant_sprint_on()
	db.actor.cant_sprint = true
	wprintf("~C0A #TEST: cant_sprint SET to true~C07")
end

function test_cant_sprint_off()
	db.actor.cant_sprint = false
	wprintf("~C0A #TEST: cant_sprint SET to false~C07")
end

function test_cant_walk_on()
	db.actor.cant_walk = true
	wprintf("~C0A #TEST: cant_walk SET to true~C07")
end

function test_cant_walk_off()
	db.actor.cant_walk = false
	wprintf("~C0A #TEST: cant_walk SET to false~C07")
end

-- проверка: не сбрасываетс¤ ли флаг сам по себе через какое-то врем¤
function test_cant_sprint_persistence()
	db.actor.cant_sprint = true
	wprintf("~C0A #TEST: cant_sprint SET true, checking persistence over 5s...~C07")
	schedule.add("test_cant_check", "sivol.test_cant_status()", 1000)
	schedule.add("test_cant_check2", "sivol.test_cant_status()", 5000)
end

function test_basic()
       wprintf("BASIC TEST FIRED")
end
