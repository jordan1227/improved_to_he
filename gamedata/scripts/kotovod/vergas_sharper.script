-- Vergas and the sharpener: hand it over once, get cheaper and faster knife
-- repair for good; later he can teach the player (skill +0.2 of the 0.4 cap).
-- Keep it ASCII-only. Dialogs (config/gameplay/dialogs_escape.xml): esc_vergas_sharper_hint,
-- esc_vergas_sharper_offer and esc_vergas_sharper_lesson, bound to esc_vergas only,
-- so the quest ends by itself when he moves to the Radar and becomes rad_vergas
-- (who has no such dialogs). No time limit before that.
--
-- HINT    needs: met Vergas (esc_vergas_new_gg), early hunter quest done
--                (tm_kill_stalker_1_done). No sharpener needed. Sets
--                "vergas_sharper_hinted": tells the player it is an option and that
--                the sharpener has to be in good condition.
-- OFFER   needs: the hint, and a sharpener of at least MIN_CONDITION in the inventory.
--         effect: that sharpener is given away for good, info "vergas_sharper_given";
--                 knife_repair.script then halves his price, x0.6 his time, and he
--                 takes knives of any condition.
-- LESSON  needs: vergas_sharper_given and bar_darklab_document_done.
--         price: one level-1 artifact. effect: sharper_core.add_skill(LESSON_SKILL),
--                info "vergas_sharper_lesson_done".
--
-- Testing from the console: fl kotovod.give_info("esc_vergas_new_gg")
--   then "tm_kill_stalker_1_done" (hint + offer), "bar_darklab_document_done" (lesson).

local MIN_CONDITION = 0.75    -- a worn-out sharpener is not accepted
local LESSON_SKILL  = 0.2

-- a sharpener in the inventory that is good enough, or nil
local function good_sharper()
	local items = get_shadow_inv():get_content( true )
	for _, rec in items:ipairs() do
		if rec.sect == "sharper" and rec.obj and rec.obj:condition() >= MIN_CONDITION then
			return rec.obj
		end
	end
	return nil
end

-- dialog precondition: the player carries a good enough sharpener
function can_offer()
	return good_sharper() ~= nil
end

-- dialog action: give that sharpener to Vergas
function give_sharper()
	local obj = good_sharper()
	if obj then
		misc.release_obj( obj:id(), true )
	end
end

-- dialog precondition: a level-1 artifact in good condition
function have_lvl1_art()
	return ui_barter.gg_good_artefacts_have( kotovod.tbl_arts.lvl1, 1 ) == true
end

-- dialog action: pay the artifact, get the lesson
function give_lesson()
	ui_barter.gg_good_artefacts_give( kotovod.tbl_arts.lvl1, 1 )
	sharper_core.add_skill( LESSON_SKILL )
end
