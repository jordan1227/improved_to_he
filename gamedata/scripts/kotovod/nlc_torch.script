-- ============================================================================
-- MODULE: nlc_torch.script (Unified Flashlight System)
-- ============================================================================
-- OVERVIEW:
--    Unified headlamp and flashlight management system (merged dsh_torch + 
--    kotovod/nlc_torch). Controls dual-mode lighting (Near/Far beam), item
--    condition decay, dynamic visual scaling (range, spread, color temperature,
--    flicker), upgraded torch progression, and Electra anomaly electromagnetic 
--    interference.
--
-- KEY RESPONSIBILITIES:
--    1. Dual-Mode Cone Control: Toggles between Near (wide beam, low range) 
--       and Far (narrow beam, high range) torch modes with animation lock.
--    2. Condition-Based Visual Scaling: Dynamically scales light distance, cone 
--       angle, color temperature, and random low-battery flickering based on 
--       slot item condition (0.0 to 1.0).
--    3. Periodic Battery Drain: Periodically degrades flashlight item condition 
--       every 5 seconds, scaling with mode (near vs far), upgrade tier, and 
--       location-based modifiers (e.g., Aver map drain boost).
--    4. Electra Anomaly Electromagnetic Glitch: Intercepts PDA glitch intensity 
--       metrics from sivol_pda.script to simulate voltage drops, rapid dimming, 
--       and dark blackout spikes when near Electras.
--    5. Save/Load Persistence & Safety Net: Maintains persistent torch state and 
--       upgrade status across save loads with asynchronous initialization fallbacks.
--
-- CONNECTED SYSTEMS & DEPENDENCIES:
--    [Engine & Slot Bindings]
--      - Actor Item Slot 9 : Expects a flashlight item object (is_torch()).
--      - Engine Flashlight : Drives C++ torch methods (set_range, set_angle, 
--                            set_brightness, set_rgb, enable, switch).
--
--    [Script Integrations]
--      - bind_stalker.script / Signal Manager : Subscribes to signals: on_save, 
--                            on_first_update, on_late_init_all, on_update.
--      - sivol_pda.script  : Reads sivol_pda.get_glitch_intensity() for Electra 
--                            interference data.
--      - dsh.script        : Uses dsh.timeout() for non-blocking state delays.
--      - ogse_signals / sm : Handles signal-driven updates and persistence callbacks.
--
--    [Assets & Resources]
--      - Sounds    : sound_object("device\\light_on")
--      - HUD Anims : game.play_hud_motion("anim_headlamp", "anm_switch")
--      - Effectors : camera_effects\headlamp_cam.anm
-- ============================================================================

-- -*- mode: lua; coding: windows-1251-dos -*-
-- nlc_torch.script — unified flashlight (merged dsh_torch.script + kotovod/nlc_torch.script)

-- ===== BASE LIGHTING & BATTERY CONFIGURATION =====
local TORCH_MIN_BRIGHTNESS              = 0.01   -- Min brightness multiplier at 0% battery condition (normalized float: 0.0 to 1.0)
local TORCH_MAX_BRIGHTNESS              = 1.0    -- Max brightness multiplier at 100% battery condition (normalized float: 0.0 to 1.0)
local TORCH_DISCHARGE_RATE              = 0.0015 -- Base condition loss per 5s tick (~0.15% condition per tick; ~55 mins total lifespan)
local TORCH_FLICKER_PROBABILITY_BASE    = 0.01   -- Base chance (1%) of random low-battery flickering on fully charged battery
local TORCH_FLICKER_PROBABILITY_FACTOR  = 0.25   -- Max additional flicker chance added as battery depletes (+25% chance at 0% condition)
local TORCH_COLOR_TEMP_MIN              = 0.7    -- Warmest RGB color temp multiplier at 0% condition (duller, reddish/yellow tint)
local TORCH_COLOR_TEMP_MAX              = 1.0    -- Neutral RGB color temp multiplier at 100% condition (bright neutral white)
local TORCH_ANGLE_FACTOR_MIN            = 0.9    -- Min beam angle scaling factor when battery is nearly dead
local TORCH_ANGLE_FACTOR_MAX            = 1.1    -- Max beam angle scaling factor when battery is fully charged
local TORCH_UPDATE_TIME_BASE            = 5000   -- Battery condition discharge update interval in milliseconds (5000 ms = 5 seconds)
local TORCH_DEVICE_ANIM_LOCK            = 800    -- Input lock in ms while the engine plays the held item's device animation (no motion length available to Lua)

-- ===== upgraded torch (from dsh_torch) — TUNE THESE, not verified in-game =====
local UPGRADED_RANGE_MULT       = 1.5   -- dsh_torch: near 20->30 (1.5x), far 50->70 (1.4x) — using 1.5x for both as a starting point
local UPGRADED_ANGLE_MULT       = 1.1   -- dsh_torch: near 80->90deg, far 45->55deg (roughly wider when upgraded)
local UPGRADED_DISCHARGE_MULT   = 1.0    -- Battery drain multiplier for upgraded torch (1.0 = standard 100% discharge rate)
local BASE_DISCHARGE_MULT       = 0.75   -- Battery drain multiplier for stock starter torch (0.75 = 25% slower discharge)
local AVER_DISCHARGE_MULT       = 4.0    -- Map-specific battery drain multiplier when on the 'Aver' map (4.0 = 4x faster discharge)

-- ===== ELECTRA ANOMALY FLICKER TUNING =====
local ELECTRA_DIM_FACTOR          = 0.8    -- Base dimming factor under Electra interference (higher = deeper drop in light output)
local ELECTRA_SPIKE_FACTOR        = 1.25   -- Severity multiplier for sudden blackout spikes (higher = harsher temporary cutouts)
local ELECTRA_SPIKE_COOLDOWN_MIN  = 125    -- Min delay between sharp voltage spikes in ms (lower = more frantic/frequent flickering)
local ELECTRA_SPIKE_COOLDOWN_MAX  = 575    -- Max delay between sharp voltage spikes in ms
local ELECTRA_SMOOTH_IN           = 4.0    -- Smoothing rate for rapid onset of Electra glitching when approaching anomaly
local ELECTRA_SMOOTH_OUT          = 1.5    -- Smoothing rate for light recovery when stepping away from anomaly
local ELECTRA_TICK_TIME           = 100    -- Electra flicker update frequency in milliseconds (100 ms = 10 updates per second)

-- ===== RUNTIME STATE VARIABLES =====
local torch_mode           = "off"   -- Active mode state ("off", "near", "far"); kept in sync with set_value("nlc_torch_state")
local upgraded_torch       = false   -- Boolean tracking whether the actor holds the upgraded torch status
local base_brightness      = 1.0     -- Cached normalized float brightness (0.0-1.0) serving as baseline for Electra flickering
local torch_glitch_smooth  = 0       -- Current exponentially smoothed Electra glitch intensity value (0.0 to 1.0)
local last_battery_tick    = 0       -- Timestamp (time_global) of the last 5-second battery discharge tick
local last_electra_tick_time = 0     -- Timestamp (time_global) of the last Electra flicker calculation tick
local last_electra_tick    = 0       -- Timestamp tracking frame delta time (dt) for Electra exponential smoothing calculations
local last_spike_time      = 0       -- Timestamp tracking when the last Electra brightness drop spike occurred
local lvl                  = string.lower(level.name())
local cached_is_aver       = lvl == "aver"
local cached_is_underground = const.ground_levels and const.ground_levels[lvl] == false or false
local torch_busy           = false   -- Prevents input spam while torch animation is playing
torch_switch_guard         = false   -- Prevents infinite recursion when reasserting torch state
local cached_torch_slot
local cached_torch_obj
local torch_cache_dirty = true
local last_applied_brightness
local TORCH_BRIGHTNESS_EPSILON = 0.002
local on_emp_malfunction

TORCH_ALT_CONTROL_MODE = true  -- false = classic short-press cycle (off->near->far->off)
                                 -- true  = short press toggles on/off, hold switches cone width
                                 -- exposed as nlc_torch.TORCH_ALT_CONTROL_MODE for a future settings hook

-- ===== location-based torch interference =====

-- Underground labs get rare, random horror dim-outs instead of a constant buzz
local TORCH_LOC_FLICKER_FX = {
    min_interval = 30000,  -- 30 seconds minimum between events
    max_interval = 90000,  -- 90 seconds maximum between events
    min_duration = 1750,   -- flicker lasts at least 1.75s
    max_duration = 4250,   -- flicker lasts at most  4.25s
    intensity = 0.875,     -- how hard it dims during the event (0.0-1.0)
}

local is_loc_flickering = false
local loc_flicker_start = 0
local loc_flicker_duration = 0
local next_loc_flicker_time = math.random(30000, 90000)

local function is_underground()
    return cached_is_underground
end

local function get_torch_location_baseline()
    if not cached_is_aver then return 0 end

    local base = sivol_emp_config.TORCH_AVER_FLICKER or 0
    local shield = (sivol_pda and sivol_pda.get_artifact_shield and sivol_pda.get_artifact_shield()) or 0
    return base * (1 - shield)
end

local function refresh_level_cache()
    lvl = string.lower(level.name())
    cached_is_aver = lvl == "aver"
    cached_is_underground = const.ground_levels and const.ground_levels[lvl] == false or false
end

local function invalidate_torch_cache()
    torch_cache_dirty = true
end

local function refresh_torch_cache()
    if not torch_cache_dirty then return end
    torch_cache_dirty = false
    cached_torch_slot = db.actor and db.actor:item_in_slot(9) or nil
    if not (cached_torch_slot and cached_torch_slot:is_torch()) then
        cached_torch_slot, cached_torch_obj = nil, nil
        upgraded_torch = false
        last_applied_brightness = nil
        return
    end

    cached_torch_obj = get_torch_obj(cached_torch_slot)
    local is_powerful = false
    local pk = get_netpk(cached_torch_slot, 1)
    if pk then
        local data = pk:get()
        is_powerful = data and data.custom_data
            and string.find(tostring(data.custom_data), "powerful_torch") ~= nil or false
    end
    upgraded_torch = is_powerful
    last_applied_brightness = nil
end

local function get_cached_torch()
    refresh_torch_cache()
    return cached_torch_slot, cached_torch_obj
end

local function set_torch_brightness(torch_obj, value)
    if not torch_obj then return end
    if not last_applied_brightness
        or math.abs(value - last_applied_brightness) > TORCH_BRIGHTNESS_EPSILON then
        torch_obj:set_brightness(value)
        last_applied_brightness = value
    end
end

local click_snd = sound_object("device\\light_on")

local wpn_flags = {
    [global_flags.eFire]    = true,
    [global_flags.eFire2]   = true,
    [global_flags.eReload]  = true,
    [global_flags.eShowing] = true,
    [global_flags.eSwitch]  = true,
    [global_flags.eMisfire] = true,
    [global_flags.eHiding]  = true,
}

-- [HE-PORT]
function torch_apply_state( torch, on_off )
	torch.disable_switch = false
	nlc_torch_script_switch = true
	torch:enable( on_off )
	nlc_torch_script_switch = false
end

-- [HE-PORT]
function has_weapon_in_hands()
	local wpn = db.actor:active_item()
	return wpn and wpn:is_weapon()
end

-- [HE-PORT]
function engine_plays_device_anim()
	return db.actor:active_item() ~= nil
end

-- [HE-PORT]
function lock_torch_input()
	torch_busy = true
	dsh.timeout( TORCH_DEVICE_ANIM_LOCK, function() torch_busy = false end )
end

-- The held-item device animation does not include the scripted camera sway.
-- Keep the sway separate so both the engine and HUD-motion paths can use it.
function play_torch_cam_sway()
	level.add_cam_effector("camera_effects\\headlamp_cam.anm", 7539, false, "", 0, false)
end

-- [HE-PORT]
function on_before_switch_torch()
	if nlc_torch_script_switch then return end
	local _, torch_obj = get_cached_torch()
	if db.actor:alive() and torch_obj then
		torch_obj.disable_switch = true
	end
end

function attach(sm)
    sm:subscribe({ signal = "on_save",          fun = on_save })
    sm:subscribe({ signal = "on_first_update",   fun = on_first_update })
    sm:subscribe({ signal = "on_late_init_all",  fun = on_late_init_all })
    sm:subscribe({ signal = "on_update",         fun = update })
    sm:subscribe({ signal = "on_before_switch_torch", fun = on_before_switch_torch })
    sm:subscribe({ signal = "on_emp_malfunction", fun = on_emp_malfunction })
    sm:subscribe({ signal = "on_spawn", fun = function()
        refresh_level_cache()
        invalidate_torch_cache()
    end })
    sm:subscribe({ signal = "on_item_to_slot", fun = invalidate_torch_cache })
    sm:subscribe({ signal = "on_item_to_ruck", fun = invalidate_torch_cache })
    sm:subscribe({ signal = "on_drop_after_all", fun = invalidate_torch_cache })
end

-- ============ persistence (dsh_torch mechanism, kept as safety net) ============
function on_save()
    set_value(script_name() .. ".save_torch_mode", torch_mode)
end

local restored = false
local function restore_torch_state()
    if restored then return end
    restored = true
    local var = get_value(script_name() .. ".save_torch_mode") or get_value("dsh_torch.save_torch_mode") or get_value("nlc_torch_state")
    upgraded_torch = get_value("upgraded_torch", false)
    if not var then return end
    local _, torch = get_cached_torch()
    if not torch then return end
    if var == "near" then
        set_near_mode(torch)
    elseif var == "far" then
        set_far_mode(torch)
    else
        set_off_mode(torch)
    end
end

function on_first_update()
    restore_torch_state()
end

function on_late_init_all()
    dsh.timeout(500, restore_torch_state)  -- nlc_torch's delay, kept as a fallback in case on_first_update fires before the torch is actually in-slot
end

-- ============ upgraded torch ============
function set_upgraded_torch()
    set_value("upgraded_torch", true)
    upgraded_torch = true
end

-- ============ mode switching ============
function reassert_torch_state()
    local _, t_obj = get_cached_torch()
    if not t_obj then return end

    -- Set guard to true so this enable() call doesn't trigger another reassert
    torch_switch_guard = true
    if torch_mode == "off" then
        torch_apply_state( t_obj, false )
    else
        torch_apply_state( t_obj, true )
        update_torch_parameters()
    end
    torch_switch_guard = false
end

function switch_torch()
    if level.main_input_receiver() then return end
    if not db.actor:alive() then return end
    if torch_busy then return end

    local torch = db.actor:item_in_slot(9)
    if not (torch and torch:is_torch()) then return end
    local wpn = db.actor:active_item()
    if wpn and wpn:is_weapon() and wpn_flags[wpn:get_hud_item_state()] then return end

    click_snd:play(db.actor, 0, sound_object.s2d)

    local state = get_value("nlc_torch_state", "off")
    local next_state

    if TORCH_ALT_CONTROL_MODE then
        -- toggle: on <-> off, restoring whichever cone was last used
        next_state = (state == "off") and get_value("nlc_torch_last_cone", "near") or "off"
    else
        -- classic cycle
        if state == "off" then next_state = "near"
        elseif state == "near" then next_state = "far"
        else next_state = "off" end
    end

    torch_mode = next_state
    set_value("nlc_torch_state", next_state)
    if next_state ~= "off" then
        set_value("nlc_torch_last_cone", next_state)
    end

    reassert_torch_state()
    if engine_plays_device_anim() then
        play_torch_cam_sway()
        lock_torch_input()
    else
        play_torch_anim()
    end
end

-- Hold: only meaningful in alt control mode. Switches near/far regardless of on/off.
function torch_switch_cone_hold()
    if not TORCH_ALT_CONTROL_MODE then return end
    if level.main_input_receiver() then return end
    if not db.actor:alive() then return end
    if torch_busy then return end

    local torch = db.actor:item_in_slot(9)
    if not (torch and torch:is_torch()) then return end
    local wpn = db.actor:active_item()
    if wpn and wpn:is_weapon() and wpn_flags[wpn:get_hud_item_state()] then return end

    local state = get_value("nlc_torch_state", "off")
    local last_cone = get_value("nlc_torch_last_cone", "near")
    local new_cone = (last_cone == "near") and "far" or "near"
    set_value("nlc_torch_last_cone", new_cone)

    click_snd:play(db.actor, 0, sound_object.s2d)

    if state == "off" then
        -- Changing the remembered cone while the torch is off still needs the
        -- same visual feedback as an active cone switch.
        if engine_plays_device_anim() then
            play_torch_cam_sway()
            lock_torch_input()
        else
            play_torch_anim()
        end
        return  -- light stays off; only the remembered cone changes for next time on
    end

    torch_mode = new_cone
    set_value("nlc_torch_state", new_cone)
    reassert_torch_state()
    if engine_plays_device_anim() then
        play_torch_cam_sway()
        lock_torch_input()
    else
        play_torch_anim()
    end
end

function set_near_mode(torch)
    torch_mode = "near"
    set_value("nlc_torch_state", "near")
    set_value("nlc_torch_last_cone", "near")   -- ADDED
    torch_apply_state( torch, true )
    update_torch_parameters()
end

function set_far_mode(torch)
    torch_mode = "far"
    set_value("nlc_torch_state", "far")
    set_value("nlc_torch_last_cone", "far")    -- ADDED
    torch_apply_state( torch, true )
    update_torch_parameters()
end

function set_off_mode(torch)
    log2("[%s] enable(false) called from set_off_mode", tostring(time_global()))
    torch_mode = "off"
    torch_apply_state( torch, false )
    set_value("nlc_torch_state", "off")
end

-- ============ per-parameter update (range/angle/brightness/color/flicker) ============
function update_torch_parameters()
    local slot, torch_obj = get_cached_torch()
    if not (slot and torch_obj) then return end

    local torch_cond = slot:condition()
    local is_powerful = upgraded_torch

    -- Restore old exact values for base_range/base_angle
    local base_range = is_powerful and 45 or 30
    local base_angle = is_powerful and math.rad(85) or math.rad(60)

    -- Restore old brightness and range_factor math
    local brightness = TORCH_MIN_BRIGHTNESS + torch_cond ^ 0.7 * (TORCH_MAX_BRIGHTNESS - TORCH_MIN_BRIGHTNESS)
    if is_powerful then brightness = brightness * 1.25 end

    local range_factor = 0.2 + torch_cond ^ 1.4 * 0.8

    local mode = get_value("nlc_torch_state", "off")
    local angle_factor
    if mode == "near" then
        angle_factor = TORCH_ANGLE_FACTOR_MIN + (1 - torch_cond) * (TORCH_ANGLE_FACTOR_MAX - TORCH_ANGLE_FACTOR_MIN)
    else
        angle_factor = TORCH_ANGLE_FACTOR_MAX - (1 - torch_cond) * (TORCH_ANGLE_FACTOR_MAX - TORCH_ANGLE_FACTOR_MIN)
    end

    local color_temp = TORCH_COLOR_TEMP_MIN + torch_cond * (TORCH_COLOR_TEMP_MAX - TORCH_COLOR_TEMP_MIN)

    local flicker_probability = TORCH_FLICKER_PROBABILITY_BASE + (1 - torch_cond) * TORCH_FLICKER_PROBABILITY_FACTOR
    if math.random() < flicker_probability then
        brightness = brightness * math.random(2, 8) / 10
    end

    local mode_switch = (mode == "near" and 1) or 2
    local range = base_range * range_factor * mode_switch
    local angle = base_angle * angle_factor / mode_switch

    torch_obj:set_range(range)
    torch_obj:set_angle(angle)

    local final_brightness = brightness -- Use 0.0-1.0 float scale, as dsh_torch did
    set_torch_brightness(torch_obj, final_brightness)
    base_brightness = final_brightness

    local r, g, b = color_temp, color_temp * 0.95, color_temp * 0.9
    torch_obj:set_rgb(r, g, b)
end

-- ============ battery drain (5s tick, folds in dsh_torch's upgraded/aver modifiers) ============
function torch_brock()
    local slot, torch_obj = get_cached_torch()
    if not torch_obj or not torch_obj.on then return end

    local mode = get_value("nlc_torch_state", "off")
    local mode_mult   = (mode == "near" and 1) or 1.25
    local upgrade_mult = upgraded_torch and UPGRADED_DISCHARGE_MULT or BASE_DISCHARGE_MULT
    local level_mult   = (lvl == "aver") and AVER_DISCHARGE_MULT or 1.0

    local torch_cond = slot:condition()
    local val = torch_cond - (TORCH_DISCHARGE_RATE * mode_mult * upgrade_mult * level_mult)
    local condition = math.max(0, val)
    slot:set_condition(condition)

    if condition <= 0 then
        set_off_mode(torch_obj)
        return
    end

    update_torch_parameters()
end

function update_torch(cond)
    local slot = get_cached_torch()
    if slot then
        slot:set_condition(cond)
        update_torch_parameters()
    end
end

-- ============ electra flicker ============

on_emp_malfunction = function(kind, intensity)
    local _, torch_obj = get_cached_torch()
    if not (torch_obj and torch_obj.on) then return end
    local resistance = upgraded_torch and sivol_emp_config.POWERFUL_TORCH_EMP_RESISTANCE or 0
    if intensity * (1 - resistance) < sivol_emp_config.TORCH_MALFUNCTION.threshold then return end
    local mode = get_value("nlc_torch_state", "off")
    if mode == "off" then return end

    if kind == "shutdown" then
        set_off_mode(torch_obj)
    elseif mode == "near" then
        set_far_mode(torch_obj)
    else
        set_near_mode(torch_obj)
    end
end

local function electra_torch_tick()
    local _, torch_obj = get_cached_torch()
    if not (db.actor:alive() and torch_obj) then return end
    if not torch_obj.on then
        torch_glitch_smooth = 0
        return
    end

    local now = time_global()
    local dt = math.min(1, (now - last_electra_tick) / 1000)
    last_electra_tick = now

    if sivol_critical_malfunction and sivol_critical_malfunction.is_device_active("torch") then
        set_torch_brightness(torch_obj, 0.01)  -- power failure, not a mode change — recovers on its own
        return
    end

    local target = (sivol_pda and sivol_pda.get_glitch_intensity and sivol_pda.get_glitch_intensity()) or 0
    target = math.max(target, get_torch_location_baseline())
    if upgraded_torch then
        target = target * (1 - sivol_emp_config.POWERFUL_TORCH_EMP_RESISTANCE)
    end

    -- Underground rare event state machine
    if is_underground() then
        if is_loc_flickering then
            -- Event is active: check if it should end
            if now - loc_flicker_start > loc_flicker_duration then
                is_loc_flickering = false
                next_loc_flicker_time = now + math.random(
                    TORCH_LOC_FLICKER_FX.min_interval,
                    TORCH_LOC_FLICKER_FX.max_interval
                )
            else
                -- During the event, apply a chaotic random pattern on top of the electra target
                local pattern_mult = math.random(4, 10) / 10
                target = math.max(
                    target,
                    TORCH_LOC_FLICKER_FX.intensity * pattern_mult
                )
            end
        else
            -- Event is dormant: check if it should start
            if now > next_loc_flicker_time then
                is_loc_flickering = true
                loc_flicker_start = now
                loc_flicker_duration = math.random(
                    TORCH_LOC_FLICKER_FX.min_duration,
                    TORCH_LOC_FLICKER_FX.max_duration
                )
            end
        end
    else
        -- Reset state machine if player leaves the underground
        is_loc_flickering = false
        next_loc_flicker_time = now + math.random(
            TORCH_LOC_FLICKER_FX.min_interval,
            TORCH_LOC_FLICKER_FX.max_interval
        )
    end

    local rate = (target > torch_glitch_smooth)
        and ELECTRA_SMOOTH_IN
        or ELECTRA_SMOOTH_OUT

    local k = math.min(1, dt * rate)
    torch_glitch_smooth = torch_glitch_smooth + (target - torch_glitch_smooth) * k

    if torch_glitch_smooth < 0.005 then
        torch_glitch_smooth = 0
    end

    if torch_glitch_smooth <= 0.005 then
        set_torch_brightness(torch_obj, base_brightness)
        return
    end

    local dim = 1 - torch_glitch_smooth * ELECTRA_DIM_FACTOR

	local cooldown_base = ELECTRA_SPIKE_COOLDOWN_MAX
		- (ELECTRA_SPIKE_COOLDOWN_MAX - ELECTRA_SPIKE_COOLDOWN_MIN)
		* torch_glitch_smooth

	local cooldown = cooldown_base * (math.random(65, 145) / 100)  -- ±35% jitter breaks the metronome

	if now - last_spike_time > cooldown then
		last_spike_time = now
		dim = dim * (
			1 - torch_glitch_smooth
				* ELECTRA_SPIKE_FACTOR
				* (math.random(6, 10) / 10)
		)
	end

    set_torch_brightness(torch_obj, math.max(0.01, base_brightness * dim))
end

-- ============ single update() — owns both cadences, no reschedule() ============
function update()
    local now = time_global()

    if now - last_battery_tick >= TORCH_UPDATE_TIME_BASE then
        last_battery_tick = now
        local torch = get_cached_torch()
        if torch then
            torch_brock()
        end
    end

    if now - last_electra_tick_time >= ELECTRA_TICK_TIME then
        last_electra_tick_time = now
        electra_torch_tick()
    end
end

-- ============ misc ============
function play_torch_anim()
    torch_busy = true
    level.only_allow_movekeys(true)
    level.set_actor_allow_ladder(false)
    
    play_torch_cam_sway()
    local torch_anm_duration = game.play_hud_motion(db.actor:active_item() and 1 or 2, "anim_headlamp", "anm_switch", false, 1.1)
    
    dsh.timeout(torch_anm_duration + 10, function()
        level.only_allow_movekeys(false)
        level.set_actor_allow_ladder(true)
        torch_busy = false
    end)
end

function get_torch_state()
    local _, torch = get_cached_torch()
    return torch and torch.on or false
end

function torch_handler(flag)
    local _, torch = get_cached_torch()
    if torch then
        local state = get_value("nlc_torch_state", "off")
        
        if flag == "off" and torch.on then
            log2("[%s] enable(false) called from torch_handler", tostring(time_global()))
            -- Save the current mode so we can restore it later
            set_value("nlc_torch_prev_mode", state)
            torch_apply_state( torch, false )
            set_value("nlc_torch_state", "off")
            torch_mode = "off"
            return state
        end
        
        if flag == "on" then
            local prev_mode = get_value("nlc_torch_prev_mode", "near")
            if prev_mode ~= "off" then
                play_torch_anim()
                dsh.timeout(800, function()
                    if prev_mode == "far" then
                        set_far_mode(torch)
                    else
                        set_near_mode(torch)
                    end
                end)
            end
        end
    end
end

