function attach( sm )
	sm:subscribe({ signal = "on_late_init_all",  	fun = this.on_late_init_all  	})
	sm:subscribe({ signal = "on_monster_death", 	fun = this.on_monster_death  	})
	sm:subscribe({ signal = "on_monster_use", 		fun = this.on_monster_use  		})
	sm:subscribe({ signal = "on_item_to_slot",	 	fun = this.on_slot				})
	sm:subscribe({ signal = "on_item_to_ruck", 		fun = this.on_drop				})
	sm:subscribe({ signal = "on_drop_before_all", 	fun = this.on_drop				})
	-- sm:subscribe({ signal = "on_hit", 			fun = this.on_hit				})	-- Надо будет добавить стоп таймера и анимок при хите. Надо будет подписываться в нужный момент
end

