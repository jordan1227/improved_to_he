    [ "mutant_dog_tail"          ] = { 2300, 0.10, - 0.01 },    
    [ "mutant_face_tushkano"     ] = { 2500, 0.10, - 0.01 },	
    [ "mutant_zombie_hand"       ] = { 3500, 0.12, - 0.02 },	
	[ "mutant_boar_leg"          ] = { 3400, 0.12, - 0.02 },
    [ "mutant_psevdodog_tail"    ] = { 3300, 0.12, - 0.01 },
    [ "mutant_tail_cat"          ] = { 2900, 0.12, - 0.02 },	
    [ "mutant_flesh_shkura"      ] = { 5000, 0.12, - 0.03 },	
    [ "mutant_snork_leg"         ] = { 4000, 0.14, - 0.03 },
    [ "mutant_chimera_kogot"     ] = { 4000, 0.14, - 0.04 },	
    [ "mutant_flesh_eye"         ] = { 4000, 0.14, - 0.01 },
    [ "mutant_burer_hand"        ] = { 5500, 0.14, - 0.03 },	
    [ "mutant_hand_kontroler"    ] = { 5500, 0.16, - 0.04 },
    [ "mutant_krovosos_jaw"      ] = { 4500, 0.16, - 0.02 },	
    [ "mutant_poltergeist_glas"  ] = { 5000, 0.16, - 0.01 },
    [ "mutant_psevdogigant_hand" ] = { 6500, 0.18, - 0.05 },
