-- Иначе можно дваджы за раз нажать и творить грязь. Попутно словить вылет
local is_processing = false

function on_monster_use( monster, who )
    monster:set_nonscript_usable( false )

	if is_processing then return end

    if monster:object_count() == 0 then return end	

	is_processing = true

    local mutant_items, additional_items = {}, {}	
    local knife_ready = false

    -- Итерируем объекты моба и заносим по таблицам
    for i = 0, monster:object_count() - 1 do
        local item = monster:object( i )
        if item:section():sub( 1, 6 ) == "mutant" then
            table.insert( mutant_items, item )
        else
            table.insert( additional_items, item )
        end
    end
  
    -- Проверяем наличие ножа
    local function is_knife( item )
        return item and strpos( item:section(), "knife" )
    end

    local active_item = db.actor:active_item()
    local knife_slot = db.actor:item_in_slot( 0 )
    local has_knife = is_knife( active_item ) or is_knife( knife_slot )

	-- Чтобы не прописывать всюду и на разные условия. Должно быть достаточно
	dsh.timeout( 500, function() is_processing = false end )
	
    -- Если есть мутантские части, проверяем нож
    if #mutant_items > 0 then
        if has_knife then
            if not is_knife( active_item ) then
                db.actor:activate_slot( 0 )
            end
            knife_ready = is_knife( active_item )
        end

        -- Если есть нож и потроха
        if has_knife then
			-- Сразу, если нож активен или 1500 мс
			level.disable_input()
			local wait = knife_ready and 0 or 1500
			dsh.timeout( wait, function() process_monster_loot( monster, mutant_items, additional_items ) end )			
            return
        end
    end

    -- Если нет ножа и есть потроха или есть доп. вещи, тогда их и лутаем
    if not has_knife or #additional_items > 0 then 
        process_additional_items( monster, additional_items )
    end	
end

-- =========================================================
-- ADAPTIVE RAYCAST
-- =========================================================

local function cast_ray( pos, dir, range, ignore_obj )
    local rq = level.ray_query( pos, dir, range, rq_target.rqtBoth, ignore_obj )
    if not rq or not rq.result or not rq.range or rq.range > range then
        return { success = false, distance = range }
    end
    return {
        success  = true,
        distance = rq.range,
        object   = rq.object,
        element  = rq.element,
        position = vector():set( pos ):mad( dir, rq.range ),
    }
end

function get_wound_pos( range, ignore_obj, target_obj )
    local pos0 = device().cam_pos
    local dirn = vector():set( device().cam_dir ):normalize()
    local res = cast_ray( pos0, dirn, range, ignore_obj )
    if res.success and target_obj and res.object and res.object:id() == target_obj:id() then
        return res.position
    end
    return nil
end

-- =========================================================
-- PROCESS MONSTER LOOT (INTEGRATION)
-- =========================================================

function process_monster_loot( monster, mutant_items, additional_items )
    local part_to_take = mutant_items[ 1 ]
    local part_section = part_to_take:section()
    
    local knife_item = db.actor:item_in_slot( 0 )
    local knife_sect = knife_item:section()
    local active_item = db.actor:active_item()
    
    local cond_by_monster = knf_brk_k[ part_section ][ 2 ]
    local reduce_cond = knf_brk_k[ part_section ][ 3 ]
    
    local knife_cond = knife_item:condition()
    local new_cond = ( knife_sect == "wpn_knife_m1" and reduce_cond / 2 ) or reduce_cond 
    params.add_condition( active_item, new_cond )
    local will_break = knife_cond + new_cond <= 0
    
    local mut_cond = math.max( 1 - ( cond_by_monster / knife_cond ), 0.2 )
    if knife_cond >= 0.9 then mut_cond = 1 end
    
    if will_break then
        local decrease_percentage = math.random( 10, 15 ) / 100
        mut_cond = math.max( mut_cond * ( 1 - decrease_percentage), 0.1 )
    end	

    force_full_crouch( function( saved )
        prev_stance = saved

        -- 1. Perform Single Raycast to find the exact point on the monster
        local wound_pos = get_wound_pos( 3.0, db.actor, monster )
        local pitch_delta = -math.rad( 25 ) -- Fallback if ray misses
        
        if wound_pos then
            local cam_pos = device().cam_pos
            local look_dir = vector():sub( wound_pos, cam_pos )
            local target_pitch = look_dir:getP() 
            local cam = actor_camera(0)
            if cam then
                pitch_delta = target_pitch - cam.pitch
                -- Clamp to sane values so we don't break our neck if standing on the corpse
                pitch_delta = math.max( -math.rad(60), math.min( math.rad(20), pitch_delta ) )
            end
        end

        -- 2. Apply the adaptive pitch
        if not strpos( monster:name(), "burer", 1, true ) then
            ease_camera_pitch( pitch_delta, 500 )
        end

        -- 3. Apply FOV using NLC's native smooth_set_fov
        local saved_fov = db.actor:get_camera_fov()
        local LOOT_FOV = 58 -- Zoom in
        if smooth_set_fov then
            pcall(function() smooth_set_fov(LOOT_FOV, 400) end)
        else
            db.actor:set_camera_fov(LOOT_FOV)
        end

        local anim = knife_sect == "wpn_knife_m1" and "anm_mob_harvest_m1" or "anm_mob_harvest"
        local anim_duration = game.play_hud_motion( 2, anim, "anm_show", false, 1, true )	
        misc.easy_sound("interface\\item_usage\\harvest_use")

        dsh.timeout( anim_duration, function() 
            game.play_hud_motion( 2, "anm_mob_loot", "anm_show", false, 1, true )
            misc.easy_sound("interface\\item_usage\\harvest_use_success")
            sak.restore_weap()

            monster:transfer_item( part_to_take, db.actor )
            part_to_take:set_condition( mut_cond )	
            sak.relocate_item( "in", part_to_take:section(), 1 )			

            if will_break then
                misc.release_obj( knife_item )
                db.actor:drop_item( part_to_take )
                sak.send_tip( 
                    "Чёрт! Совсем нож в негодность пришёл \\nТеперь точно новый покупать...", 
                    "Мысли вслух", 0, 10, "g_g", "no", "red" 
                )
                misc.easy_sound( "scripts\\knife_broke" )
                misc.easy_sound( "scripts\\matches_no_light_2" )
            end

            -- 4. Restore FOV smoothly
            if smooth_set_fov then
                pcall(function() smooth_set_fov(saved_fov, 600) end)
            else
                db.actor:set_camera_fov(saved_fov)
            end

            -- Return camera pitch to original angle
            if not strpos( monster:name(), "burer", 1, true ) then
                ease_camera_pitch( math.abs(pitch_delta), 500 )
            end

            restore_stance( prev_stance )
            stop_loot_already()
        end ) 

        monster:set_tip_text( #mutant_items > 1 and "cut_off_part" or 
            ( #mutant_items == 1 and #additional_items > 0 and ( strpos( monster:name(), "burer_", 1, true ) 
                or strpos( monster:name(), "controller", 1, true ) ) and "%c[green]Обшарим тело" 
                or "nothing_to_cut_off" ) 
        )
    end )
end

function actor_look_at_point( target_point )
	local look_dir = vector():sub( target_point, device().cam_pos )
	local cam = actor_camera( 0 )
	if cam then
		cam.yaw   = -look_dir:getH()
		cam.pitch = -look_dir:getP()
	end
end

function process_additional_items( monster, additional_items )
    local amnt = #additional_items
	if amnt == 0 then return end
	level.disable_input()
	monster:set_tip_text( "" )

	local prev_active_slot = db.actor:active_slot()
	db.actor:activate_slot( 255 )
	
	dsh.wait_condition( function() return not db.actor:active_item() end, function()
		level.add_cam_effector( "camera_effects\\hand_help.anm", 8800, false )

		--local target_pos = monster:bone_position( "bip01_spine1" ) or monster:position()
	--	local bone_name = strpos( monster:name(), "controller", 1, true ) and "bip01_pelvis" or monster:position()
	--	local target_pos = monster:bone_position( bone_name ) or monster:position()
		-- А по факту других же и не осматриваем, смысл? Бюрер - косячные кости
		if strpos( monster:name(), "controller", 1, true ) then 
			actor_look_at_point( "bip01_pelvis" )
		end	
		--local fov = db.actor:get_camera_fov()
		--db.actor:set_camera_fov( 55 )
		--set_dof_params( 1, 1, 1, 1 )
		
		local anim_duration = game.play_hud_motion( 2, "anim_body_search", "anm_show", false, 0.5 )	
		dsh.timeout( anim_duration, function() 
			game.play_hud_motion( 2, "anim_body_search", "anm_idle", false, 1, true )				
		end )	
		
		dsh.timeout( 1800, function() 
			game.stop_hud_motion()
			game.play_hud_motion( 2, "anim_body_search", "anm_end", false, 1 )	
			for _, item in ipairs( additional_items ) do
				monster:transfer_item( item, db.actor )
				sak.relocate_item( "in", item:section(), 1 )
			end

			-- Восстанавливаем текст в зависимости от наличия мутантских частей
			if monster:object_count() > 0 then
				monster:set_tip_text( "knife_need" )
			else
				monster:set_tip_text( "nothing_to_cut_off" )
			end

			--db.actor:set_camera_fov( fov )
			--set_dof_params( 0, 0, 0, 0 )
			
			dsh.timeout( 600, function() 
				level.enable_input()
				db.actor:activate_slot( prev_active_slot )			
			end )
		end )		
	end )	
end

function stop_loot_already()
	--nlc_vars.lotted_part = nil
    if snd and snd:playing() then snd:stop() end
	level.remove_cam_effector( 8553 )	
	sak.restore_weap()
end

function spawn_item_if_met( sect, id, cond, obj )
	if math.fmod( id, cond ) == 0 then
		local spawned = misc.spawn_to( sect, obj )
		if spawned then 
			obj:set_tip_text( get_tip_text( obj, has_knife() ) )	
		else
			obj:set_tip_text( "nothing_to_cut_off" )			
		end
		-- sak.send_tip( sect, "SPAWNED IN" .. id, 0, 5, "saharov", "sak", "green" )			
	end
end

function on_monster_death( monster, who )
	if not monster then return end
	local section = monster:section()	
	local id = monster:id()
	
	if strpos( section, "controller", 1, true ) then
		arc_diary.monster_killed( monster, who )
		--sak.restore_movement()
		--sak.restore_fire()
		
		-- Чтоб уж наверняка, не знаю, иногда багует
		--schedule.add( "restore_movement", function()	
			--sak.restore_movement()
		--	sak.restore_fire()
		--end, 1000 )		
	end
	
	if strpos( section, "burer_", 1, true ) then		
		on_burer_kill( monster, who, section, id )
	end
	
	if strpos( section, "flesh_strong", 1, true ) then
		if has_alife_info( "dsc_greens_flesh_shkura" ) then
			spawn_item_if_met( "mutant_flesh_shkura", id, 2, monster )
		end
	end
	
	if strpos( section, "boar_", 1, true ) then
		spawn_item_if_met( "mutant_boar_leg", id, 10, monster )
		spawn_item_if_met( "mutant_boar_leg", id, 20, monster )
		spawn_item_if_met( "mutant_boar_leg", id, 25, monster )
	end
	
	if strpos( section, "chimera_", 1, true ) then
		spawn_item_if_met( "mutant_chimera_kogot", id, 20, monster )
		spawn_item_if_met( "mutant_chimera_kogot", id, 30, monster )
		spawn_item_if_met( "mutant_chimera_kogot", id, 40, monster )
	end
	-----------------------------------------------	
	-- В противном случае вылетает при их убийстве?
	if monster:section() == "zombie_blow" then return end
	-- и чтобы наверняка
	dsh.timeout( 500, function()
		-- Исключение для зомбей и прочих, удаляемых
		if not monster or not monster:alive() and not level.object_by_id( monster:id() ) then return end
		
		local has_items = monster:object_count() > 0
		local tip_text = "nothing_to_cut_off"

		if has_items then
			tip_text = who:is_stalker() and "%c[255,230,210,30]Убито не мной, может лучше не трогать?" or get_tip_text( monster, has_knife() )
		end

		monster:set_tip_text( tip_text )

		-- Если убила аномалия или мы, то это нет смысла обрабатывать. Для аномальки будет вылет вообще
		if who:id() == db.actor:id() or IsAnomaly( who ) then
			return
		end
		
		-- Если убил моб, то переносится ему с обновлением кондиции 
		if who:is_monster() and has_items then
			local condition = dsh.get_next_random( "kotovod.on_monster_kill_check_parts", 55, 95 ) * 0.01
			
			for i = 0, monster:object_count() - 1 do
				local item = monster:object( i )
				item:set_condition( condition )
				monster:transfer_item( item, who )
			end
			
			monster:set_tip_text( "nothing_to_cut_off" )
		end
	end )
end

local burer_items = {
    { "mutant_burer_hand",   25  },
    { "mfake_af_medus_new",  16  },
    { "mfake_af_glass_new",  14  },
    { "mfake_af_crist_new",  12  },
    { "mfake_af_flower_new", 10  },
    { "mfake_af_star_new",   8   },
    { "mfake_af_dummy_fire", 6   },
    { "mfake_af_battery",    4   },
    { "mfake_af_ice",        2   },
    { "mfake_af_sul_new",    1 },
}

function on_burer_kill( obj, who, section, id )
    local can_cut = has_knife()
    obj:set_tip_text( get_tip_text( obj, can_cut ) )

    if section == "burer_hos" then
		misc.spawn_to( "mfake_af_dummy_fire", obj )
        obj:set_tip_text( "%c[green]Обшарим тело" )
        return
    end

  --  if nlc_vars.burer_killed then return end
  --  if math.fmod( id, 6 ) ~= 0 then return end
  
	-- 20 процентов на дроп 100 % рандомной вещи, ибо эта хрень возвращает раз в пятилетку
	if dsh.get_next_random("burer_drop_chance", 1, 100) > 20 then return end

    local total = 0
    for _, v in ipairs( burer_items ) do total = total + v[ 2 ] end

    local rnd = dsh.get_next_random( "on_burer_kill", 1, total )
    local sum = 0
    for _, v in ipairs( burer_items ) do
        sum = sum + v[ 2 ]
        if rnd <= sum then
            misc.spawn_to( v[ 1 ], obj )
            --if v[ 1 ] ~= "mutant_burer_hand" then
            --    nlc_vars.burer_killed = true
            --end
            if obj:object("mutant_burer_hand") then
                obj:set_tip_text( "cut_off_part" )
            else
                obj:set_tip_text( "%c[green]Обшарим тело" )
            end
            return
        end
    end
end

function g( name )
	local sobj = g_sim:object( "burer_weak7791" )
	if sobj then 
		local ids, cnt = registry.inv_objects( sobj.id, true )
		for n = 1, cnt do
			local obj = g_sim:object( ids[ n ] )
			if obj and obj.section_name then
				log2( "we have here %s", obj:section_name() )
			end
		end	
	end
end