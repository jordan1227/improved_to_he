function attach( sm )
	sm:subscribe({ signal = "on_late_init_all",  	fun = this.on_late_init_all  	})
	sm:subscribe({ signal = "on_monster_death", 	fun = this.on_monster_death  	})
	sm:subscribe({ signal = "on_monster_use", 		fun = this.on_monster_use  		})
	sm:subscribe({ signal = "on_item_to_slot",	 	fun = this.on_slot				})
	sm:subscribe({ signal = "on_item_to_ruck", 		fun = this.on_drop				})
	sm:subscribe({ signal = "on_drop_before_all", 	fun = this.on_drop				})
	-- sm:subscribe({ signal = "on_hit", 			fun = this.on_hit				})	-- Надо будет добавить стоп таймера и анимок при хите. Надо будет подписываться в нужный момент
end

local snd 

-- Вроде работает, всяко лучше апдейта. Надо в этот блок с Сяка перетягивать он монстер десы или там доделать типсы, т.к тут мы не обрабатываем доспавненные айтемы

function on_late_init_all()
	correct_monster_tip()
end	

function get_monster_part( name )
	local ini = system_ini()
	--local part = utils.cfg_get_string( ini, name, "Spawn_Inventory_Item_Section", false, false, false, "" )	
	local part = get_string( name, "Spawn_Inventory_Item_Section" )
	return part
end

function has_knife()
    local knife = db.actor:item_in_slot( 0 )
    return knife and strpos( knife:section(), "knife" ) or false
end

function get_tip_text( obj, can_cut )
    if obj:object_count() == 0 then
        return "nothing_to_cut_off"
    end
    
    local is_special = strposx( obj:name(), "burer" ) or strposx( obj:name(), "controller" )
    
    if is_special then
        if not obj:object( get_monster_part( obj:section() ) ) or not can_cut then
            return "%c[green]Обшарим тело"
        end
        return "cut_off_part"
    end
    
    return can_cut and "cut_off_part" or "knife_need"
end

function correct_monster_tip()
	local can_cut = has_knife()
    
	for id, obj in pairs( db.creatures ) do
		if g_sim:object( id ) and obj and obj:is_monster() and not obj:alive() then
			obj:set_tip_text( get_tip_text( obj, can_cut ) )
		end
	end
end

function on_slot( obj )
	if not obj:is_knife() then return end 
	-- Как-то бы проверять был ли какой до этого, чтобы зря не гонять... 
	-- Может на спавне получить активный и с ним проверять? Но вроде все равно заранее надо, т.к при помещении в любом случае обнулится
	correct_monster_tip()
end

function on_drop( obj )
	if not obj:is_knife() then return end 
--	local slot = obj:get_slot()
--	log2( "slot is %s", slot )
--	if slot ~= 0 then return end
	-- Если дропали не со слота, то не нужно его обновлять
	if has_knife() then return end
	correct_monster_tip()
end

function on_hit( obj, amount, local_direction, who, bone_index )
	log2( string.format( "%s hitted %s with %s on %s", who:name(), obj:name(), amount, bone_index ) )
end

