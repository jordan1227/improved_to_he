	[ "mutant_boar_leg"          ] = { 3400, 0.12, - 0.02 },
    [ "mutant_psevdodog_tail"    ] = { 3300, 0.12, - 0.01 },
    [ "mutant_tail_cat"          ] = { 2900, 0.12, - 0.02 },	
    [ "mutant_flesh_shkura"      ] = { 5000, 0.12, - 0.03 },	
    [ "mutant_snork_leg"         ] = { 4000, 0.14, - 0.03 },
    [ "mutant_chimera_kogot"     ] = { 4000, 0.14, - 0.04 },	
