-- кроуч - полуприсяд, крип - глубокий
function ab()
	local aobj = get_actor_obj()
	get_actor_obj():press_action( key_bindings.kCROUCH_TOGGLE )
    dsh.timeout( 50, function()
		get_actor_obj():press_action( key_bindings.kCROUCH_TOGGLE )	
        get_actor_obj():hold_action( key_bindings.kCROUCH_TOGGLE )
		local aobj = get_actor_obj()
		if aobj:is_actor_crouch() then
			log2( "crouch" )
		end	
		if aobj:is_actor_creep() then 
			log2( "creep" )
		end			
    end )		
end

local ease_pitch_sig = nil
local ease_pitch_target = nil

local function cancel_camera_pitch_ease(complete)
	if ease_pitch_sig then
		ogse_signals.get_mgr():unsubscribe( ease_pitch_sig )
		ease_pitch_sig = nil
	end
	if complete and ease_pitch_target then
		local cam = actor_camera(0)
		if cam then cam.pitch = ease_pitch_target end
	end
	ease_pitch_target = nil
end

-- Smoothly approaches an absolute pitch so cleanup can restore the exact saved angle.
function ease_camera_pitch_to(target_pitch, duration, on_complete)
	cancel_camera_pitch_ease(false)

	local cam = actor_camera(0)
	if not cam then
		if on_complete then on_complete() end
		return
	end

	local start_pitch = cam.pitch
	ease_pitch_target = target_pitch
	local start_time = time_global()

	ease_pitch_sig = ogse_signals.get_mgr():subscribe({
		signal = "on_update",
		fun = function()
			local c = actor_camera(0)
			if not c then return end

			local elapsed = time_global() - start_time
			local progress = math.clamp(elapsed / duration, 0, 1)
			local k = progress * progress * (3 - 2 * progress)
			c.pitch = start_pitch + (target_pitch - start_pitch) * k

			if progress >= 1 then
				ogse_signals.get_mgr():unsubscribe( ease_pitch_sig )
				ease_pitch_sig = nil
				ease_pitch_target = nil
				if on_complete then on_complete() end
			end
		end
	})
end

function ease_camera_pitch(delta_rad, duration, on_complete)
	local cam = actor_camera(0)
	if not cam then
		if on_complete then on_complete() end
		return
	end
	ease_camera_pitch_to(cam.pitch + delta_rad, duration, on_complete)
end
function test_ease_pitch()
	ease_camera_pitch( -math.rad( 30 ), 500, function()
		log2("eased up, holding")
		dsh.timeout( 2200, function()
			ease_camera_pitch( -math.rad( 25 ), 500, function()
				log2("eased back down")
			end)
		end)
	end)
end

local STANCE_NORMAL = 0
local STANCE_CROUCH = 1
local STANCE_CREEP  = 2

local function get_actor_stance()
	local a = get_actor_obj()
	if a:is_actor_creep() then
		return STANCE_CREEP
	elseif a:is_actor_crouch() then
		return STANCE_CROUCH
	else
		return STANCE_NORMAL
	end
end

-- Переводит актора в крип, запоминает исходную стойку и вызывает callback(prev_stance)
-- когда переход гарантированно завершён
function force_full_crouch(callback, can_continue)
	local a = get_actor_obj()
	local prev_stance = get_actor_stance()

	if prev_stance == STANCE_CREEP then
		if callback then callback(prev_stance) end
		return prev_stance
	end

	if prev_stance == STANCE_NORMAL then
		a:press_action(key_bindings.kCROUCH_TOGGLE)          -- normal -> crouch
		dsh.timeout(50, function()
			if can_continue and not can_continue() then return end
			local aobj = get_actor_obj()
			if not aobj then return end
			aobj:press_action(key_bindings.kCROUCH_TOGGLE)   -- crouch -> creep (нажатие)
			aobj:hold_action(key_bindings.kCROUCH_TOGGLE)     -- удерживаем, чтобы остаться в крипе
			if callback then callback(prev_stance) end
		end)
	else -- STANCE_CROUCH
		a:press_action(key_bindings.kCROUCH_TOGGLE)
		a:hold_action(key_bindings.kCROUCH_TOGGLE)
		if callback then callback(prev_stance) end
	end

	return prev_stance
end

-- Возврат в исходную стойку, которую вернул force_full_crouch
function restore_stance(prev_stance)
	local a = get_actor_obj()
	if not a then return end

	if prev_stance == STANCE_CREEP then return end -- и так были там

	a:release_action(key_bindings.kCROUCH_TOGGLE) -- creep -> crouch

	if prev_stance == STANCE_NORMAL then
		dsh.timeout(50, function()
			local aobj = get_actor_obj()
			if aobj then aobj:press_action(key_bindings.kCROUCH_TOGGLE) end -- crouch -> normal
		end)
	end
end

local HARVEST_HUD_FOV_REGULAR = 0.84
local HARVEST_HUD_FOV_IMPROVED = 0.94
local HARVEST_DOF_TARGET = 0.65
local HARVEST_DOF_DELAY_MS = 250
local HARVEST_VISUAL_IN_MS = 300
local HARVEST_VISUAL_OUT_MS = 400
local HUD_FOV_EPSILON = 0.003

local HARVEST_REGULAR_SPEED = 0.95
local HARVEST_IMPROVED_SPEED = 1.10
local HARVEST_REGULAR_DELAY_MIN = 600
local HARVEST_REGULAR_DELAY_MAX = 1100
local HARVEST_IMPROVED_DELAY_MIN = 100
local HARVEST_IMPROVED_DELAY_MAX = 200
local HARVEST_COMPLEXITY_MIN = 2300
local HARVEST_COMPLEXITY_MAX = 6500
local HARVEST_TRANSITION_SOUND_DELAY_MIN = 500
local HARVEST_STOW_TRANSFER_FRACTION = 0.55
local HARVEST_STOW_DURATION_FALLBACK = 1033

local is_processing = false
local harvest_generation = 0
local harvest_state = nil
local harvest_visual = nil
harvest_diagnostics = false

local function harvest_log(fmt, ...)
	if harvest_diagnostics then log2(fmt, ...) end
end

local function smoothstep(value)
	return value * value * (3 - 2 * value)
end

local function read_hud_fov()
	local ok, value = pcall(function() return get_console():get_float("hud_fov") end)
	return ok and tonumber(value) or nil
end

local function write_harvest_hud_fov(visual, value)
	if not visual.hud_owned or not value then return end

	if visual.last_hud_written and math.abs(value - visual.last_hud_written) <= 0.0005 then
		return
	end

	local live = read_hud_fov()
	if visual.last_hud_written and live
		and math.abs(live - visual.last_hud_written) > HUD_FOV_EPSILON
	then
		visual.hud_owned = false
		log2("[monster_parts] HUD FOV ownership lost; external value preserved")
		return
	end

	local ok = pcall(function()
		get_console():execute(string.format("hud_fov %.4f", value))
	end)
	if ok then
		visual.last_hud_written = value
	else
		visual.hud_owned = false
	end
end
local function update_harvest_visual()
	local visual = harvest_visual
	if not visual then return end

	local elapsed = time_global() - visual.started_at
	local duration = visual.restoring and HARVEST_VISUAL_OUT_MS or HARVEST_VISUAL_IN_MS
	local progress = math.min(1, elapsed / duration)
	local k = smoothstep(progress)
	local hud_target = visual.restoring and visual.base_hud_fov or visual.target_hud_fov
	local dof_target = visual.restoring and 0 or HARVEST_DOF_TARGET
	if visual.hud_owned then
		visual.current_hud_fov = visual.start_hud_fov + (hud_target - visual.start_hud_fov) * k
		write_harvest_hud_fov(visual, visual.current_hud_fov)
	end

	local dof_progress = progress
	if not visual.restoring then
		dof_progress = math.max(0, math.min(1, (elapsed - HARVEST_DOF_DELAY_MS) / HARVEST_VISUAL_IN_MS))
	end
	local dof_k = smoothstep(dof_progress)
	visual.current_dof = visual.start_dof + (dof_target - visual.start_dof) * dof_k

	if not visual.last_dof_written or math.abs(visual.current_dof - visual.last_dof_written) > 0.005 then
		set_dof_params(visual.current_dof, visual.current_dof, visual.current_dof, visual.current_dof)
		visual.last_dof_written = visual.current_dof
	end

	if visual.restoring and progress >= 1 then
		if visual.hud_owned then write_harvest_hud_fov(visual, visual.base_hud_fov) end
		set_dof_params(0, 0, 0, 0)
		harvest_visual = nil
	end
end

local function begin_harvest_visual(hud_fov_multiplier)
	if harvest_visual then
		if harvest_visual.hud_owned then
			write_harvest_hud_fov(harvest_visual, harvest_visual.base_hud_fov)
		end
		set_dof_params(0, 0, 0, 0)
	end

	local base_hud_fov = read_hud_fov()
	harvest_visual = {
		base_hud_fov = base_hud_fov,
		target_hud_fov = base_hud_fov and math.max(0.05, math.min(0.99, base_hud_fov * hud_fov_multiplier)) or nil,
		current_hud_fov = base_hud_fov,
		start_hud_fov = base_hud_fov,
		current_dof = 0,
		start_dof = 0,
		started_at = time_global(),
		hud_owned = base_hud_fov ~= nil,
		last_hud_written = nil,
		last_dof_written = nil,
		restoring = false,
	}
end

local function restore_harvest_visual(immediate)
	local visual = harvest_visual
	if not visual then return end

	if immediate then
		if visual.hud_owned then write_harvest_hud_fov(visual, visual.base_hud_fov) end
		set_dof_params(0, 0, 0, 0)
		harvest_visual = nil
		return
	end

	visual.start_hud_fov = visual.current_hud_fov
	visual.start_dof = visual.current_dof
	visual.started_at = time_global()
	visual.restoring = true
end

local function is_harvest_active(token)
	return harvest_state and harvest_state.token == token
end

local function begin_harvest(monster)
	harvest_generation = harvest_generation + 1
	harvest_state = {
		token = harvest_generation,
		monster = monster,
		monster_id = monster and monster:id() or nil,
		input_disabled = true,
		saved_stance = get_actor_stance(),
		stance_started = false,
	}
	is_processing = true
	return harvest_generation
end

local function cleanup_harvest(reason, interrupted)
	local state = harvest_state
	if not state then
		if interrupted then restore_harvest_visual(true) end
		return
	end

	harvest_state = nil
	harvest_generation = harvest_generation + 1
	is_processing = false
	cancel_camera_pitch_ease(false)

	if interrupted then
		pcall(function() game.stop_hud_motion() end)
	end

	local cam = actor_camera(0)
	if cam and state.saved_pitch then
		if interrupted then
			cam.pitch = state.saved_pitch
		else
			ease_camera_pitch_to(state.saved_pitch, 500)
		end
	end

	if db.actor and state.saved_fov then
		if interrupted or not smooth_set_fov then
			pcall(function() db.actor:set_camera_fov(state.saved_fov) end)
		else
			pcall(function() smooth_set_fov(state.saved_fov, 600) end)
		end
	end

	restore_harvest_visual(interrupted)

	local actor_alive = db.actor and db.actor:alive()
	if actor_alive and state.stance_started and state.saved_stance ~= nil then
		restore_stance(state.saved_stance)
	end
	if level.present() then pcall(function() level.enable_input() end) end
	if actor_alive then pcall(function() sak.restore_weap() end) end
	if snd and snd:playing() then snd:stop() end
	if level.present() then pcall(function() level.remove_cam_effector(8553) end) end
	if interrupted then
		log2("[monster_parts] harvest cleanup reason=%s interrupted=true", reason)
	else
		harvest_log("[monster_parts] harvest cleanup reason=%s interrupted=false", reason)
	end
end

local function begin_harvest_stow(state, now)
	local stow_duration = game.play_hud_motion(2, "anm_mob_loot", "anm_show", false, 1, true)
	stow_duration = tonumber(stow_duration) or HARVEST_STOW_DURATION_FALLBACK
	state.phase = "stow"
	state.transfer_at = now + stow_duration * HARVEST_STOW_TRANSFER_FRACTION
	state.phase_due_at = now + stow_duration
	harvest_log("[monster_parts] stow knife=%s part=%s anim=anm_mob_loot duration=%s transfer_ms=%s",
		state.knife_sect, state.part_section, tostring(stow_duration),
		tostring(math.floor(stow_duration * HARVEST_STOW_TRANSFER_FRACTION + 0.5)))
end

local function update_harvest_phase()
	local state = harvest_state
	if not state or not state.phase then return end

	local now = time_global()
	if state.phase == "skinning" and now >= state.phase_due_at then
		if state.stow_delay > 0 then
			state.phase = "transition"
			state.phase_due_at = now + state.stow_delay
			if state.stow_delay >= HARVEST_TRANSITION_SOUND_DELAY_MIN then
				misc.easy_sound("razgruzka\\bag_scroll")
			end
		else
			begin_harvest_stow(state, now)
		end
	elseif state.phase == "transition" and now >= state.phase_due_at then
		begin_harvest_stow(state, now)
	elseif state.phase == "stow" then
		if not state.transferred and now >= state.transfer_at then
			state.transfer()
		end
		if now >= state.phase_due_at then
			if not state.transferred then state.transfer() end
			cleanup_harvest("complete", false)
		end
	end
end

function on_update()
	update_harvest_visual()
	if harvest_state and (not db.actor or not db.actor:alive()) then
		cleanup_harvest("actor_dead", true)
	elseif harvest_state then
		local token = harvest_state.token
		local ok, err = pcall(update_harvest_phase)
		if not ok and is_harvest_active(token) then
			log2("[monster_parts] harvest error stage=phase error=%s", tostring(err))
			cleanup_harvest("error_phase", true)
		end
	end
end

function on_actor_before_hit(obj, hit_data)
	if not hit_data or hit_data.ignore_hit then return end
	if sivol_psy_phantoms and sivol_psy_phantoms.is_phantom and sivol_psy_phantoms.is_phantom( hit_data.who_id ) then return end
	if harvest_state and hit_data.hit_type ~= hit.radiation
		and (not hit_data.power or hit_data.power > 0)
	then
		cleanup_harvest("actor_hit", true)
	end
end

function on_before_save_game()
	if harvest_state then
		cleanup_harvest("save", true)
	else
		restore_harvest_visual(true)
		cancel_camera_pitch_ease(true)
	end
end

function on_stop_modules()
	if harvest_state then
		cleanup_harvest("net_destroy", true)
	else
		restore_harvest_visual(true)
		cancel_camera_pitch_ease(true)
	end
end

function on_level_changer_action()
	if harvest_state then
		cleanup_harvest("level_change", true)
	else
		restore_harvest_visual(true)
		cancel_camera_pitch_ease(true)
	end
end
function get_monster_part( name )
	local ini = system_ini()
	local part = get_string( name, "Spawn_Inventory_Item_Section" )
	return part
end

function has_knife()
    local knife = db.actor:item_in_slot( 0 )
    return knife and strpos( knife:section(), "knife" ) or false
end

function get_tip_text( obj, can_cut )
    local count = obj:object_count()
    if count == 0 then
        return "nothing_to_cut_off"
    end
    
    local is_special = strposx( obj:name(), "burer" ) or strposx( obj:name(), "controller" )
    
	if is_special then
		local part_section = get_monster_part( obj:section() )
		local has_part = part_section and part_section ~= "" and obj:object( part_section )

		local has_additional = false
		for i = 0, count - 1 do
			local item = obj:object( i )
			if item and item:section() ~= part_section then
				has_additional = true
				break
			end
		end

		if has_part then
			if can_cut then return "cut_off_part" end
			-- ножа нет: часть не взять, но можно обшарить остальное
			return has_additional and "%c[green]Обшарим тело" or "knife_need"
		end

		return has_additional and "%c[green]Обшарим тело" or "nothing_to_cut_off"
	end
		
    return can_cut and "cut_off_part" or "knife_need"
end

function correct_monster_tip()
	local can_cut = has_knife()
    
	for id, obj in pairs( db.creatures ) do
		if g_sim:object( id ) and obj and obj:is_monster() and not obj:alive() and obj:section() ~= "zombie_blow" then
			obj:set_tip_text( get_tip_text( obj, can_cut ) )
		end
	end
end

function on_slot( obj )
	if not obj:is_knife() then return end 
	-- Как-то бы проверять был ли какой до этого, чтобы зря не гонять... 
	-- Может на спавне получить активный и с ним проверять? Но вроде все равно заранее надо, т.к при помещении в любом случае обнулится
	correct_monster_tip()
end

function on_drop( obj )
	if not obj:is_knife() then return end 
--	local slot = obj:get_slot()
--	log2( "slot is %s", slot )
--	if slot ~= 0 then return end
	-- Если дропали не со слота, то не нужно его обновлять
	if has_knife() then return end
	correct_monster_tip()
end

function on_hit( obj, amount, local_direction, who, bone_index )
	log2( string.format( "%s hitted %s with %s on %s", who:name(), obj:name(), amount, bone_index ) )
end

