-- -*- mode: lua; coding: windows-1251-dos -*-
-- [HE-PORT]

local MODE_CLOSE  = 1
local MODE_FAR    = 2
local MODE_KILLER = 3

local function always_true() return true end

local function cover( npc, mode, pos, enemy_pos, radius, min_dist, cb )
  if not ( radius > 0 and radius < 1000 ) then return nil end
  return npc:ambush_cover(
    pos, enemy_pos, -( 1000 * mode + radius ), min_dist, cb or always_true
  )
end

function close_cover( npc, pos, enemy_pos, radius, min_dist, max_dist, dev, cb )
  return cover( npc, MODE_CLOSE, pos, enemy_pos, radius, min_dist, cb )
end

function far_cover( npc, pos, enemy_pos, radius, min_dist, max_dist, dev, cb )
  return cover( npc, MODE_FAR, pos, enemy_pos, radius, min_dist, cb )
end

function killer_id( obj )
  _G.bai_ret = nil
  obj:ambush_cover( obj:position(), obj:position(),
                    -( 1000 * MODE_KILLER + 1 ), 0, always_true )
  local v = _G.bai_ret
  if type( v ) ~= "number" or v < 0 then return 65535 end
  return v
end

function see_vispoint( npc, enemy )
  return enemy:center()
end

local last_who, last_wpn = {}, {}

function attach( sm )
  sm:subscribe({ signal = "on_npc_hit",         fun = this.on_npc_hit })
  sm:subscribe({ signal = "on_npc_net_destroy", fun = this.on_net_destroy })
  sm:subscribe({ signal = "on_npc_throw_grenade",
                 fun = xrs_grenade.on_throw_grenade })
  sm:subscribe({ signal = "on_npc_death",
                 fun = xrs_grenade.bai_forget_firing })
end

function on_npc_hit( npc, amount, local_direction, who, bone_index )
  if not who then return end
  local id  = npc:id()
  local wpn = who:active_item()
  last_who[ id ] = who:id()
  last_wpn[ id ] = wpn and wpn:id() or nil
end

function on_net_destroy( npc )
  local id = npc:id()
  last_who[ id ] = nil
  last_wpn[ id ] = nil
end

function who_hit( npc )
  local id = last_who[ npc:id() ]
  return id and level.object_by_id( id ) or nil
end

function who_hit_wpn( npc )
  local id = last_wpn[ npc:id() ]
  return id and level.object_by_id( id ) or nil
end
