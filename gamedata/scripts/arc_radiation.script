-- [HE-PORT] adapter starogo kotovod/arc_radiation.script (NLC HE).
-- Format custom_data kontejnerov v OGSR izmenilsya (sm. arts/arc_containers.script):
-- pervye <slots> zapisej -- arty (kodirovka arc_arts.af_decode), dalee -- customs.
-- Vozvrashchaet tablicu v starom formate: { { section, condition, custom_data }, ... }

function decode_custom_data( custom_data, sect, slots )
  if not slots then slots = get_u32( sect, "container_slots" ) end
  local artefacts = {}
  if custom_data and custom_data ~= "" then
    local cdt = string.explode( ",", custom_data, true )
    for i = 1, slots do
      local t = {}
      local a = cdt[ i ]
      if a and a ~= "_" then
        local rec = arc_arts.af_decode( a )
        t.section   = rec.section
        t.condition = rec.condition or 0
        local cust = cdt[ slots + i ]
        if cust and cust ~= "_" then
          t.custom_data = cust
        end
      end
      table.insert( artefacts, t )
    end
  end
  return artefacts
end
