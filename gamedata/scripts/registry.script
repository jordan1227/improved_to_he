function clsid_objects( cid_min, cid_max, fast_update, convertor, flags )
  local ids = {}
  local sim = alife()
  if sim and cid_min and cid_max then
    for i = 1, 65534 do
      local obj = sim:object( i )
      if obj then
        local ok, cid = pcall( function() return obj:clsid() end )
        if ok and cid and cid >= cid_min and cid <= cid_max then
          table.insert( ids, i )
        end
      end
    end
  end
  return ids, table.getn( ids )
end

function inv_objects( id, fast_update, convertor )
  local ids = {}
  local sim = alife()
  if sim and id then
    for i = 1, 65534 do
      local obj = sim:object( i )
      if obj and obj.parent_id == id then
        table.insert( ids, i )
      end
    end
  end
  return ids, table.getn( ids )
end

function all_objects( fast_update, convertor )
  local ids = {}
  local sim = alife()
  if sim then
    for i = 1, 65534 do
      if sim:object( i ) then
        table.insert( ids, i )
      end
    end
  end
  return ids, table.getn( ids )
end
