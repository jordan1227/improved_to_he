-- sivol: the wear goes to the servo integrity, not the suit condition (sivol_exo.script);
-- halved from 0.0002 together with the exo sprint factor
local WEAR_PER_SEC = 0.0001
local SLOW_K = 0.65
local slow = {
	svoboda_exoskeleton = true,
	svoboda_yellow_exo_outfit_m1 = true,
	monolit_exoskeleton = true,
}
local APPLY_AT = 0.001 -- a spawn ini write per flush
local MAX_DT = 1000
local JUMP_FLAG = 128

local last_t
local pending = 0

local function wearing_exo()
	local outfit = db.actor:item_in_slot(6)
	if outfit and he_exo_charge.is_exo(outfit) then return outfit end
end

local function straining()
	local aobj = get_actor_obj()
	if not aobj then return false end
	if aobj:is_actor_sprinting() then return true end
	return bit_and(aobj:get_body_state(), JUMP_FLAG) ~= 0
end

local function flush(outfit)
	if pending > 0 and outfit then
		sivol_exo.add_wear(outfit, pending)
	end
	pending = 0
end

function on_update()
	local t = time_global()
	local dt = last_t and t - last_t or 0
	last_t = t
	if dt <= 0 or dt > MAX_DT then return end
	local outfit = wearing_exo()
	if not outfit then
		pending = 0
		return
	end
	if not straining() then return end
	local k = slow[outfit:section()] and SLOW_K or 1
	pending = pending + WEAR_PER_SEC * k * dt / 1000
	if pending >= APPLY_AT then flush(outfit) end
end

local function reset_clock()
	last_t = nil
end

local function on_before_save_game()
	flush(wearing_exo())
end

function attach(sm)
	sm:subscribe({ signal = "on_update", fun = this.on_update })
	sm:subscribe({ signal = "on_game_loaded", fun = reset_clock })
	sm:subscribe({ signal = "on_spawn", fun = reset_clock })
	sm:subscribe({ signal = "on_before_save_game", fun = on_before_save_game })
end
