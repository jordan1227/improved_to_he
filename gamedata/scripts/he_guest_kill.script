local GUEST_COMM = "military"
local HOST_COMMS = { "ecolog", "dolg" }
local HOST_PENALTY = -400
local GUEST_PENALTY = -300
local ACTOR_REPUTATION = -200

function attach( sm )
	sm:subscribe( { signal = "on_npc_death", fun = this.on_npc_death } )
end

local function smart_of( id )
	local sim = alife()
	if not sim then return nil end
	local se = sim:object( id )
	local sid = se and se:smart_terrain_id()
	if not sid or sid == BAD_OBJ_ID then
		sid = olr_relations.guest_smart_id( id )
	end
	return sid and sim:object( sid )
end

local function host_community( smart )
	if not smart then return nil end
	local ok, res = pcall( olr_faction_policy.is_guest_smart, smart, GUEST_COMM )
	if not ( ok and res ) then return nil end
	for i = 1, #HOST_COMMS do
		local ok2, res2 = pcall( olr_faction_policy.raw_accepts, smart, HOST_COMMS[ i ] )
		if ok2 and res2 then return HOST_COMMS[ i ] end
	end
	return nil
end

function on_npc_death( npc, who )
	if not ( db.actor and npc and who ) then return end
	if who:id() ~= db.actor:id() then return end
	if not IsStalker( npc ) then return end
	if npc:character_community() ~= GUEST_COMM then return end
	-- [HE-PORT]
	local rel_ok, rel = pcall( function() return npc:relation( db.actor ) end )
	if rel_ok and rel == game_object.enemy then return end

	local host = host_community( smart_of( npc:id() ) )
	if not host then return end

	local aid = db.actor:id()
	pcall( function() relation_registry.change_community_goodwill( host, aid, HOST_PENALTY ) end )
	pcall( function() relation_registry.change_community_goodwill( GUEST_COMM, aid, GUEST_PENALTY ) end )
	pcall( function() db.actor:change_character_reputation( ACTOR_REPUTATION ) end )
end
