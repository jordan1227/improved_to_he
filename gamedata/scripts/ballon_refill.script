-- [HE-PORT]

local ART_GROUP = "ballon_refill"
local REFILL_MINUTES = 120
local READY_KEY = "he_ballon_refill_ready"
local FULL_COND = 1.0

function attach(sm)
end

function get_ballon()
    if not db.actor then return nil end
    return db.actor:object("ballon")
end

function has_ballon()
    return get_ballon() ~= nil
end

function ballon_not_full()
    local b = get_ballon()
    if not b then return false end
    return b:condition() < FULL_COND
end

function is_refilling()
    return get_value(READY_KEY) ~= nil
end

function can_refill()
    if is_refilling() then return false end
    if not has_ballon() then return false end
    return ballon_not_full()
end

function has_payment()
    return kotovod.gg_inventory_artefacts(ART_GROUP, "have", 1) == true
end

function take_ballon()
    if not can_refill() then return end
    if not has_payment() then return end
    kotovod.gg_inventory_artefacts(ART_GROUP, "give", 1)
    local b = get_ballon()
    if not b then return end
    misc.release_obj(b)
    set_value(READY_KEY, timers.Get_Game_Minutes() + REFILL_MINUTES)
end

function is_ready()
    local ready = get_value(READY_KEY)
    if not ready then return false end
    return timers.Get_Game_Minutes() >= ready
end

function not_ready()
    return is_refilling() and not is_ready()
end

function give_back()
    remove_value(READY_KEY)
    local ballon = misc.spawn_to("ballon", db.actor)
    misc.process_spawn()
    if ballon then
        params.upd_condition(ballon.id, FULL_COND)
        params.set_inv_weight(ballon.id, 1 + 4 * FULL_COND)
    end
    sak.send_tip(
        "Баллон заправлен",
        "Мысли вслух", 0, 5, "pribor", "pda_news", "green"
    )
end

function force_return()
    set_value(READY_KEY, 0)
    give_back()
end
