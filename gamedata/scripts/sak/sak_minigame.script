function load_sultan_weapon_treasure()
	local tip=get_value("sultan_weapon", 0)
	local rand_treasure = dsh.get_next_random( "sultan_weapon_treasure", 1, 3 )
	local npc=db.actor
	local obj = alife():story_object(sultan_treasure[rand_treasure*2-1])
	if tip~=0 and obj then
		for k,v in pairs(sultan_weapons[tip]) do
			misc.spawn_to(v, obj)
		end 
    level.map_add_object_spot_ser(obj.id,"crlc_big_treasure0","?")
		npc:give_talk_message("%c[255,216,186,140]"..game.translate_string("sakm.sultan_treasure_"..sultan_treasure[rand_treasure*2]),"ui\\ui_iconsTotal",Frect():set(0,0,0,0),"simple_answer_item")
		npc:give_info_portion("way_sultan_treasure_"..rand_treasure)
		remove_value("sultan_weapon")
		npc:disable_info_portion("sultan_weapon_starting")
	end
end
--[[Покер с игральными костями

Для этой игры необходимо иметь пять покерных игральных костей. 
Цель игры: составить наиболее выгодную покерную комбинацию из пяти игральных костей.
Количество игроков может быть любым, но лучше всего, если число играющих не будет превышать пяти.
Каждый игрок кидает одну игральную кость, чтобы определить очередность ходов. Начинает тот у кого выпала старшая карта(Например, если выпадает Туз, то игрок у которого он выпал начинает игру)
Каждый игрок кидает все пять игральных костей, после чего он может заявить, что доволен результатами или перекинуть любое количество костей(от одной до пяти). После второго броска у него снова есть выбор - принять полученную комбинацию или снова перекинуть кости, причем он не имеет права трогать те кости, которые остались нетронутыми после первого сбрасывания. Таким образом, у каждого игрока есть три попытки собрать наиболее выгодную комбинацию. После третьего сбрасывания вне зависимости от результата ход переходит к игроку сидящему слева. В конце круга, когда все игроки сделали свои ходы, выигрывает тот у кого окажется высшая комбинация.
Возможны следующие комбинации(в порядке убывания):
1. Покер - пять костей одного вида(например, пять Королей или пять Девяток)
2. Каре - четыре кости одного вида(например, четыре Десятки)
3. Фулл хаус - три кости одного вида + пара(например, три Дамы и два Валета)
4. Тройка - три кости одного вида(например, три Туза)
5. Две пары - две кости одного вида и две кости другого вида(например, две Девятки и две Десятки)
6. Пара - две кости одного вида(например, два Короля)
7. Наивысшее очко - в случае, если ни у кого не выпало покерной комбинации выигрывает игрок с наивысшей суммой очков среди пяти несовмещающихся в комбинацию баллов, выпавших на игральных костях.
Если комбинации двух игроков одинаковы(например, у двух игроков по Каре), то выигрывает тот у кого выше очки, выпавшие на костях(например, если у одного игрока Каре Десяток, а у второго Каре Дам, то выиграл второй). Если у игроков одинаковые комбинации, то они разыгрывают партию друг с другом.
Ставки делаются перед каждой игрой. Выигравшему достается весь банк.

Другой вариант игры: правила те же, только выигрывает игрок с худшей комбинацией.]]

-- [HE-PORT] perenos kvestovyh funkcij iz NLC HE (sak\sak_minigame.script)

-- [HE-PORT] proxy: staroe hranilishche nlc_vars poverh dvizhkovogo xvars (get_value/set_value iz _g)
if nlc_vars == nil then
  nlc_vars = setmetatable( {}, {
    __index    = function( t, k ) return get_value( "nlc_vars." .. k ) end,
    __newindex = function( t, k, v ) set_value( "nlc_vars." .. k, v ) end,
  } )
end
local mongol_wins_today     = nlc_vars.mongol_wins or 0
local summ_dises = {
    "один", "два", "три", "четыре", "пять", "шесть", "семь",
    "восемь", "девять", "десять", "одиннадцать", "двенадцать"
}

local lisiy_art = "af_medusa_dyn2d"
local mongol_tbl = { "suhpay", "device_pda_npc", "grenade_f1", "ammo_vog-25" }
local mongol_ind = 1

function roll_dice_ochko_npc_for_gg( npc )
    die_a = lua_random( 1, 6 )
    if ( die_a + gg_sum ) == ochko then
        db.actor:give_talk_message(
            "%c[255,216,186,140]Так..."       .. numer[ die_a ]
            .. "%c[255,216,186,140], а было " .. summ_dises[ gg_sum ]
            .. "\\n%c[255,216,186,140]Всего одиннадцать! Очко! Повезло...",
            "ui\\ui_iconsTotal", Frect():set( 498, 188, 83, 47 ), "iconed_answer_item"
        )
        handle_minigame_wins( npc )
    elseif ( die_a + gg_sum ) > ochko then
        db.actor:give_talk_message(
            "%c[255,216,186,140]Ха! У тебя "  .. numer[ die_a ]
            .. "%c[255,216,186,140], а было " .. summ_dises[ gg_sum ]
            .. "\\n%c[255,216,186,140]Перебор... Банк мой!",
            "ui\\ui_iconsTotal", Frect():set( 498, 188, 83, 47 ), "iconed_answer_item"
        )
        db.actor:give_info_portion( "gg_luser" )
    elseif ( die_a + gg_sum ) < ochko then
        if gg_sum ~= 0 then
            db.actor:give_talk_message(
                "%c[255,216,186,140]У тебя "      .. numer[ die_a ]
                .. "%c[255,216,186,140], а было " .. summ_dises[ gg_sum ]
                .. "\\nВсего %c[255,255,255,255]" .. summ_dises[ ( gg_sum + die_a ) ]
                .. "\\n%c[255,216,186,140]Ещё? Бросать?",
                "ui\\ui_iconsTotal", Frect():set( 498, 188, 83, 47 ), "iconed_answer_item"
            )
            gg_sum = die_a + gg_sum
        else
            db.actor:give_talk_message(
                "%c[255,216,186,140]У тебя " .. numer[ die_a ]
                .. "\\n%c[255,216,186,140]Ещё бросать? Или хватит?",
                "ui\\ui_iconsTotal", Frect():set( 498, 188, 83, 47 ), "iconed_answer_item"
            )
            gg_sum = die_a + gg_sum
        end
    end
end
function roll_dice_ochko_npc( npc )
    die_e = lua_random( 1, 5 )
    if ( die_e + npc_sum ) == ochko then
        db.actor:give_talk_message(
            "%c[255,216,186,140]Ага! У меня "  .. numer[ die_e ]
            .. "%c[255,216,186,140], а было "  .. summ_dises[ npc_sum ]
            .. "\\n%c[255,216,186,140]Очко! Я забираю банк...", 
            "ui\\ui_iconsTotal", Frect():set( 498, 188, 83, 47 ), "iconed_answer_item"
        )
        db.actor:give_info_portion( "gg_luser" )
    elseif ( die_e + npc_sum ) > ochko then
        db.actor:give_talk_message(
            "%c[255,216,186,140]Блинн! "      .. numer[ die_e ]
            .. "%c[255,216,186,140], а было " .. summ_dises[ npc_sum ]
            .. "\\n%c[255,216,186,140]Перебор... Банк твой...",
            "ui\\ui_iconsTotal", Frect():set( 498, 188, 83, 47 ), "iconed_answer_item"
        )
        handle_minigame_wins( npc )
    elseif ( die_e + npc_sum ) < gg_sum then
        if npc_sum ~= 0 then
            db.actor:give_talk_message(
                "%c[255,216,186,140]Так "                       .. numer[ die_e ]
                .. "%c[255,216,186,140], да ещё до этого было " .. summ_dises[ npc_sum ]
                .. "\\nВсего "                                  .. summ_dises[ ( npc_sum + die_e ) ]
                .. "\\n%c[255,216,186,140]Бросаю ещё! Не против?",
                "ui\\ui_iconsTotal", Frect():set( 498, 188, 83, 47 ), "iconed_answer_item"
            )
            npc_sum = ( die_e + npc_sum )
        else
            db.actor:give_talk_message(
                "%c[255,216,186,140]У меня " .. numer[ die_e ]
                .. "\\n%c[255,216,186,140]Едем дальше...\\nДа?",
                "ui\\ui_iconsTotal", Frect():set( 498, 188, 83, 47 ), "iconed_answer_item"
            )
            npc_sum = ( die_e + npc_sum )
        end
    elseif ( die_e + npc_sum ) == gg_sum then
        if npc_sum ~= 0 then
            db.actor:give_talk_message(
                "%c[255,216,186,140]Ну вот... "   .. numer[ die_e ]
                .. "%c[255,216,186,140], а было " .. summ_dises[ npc_sum ]
                .. "\\nВсего "                    .. summ_dises[ ( npc_sum + die_e ) ]
                .. "\\n%c[255,216,186,140]Не буду больше бросать, останемся при своих...",
                "ui\\ui_iconsTotal", Frect():set( 498, 188, 83, 47 ), "iconed_answer_item"
            )
            npc_sum = ( die_e + npc_sum )
        else
            db.actor:give_talk_message(
                "%c[255,216,186,140]Ну вот... " .. numer[ die_e ]
                .. "\\n%c[255,216,186,140]Не буду больше бросать, останемся при своих...",
                "ui\\ui_iconsTotal", Frect():set( 498, 188, 83, 47 ), "iconed_answer_item"
            )
            npc_sum = ( die_e + npc_sum )
        end
        db.actor:give_info_portion( "draw" )
    elseif
            ( die_e + npc_sum ) > gg_sum
        and ( die_e + npc_sum ) < ochko
    then
        if npc_sum ~= 0 then
            db.actor:give_talk_message(
                "%c[255,216,186,140]Ну вот... "   .. numer[ die_e ]
                .. "%c[255,216,186,140], а было " .. summ_dises[ npc_sum ]
                .. "\\nВсего "                    .. summ_dises[ ( npc_sum + die_e ) ]
                .. "\\n%c[255,216,186,140]Я победил! Кровные Меченного уплыли...",
                "ui\\ui_iconsTotal", Frect():set( 498, 188, 83, 47 ), "iconed_answer_item"
            )
            npc_sum = ( die_e + npc_sum )
        else
            db.actor:give_talk_message(
                "%c[255,216,186,140]Ага! Вот... " .. numer[ die_e ]
                .. "\\n%c[255,216,186,140]Я победил! Кровные Меченного уплыли...",
                "ui\\ui_iconsTotal", Frect():set( 498, 188, 83, 47 ), "iconed_answer_item"
            )
            npc_sum = ( die_e + npc_sum )
        end
        db.actor:give_info_portion("gg_luser")
    end
end
function handle_minigame_wins( npc )
    db.actor:give_info_portion( "gg_winner" )
    -- для статистики:
    xr_statistic.add_pts(
        "otherstats", game.translate_string( "st_pda_otherstats_won" ), 1, 0 
    )
    if npc == "mongol" then
        mongol_wins_today    = mongol_wins_today + 1
        nlc_vars.mongol_wins = mongol_wins_today
    elseif npc == "stas" then
        vodka8_wins_from_stas()
    elseif npc == "lysyi" then
        art1_wins_from_lysyi()
    end
end
function gg_cheater_money( flag, stor_name )
	local cheater_money = tonumber( he_stor.stor_read( stor_name, "0" ) ) or 0

	if flag == "lose" then 
		local money = 0
		local amount = 0
		-----
		if stor_name == "lisiy_money" then 
			if str_in_tab( lisiy_art, kotovod.tbl_arts.lvl1 ) then amount = 15000 end
			if str_in_tab( lisiy_art, kotovod.tbl_arts.lvl2 ) then amount = 30000 end 
			if str_in_tab( lisiy_art, kotovod.tbl_arts.lvl3 ) then amount = 70000 end 				
			money = cheater_money + amount 
		end	
		-----
		if stor_name == "stas_money" then 
			money = cheater_money + 12000
			nlc_vars.stas_money_give = true
		end	
		-----
		he_stor.stor_write( stor_name, money )		
	end
	
	if flag == "win" then 
		he_stor.stor_write( stor_name, 0 ) 	
	end
	
	if flag == "show" then 
		db.actor:give_talk_message(
			"%c[255,216,186,140]Верни должок в виде: " .. "%c[255, 238, 153, 26]" .. cheater_money .."%c[default]"
			.. " рубликов, тогда и поиграем.",
			"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item"
		)	
	end

	if flag == "have" then 
		return db.actor:money() >= cheater_money
	end	
	
	if flag == "give" then 
		sak_dialog.relocate_money( cheater_money, "out" )		
	end
end
function art1_wins_from_lysyi()
    local art_winned = nlc_vars.art_win or 0
    nlc_vars.art_win = art_winned + 1
end
function vodka8_wins_from_stas()
    local vodka_winned = nlc_vars.vodka_win or 0
    nlc_vars.vodka_win = vodka_winned + 8
end
function add_mongol_bet()
    local item = mongol_tbl[ mongol_ind ]
    if item == "device_pda_npc" then
        mike.add_pda_npc_amount( 1, 2 )
    else
		sak.create_items( item, 1 )
    end
end

-- [HE-PORT-R2] перенос функций NLC HE из sak\sak_minigame.script
local mongol_wins_amount    = 1 + math.fmod( timers.Get_Game_Days(), 3 )
local its_cart = {
    "af_night_star",
    "af_gold_fish",
    "af_soul",
    "af_electra_moonlight",
    "af_cristall",
    "af_ameba_mica",
    "af_rusty_sea_urchin"
}

local stas_art  = "af_vyvert_dyn2d"

function gg_minigame_zubr( flag, section )
	local stor_table = vergas_lib.str_explode( "|", he_stor.stor_read( "zubr_payment", "false|false" ), true )
	local cheated_item, already_played = stor_table[ 1 ],  stor_table[ 2 ]
	zubr_section = section

	if flag == "stor" then 
		he_stor.stor_write( "zubr_payment", section .. "|" .. "true" )
		nlc_vars.zubr_cheated = nil
	end
	
	if flag == "cheated" then 
		if ( cheated_item ~= "false" and nlc_vars.zubr_cheated ~= true ) or ( nlc_vars.zubr_cheated == true and already_played ~= "false" ) then return true end	
		return false
	end
	
	if flag == "not_cheated" then
		return not gg_minigame_zubr( "cheated" )
	end
	
	if flag == "show" then
		if timers.check_timer( "zubr_rewrite" ) then
			db.actor:give_talk_message(
				"Подходи через " .. new_quests.check_timer( 'zubr_rewrite', "sak_minigame.gg_minigame_zubr( 'rewrite' )" ) .." минут, необходимо подготовить всё, тогда и поиграем ещё...",
				"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item"
			)			
		elseif cheated_item ~= "false" then 
			db.actor:give_talk_message(
				"%c[255,216,186,140]Мы ведь не так давно играли с тобой, ты ещё обещал артефакт вернуть... \\nВ общем, пока не вернёшь - " .. "%c[255, 238, 153, 26]".. get_inv_name( cheated_item ) .."%c[default]"
				.. ", играть с тобой не буду.",
				"ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item"
			)
		end
	end
	
	if flag == "time_over" then 
		if not timers.check_timer( "zubr_rewrite" ) then return true end
	end
	
	if flag == "have" then 
		return sak.have_items_count( cheated_item, 1 ) ~= false
	end
	
	if flag == "give" then 
		sak_inventory.release_actor_items( cheated_item, 1 )
		he_stor.stor_write( "zubr_payment", "false|false" )
		nlc_vars.zubr_cheated = nil		
	end
	
	if flag == "finish" then
		nlc_vars.zubr_cheated = true
		timers.start_timer( "zubr_rewrite", 0, 0, 40, "sak_minigame.gg_minigame_zubr( 'rewrite' )" )	
	end
	
	if flag == "rewrite" then 
		if cheated_item ~= "false" then 
			he_stor.stor_write( "zubr_payment", cheated_item .. "|" .. "false" )
		end
	end
end
function give_lisiy_gameart( table )
	local lisiy = level_object_by_sid( 607 )
	local cond
	for a = 1, #table do 
		for i, k in pairs( sak_inventory.rucksack ) do
			if strpos( i, table[ a ], 1, true ) then
				if str_in_tab( i, kotovod.tbl_arts.lvl1 ) then cond = 0.5 end
				if str_in_tab( i, kotovod.tbl_arts.lvl2 ) then cond = 0.6 end 
				if str_in_tab( i, kotovod.tbl_arts.lvl3 ) then cond = 0.7 end 	
				for m = 1, #k do
					local obj = client_obj( k[ m ] )				
					if obj:condition() >= cond then 	
						lisiy_art = obj:section()						
						sak_inventory.relocate_actor_items( lisiy, obj:section(), 1 )		
						return
					end	
				end
			end
		end
	end	
end
function is_gg_cheated_lisiy()
    local cheated_money = tonumber( he_stor.stor_read( "lisiy_money", "0" ) ) or 0
    if cheated_money > 0 and not has_alife_info( "gg_luser" ) then return true end
    return false
end
function is_gg_cheated_stas()
    local cheated_money = tonumber( he_stor.stor_read( "stas_money", "0" ) ) or 0
    if cheated_money > 0 and nlc_vars.stas_money_give ~= true then return true end
    return false
end
function money_lisiy_reward()
	local money = 0
	if str_in_tab( lisiy_art, kotovod.tbl_arts.lvl1 ) then money = 15000 end
	if str_in_tab( lisiy_art, kotovod.tbl_arts.lvl2 ) then money = 30000 end
	if str_in_tab( lisiy_art, kotovod.tbl_arts.lvl3 ) then money = 70000 end	
	sak_dialog.relocate_money( money, "in" )
end
function mongol_bet_today()
    local day  = timers.Get_Game_Days() or 1
    mongol_ind = dsh.get_fixed_random( "minigame_bet_rnd", day, 1, #mongol_tbl )
    db.actor:give_talk_message(
        game.translate_string( system_ini():r_string( mongol_tbl[ mongol_ind ], "inv_name" ) )
        .. " - одна штука",
        "ui\\ui_iconsTotal", Frect():set( 0, 0, 0, 0 ), "simple_answer_item"
    )
end
function mongol_have_items()
    wprintf( "@----------- mongol_wins_amount: %s, nlc_vars.mongol_wins: %s", tostring( mongol_wins_amount ), tostring( nlc_vars.mongol_wins ) )
    if
           ( not nlc_vars.mongol_wins )
        or ( nlc_vars.mongol_wins < mongol_wins_amount )
    then
        return true
    end
    return false
end
function mongol_not_have_items() return not mongol_have_items() end
function not_gg_cheated_lisiy() return not is_gg_cheated_lisiy() end
function not_gg_cheated_stas() return not is_gg_cheated_stas() end
function out_lisiy_gameart( first_speaker, second_speaker )
    for n = 1, 6 do
        local obj = first_speaker:object( lisiy_art )
        if obj then
            misc.release_obj( obj, 'out_lisiy_gameart' )
            break
        end
    end
end
function return_lisiy_gameart( first_speaker, second_speaker )
    for n = 1, 6 do
        local obj = first_speaker:object( lisiy_art )
        if obj then
            first_speaker:transfer_item( obj, second_speaker )
            sak.relocate_item( "in", lisiy_art, 1 )
            break
        end
    end
end
function stas_give_gameart( table )
	local stas = level_object_by_sid( 35 )
	for a = 1, #table do 
		for i, k in pairs( sak_inventory.rucksack ) do
			if strpos( i, table[ a ], 1, true ) then
				for m = 1, #k do
					local obj = client_obj( k[ m ] )				
					if obj:condition() >= 0.6 then 	
						sak_inventory.relocate_actor_items( stas, obj:section(), 1 )		
						stas_art = obj:section()	
						return
					end	
				end
			end
		end
	end	
end
function stas_have_gameart( table )
	for a = 1, #table do 
		for i, k in pairs( sak_inventory.rucksack ) do
			if strpos( i, table[ a ], 1, true ) then
				for m = 1, #k do
					local obj = client_obj( k[ m ] )				
					if obj:condition() >= 0.6 then 
						return true
					end
				end
			end
		end
	end
	return false
end
function stas_out_gameart( first_speaker, second_speaker )
    for n = 1, 6 do
        local obj = first_speaker:object( stas_art )
        if obj then
            misc.release_obj( obj, 'stas_out_gameart' )
            break
        end
    end
end
function stas_return_gameart( first_speaker, second_speaker )
    for n = 1, 6 do
        local obj = first_speaker:object( stas_art )
        if obj then
            first_speaker:transfer_item( obj, second_speaker )
            sak.relocate_item( "in", stas_art, 1 )
            break
        end
    end
end
function stas_store()
	nlc_vars.stas_money_give = true
end
function stas_store_clear()
	nlc_vars.stas_money_give = nil
end
function take_cart()
    local c    = lua_random( 1, 7 )
    local d    = lua_random( 1, 3 )
    local item = its_cart[ c ]
    sak.create_items( item .. "_dyn" .. d .. "d", 1 )
end
