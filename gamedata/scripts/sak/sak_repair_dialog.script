function active_wpn_strelok( slot )
	local item_in_slot = actor_active_item( slot )
	if item_in_slot and strpos( item_in_slot:section(), "wpn_ak74_m1", 1, true ) then return false end 
	return true
end

-- модульные колбеки

function sak_repair_dialog.init_module()
	if nil == get_value("repair") then 
		set_value("repair", {dolgovjaz = {}, lisaped = {}, stepanych = {}, vergas = {}, shurup = {} })
	end 
	t_repair = get_value("repair")
	local repairers = { r_dolgovjaz, r_lisaped, r_stepanych, r_vergas }
 
	local dt = get_value("dialog_timers", {}) 
 
 
	-- конвертирование из старой схемы                                                                
	for i, repairer in ipairs(repairers) do
		local ss = repairer .. "_"
		if ss == r_dolgovjaz.."_" then ss = "" end 
 
		local tip = get_value(ss.."repairtip") 
  
		if tip and tip:len() > 1 then        
			t_repair[repairer].section = tip
			remove_value(ss.."repairtip")    
		end 
  
  
		local tnr = get_value(ss.."time_need_repair", dt[ss.."time_need_repair"])
   
		if tnr and tnr > 0 then        
			t_repair[repairer].time_need = tnr
			dt[repairer.."_time_need_repair"] = tnr     
			remove_value(ss.."time_need_repair")
		end                                     
  
		local tmr = get_value(ss.."time_repair", dt[ss.."time_repair"])
		if tmr and tmr > 0 then        
			t_repair[repairer].time_repair = tmr
			dt[repairer.."_time_repair"] = tmr     
			remove_value(ss.."time_repair")         
		end
	end -- for
 
	dt.time_repair = nil -- obsolete
	set_value("dialog_timers", dt)
   
	-- wprintf(" t_repair dump:")  
	-- misc.dump_table(t_repair(true))
end

function sak_repair_dialog.late_init()	end 

---------------
-- Ремонтник-солдат на Кордоне после экспедиции

function soldier_calc_time( cond )
	return math.ceil( ( 1 - cond ) / 0.1 )
end

function soldier_calc_cost( item, cond )
	local cost = 0
	local ini = system_ini()
	if ini:section_exist( item ) then
		sys_cost = ini:r_float( item, "cost" )
		cost = math.ceil( ( sys_cost / cond ) / 5000 )
		if cost < 1 then cost = 1 end
		if cost > 5 then cost = 5 end	
	end	
	return cost
end


function is_mask_in_repair( repairer )
	local tr = t_repair[ repairer ]
	if not tr then return false end
	
	local mask_or_armor = tr.mask_or_armor
	if mask_or_armor == 'm' then
		if tr.a_cond < 0.82 then
			this.need_additonal_repair_armor = true
		end
		return true
	end
	
	return false
end

function is_armor_in_repair( repairer )
	local tr = t_repair[ repairer ]
	if not tr then return false end
	
	local mask_or_armor = tr.mask_or_armor
	if mask_or_armor == 'all' then
		return true
	elseif mask_or_armor == 'a' and tr.m_cond < 0.82 then
		this.need_additonal_repair_mask = true
		return true
	end
	
	return false
end

function is_wpn_in_repair( repairer )
	return not is_mask_in_repair( repairer ) and not is_armor_in_repair( repairer )
end

function need_additional_repair_mask()
	return this.need_additonal_repair_mask
end

function need_additional_repair_armor()
	return this.need_additonal_repair_armor
end

function no_additional_repair()
	return not need_additional_repair_mask() and not need_additional_repair_armor()
end

function clear_repair_vars()
	this.need_additonal_repair_mask = false
	this.need_additonal_repair_armor = false
	log2( "CLEARED REPAIR DLG" )
end