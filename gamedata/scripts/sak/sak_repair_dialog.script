function sak_dialog.update_margin()
	this.vergas_margin         = 1.4 + 0.1 * math.ceil( sak.day_money / 3 ) 
	this.lisaped_margin        = 1.5 + 0.1 * math.ceil( sak.day_money / 3 )
	this.dolgovjaz_margin      = 0.8 + 0.1 * math.ceil( sak.day_money / 6 ) 
	this.stepanych_margin      = 1.3 + 0.1 * math.ceil( sak.day_money / 4 )
	this.shurup_margin         = 1.3 + 0.15 * math.ceil( sak.day_money / 3 )
end

--[[
function uniform_time_repair(item_rc, item_cost, coefs, times) 
    for i, coef in ipairs(coefs) do
        -- искать стоимость ремонта соразмерную повреждению
        if item_rc >= item_cost * coef then 
            -- Увеличиваем время на 20-30%
            local increase_factor = 1.5 -- Для 20% увеличения
            -- local increase_factor = 1.3 -- Для 30% увеличения
            return times[i] * increase_factor 
        end
    end          
    return 0
end
]]--

function uniform_time_repair(item_rc, item_cost, coefs, times) 
    for i, coef in ipairs(coefs) do
        -- искать стоимость ремонта соразмерную повреждению
        if item_rc >= item_cost * coef then 
            -- Увеличиваем время в зависимости от состояния предмета
            local base_time = times[i]
            local condition_factor = math.ceil( 1 + (1 - (item_rc / item_cost)) * 0.5 )-- Увеличиваем на 50% от базового времени в зависимости от повреждения
            return math.ceil(base_time * condition_factor) -- Округляем до целого
        end
    end          
    return 0
end

function calc_repair_cost( item, margin, repairer )
    local days_in_zone = level.get_time_days()
    
    if not margin or type( margin ) ~= "number" then
        wprintf(" [~T].~C0C #WARN:~C07 margin = ~C0F %s~C07", DumpVar( margin ) )
        margin = 1
    end
    
    local condition_percent = ( 1 - item:condition() ) * 100
    
    local base_cost = item:cost() * ( condition_percent / 100 ) * ( 0.8 + 0.1 * ( days_in_zone / 8 ) )
    
    -- Добавляем зависимость от сложности игры
    local difft = {
        [ 0 ] = { 0.7,  250 }, -- новичок
        [ 1 ] = { 0.8,  500 }, -- сталкер
        [ 2 ] = { 0.9,  750 }, -- ветеран
        [ 3 ] = {   1, 1000 }  -- мастер
    }
    
    local g_dif = difft[ level.get_game_difficulty() ]
    local adjusted_cost = math.ceil( base_cost * margin * g_dif[ 1 ] )
    
    -- Устанавливаем минимальную стоимость в зависимости от сложности
    if adjusted_cost < g_dif[ 2 ] then
        adjusted_cost = g_dif[ 2 ]
    end
    
    this.cur_price = adjusted_cost
    
    return adjusted_cost, math.floor( 100 - ( item:condition() * 100 ) )
end

--[[
function time_desc( minutes )
	local tm = {}
		tm[ 15 		] = "\\nМинут пятнадцать"
		tm[ 20 		] = "\\nМинут двадцать"
		tm[ 30 		] = "\\nПолчаса"
		tm[ 40 		] = "\\nМинут сорок - час"
		tm[ 45 		] = "\\nТри четверти часа"
		tm[ 60 		] = "\\nЧасок или около того"       
		tm[ 80 		] = "\\nЧасок с небольшим"
		tm[ 90 		] = "\\nПолтора часа"
		tm[ 120 	] = "\\nЧаса два"
		tm[ 180 	] = "\\nДва с половиной, а может и три"
		tm[ 240 	] = "\\nЧетыре часа, не меньше"
		tm[ 480 	] = "\\nВосемь часов, не меньше"
		tm[ 12 * 60 ] = "\\nПолдня или даже больше"
		tm[ 24 * 60 ] = "\\nЦелый день"
		
	if minutes > 24 * 60 then 
		return "\\nБольше суток"
	else  
		return tm[ minutes ] or sprintf( "\\n%d минут примерно", minutes )
	end        
end
]]--


function time_desc(minutes)
    local tm = {
        [15] = "\\nМинут пятнадцать",
        [20] = "\\nМинут двадцать",
        [30] = "\\nПолчаса",
        [40] = "\\nМинут сорок - час",
        [45] = "\\nТри четверти часа",
        [60] = "\\nЧасок или около того",
        [80] = "\\nЧасок с небольшим",
        [90] = "\\nПолтора часа",
        [120] = "\\nЧаса два",
        [180] = "\\nДва с половиной, а может и три",
        [240] = "\\nЧетыре часа, не меньше",
        [300] = "\\nПять часов",
        [360] = "\\nШесть часов, где-то так...",
        [480] = "\\nВосемь часов, не меньше",
        [12 * 60] = "\\nПолдня или даже больше",
        [24 * 60] = "\\nЦелый день"
    }

    if minutes > 24 * 60 then 
        return "\\nБольше суток"
    else  
        -- Найти ближайшее значение
        local closest = nil
        local closest_diff = math.huge -- Начальное значение для разницы

        for time in pairs(tm) do
            local diff = math.abs(minutes - time)
            if diff < closest_diff then
                closest_diff = diff
                closest = time
            end
        end

        -- Формируем результат с учетом разницы
        local result = tm[closest]
        if closest_diff > 0 then
        --    if minutes < closest then
        --       result = result .. ", возможно, чуть меньше"
        --    else
        --        result = result .. " с небольшим"
        --    end
			if minutes > closest and minutes < 240 then 
				result = result .. " с небольшим"
			elseif minutes < 240 then 
				result = result .. ", возможно, чуть меньше"
			end	
        end

        return result -- Возвращаем описание для ближайшего времени
    end        
end

function get_margin( repairer )
	local m = this[repairer..'_margin']
	if not m then
		wprintf("[~T].~C0C #ERROR: this.%s_margin == nil~C07", repairer)
		m = 1
	end 
	return tonumber( m )
end                              


function repair_start( repairer, time_need, sect, obj, todo)
	log2( "%s %s %s aaaa", repairer, time_need, sect )
    local cfg = this.repair_config[ repairer ]
    if cfg.info_start then db.actor:give_info_portion(cfg.info_start) end
    
    if t_repair[ repairer ] == nil then
        t_repair[ repairer ] = {}
    end
    
    sak.relocate_item("out", sect, 1)
    
    t_repair[ repairer ].time_need = time_need
    t_repair[ repairer ].time_end = misc.game_time_minutes() + time_need
    t_repair[ repairer ].section = sect
    
    local obj = client_obj( obj )
    
    if obj:is_outfit() then
		-- Если чиним только броню, тогда сохраняем грязь и состояние маски
		t_repair[ repairer ].mask_or_armor = todo	
		if todo == "a" then 
			local custom, condition = vergas_masks.manage_armor_mask_params( obj, "get" )
			local tbl_custom = vergas_lib.str_explode( "|", custom, true )
			if tbl_custom and tbl_custom[ 1 ] ~= "none" then
				t_repair[ repairer ].cust = custom
				t_repair[ repairer ].m_cond = condition			
			end
		end	
		
		if todo == "m" then 
			t_repair[ repairer ].a_cond = obj:condition()
		end	
	
        misc.release_obj( obj )
    else
		kotovod.respawn_addons( obj )
        misc.release_obj( obj )
    end
end


function uniform_take( repairer )
    local tr = t_repair[ repairer ]
    if nil == tr then
        wprintf("[~T].~C0C #ERROR(uniform_take):~C07 not specified repair for repairer~C0A %s~C07", repairer)          
        misc.dump_table(t_repair)
        return 
    end      
    local mod_wpn = tr.section
    if mod_wpn then
        local obj = misc.spawn_to( mod_wpn, 0 )
        sak.relocate_item( "in", mod_wpn, 1 )
        
        dsh.wait_condition(
            function() 
                return level.object_by_id( obj.id ) ~= nil 
            end, 
            function()
                local object = level.object_by_id( obj.id )
                if object then 
					if object:is_weapon() then 
						dsh.timeout( 250, function()
							sak_dialog.weapon_unload( obj.id )
						end )
					elseif object:is_outfit() then 
						level.client_spawn_manager():add(
							obj.id, -1,
							function( id, obj )
								-- Если чинили только маску, тогда восстанавливаем кондицию брони
								if tr.a_cond then 
									params.upd_condition( obj, tr.a_cond )
									tr.a_cond = nil
								end
								
								-- Если брони нет, - надеваем эту
								if db.actor:get_current_outfit() == nil then 
									db.actor:move_to_slot( obj )
								end			
								
								-- Восстанавливаем состояние маски
								if tr.m_cond then 						
									dsh.timeout( 250, function() 
										vergas_masks.set_default_cd( obj:id() )
										vergas_masks.set_mask_condition( obj:id(), tr.m_cond * 100, 1 )
										tr.m_cond = nil
									end )
								end							
							
								-- Восстанавливаем кастомку брони
								if tr.cust then
									dsh.timeout( 500, function() 
										vergas_masks.manage_armor_mask_params( obj, "set", tr.cust ) 
										tr.cust = nil 
									end )
								end	
							end
						)						
					end	
                end 
            end
        )
        
        t_repair[repairer] = {}  
        set_value("repair", t_repair) 
    else
        wprintf("[~T].~C0C #ERROR(uniform_take):~C07 nothing for spawn for repairer~C0A %s~C07", repairer)  
    end 
end

