-- Cosmetic toggle only; charge consumption and empty-watch shutdown stay active.
show_battery_icon = false

local function reset_shader_zoom_params()
	--обязательно обнуляем когда прицел неактивен, w используется в двиге для определения, активен ли 3д прицел.
	shader_set_custom_param("s3ds_param_2", 0, 0, 0, 0)
end

local is_en_cache = {}
local function is_enabled_3dss(s)
	if is_en_cache[s] == nil then
		is_en_cache[s] = get_bool(s, "3dss_gen_zoom_enable", false)
	end
	return is_en_cache[s]
end

local last_weapon_id
local function on_dots_update()
	if not (db.actor and db.actor:alive()) then return end

	local wpn = db.actor:active_item()
	if not wpn then return end

	local section = wpn:section()
	if not is_enabled_3dss(section) then
		reset_shader_zoom_params()
		last_weapon_id = nil
		return
	end

	if last_weapon_id and last_weapon_id == wpn:id() then return end
	last_weapon_id = wpn:id()

	local scope_status = get_u32(section, "scope_status", 0)
	local scope_name = scope_status > 1 and get_string(section, "scope_name", nil) or section
	local scope_texture = get_string(scope_name, "scope_texture", nil)

	if scope_texture then
		-- Manool: приоритет поменял на сам ствол вместо прицела. Потому что
		-- стволы разные и один и тот же прицел на разных будет смотреться по-другому.
		-- Надо настраивать для каждого.
		-- scope_control(scope_name, scope_status)
		scope_control(section, scope_status, scope_name)
	end

	-- mark_control(wpn, true)
end

-- NLC: 3d_* keys come from the weapon section first, then from the fitted scope section, then the defaults
-- (docs/SCOPE_PIP_DESIGN.md 1.4). Before, only the weapon section was read.
local function scope_section_of(section, scope_section)
	return function(key)
		if section and sys_ini:section_exist(section) and sys_ini:line_exist(section, key) then return section end
		if scope_section and scope_section ~= section and sys_ini:section_exist(scope_section)
			and sys_ini:line_exist(scope_section, key) then return scope_section end
		return section
	end
end

function scope_control(scope_name, scope_status, scope_section)
	if scope_status < 1 and not scope_name then return end
	local from = scope_section_of(scope_name, scope_section)

	local reticle_size = get_float(from("3d_reticle_size"), "3d_reticle_size", 4)
	local eye_relief = get_float(from("3d_eye_relief"), "3d_eye_relief", 4)
	local exit_pupil = get_float(from("3d_exit_pupil"), "3d_exit_pupil", 0.3)
	local ffp = get_float(from("3d_ffp"), "3d_ffp", 0)

	local scope_zoom_factor = get_float(from("scope_zoom_factor"), "scope_zoom_factor", 1.5)
	local min_zoom = get_float(from("3d_min_zoom"), "3d_min_zoom", 0)
	local zoom_factor = get_float(from("3d_zoom_factor"), "3d_zoom_factor", 1)

	local image_type = get_float(from("3d_image_type"), "3d_image_type", 0)
	local reticle_type = get_float(from("3d_reticle_type"), "3d_reticle_type", 0)
	local dirt_intensity = get_float(from("3d_dirt_intensity"), "3d_dirt_intensity", 0)
	local chroma_power = get_float(from("3d_chroma_power"), "3d_chroma_power", 0.02)

	local lens_color = get_vector(from("3d_lens_color"), "3d_lens_color", vector():set(1, 1, 1))
	local nvg_blur = get_float(from("3d_nvg_blur"), "3d_nvg_blur", 0)

	local mark_number = get_float(from("mark_number"), "mark_number", 0)
	local mark_color = get_vector(from("mark_color"), "mark_color", vector():set(0, 0, 0))

	shader_set_custom_param("s3ds_param_1", reticle_size, eye_relief, exit_pupil, ffp)
	shader_set_custom_param("s3ds_param_2", 0, scope_zoom_factor, min_zoom, zoom_factor)
	shader_set_custom_param("s3ds_param_3", image_type, reticle_type, dirt_intensity, chroma_power)
	shader_set_custom_param("s3ds_param_4", lens_color.x, lens_color.y, lens_color.z, nvg_blur)

	-- NLC: 3d_reticle_lock = 0 keeps the reticle lens-attached (mark_number.y = 1, see 3dss_reticle.ps)
	local reticle_lock = get_float(from("3d_reticle_lock"), "3d_reticle_lock", 1)
	shader_set_custom_param("mark_number", mark_number, reticle_lock < 0.5 and 1 or 0, 0, 0)
	shader_set_custom_param("mark_color", mark_color.x, mark_color.y, mark_color.z)
end

-- [HE-PORT] Radiation ring availability: a proper rad-detecting, non-fake detector
-- equipped in one of the known detector belt slots. Read-only inventory/config check.
local function radiation_ring_available()
	local slots = {8, 13, 14, 15, 16}
	for i = 1, #slots do
		local item = db.actor:item_in_slot(slots[i])
		if item then
			local section = item:section()
			if section and not string.find(section, "_fake", 1, true) then
				if get_bool(section, "detect_actor_radiation", false) then
					return true
				end
			end
		end
	end
	return false
end

-- NLC debug (docs/damage_model/DESIGN_recovery_and_body_status.md 20, 22), console:
-- g_loadstring ogsr_shaders_control.watch_debug(1): paint every watch mesh (mesh map)
-- g_loadstring ogsr_shaders_control.watch_debug(2): body figure always shown, its rect outlined (placement)
-- g_loadstring ogsr_shaders_control.watch_debug(0): off
function watch_debug(on)
	on = tonumber(on) or 0
	shader_set_custom_param("m_he_watch_debug", on == 1 and 1 or 0, on == 2 and 1 or 0, 0, 0)
end

-- page-2 body figure rect in the clock's UV (he_watch_common.h): x, y, w, h. The clock is 0..1 (1.83 : 1 wide), the
-- health bar below it 1.159..1.355; the mask is square, so w = h / 1.83. Clock only: 0.227, 0, 0.546, 1
local body_rect = { 0.13, 0.0, 0.74, 1.355 }
-- console placement while watch_debug(2): g_loadstring ogsr_shaders_control.watch_body_rect(0.13, 0, 0.74, 1.355)
function watch_body_rect(x, y, w, h)
	body_rect = { tonumber(x) or body_rect[1], tonumber(y) or body_rect[2], tonumber(w) or body_rect[3], tonumber(h) or body_rect[4] }
	log2("[ogsr_shaders_control] watch body rect %.3f %.3f %.3f %.3f", body_rect[1], body_rect[2], body_rect[3], body_rect[4])
end

local BODY_PARTS = { "head", "body", "left_arm", "right_arm", "left_leg", "right_leg" }

-- NLC page-2 body figure and adrenaline meter (he_watch_common.h). mode 0 = page 2 as before (both systems off),
-- 1 = injury system only (all parts show the total health), 2 = body health (white and green per part)
local function watch_body(psy)
	local crit_on = sivol_actor_crit ~= nil and sivol_actor_crit.active() and game_options.AdditionalMobHits ~= false
	local body_on = body_health ~= nil and body_health.enabled()
	local mode = body_on and 2 or (crit_on and 1 or 0)
	local w, g = {}, {}
	local total = db.actor.health
	for i, n in ipairs(BODY_PARTS) do
		w[i] = body_on and body_health.part_health(n) or total
		g[i] = (body_on and body_health.green) and body_health.green(n) or 0
	end
	shader_set_custom_param("m_he_watch_body", w[1], w[2], w[3], w[4])
	shader_set_custom_param("m_he_watch_body2", w[5], w[6], mode, 1 - psy)
	shader_set_custom_param("m_he_watch_green", g[1], g[2], g[3], g[4])
	shader_set_custom_param("m_he_watch_green2", g[5], g[6], 0, 0)
	local fill, st = 1, 0
	if crit_on and sivol_adrenaline then fill, st = sivol_adrenaline.meter() end
	shader_set_custom_param("m_he_watch_adrenaline", fill, st, crit_on and 1 or 0, 0)
	shader_set_custom_param("m_he_watch_body_rect", body_rect[1], body_rect[2], body_rect[3], body_rect[4])
end

local function watch_update()
	ogse_signals.get_mgr():reschedule(200)
	if not (db.actor and db.actor:alive()) then return end

	-- m_timearrow2 (compass ring rotation) is owned by he_watch_compass.script.

	-- Shader contract: x = shared interference, y = complete electronic outage.
	local watch_operational = he_watch_status.is_operational()
	shader_set_custom_param("m_he_watch_battery", he_watch_battery.get_charge(),
		(show_battery_icon and watch_gate.has_watch()) and 1 or 0, 0, 0)
	shader_set_custom_param("m_he_watch_effects", he_watch_status.get_interference(),
		watch_operational and 0 or 1, 0, 0)

	-- Psy health drives the upper static outline, independently of HP segments.
	local psy = math.max(0, math.min(1, tonumber(db.actor.psy_health) or 1))
	shader_set_custom_param("m_he_watch_psy", psy, 0, 0, 0)

	local h, m = level.get_time_hours(), level.get_time_minutes()
	if he_watch_ui and he_watch_ui.get_display_time then
		local edit_h, edit_m = he_watch_ui.get_display_time()
		if edit_h ~= nil then
			h, m = edit_h, edit_m
		end
	end
	shader_set_custom_param(
		"m_digiclock",
		math.floor(h / 10) * 0.1,
		(h % 10) * 0.1,
		math.floor(m / 10) * 0.1,
		(m % 10) * 0.1
	)

	-- Preserve a neutral value for any existing packed-shader consumer.
	shader_set_custom_param("m_actor_watch_params_2", 0, 0, 0, 0)

	-- NLC: player limb injuries on the clock face (model_clock.ps): arm / leg level 0..2, head concussion
	local inj_arm, inj_leg, inj_head = 0, 0, 0
	if watch_operational and sivol_actor_crit and sivol_actor_crit.injury_level then
		inj_arm = sivol_actor_crit.injury_level("arm")
		inj_leg = sivol_actor_crit.injury_level("leg")
		inj_head = sivol_actor_crit.injury_level("head")
	end
	shader_set_custom_param("m_he_watch_injury", inj_arm, inj_leg, inj_head, 0)
	watch_body(psy)

	-- x = sleepiness, y = bleeding, z = hydration (1 - thirst), w = satiety
	local slp = sleep_manager.get_sleepiness(108) / 250
	local bld = db.actor:get_bleeding()
	if bld > 0 and bld < 0.11 then bld = 0.11 end
	local hydration = 1 - thirst.get_thirst()
	shader_set_custom_param("m_actor_watch_params", slp, bld, hydration, db.actor.satiety)

	-- Radiation ring contract: x = fill fraction, y = detector available.
	local available = radiation_ring_available() and 1 or 0
	local fraction = db.actor.radiation or 0
	if fraction < 0 then fraction = 0 elseif fraction > 1 then fraction = 1 end
	shader_set_custom_param("m_he_watch_ring", fraction, available, 0, 0)

	-- Alarm contract: x = enabled, y = editor active, z/w = saved hour/minute.
	local enabled, editing = 0, 0
	local cfg = vergas_watch and vergas_watch.g_watch and vergas_watch.g_watch:alarm_config()
	if cfg and cfg.f then enabled = 1 end
	if he_watch_ui and he_watch_ui.is_active and he_watch_ui.is_active() then editing = 1 end
	local alarm_h = cfg and math.floor(tonumber(cfg.h) or 0) % 24 or 0
	local alarm_m = cfg and math.floor(tonumber(cfg.m) or 0) % 60 or 0
	shader_set_custom_param("m_he_watch_alarm", enabled, editing, alarm_h, alarm_m)
end

local function on_key(key, bind)
	local res
	if key == DIK_keys.DIK_O then
		local v = shader_get_custom_param_vector("s3ds_param_1")
		v.x = v.x + 0.1
		res = v.x
		shader_set_custom_param_vector("s3ds_param_1", v)
	end
	if key == DIK_keys.DIK_I then
		local v = shader_get_custom_param_vector("s3ds_param_1")
		v.x = v.x - 0.1
		res = v.x
		shader_set_custom_param_vector("s3ds_param_1", v)
	end
	if res then
		log2("3d_reticle_size = %s", res)
	end
end

-- NLC: 2D texture scopes get crookr's screen lens pass (engine phase_fakescope: eye box that trails fast
-- camera motion, dimmed and blurred surroundings, chromatic edge; docs/SCOPE_PIP_DESIGN.md 5).
-- fake_scope_radius is non-zero only while a 2D-texture scope is zoomed. Radius per weapon or scope section
-- (fake_scope_radius key) or the default; the console command tunes it live until the next zoom.
local FAKESCOPE_DEFAULT_RADIUS = 0.37
fakescope_enabled = true
local fakescope_radius_set = -1
local fakescope_params_set = false

local function set_fakescope_radius(radius)
	if math.abs(radius - fakescope_radius_set) < 0.0001 then return end
	fakescope_radius_set = radius
	get_console():execute(string.format("fake_scope_radius %.4f", radius))
end

-- Live tuning: fl ogsr_shaders_control.fakescope_radius(0.4) applies to every 2D scope this session (also logged);
-- fl ogsr_shaders_control.fakescope_radius() returns to the configured values. While zoomed, the console command
-- fake_scope_radius also works directly until the next zoom.
local fakescope_radius_override = nil
function fakescope_radius(radius)
	radius = tonumber(radius)
	fakescope_radius_override = radius and radius > 0 and radius or nil
	fakescope_radius_set = -1
	log2("[fakescope] radius override = %s", tostring(fakescope_radius_override))
end

local function update_fakescope()
	local radius = 0
	local actor = db.actor
	local item = fakescope_enabled and actor and actor:alive() and actor:active_item()
	local wpn = item and item:get_weapon()
	if wpn and wpn.zoom_mode and wpn:UseScopeTexture() then
		local section = item:section()
		radius = get_float(section, "fake_scope_radius", 0)
		local scope = wpn.scope_name
		if radius <= 0 and scope and scope ~= "" and sys_ini:section_exist(scope) then
			radius = get_float(scope, "fake_scope_radius", 0)
		end
		if radius <= 0 then radius = FAKESCOPE_DEFAULT_RADIUS end
		if fakescope_radius_override then radius = fakescope_radius_override end
		if not fakescope_params_set then
			-- power 1 = no zoom on top of the camera's; no blur inside; blurred, dimmed surroundings
			get_console():execute("fake_scope_power 1")
			get_console():execute("fake_scope_params_1 0,0.6,0.85,0")
			fakescope_params_set = true
		end
	end
	set_fakescope_radius(radius)
end

function attach(sm)
	sm:subscribe({signal = "on_update", fun = watch_update})
	sm:subscribe({signal = "on_update", fun = on_dots_update})
	sm:subscribe({signal = "on_update", fun = update_fakescope})
	-- sm:subscribe({signal = "on_key", fun = on_key})
end