-- [HE-PORT]
function attach(sm)
	sm:subscribe({ signal = "on_body_open", fun = this.on_body_open })
end

function on_body_open()
	local box = level.get_car_body_target()
	if box then on_take_item_from_box(box) end
end

function on_take_item_from_box(box)
	if not box or box:section() ~= "rucksack" then return end
	local id = box:id()
	dsh.timeout(100, function() try_pickup(id) end)
end

function try_pickup(id)
	local box = level.object_by_id(id)
	if not box or box:section() ~= "rucksack" or box:parent() then return end
	local cont = box:get_container()
	if not cont or not cont:empty() then return end
	if has_alife_info("ui_car_body") then sak.close_window() end
	box:transfer_item(box, db.actor)
end
