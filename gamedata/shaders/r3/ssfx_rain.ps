/**
 * @ Description: Rain - refraction buffer without rain ( 1/8 res )
 * @ Based on: SCREEN SPACE SHADERS - UPDATE 22 ssfx_rain.ps ( https://www.moddb.com/members/ascii1457 )
 * @ NLC: 2026-10-13 ( .85 ). The current HDR scene ( before the forward pass ) plus the volumetric light, so rain
 *        streaks catch lamp and torch beams. ssfx_rain_vol.x: volumetrics drawn this frame, .y: second target
 *        ( full-size spot volumetrics; the reduced path keeps sun and spot in one target ).
 */

#include "common.h"

Texture2D ssfx_color_buffer;
Texture2D volumetric_buffer;
Texture2D volumetric_buffer2;

uniform float4 ssfx_rain_vol;

float4 main(p_screen I) : SV_Target
{
    float2 size;
    ssfx_color_buffer.GetDimensions(size.x, size.y);
    float2 HalfPixel = (8.0f / size) * 2.0f;

    const float2 Coords[4] = {float2(-HalfPixel.x, HalfPixel.y), float2(HalfPixel.x, HalfPixel.y), float2(HalfPixel.x, -HalfPixel.y), float2(-HalfPixel.x, -HalfPixel.y)};

    float3 Color = ssfx_color_buffer.SampleLevel(smp_rtlinear, I.tc0, 0).rgb * 4.0f;
    [unroll] for (int x = 0; x < 4; x++)
        Color += ssfx_color_buffer.SampleLevel(smp_rtlinear, I.tc0 + Coords[x], 0).rgb;
    Color /= 8.0f;

    // Volumetric light: drops inside a beam scatter it ( alpha: beam strength for effects_rain.ps, rgb: its colour )
    float3 Vol = volumetric_buffer.SampleLevel(smp_rtlinear, I.tc0, 0).rgb + volumetric_buffer2.SampleLevel(smp_rtlinear, I.tc0, 0).rgb * ssfx_rain_vol.y;
    Vol *= ssfx_rain_vol.x;
    float beam = saturate(dot(Vol, LUMINANCE_VECTOR) * 4.0f);

    return float4(Color + Vol * 2.0f, beam);
}
