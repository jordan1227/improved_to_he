/**
 * @ Version: SCREEN SPACE SHADERS - UPDATE 21
 * @ Description: Water Shader
 * @ Modified time: 2024-11-29 06:58
 * @ Author: https://www.moddb.com/members/ascii1457
 * @ Mod: https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders
 * @ NLC: 2026-10-12 - OGSR port. Without SSFX_WATER_PASS this file is the OGSR water ( water.ps ), unchanged.
 *        With it: reflections from the prepass ( $user$ssfx_water_a blurred, $user$ssfx_water sharp ), parallax
 *        waves, wind layer; OGSR water VS output ( watermove kept ); ssfx_compare 1 runs the OGSR water.
 *        2026-10-12 test fixes: refraction / reflection offsets scaled like the OGSR water ( full SSS offsets
 *        shimmered and smeared the reflections ), 0.1 m soft border, turbidity colour as OGSR ( not linearised ),
 *        height fog with the world height ( SSS and OGSR passed the height relative to the camera ). Variants keep their OGSR defines
 *        ( ssfx_water_regular / _ryaska / _studen / _underground ).
 */

#ifndef SSFX_WATER_PASS

#include "water.ps"

#else // SSFX_WATER_PASS

// OGSR water as a function, for ssfx_compare
#define main ssfx_water_old
#include "water.ps"
#undef main

#include "settings_screenspace_SSFX_WATER.h"

#if defined(SSFX_FOG) && defined(SSFX_GROUND_MIST)
#include "ssfx_mist.h" // NLC .84: ground mist
#endif
#ifdef SSFX_FOG_SUN
#include "ssfx_fog_sun.h" // NLC: same fog colour as the terrain behind the water
#endif

#ifdef SSFX_STEP_RIPPLES
#include "ssfx_step_ripples.h" // NLC: footstep ripples
#endif

Texture2D s_ssfx_water_nmap; // fx\ssfx_water_normal ( SSS 23 )
Texture2D s_ssfx_water_wind; // fx\ssfx_water_wind
Texture2D s_ssfx_water_perlin; // water\ssfx_water_perlin
Texture2D s_ssfx_water_refl; // $user$ssfx_water_a: blurred reflection
Texture2D s_ssfx_water_sharp; // $user$ssfx_water: unblurred reflection
Texture2D s_ssfx_water_height; // $user$ssfx_water_waves

uniform float4 ssfx_water; // x: resolution divider, y: blur, z: reflection strength
uniform float4 ssfx_compare;
uniform float4 wind_params; // x: direction, y: velocity

static const int ssfx_parallax_steps[4] = {0, 8, 16, 32};

float3 Water_DoParallax(float2 tc, float2 tc_step, float _step, Texture2D height_tex, float height_scale)
{
    float curr_step = 0;
    float2 parallax_tc = tc;

    float prev_Height = 0;
    float curr_Height = 0;
    float curr_Sam = 0;

    [loop] for (int i = 0; i < 64; i++) // basic step parallax ( ends when the ray is under the surface )
    {
        prev_Height = curr_Height;

        parallax_tc -= tc_step;
        curr_step += _step;

        curr_Sam = height_tex.SampleLevel(smp_base, parallax_tc * height_scale, 0).x;
        curr_Height = 1.0f - curr_Sam;

        if (curr_Height <= curr_step)
            break;
    }

    // [ POM ] Interpolation between the previous offset and the current offset
    float currentDiff = curr_Height - curr_step;
    float ratio = currentDiff / (currentDiff - saturate(prev_Height - curr_step + _step));

    return float3(lerp(parallax_tc, parallax_tc + tc_step, ratio), curr_Sam);
}

// Reflection buffer sample; falls back to the centre where the offset lands outside the water
float3 ssfx_water_reflection(Texture2D buffer, float2 tc, float2 offset)
{
    float4 r = buffer.SampleLevel(smp_rtlinear, saturate(tc + offset), 0);
    return r.a > 0.5f ? r.rgb : buffer.SampleLevel(smp_rtlinear, tc, 0).rgb;
}

float4 main(vf I) : SV_Target
{
    if (ssfx_compare.x > 0)
        return ssfx_water_old(I);

    // Wind data
    float r = wind_params.x + 1.57079f;
    float2 Wind_Dir = float2(cos(r), sin(r));
    float Wind_Int = saturate(wind_params.y * 0.001);
    float anim_time = timers.x;

    // Waves speed
    float TimeSpeed = clamp(0.97f * Wind_Int, 0.45f, 0.97f);

    // 3d view space pos reconstruction math
    float3 Pv = float3(I.tctexgen.z * (I.hpos.xy * pos_decompression_params.zw - pos_decompression_params.xy), I.tctexgen.z);

    float dist_att = 1.0 - smoothstep(G_SSFX_WATER_PARALLAX_DISTANCE * 0.6f, G_SSFX_WATER_PARALLAX_DISTANCE, Pv.z);

    // SSS 23 water UV scale
    float2 tbase = I.tbase * 1.5f;

    // PARALLAX -------------------------------------------------------------------
#if SSFX_WATER_PARALLAX > 0

    float3 eye = normalize(mul(float3x3(I.M1.x, I.M2.x, I.M3.x, I.M1.y, I.M2.y, I.M3.y, I.M1.z, I.M2.z, I.M3.z), -I.v2point_w.xyz));

    float view_angle = abs(dot(float3(0.0, 0.0, 1.0), eye));

    // Dynamic steps ( 1.0 / step count ), one step beyond the parallax distance
    float _step = rcp(lerp(ssfx_parallax_steps[SSFX_WATER_PARALLAX], 1, view_angle));
    _step = dist_att <= 0 ? 1 : _step;

    float2 viewdir = eye.xy / eye.z;
    float2 tc_step = _step * viewdir * clamp(G_SSFX_WATER_PARALLAX_HEIGHT * Wind_Int, 0.015f, G_SSFX_WATER_PARALLAX_HEIGHT);

    float3 tc_parallax = Water_DoParallax(tbase, tc_step, _step, s_ssfx_water_height, 0.35f);

#else

    float3 tc_parallax = float3(tbase + (anim_time * float2(0.065f, 0.445f) * TimeSpeed), 0);

#endif
    // ----------------------------------------------------------------------------

    // Normal textures
    float3 n_tc = tc_parallax;

    float3 n0 = s_ssfx_water_nmap.Sample(smp_base, n_tc.xy + (anim_time * float2(0.23f, 0.10f) * TimeSpeed)).rgb;
    float3 n1 = s_ssfx_water_nmap.Sample(smp_base, n_tc.xy - (anim_time * float2(0.21f, 0.28f) * TimeSpeed)).rgb;

    // Wind layer
    float2 wind_layer = s_ssfx_water_wind.Sample(smp_base, n_tc.xy * 0.1f + (Wind_Dir * Wind_Int * anim_time * 0.1f)).rg;
    n0.xy = lerp(n0.xy, wind_layer.xy, 0.1f * Wind_Int);

    // Waves normal
    float3 Waves_Normal = n0 * 2.0f - 1.0f;
    Waves_Normal.xy += float2(0.095f, 0.088f);

    float2 Wave_Int = 0;
    Wave_Int.x = clamp(0.1f * Wind_Int, 0.03f, 0.1f);
    Wave_Int.y = clamp(0.2f * Wind_Int, 0.1f, 0.2f);
    Waves_Normal = normalize(float3(Waves_Normal.xy * Wave_Int.xy * G_SSFX_WATER_DISTORTION, Waves_Normal.z));

    // Prepare stuff --------------------------------------------------------------
    float2 PosTc = I.tctexgen.xy / I.tctexgen.z;

    float4 P = s_position.Sample(smp_nofilter, PosTc);
    float4 C = s_diffuse.Sample(smp_nofilter, PosTc);

    // Water surface to world space
    float3 w_s = mul(m_inv_V, Pv);

    // Rain intensity. Fadeout and rain cover
    float is_raining = rain_params.x > 0 ? 1.0f : 0.0f;
    float RainInt = clamp(rain_params.x * 1.6f, 0.65f * is_raining, 1.0f);

    // Ripples normal
    float2 Ripples = ssfx_rain_ripples(s_rainsplash, n_tc.xy * 0.6f, float3(RainInt, G_SSFX_WATER_RIPPLES, 15.0f), P.z);
    Waves_Normal += float3(Ripples, 0) * is_raining;

#ifdef SSFX_STEP_RIPPLES
    float2 step_rip = ssfx_step_ripples(w_s + eye_position);
    Waves_Normal.xy += step_rip;
#endif

    // Water wave intensity
    float3 Navg = ((n0 + n1) * 0.5) * 2.0f - 1.0f;
    Navg += float3(0.1f, 0.1f, 0.1f) + float3(Ripples, 0) * is_raining;
#ifdef SSFX_STEP_RIPPLES
    Navg.xy += step_rip * 4.0f;
#endif
    Navg.xy *= 0.5f;

    float3 Nw = mul(float3x3(I.M1, I.M2, I.M3), Navg);
    Nw = normalize(Nw);

    float3 v2point = normalize(I.v2point_w);
    float3 vreflect = reflect(v2point, Nw.xyz);

    // Refractions normal ( used by shadows and refraction ), OGSR strength
    float2 N_Scr = Waves_Normal.xy * G_SSFX_WATER_REFRACTION;

    // Discard refractions from things above the water ( like weapons )
    float Refraction_Discard = Pv.z < SSFX_get_depth(PosTc + N_Scr, 0);
    float2 Refraction_UV = N_Scr * Refraction_Discard;

    // Bottom of the water in view and world space ( caustics and water fog )
    P.xyz = float3(P.z * (I.hpos.xy * pos_decompression_params.zw - pos_decompression_params.xy), P.z);
    float3 w_p = mul(m_inv_V, float4(P.xyz, 1));

    // Shadows to do some tricks
    float water_shadows = saturate(s_accumulator.Sample(smp_nofilter, PosTc + Refraction_UV).r * 2000);

    // Fresnel
    float fresnel = saturate(dot(vreflect, v2point));
    float fresnel_amount = pow(fresnel, 3.0);

    // Sun colour
    float test_sun = dot(L_sun_color.rgb, 0.5f);

    // Caustics offset anim
    float4 CausticsT = float4(anim_time * 0.1f, 0.0f, -anim_time * 0.07f, 0.2f);

    // Fake caustics
    float sun_int = smoothstep(0.3f, 1.0f, test_sun);
    float3 Ca0 = saturate(s_watercaustics.Sample(smp_base, w_p.xz * (0.19f / G_SSFX_WATER_CAUSTICS_SCALE) + CausticsT.xy) - 0.1f);
    float3 Ca1 = saturate(s_watercaustics.Sample(smp_base, w_p.xz * (0.11f / G_SSFX_WATER_CAUSTICS_SCALE) + CausticsT.zw) - 0.1f);
    float3 CA = min(Ca0, Ca1) * water_shadows * sun_int * G_SSFX_WATER_CAUSTICS;

#ifdef NEED_SPECULARS
    // Specular ( flattened water normal )
    float3 Nf = normalize(float3(Nw.x, Nw.y * G_SSFX_WATER_SPECULAR_NORMAL, Nw.z));
    float3 spec = L_sun_color.rgb * pow(abs(dot(normalize(v2point + L_sun_dir_w), Nf)), 512) * saturate(test_sun) * G_SSFX_WATER_SPECULAR;
#else
    float3 spec = 0;
#endif

    // Reflection -----------------------------------------------------------------
    float2 refl_offset = Waves_Normal.xy * G_SSFX_WATER_REFL_DISTORTION;
    float3 reflection = ssfx_water_reflection(s_ssfx_water_refl, PosTc, refl_offset);
    float3 refle_no_blur = ssfx_water_reflection(s_ssfx_water_sharp, PosTc, refl_offset);

    float water_perlin = s_ssfx_water_perlin.Sample(smp_linear, (w_s.xz + eye_position.xz + Nw.xy * 100) * 0.02f).r;

    // Clear <-> blurry
    reflection = lerp(reflection, refle_no_blur, saturate(water_perlin));
    reflection = vibrance(reflection, G_SSFX_WATER_VIBRANCE);

    // Add everything -------------------------------------------------------------

    // Water depth
    float waterDepth = w_s.y - w_p.y + eye_position.y;

    // Water fog
    float waterFog = exp(waterDepth + n_tc.z * 0.1f) - 1.0f;

    // Screen buffer
    float3 screen = SSFX_get_image(PosTc + Refraction_UV, 0);

    // Base texture * vertex light ( as the OGSR water )
    float3 base_tex = s_base.Sample(smp_base, (w_s.xz + eye_position.xz) * 0.1f + Waves_Normal.xy).rgb;
    base_tex *= I.c0.rgb;

    // Mix refraction ( 100% clear water ) & base texture ( turbidity )
    float3 turbidity = lerp(base_tex, screen, smoothstep(G_SSFX_WATER_FOG_MAXDEPTH, -G_SSFX_WATER_TURBIDITY, waterFog));

    // Water result and reflection
    float3 acc = lerp(turbidity, reflection, saturate(fresnel_amount * G_SSFX_WATER_REFLECTION * ssfx_water.z));

    // Caustics. Fade through water fog
    acc = acc + CA * smoothstep(G_SSFX_WATER_FOG_MAXDEPTH + 0.5f, 0.0f, waterFog) * saturate(waterFog * 3.0f);

    // Specular
    acc += spec * water_shadows;

    // Fogging
#ifdef SSFX_FOG
    float fogging = SSFX_FOGGING(1.0 - I.fog, w_s.y + eye_position.y); // w_s has no translation: world height
#ifdef SSFX_GROUND_MIST
    // NLC .84: ground mist over the water, as combine
    fogging = saturate(fogging - ssfx_mist(w_s + eye_position, length(w_s), smoothstep(G_FOG_HEIGHT, -G_FOG_HEIGHT, w_s.y + eye_position.y) * G_FOG_HEIGHT_INTENSITY));
#endif
#else
    float fogging = I.fog;
#endif
#ifdef SSFX_FOG_SUN
    acc = lerp(ssfx_fog_color_sun(normalize(I.v2point_w)), acc, fogging);
#else
    acc = lerp(fog_color, acc, fogging);
#endif

    // Far water fades into the scene behind it ( as the OGSR water alpha )
    acc = lerp(screen, acc, fogging * fogging);

    // NLC: soft border as the OGSR water ( SSS cut everything shallower than 0.1 m, so shallow ponds vanished )
    return float4(acc, smoothstep(0.0, G_SSFX_WATER_SOFTBORDER, waterDepth));
}

#endif // SSFX_WATER_PASS
