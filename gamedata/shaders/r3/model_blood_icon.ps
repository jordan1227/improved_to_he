/*
	Watch shader - bleeding icon
	
	Current issues: None (i think)
*/
#include "common.h"
#include "watch_ui_common.h"
#include "electronics_problems.h"
#include "he_watch_common.h"

Texture2D s_he_psy; // existing act/watch/icon_thirst2, ten 200x200 frames
uniform float4 m_he_watch_psy; // x = psy health

// float4 m_actor_params; //x = health, y = outfit cond, z = wpn cond, w = wpn_loading

struct v2p
{
 	float2 tc0	: TEXCOORD0; //Base texture coordinates
 	float3 tc1	: TEXCOORD1; //Unused
  	float4 c0	: COLOR0; //Light color + fog
};

float get_noise(float2 co)
{
	return (frac(sin(dot(co.xy, float2(12.9898,78.233))) * 43758.5453))*0.5;
}

float3 sample_watch_stat(float2 uv, bool psy_icon)
{
    //Color and other settings
    float4 background_col = float4(16.0, 18.0, 20.0, 255.0) / 255.0; //Background color
	float f_min = 0.0; //Lowest value of X

	//Sample bar texture
	float val = psy_icon ? 1.0 - saturate(m_he_watch_psy.x) : m_actor_watch_params.y;
	uv = cond_icon(uv, val);
	float4 t_base = psy_icon ? s_he_psy.SampleLevel(smp_base, uv, 0) : s_base.SampleLevel(smp_base, uv, 0); //force mip 0

	//Blending factor
	float factor = val > f_min ? saturate(sin(timers.x * 10.0 * val)) : saturate(sin(timers.x * 9.0 * electronics_problems.x));

	//Simple flickering
	t_base.xyz = lerp(background_col.xyz, t_base.xyz, max(ElectronicsProblemsBlackout() ? 0.f : factor, 0.2));

	float brightness = 1.f;
	brightness *= calc_glitch_brightness_watch_ui(brightness);
	t_base.xyz = lerp(watchBgColor(), t_base.xyz, brightness);

	//Output

	return t_base.xyz;
}
float4 main(v2p I) : SV_Target
{
    float2 uv = he_watch_distort_uv(I.tc0);
    // Alarm editing always shows the normal bleeding icon.
    float slide = m_he_watch_alarm.y > 0.5 ? 0.0 : saturate(m_he_watch_page.y);
    float3 color = watchBgColor();
    float2 bleed_uv = uv + float2(slide, 0.0);
    float2 psy_uv = uv - float2(1.0 - slide, 0.0);
    // Clip in LOCAL icon coordinates before mapping to either ten-frame atlas.
    // Compose one background rather than adding two opaque texture rectangles.
    if (slide < 1.0 && all(bleed_uv >= 0.0) && all(bleed_uv <= 1.0))
        color = sample_watch_stat(bleed_uv, false);
    if (slide > 0.0 && all(psy_uv >= 0.0) && all(psy_uv <= 1.0))
        color = sample_watch_stat(psy_uv, true);
    return float4(he_watch_apply_signal(color, I.tc0), 1.0);
}
