/*
	Watch shader - bleeding icon
	
	Current issues: None (i think)
*/
#include "common.h"
#include "watch_ui_common.h"
#include "electronics_problems.h"
#include "he_watch_common.h"

Texture2D s_he_psy; // existing act/watch/icon_thirst2, ten 200x200 frames
uniform float4 m_he_watch_psy; // x = psy health

// NLC: player limb injuries (sivol_actor_crit via ogsr_shaders_control.script) share the bleeding slot
// (m_he_watch_injury in he_watch_common.h).
Texture2D s_he_injury; // act\\watch\\icon_injury, 64x64: R head, G arms, B legs, A whole figure

// float4 m_actor_params; //x = health, y = outfit cond, z = wpn cond, w = wpn_loading

struct v2p
{
 	float2 tc0	: TEXCOORD0; //Base texture coordinates
 	float3 tc1	: TEXCOORD1; //Unused
  	float4 c0	: COLOR0; //Light color + fog
};

float get_noise(float2 co)
{
	return (frac(sin(dot(co.xy, float2(12.9898,78.233))) * 43758.5453))*0.5;
}

float3 sample_watch_stat(float2 uv, bool psy_icon)
{
    //Color and other settings
    float4 background_col = float4(16.0, 18.0, 20.0, 255.0) / 255.0; //Background color
	float f_min = 0.0; //Lowest value of X

	//Sample bar texture
	float val = psy_icon ? 1.0 - saturate(m_he_watch_psy.x) : m_actor_watch_params.y;
	uv = cond_icon(uv, val);
	float4 t_base = psy_icon ? s_he_psy.SampleLevel(smp_base, uv, 0) : s_base.SampleLevel(smp_base, uv, 0); //force mip 0

	//Blending factor
	float factor = val > f_min ? saturate(sin(timers.x * 10.0 * val)) : saturate(sin(timers.x * 9.0 * electronics_problems.x));

	//Simple flickering
	t_base.xyz = lerp(background_col.xyz, t_base.xyz, max(ElectronicsProblemsBlackout() ? 0.f : factor, 0.2));

	float brightness = 1.f;
	brightness *= calc_glitch_brightness_watch_ui(brightness);
	t_base.xyz = lerp(watchBgColor(), t_base.xyz, brightness);

	//Output

	return t_base.xyz;
}
// NLC: injury figure in the bleeding slot: dim body, light injury amber, severe red pulsing
float3 sample_injury(float2 uv)
{
	float3 background = float3(16.0, 18.0, 20.0) / 255.0;
	float4 m = s_he_injury.SampleLevel(smp_base, uv, 0);
	float3 severe = float3(1.0, 0.22, 0.12) * lerp(0.3, 1.0, he_watch_alarm_pulse());
	float3 col = lerp(background, float3(0.45, 0.50, 0.45), m.a * 0.8);
	if (m_he_watch_injury.z > 0.5) col = lerp(col, m_he_watch_injury.z > 1.5 ? severe : he_watch_alarm_amber, m.r);
	if (m_he_watch_injury.x > 0.5) col = lerp(col, m_he_watch_injury.x > 1.5 ? severe : he_watch_alarm_amber, m.g);
	if (m_he_watch_injury.y > 0.5) col = lerp(col, m_he_watch_injury.y > 1.5 ? severe : he_watch_alarm_amber, m.b);
	if (ElectronicsProblemsBlackout()) col = background;

	float brightness = 1.f;
	brightness *= calc_glitch_brightness_watch_ui(brightness);
	return lerp(watchBgColor(), col, brightness);
}

float4 main(v2p I) : SV_Target
{
	if (m_he_watch_debug.x > 0.5) return he_watch_debug_map(I.tc0, float3(0.1, 1.0, 0.1)); // NLC mesh map (he_watch_common.h)
    float2 uv = he_watch_distort_uv(I.tc0);
    // Alarm editing always shows the normal bleeding icon.
    // NLC: no slide with the body figure: the bleeding icon fades into the page-2 radiation number instead
    float slide = (m_he_watch_alarm.y > 0.5 || m_he_watch_body2.z > 0.5) ? 0.0 : saturate(m_he_watch_page.y);
    float3 color = watchBgColor();
    float2 bleed_uv = uv + float2(slide, 0.0);
    float2 psy_uv = uv - float2(1.0 - slide, 0.0);
    // Clip in LOCAL icon coordinates before mapping to either ten-frame atlas.
    // Compose one background rather than adding two opaque texture rectangles.
    // NLC: while injured the slot shows the injury figure; bleeding at the same time alternates every 2 s
    bool injured = any(m_he_watch_injury.xyz > 0.5) && m_he_watch_alarm.y < 0.5;
    bool show_injury = injured && (m_actor_watch_params.y <= 0.0 || frac(timers.x * 0.25) >= 0.5);
    if (slide < 1.0 && all(bleed_uv >= 0.0) && all(bleed_uv <= 1.0))
        color = show_injury ? sample_injury(bleed_uv) : sample_watch_stat(bleed_uv, false);
    bool page2_body = m_he_watch_body2.z > 0.5;
    if (!page2_body && slide > 0.0 && all(psy_uv >= 0.0) && all(psy_uv <= 1.0))
        color = sample_watch_stat(psy_uv, true);
    // NLC: page 2 with the body figure: its share of the radiation number (he_watch_common.h, tile in clock UV)
    if (page2_body)
        color = he_watch_page2(color, float2(0.2937 * I.tc0.x + 0.0322, 0.5384 * I.tc0.y + 1.9168), false);
    return float4(he_watch_apply_signal(color, I.tc0), 1.0);
}
