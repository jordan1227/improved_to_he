/**
 * @ Description: HUD glass ( watch glass, model_hud_glass.s ) with rain drops
 * @ NLC: 2026-10-13. model_env_lq.ps plus the SSS 17 HUD rain drops: drops bend the reflection and add highlights and
 *        a little opacity where they sit. Intensity ssfx_hud_drops_1.y ( rain and cover, so none under a roof ).
 */

#include "common.h"
#include "screenspace_hud_raindrops.h"

struct v2p
{
    float2 tc0 : TEXCOORD0; // base
    float3 tc1 : TEXCOORD1; // environment
    float3 c0 : COLOR0; // sun
    float fog : FOG;
};

TextureCube s_env; // Environment for forward rendering

float4 main(v2p I) : SV_Target
{
    float drop_hl = 0;
    if (ssfx_hud_drops_1.y > 0)
    {
        float4 Layer0 = s_hud_rain.Sample(smp_base, (I.tc0 + float2(0, -ssfx_hud_drops_1.x * 0.01f)) * 1.0f);
        float4 Layer1 = s_hud_rain.Sample(smp_base, I.tc0 * 2.5f);
        float3 drops = ssfx_process_drops(Layer0, 0.1f, 0.4f) + ssfx_process_drops(Layer1, 0.2f, 1.0f);
        drops.xy = clamp(drops.xy, -1.0f, 1.0f);
        drops *= ssfx_hud_drops_1.y;
        I.tc1.xz += drops.xy * 0.3f; // drops bend the reflection
        drop_hl = saturate(drops.z);
    }

    float4 t_base = s_base.Sample(smp_base, I.tc0);
    float4 t_env = s_env.Sample(smp_rtlinear, I.tc1);

    float3 base = lerp(t_env, t_base, t_base.a);
    float3 light = I.c0;
    float3 final = light * base * 2;
    final += light * t_env.rgb * drop_hl * 0.8f; // wet highlights

    final = lerp(fog_color, final, I.fog);

    return float4(final, saturate(t_base.a + drop_hl * 0.35f) * I.fog * I.fog);
}
