/**
 * @ Description: Anomaly haze pass ( docs/ANOMALY_HAZE_DESIGN.md ), one draw per volume, see ssfx_haze.h
 * @ NLC: 2026-11-14
 */

#include "common.h"
#include "ssfx_haze.h"

float4 main(p_screen I) : SV_Target
{
    // Split view ( ssfx_fog_split or ssfx_haze_split ): no haze on the left half
    if (haze_p9.z > 0.5f && I.hpos.x < screen_res.x * 0.5f)
        discard;

    float depth = s_position.Sample(smp_nofilter, I.tc0).z;

    // View ray through this pixel ( TAA jitter removed as gbuffer_load_position does )
    float2 pos2d = I.hpos.xy - m_taa_jitter.xy * float2(0.5f, -0.5f) * pos_decompression_params2.xy;
    float3 Pv = float3(pos2d * pos_decompression_params.zw - pos_decompression_params.xy, 1.0f);
    float scene = depth > SKY_EPS ? depth * length(Pv) : 100000.0f;
    float3 dir = normalize(mul(m_inv_V, float4(Pv, 0.0f)).xyz);

    return ssfx_haze_eval(eye_position, dir, scene, I.hpos.xy);
}
