/*
	Watch shader - thirst icon

	Current issues: Fucking remapping of thirst values.	
*/
#include "common.h"
#include "watch_ui_common.h"
#include "electronics_problems.h"
#include "he_watch_common.h"

// float4 m_actor_params; //x = health, y = outfit cond, z = wpn cond, w = wpn_loading

struct v2p
{
 	float2 tc0	: TEXCOORD0; //Base texture coordinates
 	float3 tc1	: TEXCOORD1; //Unused
  	float4 c0	: COLOR0; //Light color + fog
};

float get_noise(float2 co)
{
	return (frac(sin(dot(co.xy, float2(12.9898,78.233))) * 43758.5453))*0.5;
}

float4 main(v2p I) : SV_Target
{
	if (m_he_watch_debug.x > 0.5) return he_watch_debug_map(I.tc0, float3(0.1, 1.0, 1.0)); // NLC mesh map (he_watch_common.h)
    float2 he_face_uv = I.tc0;
    I.tc0 = he_watch_distort_uv(I.tc0);
    //Color and other settings
    float4 background_col = float4(16.0, 18.0, 20.0, 255.0) / 255.0; //Background color
	float f_min = 0.15; //Lowest value of X

	//Sample bar texture
	float val = 1.0-m_actor_watch_params.z;
	I.tc0 = cond_icon(I.tc0, val);
	float4 t_base = s_base.Sample(smp_base, I.tc0);

	//Blending factor
	float factor = val > f_min ? saturate(sin(timers.x * 10.0 * val)) : saturate(sin(timers.x * 6.0 * electronics_problems.x));

	//Simple flickering
	t_base.xyz = lerp(background_col.xyz, t_base.xyz, max(ElectronicsProblemsBlackout() ? 0.f : factor, 0.2));

	float brightness = 1.f;
	brightness *= calc_glitch_brightness_watch_ui(brightness);
	t_base.xyz = lerp(watchBgColor(), t_base.xyz, brightness);

	//Output

	// NLC: page 2 with the body figure: its share of the radiation number (he_watch_common.h, tile in clock UV)
	t_base.xyz = he_watch_page2(t_base.xyz, float2(0.2937 * he_face_uv.x + 0.3530, 0.5384 * he_face_uv.y + 1.9168), false);
	return float4(he_watch_apply_signal(t_base.xyz, he_face_uv), 1.0);
}