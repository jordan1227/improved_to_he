/**
 * @ Description: Indirect light - blur ( IL resolution )
 * @ Based on: SCREEN SPACE SHADERS - UPDATE 21 ssfx_il_blur.ps ( https://www.moddb.com/members/ascii1457 )
 * @ NLC: 2026-10-12 - runs at the IL target size, so no subrect clamping is needed.
 */

#include "common.h"

#ifndef G_IL_BLUR_SAMPLES
#define G_IL_BLUR_SAMPLES 4
#endif

uniform float4 blur_setup; // x: res divider, y: radius, zw: IL target size

Texture2D ao_image;

static const float2x2 ssfx_il_rotation = {-0.666276f, 0.745705f, -0.745705f, -0.666276f};

float4 main(p_screen I) : SV_Target
{
    float2 tc = I.tc0.xy;

    float2 buffer_pixel_size = 1.0f / blur_setup.zw;
    float2 offset = blur_setup.yy;

    float4 blur = 0; // NLC: alpha = flashlight bounce
    float r = 2.0f;

    [unroll(G_IL_BLUR_SAMPLES)]
    for (int i = 0; i < G_IL_BLUR_SAMPLES; i++)
    {
        r += 1.0f / r;
        offset = mul(offset, ssfx_il_rotation);

        blur += ao_image.SampleLevel(smp_rtlinear, saturate(tc + offset * (r - 1.0f) * buffer_pixel_size), 0);
    }
    blur /= G_IL_BLUR_SAMPLES;

    return blur;
}
