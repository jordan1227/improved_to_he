#include "common.h"

uniform float4 m_hud_params;

uniform float4 fakescope;
uniform float4 m_flare_params;

// Check Screen Space Shaders modules
#include "check_screenspace.h"

#ifdef SSFX_BEEFS_NVG
#include "night_vision.h"
#endif

#ifdef SSFX_DEBAND
#include "screenspace_debanding.h"
#endif

#if defined(SSFX_INDIRECT_LIGHT) && !defined(SSFX_IL_PASS) // NLC: replaced by the SSS 23 IL pass
#include "screenspace_il.h"
#endif

#include "img_corrections.h"
#include "effects_flare.h"

#include "mblur.h"

#include "nlc_psy_vision.h" // NLC: low psy health edge tunnel
#include "nlc_flytrap.h" // NLC: Flytrap stasis anomaly lens + colour fringe

Texture2D s_flares;
#ifdef SSFX_BLOOM
Texture2D s_ssfx_bloom;
#endif

float4 main(p_screen I) : SV_Target
{
    float2 center = I.tc0;

    float3 _P = gbuffer_load_position(center, I.hpos);

    float depth = _P.z;

    float3 img = s_image.Load(int3(center.xy * screen_res.xy, 0), 0);

#ifdef USE_MBLUR
    img = mblur(center, _P, img.rgb);
#endif

    // Indirect light - SCREEN SPACE SHADERS - UPDATE 14
#if defined(SSFX_INDIRECT_LIGHT) && !defined(SSFX_IL_PASS) // NLC: replaced by the SSS 23 IL pass
    ssfx_il(center, I.hpos, _P, gbuffer_load_normal(center), img, 0);
#endif

// Sky Debanding Implementation  - SCREEN SPACE SHADERS - UPDATE 12.5
#ifdef SSFX_DEBAND
    if (depth <= SKY_EPS)
        img = ssfx_debanding(img, center);
#endif

    // NLC: psy vision before bloom/flares so they stay steady over the distorted edges
    // NLC flytrap: the lens moves the coordinate the image (and the psy effect) is read from; the fringe goes on top
    float2 nlc_tc = center;
    [branch] if (nlc_flytrap_on() > 0.001f)
    {
        nlc_tc = nlc_flytrap_uv(center);
        img = s_image.Sample(smp_rtlinear, nlc_tc).rgb;
    }
    img = nlc_psy_vision(nlc_tc, _P, img);
    [branch] if (nlc_flytrap_on() > 0.001f)
        img = max(0.f, img + nlc_flytrap_fringe(nlc_tc));

#ifdef SSFX_BLOOM
    float4 bloom = s_ssfx_bloom.Sample(smp_rtlinear, center);
#else
    float4 bloom = s_bloom.Sample(smp_rtlinear, center);
#endif

        if (
#ifdef SSFX_BEEFS_NVG // NVG CHANGE TO PREVENT WEIRD COLORS, ONLY APPLY BLOOM WHEN WE'RE NOT IN NVG MASK
            pnv_param_1.z == 0.f &&
#endif
            (m_hud_params.x < 1.0 || fakescope.y <= 0))
        {
            img = blend_soft(img, bloom.xyz * bloom.w);
            if (m_actor_position.w > 0.f)
            {
                img += generate_flare(center, m_flare_params.y);

                float4 flares = s_flares.Sample(smp_rtlinear, center);
                img += flares.xyz * flares.a;
            }
        }

    // Vanilla color grading ( Exposure, saturation and gamma )
    img = img_corrections(img);

    // NLC: psy colour loss and blink last, so bloom and flares cannot bring colour back or light the black edges up
    img = nlc_psy_colour(img);
    img *= nlc_psy_blink_factor(center);

    return float4(img, 1.0);
}
