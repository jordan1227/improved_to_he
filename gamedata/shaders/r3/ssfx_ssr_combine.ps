/**
 * @ Version: SCREEN SPACE SHADERS - UPDATE 20
 * @ Description: SSR - Combine Phase
 * @ Author: https://www.moddb.com/members/ascii1457
 * @ Mod: https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders
 * @ NLC: 2026-10-12 - full-resolution SSS 23 SSR result ( $user$ssfx_ssr ).
 */

#include "common.h"
#include "ssfx_upsample.h"

Texture2D ssr_image;

// NLC .209: the AO pass result occludes the reflection ( wet crevices and the ground under objects showed the full
// sky reflection ); 0.8: a reflection is more directional than the ambient light
#ifdef SSFX_AO_PASS
Texture2D s_ssfx_ao; // $user$ssfx_ao_a, .w = occlusion
#define G_SSR_AO 0.8f
uniform float4 ssfx_compare; // NLC: y = 1: no AO this pass ( true PiP scope view without its own AO )
#endif

float4 main(p_screen I) : SV_Target
{
    // NLC: depth-aware upsample ( the SSR target may be half size, ssfx_ssr_resolution 2 ): reflections no longer
    // bleed onto non-reflective neighbours at depth edges. At full size it is the old bilinear fetch, depth-weighted.
    float z0 = s_position.SampleLevel(smp_nofilter, I.tc0, 0).z;
    float4 ssr = ssfx_upsample(ssr_image, I.tc0, z0);

#ifdef SSFX_AO_PASS
    ssr.a *= lerp(1.0f, ssfx_upsample(s_ssfx_ao, I.tc0, z0).w, G_SSR_AO * (1.0f - ssfx_compare.y));
#endif

    // NLC .84: premultiplied, blended ( one, invsrcalpha ) straight into the scene: lerp( scene, ssr, a ) without a
    // full-resolution read of the scene and a copy back
    return float4(ssr.rgb * ssr.a, ssr.a);
}
