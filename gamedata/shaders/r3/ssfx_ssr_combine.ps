/**
 * @ Version: SCREEN SPACE SHADERS - UPDATE 20
 * @ Description: SSR - Combine Phase
 * @ Author: https://www.moddb.com/members/ascii1457
 * @ Mod: https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders
 * @ NLC: 2026-10-12 - full-resolution SSS 23 SSR result ( $user$ssfx_ssr ).
 */

#include "common.h"

Texture2D ssr_image;

float4 main(p_screen I) : SV_Target
{
    float4 ssr = ssr_image.SampleLevel(smp_rtlinear, I.tc0, 0); // bilinear: the SSR target may be half size

    // NLC .84: premultiplied, blended ( one, invsrcalpha ) straight into the scene: lerp( scene, ssr, a ) without a
    // full-resolution read of the scene and a copy back
    return float4(ssr.rgb * ssr.a, ssr.a);
}
