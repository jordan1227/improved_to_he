#include "common.h"

Texture2D ssr_image;

float4 main(p_screen I) : SV_Target
{
    float4 ssr = ssr_image.SampleLevel(smp_nofilter, I.tc0, 0);
    float3 color = s_image.SampleLevel(smp_nofilter, I.tc0, 0).rgb;

    return float4(lerp(color, ssr.rgb, ssr.a), 1.0f);
}
