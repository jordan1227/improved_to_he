#include "common.h"

// NLC: pixel part of shadow_direct_model_legs.vs. m_nlc_vb_shadow.x = clip height in the puppet's model space
// (its pelvis height + g_actor_shadow_legs_cut, set by CHUDManager::Render_Actor_Shadow each frame).
uniform float4 m_nlc_vb_shadow;

struct v2p_shadow_legs
{
    float4 hpos : SV_Position;
    float h : TEXCOORD0;
};

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 main(v2p_shadow_legs I) : SV_Target
{
    clip(m_nlc_vb_shadow.x - I.h);
    return 0;
}
