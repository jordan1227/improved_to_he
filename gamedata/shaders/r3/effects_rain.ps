/**
 * @ Version: SCREEN SPACE SHADERS - UPDATE 17.1
 * @ Description: Rain Shader - PS
 * @ Modified time: 2023-08-07 06:17
 * @ Author: https://www.moddb.com/members/ascii1457
 * @ Mod: https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders
 */

#include "screenspace_common.h"

// Pixel Struct
struct p_Rain
{
    float2 Tex0 : TEXCOORD0;
    float4 tc : TEXCOORD1;
};

float4 ssfx_rain_setup; // Alpha, Brigthness, Refraction, Reflection

#ifdef SSFX_RAIN_PASS
Texture2D ssfx_color_buffer; // NLC .85: $user$ssfx_rain ( current HDR scene + volumetric light, ssfx_rain.ps )
uniform float4 ssfx_torch[3]; // NLC .85: player torch, view space ( Blender_Recorder_StandartBinding.cpp )
#endif

float4 main(p_Rain I) : SV_Target
{
    // Factor to adjust the effect depending on light conditions
    float HemiFactor = saturate(dot(L_hemi_color.rgb, float3(1.0f, 1.0f, 1.0f)));

    // Screen Space
    float2 PosTc = I.tc.xy / I.tc.w;

    // Normal Setup
    float4 N0 = s_base.Sample(smp_rtlinear, I.Tex0);
    N0.xy = N0.xy * 2.0f - 1.0f; // Convert to -1.0f ~ 1.0f

    // Adjust "refraction" offset
    float4 UV_Offset = float4(N0.xy * 0.0125f, N0.xy);
    UV_Offset.xy = normalize(float3(UV_Offset.xy * ssfx_rain_setup.z, 1.0f));
    UV_Offset.zw = normalize(float3(UV_Offset.zw * (0.2f + HemiFactor * 0.5f), 1.0f));

#if SSFX_RAIN_QUALITY > 0
    // Remove incorrect refraction
    float Depth = SSFX_get_depth(saturate(PosTc + UV_Offset.xy), 0);
    UV_Offset.xy *= (I.tc.w < Depth || Depth <= SKY_EPS);
#endif

    // Screen Buffer ( Blur )
#ifdef SSFX_RAIN_PASS
    float4 RainBuf = ssfx_color_buffer.Sample(smp_rtlinear, saturate(PosTc + UV_Offset.xy));
    float3 Screen = RainBuf.rgb;

    // NLC .85: drops lit by the player's torch ( its cone and range, whether or not it has a volumetric beam )
    float lit = RainBuf.a; // volumetric beams ( lamps, projectors )
    [branch] if (ssfx_torch[0].w > 0.0f)
    {
        float3 P = float3(I.tc.w * (PosTc * screen_res.xy * pos_decompression_params.zw - pos_decompression_params.xy), I.tc.w);
        float3 Lv = ssfx_torch[0].xyz - P;
        float att = saturate(1.0f - dot(Lv, Lv) * ssfx_torch[0].w);
        float cone = smoothstep(ssfx_torch[1].w, lerp(ssfx_torch[1].w, 1.0f, 0.3f), dot(normalize(-Lv), ssfx_torch[1].xyz));
        // .86: softer, and mostly the first few metres ( long white streaks across the whole beam before )
        float t = att * att * cone / (1.0f + dot(Lv, Lv) * 0.06f);
        Screen += ssfx_torch[2].rgb * t * 0.35f;
        lit = max(lit, t * 0.5f);
    }
#else
    float3 Screen = s_blur_4.Sample(smp_nofilter, saturate(PosTc + UV_Offset.xy)).rgb;
#endif

#if SSFX_RAIN_QUALITY > 1
    // Fake reflection using light accumulator with a high UV offset
    float3 rL = s_accumulator.Sample(smp_nofilter, saturate(PosTc + UV_Offset.zw)).rgb;

    // Adjust intensity ( Day: 3.0f | Night: 18.0f )
    rL *= 3.0f + (1.0 - HemiFactor) * 15.0f;

    // Add fake reflection
    Screen += rL * ssfx_rain_setup.w;
#endif

    // Add Brightness
    Screen += L_hemi_color.rgb * ssfx_rain_setup.y;

    // Result
#ifdef SSFX_RAIN_PASS
    // NLC .85: HDR input, keep bright beams; lit drops are more visible ( they scatter the light towards the eye )
    return float4(clamp(Screen, 0.0f, 8.0f), saturate(N0.w * ssfx_rain_setup.x * (1.0f + lit * 2.0f)));
#else
    return float4(saturate(Screen), N0.w * ssfx_rain_setup.x);
#endif
}
