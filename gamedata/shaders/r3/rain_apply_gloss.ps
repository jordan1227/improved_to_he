#include "common.h"
#include "lmodel.h"

Texture2D s_patched_normal;

float4 main(float2 tc : TEXCOORD0, float2 tcJ : TEXCOORD1) : SV_Target
{
    // NLC .84: alpha = porosity step ( integer, rain_patch_normal.ps ) + gloss
    float packed = s_patched_normal.Sample(smp_nofilter, tc).a;
    float step7 = floor(packed + 0.002f);
    float porous = saturate(step7 / 7.0f);
    float Gloss = saturate(packed - step7);

    float rain = rain_params.x;

    float ColorIntencity = 1 - sqrt(Gloss);
    ColorIntencity = ColorIntencity + (rain / 2);

    // NLC .84: wet porous surfaces darken ( water fills the pores, less diffuse light ), asphalt and metal do not
    ColorIntencity *= lerp(1.0f, 0.78f, porous * saturate(Gloss * 10.0f));

    return float4(ColorIntencity, ColorIntencity, ColorIntencity, Gloss);
}