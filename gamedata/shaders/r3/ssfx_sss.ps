/**
 * @ Description: Screen-space shadows - sun ( trace + temporal accumulation )
 * @ Based on: SCREEN SPACE SHADERS - UPDATE 22 ssfx_sss.ps ( https://www.moddb.com/members/ascii1457 )
 * @ NLC: 2026-10-12 - OGSR G-buffer / velocity, shared reprojection helpers.
 *        Output: r = accumulated shadow, g = disocclusion, b = 1 ( blurred later ), a = offscreen / object motion
 */

#include "common.h"
#include "ssfx_sss.h"

Texture2D sss_image; // History ( $user$ssfx_sss )

float4 main(p_screen I) : SV_Target
{
    float2 tc = I.tc0;

    gbuffer_data gbd = gbuffer_load_data(tc, I.hpos.xy);
    float3 P = gbd.P;

    if (P.z <= SKY_EPS)
        return float4(1.0f, 0.0f, 1.0f, 0.0f);

    float HudMask = ssfx_hud_mask(tc);
    float2 mv = ssfx_motion_uv(tc);

    // Current frame
    float occ_motion;
    float sss = SSFX_ScreenSpaceShadows_Sun(P, tc, HudMask, occ_motion);

    // Reprojection
    float2 prev_tc = tc - mv;

    // Object motion only ( camera motion removed ), used by the blur
    float vel_history = length(mv - ssfx_camera_motion_uv(P) * (1.0f - HudMask)) * 200.0f;
    float vel = length(mv) * 30.0f * HudMask; // HUD only

    float docc = ssfx_disocclusion(P.z, prev_tc) * (1.0f + 10.0f * HudMask);
    // NLC: a depth change above ~2% is another surface ( feet on the ground ): drop the history. Not on flora,
    // whose depth flickers in the wind; looser far away, where grazing ground changes depth a lot per pixel
    if (abs(gbd.mtl - MAT_FLORA) > 0.04f)
        docc = max(docc, saturate((docc - (0.02f + P.z * 0.002f)) * 20.0f));

    float4 prev = sss_image.Sample(smp_rtlinear, prev_tc + ssfx_history_noise(tc, 0.5f * saturate(1.0f - length(mv) * 10.0f)));

    float outoffsrc = lerp(ssfx_offscreen(prev_tc), prev.a, 0.95f);

    // 0 = current frame ~ 1 = previous frame
    float2 weight;
    // NLC: 0.85 ( was 0.95, ~20 frames ): TAA / DLAA accumulate again later, this only has to denoise the trace.
    // A shadow cast by a moving object this frame ( occ_motion ) does not blend into old frames either
    weight.x = saturate(0.85f - (max(outoffsrc, occ_motion) + docc + vel)); // Shadow
    weight.y = saturate(0.60f - (outoffsrc + docc)); // Disocclusion mask

    float2 result = lerp(float2(sss, docc), prev.rg, weight);

    // NLC: alpha also marks shadows cast by moving objects ( occ_motion ), at full strength at once and then fading
    // ( x0.85 per frame ), so the next frames drop the history where the shadow was and the blur softens the result.
    // The object's own motion ( vel_history ) still builds up gradually, as before, so moving bodies keep some history.
    // .b = this frame's raw trace: ssfx_sss_blur.ps clamps the accumulated shadow to its 3x3 range ( overwritten there )
    return float4(result, sss, max(ssfx_offscreen(prev_tc), max(occ_motion, lerp(saturate(vel_history), prev.a, 0.85f))));
}
