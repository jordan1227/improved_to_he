/**
 * @ Version: SCREEN SPACE SHADERS - UPDATE 21
 * @ Description: Water reflection blur
 * @ Author: https://www.moddb.com/members/ascii1457
 * @ Mod: https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders
 * @ NLC: 2026-10-12 - separable 13 taps on the reduced-size target, weighted by coverage ( alpha ) so pixels
 *        without water do not darken the edges.
 */

#include "common.h"

Texture2D water_buffer;

uniform float4 blur_setup; // xy: direction * texel size, z: blur strength, w: -

float4 main(p_screen I) : SV_Target
{
    float4 base_image = water_buffer.SampleLevel(smp_rtlinear, I.tc0, 0);

    float3 blur = 0;
    float weight = 0;

    [unroll] for (int i = -6; i <= 6; i++)
    {
        float4 s = water_buffer.SampleLevel(smp_rtlinear, I.tc0 + i * 0.5f * blur_setup.xy, 0); // up to +-6 texels
        blur += s.rgb * s.a;
        weight += s.a;
    }

    blur = weight > 0 ? blur / weight : base_image.rgb;

    return float4(lerp(base_image.rgb, blur, blur_setup.z), base_image.a);
}
