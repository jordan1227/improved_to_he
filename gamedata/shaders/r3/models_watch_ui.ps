#include "common.h"
#include "he_watch_common.h"
#include "watch_ui_common.h"
#include "electronics_problems.h"

struct 	v2p
{
 	float2 	tc0: 		TEXCOORD0;	// base
 	float3 	tc1: 		TEXCOORD1;	// environment
  	float4	c0:			COLOR0;		// sun.(fog*fog)
};

//////////////////////////////////////////////////////////////////////////////////////////

float4 main(v2p I) : SV_Target
{
	float2 coords = he_watch_distort_uv(I.tc0);

	float4	t_base 	= s_base.Sample( smp_base, coords );

	float brightness = 1.f;
	brightness *= calc_glitch_brightness_watch_ui(brightness);
	t_base.rgb = lerp(watchBgColor(), t_base.rgb, brightness);

	//Output
	return float4(he_watch_apply_signal(t_base.rgb, I.tc0), 1.f);
}