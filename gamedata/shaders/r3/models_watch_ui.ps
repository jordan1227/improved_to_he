#include "common.h"
#include "he_watch_common.h"
#include "watch_ui_common.h"
#include "electronics_problems.h"

uniform float4 m_he_watch_psy; // x = psy health 0..1; y/z/w reserved

float3 he_watch_psy_outline(float3 original, float2 uv)
{
    // Reference watch_ui.dds: upper frame x=205..883, y=469..574 (1024 square).
    // Two-pixel margin includes filtered edges; the lower stamina frame is untouched.
    float2 pixel = uv * 1024.0;
    if (pixel.x < 203.0 || pixel.x > 886.0 || pixel.y < 467.0 || pixel.y > 577.0)
        return original;

    float health = saturate(m_he_watch_psy.x);
    if (health >= 1.0) return original; // preserve the accepted full-health appearance
    float3 background = watchBgColor();
    if (health <= 0.0) return background; // no surviving static outline at zero

    float progress = saturate((pixel.x - 205.0) / 679.0);
    // The visible left portion shrinks as health falls; soften the cut by one texel.
    float fill = 1.0 - smoothstep(health - 0.5 / 679.0, health + 0.5 / 679.0, progress);
    float coverage = saturate((max(original.r, max(original.g, original.b)) - 0.10) / 0.45);
    float damage = 1.0 - health;
    float3 yellow = float3(1.0, 0.85, 0.15);
    float3 red = float3(1.0, 0.12, 0.05);
    float3 warning_color = lerp(yellow, red, saturate((damage - 0.5) * 2.0));
    float3 tinted = lerp(original, lerp(background, warning_color, coverage), saturate(damage * 2.0));
    // Replace the original frame; do not leave its fixed artwork behind the fill.
    return lerp(background, tinted, fill);
}

struct 	v2p
{
 	float2 	tc0: 		TEXCOORD0;	// base
 	float3 	tc1: 		TEXCOORD1;	// environment
  	float4	c0:			COLOR0;		// sun.(fog*fog)
};

//////////////////////////////////////////////////////////////////////////////////////////

float4 main(v2p I) : SV_Target
{
	float2 coords = he_watch_distort_uv(I.tc0);

	float4	t_base 	= s_base.Sample( smp_base, coords );

	t_base.rgb = he_watch_psy_outline(t_base.rgb, coords);

	float brightness = 1.f;
	brightness *= calc_glitch_brightness_watch_ui(brightness);
	t_base.rgb = lerp(watchBgColor(), t_base.rgb, brightness);

	//Output
	return float4(he_watch_apply_signal(t_base.rgb, I.tc0), 1.f);
}