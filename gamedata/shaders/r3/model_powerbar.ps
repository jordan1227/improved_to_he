/*
	Watch shader - stamina bar (top)
*/
#include "common.h"
#include "watch_ui_common.h"
#include "electronics_problems.h"
#include "he_watch_common.h"

// float4 m_actor_params; //x = health, y = outfit cond, z = wpn cond, w = wpn_loading

struct v2p
{
 	float2 tc0	: TEXCOORD0; //Base texture coordinates
 	float3 tc1	: TEXCOORD1; //Unused
  	float4 c0	: COLOR0; //Light color + fog
};

float get_noise(float2 co)
{
	return (frac(sin(dot(co.xy, float2(12.9898,78.233))) * 43758.5453))*0.5;
}

float4 main(v2p I) : SV_Target
{
	if (m_he_watch_debug.x > 0.5) return he_watch_debug_map(I.tc0, float3(1.0, 0.5, 0.0)); // NLC mesh map (he_watch_common.h)
    float2 he_face_uv = I.tc0;
    I.tc0 = he_watch_distort_uv(I.tc0);
    //Color
    float4 background_col = float4(16.0, 18.0, 20.0, 255.0) / 255.0;

    //Sample bar texture
    float4 t_base = s_base.Sample(smp_base, I.tc0);
    float3 t_alpha = lerp(t_base.xyz, background_col.xyz, 0.8);

    //Bar 'logic' kek
    // NLC: on page 2 with the body figure this bar shows health (the health bar's place is taken by the figure)
    float hp_page = step(0.5, he_watch_body_hide());
    float bar_value = lerp(m_actor_watch_params.x, 1.0 - saturate(m_actor_params.x), hp_page);
    t_base.xyz = I.tc0.x > bar_value ? t_base.xyz : t_alpha; // note from yohji: logic flipped because in the watch mesh the texture is flipped? lol
    t_base.xyz = lerp(t_base.xyz, dot(t_base.xyz, float3(0.30, 0.59, 0.11)).xxx * 1.2, hp_page); // neutral like the health bar

    float brightness = 1.f;
    brightness *= calc_glitch_brightness_watch_ui(brightness);
    t_base.xyz = lerp(watchBgColor(), t_base.xyz, brightness);

    //Output

    return float4(he_watch_apply_signal(t_base.xyz, he_face_uv), 1.0);
}