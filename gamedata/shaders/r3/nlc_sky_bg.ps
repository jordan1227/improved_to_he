/**
 * @ Description: Sky + clouds behind the scene, blurred ( docs/RAIN_CLOUDS_DESIGN.md 4.5 )
 * @ NLC .237: runs after RenderClouds and before combine_1, when rt_Generic_0 holds only the skybox and the clouds
 *        ( r4_rendertarget_phase_ssfx.cpp phase_nlc_sky_bg ). Writes $user$nlc_sky_bg ( 80 x 45 ): each texel averages
 *        16 bilinear taps over its footprint. The fog fades far geometry into this colour ( ssfx_fog_atmo.h SSFX_FOG_BG )
 *        instead of the sky cube's, which has no clouds.
 */

#include "common.h"

#define NLC_SKY_BG_SIZE float2(80.0f, 45.0f) // r4_rendertarget_phase_ssfx.cpp rt_nlc_sky_bg

float4 main(p_screen I) : SV_Target
{
    const float2 cell = 1.0f / NLC_SKY_BG_SIZE;
    float3 c = 0.0f;
    [unroll] for (int y = 0; y < 4; y++)
    {
        [unroll] for (int x = 0; x < 4; x++)
        {
            // a sun disk or flare in HDR would bleed into the fog around it ( the sun lobe already brightens it )
            c += min(s_image.SampleLevel(smp_rtlinear, I.tc0 + (float2(x, y) - 1.5f) * 0.25f * cell, 0).rgb, 3.0f);
        }
    }
    return float4(c / 16.0f, 1.0f);
}
