/*
	Watch shader - stamina bar (top)
*/
#include "common.h"
#include "watch_ui_common.h"
#include "electronics_problems.h"
#include "he_watch_common.h"

// float4 m_actor_params; //x = health, y = outfit cond, z = wpn cond, w = wpn_loading

struct v2p
{
 	float2 tc0	: TEXCOORD0; //Base texture coordinates
 	float3 tc1	: TEXCOORD1; //Unused
  	float4 c0	: COLOR0; //Light color + fog
};

float get_noise(float2 co)
{
	return (frac(sin(dot(co.xy, float2(12.9898,78.233))) * 43758.5453))*0.5;
}

float4 main(v2p I) : SV_Target
{
    float2 he_face_uv = I.tc0;
    I.tc0 = he_watch_distort_uv(I.tc0);
    //Color and other settings
    float stamina = (round((1.0-m_actor_watch_params.x) * 100) / 100); // Rounding stamina value to avoid flickering when rapidly increasing/decreasing.
    float4 background_col = float4(16.0, 18.0, 20.0, 255.0) / 255.0; //Background color
	float f_min = 0.5; //Blinking only enabled when under 90%

	//Sample bar texture
	float4 t_base = s_base.Sample(smp_base, I.tc0);

	//Blending factor
	float factor = m_actor_watch_params.x > f_min ? saturate(sin(timers.x * 10.0 * (m_actor_watch_params.x))) : saturate(sin(timers.x * 5.0 * electronics_problems.x));

	//Simple flickering
	t_base.xyz = lerp(t_base.xyz, background_col.xyz, max(ElectronicsProblemsBlackout() ? 0.f : factor, 0.2)); // Prevent icon from fading out completely.

	float brightness = 1.f;
	brightness *= calc_glitch_brightness_watch_ui(brightness);
	t_base.xyz = lerp(watchBgColor(), t_base.xyz, brightness);

    //Output

    return float4(he_watch_apply_signal(t_base.xyz, he_face_uv), 1.0);
}