#include "common.h"
#include "lmodel.h"
#include "shadow.h"

#include "screenspace_common_ripples.h"

#include "settings_screenspace_TERRAIN.h"

// Фикс чтобы не стекала вода по стенам внутри помещений
#define INDOOR_LEAKS_FIX

uniform float4 ssfx_wetsurfaces_1; // Ripples [ Size, Speed, Min Speed, Int ]
uniform float4 ssfx_wetsurfaces_2; // FallWater [ Size, Speed, Min Speed, Int ]
uniform float4 ssfx_puddle_ripples; // NLC .216 A/B: z 1 = rain rings on terrain too ( old )

// NLC .216: the rain depth map as plain depth ( rain.s ), for the height of the cover ( soft dry edge )
uniform float4 ssfx_fog_map; // y: map depth per metre, w: map valid
uniform float4x4 ssfx_fog_map_xf; // world -> map ( uv, depth )
Texture2D s_fog_map;

float nlc_cover_height(float3 Pv)
{
    float4 p = mul(ssfx_fog_map_xf, float4(mul(m_inv_V, float4(Pv, 1.0f)).xyz, 1.0f));
    p.xyz /= p.w;
    float4 d4 = s_fog_map.GatherRed(smp_nofilter, saturate(p.xy));
    return ssfx_fog_map.w > 0.5f ? max(0.0f, p.z - min(min(d4.x, d4.y), min(d4.z, d4.w))) / max(ssfx_fog_map.y, 1e-6f) : 0.0f;
}

// NLC .217: open from above at a world point ( 2x2 texels, bilinear ), 1 outside the map
uniform float4 ssfx_rain_slant; // xz: upwind offset per metre of cover height, w: valid ( r3_rain_slant_mode 0 )
float nlc_map_open_w(float3 Pw)
{
    float4 p = mul(ssfx_fog_map_xf, float4(Pw, 1.0f));
    p.xyz /= p.w;
    float2 size;
    s_fog_map.GetDimensions(size.x, size.y);
    float2 uv = saturate(p.xy);
    float2 f = frac(uv * size - 0.5f);
    float4 o = step(p.z - max(0.3f, ssfx_fog_map.z) * ssfx_fog_map.y, s_fog_map.GatherRed(smp_nofilter, uv));
    float open = lerp(lerp(o.w, o.z, f.x), lerp(o.x, o.y, f.x), f.y);
    return (all(p.xy > 0.0f) && all(p.xy < 1.0f)) ? open : 1.0f;
}

Texture2D s_water;
Texture2D s_waterFall;

float4 RainFallof;


#ifdef INDOOR_LEAKS_FIX

float shadow_hw(float4 tc)
{
    float s0 = sample_hw_pcf(tc, float4(-1, -1, 0, 0));
    float s1 = sample_hw_pcf(tc, float4(+1, -1, 0, 0));
    float s2 = sample_hw_pcf(tc, float4(-1, +1, 0, 0));
    float s3 = sample_hw_pcf(tc, float4(+1, +1, 0, 0));

    return (s0 + s1 + s2 + s3) / 4.h;
}

#else

float4 test(float4 tc, float2 offset)
{
    tc.xyz /= tc.w;
    tc.xy += offset;
    return s_smap.SampleCmpLevelZero(smp_smap, tc.xy, tc.z).x;
}

float shadow_rain(float4 tc, float2 tcJ) // jittered sampling
{
    float4 r;

    const float scale = (4.0 / float(SMAP_size));

    float4 J0 = jitter0.Sample(smp_linear, tcJ) * scale;
    float4 J1 = jitter1.Sample(smp_linear, tcJ) * scale;

    r.x = test(tc, J0.xy).x;
    r.y = test(tc, J0.wz).y;
    r.z = test(tc, J1.xy).z;
    r.w = test(tc, J1.wz).x;
    return dot(r, 1.0 / 4.0);
}

#endif


float3 GetWaterFall(Texture2D s_texture, float2 tc)
{
    // 0.75 1.5 0.2 0.5

    // Num of columns
    float col_num = 50;
    float col_scale = 1.0 / col_num;

    // Original UV Coors
    float2 tc_ori = tc * ssfx_wetsurfaces_2.x;

    // UV Columns
    float2 col_tc = float2(frac(tc_ori.x * col_num), tc_ori.y);

    // Column ID to add a random offset and adjust horizontal offset
    half col_id = ceil(tc_ori.x * col_num);

    // Random Y-Offset for each column
    float col_offset = hash22(float2(col_id, 1.0));

    // Limit min speed
    col_offset = (col_offset < ssfx_wetsurfaces_2.z ? col_offset * 3.0f : col_offset);

    // Animate
    col_offset += timers.x * col_offset * ssfx_wetsurfaces_2.y;

    // Add wabbly
    // col_tc.x += sin((tc_ori.y + col_offset) * 20) * 0.5f + 0.5f;

    // Base Bump. Columns UVs, scale and apply offset.
    float2 wf_uv = col_tc * float2(col_scale, 1.0f) + float2(col_scale * col_id, col_offset);
    float3 water = s_texture.Sample(smp_base, wf_uv);

    // Bump to -1.0 ~ 1.0
    water.xyz = water.xzy * 2.0f - 1.0f;

    // Intensity
    water.xyz *= ssfx_wetsurfaces_2.w * clamp(rain_params.x, 0.1f, 1.f);

    return water.xyz;
}

float4 main(float2 tc : TEXCOORD0, float2 tcJ : TEXCOORD1, float4 Color : COLOR, float4 pos2d : SV_Position) : SV_Target
{
    gbuffer_data gbd = gbuffer_load_data(tc, pos2d);

    // Buffers
    float4 _P = float4(gbd.P, 1.0);
    float3 _N = normalize(gbd.N.xyz);
    float3 _D = gbd.C;
    float _M = gbd.mtl;

    // NLC .209i: cover looked up 0.6 m off the surface along its normal. At the surface itself a wall or the side
    // of a car read the top of the same object in the rain map as cover: no wet gloss, no running water there
    // .209l: 0.6 -> 1.2 m and 0.3 m up ( test: an open brick wall still read as covered at 0.6 m: eaves, map texel
    // and PCF kernel together are wider than that )
    float4 PS = mul(m_shadow, float4(_P.xyz + _N * 1.2f + mul((float3x3)m_V, float3(0.0f, 0.3f, 0.0f)), 1.0f));
    float3 WorldP = mul(m_sunmask, _P);
    float3 WorldN = mul(m_sunmask, _N.xyz);

#ifdef INDOOR_LEAKS_FIX
    float Cover = shadow_hw(PS);
    // .214b: thin occluders ( trunks, posts ) are not cover: 4 points 0.6 m around ( world x / z ), open when most are
    // .216: the 4 points spread with the height of the cover ( 0.3 x, 0.6 ~ 2 m ): a soft dry edge under high cover
    // ( truck body, roof edge in slanted rain ) instead of a hard rectangle; the average ramps 0.1 ~ 0.9
    float3 Pc = _P.xyz + _N * 1.2f + mul((float3x3)m_V, float3(0.0f, 0.3f, 0.0f));
    float cover_h = 0.0f;
    [branch] if (Cover < 0.99f)
    {
        cover_h = nlc_cover_height(Pc);
        float r = clamp(cover_h * 0.3f, 0.6f, 2.0f);
        float3 ox = mul((float3x3)m_V, float3(r, 0.0f, 0.0f));
        float3 oz = mul((float3x3)m_V, float3(0.0f, 0.0f, r));
        float wide = 0.25f * (shadow_hw(mul(m_shadow, float4(Pc + ox, 1.0f))) + shadow_hw(mul(m_shadow, float4(Pc - ox, 1.0f))) +
                              shadow_hw(mul(m_shadow, float4(Pc + oz, 1.0f))) + shadow_hw(mul(m_shadow, float4(Pc - oz, 1.0f))));
        Cover = max(Cover, smoothstep(0.1f, 0.9f, wide));
    }
    // .217: the map is straight down ( r3_rain_slant_mode 0 ); slanted rain reaches a covered point when the point
    // cover height x tan( lean ) upwind is open ( windward edges under eaves ). Only adds wetness; hemi keeps closed
    // rooms dry ( a windward wall is not in the map ), cover above ~6 m fades out
    [branch] if (Cover < 0.99f && ssfx_rain_slant.w > 0.5f)
    {
        float3 Pw = mul(m_inv_V, float4(Pc, 1.0f)).xyz + float3(ssfx_rain_slant.x, 0.0f, ssfx_rain_slant.z) * min(cover_h, 6.0f);
        // .218: hemi 0.05 ~ 0.25 -> 0.25 ~ 0.5 ( sheds and rooms with a door or window to the wind got wet floors )
        Cover = max(Cover, nlc_map_open_w(Pw) * smoothstep(0.25f, 0.5f, gbd.hemi) * saturate((8.0f - cover_h) * 0.25f));
    }
    Cover *= saturate(gbd.hemi * 10.0f);
    // NLC .211: outside the rain map ( r3_rain_map_radius ) the hemi alone ( the sampler clamped to the edge texels )
    float2 ps_uv = PS.xy / PS.w;
    Cover = (any(ps_uv < 0.0f) || any(ps_uv > 1.0f)) ? saturate(gbd.hemi * 10.0f) : Cover;
#else
    // Read rain projection with some jetter. Also adding pixel normal
    // factor to jitter to make rain strips more realistic.
    float Cover = shadow_rain(PS, WorldP.xz - WorldN.xz); // Wet Surfaces fix by Diana.Petran
#endif

    // Distance
    float p_len = length(_P.xyz);
    bool is_flora = abs(_M - 0.15) < 0.04f;
    bool is_terrain = abs(_M - 0.95) < 0.04f;

    // Rain parameters ( Wetness > 0.5 = 100% | Rain Intensity > 0.66 = 100% )
    float Wetness = saturate(rain_params.y * 2.0f);
    float RainInt = clamp(rain_params.x * ssfx_wetsurfaces_1.y, ssfx_wetsurfaces_1.z * (rain_params.x > 0), 2.0f); // 1.5

    // [ BUMP ] -------------------------------------------
    float3 waterSplash = 0;
    if (p_len < TERRAIN_PUDDLES_RIPPLES_RANGE)
    {
        waterSplash.xy = ssfx_rain_ripples(s_water, WorldP.xz * ssfx_wetsurfaces_1.x, float3(RainInt, ssfx_wetsurfaces_1.w, 6), _P.z); // 0.9
    }

    // Blending weights ( We don't want splashes or fall water on FLORA )
    float3 weights = WorldN.xyz * !is_flora;

    // Water Fall
    float3 waterFallX = GetWaterFall(s_waterFall, WorldP.zy);
    float3 waterFallZ = GetWaterFall(s_waterFall, WorldP.xy);

    // NLC .216: no rain rings on terrain ( the terrain shader draws its own in the puddles; these were on dry and damp
    // ground too and doubled in the puddles ). ssfx_puddle_ripples.z 1 = old
    waterSplash *= (is_terrain && ssfx_puddle_ripples.z < 0.5f) ? 0.0f : 1.0f;

    // Base bump - Splahes
    float3 water = waterSplash * smoothstep(0.75f, 0.8f, weights.y);

    // Adjust Water fall and add to the Normal
    weights.xz = saturate(abs(weights.xz) - 0.15f);

    weights.xz *= float2(weights.x > weights.z, weights.x < weights.z);

    water += waterFallX.yxz * weights.x;
    water += waterFallZ.zxy * weights.z;

    // HUD attenuations ( Remove Terrain & Flora )
    float HUD_Attenuation = smoothstep(1.0f, 1.3f, p_len + (is_terrain * 1.3f)) * !is_flora;

    // Apply attenuations
    water *= HUD_Attenuation * saturate(RainInt) * Cover;

    // Convert normal to view space
    water = mul(m_V, water);

    // Add water normal
    _N = normalize(_N + water.xyz);

    // [ GLOSS ] ------------------------------------------
    float Gloss = (0.15f + saturate(RainInt) * 0.05) * Wetness; // Wetness

    // NLC .209j: objects ( not terrain, not flora ): 0.15 ~ 0.2 was below anything the SSR or the specular shows, so
    // cars, walls and metal never looked wet and the running-water normals had nothing to show on. Gloss by the
    // albedo brightness as the old rain patch ( dark 0.18, mid grey ~0.35, bright ~0.5 ), less on porous
    // ( green / brown: wood, cloth, bark ) surfaces
    bool is_object = !is_terrain && !is_flora;
    if (is_object)
        Gloss = (0.18f + 0.35f * saturate(dot(_D, 0.333f) * 2.0f)) * lerp(1.0f, 0.45f, saturate((_D.g - _D.b) * 6.0f)) * Wetness;

    // Fade to full cover. ( RainFallof.y = far shadow rain rendering )
    Cover += smoothstep(RainFallof.y - 20, RainFallof.y, _P.z);

    // If gloss is high, remove cover factor
    // NLC .209j: objects need the cover itself ( glossy floors and metal indoors got the rain gloss )
    Gloss *= HUD_Attenuation * saturate(Cover + (is_object ? 0.0f : (gbd.gloss > 0.3f)));

    // Limit gloss on terrain ( Puddles )
    Gloss = (is_terrain && gbd.gloss > 0.3f) ? 0.15f : Gloss;

    // NLC 2026-10-13: earth and grass terrain ( green / brown texels ) get less rain gloss than asphalt or concrete,
    // the terrain shader already makes them damp ( deffer_terrain_high_flat.ps )
    // .212d: terrain without the colour test ( the G-buffer albedo of terrain is the level colour map: blocky squares );
    // soft ground already gets its damp look from deffer_terrain_high_flat.ps
    // .212f: none - terrain wetness is the terrain shader's ( a rain gloss on top gave wet earth a sun glint after rain )
    Gloss *= is_terrain ? 0.0f : 1.0f;

    // Remove rain gloss from bottom surfaces
    // NLC .209j: on objects vertical surfaces keep half of it ( walls had none: the water running down them was
    // only a normal, with no gloss to show it )
    Gloss *= is_object ? saturate(0.5f + weights.y * 1.5f) : saturate(weights.y * 1.5f);

    //	Apply distance falloff
    Gloss *= smoothstep(250, 200, p_len);

    // NLC .84: porous surfaces ( earth, wood, cloth: green / brown albedo, not already glossy ) darken when wet. The
    // porosity rides in the integer part of the alpha ( 0..7 ) for rain_apply_gloss.ps, which cannot read the albedo
    // it blends into; the gloss stays the fraction ( < 1 ). The accumulator is a float target.
    float porous = is_terrain ? 0.0f : saturate((_D.g - _D.b) * 6.0f) * (gbd.gloss <= 0.3f ? 1.0f : 0.0f); // .212d: not terrain

    float packed_out = (min(saturate(Gloss), 0.9f) + round(porous * 7.0f)); // .90: fraction <= 0.9 survives FP16 at 4..8 ( 1/256 steps )
    return float4(_N.xyz, packed_out);
}