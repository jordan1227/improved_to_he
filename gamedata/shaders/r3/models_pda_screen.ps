#include "common.h"
#include "screenspace_hud_raindrops.h"

uniform float4 m_affects;
uniform Texture2D s_vp2;
uniform Texture2D s_load;

// ====== electra glitch tuning (FE-style, OGSR port) ======
#define JITTER_STRENGTH   0.012   // Tripled: much more violent horizontal wobble
#define TEAR_THRESHOLD    0.60    // Lowered from 0.82: screen tears constantly
#define TEAR_STRENGTH     0.08    // Nearly tripled: tears are wide and jarring
#define CHROMA_STRENGTH   0.035   // Nearly tripled: heavy RGB split
#define NOISE_STRENGTH    0.35    // More than doubled: thick electronic snow
#define FLASH_THRESHOLD   0.88    // Lowered from 0.995: very frequent black flashes
#define STATIC_MIX_MAX    0.85    // Raised from 0.6: screen is 85% pure static at point blank

struct v2p
{
    float2 tc0 : TEXCOORD0; // main tc for screen
    float3 RDrops : TEXCOORD1; // Raindrops
    float4 c0 : COLOR0;
};

float get_noise(float2 co) { return (frac(sin(dot(co.xy, float2(12.9898, 78.233))) * 43758.5453)) * 0.5; }
float fe_rand(float2 co) { return frac(sin(dot(co, float2(12.9898, 78.233))) * 43758.5453); }

// ======================= legacy static path (blowout / broken) =======================
float4 problems_main(v2p I)
{
    float x = m_affects.x;
    float y = m_affects.y;

    float problems = frac(timers.z * 5 * (1 + 2 * x));
    float band1 = (I.tc0.y > problems - 0.01 && I.tc0.y < problems) ? sin((I.tc0.y - problems) * 5 * y) : 0;
    I.tc0.x += band1 * saturate((x - 0.09) * 8.0);

    problems = cos((frac(timers.z * 2) - 0.5) * 3.1416) * 2 - 0.8;
    float AMPL = 0.13;
    float band2 = (I.tc0.y > problems - AMPL && I.tc0.y < problems + AMPL) ?
        cos(4.71 * (I.tc0.y - problems) / AMPL) * sin(frac(timers.z) * 6.2831 * 90) * 0.02 * (AMPL - abs(I.tc0.y - problems)) / AMPL : 0;
    I.tc0.x -= band2 * saturate((x - 0.15) * 6.0);

    I.tc0.x += (y - 0.5) * 0.04 * saturate((x - 0.38) * 8.0);

    float4 t_live = s_vp2.Sample(smp_base, I.tc0);
    float4 t_stat = s_base.Sample(smp_base, I.tc0);
    float4 t_vp2  = lerp(t_live, t_stat, saturate(x * 1.111));

    float noise = get_noise(I.tc0 * timers.z) * min(x * x * 20.0, 3.0);
    t_vp2.rgb += noise;
    t_vp2.rgb *= 0.7;

    // Keep the improved paths intact, but retain the original fully-off PDA screen.
    // The turn-on/loadscreen path is selected before this function is used.
    t_vp2.rgb = (x > 0.41) ? float3(0.0, 0.0, 0.0) : t_vp2.rgb;

    return float4(t_vp2.r, t_vp2.g, t_vp2.b, m_affects.z);
}

// ======================= location heavy static path (a >= 0.9) =======================
// Static look driven entirely by y channel so x remains 0 (lamps stay calm)
float4 static_loc_main(v2p I, float intensity)
{
    float time = timers.x;
    float2 uv = I.tc0;

    // Rolling band distortion
    float problems = frac(timers.z * 5.0 * (1.0 + 2.0 * intensity));
    float band = (uv.y > problems - 0.015 && uv.y < problems) ? sin((uv.y - problems) * 10.0) : 0.0;
    uv.x += band * saturate(intensity * 0.05);

    // Subdued horizontal tearing accent
    float tear = fe_rand(float2(floor(time * 8.0), floor(uv.y * 20.0)));
    if (tear > 0.85)
        uv.x += (tear - 0.85) * 0.03 * intensity;

    float4 t_live = s_vp2.Sample(smp_base, uv);
    float4 t_stat = s_base.Sample(smp_base, uv);

    // Blend live viewport with heavy static texture based on y intensity
    float4 col = lerp(t_live, t_stat, saturate(intensity * 1.15));

    // Electronic noise
    float noise = get_noise(uv * timers.z) * intensity * 2.5;
    col.rgb += noise;
    col.rgb *= 0.7;

    return float4(col.rgb, m_affects.z);
}

// ======================= electra glitch path (FE-style, a >= 0.25) =======================
float4 electra_main(v2p I, float x)
{
    float time = timers.x;
    float2 uv = I.tc0;

    // 1. subtle horizontal jitter
    float wave = sin(uv.y * 120.0 + time * 12.0) *
                 fe_rand(float2(floor(time * 12.0), floor(uv.y * 80.0)));
    uv.x += wave * JITTER_STRENGTH * saturate(x * 2.0);

    // 2. horizontal tearing bursts
    float tear = fe_rand(float2(floor(time * 10.0), floor(I.tc0.y * 35.0)));
    if (tear > TEAR_THRESHOLD)
        uv.x += (tear - TEAR_THRESHOLD) * TEAR_STRENGTH * x;

    // 3. rolling narrow band
    float problems = frac(timers.z * 5 * (1 + 2 * x));
    float band1 = (I.tc0.y > problems - 0.01 && I.tc0.y < problems) ? sin((I.tc0.y - problems) * 2.5) : 0;
    uv.x += band1 * saturate((x - 0.09) * 8.0);

    // 4. RGB channel separation
    float glitch = fe_rand(float2(floor(time * 12.0), 0.0)) * CHROMA_STRENGTH * x;
    float r = s_vp2.Sample(smp_base, uv + float2(-glitch,  glitch * 0.4)).r;
    float g = s_vp2.Sample(smp_base, uv + float2( glitch,  glitch * 0.4)).g;
    float b = s_vp2.Sample(smp_base, uv + float2( 0.0,    -glitch)).b;
    float3 glitched = float3(r, g, b);

    // 5. colored electronic noise
    float3 n = float3(fe_rand(uv * 37.17  + time * 2.7),
                      fe_rand(uv * 83.41  - time * 4.1),
                      fe_rand(uv * 121.73 + time * 6.3));
    glitched += (n - 0.5) * NOISE_STRENGTH * x;

    // 6. blend live image <-> glitched image
    float3 original = s_vp2.Sample(smp_base, uv).rgb;
    float3 col = lerp(original, glitched, saturate(x * 1.5));

    // 7. rapid violent strobing at close range
    float flash = step(FLASH_THRESHOLD, fe_rand(float2(floor(time * 35.0), 17.31)));
    col = lerp(col, float3(0.0, 0.0, 0.0), flash * x); 

    // 8. near point-blank static mix
    col = lerp(col, s_base.Sample(smp_base, uv).rgb, saturate((x - 0.75) * 4.0) * STATIC_MIX_MAX);

    return float4(col * 0.7, m_affects.z);
}

float4 loading_main(v2p I)
{
    float4 t_load = s_load.Sample(smp_base, I.tc0);
    return float4(t_load.r, t_load.g, t_load.b, 1);
}

float4 main(v2p I) : SV_Target
{
    float extra_col = 0;
    if (ssfx_hud_drops_1.y > 0)
    {
        float4 Layer0 = s_hud_rain.Sample(smp_base, (I.tc0 + float2(0, -ssfx_hud_drops_1.x * 0.01f)) * float2(1.5f, 0.75f));
        float4 Layer1 = s_hud_rain.Sample(smp_base, I.tc0 * float2(5.0f, 3.0f));

        float3 result = ssfx_process_drops(Layer0, 0.1f, 0.2f) + ssfx_process_drops(Layer1, 0.2f, 1.0f);
        result.xy = clamp(result.xy, -1.0f, 1.0f);
        result.xyz *= saturate(I.RDrops.y);
        result.xyz *= ssfx_hud_drops_1.y;

        I.tc0.xy = I.tc0.xy - result.xy * 0.4f;
        extra_col = saturate(Layer0.x + Layer1.x) * result.z * 0.25f;
    }

	float4 final_clr;
	if (m_affects.a >= 1.5)
		final_clr = float4(0, 0, 0, m_affects.z);                    // forced black
	else if (m_affects.a >= 0.25)
	{
		// Continuous transition: 0.25 = full glitch, 1.5 = full static
		float style_mix = saturate((m_affects.a - 0.25) / (1.5 - 0.25));

		float4 glitch_col = electra_main(I, saturate(m_affects.y));
		float4 static_col = static_loc_main(I, saturate(m_affects.y));

		final_clr = lerp(glitch_col, static_col, style_mix);
	}
	else if (m_affects.a > 0 && m_affects.x >= 0.08)
		final_clr = loading_main(I);                                 // loadscreen
	else
		final_clr = problems_main(I);                                // blowout static (lamps read .x)

	return final_clr + extra_col;
}
