/**
 * @ Description: Screen-space shadows - disocclusion blur ( writes the blurred shadow into .b )
 * @ Based on: SCREEN SPACE SHADERS - UPDATE 22 ssfx_sss_blur.ps ( https://www.moddb.com/members/ascii1457 )
 * @ NLC: 2026-10-12 - render resolution pixel size ( upscalers ), integer channel select.
 */

#include "common.h"

Texture2D sss_image;

uniform float4 blur_setup; // x, y: -, z: source channel ( 0 = r, 2 = b )

static const float2x2 ssfx_sss_rotation = {-0.666276f, 0.745705f, -0.745705f, -0.666276f};

float4 main(p_screen I) : SV_Target
{
    float2 tc = I.tc0.xy;
    uint channel = (uint)blur_setup.z;

    float4 base_image = sss_image.SampleLevel(smp_nofilter, tc, 0);

    // NLC: pass 1 only ( channel 0 ): clamp the accumulated shadow to the 3x3 range of this frame's raw trace ( .b from
    // ssfx_sss.ps ). Where a moving shadow has left, every neighbour is lit and the old shadow is dropped at once;
    // noisy or static areas span the full range and keep their accumulation. Pass 2 copies .rg, so it is the history.
    if (channel == 0)
    {
        float lo = 1.0f, hi = 0.0f;
        [unroll] for (int y = -1; y <= 1; y++)
        {
            [unroll] for (int x = -1; x <= 1; x++)
            {
                float raw = sss_image.SampleLevel(smp_nofilter, tc + float2(x, y) * render_res.zw, 0).b;
                lo = min(lo, raw);
                hi = max(hi, raw);
            }
        }
        base_image.r = clamp(base_image.r, lo, hi);
    }

    float mask = base_image.g + base_image.a;

    // Stable pixels keep the sharp result
    if (mask <= 0.1f)
        return float4(base_image.rg, base_image[channel], base_image.a);

    // NLC: depth-aware taps, so a moving NPC's shadow does not bleed across its silhouette onto the ground behind it
    float z0 = s_position.SampleLevel(smp_nofilter, tc, 0).z;

    float blur = base_image[channel];
    float wsum = 1.0f;
    float2 offset = mask.xx;
    float r = 0.9f;

    [unroll]
    for (int i = 0; i < 8; i++)
    {
        r += 1.0f / r;
        offset = mul(offset, ssfx_sss_rotation);

        float2 tap = tc + offset * (r - 1.0f) * render_res.zw;
        float z = s_position.SampleLevel(smp_nofilter, tap, 0).z;
        float w = exp2(-abs(1.0f - z / max(z0, 0.0001f)) * 32.0f);
        blur += sss_image.SampleLevel(smp_nofilter, tap, 0)[channel] * w;
        wsum += w;
    }
    blur /= wsum;

    return float4(base_image.rg, blur, base_image.a);
}
