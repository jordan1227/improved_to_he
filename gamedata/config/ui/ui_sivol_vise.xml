<?xml version="1.0" encoding="windows-1251" ?>
<!-- sivol: vise repair choice window (sivol/sivol_vise.script); frame and buttons as ui_sharper.xml.
     col_* nodes are templates: the script moves them into each of the 4 columns (x from COL_X). -->
<main>
    <main_dialog>
    	<dialog x="200" y="120" width="832" height="580" stretch="1">
			<texture>ui\ui_cheat_naxac_new</texture>
		</dialog>
	</main_dialog>

	<!-- title with the broken line, as the item names in ui_inv_descr -->
	<cap_line x="250" y="182" width="500" height="22">
		<texture>ui_brokenline</texture>
		<text font="letterica18" align="c" vert_align="c" />
	</cap_line>
	<cap_text x="250" y="182" width="500" height="22">
		<text font="graffiti19" align="c" vert_align="c" r="238" g="155" b="23" />
	</cap_text>

	<info_text x="250" y="212" width="500" height="44" complex_mode="1">
		<text font="letterica16" align="c" r="160" g="160" b="160" />
	</info_text>

	<col_name x="0" y="276" width="111" height="34" complex_mode="1">
		<text font="letterica16" align="c" vert_align="b" r="238" g="155" b="23" />
	</col_name>
	<col_line x="0" y="312" width="111" height="22">
		<texture>ui_brokenline</texture>
		<text font="letterica16" align="c" vert_align="c" />
	</col_line>
	<col_pct x="0" y="312" width="111" height="22">
		<text font="letterica16" align="c" vert_align="c" r="227" g="199" b="178" />
	</col_pct>
	<col_gain x="0" y="470" width="121" height="44" complex_mode="1">
		<text font="letterica16" align="c" r="160" g="160" b="160" />
	</col_gain>

	<btn_pick x="242" y="583" width="111" height="29">
		<texture>ui_button_ordinary</texture>
		<text x="4" y="0" font="letterica16">ui_vise_btn</text>
		<text_color>
			<e r="227" g="199" b="178"/><t r="180" g="153" b="155"/> <d r="106" g="95" b="91"/> <h r="255" g="165" b="33"/>
		</text_color>
	</btn_pick>

	<btn_cancel x="720" y="130" width="30" height="30">
       	<texture_e>ui_icons_repair_close_t</texture_e>
       	<texture_t>ui_icons_repair_close_h</texture_t>
       	<texture_h>ui_icons_repair_close_h</texture_h>
	</btn_cancel>
</main>
