<?xml version="1.0" encoding="windows-1251"?>
<!-- sivol: new-game A-life selector, 4:3 (ui_mm_alife_preset.script). 16:9: ui_mm_alife_preset_16.xml.
     Replaces message_box_alife_preset in message_box.xml. *_title nodes give a header's centre, top, max width and
     height; the matching *_line (ui_brokenline) is sized to the text by fit_header. docs/ALIFE_DESC_UI_DESIGN.md -->
<window>
	<!-- set a="0" to drop the dimming (the node itself is required by the script) -->
	<dim x="0" y="0" width="1024" height="768" stretch="1">
		<texture r="0" g="0" b="0" a="150">ui_nlc_dim</texture>
	</dim>

	<choice_back x="20" y="230" width="330" height="275" stretch="1">
		<texture>ui_nlc_hint_back</texture>
	</choice_back>

	<choice_line x="63" y="256" width="260" height="22">
		<texture>ui_brokenline</texture>
		<text font="letterica18" align="c" vert_align="c" />
	</choice_line>

	<choice_title x="63" y="256" width="260" height="22">
		<text align="c" vert_align="c" font="letterica18" r="238" g="155" b="23">ui_mm_alife_title</text>
	</choice_title>

	<intro x="58" y="286" width="270" height="64">
		<text align="c" font="letterica16" r="255" g="255" b="255" complex_mode="1">ui_mm_alife_preset_desc</text>
	</intro>

	<rec_mark x="58" y="352" width="270" height="18">
		<text align="c" font="letterica16" r="216" g="186" b="140" complex_mode="1">ui_mm_alife_recommended</text>
	</rec_mark>

	<btn_extended x="115" y="372" width="157" height="40" stretch="1">
		<text font="letterica18" align="c">ui_mm_alife_extended</text>
		<texture>ui_button_main02</texture>
		<text_color>
			<e r="227" g="199" b="178"/> <t r="180" g="153" b="155"/> <d r="106" g="95" b="91"/> <h r="0" g="0" b="0"/>
		</text_color>
	</btn_extended>

	<btn_classic x="115" y="412" width="157" height="40" stretch="1">
		<text font="letterica18" align="c">ui_mm_alife_classic</text>
		<texture>ui_button_main02</texture>
		<text_color>
			<e r="227" g="199" b="178"/> <t r="180" g="153" b="155"/> <d r="106" g="95" b="91"/> <h r="0" g="0" b="0"/>
		</text_color>
	</btn_classic>

	<btn_back x="115" y="452" width="157" height="40" stretch="1">
		<text font="letterica18" align="c">ui_mm_alife_back</text>
		<texture>ui_button_main03</texture>
		<text_color>
			<e r="227" g="199" b="178"/> <t r="180" g="153" b="155"/> <d r="106" g="95" b="91"/> <h r="0" g="0" b="0"/>
		</text_color>
	</btn_back>

	<desc_back x="370" y="115" width="640" height="530" stretch="1">
		<texture>ui_nlc_hint_back</texture>
	</desc_back>

	<desc_line x="457" y="168" width="500" height="22">
		<texture>ui_brokenline</texture>
		<text font="letterica18" align="c" vert_align="c" />
	</desc_line>

	<desc_title x="457" y="168" width="500" height="22">
		<text align="c" vert_align="c" font="letterica18" r="238" g="155" b="23"></text>
	</desc_title>

	<desc_text x="432" y="198" width="550" height="420">
		<text align="l" font="letterica16" r="255" g="255" b="255" complex_mode="1"></text>
	</desc_text>
</window>
