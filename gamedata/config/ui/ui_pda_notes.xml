<?xml version="1.0" encoding="windows-1251" ?>
<!-- NLC: PDA Notes tab (ui_pda_notes.script). Coordinates are local to the tab area
     (pda.xml script_tab_area, 761x525), mirroring the Spravka window. -->
<window>
	<!-- LEFT: note list -->
	<list_frame x="0" y="0" width="298" height="525" a="80">
		<texture>ui_pda_frame_sub</texture>
	</list_frame>
	<list_header x="8" y="16" width="284" height="27">
		<texture>ui_string_02</texture>
	</list_header>
	<list_title x="23" y="17" width="130" height="25">
		<text font="font_pda_h" r="225" g="225" b="250"/>
	</list_title>
	<list x="15" y="55" width="268" height="395" item_height="22" scroll_profile="pda"/>
	<count x="15" y="455" width="268" height="18">
		<text font="font_pda" r="160" g="160" b="160"/>
	</count>
	<btn_new x="15" y="482" width="125" height="28">
		<text x="4" y="0" font="font_pda" r="231" g="168" b="12">pda_notes_btn_new</text>
	</btn_new>
	<btn_sort x="150" y="17" width="130" height="25">
		<text x="0" y="0" font="font_pda" r="160" g="160" b="160" align="r">pda_notes_sort_date</text>
	</btn_sort>
	<btn_here x="150" y="482" width="133" height="28">
		<text x="4" y="0" font="font_pda" r="231" g="168" b="12">pda_notes_btn_here</text>
	</btn_here>

	<!-- RIGHT: editor -->
	<edit_frame x="313" y="0" width="448" height="525" a="80">
		<texture>ui_pda_frame_sub</texture>
	</edit_frame>
	<edit_header x="321" y="17" width="434" height="21">
		<texture>ui_string_03</texture>
	</edit_header>
	<edit_caption x="331" y="18" width="420" height="18">
		<text font="font_pda" r="255" g="255" b="255"/>
	</edit_caption>
	<title_label x="330" y="48" width="200" height="18">
		<text font="font_pda" r="160" g="160" b="160">pda_notes_title</text>
	</title_label>
	<title_edit x="330" y="68" width="414" height="24" max_symb_count="48">
		<texture>ui_linetext_e</texture>
		<text font="letterica16" r="240" g="217" b="182"/>
	</title_edit>
	<!-- icon buttons are placed by the script from x/y with this size and step -->
	<icons x="330" y="100" size="24" step="30"/>
	<body_frame x="330" y="132" width="414" height="296" a="80">
		<texture>ui_pda_frame_sub</texture>
	</body_frame>
	<body x="334" y="136" width="406" height="288"/>
	<info x="330" y="432" width="414" height="36">
		<text font="font_pda" r="160" g="160" b="160" complex_mode="1"/>
	</info>
	<btn_pin x="330" y="482" width="100" height="28">
		<text x="4" y="0" font="font_pda" r="231" g="168" b="12">pda_notes_btn_pin</text>
	</btn_pin>
	<btn_map x="434" y="482" width="100" height="28">
		<text x="4" y="0" font="font_pda" r="231" g="168" b="12">pda_notes_btn_map</text>
	</btn_map>
	<btn_mark x="538" y="482" width="100" height="28">
		<text x="4" y="0" font="font_pda" r="231" g="168" b="12">pda_notes_btn_mark</text>
	</btn_mark>
	<btn_delete x="642" y="482" width="102" height="28">
		<text x="4" y="0" font="font_pda" r="231" g="168" b="12">pda_notes_btn_delete</text>
	</btn_delete>
	<!-- pinned system entries: read-only coloured body inside body_frame -->
	<sys_scroll x="344" y="148" width="392" height="272" scroll_profile="pda"/>
	<sys_text x="0" y="0" width="374" height="272" complex_mode="1">
		<text font="letterica16" align="l" r="225" g="225" b="225"/>
	</sys_text>
	<empty x="330" y="200" width="414" height="60">
		<text font="font_pda" r="160" g="160" b="160" align="c" complex_mode="1">pda_notes_empty</text>
	</empty>
</window>
