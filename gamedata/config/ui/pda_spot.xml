<w>
	<background x="20" y="55" width="780" height="150">
		<!--auto_static x="-5" y="0" width="240" height="85" stretch="1">
			<texture>ui_frame_mainDes</texture>
		</auto_static-->
	</background>

	<spot_name_edit x="20" y="100" width="700" height="130">
		<text font="letterica25" r="240" g="217" b="182"/>
		<texture>ui_stroketextbox</texture>
	</spot_name_edit>

	<btn_apply x="20" y="235" width="117" height="28">
		<texture_e>ui_button_ordinary_e</texture_e>
		<texture_t>ui_button_ordinary_t</texture_t>
		<texture_h>ui_button_ordinary_h</texture_h>
		<text>ui_inv_ok</text>
	</btn_apply>

	<!-- NLC: marker icons (spot types from map_spots.xml); the first one is the default -->
	<icons x="26" y="62" size="30" step="40">
		<icon type="yellow_flag_location">ui_icons_newPDA_perssign_h</icon>
		<icon type="red_location">ui_icons_mapPDA_mark_t</icon>
		<icon type="green_location">ui_icons_mapPDA_persBig_h</icon>
		<icon type="blue_location">ui_icons_mapPDA_persBig_e</icon>
		<icon type="habar_location">ui_icons_mapPDA_habar</icon>
		<icon type="artefact_location">ui_mapQuest_artefact</icon>
		<icon type="monster_part_location">ui_mapQuest_monster_find</icon>
	</icons>

	<!-- NLC: append game date/time to new markers (toggle) -->
	<btn_time x="160" y="235" width="160" height="28">
		<texture_e>ui_button_ordinary_e</texture_e>
		<texture_t>ui_button_ordinary_t</texture_t>
		<texture_h>ui_button_ordinary_h</texture_h>
		<text>st_pda_spot_time_on</text>
	</btn_time>

	<!-- NLC: marker count / cap ([user_spots] max_count) -->
	<counter x="340" y="239" width="240" height="20">
		<text font="letterica16" r="220" g="220" b="220"/>
	</counter>

	<btn_cancel x="602" y="235" width="117" height="28">
		<texture_e>ui_button_ordinary_e</texture_e>
		<texture_t>ui_button_ordinary_t</texture_t>
		<texture_h>ui_button_ordinary_h</texture_h>
		<text>ui_inv_cancel</text>
    </btn_cancel>
</w>
