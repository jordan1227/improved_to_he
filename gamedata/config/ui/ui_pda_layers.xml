<?xml version="1.0" encoding="windows-1251" ?>
<!-- Layer strip (map tab) and signal readout of the upgraded PDA, see he_pda_layers.script. Coordinates are
     in the 1024x768 PDA window space, like ui_pda_add.xml. -->
<main>
	<!-- Layer strip: just right of the map toolbar's "to the Zone map" and "centre on me" buttons, left of the zoom
	     buttons. Overlay coordinates draw about 16 units right of pda_map.xml coordinates, so these are
	     pda_map.xml x minus 16 (toolbar buttons: 163, 185 and zoom 278 in pda_map.xml terms). -->
	<btn_me x="184" y="107" width="21" height="15" stretch="1" hint="he_layer_me_hint">
		<texture x="749" y="411" width="25" height="25">ui\ui_common</texture>
	</btn_me>
	<btn_camps x="207" y="107" width="21" height="15" stretch="1" hint="he_layer_camps_hint">
		<texture x="594" y="853" width="21" height="15">ui\ui_common</texture>
	</btn_camps>
	<btn_markers x="230" y="107" width="21" height="15" stretch="1" hint="he_layer_markers_hint">
		<texture>ui_icons_newPDA_perssign_h</texture>
	</btn_markers>
	<!-- Signal readout: icons from ui_common.dds at x=596, y=1026 + 14 * state (docs/assets/signal_icons_596_1026.png
	     holds the placeholder sheet). Placed at the right end of the time/date box (pda.xml timer_frame_line, 750..911). -->
	<sig_0 x="857" y="632" width="22" height="14" stretch="1">
		<texture x="596" y="1026" width="22" height="14">ui\ui_common</texture>
	</sig_0>
	<sig_1 x="857" y="632" width="22" height="14" stretch="1">
		<texture x="596" y="1040" width="22" height="14">ui\ui_common</texture>
	</sig_1>
	<sig_2 x="857" y="632" width="22" height="14" stretch="1">
		<texture x="596" y="1054" width="22" height="14">ui\ui_common</texture>
	</sig_2>
	<sig_3 x="857" y="632" width="22" height="14" stretch="1">
		<texture x="596" y="1068" width="22" height="14">ui\ui_common</texture>
	</sig_3>
	<sig_4 x="857" y="632" width="22" height="14" stretch="1">
		<texture x="596" y="1082" width="22" height="14">ui\ui_common</texture>
	</sig_4>
</main>
