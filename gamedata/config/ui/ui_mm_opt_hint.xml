<?xml version="1.0" encoding="windows-1251"?>
<!-- sivol: options hover hint, 4:3. Shown only while an option is hovered (ui_mm_opt_main.script ShowHint/HideHint).
     hint_name gives the header's centre, top, max width and height; hint_line is a ui_brokenline sized to the text
     (ui_mm_alife_preset.fit_header). The 16:9 layout is ui_mm_opt_hint_16.xml. docs/ALIFE_DESC_UI_DESIGN.md -->
<window>
	<hint_back x="10" y="160" width="400" height="330" stretch="1">
		<texture>ui_nlc_hint_back</texture>
	</hint_back>

	<hint_line x="55" y="192" width="330" height="22">
		<texture>ui_brokenline</texture>
		<text font="letterica18" align="c" vert_align="c" />
	</hint_line>

	<hint_name x="55" y="192" width="330" height="22">
		<text align="c" vert_align="c" font="letterica18" r="238" g="155" b="23"></text>
	</hint_name>

	<hint_caption x="50" y="224" width="340" height="250">
		<text align="j" font="letterica16" r="255" g="255" b="255" complex_mode="1"></text>
	</hint_caption>
</window>
