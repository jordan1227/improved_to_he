; news_voice settings. Text counts at the end are generated by docs/build_news_text.ps1.
; Times are game minutes (gm); 1 game hour = 60 gm = 12 real minutes.
[nv]
enabled = 1
kill_window = 6
kill_merge_dist = 100
kill_cd = 20
kill_chance = 70
weather_cd = 150
weather_key_cd = 360
; real seconds after a load during which weather changes are ignored
weather_load_grace = 120
weather_chance = 75
time_voice_chance = 60
time_cd = 1000
reply_chance = 25
reply_cd = 20
reply_delay = 14
; lines per budget_window (gm) by class: reports, ambient chatter, reactions
budget = 3
budget_ambient = 2
budget_react = 4
budget_window = 60
blow_window = 90
olr_cd = 30
mem_size = 8
speaker_cd = 60
; time of day, replies and party comments: percent of speakers taken from another level
speaker_world_chance = 75
place_chance = 30
afterblow_window = 720
afterblow_chance = 70
; seconds before a report is written down: the scarier the fight, the longer
fear_trivial_min = 40
fear_trivial_max = 200
fear_easy_min = 120
fear_easy_max = 400
fear_hard_min = 400
fear_hard_max = 1500
; witnessed player kills
wit_radius = 80
heard_radius = 70
wit_cap = 14
plr_min_tier = 1
plr_cd = 25
plr_chance = 80
found_delay_min = 60
found_delay_max = 240
fame_cap = 6
fame_half = 4320
; veterans are named now and then, masters more often (percent)
name_chance_vet = 15
name_chance_master = 40
; a held-back report is dropped after this many gm
retry_max = 45
; chance of party_end comments, and of a second one
party_chance = 70
; chance of a comment when a party sets out
party_start_chance = 40
party_second_chance = 40
w_rank_p = 0.5
w_rep_p = 0.2
w_fame_p = 0.3
s_tier1 = 0.25
s_tier2 = 0.45
s_tier3 = 0.7
; character rank points (game_relations.ltx rating)
rank_exp = 300
rank_vet = 600
rank_mas = 900
; danger = tier*2 + min(count-1,3)*0.7 - rank*1.2 + (1-hp)*3
w_tier = 2
w_count = 0.7
w_rank = 1.2
w_hp = 3
t_trivial = 1.0
t_hard = 3.5
t0_easy = 1.5

