; Mutant parts on NPC kills, read by sivol_part_claim.script (docs/PART_LOOT_DESIGN.md).
; Plain ASCII. Times are real milliseconds, distances metres.

[main]
; true = stalker kills destroy the part, as before. false = same drops for everyone.
strip_npc_kills = false
; percent of parts that stay on an NPC's kill, by tier 1 weak, 2 mid, 3 rare, 4 top. Lower to tune supply.
keep_tier_1 = 100
keep_tier_2 = 100
keep_tier_3 = 100
keep_tier_4 = 100
part_weak_cost = 1000
part_rare_cost = 5000
part_top_cost = 15000
; the player owns the kill with this share of the health bar, forgotten after forget_ms with no hit from him
actor_share = 0.2
forget_ms = 120000
claim_max_age_h = 48
; who counts as near: within near_dist and seeing the player, or within close_dist
near_dist = 25
close_dist = 8
witness_dist = 40
tip_dist = 40
; the warning comes when the player holds the crosshair on the corpse this long, knife ready, this close
aim_ms = 1000
aim_dist = 3
; chance in percent that an owner sprints for a top part or an alpha trophy; otherwise he runs at most
sprint_chance = 20
; the second press must come within this
press_ms = 20000
; a press sooner than this after the warning is the same press
press_min_ms = 1000
; stalkers hold back from the player's kill while he is this close, by his rank tier minus theirs. Below 0, or a novice player: not at all
fresh_ms_gap_0 = 10000
fresh_ms_gap_1 = 25000
fresh_ms_gap_2 = 60000
fresh_dist = 30
; other stalkers leave an NPC's kill to him this long while he is online
owner_ms = 120000
; [part_claim] decision lines in the log, on during testing
log = true
; the talk: how long the offer stands, a looter's offer, how far he can be for it, and the forced talk's reach
offer_ms = 120000
mirror_ms = 300000
mirror_dist = 100
sell_dist = 40
force_dist = 3
chase_ms = 35000
chase_dist = 40
; shares of a part's value
share_split = 0.2
; a kindness is never paid less than this
reward_min = 150
share_hire = 0.3
share_sample = 0.4
share_sell = 0.5
min_hand_condition = 0.2
; stash rewards: novice PDA tier roll, on these level prefixes
stash_levels = esc,gar,mar,agr,agru,val,dsc,hos,lost
gossip_per_day = 3
; seconds of real time before word gets around; also how long the player has to settle after cutting
gossip_delay_min = 90
gossip_delay_max = 180
; chance in percent that a PDA line names the player, by his rank tier 1 novice to 4 master
name_chance_1 = 0
name_chance_2 = 30
name_chance_3 = 60
name_chance_4 = 90
; game seconds an NPC remembers the last deal with the player
memory_s = 259200
; while he remembers a refusal the player pays this many times the sum and receives this many times it
grudge_markup = 1.25
grudge_cut = 0.75
; a lone NPC may open fire after a refused demand. Off by default. Percent: base, per part tier above weak, per rank tier he is above the player, bonus at or below attack_rep_low reputation, cap
attack_enabled = false
attack_base = 2
attack_per_tier = 3
attack_per_gap = 3
attack_rep_low = -100
attack_rep_bonus = 5
attack_max = 25
; nobody else may be this close to him, and this long passes between his line and the shot
attack_lone_dist = 40
attack_warn_ms = 3000
