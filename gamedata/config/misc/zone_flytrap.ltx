; Flytrap ("Muholovka"): a stasis field, docs/ANOMALY_DESIGN.md 3. No damage of its own.
; Engine: CCustomZone flytrap mode (nlc-3.589.187). Player side: scripts/sivol/sivol_flytrap.script.
[zone_flytrap]
GroupControlSection		= spawn_group_zone
$spawn 					= "zones\zone flytrap"
$prefetch 				= 16
class					= ZS_MBALD
script_binding			= amk_anoms.bind

; --- flytrap (engine) ---
nlc_flytrap				= true
ignore_any				= true		; never awakes, never hits
monster_detect_k		= 0.2		; x the monster's Anomaly_Detect_Probability: mutants rarely notice it (stalkers always do)
monster_follow_enemy	= true		; a monster that knows it still enters while its enemy stands inside
flytrap_bullet_speed	= 8			; m/s inside, past the ramp; the hit keeps its power
flytrap_bullet_ramp		= 1.5		; m from the surface over which a bullet eases to that speed
flytrap_slow_rim		= 0.3		; monster speed removed at the edge
flytrap_slow_core		= 0.7		; ... and past flytrap_ramp_k of the radius
flytrap_ramp_k			= 0.6
flytrap_monster_speed_rim	= 4.5	; m/s: physical speed limit of a live monster at the edge (jumps, charges, falls included)
flytrap_monster_speed_core	= 1.8	; ... and in the core
; loose items / bolts / grenades / corpses live in slowed time (docs/ANOMALY_DESIGN.md 18): velocity and spin x k,
; gravity x k^2, hit impulses x k, a grenade fuse runs at k; the own speed comes back on exit.
; Objects are slowed far more than monsters, so grenades and corpses hang (docs/ANOMALY_DESIGN.md 19).
flytrap_object_time_rim		= 0.5	; k at the edge (without the key: 1 - flytrap_slow_rim)
flytrap_object_time_core	= 0.07	; k in the core: a 15 m/s grenade crawls at ~1 m/s, a 2.5 s fuse lasts ~36 s
flytrap_object_ramp			= 1.0	; m from the surface to the core factor, geometric (0 = the monsters' ramp, R x flytrap_ramp_k)
flytrap_object_hit_k_exp	= 0.5	; hits inside (blasts, bullets) x k^this: 1 = fully slowed, 0.5 = a blast shows (strong core: x0.2 instead of x0.04)
flytrap_object_gravity_k	= 1.0	; x k^2 g inside; lower = things hang longer
flytrap_object_exit_speed	= 20	; m/s, upper limit of the own speed given back on exit
flytrap_ragdoll_exit_speed	= 12	; m/s (8 until 2026-11-13: cut a blast short), the same for corpses (joint jitter is multiplied by 1 / k on exit)
flytrap_object_exit_spin	= 20	; rad/s, upper limit of the own spin given back on exit
flytrap_learn_radius	= 25		; m, mates of a trapped monster that learn the zone
flytrap_learn_ms		= 700		; ms inside before the monster understands
flytrap_log				= true		; "~ [flytrap]" lines (testing)

; --- flytrap (sivol_flytrap.script, the player) ---
flytrap_actor_slow_rim	= 0.3		; movement removed at the edge: the same as the monsters' (flytrap_slow_rim), docs/ANOMALY_DESIGN.md 24
flytrap_actor_slow_core	= 0.7		; ... and in the core (= flytrap_slow_core)
flytrap_actor_power		= 0.06		; extra stamina per second of movement in the core (0.03)
flytrap_actor_handling	= 0.5		; speed removed in the core from everything in the hands: reload, draw, aiming, knife, throws, fire rate (the engine floors the total at 0.3) (0.45)
flytrap_actor_air_speed	= 5		; m/s x the movement factor: the actor's speed limit off the ground (a jump does not carry him out)
flytrap_actor_look		= 0.5		; mouse look speed removed in the core (level.nlc_set_look_factor, engine nlc-3.589.197)
flytrap_actor_snd_gain	= 0.75		; world sound in the core: volume (sivol_mask_audio contribution "flytrap")
flytrap_actor_snd_hf	= 0.35		; ... and high frequencies kept
flytrap_fx_fringe		= 0.006		; screen: colour fringe at the frame edge, uv (shaders/r3/nlc_flytrap.h)
flytrap_fx_lens			= 0.125		; screen: lens bulge (was 0.10 until the 2026-11-12 test)
flytrap_fx_breathe		= 1.0		; screen: slow breathing of the lens, 0..1

hit_impulse_scale		= 0.0
effective_radius		= 0.0
actor_blowout_radius_percent	= 0

ef_anomaly_type			= 1
ef_weapon_type			= 13

sound					=

artefacts				=
BirthProbability		= 0.0
hit_type				= strike

min_start_power			= 0.0
max_start_power			= 0.0
attenuation				= 1
period					= 1
min_artefact_count		= 0
max_artefact_count		= 0

idle_particles			= nlc\flytrap_idle
blowout_particles		=

awaking_time			= 100
blowout_time			= 500
accamulate_time			= 500

disable_time			= -1
disable_time_small		= -1
disable_idle_time		= -1

ignore_nonalive			= false
ignore_small			= false
ignore_artefacts		= false

blowout_light			= off
light_color				= 0.5,0.5,0.6
light_range				= 4
light_time				= 0.35
light_height			= 0.75

idle_light				= off
idle_light_range		= 2.0
idle_light_range_delta	= 0.25
idle_light_anim			= koster_01
idle_light_height		= 0.70

visible_by_detector		= off

blowout_wind			= off
blowout_wind_time_start	= 0
blowout_wind_time_peak	= 300
blowout_wind_time_end	= 600
blowout_wind_power		= 0.0

spawn_blowout_artefacts	= off

; SSS interactive grass: slow pulse
bend_grass_idle_anim	= 5
bend_grass_idle_str		= 0.3
bend_grass_idle_radius	= 5.0
bend_grass_idle_speed	= 0.25

[zone_flytrap_weak]:zone_flytrap
flytrap_monster_speed_rim	= 6
flytrap_monster_speed_core	= 3
$spawn					= "zones\flytrap weak"
flytrap_bullet_speed	= 14
flytrap_slow_rim		= 0.2
flytrap_slow_core		= 0.5
flytrap_actor_slow_rim	= 0.2
flytrap_actor_slow_core	= 0.5
flytrap_actor_power		= 0.04
flytrap_actor_handling	= 0.4
flytrap_actor_look		= 0.4
flytrap_object_time_rim		= 0.6
flytrap_object_time_core	= 0.15

[zone_flytrap_average]:zone_flytrap
$spawn					= "zones\flytrap average"

[zone_flytrap_strong]:zone_flytrap
flytrap_monster_speed_rim	= 3.5
flytrap_monster_speed_core	= 1.2
$spawn					= "zones\flytrap strong"
flytrap_bullet_speed	= 5
flytrap_slow_rim		= 0.35
flytrap_slow_core		= 0.8
flytrap_actor_slow_rim	= 0.35
flytrap_actor_slow_core	= 0.8
flytrap_actor_power		= 0.08
flytrap_actor_handling	= 0.6
flytrap_actor_look		= 0.6
flytrap_object_time_rim		= 0.4
flytrap_object_time_core	= 0.035

[amk_zone_flytrap]:zone_flytrap
$spawn					= "zones\amk flytrap"

[amk_zone_flytrap_weak]:zone_flytrap_weak
$spawn					= "zones\amk flytrap weak"

[amk_zone_flytrap_average]:zone_flytrap_average
$spawn					= "zones\amk flytrap average"

[amk_zone_flytrap_strong]:zone_flytrap_strong
$spawn					= "zones\amk flytrap strong"
