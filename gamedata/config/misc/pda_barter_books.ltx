; PDA barter book (Spravka > Barter), read by he_pda_barter.script.
; Every book needs an article "pda_barter_<id>" in gameplay\encyclopedia_barter.xml
; and the name string "pda_barter_name_<id>".
;   kind        = tradein (trade_manager.tradein_start), trade (normal trade window
;                 with the wallet held aside, Petrenko), ui_barter (ui_barter.screen)
;   cfg         = trader config(s) as passed to trade_manager.trade_init
;   suffix      = tail that the barter function appends to npc:name() in "tradein_npc"
;   buy_key     = [trader] key whose section feeds the approximate "pays" summary
;   level       = location shown until the first visit
;   unlock_info = dialogue infos that unlock the page before a visit
;   ui_name     = ui_barter list name
;   note        = optional string shown at the end of the page
;   kind = static: the page shows the string "text" as is

[books]
sidor
sidor_mod
dan
kuznetcov
sherstyk
petrenko
zub
arny
skryaga
vahtang
jila
saharov
saharov_recipes
kruglov
junkman
mikhalych
lesnik
hermit
ignat
prosha
sultan
doctor
addons
fuel_esc
fuel_bar
stepanych
voron

[names]
; plain display names for the barter book
vodka = pda_barter_item_vodka
conserva = pda_barter_item_conserva
kolbasa = pda_barter_item_kolbasa
energy_drink = pda_barter_item_energy_drink
antirad = pda_barter_item_antirad

[categories]
; item section = weapons | addons | ammo | med | food | gear | arts | misc (overrides the guess)

[sidor]
cfg         = misc\shop_sidor\trade_sidor.ltx
suffix      = _barter
buy_key     = sidor_barter_buy
level       = l01_escape
unlock_info = price_sidor

[sidor_mod]
; unlocks only when the modificates barter is opened
cfg         = misc\shop_sidor\trade_sidor.ltx
suffix      = _mod
buy_key     = sidor_modificats_buy
level       = l01_escape

