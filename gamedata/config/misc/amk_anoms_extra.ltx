; Extra anomaly spawns (amk_anoms.generate_extras, docs/ANOMALY_DESIGN.md 27).
; Rare anomalies placed on top of a level's ordinary fill, independent of level_anoms weights and counts.
;
; One section per level: [amk_extra_<level name>]. One line per anomaly type (a key of anoms_sections in
; amk_anoms.script):  type = min,max  - how many per anomaly set (each set is rolled on its own; an emission
; switches to the other set, so every emission brings a new roll). No difficulty scaling: the number written
; here is the number placed (unless the level runs out of free spots; the [amk_anoms] log line shows placed/rolled).
; Optional:  type_tiers = weak,average,strong  - tier percentages; without it the level's own tier table is used.
;
; Placement: the usual random level point (anti-spawn zones, hideouts), and the whole zone must not touch any
; other anomaly of the same set or another extra: distance >= both radii + extra_spacing.
; Use commas, not spaces, in values (the ini parser mangles spaces).

[amk_anoms_extra]
extra_spacing		= 1.0		; m of free ground between the zone's edge and another anomaly's edge
extra_tries			= 25		; random points tried per zone before giving up on it

[amk_extra_aver]
flytrap				= 25,35
silence				= 15,22

