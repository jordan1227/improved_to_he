; [HE-PORT] Left-hand watch raise (allcore_hide.script, mode "view").
; Motions come from wd_promin_hand.omf, attached to the hands models through
;Credits to: Watch animations (wd_watch_draw_left, wd_watch_idle, wd_watch_holster_left) 
;taken from Wearable Devices with permission from Sulik and the WD Team 
;(Sulik, Jeremussy, Wiarubane).

[omf_override]
file = misc\he_omf_override.ltx

; Played with game.play_hud_motion(1, ...) = left hand only; the weapon stays in the right.
; hands_position / hands_orientation: where the left hand settles while the motion runs
; (engine blends the hand to this offset). 0,0,0 is the starting value, tune in game.
[he_watch_left_hud]
hands_position = 0,0,0
hands_position_16x9 = 0,0,0
hands_orientation = 0,0,0
hands_orientation_16x9 = 0,0,0
anm_draw = wd_watch_draw_left
anm_idle = wd_watch_idle
anm_holster = wd_watch_holster_left
