#include "trade_generic.ltx"

[trader]
buy_condition = lesnik_barter_buy
sell_condition = lesnik_barter_sell
buy_supplies = lesnik_barter_supplies

;------------------------------------------------------------------------------
;-------------------------- Товар для бартера Егеря ---------------------------
;------------------------------------------------------------------------------

[lesnik_barter_supplies]

mutant_psevdodog_tail				= 5, 0.9
mutant_snork_leg					= 3, 0.8
mutant_krovosos_jaw					= 2, 0.7
mutant_poltergeist_glas				= 1, 0.6
mutant_hand_kontroler				= 1, 0.5
mutant_psevdogigant_hand			= 1, 0.45
wpn_knife_m1						= 1, 1
sharper								= 1, 1


;------------------------------------------------------------------------------
;-------------------------- Цена бартера у Егеря ------------------------------
;------------------------------------------------------------------------------

[lesnik_barter_sell]:ammo	; не продает обратно патрошки
; Factors rebased to preserve Old HE stock prices with repo item costs.

; Old HE exchange rates at the current ammo prices (3 darts = tail, 5 darts = snork leg,
; 8 slugs = jaw, 12 slugs = glass, 17 slugs = hand, 25 slugs = gigant hand); price = cost x factor.
mutant_psevdodog_tail				= 7.5, 7.5		; 2000 -> 15000
mutant_snork_leg					= 10, 10		; 2500 -> 25000
mutant_krovosos_jaw					= 8, 8			; 10000 -> 80000
mutant_poltergeist_glas				= 8, 8			; 15000 -> 120000
mutant_hand_kontroler				= 9.444445, 9.444445	; 18000 -> 170000
mutant_psevdogigant_hand			= 10, 10		; 25000 -> 250000
; M1 knife: Old HE sold it for one rare part. 3000 (config cost) x 40 = 120000 = one poltergeist glass at the price above,
; the cheapest of the three parts its price used to rotate between (glass / gigant hand / chimera kidney).
wpn_knife_m1						= 40, 40
; Sharpener: config cost 10000 x 5 = 50000 (Dan sells it for mutant parts at 10000).
sharper								= 5, 5

[lesnik_barter_buy]:food,medical,mutant_parts,ammo,weapons,addons,outfits,devices,modificats,containers,belts,accums,first_lvl,second_lvl,third_lvl,third_lvl_capsules,unknown,dummys,mayatniks,dummy_capsules,mayatniks_capsules,red_dummys,uniques,quest_items,repair_items,other_items,recipes

ammo_12x70_buck						= 10, 10		; 1500 per unit
ammo_12x76_dart						= 20, 20		; 5000 per unit
ammo_12x76_zhekan					= 30.769231, 30.769231	; 10000 per unit
