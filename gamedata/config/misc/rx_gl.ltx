[main]
; [HE-PORT]
allowed_factions = killer, military, dolg, freedom
enabled = true
check_period		= 1500	;мс ; время между проверками
check_period_covert	= 4500	;мс ; время между проверками
forbidden_factions	= zombied
forbidden_npcs		= none
min_dist		= 12	; минимальное расстояние выстрела
max_dist		= 250	; максимальное расстояние выстрела
spawn_ammo		= true	; автоматически спавнить гранаты
aim_be_only		= false ; стрелять только по лучшему врагу, или же выбирать любую доступную цель


[novice]
aim_time	= 600		;мс ; время прицеливания на 100 метров, линейная интерполяция начиная от 0
reload_time	= 1000		;мс ; время, затрачиваемое на перезарядку
repose_time	= 5000		;мс ; минимальная пауза между двумя выстрелами
accuracy	= 100		;%  ; точность; 100 - отклонение отсутствует; допустимы отрицательные значения

[experienced]
aim_time	= 600
reload_time	= 1000
repose_time	= 5000
accuracy	= 100

[veteran]
aim_time	= 600
reload_time	= 1000
repose_time	= 5000
accuracy	= 100

[master]
aim_time	= 600
reload_time	= 1000
repose_time	= 5000
accuracy	= 100
