; sivol_hit_fx.ltx: data for scripts\sivol\sivol_hit_fx.script (armour hit sounds, hit camera choice).
; Sounds and camera animations: "Wepl's Hit Effects" by wepl, used with permission (credit list).
; Design: docs\damage_model\DESIGN_hit_fx_remake.md. Read once when the game loads; restart after editing.

[options]
; outcome of a bullet hit, from the share of the bullet power the armour removed
stop_absorb      = 0.80   ; at or above (or only the hit_fraction floor got through): stopped
partial_absorb   = 0.45   ; at or above: partly stopped; below: penetrated
bare_armour      = 0.05   ; NPC bone with armour <= this and koeff >= bare_koeff has no armour
bare_koeff       = 0.95
; volume per outcome, times vol_actor for hits on the player, vol_npc_vs_npc for third-party hits
vol_stopped      = 1.0
vol_partial      = 0.8
vol_penetrated   = 0.5
vol_actor        = 0.8
vol_npc_vs_npc   = 0.7
vol_head_floor   = 0.8    ; head hits on a mask, visor or helmet play at least this loud (the round strikes it
                          ; first even when it goes through; a SEVA visor hit is otherwise always "penetrated")
max_dist         = 60     ; m, player shots at NPCs
npc_vs_npc_dist  = 25     ; m from the player, NPC-vs-NPC hits
group_ms         = 60     ; pellets of one shot on one target: one sound (one upgrade allowed)
budget_ms        = 100    ; at most budget_count sound starts per budget_ms overall
budget_count     = 4
cam_full         = 0.4    ; health lost by one hit that picks the strongest camera variant

; protection section (bone_protection_section()) -> body class, head class
; body: none, light, medium, heavy, exo; head: none, glass, gasmask, helmet, helmet_heavy, zombie
; unmapped sections fall back to the hit bone's numbers (logged once)
[npc_profiles]
kurtka_mask_damage            = light, none
kurtka_antigas_damage         = light, gasmask
kurtka_kupol_damage           = light, helmet
plasch_mask_damage            = light, none
plasch_antigas_damage         = light, gasmask
gilet_mask_damage             = medium, none
gilet_antigas_damage          = medium, gasmask
kombez_mask_damage            = medium, none
kombez_antigas_damage         = medium, gasmask
kombez_kupol_damage           = medium, helmet
kombez_helmet_damage          = medium, helmet
armor_helmet_damage           = heavy, helmet
exo_helmet_damage             = exo, helmet_heavy
npc_exo_helmet_damage         = exo, helmet_heavy
npc_exo_helmet_monolit_damage = exo, helmet_heavy
npc_skat_damage               = exo, glass
clear_sky_1                   = medium, none
clear_sky_2                   = heavy, none
stalker_nebo_1                = heavy, none
stalker_nebo_2                = heavy, gasmask
stalker_nebo_3                = heavy, gasmask
gravi_gilet_mask_damage       = medium, none
hunter_plasch_mask_damage     = light, gasmask
hunter_kombez_mask_damage     = medium, gasmask
zombied_damage                = none, zombie

; per-visual override, checked before [npc_profiles]: visual -> body class, head class ("-" keeps the
; profile's class). SEVA / scientist visuals share kombez_kupol_damage / kurtka_kupol_damage (sphere
; helmet, "helmet") with Sultan, the Duty praporshchik and gavr, or have no protection table at all, so
; the visor is set per visual. An overridden zone plays even when the bone has no armour numbers.
; Profiles read from the unpacked 06_07 patch meshes and gamedata\meshes (2026-10-20).
[npc_visuals]
actors\ecolog\stalker_ecolog               = -, glass
actors\ecolog\stalker_ecolog_military      = -, glass
actors\ecolog\stalker_ecolog_olddead       = -, glass
actors\ecolog\nauchniy_mil                 = -, glass
actors\nauchniy\nauchniy_0                 = -, glass
actors\nauchniy\nauchniy_1                 = -, glass
actors\hero\stalker_scien                  = -, glass
actors\hero\stalker_ecolog                 = -, glass
actors\hero_fix\scien_dolg                 = -, glass
actors\hero_fix\scien_green                = -, glass
actors\hero_fix\scien_killer               = -, glass
actors\hero_fix\scien_monolit              = -, glass
actors\hero_fix\scien_red                  = -, glass
actors\hero_fix\scien_stalker              = -, glass
actors\hero_fix\scien_svoboda              = -, glass
actors\dolg\stalker_do_nauchniy            = -, glass
actors\killer\stalker_ki_nauchniy          = -, glass
actors\monolit\stalker_mo_nauchniy         = -, glass
actors\neytral\stalker_neytral_nauchniy    = -, glass
actors\spec_monolit\oso_zp_nauchniy        = -, glass
actors\svoboda\stalker_sv_nauchniy         = -, glass
actors\2018\white                          = -, glass
actors\2018\vronsky                        = -, glass
actors\2018\semenov                        = -, glass

; player suit bullet_protection_sect -> body class (sounds and camera)
[actor_tiers]
actor_bullet_jacket = light
actor_bullet_vest   = medium
actor_bullet_kombez = medium
actor_bullet_heavy  = heavy
actor_bullet_skat   = exo
actor_bullet_exo    = exo

; player mask type (vergas_masks list_masks, while the mask is on) -> head sound class, head camera class
[actor_masks]
hud_gas = gasmask, gasmask
hud_mer = gasmask, gasmask
hud_sci = glass, glass
hud_mil = helmet, helmet
hud_exo = helmet_heavy, exo

; sound class -> file prefix (under gamedata\sounds), number of variants (prefix_1 .. prefix_N)
; there is no head exo set: helmet_heavy uses the body exo plates at the head
[sets]
head_none         = wepl\hit_effect\head\hit_none, 20
head_glass        = wepl\hit_effect\head\hit_glass, 20
head_gasmask      = wepl\hit_effect\head\hit_gasmask, 20
head_helmet       = wepl\hit_effect\head\hit_helmet, 20
head_helmet_heavy = wepl\hit_effect\body\hit_exo, 20
head_zombie       = wepl\hit_effect\head\hit_zombie, 20
body_light        = wepl\hit_effect\body\hit_light, 20
body_medium       = wepl\hit_effect\body\hit_medium, 20
body_heavy        = wepl\hit_effect\body\hit_heavy, 20
body_exo          = wepl\hit_effect\body\hit_exo, 20

; camera variants weak -> strong (peak rotation measured from the .anm files, 2026-10-20):
; body 0.63 s, none 4.5-6 deg, light 4-5.5, medium 3.5-5, heavy 2.5-4, exo 1-3; head 2 s,
; none/glass/gasmask 26 deg, helmet/exo 12-13 deg. Files:
; anims\camera_effects\wepl\hit_effect\<zone>\hit_<class>_<n>.anm
[camera]
body_light   = 3, 4, 1, 2, 5
body_medium  = 3, 4, 1, 2, 5
body_heavy   = 3, 4, 1, 5, 2
body_exo     = 3, 4, 1, 2, 5
head_glass   = 1, 2, 3, 4, 5
head_gasmask = 1, 2, 3, 4, 5
head_helmet  = 4, 1, 2, 3, 5
head_exo     = 4, 1, 2, 3, 5
