; Manual inventory arrangement and the item menu. docs/INVENTORY_LAYOUT_DESIGN.md

[inventory_layout]
spare_rows    = 2       ; empty rows kept under the last item, room to drag into
drop_conflict = reject  ; dropping on several items: reject = refused, Shift pushes them; push = always push

[inventory_item_menu]
; Row order of the item menu in the inventory, trade and corpse windows. Changing it needs a game restart.
; "-" starts a new group: a separator is drawn between groups that have rows.
; A row missing here goes last and logs one line.
order = st_move_to_slot, st_move_on_belt, st_move_to_bag, st_dress_outfit, st_undress_outfit, st_ballon_remove, -, st_swap_scope, st_install_scope, st_attach_addon, st_detach_gl, st_detach_scope, st_detach_silencer, st_unload_magazine, -, st_use_on, st_use_on_all, st_use, st_eat, st_drink, st_charge_gps, st_charge_torch, -, st_move, st_move_all, st_drop, st_drop_all

max_scope_rows   = 4    ; scope rows in a weapon's menu
icon_size        = 16   ; row icon height
icon_text_spaces = 5    ; text indent of every row once a row in the menu has an icon

; Optional row icons: icon_<row> = texture[, x, y, width, height]. Scope rows use the scope's own icon.
; icon_st_drop = ui\ui_my_icons, 0, 0, 32, 32
