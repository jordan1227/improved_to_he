;--------------------------------------
; Rulix aka Bak
; Настройки модуля rx_bandage
;--------------------------------------

[main]
enabled = true			; схема вкючена
medkit_health = 70		; использовать аптечку если здоровье меньше, %
bandage_bleeding = 0.1		; использовать бинт, если кровотечение больше
medkits = medkit,medkit_army,medkit_scientic	; аптечки или то чем можно лечиться
bandages = bandage 		; список бинтов, предметы, останавливающие кровотечение
spawn_medkits = 0		; сек; время спавна аптечек, 0 - отключить спавн
spawn_bandages = 120,105,90,75		; сек; время спавна бинтов, 0 - отключить спавн
spawn_random = false		; спавнить случайный предмет или первый из списка?

; NLC AlifeTactics 16.12-16.13: a bandage restores health in an NPC (percent of full health); read once at game start
; spawn_bandages and bandage_free_delay are lists by rank: novice,experienced,veteran,master (one number = all ranks)
bandage_health = 60		; an NPC uses a bandage he carries below this health
bandage_free_health = 75	; below this he gets a free bandage (after bandage_free_delay) and uses it; spawn_bandages is the interval between free ones, s
bandage_free_delay = 25,20,15,10	; s from needing a bandage to the first free one; lists by rank novice,experienced,veteran,master
bandage_heal = 20		; health a bandage restores
bandage_cap = 80		; ... but never above this
regen_rate = 4		; out of combat, with no bandage wanted: percent of health per real minute (0 = off)

forbidden_npcs	= bar_barman,mil_patrol_stalker0013,mil_patrol_stalker0014
forbidden_factions = zombied

