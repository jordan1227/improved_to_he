; NLC: anomaly hit profiles (docs/ANOMALY_DESIGN.md 16.5, engine nlc-3.589.192).
; A zone section names one in "actor_hit_profile". Engine (CActorBodyHealth::BeginZoneHit) reads:
;   mode     split = every hit is divided over the parts by the weights
;            roll  = each hit lands on one part, picked by the weights
;   head, body, left_arm, right_arm, left_leg, right_leg = weights (normalised by the engine)
; The bleeding wound goes on the heaviest (split) or the picked (roll) part. With the skeleton off only
; the wound bone moves; the health loss stays the single pool.
; sivol_actor_crit.script reads (injury system, strike hits only):
;   injury_k      share of the hit that charges the arm / leg injury (0 or absent: none)
;   injury_heavy  true = the charge alone can make the injury severe (as a bullet or a heavy mutant blow)

[nlc_zone_hit_torso]
mode						= split
body						= 1.0

; chemical puddles: the boots and shins
[nlc_zone_hit_legs]
mode						= split
left_leg					= 0.5
right_leg					= 0.5

; zharka: legs first, the heat reaches the torso and the hands
[nlc_zone_hit_zharka]
mode						= split
left_leg					= 0.30
right_leg					= 0.30
body						= 0.25
left_arm					= 0.075
right_arm					= 0.075

; electra: the discharge enters through the feet and crosses the chest
[nlc_zone_hit_electra]
mode						= split
left_leg					= 0.30
right_leg					= 0.30
body						= 0.30
left_arm					= 0.05
right_arm					= 0.05

; gravi, mincer, mosquito bald, weak tier: torso or a random limb; injuries stay light
[nlc_zone_hit_gravi]
mode						= roll
body						= 0.40
left_leg					= 0.175
right_leg					= 0.175
left_arm					= 0.125
right_arm					= 0.125
injury_k					= 0.6
injury_heavy				= false

; the same, base and average tiers: a limb can break
[nlc_zone_hit_gravi_heavy]:nlc_zone_hit_gravi
injury_k					= 1.0
injury_heavy				= true
