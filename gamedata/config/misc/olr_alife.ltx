; One place for the OLR A-life numbers. docs/ALIFE_DESIGN.md 4.0 is the design record.
;
; preset = legacy   the OLR dynamics exactly as they were before this file existed
; preset = quiet    sparse, close to NLC without OLR
; preset = default  sparser than legacy, livelier than NLC without OLR
; preset = lively   more movement, still no raids and no spawns on the player's level
;
; Edit the preset line, then load a save. Respawners read their timers at load.
; fl olr_cfg.report()              shows the active preset
; fl olr_cfg.set_preset("legacy")  switches OLR until the game is closed (not respawners)
; fl olr_census.report()           counts who lives where; more helpers at the top of olr_census.script

[settings]
preset = classic
census_log = true

; A human OLR group may not enter these levels until the info is set.
; Zombied and whoever already lives there are not affected.
[closed_levels]
l10_radar = flag:north_open
l11_pripyat = flag:north_open

; Levels a faction lives on | levels it may visit. Monolith uses mono_levels, military has none.
[territory]
stalker = l01_escape,marsh,lost_village,k01_darkscape,hospital,l02_garbage,l03_agroprom,l05_bar,l06_rostok | l04_darkvalley,l08_yantar,l07_military,red_forest,limansk,l10_radar,l11_pripyat,deadcity
dolg = l05_bar,l02_garbage,l06_rostok | l08_yantar,l04_darkvalley,l10_radar
freedom = l07_military | red_forest,limansk,l06_rostok,l10_radar,l11_pripyat
bandit = l04_darkvalley,l02_garbage,l03_agroprom | l01_escape,marsh,k01_darkscape,l06_rostok,red_forest
killer = deadcity,l06_rostok,l07_military | l03_agroprom,l05_bar,l10_radar
ecolog = l08_yantar,marsh | k01_darkscape,deadcity

; Levels with no preset of their own borrow this one for OLR rank checks.
[preset_fallback]
hospital = l01_escape

; The story so far: the highest chapter whose info is set. Linear, as the main quest is.
[chapters]
1 = agroprom_military_case_done
2 = bar_darklab_document_done
3 = yan_kill_brain_done
4 = war_zone_sleeps

; Levels OLR may use, added chapter by chapter.
[frontier]
0 = l01_escape,marsh,lost_village,k01_darkscape,hospital,l02_garbage,l03_agroprom,l05_bar
1 = l04_darkvalley,l06_rostok
2 = l08_yantar,l07_military
3 = red_forest,limansk,deadcity
4 = l10_radar,l11_pripyat

