l04u_labx18 = gigant_normal,2,dar_angar
l08u_brainlab = gigant_strong,3,auto

; Population steering (olr_steering.script): the start is the most each level held in the first steer_base_h game hours;
; then every steer_every_h a level is "over" past steer_over x its start (and at least steer_min_diff more), "under"
; below steer_under x. Over: its native respawners of that kind wait. Under: neighbours' migrants go there steer_pull %
; of the time. Loose on purpose: it only stops runaway growth and empty levels, the swings in between are left alone.
[steering]
steer_base_h = 96
steer_every_h = 6
steer_over = 1.75
steer_under = 0.5
steer_min_diff = 5
steer_pull = 40

; Shared population count (olr_population.script, preset key population): every live creature on a level, counted
; where it is now. Rats, tushkanos and dormant event NPCs apart. Monsters the level placed itself are counted apart:
; the monster target is for what lairs and OLR add, as the old ceiling was.
; Monster target = lair capacity (max_count of the level's monster respawners, AMK ones read from
; scripts\amk\amk_respawns.ltx, an unlimited one as pop_unlimited_as) x pop_factor for chapters 0,1,2,3,4.
; A lair spawns while it is under its share (target x its max_count / capacity, at most pop_lair_cap x target) and the
; level is under target; past its share only while the level is under pop_over_fill x target. A share under 1 spawns
; with that chance. Rule lairs, kept respawners and rat or tushkano lairs are counted but never wait.
; Humans: target = the level's humans when first counted x (1 + pop_human_margin), at least pop_human_min more.
; Steering reads from here: "over" at target, "under" below pop_under x target. Nothing is ever removed.
[population]
pop_factor = 0.5,0.55,0.6,0.7,0.8
pop_lair_cap = 0.2
pop_over_fill = 0.75
pop_unlimited_as = 8
pop_human_margin = 0.25
pop_human_min = 3
pop_under = 0.5
pop_count_ttl = 120
; seeding (preset key seeding): every seed_every_h game hours one OLR squad on an open surface level the player has
; not visited yet, while that level is under seed_share x its target. No seeding within seed_radius m of a quest NPC
; (olr_protected) or in the smarts below. A level with no monster smart for the squad gets a few of an AMK lair's own
; kind at the lair's spot instead (only lairs whose sections all start with one of seed_lair_species).
seed_share = 0.3
seed_every_h = 3
seed_radius = 25
seed_lair_species = dog,pseudodog,boar,flesh,cat,snork
; quest NPCs (olr_protected) take this share of what mutants deal them
quest_npc_monster_damage = 0.35
; native monsters in a free smart (no smart of their own in custom data, not from a rule or kept lair) move now and
; then (preset key native_migration): they stay native_stay_h game hours on average, at most native_max_per_pass move
; in one pass (a pass every half game hour or more, on game time)
native_stay_h = 36
native_max_per_pass = 12

; AMK offline life (olr_amk_offline.script, preset key amk_sight): what an offline stalker sees, in metres. Each call
; (every 17 game minutes, one level, up to 30 stalkers tried) the first one who found anything rolls one action by the
; w_ weights among what he found; trade only when he found nothing. over_share % of the calls go to a level over its
; monster target. Artefacts lie loose only (boxes are the stash path's); mutants within art_guard_radius of one are
; fought first, and he takes it only if they all die and he stays above art_min_health.
[amk_offline]
sight_monster = 50
sight_enemy = 80
sight_friend = 50
sight_corpse = 50
sight_weapon = 50
sight_art = 60
art_guard_radius = 40
; a level's loose artefacts are looked for again after this many game hours (AMK only lists them on a level load)
art_refresh_h = 12
art_min_health = 0.05
w_monsters = 30
w_enemies = 15
w_corpses = 15
w_weapons = 15
w_boxes = 15
w_artefacts = 10
over_share = 50
; a stalker who sees nothing trades only this % of the time; otherwise the call goes on to the next stalker
trade_chance = 15
; "well over": the count at this many times the target or more
over_margin = 1.1
; stalkers' damage against mutants in AMK fights (1 is AMK's own: stalkers nearly always won; hunts use 0.4)
amk_damage_k = 0.4
; on the player's level an offline stalker does nothing within this many metres of him (switch distance + sight)
player_clear = 230
earned_news_chance = 0.5
; two stalkers are enemies at this goodwill or below (game_relations.ltx goodwill_enemy -5000 is below the whole matrix)
; -1000: only those who also fight online (Duty/Freedom, military, killers); -250 made loners and bandits
; "enemies" offline that never shoot each other online
enemy_goodwill = -1000
; 8.29 D1: a fight's enemy side takes in their friends nearby who are hostile to the scanned man: how near (used when
; the AMK friend sight is 0) and at most how many
loyal_radius = 50
loyal_max = 4
; under time_factor one news tick spans many 17-minute periods: up to this many calls catch up per tick
catch_up_calls = 8
; road encounters: every road_every_min game minutes, offline stalkers road_far m or more from their smart (or with
; none) look for enemies in enemy sight; road_fight_chance % of meetings turn into a fight, at most road_max_fights a pass
road_every_min = 30
road_far = 40
road_fight_chance = 50
road_max_fights = 2
road_max_checks = 25
; names starting with these never take part in offline fights or finds (scripted scenes)
