[rr_garb_blood_par_1]
min_chapter = 2
sections = bloodsucker_weak,1,bloodsucker_normal,1
max_count = 2
max_spawn = 2
extra_chance = 50
idle_h = 96,120
once = false

; Darkscape: cats for the first days, burers after
[rr_dsc_burers1_1]
; the level's monster ceiling is often full on the first day: these replace the burers, so they come anyway
skip_ceiling = true
max_day = 2
sequence = cat_weak,cat_weak,cat_weak
max_count = 3
max_spawn = 3
idle_h = 12,18

[rr_dsc_burers1_2]
; the level's monster ceiling is often full on the first day: these replace the burers, so they come anyway
