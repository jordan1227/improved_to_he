l01_escape = esc_lager,esc_fabrika_bandit,esc_fox_camp,esc_dogs_to_fox,esc_assault,esc_blokpost,esc_bridge,esc_specnaz,esc_private
marsh = marsh_baze_ecolog,marsh_base_botan_lager,mar_lager,mar_military_post,mar_esc_khutor,mar_agr_khutor
k01_darkscape = dsc_dom_bridge
l02_garbage = gar_angar,gar_seryi_bandits,gar_psevdowounded,gar_hellcar_group,gar_dolg_blokpost,gar_bandit_agr,gar_bandit_blokpost,gar_bandit_post,gar_bandit_stroyka,gar_dram
l03_agroprom = agr_factory_assault,agr_factory_defence,agr_factory_hold,agr_nii
l04_darkvalley = val_lager_bandits,val_escort,val_prisoner,val_sacrifice,val_rob,val_sos,val_lager_dolg,val_mongol,val_dram
l06_rostok = bar_ecolog_crush,bar_freedom_chasers_attack,dt_bandit_veterans,dt_fraer_smart,dt_merc_baze
