; NLC sound occlusion and room acoustics (engine, docs/AUDIO_DESIGN.md sections 2-4)
; Read at level load and by the console command snd_occ_reload (edit, save, reload: no restart needed).
; Console: snd_occ_mode 0/1 (legacy/new), snd_occ_strength, snd_occ_log <part of a sound name>, snd_reverb_log 1.
;
; Loss along one listener-to-sound ray, in dB:
;   sum over crossed solids ( surface_db + db_per_m * thickness )
; High frequencies kept (low-pass on the sound):
;   product over crossed solids ( hf_keep ^ (1 + thickness / hf_ref_m) )
; Thickness comes from the entry and exit faces of a solid; when they do not pair up (open meshes, one-sided
; props, two-sided planes) default_thick is used. absorb is used by the listener room probe (reverb decay).
; Up to 5 leak paths (beside / above the sound, beside the listener) are tried; each costs leak_db and leak_hf,
; and the least lossy path wins - a thin trunk or post with open air beside it barely matters.

[snd_occlusion]
strength      = 1.0     ; multiplies every dB loss (console snd_occ_strength multiplies again)
max_db        = 30      ; cap on one path's loss (40 in the first test: shots behind buildings went silent)
min_thick     = 0.05    ; m
max_thick     = 1.5     ; m; entry/exit faces farther apart are two separate surfaces
leak_db       = 3       ; extra loss of a leak path
leak_hf       = 0.7     ; extra high-frequency loss of a leak path
leak_side     = 1.2     ; m, sideways offset of the leak paths (scaled down for sounds nearer than 4 m)
leak_up       = 1.5     ; m, leak path over the sound
leak_max_dist = 60      ; m; farther sounds use the direct ray only
attack        = 0.15    ; s, smoothing toward clearer
release       = 0.35    ; s, smoothing toward muffled
; Loud sounds (shots, explosions): soft cap; dB above loud_cap count loud_slope each, up to loud_max.
; The capped-away dB become extra high-frequency loss (hf x 10^(-dB / cap_hf_div)): dull but audible.
loud_cap      = 18
loud_slope    = 0.25
loud_max      = 24
terrain_cap   = 22      ; a path through terrain only (a hill) loses at most this
cap_hf_div    = 40
terrain       = materials\earth, materials\earth_slide, materials\earth_death, materials\dirt, materials\sand, materials\gravel, materials\grass, materials\asphalt
; Sound name parts that are never occluded (sounds typed world_ambient were all exempt before nlc-3.589.148), e.g.
; no_occlude = ambient\some_loop, device\some_radio
no_occlude    =
; Stereo sound name parts kept 3D (positioned) instead of forced 2D - shell casings are all stereo files
spatial_stereo = bullet_shells\
;                surface_db, db_per_m, hf_keep, hf_ref_m, default_thick, absorb
default       = 6,          20,       0.45,    0.3,      0.2,           0.1
passable      = 1,          2,        0.85,    1.0,      0.5,           0.6     ; unlisted passable materials (foliage)

[snd_occlusion_materials]
; name                    = surface_db, db_per_m, hf_keep, hf_ref_m, default_thick, absorb   (or: skip)
materials\concrete        = 8,  30, 0.35, 0.25, 0.25, 0.09
materials\bricks          = 7,  28, 0.40, 0.25, 0.25, 0.09
materials\stucco          = 5,  20, 0.50, 0.25, 0.15, 0.11
materials\flooring_tile   = 7,  28, 0.40, 0.25, 0.20, 0.08
materials\asphalt         = 10, 40, 0.30, 0.50, 1.00, 0.05
materials\earth           = 10, 40, 0.30, 0.50, 1.00, 0.30
materials\earth_slide     = 10, 40, 0.30, 0.50, 1.00, 0.30
materials\earth_death     = 10, 40, 0.30, 0.50, 1.00, 0.30
materials\dirt            = 10, 40, 0.30, 0.50, 1.00, 0.30
materials\sand            = 10, 40, 0.30, 0.50, 1.00, 0.35
materials\gravel          = 10, 40, 0.30, 0.50, 1.00, 0.30
materials\grass           = 10, 40, 0.30, 0.50, 1.00, 0.40
materials\metal           = 6,  40, 0.40, 0.10, 0.02, 0.08
materials\metal_pipe      = 3,  40, 0.55, 0.05, 0.01, 0.05
materials\metal_plate     = 3,  40, 0.60, 0.05, 0.01, 0.05
materials\tin             = 2,  30, 0.70, 0.05, 0.005, 0.06
materials\shifer          = 2,  25, 0.70, 0.05, 0.01, 0.06
materials\wood            = 4,  15, 0.55, 0.20, 0.10, 0.15
materials\wooden_board    = 2,  15, 0.65, 0.10, 0.03, 0.15
materials\glass           = 3,  30, 0.55, 0.02, 0.01, 0.04
materials\cloth           = 1,  5,  0.75, 0.10, 0.02, 0.70
materials\tree_trunk      = 4,  12, 0.60, 0.30, 0.40, 0.20
materials\bush            = 1,  2,  0.85, 1.00, 0.50, 0.60
materials\bush_sux        = 0.5, 1, 0.90, 1.00, 0.50, 0.60
materials\setka_rabica    = skip
materials\fake            = skip
materials\fake_ladders    = skip
materials\death           = skip
materials\water           = skip
materials\water_radiation = skip
; absorb of hard surfaces stands in for the clutter the collision mesh lacks (bare concrete 0.05 rang ~1.2 s in small rooms)

[snd_reverb]
probe_len     = 60      ; m, listener probe ray length (the sky ray is 80 m)
enc_near      = 10      ; m; a probe hit nearer than this encloses fully...
enc_far       = 40      ; m; ...farther than this not at all
roof_open_k   = 0.4     ; enclosure multiplier with open sky overhead
decay_k       = 0.03    ; decay = decay_k * room size / absorption (0.02 left underground tunnels at 0.7-1.0 s)
decay_min     = 0.3     ; s
decay_max     = 3.5     ; s
room_gain     = 0.22    ; reverb level when fully enclosed (0.32 in the first test: too intense) (console snd_reverb_gain multiplies)
outdoor_gain  = 0.3     ; open-air tail level (near-dry 0.9 s preset since nlc-3.589.148; was EFX rolling plains 2.1 s)
send_mismatch = 0.35    ; room send of a sound whose enclosure differs fully from the listener's
echo_gain     = 0.5     ; outdoor echo send of shots and explosions in the open (console snd_outdoor_echo multiplies)
amb_indoor_hf = 0.4     ; high frequencies kept of weather ambience and rain when fully enclosed (gain: snd_amb_indoor_gain)
rain_indoor   = 0.3     ; rain volume floor when fully enclosed (before, rain went silent under any roof)
hrtf_2d_gain  = 0.71    ; with HRTF on, 2D sounds (own weapons, HUD) bypass it as direct stereo at this level (snd_hrtf_2d on = through HRTF)
