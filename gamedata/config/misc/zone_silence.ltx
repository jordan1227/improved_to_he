; Silence ("Tishina"): sound does not carry in or out, docs/ANOMALY_DESIGN.md 16. Non-lethal, no artefact.
; Engine: CCustomZone key nlc_silence (nlc-3.589.191): sounds made inside, or heard by a listener inside, reach the AI
; (stalkers and mutants, Feel::Sound) weaker or not at all. Player side: scripts/sivol/sivol_silence.script (the world
; fades as he walks in; combined with the gas mask in sivol_mask_audio.script).
[zone_silence]
GroupControlSection		= spawn_group_zone
$spawn 					= "zones\zone silence"
$prefetch 				= 16
class					= ZS_MBALD
script_binding			= amk_anoms.bind

; --- silence (engine) ---
nlc_silence				= true
ignore_any				= true		; never awakes, never hits
monster_detect_k		= 0.0		; mutants do not avoid it: they walk through, unheard (stalkers keep out, as for any anomaly)
silence_ai_rim			= 0.7		; share of a sound's power removed for the AI at the edge
silence_ai_core			= 1.0		; ... and past silence_ramp_k of the radius (1 = not heard at all)
silence_ramp_k			= 0.5
silence_log				= true		; "~ [silence]" on / off lines (testing)

; --- silence (sivol_silence.script, the player) ---
silence_actor_edge		= 0.55		; how far the world has faded (0..1) when he crosses the edge
silence_actor_gain		= 0.12		; listener gain in the core (1 = unchanged)
silence_actor_hf		= 0.08		; listener high frequencies kept in the core
silence_approach		= 2.5		; m outside the edge over which the fade starts (the tell)

hit_impulse_scale		= 0.0
effective_radius		= 0.0
actor_blowout_radius_percent	= 0

ef_anomaly_type			= 1
ef_weapon_type			= 13

sound					=

artefacts				=
BirthProbability		= 0.0
hit_type				= strike

min_start_power			= 0.0
max_start_power			= 0.0
attenuation				= 1
period					= 1
min_artefact_count		= 0
max_artefact_count		= 0

blowout_particles		=

awaking_time			= 100
blowout_time			= 500
accamulate_time			= 500

disable_time			= -1
disable_time_small		= -1
disable_idle_time		= -1

ignore_nonalive			= false
ignore_small			= false
ignore_artefacts		= false

blowout_light			= off
light_color				= 0.5,0.5,0.6
light_range				= 4
light_time				= 0.35
light_height			= 0.75

idle_light				= off
idle_light_range		= 2.0
idle_light_range_delta	= 0.25
idle_light_anim			= koster_01
idle_light_height		= 0.70

visible_by_detector		= off

blowout_wind			= off
blowout_wind_time_start	= 0
blowout_wind_time_peak	= 300
blowout_wind_time_end	= 600
blowout_wind_power		= 0.0

spawn_blowout_artefacts	= off

; world tell (SSS interactive grass): the grass leans slowly toward the centre, as if the air were drawn in
bend_grass_idle_anim	= 3
bend_grass_idle_str		= 0.25
bend_grass_idle_radius	= 5.5
bend_grass_idle_speed	= 0.15

[zone_silence_weak]:zone_silence
$spawn					= "zones\silence weak"
silence_ai_rim			= 0.5
silence_ai_core			= 0.85
silence_actor_gain		= 0.25
silence_actor_hf		= 0.15

[zone_silence_average]:zone_silence
$spawn					= "zones\silence average"

[zone_silence_strong]:zone_silence
$spawn					= "zones\silence strong"
silence_ai_rim			= 0.85
silence_actor_edge		= 0.65
silence_actor_gain		= 0.05
silence_actor_hf		= 0.05
silence_approach		= 3.0

[amk_zone_silence_weak]:zone_silence_weak
$spawn					= "zones\amk silence weak"

[amk_zone_silence_average]:zone_silence_average
$spawn					= "zones\amk silence average"

[amk_zone_silence_strong]:zone_silence_strong
$spawn					= "zones\amk silence strong"
