[logic]
active=walker@stand
combat_ignore = combat_ignore
on_hit = hit
on_death = death

[death]
on_info = %+rad_pre_drop_barrel4%

[hit]
on_info = walker@walk %+rad_pre_drop_barrel4%

[combat]
combat_type = monolith

[walker@stand]
path_walk = rad_curve_road_high_guard2_stand
path_look = rad_curve_road_high_guard_look
sound_idle = state
;danger=danger_condition
on_info = {+rad_pre_drop_barrel4} walker@walk 
combat_ignore_cond = always


[danger_condition]
danger_expiration_time = 60000
danger_inertion_time =  90000

[walker@walk]
path_walk = rad_curve_road_high_guard2_stand
path_look = rad_curve_road_high_guard_look
sound_idle = state

[combat_ignore]