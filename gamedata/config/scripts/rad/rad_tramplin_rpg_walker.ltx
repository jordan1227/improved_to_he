[logic]
active = camper
combat_ignore = combat_ignore
on_hit = hit
on_death = death

[camper]
path_walk = rad_tramplin_rpg_walk
path_look = rad_tramplin_rpg_look
danger=danger_condition
meet=meet
combat_ignore_cond = {-rad_tramplin_open_fire =fighting_actor}

[danger_condition]
danger_expiration_time = 60000
danger_inertion_time =  90000

[meet]
meet_dialog		= rad_tramplin_members_start

[hit]
on_info = {=hit_by_actor} %+rad_tramplin_open_fire%

[combat_ignore]
combat_ignore_cond = {-rad_tramplin_open_fire =fighting_actor}

[death]
on_info = {=killed_by_actor} %+rad_tramplin_open_fire%