[logic]
active = sr_idle@idle1

[sr_idle@idle1]
on_info = {+deactivate_radar_fall} sr_idle@idle2
on_actor_inside = {-bar_deactivate_radar_done !psy_antenna_bad_time !psy_antenna_good_time} %=aes_kill_actor% nil

[sr_idle@idle2]
on_actor_inside = {-bar_deactivate_radar_done} %=aes_kill_actor% nil, {+radar_on !actor_make_good_psy} %=aes_kill_actor% nil