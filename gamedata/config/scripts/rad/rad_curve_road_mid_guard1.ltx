[logic]
active=walker@stand
combat_ignore = combat_ignore
on_hit = hit
on_death = death

[death]
on_info = %+rad_here_i_come%

[hit]
on_info = walker@walk %+rad_here_i_come%

[combat]
combat_type = monolith

[walker@stand]
path_walk = rad_curve_road_mid_guard1_stand
path_look = rad_curve_road_mid_guard_look
sound_idle = state
;danger=danger_condition
on_info = {+rad_here_i_come} walker@walk 

combat_ignore_cond = always


[danger_condition]
danger_expiration_time = 60000
danger_inertion_time =  90000

[walker@walk]
path_walk = rad_curve_road_mid_guard1_stand
path_look = rad_curve_road_mid_guard_look
sound_idle = state

[combat_ignore]