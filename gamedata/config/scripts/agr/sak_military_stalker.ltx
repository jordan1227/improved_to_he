[combat_ignore@sak_military]
combat_ignore_cond = {!fighting_actor}, {-sherstuk_enemy =fighting_actor}

[hit@soldier]
on_info = {=hit_by_actor} %+sherstuk_enemy +dumenko_fire%

[death@soldier]
on_info = %+sherstuk_dead%

[danger_condition@sak_military]
ignore_distance = 50
ignore_types = corpse
