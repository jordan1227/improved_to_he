combat_ignore_cond = {!fighting_actor}, {-sherstuk_enemy =fighting_actor}
meet = meet@kamp
danger = danger_condition@sak_military
on_info = {=is_sherstyk_night} walker@to_military

[walker@to_military]
path_walk = sherstyk_stalkers_to_military_walk
def_state_moving1 = run
def_state_moving2 = run
def_state_moving3 = run
meet = no_meet
combat_ignore_cond = {!fighting_actor}, {-sherstuk_enemy =fighting_actor}
danger = danger_condition@sak_military
