[logic]
active = walker
combat_ignore = combat_ignore
on_hit = hit
on_death = death

[walker]
path_walk = age_mil_folls_comander_walk
path_look = age_mil_folls_comander_look
combat_ignore_cond = {-agr_mil_fire =fighting_actor}
meet = meet

[meet]
meet_state = 5| {-agr_mil_fire} wait
meet_state_wpn = 5| {-agr_mil_fire} guard
victim 			= 10| actor
victim_wpn = 10| actor
use			= true
use_wpn		= false
abuse = true
meet_dialog	= agr_mil_start_dialog

[combat_ignore]
combat_ignore_cond = {-agr_mil_fire =fighting_actor}

[hit]
on_info = {=hit_by_actor} %+agr_mil_fire%

[death]
on_info = {=killed_by_actor} %+agr_mil_fire%