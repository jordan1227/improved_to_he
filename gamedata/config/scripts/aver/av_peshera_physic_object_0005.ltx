[logic]
active = ph_door@locked

[ph_door@locked]
closed = true
locked = true
snd_open_start = trader_door_unlock
on_info = {+peshera_code_door_unlocked4} ph_door@open %=play_snd(device\door_servomotor)%

[ph_door@closed]
closed = true
locked = false
on_use = ph_door@open
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_timer = 5000 | ph_door@locked %=play_snd(device\door_servomotor) -peshera_code_door_unlocked4%

[ph_door@open]
closed = false
locked = false
on_use = ph_door@closed
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_timer = 5000 | ph_door@locked %=play_snd(device\door_servomotor) -peshera_code_door_unlocked4%