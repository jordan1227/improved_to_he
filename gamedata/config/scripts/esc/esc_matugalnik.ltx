[logic]
active = ph_sound@epic
on_hit = hit

[ph_sound@epic]
snd = epic
on_info = {+esc_blockpost_alarm} ph_sound@alarm
on_info2 = {=esc_blokpost_night} ph_idle
on_info3 = {+esc_commander_die} nil
on_signal = sound_end|ph_idle@wait
on_info4 = {+esc_matugalnik_off} nil

[ph_idle@wait]
on_timer = 15000| ph_sound@humor
on_info2 = {+esc_matugalnik_off} nil

[ph_sound@alarm]
snd = siren1
on_info = {+esc_blockpost_normal -esc_commander_die} ph_sound@epic
on_info2 = {+esc_blockpost_normal +esc_commander_die} nil
on_info3 = {+esc_matugalnik_off} nil

[ph_idle]
on_info = {+esc_blockpost_alarm} ph_sound@alarm
on_info2 = {!esc_blokpost_night -esc_commander_die} ph_sound@epic
on_info3 = {!esc_blokpost_night +esc_commander_die} nil
on_info4 = {+esc_matugalnik_off} nil

[hit]
on_info = %+esc_matugalnik_off%

;esc_blockpost_alarm
;esc_blockpost_abuse