[logic]
active = sr_idle@lager

[sr_idle@lager]
on_info = {+escape_lager_killers_die} nil, {+esc_return} sr_idle@killers %+esc_fanat_spawn =sak.timer_lager_attack()%

[sr_idle@killers]
on_info = {+escape_lager_help} sr_idle@wait

[sr_idle@wait]
on_timer = 25000| {!gulag_empty(esc_killers)} sr_idle@fighting, %+escape_lager_killers_die%

[sr_idle@fighting]
on_info = {=gulag_empty(esc_killers)} nil %+escape_lager_killers_die%