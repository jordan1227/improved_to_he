[logic]
active = ph_idle@day

[ph_idle@day]
tips = speaker
on_info = {!is_day} %=turn_off(51) =turn_off(52) =turn_off(53) +esc_lamp_2_off% ph_idle@night
on_info2 = {=is_holiday_sidor} %=sak.sidor_out =turn_off(51) =turn_off(52) =turn_off(53) +esc_lamp_2_off% ph_idle@holiday_sidor
on_use = ph_idle@2 %=play_snd(device\speakerfon_sound\lamp_switch)%

[ph_idle@night]
tips = speaker
on_info = {=is_holiday_sidor} %=sak.sidor_out =turn_off(51) =turn_off(52) =turn_off(53) +esc_lamp_2_off% ph_idle@holiday_sidor
on_info2 = {=is_day !is_holiday_sidor} %=sak.sidor_in =turn_on(51) =turn_on(52) =turn_on(53) +esc_lamp_2_on% ph_idle@day
on_use = ph_idle@3 %=play_snd(device\speakerfon_sound\speaker_night_2)%

[ph_idle@holiday_sidor]
tips = speaker
on_info = {!is_day !is_holiday_sidor} %=turn_off(51) =turn_off(52) =turn_off(53) +esc_lamp_2_off% ph_idle@night
on_info2 = {=is_day !is_holiday_sidor} %=sak.sidor_in =turn_on(51) =turn_on(52) =turn_on(53) +esc_lamp_2_on% ph_idle@day
on_use = ph_idle@3 %=play_snd(device\speakerfon_sound\lamp_switch)%

[ph_idle@2]
on_timer = 4000|{+esc_sid_guard_umer -esc_sid_guard_fire} ph_idle@3 %+esc_open_door% , ph_idle@3

[ph_idle@3]
on_timer = 20000| {!is_day !is_holiday_sidor} ph_idle@night, {=is_day !is_holiday_sidor} ph_idle@day, ph_idle@holiday_sidor