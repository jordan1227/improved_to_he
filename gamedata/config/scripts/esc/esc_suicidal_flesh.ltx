[logic]
active = mob_walker1
on_death = mob_death

[mob_death]
on_actor_in_zone = esc_suicidal_flash_restrictor| %+tutorial_flesh_die%

[mob_walker1]
braindead = true
path_walk = esc_tut_flesh_bush_walk
path_look = esc_tut_flesh_bush_look
on_info = {=mob_was_hit} mob_walker2 %+tutorial_flesh_start%
on_actor_in_zone = esc_suicidal_flash_restrictor | mob_walker2 %+tutorial_flesh_start%

[mob_walker2]
braindead = true
path_walk = esc_tut_flesh_anomaly_walk
path_look = esc_tut_flesh_anomaly_look
on_npc_in_zone = 029|esc_flesh_destroy|nil %=hit_npc(esc_hit_point:bip01_spine1:500:0) +tutorial_flesh_die%