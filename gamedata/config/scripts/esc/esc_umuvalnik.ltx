[logic]
active = sr_idle@idle

[sr_idle@idle]
on_info = {+esc_give_water} ph_idle@idle, {-esc_kill_bandits_quest_done} ph_idle@idle
 
[ph_idle@idle]
tips = water
on_use = %=vergas_masks.fill_flask()% ph_idle@water_time
on_timer = 30000| ph_idle@water_time

[ph_idle@water_time]
on_timer = 20000| sr_idle@idle %-esc_give_water%