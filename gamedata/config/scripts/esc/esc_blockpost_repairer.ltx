[logic]
active = walker@day
on_death = death
on_hit = hit
combat_ignore = combat_ignore
danger = danger_condition

[walker@day]
path_walk = esc_soldier_repair_walk
path_look = esc_soldier_repair_look
meet = meet@esc_repair
danger = danger_condition
combat_ignore_cond = {-esc_blockpost_abuse +mil_find_prizrak_today =fighting_actor}
on_info = {!is_day} sleeper@night

[sleeper@night]
path_main = esc_soldier_repair_night_walk
path_walk = esc_soldier_repair_night_walk
path_look = esc_soldier_repair_night_look
danger = danger_condition
combat_ignore_cond = {-esc_blockpost_abuse +mil_find_prizrak_today =fighting_actor}
meet = no_meet
on_info = {=is_day} walker@day

[meet@esc_repair]
meet_state = 4 | wait
meet_state_wpn = 4 | claim
victim = 4 | actor
victim_wpn = 4 | actor
use = true
use_wpn = false
abuse = false
meet_dialog = esc_soldier_repair_dialog

[danger_condition]
ignore_distance = 1
ignore_types = corpse
ignore_distance_sound = 3
danger_inertion_time_sound = 1000
danger_inertion_time_ricochet = 1000
ignore_distance_corpse = 3

[combat_ignore]
combat_ignore_cond = {-esc_blockpost_abuse +mil_find_prizrak_today =fighting_actor}

[death]
on_info = {=killed_by_actor} %+esc_blockpost_abuse =sak.mil_abuse()%

[hit]
on_info = {=hit_by_actor} %+esc_blockpost_abuse =sak.mil_abuse()%
