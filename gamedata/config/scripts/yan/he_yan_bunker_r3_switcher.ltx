[logic]
active = ph_button@deactive

[ph_button@deactive]
anim = lab_primary_switcher_idle
on_info={+he_yan_bunker_r3_lamp_off} ph_button@deactivate
on_info2={+he_yan_bunker_r3_lamp_on} ph_button@activate

[ph_button@activate]
anim = lab_primary_switcher_idle
on_timer = 500 | %=turn_on(10205)% ph_button@activate2

[ph_button@activate2]
anim = lab_primary_switcher_idle
tooltip = switcher_press_off
on_press = ph_button@deactivate %=play_snd_from_obj(16:device\power_switch) +he_yan_bunker_r3_lamp_off%

[ph_button@deactivate]
anim = lab_primary_switcher_off
on_timer = 500 | %=turn_off(10205)% ph_button@deactivate2

[ph_button@deactivate2]
anim = lab_primary_switcher_off
tooltip = switcher_press_on
on_press = ph_button@activate %=play_snd_from_obj(16:device\power_switch) +he_yan_bunker_r3_lamp_on%
