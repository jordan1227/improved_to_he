[logic]
active = remark@he_semenov_home
combat_ignore = combat_ignore
on_death = death@he_semenov

[remark@he_semenov_home]
anim = wait
target = he_semenov_home_look,0
no_move = true
no_rotate = true
on_info = {+he_semenov_at_shift} remark@he_semenov_shift
meet = meet@he_semenov
danger = danger_condition@he_semenov
combat_ignore_cond = always

[remark@he_semenov_shift]
anim = wait
target = he_semenov_shift_look,0
no_move = true
no_rotate = true
on_info = {-he_semenov_at_shift} remark@he_semenov_home
meet = meet@he_semenov
danger = danger_condition@he_semenov
combat_ignore_cond = always

[meet@he_semenov]
use = true
use_wpn = true
meet_state = wait
meet_state_wpn = wait
victim = 2|actor
victim_wpn = 2|actor
abuse = false

[death@he_semenov]
on_info = %+yan_scientist_die%

[danger_condition@he_semenov]
ignore_distance = 5
ignore_types = corpse

[combat_ignore]
combat_ignore_cond = always
