[logic]
trade = misc\trade_npc\trade_semenov.ltx
active = remark@he_semenov_home
combat_ignore = combat_ignore
on_death = death@he_semenov

[remark@he_semenov_home]
anim = wait
target = he_semenov_home_look,0
no_move = true
no_rotate = true
on_info = {+he_semenov_at_shift} remark@he_semenov_shift
on_info2 = {+yan_semenov_resiept_start_follow -yan_semenov_resiept_job_done -yan_semenov_resiept_job_failed} karavan@he_semenov
meet = meet@he_semenov
danger = danger_condition@he_semenov
combat_ignore_cond = always

[remark@he_semenov_shift]
anim = wait
target = he_semenov_shift_look,0
no_move = true
no_rotate = true
on_info = {-he_semenov_at_shift} remark@he_semenov_home
on_info2 = {+yan_semenov_resiept_start_follow -yan_semenov_resiept_job_done -yan_semenov_resiept_job_failed} karavan@he_semenov
meet = meet@he_semenov
danger = danger_condition@he_semenov
combat_ignore_cond = always

[meet@he_semenov]
use = true
use_wpn = true
meet_state = wait
meet_state_wpn = wait
victim = 2|actor
victim_wpn = 2|actor
abuse = false

[death@he_semenov]
on_info = %+yan_scientist_die%

[danger_condition@he_semenov]
ignore_distance = 5
ignore_types = corpse

[combat_ignore]
combat_ignore_cond = always

; [HE-PORT]
[karavan@he_semenov]
close_dist = 2
near_dist = 5
faraway_dist = 25
close_state = guard
near_state = patrol
faraway_state = sprint
wait_state = hide
look_on_actor = false
no_loot = true
radius = 1
on_info = {+yan_semenov_resiept_start_transmutation -yan_semenov_resiept_ended_transmutation} remark@he_semenov_transmutation
on_info2 = {+yan_semenov_resiept_job_done} remark@he_semenov_back, {+yan_semenov_resiept_job_failed} remark@he_semenov_back
on_actor_dist_ge_nvis = 60 | %+yan_semenov_resiept_job_failed%
meet = meet@he_semenov
combat_ignore = combat_ignore
danger = danger_condition@he_semenov_karavan

[remark@he_semenov_transmutation]
anim = wait
target = actor
no_move = true
on_info = {+yan_semenov_resiept_ended_transmutation} karavan@he_semenov, {+yan_semenov_resiept_job_failed} remark@he_semenov_back
meet = no_meet
danger = danger_condition@he_semenov_karavan
combat_ignore_cond = always

[remark@he_semenov_back]
anim = wait
no_move = true
on_info = {+he_semenov_at_shift} remark@he_semenov_shift, remark@he_semenov_home
meet = meet@he_semenov
danger = danger_condition@he_semenov
combat_ignore_cond = always

[danger_condition@he_semenov_karavan]
ignore_distance = 0
ignore_distance_grenade = 0
ignore_distance_corpse = 0
ignore_distance_danger_hit = 0
ignore_distance_sound = 0
ignore_types = corpse, sound
danger_inertion_time_grenade = 0
danger_inertion_time_hit = 0
danger_inertion_time_ricochet = 0
danger_inertion_time_corpse = 0
danger_inertion_time_sound = 0
