[logic]
;active = ph_button@deactive

[ph_button@deactive]
on_info={+yan_lamps_off} ph_button@stop
on_info2={+yan_lamps_on} ph_button@pult_on

[ph_button@stop]
anim = k_off
tooltip = bar_switcher_press_on
on_press = ph_button@on_tmbl %=sak.turn_on_yan_lamps() +yan_lamps_on%

[ph_button@on_tmbl]
anim = k_on_run
on_timer = 1000 | ph_button@on_tmbl_stop

[ph_button@on_tmbl_stop]
anim = k_on
on_timer = 1000 | ph_button@pult_on %=turn_on(3161) =turn_off(3162)%

[ph_button@pult_on]
anim = k_on
tooltip = bar_switcher_press_off
on_press = ph_button@off_tmbl %=sak.turn_off_yan_lamps() +yan_lamps_off%

[ph_button@off_tmbl]
anim = k_off_run
on_timer = 1000 | ph_button@off_tmbl_stop

[ph_button@off_tmbl_stop]
anim = k_off
on_timer = 1000 | ph_button@stop %=turn_off(3162) =turn_on(3161)%


