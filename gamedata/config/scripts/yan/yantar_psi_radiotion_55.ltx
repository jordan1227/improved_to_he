[logic]
active = sr_psy_antenna@no_helmet

[sr_psy_antenna@no_helmet]
eff_intensity = 30
hit_intensity = 20
on_info = {=psy_antenna_good_time} sr_psy_antenna@good_psy_helmet, {=psy_antenna_bad_time} sr_psy_antenna@bad_psy_helmet
on_info2 = {+yan_labx16_switcher_primary_off} sr_psy_antenna@idle

[sr_psy_antenna@bad_psy_helmet]
eff_intensity = 20
hit_intensity = 0
on_info = {=psy_antenna_good_time !psy_antenna_bad_time} sr_psy_antenna@good_psy_helmet, {!psy_antenna_good_time !psy_antenna_bad_time} sr_psy_antenna@no_helmet
on_info2 = {+yan_labx16_switcher_primary_off} sr_psy_antenna@idle

[sr_psy_antenna@good_psy_helmet]
eff_intensity = 10
hit_intensity = 0
on_info = {!psy_antenna_good_time =psy_antenna_bad_time} sr_psy_antenna@bad_psy_helmet, {!psy_antenna_good_time !psy_antenna_bad_time} sr_psy_antenna@no_helmet
on_info2 = {+yan_labx16_switcher_primary_off} sr_psy_antenna@idle

[sr_psy_antenna@idle]
eff_intensity = 0
hit_intensity = 0
on_info = {-yan_labx16_switcher_primary_off} sr_psy_antenna@no_helmet