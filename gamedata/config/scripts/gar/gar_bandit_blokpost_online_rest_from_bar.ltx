[logic]
active = sr_idle1

[sr_idle1]
on_info = {+deactivate_radar_fall} sr_idle

[sr_idle]
on_actor_inside = {-gar_bandit_blokpost_online} sr_idle@online %+gar_bandit_blokpost_online =sak.gar_zone_tips%
on_info = {+gar_bandit_blokpost_pass_fire} nil

[sr_idle@online]
on_info = {=dist_to_actor_ge(150) +gar_bandit_blokpost_online} sr_idle %-gar_bandit_blokpost_online% 
on_info2 = {+gar_bandit_blokpost_pass_off} sr_idle
on_timer = 10000 | {-gar_bandit_blokpost_on_sign} sr_idle@online2 %+gar_bandit_blokpost_online =sak.gar_zone_2tips%

[sr_idle@online2]
on_info = {=dist_to_actor_ge(150) +gar_bandit_blokpost_online} sr_idle %-gar_bandit_blokpost_online% 
on_info2 = {+gar_bandit_blokpost_pass_off} sr_idle
on_timer = 10000 | {-gar_bandit_blokpost_on_sign} %+gar_bandit_blokpost_pass_fire% nil