[logic]
active = walker@hostage
on_death = death
danger = danger_condition

[death]
on_info = %+gar_dm_novice_dead =gar_dm_yurik_died%

; [sivol] held at Orekh's fire until the debt timer is cleared (rescue, timer end or Orekh's death)
[walker@hostage]
path_walk = gar_yurik_hostage_walk
path_look = gar_yurik_hostage_look
on_info = {-gar_dm_bandits_yurik_timer +gar_dm_novice_rescued} remark@freed
on_info2 = {-gar_dm_bandits_yurik_timer} walker1
meet = meet@hostage
danger = danger_condition
show_spot = false

; state nil: the meet action never takes over from the walker, so the pose is not reset or turned while talking
[meet@hostage]
meet_state = 3|nil
meet_state_wpn = 3|nil
victim = 3|nil
victim_wpn = 3|nil
use = true
use_wpn = true
meet_dialog	= yurik_start_dialog

; [sivol] freed: waits at the fire about 2 real minutes for the actor, or leaves shortly after their talk
[remark@freed]
anim = wait
target = actor
on_timer = 120000 | walker1
on_info = {+gar_dram_novice_start} remark@freed_talked
meet = meet1
danger = danger_condition
show_spot = false

[remark@freed_talked]
anim = wait
target = actor
on_timer = 15000 | walker1
meet = meet1
danger = danger_condition
show_spot = false

[walker1]
path_walk = yurik_walk_way
path_look = yurik_way_look
on_info = {+gar_dram_novice_burer_hand_done} remark@free
meet = meet1
danger = danger_condition
show_spot = false 

[remark@free]
show_spot = false

[meet1]
meet_state = 3|wait@wait
meet_state_wpn = 3|wait@wait
victim = 3|actor
victim_wpn = 3|actor
use = true
use_wpn = true
meet_dialog	= yurik_start_dialog

[danger_condition]
ignore_distance = 5