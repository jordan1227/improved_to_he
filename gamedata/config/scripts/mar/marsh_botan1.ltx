[logic]
active = karavan
combat_ignore = combat_ignore

[karavan]
close_dist = 2
near_dist = 5
faraway_dist = 30
close_state = guard
near_state = patrol
faraway_state = sprint
wait_state = hide 
look_on_actor = false
no_loot = true 
radius = 1
meet = no_meet
on_info = {+marsh_botan_to_gigant_walk_end} walker@look_gigant
on_actor_dist_ge_nvis = 100 | %=kill =kotovod.gluzov_gig_spot_remove() -marsh_botan_to_gigant_walk_end -marsh_botan_ok%
combat_ignore = combat_ignore
danger = danger_condition

[walker@look_gigant]
path_walk = marsh_botan_look_gigant_way
path_look = marsh_botan_look_gigant_look
on_timer = 20000 | %+marsh_botan_to_gigant_end =sak.provodnik_body_out() =kotovod.gluzov_gig_spot_remove()% walker@marsh_gluzov_tp
meet = no_meet
combat_ignore_cond = {=fighting_dist_ge(5) =fighting_gigant}
danger = danger_condition

[walker@marsh_gluzov_tp]
path_walk = marsh_botan_gluzov_tp_way
path_look = marsh_botan_gluzov_tp_look
on_signal = mar_gluzov_tp | %=kotovod.tp_gluzov_to_base()%
meet = meet@marsh_end
combat_ignore_cond = {=fighting_dist_ge(5) =fighting_gigant}
danger = danger_condition

[meet@marsh_end]
use = true
use_wpn = true
meet_talk_enabled = true
meet_dialog	= marsh_botan1_start_dialog

[combat_ignore]
combat_ignore_cond = always

[danger_condition]
ignore_distance = 0
ignore_distance_grenade = 0
ignore_distance_corpse = 0
ignore_distance_danger_hit = 0
ignore_distance_sound = 0
ignore_types = corpse, sound
danger_inertion_time_grenade = 0
danger_inertion_time_hit = 0
danger_inertion_time_ricochet = 0
danger_inertion_time_corpse = 0
danger_inertion_time_sound = 0

;characters_voice\human_02\ecolog\fight\searching_enemy + detour