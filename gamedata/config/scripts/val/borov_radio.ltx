[logic]
active = ph_sound1
on_hit = hit

[hit]
on_info = %+borov_priemnik_off%

[ph_sound1]
tips = switch_off
on_use = ph_idle@idle
snd = radio_music_bandit
on_info = {+borov_priemnik_off} nil 
on_info2 = {+deactivate_radar_fall} ph_sound2

[ph_sound2]
tips = switch_off
on_use = ph_idle@idle
snd = prapor_music
on_info = {+borov_priemnik_off} nil 

[ph_idle@idle]
tips = switch_on
on_use = {+deactivate_radar_fall} ph_sound2, ph_sound1