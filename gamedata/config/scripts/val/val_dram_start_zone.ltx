[logic]
active = sr_idle@idle

[sr_idle@idle]
on_info = {+val_actor_has_borov_key} sr_idle@work

[sr_idle@work]
on_actor_inside = {-val_dram_begin} %+val_dram_begin% sr_idle@work2
on_info = {+val_dram_fire} %=sak.set_val_gulag_enemy_actor()% nil

[sr_idle@work2]
on_timer = 60000|{+val_dram_pass_on -val_dram_fire} nil, %+val_dram_fire =sak.set_val_gulag_enemy_actor()% nil
on_info = {+val_dram_fire} %=sak.set_val_gulag_enemy_actor()% nil