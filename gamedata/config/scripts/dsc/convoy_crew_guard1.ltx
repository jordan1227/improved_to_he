; sivol: Kishka convoy case, merc crew (guard1), see sivol_worldspawns.script
[smart_terrains]
none = true

[logic]
active = walker

[walker]
path_walk = convoy_crew_guard1_walk
path_look = convoy_crew_guard1_look
meet = meet@convoy_crew
danger = danger_condition

[meet@convoy_crew]
meet_state = 20|threat
meet_state_wpn = 30|threat@threat_weap
victim = 20|actor
victim_wpn = 30|actor
use = false
use_wpn = false
syndata = backoff@threat_weap
precond = visibility
abuse = false

[danger_condition]
ignore_types = corpse
ignore_distance_corpse = 0
ignore_distance = 100
