; sivol: Kishka convoy case, merc crew (biryuk), see sivol_worldspawns.script
[smart_terrains]
none = true

[logic]
active = walker

[walker]
path_walk = convoy_crew_biryuk_walk
path_look = convoy_crew_biryuk_look
meet = meet@convoy_biryuk
danger = danger_condition

[meet@convoy_biryuk]
meet_state = 5|wait|25|guard
meet_state_wpn = 30|threat@threat_weap
init_meet = talk_hello
victim = 25|actor
victim_wpn = 30|actor
use = {-convoy_crew_hostile} true, false
use_wpn = false
syndata = backoff@threat_weap
precond = visibility
abuse = false

[danger_condition]
ignore_types = corpse
ignore_distance_corpse = 0
ignore_distance = 100
