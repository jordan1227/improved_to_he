<dialog id="he_ballon_refill_saharov">
<precondition>dialogs.is_not_wounded</precondition>
<precondition>ballon_refill.can_refill</precondition>
	<phrase_list>
		<phrase id="0">
			<text>he_ballon_refill_saharov_0</text>
			<next>100</next>
		</phrase>
		<phrase id="100">
			<text>he_ballon_refill_saharov_100</text>
			<next>200</next>
			<next>300</next>
		</phrase>
		<phrase id="200">
			<precondition>ballon_refill.has_payment</precondition>
			<text>he_ballon_refill_saharov_200</text>
			<action>ballon_refill.take_ballon</action>
			<next>201</next>
		</phrase>
		<phrase id="201">
			<text>he_ballon_refill_saharov_201</text>
			<action>dialogs.break_dialog</action>
		</phrase>
		<phrase id="300">
			<text>he_ballon_refill_saharov_300</text>
			<action>dialogs.break_dialog</action>
		</phrase>
	</phrase_list>
</dialog>

<dialog id="he_ballon_refill_saharov_done">
<precondition>dialogs.is_not_wounded</precondition>
<precondition>ballon_refill.is_refilling</precondition>
	<phrase_list>
		<phrase id="0">
			<text>he_ballon_refill_saharov_done_0</text>
			<next>100</next>
			<next>200</next>
		</phrase>
		<phrase id="100">
			<precondition>ballon_refill.not_ready</precondition>
			<text>he_ballon_refill_saharov_done_100</text>
		</phrase>
		<phrase id="200">
			<precondition>ballon_refill.is_ready</precondition>
			<text>he_ballon_refill_saharov_done_200</text>
			<action>ballon_refill.give_back</action>
			<action>dialogs.break_dialog</action>
		</phrase>
	</phrase_list>
</dialog>
