<dialog id="he_pda_charge_vergas">
<precondition>dialogs.is_not_wounded</precondition>
<precondition>pda_battery.can_charge</precondition>
	<phrase_list>
		<phrase id="0">
			<text>he_pda_charge_vergas_0</text>
			<next>100</next>
		</phrase>
		<phrase id="100">
			<text>he_pda_charge_vergas_100</text>
			<next>200</next>
			<next>300</next>
		</phrase>
		<phrase id="200">
			<precondition>pda_battery.art_have</precondition>
			<text>he_pda_charge_vergas_200</text>
			<action>pda_battery.take_vergas</action>
			<next>201</next>
		</phrase>
		<phrase id="201">
			<text>he_pda_charge_vergas_201</text>
			<action>dialogs.break_dialog</action>
		</phrase>
		<phrase id="300">
			<text>he_pda_charge_vergas_300</text>
			<action>dialogs.break_dialog</action>
		</phrase>
	</phrase_list>
</dialog>

<dialog id="he_pda_charge_vergas_done">
<precondition>dialogs.is_not_wounded</precondition>
<precondition>pda_battery.taken_by_vergas</precondition>
	<phrase_list>
		<phrase id="0">
			<text>he_pda_charge_vergas_done_0</text>
			<next>100</next>
			<next>200</next>
		</phrase>
		<phrase id="100">
			<precondition>pda_battery.not_ready</precondition>
			<text>he_pda_charge_vergas_done_100</text>
			<action>dialogs.break_dialog</action>
		</phrase>
		<phrase id="200">
			<precondition>pda_battery.is_ready</precondition>
			<text>he_pda_charge_vergas_done_200</text>
			<action>pda_battery.give_back</action>
			<action>dialogs.break_dialog</action>
		</phrase>
	</phrase_list>
</dialog>

