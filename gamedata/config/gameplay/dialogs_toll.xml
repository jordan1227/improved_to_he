<?xml version="1.0" encoding="windows-1251" ?>
<game_dialogs>
<!-- [HE-PORT] olr_toll: a bandit toll on the road (docs/ALIFE_NEXT_DESIGN.md 4.2). Opened by olr_toll through
     npc_targets, so it is the bandit's start dialogue: phrase 0 is his (empty), 2 the player's (empty), 1 his opening
     line, as in dialogs_part_claim.xml. Every branch set has an unconditional option (refuse). -->
<dialog id="he_toll_dlg">
	<phrase_list>
		<phrase id="0">
			<text></text>
			<next>2</next>
		</phrase>
		<phrase id="2">
			<text></text>
			<next>1</next>
		</phrase>
		<phrase id="1">
			<text>he_toll_dlg_open</text>
			<script_text>olr_toll.dlg_t_open</script_text>
			<next>10</next>
			<next>20</next>
			<next>30</next>
			<next>40</next>
			<next>60</next>
			<next>50</next>
		</phrase>
		<phrase id="10">
			<precondition>olr_toll.dlg_can_pay</precondition>
			<text>he_toll_dlg_pay</text>
			<action>olr_toll.dlg_pay</action>
			<next>11</next>
		</phrase>
		<phrase id="11">
			<text>he_toll_dlg_pay_reply</text>
		</phrase>
		<phrase id="20">
			<precondition>olr_toll.dlg_can_kind</precondition>
			<text>he_toll_dlg_kind</text>
			<next>21</next>
		</phrase>
		<phrase id="21">
			<text>he_toll_dlg_kind_ask</text>
			<script_text>olr_toll.dlg_t_kind</script_text>
			<next>22</next>
			<next>50</next>
		</phrase>
		<phrase id="22">
			<text>he_toll_dlg_kind_give</text>
			<action>olr_toll.dlg_pay_kind</action>
			<next>23</next>
		</phrase>
		<phrase id="23">
			<text>he_toll_dlg_kind_reply</text>
		</phrase>
		<phrase id="30">
			<precondition>olr_toll.dlg_is_poor</precondition>
			<text>he_toll_dlg_poor</text>
			<action>olr_toll.dlg_poor</action>
			<next>31</next>
		</phrase>
		<phrase id="31">
			<text>he_toll_dlg_poor_reply</text>
		</phrase>
		<phrase id="40">
			<precondition>olr_toll.dlg_can_stare</precondition>
			<text>he_toll_dlg_stare</text>
			<action>olr_toll.dlg_stare</action>
			<next>41</next>
			<next>42</next>
		</phrase>
		<phrase id="41">
			<precondition>olr_toll.dlg_stare_ok</precondition>
			<text>he_toll_dlg_stare_ok</text>
		</phrase>
		<phrase id="42">
			<precondition>olr_toll.dlg_stare_fail</precondition>
			<text>he_toll_dlg_stare_fail</text>
			<action>olr_toll.dlg_break</action>
		</phrase>
		<phrase id="50">
			<text>he_toll_dlg_refuse</text>
			<action>olr_toll.dlg_refuse</action>
			<next>51</next>
			<next>52</next>
		</phrase>
		<phrase id="51">
			<precondition>olr_toll.dlg_refuse_attack</precondition>
			<text>he_toll_dlg_refuse_attack</text>
			<action>olr_toll.dlg_break</action>
		</phrase>
		<phrase id="52">
			<precondition>olr_toll.dlg_refuse_letgo</precondition>
			<text>he_toll_dlg_refuse_letgo</text>
			<action>olr_toll.dlg_letgo</action>
		</phrase>
		<phrase id="60">
			<text>he_toll_dlg_decline</text>
			<action>olr_toll.dlg_decline</action>
			<next>61</next>
		</phrase>
		<phrase id="61">
			<text>he_toll_dlg_decline_reply</text>
		</phrase>
	</phrase_list>
</dialog>
</game_dialogs>
