<!-- [sivol] shurup_mtv_upgrade: карманы армейской разгрузки; квест-условие (FAL kit) снято -->
<dialog id="shurup_mtv_upgrade_dlg">
	<precondition>dialogs.is_not_wounded</precondition>
	<precondition>sak_dialog.have_razgruzka</precondition>
	<dont_has_info>shurup_mtv_upgrade_done_info</dont_has_info>
	<phrase_list>
		<phrase id="0">
			<text>shurup_mtv_upgrade_dlg_0</text>
			<next>1</next>
		</phrase>
		<phrase id="1">
			<text>shurup_mtv_upgrade_dlg_1</text>
			<next>21</next>
			<next>22</next>
		</phrase>
		<phrase id="21">
			<dont_has_info>shurup_mtv_upgrade_info</dont_has_info>
			<text>shurup_mtv_upgrade_dlg_21</text>
			<next>31</next>
		</phrase>
		<phrase id="22">
			<has_info>shurup_mtv_upgrade_info</has_info>
			<text>shurup_mtv_upgrade_dlg_22</text>
			<next>32</next>
		</phrase>
		<phrase id="31">
			<text>shurup_mtv_upgrade_dlg_31</text>
			<next>41</next>
		</phrase>
		<phrase id="32">
			<text>shurup_mtv_upgrade_dlg_32</text>
			<next>611</next>
			<next>42</next>
		</phrase>
		<phrase id="41">
			<text>shurup_mtv_upgrade_dlg_41</text>
			<next>5</next>
		</phrase>
		<phrase id="42">
			<text>shurup_mtv_upgrade_dlg_42</text>
			<action>dialogs.break_dialog</action>
		</phrase>
		<phrase id="5">
			<text>shurup_mtv_upgrade_dlg_5</text>
			<give_info>shurup_mtv_upgrade_info</give_info>
			<next>611</next>
			<next>612</next>
		</phrase>
		<phrase id="611">
			<precondition>sak.have_items_count("bearer_cheque",2)</precondition>
			<precondition>sak.have_items_count("vodka",5)</precondition>
			<text>shurup_mtv_upgrade_dlg_611</text>
			<action>sak_inventory.release_actor_items("bearer_cheque",2)</action>
			<action>sak_inventory.release_actor_items("vodka",5)</action>
			<next>7</next>
		</phrase>
		<phrase id="612">
			<text>shurup_mtv_upgrade_dlg_612</text>
			<action>dialogs.break_dialog</action>
		</phrase>
		<phrase id="7">
			<text>shurup_mtv_upgrade_dlg_7</text>
			<give_info>shurup_mtv_upgrade_done_info</give_info>
			<next>8</next>
		</phrase>
		<phrase id="8">
			<text>shurup_mtv_upgrade_dlg_8</text>
			<action>dialogs.break_dialog</action>
		</phrase>
	</phrase_list>
</dialog>

