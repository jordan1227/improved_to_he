; OGSR: per-visual user data replacement (ModelPool.cpp, SkeletonCustom.cpp), [data] prefix = file.
[visual_userdata_override]
file = models\npc_visual_userdata_override.ltx

; NLC damage model (docs/damage_model/DESIGN_npc_damage_model.md 14), read by the engine (nlc_npc_damage.h).
; Bone lines are "koeff, armour": NPC bullets lose armour*(1-k_ap), then koeff absorbs a share of the
; rest (k_ap lifts koeff towards 1 by ap_koeff_bypass). Sections used by actor outfits keep old values.
; NLC: bone lines are "koeff, armour[, blunt]"; blunt = minimum share of the raw bullet power that passes as
; blunt trauma (x ammo nlc_blunt_k), 0 or missing = off (DESIGN_npc_damage_model.md 21)
[nlc_npc_damage]
apply_ap        = true
use_bone_koeff  = true
ap_koeff_bypass = 0.35 ; was 0.5 (heavy-tier retune, DESIGN_npc_damage_model.md 20)
apply_ap_actor  = false ; legacy actor outfit path only; the actor bullet model below always applies k_ap
stagger_log = false ; [SIVOL TEST] one line per impact / concussion stagger attempt, set false after testing
legacy_communities = zombied ; engine nlc-3.589.106+: these keep the pre-pass NPC armour path (no k_ap, no koeff)

; NLC actor bullet model (docs/damage_model/DESIGN_actor_damage_model.md 3-4, 11-15), read by the engine (nlc_npc_damage.h).
; Suits name a section with bullet_protection_sect (misc/all_outfits_nlc.ltx). Lines are "coverage, armour":
;   pen = max(p - armour*cf*(1-k_ap), p*hit_fraction), K = 1 - coverage*(1 - (1 - F*cf)^fw_protection_exp)
; F = live fire_wound_protection, cf = min(1, condition/cond_full). Head bones take coverage/armour from the
; worn mask (vergas_masks -> nlc_set_head_cover), so these sections list body bones only (default = limbs).
[nlc_actor_damage]
enabled           = true
fw_protection_exp = 3.0
cond_full         = 0.75
ap_koeff_bypass   = 0.35 ; same as [nlc_npc_damage] (DESIGN_exo_rebalance.md 7); novice/master fire_wound_immunity raised to match
bullet_head_scale = 1.4 ; neck, head, eyes, jaw for bullets only; mutant hits keep [actor_damage]
blunt_head        = 0.084 ; blunt-impact minimum on the head x the mask coverage (DESIGN_npc_damage_model.md 21)
log               = false

