HugeKick_MinMaxDelay    = 13000, 22000 ;10000, 30000
HugeKick_Time_SlowDown    = 4000
HugeKick_Hit_Jumping_Actor = false ; NLC: false = a jump dodges only if the feet are HugeKick_Dodge_Height above ground at impact
; NLC stomp extensions (engine CPseudoGigant). Remove a key to restore the original behavior of that part.
HugeKick_Dodge_Height      = 0.45  ; m of clearance under the feet at the impact frame (jump height: stamina, load, artifacts)
HugeKick_Crowd_Radius      = 6     ; m, enemies counted for a crowd stomp
HugeKick_Crowd_Min         = 3     ; enemies within the radius that allow a stomp at any distance (0 = off)
HugeKick_Height_Gate       = 3     ; m, victims above/below this height difference are not hit
HugeKick_Splash_Radius     = 10    ; m, stomp damage to other creatures (0 = actor only, as before)
HugeKick_Splash_Hit_Neutrals = false ; true = also hit neutral creatures (friends are never hit)
HugeKick_Damage_K_Monster  = 1.5   ; x falloff hit for mutants (before their immunity to HugeKick_Hit_Type_Monster)
HugeKick_Damage_K_Stalker  = 0.3   ; x falloff hit for stalkers (before armour)
HugeKick_Hit_Type_Monster  = explosion ; strike | explosion. Strike immunity is ~0.01-0.1 for all mutants; explosion carries the weak/normal/strong scaling
HugeKick_Hit_Type_Stalker  = strike
HugeKick_Hit_Bone_Monster  = bip01_spine ; damage-table bone for mutants (body scale instead of the default/limb scale); root if missing
HugeKick_Impulse           = 92    ; per kg x falloff: knockback, and the ragdoll throw on a kill
HugeKick_Stagger_Min       = 0.3   ; falloff hit that staggers (stalkers: leg-hit anim, mutants: critical-hit anim)
HugeKick_Slow_K            = 0.5   ; mutant movement slow at the centre (x falloff)
HugeKick_Slow_Time         = 4000  ; ms
HugeKick_Hit_Actor_In_Splash = true ; the actor is hit inside the splash even when not the target
HugeKick_Grenade_Radius    = 8     ; m, a thrown grenade in front triggers a deflection stomp (0 = off)
HugeKick_Grenade_Delay     = 30000 ; ms, own cooldown
HugeKick_Grenade_Damage_K  = 0.4   ; damage multiplier of the deflection stomp
HugeKick_Grenade_Anim_Speed = 1.4  ; stomp animation speed for the deflection stomp
; NLC rage: below the health fraction the giant stomps more often, wider, and moves faster
HugeKick_Rage_Enabled      = true
HugeKick_Rage_Health       = 0.35  ; health fraction that triggers rage (leaves again 10% above it)
HugeKick_Rage_Delay_K      = 0.6   ; stomp cooldown multiplier in rage
HugeKick_Rage_Crowd_Min    = 2     ; enemies needed for a crowd stomp in rage (0 = unchanged)
HugeKick_Rage_Splash_K     = 1.15  ; splash radius multiplier in rage
HugeKick_Rage_Speed_K      = 1.15  ; movement (and walk clip) speed multiplier in rage
HugeKick_Rage_Entry_Stomp  = true  ; one immediate stomp when rage starts
; NLC recovery stomp: burst damage (all attackers) within the window -> immediate stomp
HugeKick_Recover_Enabled   = true
HugeKick_Recover_Damage    = 0.12  ; fraction of max health lost within the window
HugeKick_Recover_Window    = 3000  ; ms
HugeKick_Recover_Delay     = 20000 ; ms, own cooldown
; NLC charge: rush at a visible enemy on a clear line, first strike after arrival is empowered
Charge_Enabled             = true
Charge_Dist                = 6, 15 ; m, target distance that allows a charge
Charge_Max_Height          = 2     ; m, height difference limit
Charge_Speed_K             = 1.6   ; movement and walk clip speed multiplier during the rush
Charge_Max_Time            = 3000  ; ms, rush time limit
Charge_End_Dist            = 3.3   ; m, the rush ends and the strike window opens
Charge_Delay               = 15000, 25000 ; ms, cooldown
Charge_Strike_Window       = 1500  ; ms, the first melee hit in this window is empowered
Charge_Damage_K            = 1.5   ; damage multiplier of that hit
Charge_Impulse_K           = 2.0   ; impulse multiplier of that hit (knock-back)
Charge_Stumble_Time        = 2500  ; ms of damaged walk (limp clip, Velocity_WalkFwdDamaged) after a dodged charge
Charge_Contact_Dist        = 2.2   ; m, ram hit on touch during the rush if facing the target (0 = off: strike window after Charge_End_Dist instead)
Charge_Contact_Yaw         = 1.0   ; rad, facing window for the ram; outside it the rush carries on to the locked point
Charge_Contact_Power       = 0.75  ; ram hit power (wound, like the claws)
Charge_Contact_Impulse     = 600   ; ram knock-back
Charge_Windup              = 600   ; ms, telegraph before the rush: attack sound + Charge_Windup_Anim in place (0 = none)
Charge_Windup_Anim         = stand_idle_1 ; in-place clip for the wind-up (try stand_idle_0/2, stand_turn_ls_0, stand_eat_0)
Charge_Windup_Anim_Speed   = 1.5   ; playback speed of that clip
Charge_Face_Yaw            = 0.5   ; rad, the giant must already face the target to start (the wind-up stops rotation)
Charge_Overshoot           = 3     ; m, the rush runs to a point locked this far past the target; reaching it without contact = dodged
move_speed_k               = 0.83  ; NLC engine: movement and walk clip speed multiplier (rage and charge stack on it)

