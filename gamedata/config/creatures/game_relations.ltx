[monster_target_selection]
; NLC: monster target choice (engine CMonsterEnemyMemory). Base danger = (1 + relation^3) / (1 + distance).
; Same keys (except debug_log) can be overridden in a monster's own section. Missing keys = 1.0 / 0 (old formula).
actor_bias        = 1.15   ; multiplier on the actor's danger score
target_stickiness = 1.6    ; multiplier on the monster's current target
hit_bonus         = 1.2    ; multiplier on an enemy that hit this monster within hit_bonus_time
hit_bonus_time    = 3000   ; ms
damage_threat_k    = 12    ; multiplier on an attacker = min(1 + k * recent health lost to it, damage_threat_max); 0 = off
damage_threat_max  = 4     ; cap of that multiplier
damage_memory_time = 12000 ; ms for the recorded damage to fade linearly to 0
back_hit_threat    = 0.08  ; counted as damage (threat only) per hit in the back from within back_hit_max_dist
back_hit_max_dist  = 3.0   ; m
debug_log         = false  ; true: log every target switch with both danger values

[monster_melee]
; NLC: melee diagnostics (engine CMeleeChecker / group attack state). Per-species keys melee_surface_distance
; and melee_surface_offset live in the monster sections.
debug_log = false ; true: log melee decisions (enemy within 4 m) and every bite attempt
trace_ignore_objects = true ; only level geometry blocks the bite line-of-hit check (not pack mates or loose objects)
close_yaw_dist = 1.2 ; m, below this bite distance the yaw window is at least +-close_yaw_half
close_yaw_half = 1.4 ; rad (~80 deg); body-contact headings are unstable

[monster_elevation]
; NLC: siege of an elevated enemy (engine CBaseMonster, base_monster_siege.cpp; docs/DESIGN_monster_elevation_siege.md).
; Every key except elev_debug_log can be overridden in a monster's own section (elev_enabled = false: species off).
; Times in ms, distances in m, "a, b" = random range.
elev_enabled        = true          ; false: stock behaviour everywhere (home-point shuffle)
elev_vs_npc         = false         ; also besiege NPC enemies on roofs (experimental)
elev_debug_log      = true          ; true: "~ [siege]" log lines (start/end, points, contact, exits)
elev_grace_first    = 3000          ; charge before breaking off, first time
elev_grace_repeat   = 1000          ; charge before breaking off after a bait (toggle)
elev_reengage_close = 10            ; enemy down within this of the monster: immediate attack
elev_reengage_delay = 3000, 6000, 10000 ; enemy down farther: attack after this long on the ground, by bait count
elev_toggle_decay   = 60000         ; one counted bait fades per this
elev_min_episode    = 1000          ; a siege shorter than this does not count as bait
elev_reach_height   = 1.6           ; a perch up to this high (crate) is attacked, not besieged
elev_reach_timeout  = 4000          ; ... until no bite was tried for this long
elev_eye_height     = 1.0           ; line-of-sight ray origin above the monster's feet
elev_ambush_dist    = 8, 20         ; ring around the enemy's ground point, first phase
elev_ambush_time    = 45000         ; then the watch phase
elev_watch_dist     = 20, 35        ; ring in the watch phase
elev_watch_count    = 1             ; watchers per squad (peek for a sighting)
elev_peek_interval  = 15000, 25000
elev_peek_time      = 2500
elev_peek_detect_k  = 1.5           ; vision rate factor while a watcher peeks (stealth hunt factor)
elev_hold_time      = 6000, 12000   ; voluntary reselect of the waiting point
elev_growl_interval = 8000, 15000   ; 0, 0 = silent
elev_lock_radius    = 10            ; a sound moves the anchor only this far; bolt distraction beyond it
elev_patience       = 75000         ; lock (enemy kept in memory) after the last noise or sighting, then 20 s memory
elev_faint_patience = 30000         ; a faint (suppressed outer-tier) shot keeps the lock at least this long
elev_distractible   = false         ; a bolt far from the anchor pulls one besieger to look
elev_distract_after = 10000         ; ... only when the enemy was silent and unseen this long
elev_retreat_dist   = 28            ; shot: hide this far from the enemy's ground point
elev_retreat_time   = 7000
elev_max_time       = 600000        ; fail-safe: the lock is not renewed after this
elev_gait           = run           ; run, walk, steal (sneak)
elev_rest           = stand         ; watch-phase pose: stand, sit, lie
; elev_flee_losses: pack losses (own squad, during the siege) before the siege is abandoned; default hunt_flee_losses

[monster_evasion]
; NLC: mutant evasion (engine base_monster_evade.cpp; docs/DESIGN_monster_movement_under_fire.md).
; Every key except evade_debug_log can be overridden in a monster's own section.
evade_enabled       = true          ; false: no evasion anywhere
evade_debug_log     = true          ; true: "~ [evade]" log lines
evade_watch_cone    = 55            ; deg, "the enemy sees the monster"
evade_aim_angle     = 12            ; deg, "the enemy aims at the monster"
zz_enabled          = false         ; zigzag approach (species sections switch it on)
zz_need_gun         = 0             ; 0 watched, 1 watched and armed, 2 aimed, 3 aiming down sights or crosshair lock
zz_react_ms         = 0             ; ms the trigger holds before the first leg
zz_dist             = 8, 40
zz_speed_k          = 1.2           ; speed on zigzag legs; leg angle = acos(1/k), capped by zz_max_angle
zz_max_angle        = 35
zz_leg_time         = 500, 900
zz_aim_leg_k        = 0.7
zz_lock_leg_k       = 0.5
zz_same_side        = 0.25
zz_fire_switch      = true
zz_vs_npc           = false
zz_seen_grace       = 800           ; ms the monster's sight of the enemy holds (vision flickers between updates)
zz_chance           = 1             ; chance that a burst of legs starts (rolled per burst)
zz_burst            = 0, 0          ; legs per burst; 0, 0 = continuous zigzag
zz_rest             = 0, 0          ; ms of straight run between bursts (and after a failed roll)
zz_turn_share       = 0.5           ; a side switch (2 x leg angle) must fit in this share of a leg at the run turn rate
zz_min_leg_k        = 1.5           ; a leg shorter than this x the run turn radius runs straight (no walk-speed curves)
zz_heading_gate     = 60            ; deg; no new leg while the body heads farther than this from the enemy
side_guard          = false         ; prefer moves toward or away from a watching enemy
side_guard_angle    = 30
side_guard_short    = 3
run_attack_haste_k  = 1.0