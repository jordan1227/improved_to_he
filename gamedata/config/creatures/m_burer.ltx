nlc_grudge_ms               = 60000  ; an enemy that hurt it this recently is not forgotten; unseen 3 s: it peeks for a line of sight
; grenade snatch (strong / hos / yan): a grenade in the actor's hand is yanked out (dropped), its pin pulled, held, thrown back
nlc_snatch                  = false
nlc_snatch_selected         = false  ; also a merely selected grenade (hos / yan); otherwise only once the pin is pulled
nlc_snatch_range            = 14
nlc_snatch_chance           = 0.5    ; per check, twice a second
nlc_snatch_cooldown         = 20000
nlc_snatch_speed            = 4      ; m/s the grenade leaves the hand toward the burer
; shield bullet catch: blocked bullets stop in the air and go back one by one when the shield drops; they fall when it breaks
nlc_catch_max               = 6      ; bullets held at most (weak 0, strong 10, hos 14); 0 = off
nlc_catch_return_k          = 0.7    ; damage of a returned bullet, x the damage it would have done
nlc_catch_disp              = 1.5    ; degrees of spread on the way back
nlc_catch_delay_ms          = 400    ; the tell: every caught bullet flares, then the volley after this long (was 200)
nlc_catch_flare             = anomaly2\group_items\burer_shield_flash
nlc_catch_glow_fast_ms      = 350    ; the glow pulses this fast in the shield's last second
nlc_catch_interval_min      = 40     ; ms between returned bullets
nlc_catch_interval_max      = 80
nlc_catch_drop_on_break     = true   ; a broken shield drops them (false: returned anyway)
nlc_catch_particle          =        ; optional looping particle per caught bullet (static\fire_distort was invisible)
nlc_catch_glow              = anomaly2\group_items\burer_shield_bullet2 ; the shield's bullet glow, replayed at each caught bullet
nlc_catch_glow_ms           = 1200
; pull: an enemy up on a roof / ledge (a drop toward the burer 2-6 m out) is yanked over the edge; fall damage applies
nlc_pull                    = true
nlc_pull_range              = 20
nlc_pull_speed              = 10     ; m/s horizontal, held nlc_pull_ms
nlc_pull_up                 = 3.5
nlc_pull_ms                 = 300
nlc_pull_cooldown           = 12000
nlc_pull_delay_ms           = 500    ; cast time before the pull (warning)
nlc_pull_tug                = 8      ; degrees of the camera tug
; elevation: the enemy up on a roof stays in memory while there is contact (sight, sound, hits, psy sense) plus
; nlc_elev_patience; the burer watches from a point with a line of sight, else waits hidden nearby
nlc_elev                    = true
nlc_elev_min_height         = 1.8    ; m above the ground under the enemy
nlc_elev_patience           = 90000
nlc_overwatch_min           = 10     ; m from the ground point under the enemy
nlc_overwatch_max           = 20
nlc_overwatch_hold_min      = 4000
nlc_overwatch_hold_max      = 8000
; gaze (replaces the script stare): looking at its head while it looks back fills a meter; outside a stare window it
; only primes (x nlc_gaze_passive_k, at most nlc_gaze_passive_cap); in the window (it stands and stares, warning sound)
; it fills fully; full = the stamina attack (anti-aim clip, stamina, weapon drop if stamina is low)
nlc_gaze                    = true
nlc_gaze_range              = 25     ; weak 20, strong 28, hos 30
nlc_gaze_min_dist           = 4
nlc_gaze_cone               = 12     ; degrees off its head where the gaze counts at all
nlc_gaze_cone_full          = 3      ; ... and counts fully
nlc_gaze_gain               = 0.4    ; per second (from the primed 0.5: about 1.25 s of looking) at full contact in the window (x1.25 wounded, x1.5 desperate; less far away)
nlc_gaze_passive_k          = 0.25   ; outside the window
nlc_gaze_passive_cap        = 0.5
nlc_gaze_loss               = 0.5    ; per second looking away (x2 out of sight)
nlc_gaze_drain              = 0.15   ; stamina per second at a full meter, from half
nlc_gaze_seize_stamina      = 0.5    ; stamina hit at the seize, before the weapon-weight hit
nlc_gaze_window_min         = 2000
nlc_gaze_window_max         = 3000
nlc_gaze_cooldown           = 8000   ; between windows (weak 10000, strong 7000, hos 6000)
nlc_gaze_look_ms            = 500    ; the actor has looked at it this long before a window opens
;nlc_gaze_warn_sound        = monsters\burer\burer_scan_affect_0 ; default: scan_sound
; script side (bind_monster.burer_gaze): screen effect and whispers from nlc_gaze_fx_start, scaled by the meter (placeholders)
nlc_gaze_fx_start           = 0.25
nlc_gaze_ppe                = yantar_underground_psi.ppe
nlc_gaze_ppe_id             = 2071
nlc_gaze_whisper            = characters_voice\scenario\yantar\psy_voices_1

