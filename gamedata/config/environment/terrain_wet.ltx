; NLC .212f / .213b: how each terrain detail texture behaves when wet, read by the engine ( Blender_BmmD.cpp ) for
; deffer_terrain_high_flat.ps. Value: softness, puddles
;   softness 0 = hard ( asphalt, concrete: wet sheen, mirror puddles ), 1 = soft ( earth, grass: damp, muddy puddles
;   only in hollows ); puddles 0 = none ( water soaks in ), 1 = full; less keeps only the strongest puddles.
; A missing value keeps the shader default ( colour test for softness, full puddles ).
; The game log lists every terrain material as "[nlc_terrain_wet] texture=softness,puddles ...".
; Restart the game after a change ( shaders are compiled once ).

[terrain_wet_textures]
; exact detail texture names, e.g.
; detail\detail_grnd_asphalt = 0, 1
detail\detail_grnd_yantar = 1, 0

[terrain_wet_keywords]
; the longest key found in the texture name wins
asphalt = 0, 1
asfalt = 0, 1
asf = 0, 1
beton = 0, 1
concrete = 0, 1
road = 0.1, 1
doroga = 0.1, 1
plit = 0, 1
tile = 0, 1
stone = 0.2, 0.8
rock = 0.2, 0.6
kamen = 0.2, 0.8
gravel = 0.4, 0.5
graviy = 0.4, 0.5
sand = 0.6, 0
pesok = 0.6, 0
mud = 0.8, 0
gryaz = 0.8, 0
swamp = 0.8, 0
boloto = 0.8, 0
dirt = 1, 0
earth = 1, 0
zeml = 1, 0
ground = 1, 0
grass = 1, 0
trava = 1, 0
moss = 1, 0
mox = 1, 0
leaf = 1, 0
list = 1, 0
forest = 1, 0
