; NLC: anomaly haze profiles ( docs/ANOMALY_HAZE_DESIGN.md ). A zone section names one with nlc_haze = <profile>.
; Read by the engine itself ( not through system.ltx ); ssfx_haze_reload re-reads it in game.
;
; shape         sphere | ground ( density thins upwards from the zone centre, the ground cuts the lower half )
; radius_k      x the zone's collision sphere radius
; height        m, ground shape: density falls to 1/e this high above the zone centre
; density       extinction per metre at the core
; falloff       radial edge softness ( exponent )
; albedo        colour the haze scatters ( ambient, sun and zone light are multiplied by it )
; emissive      own glow, independent of any light
; light_scatter strength of the zone's own light ( idle light + blowout flash ) inside the haze
; sun_g         forward scattering ( -0.9 .. 0.9, 0 = even )
; noise_scale   1/m; noise_drift m/s ( x, y, z ); noise_amount 0 smooth .. 1 patchy
; fade_time     s, fade in / out when the zone is switched on or off
; light_range_k x the zone light's range for the haze ( the light reaches further into the haze )
; ambient_k / sun_k / light_k / emissive_k  per-profile multipliers of the four light terms ( x ssfx_haze_light )
; blowout_density / blowout_light  x density / x zone light at a blowout, decaying over blowout_time s
; keep_volumetric_light  true = the zone light keeps its volumetric flag while hazed ( default false )
; levels        comma-separated level names; empty = every level ( a change applies after a level load )

[haze_buzz]
; undergrounds: Agroprom, X18, X16 ( brainlab ), Warlab, X8, X10, X10 bunker ( radar ), Sarcophagus, Monolith control,
; Aver cave; names as level.name() returns them ( lower case l04u_labx18 )
levels          = l03u_agr_underground,l04u_labx18,l08u_brainlab,warlab,labx8,labx10,l10u_bunker,l12u_sarcofag,l12u_control_monolith,av_peshera
shape           = ground
radius_k        = 1.9
height          = 0.9
density         = 0.45
falloff         = 1.5
albedo          = 0.60, 0.80, 0.45
emissive        = 0.015, 0.04, 0.01
light_scatter   = 0.65
light_range_k   = 1.6
ambient_k       = 0.5
sun_k           = 1.0
light_k         = 0.5
emissive_k      = 1.0
sun_g           = 0.4
noise_scale     = 0.7
noise_drift     = 0.10, 0.30, 0.08
noise_amount    = 0.7
fade_time       = 1.5
blowout_density = 2.0
blowout_light   = 3.0
blowout_time    = 1.5

[haze_buzz_strong]:haze_buzz
levels          =
density         = 0.55
height          = 1.3
radius_k        = 1.35
emissive        = 0.025, 0.07, 0.02
