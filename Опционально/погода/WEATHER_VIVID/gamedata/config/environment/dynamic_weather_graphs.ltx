; узлы переведены на погоды NLC Style Addon 2.2
;dynamic weather graphs
;modified for SWE by ggGhosTt, zhoracementov

[weather_console_settings]
; шаг 1: против пересвета — солнце к стоку, тонмаппинг включён,
; блум по порогу, линзовые блики и грязь линзы выключены
r2_sun_lumscale            = 1.0
r2_sun_lumscale_amb        = 0.6
r2_sun_lumscale_hemi       = 1.0
r2_tonemap                 = on
r2_tonemap_adaptation      = 2.0
r2_tonemap_amount          = 1.0
r2_tonemap_lowlum          = 0.01
r2_tonemap_middlegray      = 0.7
r2_ls_bloom_threshold      = 1.0
r2_ls_bloom_speed          = 100.0
ssfx_bloom_1               = (4, 1.5, 0, 0.25)
ssfx_bloom_2               = (1.7, 0.5, 0, 0)
ssfx_exposure              = 1.0
ssfx_gamma                 = 1.0
ssfx_saturation            = 1.0
r2_gloss_factor            = 8.0
r_SunShafts_Blend          = 0.25
r_SunShafts_Radius         = 1.56

[weather_periods]
1_good 				= 2, 6
2_neutral			= 2, 7
3_alpha				= 2, 3
4_bad				= 2, 5
5_foggy				= 2, 3

;starts on one hour	after prev period ending
[transition]
sa_pasmurno_october          = 1

; pre blowout weathers
[pre_blowout]
pre_blowout                  = 1

[good]
