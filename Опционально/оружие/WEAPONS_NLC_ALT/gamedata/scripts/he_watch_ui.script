-- [HE-PORT]
local took = false

function is_active()
	return vergas_watch ~= nil and vergas_watch.get_flag_watch_open() == true
end

local function blocked()
	if not db.actor then return true end
	if level.main_input_receiver() then return true end
	if db.actor:is_talking() then return true end
	if level.only_movekeys_allowed() then return true end
	if watch_gate and watch_gate.has_watch and not watch_gate.has_watch() then return true end
	if not ui_cheat_watch then return true end
	return false
end

function open()
	took = false
	if is_active() or blocked() then return false end
	level.start_stop_menu(ui_cheat_watch.watch_dialog(get_hud()), true)
	-- [HE-PORT]
	if he_sleeves and he_sleeves.refresh then he_sleeves.refresh() end
	took = true
	return true
end

function took_key()
	local t = took
	took = false
	return t
end

function abort(reason)
	if not is_active() then return end
	if ui_cheat_watch and ui_cheat_watch.close_watch_dialog then
		ui_cheat_watch.close_watch_dialog()
	end
end

function get_display_time()
	return nil
end

local function on_key(key, bind)
	if key_bindings and bind == key_bindings.kPDA_CLOCK then
		open()
	end
end

function attach(sm)
	sm:subscribe({ signal = "on_key", fun = on_key })
	sm:subscribe({ signal = "on_stop_modules", fun = function() abort("stop_modules") end })
	sm:subscribe({ signal = "on_load_before_all", fun = function() abort("load") end })
end
