-- [HE-PORT]

local function open_watch()
	if not db.actor then return "нет актора" end
	if level.main_input_receiver() then return "уже открыто другое окно" end
	if db.actor:is_talking() then return "идёт диалог" end
	if level.only_movekeys_allowed() then return "только движение" end
	if watch_gate and watch_gate.has_watch and not watch_gate.has_watch() then
		return "нет предмета device_watch"
	end
	if not ui_cheat_watch then return "ui_cheat_watch не загружен" end
	level.start_stop_menu(ui_cheat_watch.watch_dialog(get_hud()), true)
	-- [HE-PORT]
	if he_sleeves and he_sleeves.refresh then he_sleeves.refresh() end
	return nil
end

-- [HE-PORT]

local took = false

function open()
	local why = open_watch()
	took = why == nil
	return took
end

function took_key()
	local t = took
	took = false
	return t
end

function attach(sm)
end
