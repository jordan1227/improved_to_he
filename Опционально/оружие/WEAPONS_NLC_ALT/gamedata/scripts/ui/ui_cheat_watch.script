-- [HE-PORT]
local MASK_OVERLAY = true

local function clamp_cycle(value, min, max)
 if value > max then value = min end
 if value < min then value = max end
 return value
end

g_dialog = {}

local last_m = 0
local upd_t = misc.game_timer()

class "watch_dialog"(CUIScriptWnd)

local wnd_watch_hh
local wnd_watch_mm
local wnd_watch_2t
local wnd_alarm_hh
local wnd_alarm_mm
local wnd_alarm_2t
local wnd_sec_hh
local wnd_sec_mm
local wnd_sec_2t
local wnd_rad_1
local wnd_rad_2
local wnd_rad_3
local wnd_rad_4
local wnd_glass_m
local wnd_glass_b
local wnd_date_dd
local wnd_date_t1
local wnd_date_mm
local wnd_date_t2
local wnd_date_yy
local wnd_day_w
local wnd_day_z_n
local wnd_day_z_2t
local wnd_day_z_dd1
local wnd_day_z_dd2
local wnd_day_z_dd3
local wnd_alarm_on
local wnd_sec_on

function close_watch_dialog()
    if g_dialog then
        -- [HE-PORT]

        if g_dialog.on_quit then
            g_dialog:on_quit()
        end
        g_dialog = nil
    end
end

function set_lz(wnd, value)
 value = tonumber(value)
 if wnd and wnd.InitTexture and value >= 0 and value < 60 then
    wnd:InitTexture( sprintf("ui_watch_%02d", value) )
 end
end

function watch_dialog:__init(owner)
  super()
  g_dialog = self
  -- [HE-PORT]
  bind_stalker.hide_weapon()
  -- [HE-PORT]
  self.ignore_first_press = true
  self.owner = owner
  self.watch = vergas_watch.g_watch
  self:SetWindowName("watch_dialog")
  self:InitControls()
  self:InitCallBacks()
  wprintf(" watch_dialog initialized as~C0A %s~C07 ", DumpVar(self))
end

function watch_dialog:__finalize()
 wprintf("[~T/~B].~C06 #DBG: __finalize called for ~C0A %s~C07 ", DumpVar(self))
end

function watch_dialog:InitControls()

  self:Init(0,0,1024,768)

  local xml = CScriptXmlInit()
  xml:ParseFile("ui_cheat_watch.xml")

  xml:InitStatic("background", self)

  self:Register(xml:Init3tButton("btn_hours",   self), "btn_hours")
  self:Register(xml:Init3tButton("btn_min",     self), "btn_min")
  self:Register(xml:Init3tButton("btn_sbros_t", self), "btn_reset_alarm")
  self:Register(xml:Init3tButton("btn_start_t", self), "btn_set_alarm")

  self:Register(xml:Init3tButton("btn_sbros_s", self),"btn_sbros_s")
  self:Register(xml:Init3tButton("btn_start_s", self),"btn_start_s")

  vergas_watch.set_flag_watch_open(true)

  self:set_static_windows()

  self:set_dynamic_windows()

  self:set_glass_window_m()
  self:set_glass_window_b()

	-- [HE-PORT]

	if MASK_OVERLAY and vergas_masks.get_flag_mask() then
		local mask, armor = vergas_masks.mask_definition()
		if mask ~= "?" then
			self.wnd_mask = CUIStatic()
			self.wnd_mask:SetStretchTexture(true)
			self.wnd_mask:Init(0, 0, 1024, 1024)
			self.wnd_mask:InitTexture("verg\\masks\\"..mask)
			local wnd_ref = self.wnd_mask
			-- [HE-PORT]
			dsh.timeout(1, function()
				get_hud():AddDialogToRender(wnd_ref)
			end)
		end
	end
end

function watch_dialog:InitCallBacks()
  self:AddCallback("btn_hours", ui_events.BUTTON_CLICKED, function() self:btn_hours_inc() end)
  self:AddCallback("btn_min", ui_events.BUTTON_CLICKED, function() self:btn_min_inc() end)
  self:AddCallback("btn_reset_alarm", ui_events.BUTTON_CLICKED, function() self:btn_reset_alarm() end)
  self:AddCallback("btn_set_alarm", ui_events.BUTTON_CLICKED, function() self:btn_set_alarm() end)
  self:AddCallback("btn_sbros_s", ui_events.BUTTON_CLICKED, function() self:btn_sbros_s() end)
  self:AddCallback("btn_start_s", ui_events.BUTTON_CLICKED, function() self:btn_start_s() end)
end

function watch_dialog:OnKeyboard(dik, keyboard_action)
    -- [HE-PORT]
    if self.ignore_first_press then
        self.ignore_first_press = false
        return true
    end
    CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
        -- [HE-PORT]

        if dik == DIK_keys.DIK_ESCAPE
           or (key_bindings.kPDA_CLOCK
               and dik == bind_to_dik(key_bindings.kPDA_CLOCK)) then
            self:on_quit()
        end
    end
    return true
end

function watch_dialog:on_quit()

  g_dialog = {}
  vergas_watch.set_flag_watch_open(false)
  -- [HE-PORT]

  self:delete_windows()

	if self.wnd_mask ~= nil then
		get_hud():RemoveDialogToRender(self.wnd_mask)
		self.wnd_mask = nil
	end

  if self.watch:alarm_config().f then
     self.watch:enable_alarm()
  end

  if vergas_watch.set_get_old_sizes("sec") ~= 0 and (not vergas_watch.set_get_flag_sec_show(2)) then
     vergas_watch.set_get_old_sizes("sec",0)
  end
  bind_stalker.restore_weapon()
  used_items.set_get_flag_use_gadget(1,true)
  local holder = self:GetHolder()
  if holder then
     holder:start_stop_menu(self,true)
  end
  if self.Destroy then
     self:Destroy()
  end
end

function watch_dialog:update_alarm(h_add, m_add)
  local cfg = self.watch:alarm_config()
  cfg.h = clamp_cycle(cfg.h + h_add, 0, 23)
  cfg.m = clamp_cycle(cfg.m + m_add, 0, 59)
  -- [HE-PORT]
  set_value("alarm_time", cfg)
  wprintf("[~T]. #DBG: alarm time updated to~C0F %02d:%02d~C07", cfg.h, cfg.m)
  self:DrawAlarmTime()
end

function watch_dialog:btn_hours_inc()
 self:update_alarm(1, 0)
end

function watch_dialog:btn_min_inc()
 self:update_alarm(0, 1)
end

function watch_dialog:btn_reset_alarm()
  self.watch:disable_alarm()
  self.watch:shut_up()
  local cfg = self.watch:alarm_config()
  cfg.h = 0
  cfg.m = 0
  -- [HE-PORT]
  set_value("alarm_time", cfg)
  self:DrawAll()
  vergas_lib.s_play("pda\\pass_no",1)
  wnd_alarm_on:SetWndRect(0,0,0,0)
end

function watch_dialog:btn_set_alarm()

  self.watch:enable_alarm()
  self.watch:shut_up()
  vergas_lib.s_play("pda\\pass_ok",1)
  wnd_alarm_on:SetWndRect(523,286,28,25)
  wnd_alarm_on:InitTexture("ui_watch_timer_on")
end

function watch_dialog:btn_sbros_s()
  vergas_watch.set_get_old_sizes("ss",0)
  set_lz(wnd_sec_hh, 0)
  set_lz(wnd_sec_mm, 0)
  vergas_watch.set_get_flag_sec_show(1,false)
  vergas_lib.s_play([[pda\pass_no]],1)
  wnd_sec_on:SetWndRect(0,0,0,0)
end

function watch_dialog:btn_start_s()

	-- [HE-PORT]

	if ui_waiting then ui_waiting.start() end
end

function watch_dialog:show_sec()
  local hh
  local mm

  if not vergas_watch.set_get_flag_sec_show(2) then

    return
  end

  local time_t = vergas_watch.set_get_old_sizes("sec")
  if time_t == nil then
    time_t = 0
  end
  time_t = time_t + 1

  hh = math.modf(time_t / 60)
  mm = time_t - hh*60

  if hh == 100 then
    hh = 0
    time_t = mm
  end

  vergas_watch.set_get_old_sizes("sec",time_t)

  if vergas_watch.get_flag_watch_open() then
    set_lz(wnd_sec_hh, hh)
    set_lz(wnd_sec_mm, mm)
  end
end

function watch_dialog:show_radiation()
  if vergas_watch.get_flag_watch_open() then
     self:DrawRadiation()
  end
end

